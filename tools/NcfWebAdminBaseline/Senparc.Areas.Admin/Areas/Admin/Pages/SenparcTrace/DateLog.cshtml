@page
@model Senparc.Areas.Admin.Areas.Admin.Pages.SenparcTrace_DateLogModel
@{
    ViewData["Title"] = AR["Trace.日志"];
    Layout = "_Layout_Vue";
}

@section breadcrumbs {
    <el-breadcrumb-item>@AR["Common.系统管理"]</el-breadcrumb-item>
    <el-breadcrumb-item><a asp-area="Admin" asp-page="Index">@AR["Trace.日志"]</a></el-breadcrumb-item>
    <el-breadcrumb-item>{{dateTitle}}</el-breadcrumb-item>
}

@section HeaderContent {
    <link rel="stylesheet" href="~/css/Admin/Pages/SenparcTrace/trace.css" />
}

<div class="trace-page" v-loading="loading">
    <el-alert class="trace-redacted-notice"
              :title="ncfT('Trace.RedactedNotice')"
              type="info"
              :closable="false"
              show-icon></el-alert>

    <el-row :gutter="16" class="trace-summary">
        <el-col :xs="24" :sm="8">
            <el-card shadow="never">
                <div class="trace-summary__label">@AR["Trace.TotalRecords"]</div>
                <div class="trace-summary__value">{{searchData.total}}</div>
            </el-card>
        </el-col>
        <el-col :xs="24" :sm="8">
            <el-card shadow="never">
                <div class="trace-summary__label">@AR["Trace.ExceptionInfo"]</div>
                <div class="trace-summary__value trace-summary__value--danger">{{exceptionCount}}</div>
            </el-card>
        </el-col>
        <el-col :xs="24" :sm="8">
            <el-card shadow="never">
                <div class="trace-summary__label">@AR["Trace.FileSize"]</div>
                <div class="trace-summary__value">{{formatBytes(fileSize)}}</div>
            </el-card>
        </el-col>
    </el-row>

    <el-card shadow="never" class="trace-filter-card">
        <el-row :gutter="12">
            <el-col :xs="24" :sm="12" :lg="8">
                <el-input v-model="filterConditions.keyword"
                          prefix-icon="el-icon-search"
                          :placeholder="ncfT('Trace.KeywordPlaceholder')"
                          clearable
                          @@input="scheduleFetch"></el-input>
            </el-col>
            <el-col :xs="24" :sm="12" :lg="8">
                <el-date-picker v-model="filterConditions.timeRange"
                                type="datetimerange"
                                class="trace-full-width"
                                :picker-options="pickerOptions"
                                :range-separator="ncfT('Trace.To')"
                                :start-placeholder="ncfT('Trace.StartTime')"
                                :end-placeholder="ncfT('Trace.EndTime')"
                                @@change="fetchData"
                                align="right"></el-date-picker>
            </el-col>
            <el-col :xs="24" :sm="8" :lg="4">
                <el-select v-model="filterConditions.threadId"
                           class="trace-full-width"
                           :placeholder="ncfT('Trace.SelectThread')"
                           clearable
                           @@change="fetchData">
                    <el-option v-for="thread in availableThreads" :key="thread" :label="thread" :value="thread"></el-option>
                </el-select>
            </el-col>
            <el-col :xs="24" :sm="8" :lg="4">
                <el-select v-model="filterConditions.traceType"
                           class="trace-full-width"
                           :placeholder="ncfT('Trace.SelectType')"
                           clearable
                           @@change="fetchData">
                    <el-option v-for="item in traceTypes" :key="item.value" :label="item.label" :value="item.value"></el-option>
                </el-select>
            </el-col>
            <el-col :xs="24" :sm="8" :lg="4">
                <el-select v-model="filterConditions.exceptionStatus"
                           class="trace-full-width"
                           :placeholder="ncfT('Trace.ExceptionStatus')"
                           clearable
                           @@change="fetchData">
                    <el-option :label="ncfT('Xncf.Yes')" value="true"></el-option>
                    <el-option :label="ncfT('Xncf.No')" value="false"></el-option>
                </el-select>
            </el-col>
            <el-col :xs="24" class="trace-filter-actions">
                <el-button icon="el-icon-refresh" @@click="fetchData">@AR["Trace.Refresh"]</el-button>
                <el-button @@click="resetFilters">@AR["Trace.Reset"]</el-button>
            </el-col>
        </el-row>
    </el-card>

    <el-card shadow="never" class="trace-table-card">
        <el-table :data="tableData"
                  border
                  stripe
                  :empty-text="ncfT('Trace.NoData')"
                  @@row-click="openDetail">
            <el-table-column :label="ncfT('Trace.Time')" width="180">
                <template slot-scope="scope">{{scope.row.dateTime}}</template>
            </el-table-column>
            <el-table-column :label="ncfT('Trace.Thread')" width="90" align="center">
                <template slot-scope="scope">{{scope.row.threadId}}</template>
            </el-table-column>
            <el-table-column :label="ncfT('Trace.Type')" width="120" align="center">
                <template slot-scope="scope">
                    <el-tag size="mini" :type="typeTag(scope.row.senparcTraceType)">
                        {{traceTypeText(scope.row.senparcTraceType)}}
                    </el-tag>
                </template>
            </el-table-column>
            <el-table-column :label="ncfT('Trace.Title')" min-width="180">
                <template slot-scope="scope">
                    <span :title="scope.row.title">{{scope.row.title}}</span>
                </template>
            </el-table-column>
            <el-table-column :label="ncfT('Trace.Preview')" min-width="300">
                <template slot-scope="scope">
                    <div class="trace-preview" :title="scope.row.preview">{{scope.row.preview || '-'}}</div>
                </template>
            </el-table-column>
            <el-table-column :label="ncfT('Trace.NumberAndLine')" width="110" align="center">
                <template slot-scope="scope">{{scope.row.no}} / {{scope.row.line}}</template>
            </el-table-column>
            <el-table-column width="96" align="center">
                <template slot-scope="scope">
                    <el-button type="text" size="mini" @@click.stop="openDetail(scope.row)">
                        {{ncfT('Trace.Details')}}
                    </el-button>
                </template>
            </el-table-column>
        </el-table>

        <pagination :total="searchData.total"
                    :page.sync="searchData.pageIndex"
                    :limit.sync="searchData.pageSize"
                    @@pagination="fetchData"></pagination>
    </el-card>

    <el-drawer :title="ncfT('Trace.Details')"
               :visible.sync="detailVisible"
               direction="rtl"
               size="52%">
        <div class="trace-detail" v-loading="detailLoading">
            <div class="trace-detail__meta">
                <el-tag size="small" :type="typeTag(detail.senparcTraceType)">
                    {{traceTypeText(detail.senparcTraceType)}}
                </el-tag>
                <span>{{detail.dateTime}}</span>
                <span>@AR["Trace.Thread"] {{detail.threadId}}</span>
                <span>@AR["Trace.NumberAndLine"] {{detail.line}}</span>
            </div>
            <h3>{{detail.title}}</h3>
            <el-alert v-if="detail.url" :title="detail.url" type="info" :closable="false"></el-alert>
            <section v-if="detail.exceptionMessage">
                <h4>@AR["Trace.ExceptionInfo"]</h4>
                <pre>{{detail.exceptionMessage}}</pre>
            </section>
            <section v-if="detail.exceptionStackTrace">
                <h4>@AR["Trace.ExceptionStackTrace"]</h4>
                <pre>{{detail.exceptionStackTrace}}</pre>
            </section>
            <section v-if="detail.postData">
                <h4>@AR["Trace.PostData"]</h4>
                <pre>{{detail.postData}}</pre>
            </section>
            <section v-if="detail.result">
                <h4>@AR["Trace.ReturnResult"]</h4>
                <pre>{{detail.result}}</pre>
            </section>
            <section>
                <div class="trace-detail__heading">
                    <h4>@AR["Trace.Content"]</h4>
                    <el-button size="mini" icon="el-icon-document-copy" @@click="copyDetail">
                        {{copied ? ncfT('Trace.Copied') : ncfT('Trace.Copy')}}
                    </el-button>
                </div>
                <pre>{{detail.totalResult}}</pre>
            </section>
        </div>
    </el-drawer>
</div>

@section scripts {
    <script src="~/js/Admin/Pages/SenparcTrace/detail.js"></script>
}
