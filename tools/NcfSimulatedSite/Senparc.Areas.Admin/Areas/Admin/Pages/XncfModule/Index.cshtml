@page
@model Senparc.Areas.Admin.Areas.Admin.Pages.XncfModuleIndexModel
@using Senparc.Ncf.Core.Areas;
@using Senparc.Ncf.XncfBase;
@{
    ViewData["Title"] = AR["Xncf.Management"];
    Layout = "_Layout_Vue";
}
@section Style {
    <link href="~/css/Admin/XncfModule/XncfModule.css" rel="stylesheet" />
}
@section breadcrumbs {
    <el-breadcrumb-item>@AR["Xncf.Extensions"]</el-breadcrumb-item>
    <el-breadcrumb-item>@AR["Xncf.Management"]</el-breadcrumb-item>
}
<div class="common-layout">
    <el-container>
        <el-header height="50px">
            <div class="filter-container" style="text-align: right; margin-top:10px">
                <el-popconfirm placement="top" :title="handlerTips" @@on-confirm="handleSwitch">
                    <el-button size="mini" type="danger" slot="reference">{{handlerText}}</el-button>
                </el-popconfirm>
            </div>
        </el-header>
        <el-main>
            <el-tabs type="border-card" class="demo-tabs">
                <el-tab-pane>
                    <template #label>
                        @AR["Xncf.NewModules"]<sup class="el-badge__content">{{newTableData.length}}</sup>
                    </template>
                    <template #add-icon>
                        <el-popconfirm placement="top" :title="handlerTips" @@on-confirm="handleSwitch">
                            <el-button size="mini" type="danger" slot="reference">{{handlerText}}</el-button>
                        </el-popconfirm>
                    </template>
                    <el-table :data="newTableData.filter(data => !newTableSearch || data.name.includes(newTableSearch))"
                                style="width: 100%;margin-bottom: 20px;">
                        <el-table-column align="left" label="@AR["Xncf.ModuleName"]">
                            <template slot-scope="scope">
                                <i class="fa fa-cubes"></i>
                                {{scope.row.name}}
                            </template>
                        </el-table-column>
                        <el-table-column align="center" label="@AR["Xncf.DisplayName"]">
                            <template slot-scope="scope">
                                <i :class="scope.row.icon"></i>
                                {{scope.row.menuName}}

                            </template>
                        </el-table-column>
                        <el-table-column align="center" label="@AR["Xncf.Version"]">
                            <template slot-scope="scope">
                                <i class="fa fa-code-fork"></i>
                                {{scope.row.version}}
                            </template>
                        </el-table-column>
                        <el-table-column align="center" label="@AR["Xncf.Uid"]" width="350">
                            <template slot-scope="scope">
                                <i class="fa fa-shield"></i>
                                {{scope.row.uid}}
                            </template>
                        </el-table-column>
                        <el-table-column label="@AR["Common.操作"]" width="95">
                            <template slot="header" slot-scope="scope">
                                <el-input v-model="newTableSearch"
                                            size="mini"
                                            placeholder="@AR["Xncf.SearchPlaceholder"]" />
                            </template>
                            <template slot-scope="scope">
                                <el-button size="mini"
                                            type="primary"
                                            icon="el-icon-circle-plus"
                                            @@click="handleInstall(scope.$index, scope.row)">@AR["Xncf.Install"]</el-button>
                            </template>
                        </el-table-column>
                    </el-table>
                </el-tab-pane>
                <el-tab-pane label="@AR["Xncf.InstalledModules"]">
                    <el-table :data="oldTableData.filter(data => !oldTableSearch || data.xncfModule.name.includes(oldTableSearch))"
                                v-if="oldTableData.length>0"
                                style="width: 100%;margin-bottom: 20px;">
                        <el-table-column align="left" label="@AR["Xncf.DisplayNameAndVersion"]">
                            <template slot-scope="scope">
                                <div>
                                    <i :class="scope.row.xncfRegister?scope.row.xncfRegister.icon:'fa fa-chain-broken'"></i>
                                    {{scope.row.xncfModule.menuName}}
                                </div>
                                <div>
                                    <i class="fa fa-code-fork"></i>
                                    v{{scope.row.xncfModule.version}}
                                </div>
                            </template>
                        </el-table-column>
                        <el-table-column align="center" label="@AR["Xncf.ModuleNameAndUid"]" width="350">
                            <template slot-scope="scope">
                                <div>
                                    <i class="fa fa-cubes"></i>
                                    {{scope.row.xncfModule.name}}
                                </div>
                                <div>
                                    <i class="fa fa-shield"></i>
                                    {{scope.row.xncfModule.uid}}
                                </div>
                            </template>
                        </el-table-column>
                        <el-table-column align="center" label="@AR["Xncf.Status"]">
                            <template slot-scope="scope">
                                {{oldData.state[scope.row.xncfModule.state]}}
                            </template>
                        </el-table-column>
                        <el-table-column align="center" label="@AR["Common.添加时间"]">
                            <template slot-scope="scope">
                                {{formaTableTime(scope.row.xncfModule.addTime)}}
                            </template>
                        </el-table-column>
                        <el-table-column label="@AR["Common.操作"]" width="185">
                            <template slot="header" slot-scope="scope">
                                <el-input v-model="oldTableSearch"
                                            size="mini"
                                            placeholder="@AR["Xncf.SearchPlaceholder"]" />
                            </template>
                            <template slot-scope="scope">
                                <el-button size="mini"
                                            icon="el-icon-s-tools"
                                            type="primary"
                                            v-if="scope.row.xncfRegister!==null"
                                            @@click="handleHandle(scope.$index, scope.row)">@AR["Common.操作"]</el-button>
                                <el-button size="mini"
                                            v-if="scope.row.xncfRegister!==null&&scope.row.xncfRegister.homeUrl"
                                            icon="el-icon-s-home"
                                            type="primary"
                                            @@click="handleIndex(scope.$index, scope.row)">@AR["Xncf.Home"]</el-button>
                                <div v-if="scope.row.xncfRegister===null">
                                    <span>@AR["Xncf.AssemblyMissing"]</span>
                                    @*  <span>
                                <el-button size="mini"
                                            icon="el-icon-s-home"
                                            type="primary"
                                            @@click="remove(scope.$index, scope.row)">@AR["Xncf.Home"]</el-button>
                            </span> *@
                                </div>
                            </template>
                        </el-table-column>
                    </el-table>
                </el-tab-pane>
                <el-tab-pane>
                    <template #label>
                        @AR["Xncf.PendingUpdates"]<sup class="el-badge__content">{{updatedTableData.length}}</sup>
                    </template>
                    <template #add-icon>
                        <el-popconfirm placement="top" :title="handlerTips" @@on-confirm="handleSwitch">
                            <el-button size="mini" type="danger" slot="reference">{{handlerText}}</el-button>
                        </el-popconfirm>
                    </template>
                    <div style="text-align: right; margin-bottom: 12px;">
                        <el-button type="primary"
                                   icon="el-icon-refresh"
                                   :disabled="updatedTableData.length === 0"
                                   @@click="openBatchUpdate">
                            @AR["Xncf.BatchUpdate"] ({{updatedTableData.length}})
                        </el-button>
                    </div>
                    <el-table :data="updatedTableData.filter(data => !newTableSearch || data.name.includes(newTableSearch))"
                              style="width: 100%;margin-bottom: 20px;">
                        <el-table-column align="left" label="@AR["Xncf.ModuleName"]">
                            <template slot-scope="scope">
                                <i class="fa fa-cubes"></i>
                                {{scope.row.name}}
                            </template>
                        </el-table-column>
                        <el-table-column align="center" label="@AR["Xncf.DisplayName"]">
                            <template slot-scope="scope">
                                <i :class="scope.row.icon"></i>
                                {{scope.row.menuName}}

                            </template>
                        </el-table-column>
                        <el-table-column align="center" label="@AR["Xncf.Version"]">
                            <template slot-scope="scope">
                                <i class="fa fa-code-fork"></i>
                                {{scope.row.version}}
                            </template>
                        </el-table-column>
                        <el-table-column align="center" label="@AR["Xncf.Uid"]" width="350">
                            <template slot-scope="scope">
                                <i class="fa fa-shield"></i>
                                {{scope.row.uid}}
                            </template>
                        </el-table-column>
                        <el-table-column label="@AR["Common.操作"]" width="95">
                            <template slot="header" slot-scope="scope">
                                <el-input v-model="newTableSearch"
                                          size="mini"
                                          placeholder="@AR["Xncf.SearchPlaceholder"]" />
                            </template>
                            <template slot-scope="scope">
                                <el-button size="mini"
                                           type="primary"
                                           icon="el-icon-circle-plus"
                                           @@click="handleInstall(scope.$index, scope.row)">@AR["Xncf.Install"]</el-button>
                            </template>
                        </el-table-column>
                    </el-table>
                </el-tab-pane>
            </el-tabs>
        </el-main>
    </el-container>

    <el-dialog title="@AR["Xncf.BatchUpdateTitle"]"
               :visible.sync="batchUpdate.visible"
               :close-on-click-modal="false"
               width="480px">
        <p>{{ncfT('Xncf.BatchUpdateConfirm', updatedTableData.length)}}</p>
        <el-form label-width="150px">
            <el-form-item label="@AR["Xncf.EnableAfterUpdate"]">
                <el-switch v-model="batchUpdate.enableAfterUpdate"></el-switch>
                <p style="margin: 4px 0 0; color: #909399; line-height: 1.5;">
                    @AR["Xncf.EnableAfterUpdateTip"]
                </p>
            </el-form-item>
        </el-form>
        <span slot="footer" class="dialog-footer">
            <el-button @@click="batchUpdate.visible = false" :disabled="batchUpdate.loading">@AR["Common.取消"]</el-button>
            <el-button type="primary"
                       @@click="handleBatchUpdate"
                       :loading="batchUpdate.loading"
                       :disabled="batchUpdate.loading">
                {{batchUpdate.loading ? ncfT('Xncf.BatchUpdating') : ncfT('Common.确认')}}
            </el-button>
        </span>
    </el-dialog>

    <el-dialog title="@AR["Xncf.BatchUpdateResult"]"
               :visible.sync="batchUpdate.resultVisible"
               :close-on-click-modal="false"
               width="720px">
        <template v-if="batchUpdate.result">
            <el-alert :title="ncfT('Xncf.BatchUpdateSummary', batchUpdate.result.totalCount, batchUpdate.result.successCount, batchUpdate.result.failureCount)"
                      :type="batchUpdate.result.failureCount === 0 ? 'success' : 'warning'"
                      :closable="false"
                      show-icon>
            </el-alert>
            <el-table :data="batchUpdate.result.items" style="width: 100%; margin-top: 16px;" max-height="420">
                <el-table-column prop="moduleName" label="@AR["Xncf.DisplayName"]" min-width="150"></el-table-column>
                <el-table-column label="@AR["Xncf.Version"]" min-width="140">
                    <template slot-scope="scope">
                        {{scope.row.currentVersion}} → {{scope.row.targetVersion}}
                    </template>
                </el-table-column>
                <el-table-column label="@AR["Xncf.Status"]" width="100">
                    <template slot-scope="scope">
                        <el-tag :type="scope.row.success ? 'success' : 'danger'">
                            {{scope.row.success ? ncfT('Common.Success') : ncfT('Common.Error')}}
                        </el-tag>
                    </template>
                </el-table-column>
                <el-table-column prop="message" label="@AR["Common.说明"]" min-width="220"></el-table-column>
            </el-table>
        </template>
        <span slot="footer" class="dialog-footer">
            <el-button type="primary" @@click="batchUpdate.resultVisible = false">@AR["Xncf.Close"]</el-button>
        </span>
    </el-dialog>
</div>
@section scripts {
    <script src="~/js/Admin/Pages/XncfModule/Index.js"></script>
}
