                     :style="{ top: messageRailMenuTop + 'px' }"
                     @@mouseenter="messageRailMenuHover = true; openMessageRail()">
                    <button v-for="marker in messageRail" :key="'rail-item-' + marker.id" type="button"
                            :class="{ 'is-active': marker.id === messageRailActiveId }"
