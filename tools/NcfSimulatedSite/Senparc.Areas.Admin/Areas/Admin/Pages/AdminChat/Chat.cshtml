                                            class="launcher-workspace-select">
                                            <el-option
                                                v-for="item in availableWorkspaces"
                                                :key="item.id"
                                                :label="item.name + ' (' + item.id + ')'"
                                                :value="item.id"></el-option>
                                        </el-select>
                                        <div class="launcher-popover-options">
                                            <el-checkbox v-model="workspaceWriteEnabled" :disabled="!isSuperAdmin || !selectedWorkspaceId">允许 AI 写入文件</el-checkbox>
                                            <el-checkbox v-model="workspaceCliEnabled" :disabled="!isSuperAdmin || !selectedWorkspaceId || !workspaceWriteEnabled">允许 AI 执行 Python</el-checkbox>
                                            <ncf-doc-help topic="workspace.permissions"></ncf-doc-help>
                                        </div>
                                        <div class="launcher-workspace-help">
                                            Python 仅能执行 Workspace 内的 .py 文件，并优先使用 Workspace 内的 .venv。
                                        </div>
                                    </div>
                                    <button slot="reference" type="button" class="launcher-toolbar-button" :disabled="!isSuperAdmin">
                                        <i class="fa fa-folder-open"></i>
                                        <span>{{ selectedWorkspaceLabel }}</span>
                                        <i class="fa fa-angle-down"></i>
                                    </button>
                                </el-popover>

                                <el-popover
                                    placement="top-start"
                                    width="380"
                                    trigger="click"
                                    popper-class="chat-launcher-popover">
                                    <div class="launcher-popover-content launcher-reference-popover">
                                        <div class="launcher-popover-heading">
                                            <div>
                                                <strong>@AR["Admin.Home.ReferenceModules"]</strong>
                                                <span>为当前对话添加可调用模块或 Workflow</span>
                                            </div>
                                            <el-button size="mini" type="primary" plain @@click="openModuleSelector">
                                                <i class="el-icon-edit"></i> 管理
                                            </el-button>
                                        </div>
                                        <div v-if="referenceSelectionCount > 0" class="launcher-reference-summary">
                                            <el-tag
                                                v-for="module in selectedModules"
                                                :key="module.uid"
                                                closable
                                                @@close="removeModule(module.uid)"
                                                type="info"
                                                class="module-tag">
                                                <i :class="module.icon" aria-hidden="true"></i>
                                                <span class="module-tag-name">{{ module.name }}</span>
                                            </el-tag>
                                            <el-tag
                                                v-for="workflow in selectedWorkflows"
                                                :key="`selected-workflow-${workflow.id}`"
                                                closable
                                                @@close="removeWorkflow(workflow.id)"
                                                type="success"
                                                class="module-tag">
                                                <i class="fa fa-random" aria-hidden="true"></i>
                                                <span class="module-tag-name">{{ workflow.name }}</span>
                                            </el-tag>
                                        </div>
                                        <div v-else class="chat-module-selected-empty">
                                            <i class="fa fa-lightbulb-o"></i>
                                            <span>不引用模块也可以直接开始</span>
                                        </div>
                                    </div>
                                    <button slot="reference" type="button" class="launcher-toolbar-button">
                                        <i class="fa fa-cubes"></i>
                                        <span>引用模块</span>
                                        <span v-if="referenceSelectionCount > 0" class="launcher-toolbar-count">{{ referenceSelectionCount }}</span>
                                        <i class="fa fa-angle-down"></i>
                                    </button>
                                </el-popover>
                            </div>
                        </div>

                        @await Html.PartialAsync("~/Areas/Admin/Pages/Shared/_ChatModuleSelectorDialog.cshtml")
                    </div>
                </el-card>
            </div>
        </el-main>

        <aside
            v-if="currentSessionWorkspaceId && workspacePreviewOpen"
            class="chat-workspace-preview"
            aria-label="Workspace 资产"
            :style="{ width: workspacePreviewWidth + 'px' }">
            <div class="chat-workspace-preview-resizer" @@mousedown="startWorkspacePreviewResize"></div>
            <div class="chat-workspace-preview-header">
                <div>
                    <div class="chat-workspace-preview-title">
                        <i class="fa fa-folder-open"></i>
                        <span>Workspace 资产</span>
                    </div>
                    <div class="chat-workspace-preview-subtitle">
                        {{ currentSessionWorkspaceName || currentSessionWorkspaceId }}
                    </div>
                </div>
                <div class="chat-workspace-preview-actions">
                    <el-button
                        type="text"
                        size="mini"
                        title="展开至最大可用宽度"
                        :disabled="workspacePreviewWidth >= workspacePreviewMaxWidth"
                        @@click="expandWorkspacePreview">
                        <i class="el-icon-full-screen"></i>
                    </el-button>
                    <el-button type="text" size="mini" title="关闭资产面板" @@click="closeWorkspacePreview">
                        <i class="el-icon-close"></i>
                    </el-button>
                </div>
            </div>
            <div class="chat-workspace-preview-toolbar">
                <el-button
                    size="mini"
                    type="text"
                    :disabled="!workspacePreviewPath"
                    @@click="loadWorkspaceEntries(workspaceParentPath(workspacePreviewPath))">
                    <i class="el-icon-back"></i>
                </el-button>
                <span class="chat-workspace-preview-path" :title="workspacePreviewPath || '/'">
                    /{{ workspacePreviewPath || '' }}
                </span>
                <el-button size="mini" type="text" title="下载当前目录 (.zip)"
                    :loading="workspaceDownloading"
                    @@click="downloadWorkspaceEntry(workspacePreviewPath)">
                    <i class="el-icon-download"></i>
                </el-button>
                <el-button size="mini" type="text" title="刷新" @@click="loadWorkspaceEntries(workspacePreviewPath)">
                    <i class="el-icon-refresh"></i>
                </el-button>
            </div>
            <div class="chat-workspace-preview-body">
                <div class="chat-workspace-file-list" v-loading="workspaceEntriesLoading">
                    <button
                        v-for="entry in workspaceEntries"
                        :key="entry.relativePath"
                        type="button"
                        :class="['chat-workspace-file-item', { 'is-selected': workspacePreviewFilePath === entry.relativePath }]"
                        @@click="handleWorkspaceEntryClick(entry)">
                        <i :class="entry.isDirectory ? 'fa fa-folder-o' : workspaceFileIcon(entry.relativePath)"></i>
                        <span class="chat-workspace-file-name" :title="workspaceEntryName(entry.relativePath)">{{ workspaceEntryName(entry.relativePath) }}</span>
                        <span v-if="!entry.isDirectory" class="chat-workspace-file-size">{{ formatWorkspaceFileSize(entry.length) }}</span>
                    </button>
                    <div v-if="!workspaceEntriesLoading && workspaceEntries.length === 0" class="chat-workspace-empty">
                        <i class="fa fa-folder-open-o"></i>
                        <span>当前目录为空</span>
                    </div>
                </div>
                <div v-if="workspacePreviewFilePath" class="chat-workspace-file-preview">
                    <div class="chat-workspace-file-preview-header">
                        <span :title="workspacePreviewFilePath">{{ workspaceEntryName(workspacePreviewFilePath) }}</span>
                        <a v-if="workspacePreviewData && workspacePreviewData.contentType === 'text/html'"
                            :href="workspaceExternalPreviewUrl"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="chat-workspace-preview-action"
                            title="在外部浏览器打开（只读）"
                            aria-label="在外部浏览器打开（只读）">
                            <i class="el-icon-top-right"></i>
                        </a>
                        <el-button
                            v-if="workspacePreviewData && workspacePreviewData.contentType === 'text/html'"
                            type="text" size="mini" title="管理匿名分享"
                            @@click="openWorkspaceShareDialog">
                            <i class="el-icon-share"></i>
                        </el-button>
                        <el-button type="text" size="mini" title="下载 / 另存为"
                            :loading="workspaceDownloading"
                            @@click="downloadWorkspaceEntry(workspacePreviewFilePath)">
                            <i class="el-icon-download"></i>
                        </el-button>
                        <el-button
                            v-if="workspacePreviewCanEdit"
                            type="text"
                            size="mini"
                            title="编辑"
                            aria-label="编辑文件"
                            @@click="beginWorkspacePreviewEdit">
                            <i class="el-icon-edit"></i>
                        </el-button>
                        <el-button
                            v-if="workspacePreviewEditing"
                            type="text"
                            size="mini"
                            title="保存"
                            aria-label="保存文件"
                            :loading="workspacePreviewSaving"
                            :disabled="!workspacePreviewDirty"
                            @@click="saveWorkspacePreview">
                            <i class="el-icon-check"></i>
                        </el-button>
                        <el-button
                            v-if="workspacePreviewEditing"
                            type="text"
                            size="mini"
                            title="取消编辑"
                            aria-label="取消编辑"
                            @@click="cancelWorkspacePreviewEdit">
                            <i class="el-icon-refresh-left"></i>
                        </el-button>
                        <el-tag v-if="workspacePreviewDirty" size="mini" type="warning">未保存</el-tag>
                        <el-button
                            v-if="workspacePreviewIsJson && !workspacePreviewEditing"
                            type="text"
                            size="mini"
                            :title="workspacePreviewJsonTree ? '返回文本' : '树状展开'"
                            :aria-label="workspacePreviewJsonTree ? '返回文本' : '树状展开'"
                            :aria-pressed="workspacePreviewJsonTree ? 'true' : 'false'"
                            @@click="toggleWorkspaceJsonTree">
                            <i class="fa fa-sitemap"></i>
                        </el-button>
                        <el-button
                            v-if="workspacePreviewCanShowSource"
                            type="text"
                            size="mini"
                            :title="workspacePreviewSource ? '查看预览' : '查看源码'"
                            :aria-label="workspacePreviewSource ? '查看预览' : '查看源码'"
                            :aria-pressed="workspacePreviewSource ? 'true' : 'false'"
                            @@click="toggleWorkspacePreviewSource">
                            <i :class="workspacePreviewSource ? 'fa fa-eye' : 'fa fa-code'"></i>
                        </el-button>
                        <el-tag v-if="workspacePreviewData" size="mini" type="info">{{ workspacePreviewData.contentType }}</el-tag>
                    </div>
                    <div v-if="workspacePreviewWindowBar" class="chat-workspace-window-bar">
                        <span>{{ workspacePreviewWindowLabel }}</span>
                        <div class="chat-workspace-window-actions">
                            <el-button
                                v-if="workspacePreviewData.windowed"
                                size="mini"
                                :disabled="(workspacePreviewData.startLine || 1) <= 1 || workspacePreviewWindowLoading"
                                @@click="loadWorkspacePreviewWindow((workspacePreviewData.startLine || 1) - 800)">上一段</el-button>
                            <el-button
                                v-if="workspacePreviewData.windowed"
                                size="mini"
                                :disabled="!workspacePreviewData.hasMore || workspacePreviewWindowLoading"
                                @@click="loadWorkspacePreviewWindow(workspacePreviewWindowEnd + 1)">下一段</el-button>
                            <input
                                class="chat-workspace-line-jump"
                                type="number"
                                min="1"
                                v-model.number="workspacePreviewJumpLine"
                                aria-label="跳转到行"
                                @@keydown.enter.prevent="jumpWorkspacePreviewLine" />
                            <el-button size="mini" :loading="workspacePreviewWindowLoading" @@click="jumpWorkspacePreviewLine">跳转</el-button>
                        </div>
                    </div>
                    <div v-if="workspacePreviewLoading" class="chat-workspace-preview-loading">
                        <i class="el-icon-loading"></i> 正在加载预览…
                    </div>
                    <textarea
                        v-else-if="workspacePreviewEditing"
                        v-model="workspacePreviewDraft"
                        class="chat-workspace-text-editor"
                        spellcheck="false"
                        :aria-label="'编辑 ' + workspaceEntryName(workspacePreviewFilePath)"
                        @@keydown.ctrl.s.prevent="saveWorkspacePreview"
                        @@keydown.meta.s.prevent="saveWorkspacePreview"></textarea>
                    <pre v-else-if="workspacePreviewData && workspacePreviewSource && workspacePreviewData.isText" class="chat-workspace-text-preview">{{ workspacePreviewData.content }}</pre>
                    <div v-else-if="workspacePreviewJsonTree && workspaceJsonRoot" class="chat-workspace-json-tree" role="tree">
                        <div
                            v-for="row in workspaceJsonRows()"
                            :key="row.id"
                            class="json-row"
                            :style="{ paddingLeft: (row.depth * 16) + 'px' }"
                            role="treeitem">
                            <button v-if="row.more" type="button" class="json-more" @@click="showMoreWorkspaceJson(row.node)">还有 {{ row.remaining }} 项</button>
                            <template v-else>
                                <button
                                    v-if="row.node.size != null && !row.closing"
                                    type="button"
                                    class="json-toggle"
                                    :aria-expanded="row.node.open ? 'true' : 'false'"
                                    @@click="toggleWorkspaceJson(row.node)">{{ row.node.open ? '▾' : '▸' }}</button>
                                <span v-else class="json-toggle-spacer"></span>
                                <span v-if="row.node.key != null && !row.closing" class="json-key">{{ jsonKeyLabel(row.node) }}</span>
                                <span v-if="row.node.key != null && !row.closing" class="json-colon">:</span>
                                <span :class="jsonValueClass(row)" :title="jsonRowTitle(row)">{{ jsonRowText(row) }}</span>
                            </template>
                        </div>
                    </div>
                    <pre v-else-if="workspacePreviewShowsLines && !workspacePreviewVirtual" class="chat-workspace-code-block"><code v-html="workspacePreviewCodeHtml"></code></pre>
                    <div
                        v-else-if="workspacePreviewShowsLines && workspacePreviewVirtual"
                        ref="workspaceLineScroller"
                        class="chat-workspace-lines"
                        @@scroll="onWorkspaceLineScroll">
                        <div :style="{ height: (workspacePreviewLineOffset * 20) + 'px' }"></div>
                        <div
                            v-for="line in visibleWorkspaceLines()"
                            :key="line.number"
                            class="chat-workspace-line"
                            :data-ln="line.number"><span class="chat-workspace-line-text" v-html="line.html"></span></div>
                        <div :style="{ height: workspaceLineBottomPad + 'px' }"></div>
                    </div>
                    <iframe
                        v-else-if="workspacePreviewIsDocument"
                        class="chat-workspace-html-frame"
                        sandbox="allow-scripts"
                        :srcdoc="workspacePreviewSrcdoc"
                        :title="workspacePreviewFrameTitle"></iframe>
                    <div v-else-if="workspacePreviewData && workspacePreviewData.contentType.indexOf('image/') === 0" class="chat-workspace-image-preview">
                        <img :src="workspacePreviewDataUrl()" :alt="workspacePreviewFilePath" />
                    </div>
                    <iframe
                        v-else-if="workspacePreviewData && workspacePreviewData.contentType === 'application/pdf'"
                        class="chat-workspace-html-frame"
                        :src="workspacePreviewDataUrl()"
                        title="Workspace PDF 预览"></iframe>
                    <pre v-else-if="workspacePreviewData && workspacePreviewData.isText" class="chat-workspace-text-preview">{{ workspacePreviewData.content }}</pre>
                    <div v-else-if="workspacePreviewData" class="chat-workspace-binary-preview">
                        <i class="fa fa-file-o"></i>
                        <span>此文件类型暂不支持文本预览</span>
                    </div>
                </div>
            </div>
        </aside>
    </el-container>
    <el-dialog title="HTML 匿名快照分享" :visible.sync="workspaceShareDialogVisible"
        width="560px" append-to-body custom-class="workspace-share-dialog">
        <el-alert type="warning" :closable="false"
            title="任何持有链接的人都能查看此快照。"
            description="只发布选中的 HTML 及其所在目录内引用的静态资源，不公开 Workspace 目录。脚本仅在无同源权限的隔离沙箱中运行，表单、网络请求、外部资源和页面跳转已禁用。后续修改不会同步；撤销无法收回已经保存的副本。">
        </el-alert>
        <div class="workspace-share-heading">{{ workspaceSharePath }}</div>
        <div class="workspace-share-create">
            <el-select v-model="workspaceShareHours" size="small" aria-label="分享有效期">
                <el-option :value="1" label="1 小时"></el-option>
                <el-option :value="24" label="24 小时"></el-option>
                <el-option :value="168" label="7 天"></el-option>
            </el-select>
            <el-button type="primary" size="small" :loading="workspaceShareCreating"
                @@click="createWorkspaceShare">创建只读快照链接</el-button>
        </div>
        <div v-loading="workspaceSharesLoading" class="workspace-share-list">
            <div v-for="share in workspaceShares" :key="share.id" class="workspace-share-item">
                <div class="workspace-share-details">
                    <div>到期：{{ new Date(share.expiresAt).toLocaleString() }}</div>
                    <el-input :value="workspaceShareAbsoluteUrl(share.url)" readonly size="mini"
                        label="匿名快照链接"
                        @@focus="$event.target.select()"></el-input>
                </div>
                <el-button type="text" size="mini" @@click="copyWorkspaceShareLink(share)">复制</el-button>
                <el-button type="text" size="mini" :loading="workspaceShareRevoking === share.id"
                    @@click="revokeWorkspaceShare(share)">撤销</el-button>
            </div>
            <div v-if="!workspaceSharesLoading && workspaceShares.length === 0" class="chat-workspace-empty">
                暂无有效分享
            </div>
        </div>
        <span slot="footer">
            <el-button @@click="workspaceShareDialogVisible = false">关闭</el-button>
        </span>
    </el-dialog>
    <el-dialog
        title="新建 Workspace"
        :visible.sync="createWorkspaceDialogVisible"
        width="460px"
        append-to-body>
        <el-form label-position="top" @@submit.native.prevent="submitCreateWorkspace">
            <el-form-item label="Workspace 名称">
                <el-input
                    v-model="createWorkspaceName"
                    maxlength="100"
                    show-word-limit
                    autofocus
                    placeholder="例如：Yield C# 示例项目"
                    @@keyup.enter.native="submitCreateWorkspace">
                </el-input>
            </el-form-item>
        </el-form>
        <span slot="footer">
            <el-button @@click="createWorkspaceDialogVisible = false">取消</el-button>
            <el-button type="primary" :loading="creatingWorkspace" @@click="submitCreateWorkspace">创建</el-button>
        </span>
    </el-dialog>
    <el-dialog
        title="Harness 任务轨迹"
        :visible.sync="trajectoryDialogVisible"
        width="760px"
        custom-class="trajectory-dialog">
        <div class="trajectory-toolbar">
            <el-input
                v-model="trajectorySearchText"
                clearable
                size="small"
                placeholder="检索轨迹、工具或结果"
                @@keyup.enter.native="searchTrajectories">
                <el-button slot="append" icon="el-icon-search" @@click="searchTrajectories"></el-button>
            </el-input>
        </div>
        <div class="trajectory-list" v-loading="trajectoryLoading">
            <div
                v-for="trajectory in trajectoryList"
                :key="trajectory.id"
                :class="['trajectory-list-item', { active: selectedTrajectory && selectedTrajectory.id === trajectory.id }]"
                @@click="openTrajectory(trajectory.id)">
                <div>
                    <strong>{{ trajectory.title }}</strong>
                    <span class="trajectory-status">{{ trajectoryStatusLabel(trajectory.status) }}</span>
                </div>
                <small>#{{ trajectory.id }} · {{ trajectory.lastSequence }} events · {{ formatTime(trajectory.startedAt) }}</small>
            </div>
            <div v-if="trajectoryList.length === 0 && !trajectoryLoading" class="trajectory-empty">暂无 Harness 轨迹</div>
        </div>
        <div class="trajectory-detail" v-if="selectedTrajectory" v-loading="trajectoryDetailLoading">
            <div class="trajectory-detail-head">
                <div>
                    <strong>{{ selectedTrajectory.title }}</strong>
                    <span class="trajectory-status">{{ trajectoryStatusLabel(selectedTrajectory.status) }}</span>
                </div>
                <div class="trajectory-detail-actions">
                    <el-button size="mini" @@click="toggleTrajectoryReplay">
                        <i :class="replayPlaying ? 'fa fa-pause' : 'fa fa-play-circle'"></i>
                        {{ replayPlaying ? '暂停回放' : '回放' }}
                    </el-button>
                    <el-button size="mini" type="primary" @@click="resumeSelectedTrajectory">
                        <i class="fa fa-play"></i> 恢复
                    </el-button>
                    <el-button size="mini" @@click="forkSelectedTrajectory">
                        <i class="fa fa-code-fork"></i> 分叉
                    </el-button>
                </div>
            </div>
            <div class="trajectory-replay-banner" v-if="replayEvent">
                <span>回放事件 #{{ replayEvent.sequence }} · {{ replayEvent.eventType }}</span>
                <strong v-if="replayEvent.name">{{ replayEvent.name }}</strong>
                <div v-if="replayEvent.content">{{ replayEvent.content }}</div>
            </div>
            <div ref="trajectoryTimeline" class="trajectory-timeline">
                <el-timeline>
                    <el-timeline-item
                        v-for="event in selectedTrajectoryEvents"
                        :key="event.id || event.sequence"
                        :timestamp="formatTime(event.occurredAt)"
                        placement="top">
                        <div
                            :id="trajectoryEventDomId(event.sequence)"
                            :class="['trajectory-event', { 'is-replay-current': replayEvent && replayEvent.sequence === event.sequence }]"
                            @@click="selectReplayEvent(selectedTrajectoryEvents.indexOf(event))">
                            <div class="trajectory-event-title">
                                <span>#{{ event.sequence }} {{ trajectoryEventLabel(event.eventType) }}</span>
                                <strong v-if="event.name">{{ event.name }}</strong>
                            </div>
                            <div class="trajectory-event-content" v-if="event.content">{{ event.content }}</div>
                            <pre class="trajectory-event-payload" v-if="event.payloadJson">{{ formatTrajectoryPayload(event.payloadJson) }}</pre>
                        </div>
                    </el-timeline-item>
                </el-timeline>
            </div>
        </div>
    </el-dialog>

    <el-dialog :title="ncfT('AdminChat.Memory.Settings')" :visible.sync="memoryDialogVisible"
               width="960px" top="6vh" custom-class="chat-memory-dialog" :close-on-click-modal="false" append-to-body>
        <div slot="title" class="chat-memory-heading">
            <span class="chat-memory-heading-icon"><i class="el-icon-collection" aria-hidden="true"></i></span>
            <div>
                <h2>@AR["AdminChat.Memory.Settings"]<ncf-doc-help topic="admin.memory"></ncf-doc-help></h2>
                <p>@AR["AdminChat.Memory.Subtitle"]</p>
            </div>
            <span class="chat-memory-private"><i class="el-icon-lock" aria-hidden="true"></i> @AR["AdminChat.Memory.Private"]</span>
        </div>
        <el-tabs v-model="memoryTab">
            <el-tab-pane :label="ncfT('AdminChat.Memory.Entries')" name="entries">
                <div class="chat-memory-panel-heading">
                    <div>
                        <h3>@AR["AdminChat.Memory.Entries"] <span class="chat-memory-count">{{ memoryEntries.length }}</span><ncf-doc-help topic="admin.memory.entries"></ncf-doc-help></h3>
                        <p>@AR["AdminChat.Memory.EntriesHint"]</p>
                    </div>
                    <el-button type="primary" size="small" icon="el-icon-plus" :disabled="memoryBusy" @@click="editMemoryEntry(null)">
                        @AR["AdminChat.Memory.Add"]
                    </el-button>
                </div>
                <details class="chat-memory-help">
                    <summary><i class="el-icon-info" aria-hidden="true"></i> @AR["AdminChat.Memory.Guide"]</summary>
                    <p>@AR["AdminChat.Memory.ScopeNotice"]</p>
                    <p>@AR["AdminChat.Memory.Notice"]</p>
                    <p>@AR["AdminChat.Memory.StorageNotice"]</p>
                </details>
                <div v-if="memoryEntryDraft" class="chat-memory-entry-editor">
                    <p v-if="memoryProposalReview && memoryProposalReview.draft === memoryEntryDraft" class="chat-memory-caption">
                        @AR["AdminChat.Memory.ReviewNotice"]
                    </p>
                    <details v-if="memoryProposalReview && memoryProposalReview.draft === memoryEntryDraft" class="chat-memory-help">
                        <summary>@AR["AdminChat.Memory.CandidateEvidence"]</summary>
                        <p>{{ memoryProposalReview.proposal.entry.evidence }}</p>
                    </details>
                    <el-form label-position="top" size="mini">
                        <el-form-item :label="ncfT('AdminChat.Memory.Text')">
                            <el-input type="textarea" :rows="3" :maxlength="300" v-model="memoryEntryDraft.text"></el-input>
                        </el-form-item>
                        <div class="chat-memory-entry-options">
                            <el-form-item :label="ncfT('AdminChat.Memory.Scope')">
                                <el-select v-model="memoryEntryDraft.scope">
                                    <el-option :label="ncfT('AdminChat.Memory.ScopeGlobal')" value="global"></el-option>
                                    <el-option label="Workspace" value="workspace" :disabled="!memoryWorkspaceId"></el-option>
                                </el-select>
                            </el-form-item>
                            <el-form-item :label="ncfT('AdminChat.Memory.Tier')">
                                <el-select v-model="memoryEntryDraft.tier">
                                    <el-option v-for="tier in ['core','topic','archive']" :key="tier" :label="tier" :value="tier"></el-option>
                                </el-select>
                            </el-form-item>
                            <el-form-item :label="ncfT('AdminChat.Memory.Kind')">
                                <el-select v-model="memoryEntryDraft.kind">
                                    <el-option v-for="kind in ['preference','project','decision','reference']" :key="kind" :label="kind" :value="kind"></el-option>
                                </el-select>
                            </el-form-item>
                            <el-form-item :label="ncfT('AdminChat.Memory.Topic')">
                                <el-input :maxlength="40" v-model="memoryEntryDraft.topic"></el-input>
                            </el-form-item>
                            <el-form-item :label="ncfT('AdminChat.Memory.Expires')">
                                <el-date-picker v-model="memoryEntryDraft.expiresAt" type="datetime" clearable></el-date-picker>
                            </el-form-item>
                        </div>
                        <el-checkbox v-model="memoryEntryDraft.pinned">@AR["AdminChat.Memory.Pinned"]</el-checkbox>
                    </el-form>
                    <div class="chat-memory-editor-actions">
                    <el-popconfirm v-if="memoryEntryDraft.id" :title="ncfT('AdminChat.Memory.DeleteNotice')" @@on-confirm="saveMemoryEntry(true)">
                        <el-button slot="reference" type="danger" plain size="small" :disabled="memoryBusy">@AR["AdminChat.Memory.Delete"]</el-button>
                    </el-popconfirm>
                    <span class="chat-memory-action-spacer"></span>
                    <el-button size="small" :disabled="memoryBusy" @@click="memoryEntryDraft = null">@AR["Common.取消"]</el-button>
                    <el-button v-if="!memoryProposalReview || memoryProposalReview.draft !== memoryEntryDraft || !memoryProposalReview.proposal.remove"
                               type="primary" size="small" :loading="memoryBusy" @@click="saveMemoryEntry(false)">@AR["AdminChat.Memory.SaveEntry"]</el-button>
                    </div>
                </div>
                <el-table :data="memoryEntries" size="small" :empty-text="ncfT('AdminChat.Memory.EmptyEntries')">
                    <el-table-column type="expand">
                        <template slot-scope="props">
                            <p>{{ props.row.kind }} · {{ props.row.tier }} · v{{ props.row.version }} · {{ props.row.source }}</p>
                            <p v-if="props.row.sourceMessageId">@AR["AdminChat.Memory.Source"]: #{{ props.row.sourceSessionId }} / #{{ props.row.sourceMessageId }}</p>
                            <blockquote>{{ props.row.evidence }}</blockquote>
                            <p v-if="props.row.expiresAt">@AR["AdminChat.Memory.Expires"]: {{ props.row.expiresAt }}</p>
                        </template>
                    </el-table-column>
                    <el-table-column prop="text" :label="ncfT('AdminChat.Memory.Text')"></el-table-column>
                    <el-table-column :label="ncfT('AdminChat.Memory.Scope')" width="110">
                        <template slot-scope="props">
                            <span class="chat-memory-scope" :class="{ 'is-workspace': props.row.workspaceId }">{{ props.row.workspaceId ? 'Workspace' : ncfT('AdminChat.Memory.ScopeGlobal') }}</span>
                        </template>
                    </el-table-column>
                    <el-table-column width="60">
                        <template slot-scope="props">
                            <el-button class="chat-memory-edit-button" type="text" icon="el-icon-edit" :disabled="memoryBusy" :title="ncfT('AdminChat.Memory.Edit')" :aria-label="ncfT('AdminChat.Memory.Edit')" @@click="editMemoryEntry(props.row)"></el-button>
                        </template>
                    </el-table-column>
                </el-table>
            </el-tab-pane>
            <el-tab-pane :label="ncfT('AdminChat.Memory.Loaded')" name="loaded">
                <div class="chat-memory-panel-heading"><h3>@AR["AdminChat.Memory.Loaded"]<ncf-doc-help topic="admin.memory.loaded"></ncf-doc-help></h3></div>
                <details class="chat-memory-help">
                    <summary><i class="el-icon-info" aria-hidden="true"></i> @AR["AdminChat.Memory.Guide"]</summary>
                    <p>@AR["AdminChat.Memory.LoadedNotice"]</p>
                </details>
                <el-alert v-if="memoryUpdateResult && memoryUpdateSessionId === memoryDialogSessionId"
                          :title="memoryUpdateText(memoryUpdateResult)"
                          :type="memoryUpdateResult.status === 'updated' ? 'success' : 'info'" :closable="false"></el-alert>
                <p v-if="memoryUpdateResult && memoryUpdateSessionId === memoryDialogSessionId && memoryUpdateResult.promptCode">
                    PromptCode: {{ memoryUpdateResult.promptCode }}
                </p>
                <template v-if="memoryUsage && memoryUsageSessionId === memoryDialogSessionId">
                    <div class="chat-memory-token-meter"><strong>{{ memoryUsage.tokens }} <small>/ {{ memoryUsage.budget }} tokens</small></strong><span>{{ memoryUsage.counter }}</span></div>
                    <el-table :data="memoryUsage.entries" size="mini">
                        <el-table-column prop="text" :label="ncfT('AdminChat.Memory.Text')"></el-table-column>
                        <el-table-column prop="scope" :label="ncfT('AdminChat.Memory.Scope')" width="100"></el-table-column>
                        <el-table-column prop="reason" :label="ncfT('AdminChat.Memory.Reason')" width="130"></el-table-column>
                    </el-table>
                </template>
                <div v-else class="chat-memory-empty"><i class="el-icon-data-analysis" aria-hidden="true"></i><p>@AR["AdminChat.Memory.EmptyLoaded"]</p></div>
            </el-tab-pane>
            <el-tab-pane :label="ncfT('AdminChat.Memory.History')" name="history">
                <div class="chat-memory-panel-heading"><h3>@AR["AdminChat.Memory.History"]</h3></div>
                <el-table :data="memoryHistory" size="small">
                    <el-table-column prop="at" :label="ncfT('AdminChat.Memory.Time')" width="180"></el-table-column>
                    <el-table-column :label="ncfT('AdminChat.Memory.Text')">
                        <template slot-scope="props">
                            <div>{{ props.row.action }} · v{{ props.row.version }} · {{ props.row.source }}</div>
                            <del v-if="props.row.before">{{ props.row.before.text }}</del>
                            <div v-if="props.row.after">{{ props.row.after.text }}</div>
                        </template>
                    </el-table-column>
                </el-table>
            </el-tab-pane>
            <el-tab-pane :label="ncfT('AdminChat.Memory.Preview')" name="preview">
                <div class="chat-memory-panel-heading"><h3>@AR["AdminChat.Memory.Preview"]</h3></div>
                <p class="chat-memory-caption">@AR["AdminChat.Memory.MarkdownScope"]</p>
                <div class="markdown-body chat-memory-preview"
                     v-html="formatMemoryContent(memoryMarkdown)"></div>
            </el-tab-pane>
            <el-tab-pane :label="ncfT('AdminChat.Memory.Edit')" name="edit">
                <div class="chat-memory-panel-heading"><h3>@AR["AdminChat.Memory.Edit"]<ncf-doc-help topic="admin.memory.markdown"></ncf-doc-help></h3></div>
                <p class="chat-memory-caption">@AR["AdminChat.Memory.MarkdownScope"]</p>
                <details class="chat-memory-help">
                    <summary><i class="el-icon-info" aria-hidden="true"></i> @AR["AdminChat.Memory.FormatGuide"]</summary>
                    <p>@AR["AdminChat.Memory.Format"]</p>
                </details>
                <el-input type="textarea" :rows="14" v-model="memoryMarkdown" :maxlength="32000"
                          :disabled="memoryBusy"></el-input>
            </el-tab-pane>
            <el-tab-pane :label="ncfT('AdminChat.Memory.SystemMessage')" name="system">
                <div class="chat-memory-panel-heading"><h3>@AR["AdminChat.Memory.SystemMessage"]<ncf-doc-help topic="admin.memory.system"></ncf-doc-help></h3></div>
                <p class="chat-memory-caption">@AR["AdminChat.Memory.SystemNotice"]</p>
                <el-input type="textarea" :rows="6" v-model="memorySystemMessage" :maxlength="2000"
                          :disabled="memoryBusy"></el-input>
                <template v-if="isSuperAdmin && globalChatLoaded">
                    <div class="chat-memory-system-divider"></div>
                    <h4>@AR["AdminChat.Memory.GlobalSystem"]</h4>
                    <p class="chat-memory-caption">@AR["AdminChat.Memory.GlobalNotice"]</p>
                    <el-input type="textarea" :rows="6" v-model="globalChatSystemMessage" :maxlength="2000"
                              :disabled="memoryBusy"></el-input>
                    <el-button class="chat-memory-tenant-save" size="small" @@click="saveGlobalChatSystemMessage" :disabled="memoryBusy">
                        @AR["AdminChat.Memory.SaveGlobal"]
                    </el-button>
                </template>
            </el-tab-pane>
        </el-tabs>
        <div slot="footer" class="chat-memory-footer">
            <el-button type="text" size="small" icon="el-icon-download" @@click="downloadMemory">@AR["AdminChat.Memory.Download"]</el-button>
            <span class="chat-memory-action-spacer"></span>
            <el-button v-if="memoryTab === 'edit'" type="danger" plain size="small" :title="ncfT('AdminChat.Memory.Clear')" :disabled="memoryBusy" @@click="memoryMarkdown = '# Memory\n\n## Core\n\n## Archive\n'; memoryTab = 'edit'">
                @AR["AdminChat.Memory.ClearDraft"]
            </el-button>
            <el-button size="small" :disabled="memoryBusy" @@click="memoryDialogVisible = false">@AR["Xncf.CloseDialog"]</el-button>
            <el-button v-if="memoryTab === 'edit' || memoryTab === 'system'" type="primary" size="small" :loading="memoryBusy" @@click="saveMemory">@AR["AdminChat.Memory.SaveChanges"]</el-button>
        </div>
    </el-dialog>

    <!-- 超级管理员：用户用量统计（仅数量，不含内容） -->
    <el-drawer
        :visible.sync="userStatsDrawerVisible"
        :with-close-button="true"
        direction="rtl"
        size="640px"
        custom-class="user-stats-drawer"
        :wrapper-closable="true">
        <div slot="title" class="user-stats-drawer-title">
            <i class="fa fa-data-line"></i> @AR["AdminChat.UserStatsTitle"]
        </div>
        <div class="user-stats-body" v-loading="userStatsLoading">
            <div class="user-stats-tip">
                <i class="el-icon-info"></i>
                <span>@AR["AdminChat.UserStatsTip"]</span>
            </div>
            <el-table
                :data="userStatsList"
                border
                stripe
                size="small"
                style="width: 100%">
                <el-table-column align="center"
                                 label="@AR["AdminChat.UserStatsCol.User"]"
                                 min-width="150">
                    <template slot-scope="scope">
                        <div class="user-stats-user-cell">
                            <div class="user-stats-user-name">{{ scope.row.userName || ('User #' + scope.row.userId) }}</div>
                            <div class="user-stats-user-real" v-if="scope.row.realName">{{ scope.row.realName }}</div>
                        </div>
                    </template>
                </el-table-column>
                <el-table-column align="center"
                                 label="@AR["AdminChat.UserStatsCol.Total"]"
                                 width="80"
                                 prop="totalSessionCount"></el-table-column>
                <el-table-column align="center"
                                 label="@AR["AdminChat.UserStatsCol.Active"]"
                                 width="80"
                                 prop="activeSessionCount"></el-table-column>
                <el-table-column align="center"
                                 label="@AR["AdminChat.UserStatsCol.Archived"]"
                                 width="90"
                                 prop="archivedSessionCount"></el-table-column>
                <el-table-column align="center"
                                 label="@AR["AdminChat.UserStatsCol.Deleted"]"
                                 width="80"
                                 prop="deletedSessionCount"></el-table-column>
                <el-table-column align="center"
                                 label="@AR["AdminChat.UserStatsCol.Messages"]"
                                 width="90"
                                 prop="messageCount"></el-table-column>
                <el-table-column align="center"
                                 label="@AR["AdminChat.UserStatsCol.LastActive"]"
                                 width="150">
                    <template slot-scope="scope">
                        {{ formatTime(scope.row.lastActiveTime) }}
                    </template>
                </el-table-column>
            </el-table>
        </div>
    </el-drawer>
</div>

@section scripts {
    <script src="~/js/Admin/Pages/AdminChat/ChatLauncherMixin.js" asp-append-version="true"></script>
    <script src="~/js/Admin/Pages/AdminChat/WorkspaceMentions.js" asp-append-version="true"></script>
    <script src="~/js/Admin/lib/marked.min.js"></script>
    <script src="~/js/Admin/dompurify.min.js"></script>
    <script>
        window.INITIAL_DATA = {
            sessionId: @Model.SessionId,
            initialMessage: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.InitialMessage ?? string.Empty)),
            currentUserId: @Model.CurrentUserId,
            isSuperAdmin: @(Model.IsSuperAdmin ? "true" : "false"),
            moduleUids: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ModuleUids ?? string.Empty))
        };
    </script>
    <script src="~/js/Admin/Pages/AdminChat/Chat.js" asp-append-version="true"></script>
}
