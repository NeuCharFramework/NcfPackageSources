                    <div class="message-avatar">
                        <i class="fa fa-android"></i>
                    </div>
                    <div class="message-content">
                        <div class="message-meta">
                            <span class="message-role">@AR["AdminChat.RoleAssistant"]</span>
                            <span class="live-run-status">{{ liveStatusText || (chatMode === 'harness' ? '正在规划任务…' : '正在生成回答…') }}</span>
                        </div>
                        <div class="message-text live-generation-text" v-if="liveThinkingText || liveAssistantText">
                            <div v-if="liveThinkingText" class="live-thinking-preview">
                                <div class="live-thinking-label">
                                    <i class="fa fa-lightbulb-o"></i> 正在思考
                                </div>
                                <div ref="liveThinkingPreview" class="live-thinking-content" v-html="formatMessageContent(liveThinkingText)"></div>
                            </div>
                            <div v-if="liveAssistantText" ref="liveAnswerPreview" class="live-answer-preview" v-html="formatMessageContent(liveAssistantText)"></div>
                        </div>
                        <div class="message-text" v-else>
                            <span class="typing-indicator">
                                <span></span><span></span><span></span>
                            </span>
                            @AR["AdminChat.Thinking"]
                        </div>
                        <div v-if="recentTasks.length > 0" class="live-task-list" aria-live="polite">
                            <div
                                v-for="task in recentTasks.slice().reverse()"
                                :key="task.id"
                                class="live-task-item"
                                :title="task.preview ? task.title + '：' + task.preview : task.title">
                                <i :class="task.status === '执行中' || task.status === '生成中' ? 'fa fa-spinner fa-spin' : 'fa fa-check-circle'"></i>
                                <strong>{{ task.title }}</strong>
                                <span v-if="task.preview">：{{ task.preview }}</span>
                                <em>{{ task.status }}</em>
                            </div>
                        </div>
                        <el-collapse v-if="liveTrajectoryEvents.length > 0" class="live-trajectory-collapse">
