                                        <div class="harness-step-head">
                                            <span class="harness-step-index">
                                                <i :class="step.isFinal ? 'fa fa-flag-checkered' : (step.timedOut ? 'fa fa-exclamation-triangle' : 'fa fa-arrow-circle-right')"></i>
                                                {{ step.index }}
