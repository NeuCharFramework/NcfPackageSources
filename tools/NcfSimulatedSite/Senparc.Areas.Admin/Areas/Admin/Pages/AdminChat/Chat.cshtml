                                <template slot="title">
                                    <span>查看实时执行过程</span>
                                    <i class="fa fa-angle-down live-trajectory-toggle"></i>
                                </template>
                                <div v-for="event in liveTrajectoryEvents" :key="`live-${event.correlationId || event.id || event.sequence}`" class="live-trajectory-event">
                                    <div class="live-trajectory-event-title">
                                        <span>{{ trajectoryEventLabel(event.eventType) }}</span>
                                        <strong v-if="event.name">{{ event.name }}</strong>
                                    </div>
                                    <div v-if="event.content" class="live-trajectory-event-content">{{ event.content }}</div>
                                </div>
                            </el-collapse-item>
                        </el-collapse>
                        <div v-if="livePendingApprovals.length > 0" class="live-approval-hint">
                            <i class="fa fa-shield"></i> 等待工具确认
                        </div>
                    </div>
                </div>
