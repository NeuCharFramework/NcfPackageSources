                                size="mini"
                                :class="{ 'active': message.userFeedback === 1 }"
                                @@click="setFeedback(message.id, 1)">
                                <i class="fa fa-thumbs-up"></i>
                            </el-button>
                            <el-button 
                                type="text" 
                                size="mini"
                                :class="{ 'active': message.userFeedback === 2 }"
                                @@click="setFeedback(message.id, 2)">
                                <i class="fa fa-thumbs-down"></i>
                            </el-button>
                        </div>
                    </div>
                </div>

                <el-alert v-if="memoryUpdateResult && memoryUpdateSessionId === currentSessionId && (memoryUpdateResult.requested || memoryUpdateResult.status === 'updated')"
                          class="chat-memory-update-result"
                          :title="memoryUpdateText(memoryUpdateResult)"
                          :type="['updated', 'reviewed'].includes(memoryUpdateResult.status) ? 'success' : ['intent-deferred', 'no-save-intent'].includes(memoryUpdateResult.reason) ? 'info' : 'warning'"
                          :closable="false" show-icon>
                    <el-button type="text" size="mini" :disabled="memoryBusy" @@click="openMemoryDialog">
                        @AR["AdminChat.Memory.Settings"]
                    </el-button>
                    <div v-for="(proposal, index) in (memoryUpdateResult.proposals || [])" :key="index" class="chat-memory-proposal">
                        <span>{{ proposal.remove ? ncfT('AdminChat.Memory.Delete') : ncfT('AdminChat.Memory.ReviewCandidate') }}：
                            {{ proposal.entry.text }}</span>
                        <small>{{ proposal.entry.workspaceId ? 'Workspace' : ncfT('AdminChat.Memory.ScopeGlobal') }}</small>
                        <el-button type="text" size="mini" :disabled="memoryBusy || isCurrentSessionRunning" @@click="reviewMemoryProposal(proposal)">
                            @AR["AdminChat.Memory.ReviewCandidate"]
                        </el-button>
                    </div>
                </el-alert>

                <div v-if="messageList.length === 0 && !loadingMessages" class="empty-messages">
                    <i class="fa fa-comment-o"></i>
                    <p>@AR["AdminChat.StartPrompt"]</p>
                </div>

