@page
@model Senparc.Areas.Admin.Pages.AdminChat.ChatModel
@{
    ViewData["Title"] = AR["Admin.Home.AiTitle"];
    Layout = "_Layout_Vue";
}

@section Style {
    <link rel="stylesheet" href="~/css/Admin/Pages/AdminChat/ChatLauncher.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Admin/Pages/AdminChat/Chat.css" asp-append-version="true" />
}

@section breadcrumbs {
    <el-breadcrumb-item>@AR["Admin.Home.AiTitle"]</el-breadcrumb-item>
    <el-breadcrumb-item>@AR["AdminChat.Conversation"]</el-breadcrumb-item>
}

<div class="admin-chat-container">
    <input ref="workspaceFileInput" type="file" hidden multiple
        accept=".txt,.md,.csv,.tsv,.json,.docx,.xlsx,.pptx,.pdf,.doc,.xls,.ppt,.png,.jpg,.jpeg,.webp"
        @@change="handleWorkspaceFilesSelected" />
    <el-container
        ref="workspaceContainer"
        class="chat-main-container"
        :style="{ '--chat-sidebar-width': sidebarWidth + 'px' }"
        :class="{ 'is-workspace-preview-open': currentSessionWorkspaceId && workspacePreviewOpen, 'is-workspace-preview-overlay': workspacePreviewOverlay }">
        <!-- 左侧会话历史 -->
        <el-aside class="chat-sidebar" :class="{ 'is-collapsed': sidebarCollapsed }">
            <div class="sidebar-heading">
                <span v-show="!sidebarCollapsed">@AR["AdminChat.History"]</span>
                <div class="sidebar-heading-actions">
                    <el-popover v-model="historySearchVisible" placement="bottom-end" trigger="click" width="340"
                                popper-class="chat-history-search-popover" :visible-arrow="false">
                        <div class="chat-history-search" @@click.stop>
                            <div class="chat-history-search-tabs" role="tablist">
                                <button type="button" role="tab" class="chat-history-search-tab"
                                        :class="{ 'is-active': historySearchTab === 'chat' }"
                                        :aria-selected="String(historySearchTab === 'chat')"
                                        @@click="setHistorySearchTab('chat')">
                                    {{ ncfT('AdminChat.Search.ChatTab') }}
                                </button>
                                <button type="button" role="tab" class="chat-history-search-tab"
                                        :class="{ 'is-active': historySearchTab === 'tool' }"
                                        :aria-selected="String(historySearchTab === 'tool')"
                                        @@click="setHistorySearchTab('tool')">
                                    {{ ncfT('AdminChat.Search.ToolTab') }}
                                </button>
                            </div>
                            <div role="tabpanel">
                                <input ref="historySearchInput" v-model="historySearchKeyword" type="search"
                                       class="chat-history-search-input"
                                       :placeholder="ncfT(historySearchTab === 'tool' ? 'AdminChat.Search.ToolPlaceholder' : 'AdminChat.Search.Placeholder')"
                                       :aria-label="ncfT(historySearchTab === 'tool' ? 'AdminChat.Search.ToolPlaceholder' : 'AdminChat.Search.Placeholder')"
                                       @@input="scheduleHistorySearch" />
                                <p class="chat-history-search-hint">{{ ncfT(historySearchTab === 'tool' ? 'AdminChat.Search.ToolHint' : 'AdminChat.Search.Hint') }}</p>
                                <div class="chat-history-search-results" v-loading="historySearchLoading">
                                    <p v-if="historySearchSubmitted && !historySearchLoading && historySearchHits.length === 0"
                                       class="chat-history-search-empty">{{ ncfT('AdminChat.Search.Empty') }}</p>
                                    <button v-for="hit in historySearchHits"
                                            :key="hit.sessionId + '-' + (hit.trajectoryId || 0) + '-' + (hit.eventSequence || 0) + '-' + hit.messageId + '-' + hit.matchKind"
                                            type="button" class="chat-history-search-hit"
                                            :class="{ 'is-tool': isToolSearchHit(hit) }"
                                            @@click="openHistorySearchHit(hit)">
                                        <span class="chat-history-search-title">
                                            <template v-if="highlightParts(hit.title, hit.query).match">{{ highlightParts(hit.title, hit.query).before }}<mark>{{ highlightParts(hit.title, hit.query).match }}</mark>{{ highlightParts(hit.title, hit.query).after }}</template>
                                            <template v-else>{{ hit.title }}</template>
                                        </span>
                                        <span v-if="isTitleSearchHit(hit)" class="chat-history-search-kind">{{ ncfT('AdminChat.Search.TitleMatch') }}</span>
                                        <span v-else class="chat-history-search-snippet">{{ hit.snippetBefore }}<mark>{{ hit.snippetMatch }}</mark>{{ hit.snippetAfter }}</span>
                                        <small v-if="isToolSearchHit(hit)">{{ ncfT('AdminChat.Search.ToolCall') }} · {{ formatTime(hit.occurredAt) }}</small>
                                        <small v-else-if="!isTitleSearchHit(hit)">{{ getRoleTypeName(hit.roleType) }} · {{ formatTime(hit.occurredAt) }}</small>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <button slot="reference" type="button" class="sidebar-toggle sidebar-search-trigger"
                                :aria-expanded="String(historySearchVisible)"
                                :aria-label="ncfT('AdminChat.Search.Open')"
                                :title="ncfT('AdminChat.Search.Open')">
                            <i class="el-icon-search" aria-hidden="true"></i>
                        </button>
                    </el-popover>
                    <button type="button" class="sidebar-toggle"
                            :title="ncfT(sidebarCollapsed ? 'AdminChat.Sidebar.Expand' : 'AdminChat.Sidebar.Collapse')"
                            :aria-label="ncfT(sidebarCollapsed ? 'AdminChat.Sidebar.Expand' : 'AdminChat.Sidebar.Collapse')"
                            :aria-expanded="String(!sidebarCollapsed)" aria-controls="chat-sidebar-body"
                            @@click="toggleSidebar">
                        <i :class="sidebarCollapsed ? 'el-icon-s-unfold' : 'el-icon-s-fold'" aria-hidden="true"></i>
                    </button>
                </div>
                <span v-if="sidebarCollapsed && hasRunningSession" class="sidebar-running-dot"
                      role="status" :aria-label="ncfT('AdminChat.Sidebar.Running')"></span>
                <span v-else-if="sidebarCollapsed && unreadSessionIds.length" class="sidebar-unread-dot"
                      role="status" :aria-label="ncfT('AdminChat.Sidebar.Unread')"></span>
            </div>
            <div id="chat-sidebar-body" class="sidebar-body" v-show="!sidebarCollapsed">
            <div class="sidebar-header">
                <div class="sidebar-actions">
                    <el-button
                        type="primary"
                        size="small"
                        icon="el-icon-plus"
                        @@click="createNewSession">
                        @AR["AdminChat.NewConversation"]
                    </el-button>
                    <el-popover v-model="sidebarToolsVisible" placement="bottom-end" trigger="click"
                                popper-class="chat-sidebar-tools-popover" :visible-arrow="false">
                        <div class="sidebar-tools-panel">
                            <button type="button" class="sidebar-tools-action" :disabled="memoryBusy"
                                    @@click="sidebarToolsVisible = false; openMemoryDialog()">
                                <i class="el-icon-notebook-2" aria-hidden="true"></i>
                                <span>Memory</span>
                            </button>
                            <button v-if="isSuperAdmin" type="button" class="sidebar-tools-action"
                                    @@click="sidebarToolsVisible = false; openUserStatsDrawer()">
                                <i class="el-icon-data-line" aria-hidden="true"></i>
                                <span>@AR["AdminChat.UserStats"]</span>
                            </button>
                            <div class="chat-archive-panel" role="menu" :aria-label="ncfT('AdminChat.Archive.Menu')">
                                <div class="chat-archive-panel-title">
                                    {{ ncfT('AdminChat.Archive.Menu') }}
                                    <em v-if="archivedSessionList.length">{{ archivedSessionList.length }}</em>
                                </div>
                                <div v-if="archivedSessionList.length === 0" class="chat-archive-empty">{{ ncfT('AdminChat.Archive.Empty') }}</div>
                                <div v-else class="chat-archive-list">
                                    <div v-for="session in archivedSessionList" :key="session.id"
                                         :class="['chat-archive-item', { 'is-current': currentSessionId === session.id }]">
                                        <button type="button" class="chat-archive-open" :title="session.title"
                                                :aria-label="ncfT('AdminChat.Archive.Open', session.title)"
                                                @@click="openArchivedSession(session)">
                                            <i class="el-icon-check" aria-hidden="true"></i>
                                            <span>{{ session.title }}</span>
                                            <small>{{ formatTime(session.lastMessageTime) }}</small>
                                        </button>
                                        <button type="button" class="chat-archive-restore"
                                                :disabled="restoringSessionId === session.id"
                                                :title="ncfT('AdminChat.Archive.Restore')"
                                                :aria-label="ncfT('AdminChat.Archive.RestoreLabel', session.title)"
                                                @@click="restoreArchivedSession(session)">
                                            <i class="fa fa-undo" aria-hidden="true"></i>
                                        </button>
                                        <button type="button" class="chat-archive-delete" :title="ncfT('Common.删除')"
                                                :aria-label="ncfT('AdminChat.Archive.Delete', session.title)"
                                                @@click="deleteArchivedSession(session)">
                                            <i class="fa fa-trash" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <button slot="reference" type="button" class="sidebar-tools-trigger"
                                :aria-expanded="String(sidebarToolsVisible)"
                                :aria-label="ncfT('AdminChat.Sidebar.Tools')"
                                :title="ncfT('AdminChat.Sidebar.Tools')">
                            <i class="el-icon-more" aria-hidden="true"></i>
                            <em v-if="archivedSessionList.length">{{ archivedSessionList.length }}</em>
                        </button>
                    </el-popover>
                </div>
            </div>
            
            <div class="session-list" v-loading="loadingSessions">
                <div v-for="group in groupedSessionList" :key="group.key" class="session-group">
                    <button type="button" class="session-group-title"
                            :aria-expanded="String(!isSessionGroupCollapsed(group.key))"
                            :aria-controls="'session-group-' + group.key"
                            @@click="toggleSessionGroup(group.key)">
                        <i :class="isSessionGroupCollapsed(group.key) ? 'el-icon-arrow-right' : 'el-icon-arrow-down'" aria-hidden="true"></i>
                        <i :class="group.key === '__no_workspace__' ? 'fa fa-comments-o' : 'fa fa-folder-open'" aria-hidden="true"></i>
                        <span>{{ group.name }}</span>
                        <span v-if="group.sessions.some(isSessionRunning)" class="sidebar-running-dot"
                              role="status" :aria-label="ncfT('AdminChat.Sidebar.Running')"></span>
                        <span v-else-if="group.sessions.some(isSessionUnread)" class="sidebar-unread-dot"
                              role="status" :aria-label="ncfT('AdminChat.Sidebar.Unread')"></span>
                        <span class="session-group-count">{{ group.sessions.length }}</span>
                    </button>
                    <div :id="'session-group-' + group.key" v-show="!isSessionGroupCollapsed(group.key)">
                    <div
                        v-for="session in group.sessions"
                        :key="session.id"
                        :class="['session-item', { 'active': currentSessionId === session.id, 'is-running': isSessionRunning(session),
                            'is-unread': isSessionUnread(session),
                            'is-dragging': draggingSessionId === session.id,
                            'is-drop-before': dropSessionId === session.id && !dropAfter,
                            'is-drop-after': dropSessionId === session.id && dropAfter }]"
                        @@dragover="handleSessionDragOver($event, session)"
                        @@drop="handleSessionDrop($event, session)"
                        @@click="switchSession(session.id)">
                        <button type="button" class="session-drag-handle" :draggable="!savingSessionOrder"
                                :disabled="savingSessionOrder" :title="ncfT('AdminChat.Sidebar.Reorder')"
                                :aria-label="ncfT('AdminChat.Sidebar.Reorder')"
                                @@click.stop @@dragstart.stop="startSessionDrag($event, session)"
                                @@dragend="endSessionDrag"
                                @@keydown.alt.up.prevent.stop="moveSessionByKeyboard(session, -1)"
                                @@keydown.alt.down.prevent.stop="moveSessionByKeyboard(session, 1)">
                            <i class="el-icon-rank" aria-hidden="true"></i>
                        </button>
                        <div class="session-info">
                            <div class="session-title">{{ session.title }}</div>
                            <div v-if="isSessionRunning(session)" class="session-run-status" role="status">
                                <span class="session-run-bars" aria-hidden="true"><i></i><i></i><i></i></span>
                                {{ ncfT(isStopping ? 'AdminChat.Sidebar.Stopping' : 'AdminChat.Sidebar.Running') }}
                            </div>
                            <div v-else-if="isSessionUnread(session)" class="session-unread-status" role="status">{{ ncfT('AdminChat.Sidebar.Unread') }}</div>
                            <div v-else class="session-time">{{ formatTime(session.lastMessageTime) }}</div>
                        </div>
                        <el-dropdown trigger="click" @@command="handleSessionCommand">
                            <span class="session-actions" @@click.stop>
                                <i class="el-icon-more"></i>
                            </span>
                            <el-dropdown-menu slot="dropdown">
                                <el-dropdown-item :command="{action: 'archive', id: session.id}"
                                                  :disabled="isSessionRunning(session) || !!archivingSessionId"
                                                  :title="ncfT(isSessionRunning(session) ? 'AdminChat.Sidebar.ArchiveRunning' : 'AdminChat.Sidebar.Archive')">
                                    <i class="el-icon-check"></i> {{ ncfT('AdminChat.Archive.Action') }}
                                </el-dropdown-item>
                                <el-dropdown-item :command="{action: 'delete', id: session.id}">
                                    <i class="fa fa-trash"></i> @AR["Common.删除"]
                                </el-dropdown-item>
                            </el-dropdown-menu>
                        </el-dropdown>
                    </div>
                    </div>
                </div>
                
                <div v-if="sessionList.length === 0 && !loadingSessions" class="empty-sessions">
                    <i class="fa fa-comments-o"></i>
                    <p>@AR["AdminChat.EmptyHistory"]</p>
                </div>
            </div>
            </div>
            <div v-show="!sidebarCollapsed" class="chat-sidebar-resizer" role="separator" tabindex="0"
                 aria-orientation="vertical" :aria-label="ncfT('AdminChat.Sidebar.Resize')"
                 :aria-valuenow="sidebarWidth" :aria-valuemin="215" :aria-valuemax="420"
                 @@pointerdown="startSidebarResize"
                 @@keydown.left.prevent="resizeSidebarByKeyboard(-20)"
                 @@keydown.right.prevent="resizeSidebarByKeyboard(20)"></div>
        </el-aside>

        <!-- 右侧对话窗口 -->
        <el-main class="chat-content">
            <div class="chat-header" v-if="currentSessionId">
                <div class="chat-header-info">
                    <div class="chat-header-top">
                        <h3 class="chat-title">
                            <i class="fa fa-magic"></i>
                            <span>{{ currentSessionTitle || ncfT('Admin.Home.AiTitle') }}</span>
                            <el-tag v-if="currentSessionStatus === 1" size="mini" type="success" class="chat-archived-tag">{{ ncfT('AdminChat.Archive.Tag') }}</el-tag>
                        </h3>
                        <div class="chat-header-actions">
                            <ncf-doc-help topic="admin.chat"></ncf-doc-help>
                            <el-button
                                size="mini"
                                :type="isManageMode ? 'default' : 'primary'"
                                @@click="toggleManageMode">
                                {{ isManageMode ? ncfT('AdminChat.Done') : ncfT('AdminChat.Manage') }}
                            </el-button>
                            <el-button
                                size="mini"
                                type="text"
                                title="任务轨迹"
                                @@click="openTrajectoryDialog">
                                <i class="fa fa-road"></i>
                            </el-button>
                            <el-button
                                v-if="currentSessionWorkspaceId"
                                size="mini"
                                :type="workspacePreviewOpen ? 'primary' : 'default'"
                                title="Workspace 资产"
                                @@click="toggleWorkspacePreview">
                                <i class="fa fa-folder-open-o"></i>
                                <span class="chat-workspace-preview-button-label">资产</span>
                            </el-button>
                        </div>
                    </div>
                    <div v-if="currentSessionWorkspaceId" class="chat-context-bar">
                        <div class="chat-workspace-context">
                            <i class="fa fa-folder-open"></i>
                            <span :title="currentSessionWorkspaceId">Workspace：{{ currentSessionWorkspaceName || currentSessionWorkspaceId }}</span>
                            <el-tag size="mini" type="info">当前会话</el-tag>
                            <el-tag v-if="currentSessionWorkspaceWriteEnabled" size="mini" type="warning">可写入</el-tag>
                            <el-tag v-if="currentSessionWorkspaceCliEnabled" size="mini" type="danger">可执行 CLI</el-tag>
                        </div>
                    </div>
                    <div class="chat-modules" v-if="currentSessionModules.length > 0">
                        <el-popover
                            v-for="module in currentSessionModules.slice(0, 3)"
                            :key="module.id"
                            placement="bottom-start"
                            width="420"
                            trigger="hover"
                            popper-class="chat-module-detail-popover">
                            <div class="chat-module-detail-wrapper">
                                <div class="module-selector-preview-title">
                                    <i :class="[resolveModuleDetail(module).icon, 'selector-module-icon']"></i>
                                    <span>{{ resolveModuleDetail(module).name }}</span>
                                    <span class="selector-module-version" v-if="resolveModuleDetail(module).version">v{{ resolveModuleDetail(module).version }}</span>
                                </div>
                                <div class="module-selector-preview-subtitle">{{ resolveModuleDetail(module).description }}</div>

                                <div class="module-selector-preview-body">
                                    <div class="module-selector-preview-section" v-if="resolveModuleDetail(module).menus && resolveModuleDetail(module).menus.length > 0">
                                        <div class="module-selector-preview-section-title">@AR["AdminChat.MenuHierarchy"]</div>
                                        <el-tree
                                            :data="resolveModuleDetail(module).menus"
                                            node-key="id"
                                            :props="{ label: 'name', children: 'children' }"
                                            default-expand-all
                                            class="module-selector-menu-tree">
                                            <span class="custom-tree-node" slot-scope="{ data }">
                                                <a :href="data.url">{{ data.name }}</a>
                                            </span>
                                        </el-tree>
                                    </div>

                                    <div class="module-selector-preview-section" v-if="resolveModuleDetail(module).functions && resolveModuleDetail(module).functions.length > 0">
                                        <div class="module-selector-preview-section-title">@AR["AdminChat.Functions"]</div>
                                        <div class="module-selector-functions-list">
                                            <div v-for="func in resolveModuleDetail(module).functions" :key="func.name" class="module-selector-function-item">
                                                <div class="module-selector-function-name">{{ func.name }}</div>
                                                <div class="module-selector-function-description">{{ func.description }}</div>
                                            </div>
                                        </div>
                                    </div>

                                    <div
                                        class="module-selector-preview-empty"
                                        v-if="(!resolveModuleDetail(module).menus || resolveModuleDetail(module).menus.length === 0) && (!resolveModuleDetail(module).functions || resolveModuleDetail(module).functions.length === 0)">
                                        @AR["AdminChat.NoPreview"]
                                    </div>
                                </div>
                            </div>

                            <el-tag
                                slot="reference"
                                size="mini"
                                type="info"
                                :title="module.moduleDescription || module.xncfModuleUid"
                                class="chat-module-tag-detail">
                                <i class="fa fa-cube"></i>
                                {{ module.displayName || module.menuName || module.moduleName || module.xncfModuleUid }}
                                <span v-if="module.moduleVersion"> v{{ module.moduleVersion }}</span>
                            </el-tag>
                        </el-popover>
                        <el-popover
                            v-if="currentSessionModules.length > 3"
                            placement="bottom-start"
                            width="300"
                            trigger="click">
                            <div class="chat-context-popover-list">
                                <div
                                    v-for="module in currentSessionModules.slice(3)"
                                    :key="`extra-module-${module.id}`"
                                    class="chat-context-popover-item">
                                    <i class="fa fa-cube"></i>
                                    <span>{{ module.displayName || module.menuName || module.moduleName || module.xncfModuleUid }}</span>
                                </div>
                            </div>
                            <el-button slot="reference" size="mini" plain class="chat-context-more">
                                +{{ currentSessionModules.length - 3 }}
                            </el-button>
                        </el-popover>
                    </div>
                    <div class="chat-modules" v-if="currentSessionWorkflows.length > 0">
                        <el-popover
                            v-for="workflow in currentSessionWorkflows.slice(0, 2)"
                            :key="workflow.id"
                            placement="bottom-start"
                            width="360"
                            trigger="hover"
                            popper-class="chat-module-detail-popover">
                            <div class="chat-module-detail-wrapper">
                                <div class="module-selector-preview-title">
                                    <i class="fa fa-random selector-module-icon"></i>
                                    <span>{{ workflow.workflowName }}</span>
                                    <span class="selector-module-version">#{{ workflow.workflowId }}</span>
                                </div>
                                <div class="module-selector-preview-subtitle">{{ workflow.workflowDescription || '已启用 Workflow' }}</div>
                                <div class="module-selector-preview-section" v-if="workflow.parameters && workflow.parameters.length > 0">
                                    <div class="module-selector-preview-section-title">Function Calling 参数</div>
                                    <div class="module-selector-functions-list">
                                        <div v-for="parameter in workflow.parameters"
                                             :key="`session-workflow-${workflow.workflowId}-${parameter.name}`"
                                             class="module-selector-function-item">
                                            <div class="module-selector-function-name">{{ parameter.name }}</div>
                                            <div class="module-selector-function-description">{{ parameter.description || '可选参数' }}</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <el-tag
                                slot="reference"
                                size="mini"
                                type="success"
                                class="chat-workflow-tag">
                                <i class="fa fa-random"></i>
                                {{ workflow.workflowName }}
                            </el-tag>
                        </el-popover>
                        <el-popover
                            v-if="currentSessionWorkflows.length > 2"
                            placement="bottom-start"
                            width="300"
                            trigger="click">
                            <div class="chat-context-popover-list">
                                <div
                                    v-for="workflow in currentSessionWorkflows.slice(2)"
                                    :key="`extra-workflow-${workflow.id}`"
                                    class="chat-context-popover-item">
                                    <i class="fa fa-random"></i>
                                    <span>{{ workflow.workflowName }}</span>
                                </div>
                            </div>
                            <el-button slot="reference" size="mini" plain class="chat-context-more">
                                +{{ currentSessionWorkflows.length - 2 }}
                            </el-button>
                        </el-popover>
                    </div>
                </div>
            </div>

            <div class="messages-stage" v-if="currentSessionId">
            <div class="messages-container" ref="messagesContainer" v-loading="loadingMessages" @@scroll="updateActiveUserMarker">
                <div class="message-manage-toolbar" v-if="isManageMode">
                    <el-checkbox
                        :value="messageList.length > 0 && selectedMessageIds.length === messageList.length"
                        :indeterminate="selectedMessageIds.length > 0 && selectedMessageIds.length < messageList.length"
                        @@change="toggleSelectAllMessages">
                        @AR["AdminChat.SelectAll"]
                    </el-checkbox>
                    <span class="message-manage-count">{{ ncfT('AdminChat.SelectedCount', selectedMessageIds.length) }}</span>
                    <el-button size="mini" @@click="copySelectedMessages" :disabled="selectedMessageIds.length === 0">@AR["AdminChat.Copy"]</el-button>
                    <el-button size="mini" @@click="clearMessageSelection" :disabled="selectedMessageIds.length === 0">@AR["AdminChat.ClearSelection"]</el-button>
                    <el-button size="mini" type="danger" @@click="deleteSelectedMessages" :disabled="selectedMessageIds.length === 0">@AR["Common.删除"]</el-button>
                </div>

                <div 
                    v-for="message in messageList" 
                    :key="message.id"
                    :data-message-id="message.id"
                    :class="['message-item', `message-${getRoleTypeClass(message.roleType)}`, { 'is-selected': isManageMode && isMessageSelected(message.id) }]">
                    <div class="message-select" v-if="isManageMode">
                        <el-checkbox
                            :value="isMessageSelected(message.id)"
                            @@change="() => toggleMessageSelection(message.id)"
                            @@click.native.stop>
                        </el-checkbox>
                    </div>
                    <div class="message-avatar">
                        <i :class="getMessageIcon(message.roleType)"></i>
                    </div>
                    <div class="message-content">
                        <div class="message-meta">
                            <span class="message-role">{{ getRoleTypeName(message.roleType) }}</span>
                            <span class="message-time">{{ formatTime(message.addTime) }}</span>
                        </div>
                        <prompt-reference-content v-if="message.promptReferences && message.promptReferences.length"
                            class="message-text" :content="message.content" :references="message.promptReferences"
                            :ai-score="promptReferenceAiScorer(message)"></prompt-reference-content>
                        <div v-else class="message-text" v-html="formatMessageContent(message.content)"></div>
                        <div v-if="message.attachments && message.attachments.length" class="chat-message-attachments">
                            <button v-for="attachment in message.attachments" :key="attachment.relativePath"
                                type="button" :title="'下载原文件：' + attachment.name"
                                @@click="downloadWorkspaceEntry(attachment.relativePath)">
                                <i :class="workspaceFileIcon(attachment.relativePath)"></i>
                                <span>{{ attachment.name }}</span>
