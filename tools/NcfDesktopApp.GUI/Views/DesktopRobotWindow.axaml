<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NcfDesktopApp.GUI.ViewModels"
        x:Class="NcfDesktopApp.GUI.Views.DesktopRobotWindow"
        x:DataType="vm:DesktopRobotViewModel"
        Title="NCF 桌面助手"
        Width="360"
        Height="154"
        MinWidth="320"
        MinHeight="140"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome">

    <Border Margin="8"
            Padding="12"
            CornerRadius="18"
            Background="#F7FFFFFF"
            BorderBrush="#26007ACC"
            BorderThickness="1"
            BoxShadow="0 6 22 0 #42000000"
            PointerPressed="RootBorder_OnPointerPressed">
        <Grid ColumnDefinitions="76,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
            <Border Grid.RowSpan="4"
                    Width="64"
                    Height="64"
                    CornerRadius="32"
                    Background="#12007ACC"
                    BorderBrush="{Binding StateColor}"
                    BorderThickness="2"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding Emoji}"
                           FontSize="34"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Title}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="205"/>
                <Border Background="{Binding StateColor}" CornerRadius="8" Padding="7,2">
                    <TextBlock Text="{Binding StateText}" FontSize="10" Foreground="White"/>
                </Border>
            </StackPanel>

            <Button Grid.Column="2"
                    Grid.Row="0"
                    Content="×"
                    Width="24"
                    Height="24"
                    Padding="0"
                    Background="Transparent"
                    Foreground="#777777"
                    ToolTip.Tip="隐藏桌面助手"
                    Click="HideButton_OnClick"/>

            <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                       Text="{Binding Detail}"
                       FontSize="12"
                       Foreground="#444444"
                       TextWrapping="Wrap"
                       MaxHeight="38"
                       Margin="0,5,0,2"/>

            <ProgressBar Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2"
                         Value="{Binding Progress}"
                         IsVisible="{Binding IsProgressVisible}"
                         Height="4"
                         Margin="0,3,0,2"/>

            <Grid Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,5,0,0">
                <TextBlock Text="{Binding ConnectionText}"
                           FontSize="10"
                           Foreground="#777777"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1"
                        Content="打开 NCF"
                        FontSize="10"
                        Padding="10,4"
                        Background="#007ACC"
                        Foreground="White"
                        CornerRadius="8"
                        Click="OpenMainButton_OnClick"/>
            </Grid>
        </Grid>
    </Border>
</Window>
