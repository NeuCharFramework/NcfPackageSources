<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NcfDesktopApp.GUI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="720"
             x:Class="NcfDesktopApp.GUI.Views.SettingsView"
             x:DataType="vm:MainWindowViewModel"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <Grid RowDefinitions="Auto,*" VerticalAlignment="Stretch" MinHeight="0">
        
        <!-- 顶部操作栏 -->
        <Border Grid.Row="0" 
                Background="{DynamicResource ToolbarBackgroundBrush}" 
                BorderBrush="{DynamicResource ToolbarBorderBrush}" 
                BorderThickness="0,0,0,1" 
                Padding="16,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- 标题 -->
                <TextBlock Grid.Column="0" 
                           Text="⚙️ NCF 设置中心" 
                           FontSize="17"
                           FontWeight="SemiBold" 
                           VerticalAlignment="Center"/>
                
                <!-- 主要操作按钮 -->
                <StackPanel Grid.Column="2" 
                            Orientation="Horizontal" 
                            Spacing="10">
                    <Button Content="显示助手"
                            Command="{Binding ShowDesktopRobotCommand}"
                            Padding="12,8"
                            Background="#6F42C1"
                            Foreground="White"
                            CornerRadius="4"/>
                    <Button Content="测试连接" 
                            Command="{Binding TestConnectionCommand}" 
                            Padding="15,8"
                            Background="#28A745"
                            Foreground="White"
                            CornerRadius="4"
                            FontWeight="SemiBold"/>
                    <Button Content="打开配置目录" 
                            Command="{Binding OpenConfigDirectoryCommand}" 
                            Padding="15,8"
                            Background="#6C757D"
                            Foreground="White"
                            CornerRadius="4"
                            FontWeight="SemiBold"/>
                    <Button Content="{Binding MainButtonText}" 
                            Command="{Binding MainOperationCommand}" 
                            Padding="20,8"
                            Background="#007ACC"
                            Foreground="White"
                            CornerRadius="4"
                            FontWeight="SemiBold"
                            FontSize="14"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主要内容区域：占满剩余高度，左侧可纵向滚动，右侧日志区独立滚动 -->
        <Grid Grid.Row="1"
              ColumnDefinitions="400,*"
              VerticalAlignment="Stretch"
              MinHeight="0">

            <!-- 左侧：控制面板 -->
            <ScrollViewer Grid.Column="0"
                         Padding="16,12,8,16"
                         VerticalAlignment="Stretch"
                         HorizontalAlignment="Stretch"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled">

                <StackPanel Spacing="10" Margin="0,0,0,2">
                    
                    <!-- 状态信息卡片 -->
                    <Border Classes="card-compact">
                        <StackPanel Spacing="8">
                            <TextBlock Text="📊 状态信息" 
                                       FontSize="16" 
                                       FontWeight="SemiBold"/>
                            
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                  ColumnDefinitions="92,*">
                                
                                <TextBlock Grid.Row="0" Grid.Column="0" 
                                          Text="运行平台:" 
                                          FontWeight="SemiBold" 
                                          FontSize="12"
                                          Foreground="{DynamicResource SecondaryTextBrush}"
                                          Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" 
                                          Text="{Binding PlatformInfo}" 
                                          FontSize="12"
                                          Margin="0,0,0,4"/>
                                
                                <TextBlock Grid.Row="1" Grid.Column="0" 
                                          Text="最新版本:" 
                                          FontWeight="SemiBold" 
                                          FontSize="12"
                                          Foreground="{DynamicResource SecondaryTextBrush}"
                                          Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" 
                                          Text="{Binding LatestVersion}" 
                                          FontSize="12"
                                          Margin="0,0,0,4"/>
                                
                                <TextBlock Grid.Row="2" Grid.Column="0" 
                                          Text="当前状态:" 
                                          FontWeight="SemiBold" 
                                          FontSize="12"
                                          Foreground="{DynamicResource SecondaryTextBrush}"
                                          Margin="0,0,0,4"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" 
                                           Orientation="Horizontal" 
                                           Spacing="8" 
                                           Margin="0,0,0,4">
                                    <Border Background="{Binding StatusColor}" 
                                           CornerRadius="8" 
                                           Width="12" 
                                           Height="12"
                                           VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CurrentStatus}" 
                                              FontSize="12"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <TextBlock Grid.Row="3" Grid.Column="0" 
                                          Text="站点地址:" 
                                          FontWeight="SemiBold" 
                                          FontSize="12"
                                          Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" 
                                          Text="{Binding SiteUrl}" 
                                          FontFamily="Consolas" 
                                          FontSize="11"
                                          TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="4" Grid.Column="0"
                                          Text="桌面助手:"
                                          FontWeight="SemiBold"
                                          FontSize="12"
                                          Foreground="{DynamicResource SecondaryTextBrush}"
                                          Margin="0,5,0,0"/>
                                <StackPanel Grid.Row="4" Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            Margin="0,5,0,0">
                                    <Border Background="{Binding DesktopBridgeStatusColor}"
                                            CornerRadius="6"
                                            Width="10"
                                            Height="10"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DesktopBridgeStatusText}"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- DesktopBridge 缺失、版本不兼容或暂时不可用时的安全降级提示 -->
                    <Border IsVisible="{Binding IsDesktopBridgeNoticeVisible}"
                            Background="#16FFC107"
                            BorderBrush="#99FFC107"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="🤖 DesktopBridge 兼容提示"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DesktopBridgeNoticeMessage}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <Button Content="打开 XNCF 模块管理"
                                    Command="{Binding OpenDesktopBridgeInstallPageCommand}"
                                    IsVisible="{Binding IsDesktopBridgeInstallActionVisible}"
                                    HorizontalAlignment="Left"
                                    Padding="12,6"
                                    Background="#FD7E14"
                                    Foreground="White"
                                    CornerRadius="4"/>
                        </StackPanel>
                    </Border>

                    <!-- 操作进度卡片 -->
                    <Border Classes="card-compact">
                        <StackPanel Spacing="8">
                            <TextBlock Text="⚡ 操作进度" 
                                       FontSize="16" 
                                       FontWeight="SemiBold"/>
                            
                            <TextBlock Text="{Binding ProgressText}" 
                                      FontWeight="SemiBold"
                                      FontSize="12"/>
                            <ProgressBar Value="{Binding ProgressValue}" 
                                         IsIndeterminate="{Binding IsProgressIndeterminate}" 
                                         Height="6" 
                                         CornerRadius="3"/>
                        </StackPanel>
                    </Border>

                    <!-- 配置选项卡片 -->
                    <Border Classes="card-compact">
                        <StackPanel Spacing="8">
                            <TextBlock Text="⚙️ 配置选项" 
                                       FontSize="16" 
                                       FontWeight="SemiBold"/>
                            
                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*">
                                <CheckBox Grid.Row="0" Grid.Column="0"
                                          Content="自动打开内置浏览器"
                                          IsChecked="{Binding AutoOpenBrowser}"
                                          FontSize="12"/>
                                <CheckBox Grid.Row="0" Grid.Column="1"
                                          Content="自动清理下载文件"
                                          IsChecked="{Binding AutoCleanDownloads}"
                                          FontSize="12"/>
                                <CheckBox Grid.Row="1" Grid.Column="0"
                                          Content="显示更新详细信息"
                                          IsChecked="{Binding ShowDetailedInfo}"
                                          FontSize="12"/>
                                <CheckBox Grid.Row="1" Grid.Column="1"
                                          Content="最小化到系统托盘"
                                          IsChecked="{Binding MinimizeToTray}"
                                          FontSize="12"/>
                            </Grid>
                            
                            <Separator Margin="0,4"/>
                            
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <TextBlock Text="端口范围:" 
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                                    <NumericUpDown Value="{Binding StartPort}" 
                                                  Minimum="1024" 
                                                  Maximum="65535" 
                                                  Width="105"
                                                  FontSize="12"/>
                                    <TextBlock Text="到" 
                                              VerticalAlignment="Center"
                                              FontSize="12"/>
                                    <NumericUpDown Value="{Binding EndPort}" 
                                                  Minimum="1024" 
                                                  Maximum="65535" 
                                                  Width="105"
                                                  FontSize="12"/>
                            </StackPanel>

                            <Separator Margin="0,4"/>

                            <StackPanel Spacing="6">
                                <TextBlock Text="镜像服务器地址:"
                                          FontWeight="SemiBold"
                                          FontSize="12"/>
                                <TextBox Text="{Binding MirrorServerBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="https://www.ncf.pub"
                                         FontSize="12"
                                         FontFamily="Consolas,Menlo,Monaco,Courier New"/>
                                <TextBlock Text="默认优先使用此镜像；镜像不可用、版本落后或下载失败时自动切换 GitHub。修改后自动保存。"
                                          FontSize="11"
                                          Foreground="{DynamicResource SecondaryTextBrush}"
                                          TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
            
            <!-- 右侧：日志面板 -->
            <Border Grid.Column="1"
                    Classes="log-panel"
                    Margin="8,12,16,16"
                    VerticalAlignment="Stretch"
                    MinHeight="0">
                <Grid RowDefinitions="Auto,*">
                    <!-- 日志标题栏 -->
                    <Border Grid.Row="0" 
                            Background="{DynamicResource ToolbarBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="15,10">
                        <TextBlock Text="📝 操作日志" 
                                  FontSize="16" 
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"/>
                    </Border>
                    
                    <!-- 日志内容区域 -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource LogBackgroundBrush}" 
                            BorderBrush="{DynamicResource CardBorderBrush}" 
                            BorderThickness="1"
                            CornerRadius="0,0,8,8">
                        <ScrollViewer Name="LogScrollViewer" 
                                     Padding="15,10"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     ScrollChanged="LogScrollViewer_OnScrollChanged">
                            <SelectableTextBlock Text="{Binding LogText}" 
                                                FontFamily="Consolas,Menlo,Monaco,Courier New" 
                                                FontSize="11" 
                                                TextWrapping="Wrap" 
                                                Foreground="{DynamicResource InputTextBrush}"
                                                LineHeight="16"
                                                Background="Transparent"
                                                SelectionBrush="{DynamicResource SystemAccentColor}"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
            
        </Grid>
    </Grid>

    <UserControl.Styles>
        <!-- 紧凑卡片样式 -->
        <Style Selector="Border.card-compact">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BoxShadow" Value="0 1 3 0 #0D000000"/>
        </Style>
        
        <!-- 日志面板样式 -->
        <Style Selector="Border.log-panel">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BoxShadow" Value="0 2 8 0 #14000000"/>
        </Style>
        
        <Style Selector="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style Selector="Button:pointerover">
            <Setter Property="Opacity" Value="0.9"/>
        </Style>
        
        <!-- CheckBox 样式优化 -->
        <Style Selector="CheckBox">
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <!-- 滚动条样式优化 -->
        <Style Selector="ScrollViewer">
            <Setter Property="AllowAutoHide" Value="True"/>
        </Style>
    </UserControl.Styles>
</UserControl>
