<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NcfDesktopApp.GUI.ViewModels"
             xmlns:models="using:NcfDesktopApp.GUI.Models"
             xmlns:controls="using:NcfDesktopApp.GUI.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="760"
             x:Class="NcfDesktopApp.GUI.Views.SettingsView"
             x:DataType="vm:MainWindowViewModel"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <Grid RowDefinitions="Auto,*" VerticalAlignment="Stretch" MinHeight="0">
        <!-- Agent 工作台标题栏 -->
        <Border Grid.Row="0"
                Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource ToolbarBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="NCF Agent Workspace"
                               FontSize="19"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="选择运行目标，启动独立 NCF，并观察 Agent 与 DesktopBridge 活动"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="显示助手"
                            Command="{Binding ShowDesktopRobotCommand}"
                            Classes="toolbar-action"
                            Background="#7C3AED"
                            Foreground="White"/>
                    <Button Content="打开目标目录"
                            Command="{Binding OpenSelectedTargetDirectoryCommand}"
                            Classes="toolbar-action"
                            Background="#475569"
                            Foreground="White"/>
                    <Button Content="{Binding MainButtonText}"
                            Command="{Binding MainOperationCommand}"
                            Classes="primary-action"
                            Background="#2563EB"
                            Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="430,*" VerticalAlignment="Stretch" MinHeight="0">
            <!-- 左侧：目标与运行控制 -->
            <ScrollViewer Grid.Column="0"
                          Padding="16,14,8,16"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="10" Margin="0,0,0,2">
                    <!-- 启动目标卡片 -->
                    <Border Classes="card target-card">
                        <StackPanel Spacing="11">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="运行目标"
                                               FontSize="16"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="每个版本都是独立的 Agent 执行环境"
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Border Background="{Binding TargetStatusColor}"
                                            CornerRadius="6" Width="10" Height="10"/>
                                    <TextBlock Text="{Binding TargetKindText}"
                                               FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>

                            <!-- 工作模式切换 -->
                            <Border Background="{DynamicResource ToolbarBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="3"
                                    IsEnabled="{Binding IsTargetSelectionEnabled}">
                                <Grid ColumnDefinitions="*,*">
                                    <Button Grid.Column="0"
                                            Content="托管版本"
                                            Command="{Binding UseManagedRuntimeCommand}"
                                            Classes="mode-button"
                                            Background="{Binding ManagedModeButtonBackground}"
                                            Foreground="{Binding ManagedModeButtonForeground}"/>
                                    <Button Grid.Column="1"
                                            Content="外部工作区"
                                            Command="{Binding UseExternalTargetCommand}"
                                            Classes="mode-button"
                                            Background="{Binding ExternalModeButtonBackground}"
                                            Foreground="{Binding ExternalModeButtonForeground}"/>
                                </Grid>
                            </Border>

                            <!-- 内置托管版本 -->
                            <StackPanel IsVisible="{Binding IsManagedTargetMode}" Spacing="7">
                                <TextBlock Text="桌面端自动安装和更新，适合日常使用。"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"/>
                                <Border Classes="path-box">
                                    <SelectableTextBlock Text="{Binding ManagedRuntimePath}"
                                                         FontFamily="Consolas,Menlo,Monaco,Courier New"
                                                         FontSize="10"
                                                         TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>

                            <!-- 外部发布目录或源码工作区 -->
                            <StackPanel IsVisible="{Binding IsExternalTargetMode}"
                                        IsEnabled="{Binding IsTargetSelectionEnabled}"
                                        Spacing="8">
                                <TextBlock Text="选择发布目录或包含 Senparc.Web.csproj 的源码目录"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding ExternalNcfPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Watermark="选择或粘贴 NCF 路径"
                                             FontSize="11"
                                             FontFamily="Consolas,Menlo,Monaco,Courier New"
                                             Margin="0,0,6,0"/>
                                    <Button Grid.Column="1"
                                            Content="选择"
                                            Command="{Binding SelectExternalNcfTargetCommand}"
                                            Classes="secondary-action"
                                            Margin="0,0,6,0"/>
                                    <Button Grid.Column="2"
                                            Content="检测"
                                            Command="{Binding ValidateExternalTargetCommand}"
                                            Classes="secondary-action"/>
                                </Grid>

                                <ComboBox ItemsSource="{Binding RecentNcfPaths}"
                                          SelectedItem="{Binding SelectedRecentNcfPath, Mode=TwoWay}"
                                          PlaceholderText="最近使用的 NCF 工作区"
                                          FontSize="11"/>
                            </StackPanel>

                            <!-- 目标元数据 -->
                            <Border Background="#0A2563EB"
                                    BorderBrush="#332563EB"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="10">
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="72,*">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="版本" Classes="meta-label"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TargetVersionText}" Classes="meta-value"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="框架" Classes="meta-label" Margin="0,5,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TargetFrameworkText}" Classes="meta-value" Margin="0,5,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="入口" Classes="meta-label" Margin="0,5,0,0"/>
                                    <SelectableTextBlock Grid.Row="2" Grid.Column="1"
                                                         Text="{Binding TargetEntryText}"
                                                         FontFamily="Consolas,Menlo,Monaco,Courier New"
                                                         FontSize="10"
                                                         TextWrapping="Wrap"
                                                         Margin="0,5,0,0"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="{Binding TargetValidationMessage}"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"/>

                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0"
                                           Text="运行环境"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding EnvironmentOptions}"
                                          SelectedItem="{Binding AspNetCoreEnvironment, Mode=TwoWay}"
                                          FontSize="11"
                                          IsEnabled="{Binding IsTargetSelectionEnabled}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 运行态卡片 -->
                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="运行态" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding PlatformInfo}"
                                           FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </Grid>
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="82,*">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="进程" Classes="meta-label"/>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Border Background="{Binding StatusColor}" CornerRadius="6" Width="10" Height="10" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CurrentStatus}" FontSize="11"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="站点" Classes="meta-label" Margin="0,5,0,0"/>
                                <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SiteUrl}"
                                                     FontFamily="Consolas,Menlo,Monaco,Courier New"
                                                     FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Agent Bridge" Classes="meta-label" Margin="0,5,0,0"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,5,0,0">
                                    <Border Background="{Binding DesktopBridgeStatusColor}" CornerRadius="6" Width="10" Height="10" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DesktopBridgeStatusText}" FontSize="10.5" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- DesktopBridge 安全降级提示 -->
                    <Border IsVisible="{Binding IsDesktopBridgeNoticeVisible}"
                            Background="#14F59E0B"
                            BorderBrush="#66F59E0B"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="11">
                        <StackPanel Spacing="7">
                            <TextBlock Text="Agent 兼容模式" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DesktopBridgeNoticeMessage}"
                                       FontSize="10.5"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <Button Content="打开 XNCF 模块管理"
                                    Command="{Binding OpenDesktopBridgeInstallPageCommand}"
                                    IsVisible="{Binding IsDesktopBridgeInstallActionVisible}"
                                    HorizontalAlignment="Left"
                                    Classes="secondary-action"/>
                        </StackPanel>
                    </Border>

                    <!-- 进度 -->
                    <Border Classes="card">
                        <StackPanel Spacing="7">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding ProgressText}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding LatestVersion, StringFormat='目标 {0}'}"
                                           FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </Grid>
                            <ProgressBar Value="{Binding ProgressValue}"
                                         IsIndeterminate="{Binding IsProgressIndeterminate}"
                                         Height="5" CornerRadius="3"/>
                        </StackPanel>
                    </Border>

                    <!-- 次要配置 -->
                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Text="工作台选项" FontSize="14" FontWeight="SemiBold"/>
                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*">
                                <CheckBox Grid.Row="0" Grid.Column="0" Content="自动打开站点"
                                          IsChecked="{Binding AutoOpenBrowser}" FontSize="11"/>
                                <CheckBox Grid.Row="0" Grid.Column="1" Content="显示详细日志"
                                          IsChecked="{Binding ShowDetailedInfo}" FontSize="11"/>
                                <CheckBox Grid.Row="1" Grid.Column="0" Content="清理下载文件"
                                          IsChecked="{Binding AutoCleanDownloads}" FontSize="11"/>
                                <CheckBox Grid.Row="1" Grid.Column="1" Content="最小化到托盘"
                                          IsChecked="{Binding MinimizeToTray}" FontSize="11"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto,*">
                                <TextBlock Grid.Column="0" Text="端口" FontSize="11" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <NumericUpDown Grid.Column="1" Value="{Binding StartPort}" Minimum="1024" Maximum="65535"
                                               FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="2" Text="—" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <NumericUpDown Grid.Column="3" Value="{Binding EndPort}" Minimum="1024" Maximum="65535" FontSize="11"/>
                            </Grid>
                            <TextBox Text="{Binding MirrorServerBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Watermark="托管版本镜像服务器"
                                     FontSize="10.5"
                                     FontFamily="Consolas,Menlo,Monaco,Courier New"
                                     IsVisible="{Binding IsManagedTargetMode}"/>
                            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsManagedTargetMode}">
                                <Button Content="测试更新源" Command="{Binding TestConnectionCommand}" Classes="secondary-action"/>
                                <Button Content="打开配置目录" Command="{Binding OpenConfigDirectoryCommand}" Classes="secondary-action"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 右侧：Agent 运行流 -->
            <Border Grid.Column="1"
                    Classes="activity-panel"
                    Margin="8,14,16,16"
                    VerticalAlignment="Stretch"
                    MinHeight="0">
                <Grid RowDefinitions="Auto,*,Auto,150">
                    <Border Grid.Row="0"
                            Background="{DynamicResource ToolbarBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="15,11">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Admin Agent 快捷对话" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Admin API 保存消息，EventBus 只发送受权变更通知"
                                           FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border Background="{Binding StatusColor}" CornerRadius="6" Width="10" Height="10"/>
                                <TextBlock Text="{Binding CurrentStatus}" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 快捷聊天主体 -->
                    <Grid Grid.Row="1" MinHeight="0" Background="{DynamicResource CardBackgroundBrush}">
                        <StackPanel IsVisible="{Binding IsAdminChatUnavailable}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="360"
                                    Spacing="10"
                                    Margin="24">
                            <controls:NcfMascotView Mascot="Qiao" Pose="Warning"
                                                    Width="72" Height="72"/>
                            <TextBlock Text="快捷聊天尚未启用" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding AdminChatDisabledReason}"
                                       FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsAdminLoginVisible}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Width="350"
                                    Spacing="9"
                                    Margin="24">
                            <controls:NcfMascotView Mascot="Cici" Pose="Wave"
                                                    Width="76" Height="76"
                                                    HorizontalAlignment="Center"/>
                            <TextBlock Text="管理员登录" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="仅 AdminOnly 账号可使用；密码和 JWT 不会写入本地设置。"
                                       FontSize="10.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox Text="{Binding AdminUserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Watermark="后台管理员账号"/>
                            <TextBox Text="{Binding AdminPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PasswordChar="●" Watermark="密码"/>
                            <Button Content="验证并连接"
                                    Command="{Binding AdminLoginCommand}"
                                    Classes="primary-action"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Background="#7C3AED" Foreground="White"/>
                            <TextBlock Text="{Binding AdminChatStatusText}" FontSize="10.5"
                                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>

                        <Grid IsVisible="{Binding IsAdminChatActive}"
                              RowDefinitions="Auto,*,Auto" MinHeight="0">
                            <Border Grid.Row="0" BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="0,0,0,1" Padding="12,9">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="7">
                                    <controls:NcfMascotView Grid.Column="0"
                                                            Mascot="Cici"
                                                            Pose="{Binding AdminChatMascotPose}"
                                                            Width="34" Height="34"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding AdminChatSessions}"
                                              SelectedItem="{Binding SelectedAdminChatSession, Mode=TwoWay}"
                                              DisplayMemberBinding="{Binding DisplayName}"
                                              PlaceholderText="新会话将在首次发送时创建"
                                              FontSize="11"/>
                                    <Button Grid.Column="2" Content="新会话"
                                            Command="{Binding NewAdminChatSessionCommand}"
                                            Classes="secondary-action"/>
                                    <Button Grid.Column="3" Content="退出"
                                            Command="{Binding AdminLogoutCommand}"
                                            Classes="secondary-action"/>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" Padding="14,10"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding AdminChatMessages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:AdminChatMessage">
                                            <Border Background="#0A64748B" CornerRadius="8"
                                                    Padding="10,8" Margin="0,0,0,8">
                                                <StackPanel Spacing="4">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Text="{Binding SenderName}"
                                                                   Foreground="{Binding SenderColor}"
                                                                   FontWeight="SemiBold" FontSize="10.5"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayTime}"
                                                                   FontSize="9.5"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                    </Grid>
                                                    <SelectableTextBlock Text="{Binding Content}"
                                                                         TextWrapping="Wrap"
                                                                         FontSize="11.5"
                                                                         LineHeight="18"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Border Grid.Row="2" BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="0,1,0,0" Padding="12,9">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding ChatInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Watermark="输入消息；由 Admin Chat API 处理"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             MinHeight="42" MaxHeight="90"/>
                                    <Button Grid.Column="1" Content="发送"
                                            Command="{Binding SendAdminChatMessageCommand}"
                                            Classes="primary-action"
                                            Background="#2563EB" Foreground="White"
                                            VerticalAlignment="Stretch"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- 紧凑运行日志 -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource ToolbarBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="0,1,0,1"
                            Padding="12,7">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="运行日志" FontSize="11.5" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding AdminChatStatusText}"
                                       FontSize="9.5" Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3" Background="{DynamicResource LogBackgroundBrush}">
                        <ScrollViewer Name="LogScrollViewer"
                                      Padding="12,8,12,24"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      ScrollChanged="LogScrollViewer_OnScrollChanged">
                            <SelectableTextBlock Text="{Binding LogText}"
                                                 FontFamily="Consolas,Menlo,Monaco,Courier New"
                                                 FontSize="10"
                                                 TextWrapping="Wrap"
                                                 Foreground="{DynamicResource InputTextBrush}"
                                                 LineHeight="15"
                                                 Margin="0,0,0,4"
                                                 Background="Transparent"
                                                 SelectionBrush="{DynamicResource SystemAccentColor}"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BoxShadow" Value="0 2 5 0 #10000000"/>
        </Style>
        <Style Selector="Border.target-card">
            <Setter Property="BorderBrush" Value="#402563EB"/>
        </Style>
        <Style Selector="Border.path-box">
            <Setter Property="Background" Value="{DynamicResource ToolbarBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style Selector="Border.activity-panel">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="BoxShadow" Value="0 3 10 0 #18000000"/>
        </Style>
        <Style Selector="TextBlock.meta-label">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>
        <Style Selector="TextBlock.meta-value">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Opacity" Value="0.9"/>
        </Style>
        <Style Selector="Button.mode-button">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.toolbar-action">
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="Button.primary-action">
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.secondary-action">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="10.5"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="MinHeight" Value="25"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ScrollViewer">
            <Setter Property="AllowAutoHide" Value="True"/>
        </Style>
    </UserControl.Styles>
</UserControl>
