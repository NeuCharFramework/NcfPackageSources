@using System.Text.Json
@using Senparc.Ncf.Core.Localization
@using Senparc.Xncf.Connectors
@inject Microsoft.Extensions.Localization.IStringLocalizerFactory LocalizationFactory
@{
    var sourceTranslations = FrontendTranslationCatalog.Get(
        LocalizationFactory,
        typeof(ConnectorsResource));
}
<script>
    window.ncfRegisterSourceTranslations(@Html.Raw(JsonSerializer.Serialize(sourceTranslations)), "Connectors");
</script>
