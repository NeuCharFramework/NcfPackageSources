@page
@model Senparc.Xncf.Connectors.Areas.Admin.Pages.Connectors.Index
@using Senparc.Xncf.Connectors
@{
    ViewData["Title"] = ConnectorsResource.Get("Module.Connectors.MenuName", "Connectors");
    Layout = "_Layout_Vue";
}

@section Style {
    <style>
        .connector-shell { display: flex; flex-direction: column; gap: 22px; }
        .connector-hero { display: flex; gap: 16px; align-items: center; justify-content: space-between; padding: 22px 24px; border-radius: 18px; background: linear-gradient(135deg, #12324d 0%, #1f6f8b 58%, #2a9d8f 100%); color: #fff; box-shadow: 0 18px 48px rgba(18,50,77,.14); }
        .connector-hero-copy { display: flex; min-width: 0; gap: 16px; align-items: center; }
        .connector-hero-copy > i { flex: 0 0 52px; width: 52px; height: 52px; border-radius: 14px; display: grid; place-items: center; background: rgba(255,255,255,.16); font-size: 24px; }
        .connector-hero h1 { display: flex; align-items: center; gap: 6px; margin: 0 0 6px; font-size: 22px; line-height: 1.3; font-weight: 650; }
        .connector-hero p { margin: 0; max-width: 760px; line-height: 1.6; color: rgba(255,255,255,.88); }
        .connector-hero .ncf-doc-help-button { width: 24px; height: 24px; margin: 0; color: rgba(255,255,255,.92); font-size: 16px; }
        .connector-hero .ncf-doc-help-button:hover,
        .connector-hero .ncf-doc-help-button:focus-visible { color: #409eff; }
        .connector-hero-cta { flex: 0 0 auto; min-height: 36px; white-space: nowrap; }
        .connector-hero-cta .el-icon-plus { width: auto; height: auto; margin-right: 5px; font-size: 14px; }
        .connector-grid, .connector-instance-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; }
        .connector-card, .connector-instance { display: flex; min-width: 0; flex-direction: column; background: #fff; border: 1px solid #e6ebf2; border-radius: 14px; padding: 16px; box-shadow: 0 8px 24px rgba(18, 50, 77, .04); }
        .connector-card > .el-button { align-self: flex-start; margin-top: auto; }
        .connector-card h3, .connector-instance h3 { margin: 8px 0; font-size: 16px; }
        .connector-card p, .connector-muted { color: #667085; line-height: 1.55; font-size: 13px; }
        .connector-kicker { display: flex; justify-content: space-between; align-items: center; color: #1f6f8b; font-size: 12px; letter-spacing: .04em; }
        .connector-actions { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0; }
        .connector-instance-foot { display: flex; justify-content: space-between; gap: 8px; align-items: center; margin-top: 12px; }
        .connector-section-head { display: flex; justify-content: space-between; align-items: end; gap: 12px; }
        .connector-section-head h2 { margin: 0; font-size: 18px; }
        .connector-empty { padding: 28px; text-align: center; color: #667085; border: 1px dashed #d0d7e2; border-radius: 14px; background: #fbfcfe; }
        .connector-status { font-size: 12px; }
        .connector-status.ok { color: #0f7b4c; }
        .connector-status.bad { color: #b42318; }
        .connector-template-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }
        .connector-template { position: relative; overflow: hidden; display: flex; min-width: 0; flex-direction: column; background: linear-gradient(160deg,#fff,#f6faff); border: 1px solid #dbe7f5; border-radius: 14px; padding: 16px; min-height: 170px; }
        .connector-template::after { content:""; position:absolute; width:90px; height:90px; border-radius:50%; background:rgba(31,111,139,.06); right:-30px; top:-30px; }
        .connector-template > .connector-card-top > i { color: #1f6f8b; font-size: 22px; }
        .connector-template h3 { margin: 10px 0 6px; font-size: 15px; }
        .connector-template p { flex: 1 1 auto; min-height: 42px; margin: 0 0 12px; color:#667085; font-size:12px; line-height:1.5; }
        .connector-template > .el-button { position: relative; z-index: 1; align-self: flex-start; white-space: nowrap; }
        .connector-template > .el-button .el-icon-plus { margin-right: 4px; color: inherit; font-size: 12px; }
        .connector-card-top { display:flex; align-items:center; justify-content:space-between; gap:8px; }
        .connector-source { font-size:11px; color:#667085; background:#f2f4f7; border-radius:999px; padding:3px 8px; }
        .connector-toolbar { display:flex; gap:10px; align-items:center; }
        @@media (max-width: 920px) {
            .connector-hero { align-items: flex-start; flex-direction: column; }
            .connector-hero-cta { align-self: flex-end; }
            .connector-template-grid { grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); }
        }
        @@media (max-width: 560px) {
            .connector-shell { gap: 18px; }
            .connector-hero { padding: 18px; }
            .connector-hero-copy { align-items: flex-start; }
            .connector-hero-copy > i { flex-basis: 42px; width: 42px; height: 42px; font-size: 20px; }
            .connector-hero h1 { font-size: 19px; }
            .connector-hero-cta { align-self: stretch; }
            .connector-template-grid, .connector-grid, .connector-instance-grid { grid-template-columns: 1fr; }
            .connector-section-head { align-items: flex-start; flex-direction: column; }
        }
    </style>
}

@section breadcrumbs {
    <el-breadcrumb-item>@ConnectorsResource.Get("Area.Extensions", "Extensions")</el-breadcrumb-item>
    <el-breadcrumb-item>@ConnectorsResource.Get("Module.Connectors.MenuName", "Connectors")</el-breadcrumb-item>
    <el-breadcrumb-item>@ConnectorsResource.Get("Area.Connectors.Config", "Connector setup")</el-breadcrumb-item>
}

@Html.AntiForgeryToken()
<div class="connector-shell">
    <section class="connector-hero">
        <div class="connector-hero-copy">
            <i class="fa fa-plug"></i>
            <div>
                <h1>{{ ncfST('Frontend.Connectors.ExternalToolConnector') }} <ncf-doc-help topic="connectors.manage"></ncf-doc-help></h1>
                <p>{{ ncfST('Frontend.Connectors.ConfigureTheAccountAndSecretFirstThenChooseWhichActionsAIMay') }}</p>
            </div>
        </div>
        <el-button v-if="state.mcpAvailable" class="connector-hero-cta" type="primary" plain icon="el-icon-plus" @@click="openQuickMcp(state.templates[0])">
            {{ ncfST('Frontend.Connectors.AddMcpConnector') }}
        </el-button>
    </section>

    <section v-if="state.templates && state.templates.length">
        <div class="connector-section-head">
            <div>
                <h2>{{ ncfST('Frontend.Connectors.ConnectorTemplates') }}</h2>
                <p class="connector-muted">{{ ncfST('Frontend.Connectors.TemplateDescription') }}</p>
            </div>
            <el-tag size="small" type="info">{{ ncfST('Frontend.Connectors.McpManagedCentrally') }}</el-tag>
        </div>
        <div class="connector-template-grid" style="margin-top:12px;">
            <article class="connector-template" v-for="template in state.templates" :key="template.key">
                <div class="connector-card-top">
                    <i :class="template.icon"></i>
                    <el-tag size="mini" effect="plain">{{ template.category }}</el-tag>
                </div>
                <h3>{{ template.name }}</h3>
                <p>{{ template.description }}</p>
                <el-button type="primary" size="mini" icon="el-icon-plus" @@click="openQuickMcp(template)">
                    {{ ncfST('Frontend.Connectors.CreateFromTemplate') }}
                </el-button>
            </article>
        </div>
    </section>

    <section>
        <div class="connector-section-head">
            <div>
                <h2>{{ ncfST('Frontend.Connectors.AvailableTypes') }}</h2>
                <p class="connector-muted">{{ ncfST('Frontend.Connectors.TypesAreProvidedByInstalledModulesCorporateWeComAttendanceIsProvidedBy') }}</p>
            </div>
        </div>
        <div class="connector-grid" style="margin-top:12px;" v-if="state.catalog.length">
            <article class="connector-card" v-for="item in state.catalog" :key="item.key">
                <div class="connector-kicker">
                    <span><i :class="item.icon || 'fa fa-plug'"></i> {{ item.key }}</span>
                    <span class="connector-source">{{ item.key.indexOf('mcp.endpoint.') === 0 ? 'MCP' : 'XNCF' }}</span>
                </div>
                <h3>{{ item.name }}</h3>
                <p>{{ item.description }}</p>
                <div class="connector-muted">{{ ncfST('Frontend.Connectors.ValueActions', item.actions.length) }}</div>
                <el-button type="primary" size="small" icon="el-icon-plus" @@click="openCreate(item)">{{ ncfST('Frontend.Connectors.ConfigureThisConnector') }}</el-button>
            </article>
        </div>
        <div class="connector-empty" v-else>{{ ncfST('Frontend.Connectors.NoModuleHasRegisteredAConnectorYetInstallAndEnableWeixinManagement') }}</div>
    </section>

    <section>
        <div class="connector-section-head">
            <div>
                <h2>{{ ncfST('Frontend.Connectors.Configured') }}</h2>
                <p class="connector-muted">{{ ncfST('Frontend.Connectors.SecretsAreStoredOnlyOnTheServerLeaveTheFieldEmptyWhile') }}</p>
            </div>
            <span class="connector-muted">{{ ncfST('Frontend.Connectors.Value', state.instances.length) }}</span>
        </div>
        <div class="connector-instance-grid" style="margin-top:12px;" v-if="state.instances.length">
            <article class="connector-instance" v-for="item in state.instances" :key="item.instanceId">
                <div class="connector-kicker">
                    <span>{{ item.connectorName }}</span>
                    <el-tag size="mini" :type="item.enabled ? 'success' : 'info'">{{ item.enabled ? ncfST('Frontend.Connectors.Enabled') : ncfST('Frontend.Connectors.Disabled') }}</el-tag>
                </div>
                <h3>{{ item.name }}</h3>
                <p class="connector-muted">{{ item.description || ncfST('Frontend.Connectors.NoDescriptionProvided') }}</p>
                <div class="connector-actions">
                    <el-tag v-for="action in item.actionKeys" :key="action" size="mini" effect="plain">{{ actionLabel(item, action) }}</el-tag>
                </div>
                <div class="connector-status" :class="item.lastTestSucceeded === true ? 'ok' : (item.lastTestSucceeded === false ? 'bad' : '')">
                    {{ item.lastTestMessage || ncfST('Frontend.Connectors.ConnectionNotTestedYet') }}
                </div>
                <div class="connector-instance-foot">
                    <div>
                        <el-button size="mini" @@click="openEdit(item)">{{ ncfST('Frontend.Connectors.Edit') }}</el-button>
                        <el-button size="mini" type="success" plain :loading="testingId === item.instanceId" @@click="testInstance(item)">{{ ncfST('Frontend.Connectors.Test') }}</el-button>
                    </div>
                    <el-button size="mini" type="text" @@click="removeInstance(item)">{{ ncfST('Frontend.Connectors.Delete') }}</el-button>
                </div>
            </article>
        </div>
        <div class="connector-empty" v-else>{{ ncfST('Frontend.Connectors.NothingIsConfiguredSelectATypeAboveAndEnterTheCorporateWeCom') }}</div>
    </section>
</div>

<el-dialog :title="form.instanceId ? ncfST('Frontend.Connectors.EditConnector') : ncfST('Frontend.Connectors.ConfigureConnector')" :visible.sync="editorVisible" width="640px" :close-on-click-modal="false">
    <el-form v-if="currentType" label-position="top" size="small">
        <el-alert :title="currentType.name" :description="currentType.description" type="info" :closable="false" show-icon style="margin-bottom:16px;"></el-alert>
        <el-form-item :label="ncfST('Frontend.Connectors.Name')" required>
            <el-input v-model="form.name" maxlength="100" :placeholder="ncfST('Frontend.Connectors.ExampleCorporateWeCom')"></el-input>
        </el-form-item>
        <el-form-item :label="ncfST('Frontend.Connectors.Description')">
            <el-input v-model="form.description" type="textarea" :rows="2" maxlength="500" :placeholder="ncfST('Frontend.Connectors.WhichTeamOrScenarioUsesThisAccount')"></el-input>
        </el-form-item>
        <el-form-item v-for="field in currentType.fields" :key="field.key" :label="field.label" :required="field.required && field.kind !== 1">
            <el-select v-if="field.kind === 2" v-model="form.values[field.key]" style="width:100%" :placeholder="field.placeholder || ncfST('Frontend.Connectors.PleaseSelect')">
                <el-option v-for="option in field.options" :key="option.value" :label="option.label" :value="option.value"></el-option>
            </el-select>
            <el-input v-else-if="field.kind === 3" v-model="form.values[field.key]" type="textarea" :rows="3" :placeholder="field.placeholder"></el-input>
            <el-input v-else v-model="form.values[field.key]" :show-password="field.kind === 1" :placeholder="secretPlaceholder(field)"></el-input>
            <div class="connector-muted">{{ field.description }}</div>
        </el-form-item>
        <el-form-item :label="ncfST('Frontend.Connectors.ActionsAvailableToAI')" required>
            <el-checkbox-group v-model="form.actionKeys">
                <el-checkbox v-for="action in currentType.actions" :key="action.key" :label="action.key">{{ action.name }}</el-checkbox>
            </el-checkbox-group>
            <div class="connector-muted" v-for="action in currentType.actions" :key="action.key + '-desc'">{{ action.name }}：{{ action.description }}</div>
        </el-form-item>
        <el-form-item>
            <el-switch v-model="form.enabled" :active-text="ncfST('Frontend.Connectors.AvailableForSelectionInChatWorkflowAndAgentAfterEnabling')"></el-switch>
        </el-form-item>
    </el-form>
    <div slot="footer">
        <el-button @@click="editorVisible = false">{{ ncfST('Frontend.Connectors.Cancel') }}</el-button>
        <el-button type="primary" :loading="saving" @@click="save">{{ ncfST('Frontend.Connectors.Save') }}</el-button>
    </div>
</el-dialog>

<el-dialog :title="ncfST('Frontend.Connectors.CreateMcpConnector')" :visible.sync="quickMcpVisible" width="680px" :close-on-click-modal="false">
    <el-form v-if="quickTemplate" label-position="top" size="small">
        <el-alert :title="quickTemplate.name" :description="quickTemplate.description" type="info" :closable="false" show-icon style="margin-bottom:16px;"></el-alert>
        <el-row :gutter="14">
            <el-col :span="12">
                <el-form-item :label="ncfST('Frontend.Connectors.McpConnectionName')" required>
                    <el-input v-model="quickForm.mcpName" maxlength="100" :placeholder="ncfST('Frontend.Connectors.McpConnectionPlaceholder')"></el-input>
                </el-form-item>
            </el-col>
            <el-col :span="12">
                <el-form-item :label="ncfST('Frontend.Connectors.ConnectorDisplayName')">
                    <el-input v-model="quickForm.connectorName" maxlength="100" :placeholder="quickForm.mcpName"></el-input>
                </el-form-item>
            </el-col>
        </el-row>
        <el-form-item :label="ncfST('Frontend.Connectors.McpEndpoint')" required>
            <el-input v-model="quickForm.endpoint" placeholder="https://.../mcp"></el-input>
        </el-form-item>
        <el-form-item :label="ncfST('Frontend.Connectors.Transport')">
            <el-radio-group v-model="quickForm.endpointType">
                <el-radio-button label="http">HTTP</el-radio-button>
                <el-radio-button label="sse">SSE</el-radio-button>
            </el-radio-group>
        </el-form-item>
        <el-form-item :label="quickTemplate.authLabel">
            <el-input v-model="quickForm.token" type="password" show-password :placeholder="ncfST('Frontend.Connectors.SecretStoredByMcpModule')"></el-input>
        </el-form-item>
        <el-form-item :label="ncfST('Frontend.Connectors.Description')">
            <el-input v-model="quickForm.description" type="textarea" :rows="2" maxlength="500"></el-input>
        </el-form-item>
        <el-alert :title="ncfST('Frontend.Connectors.QuickCreateBehavior')" type="warning" :closable="false" show-icon></el-alert>
    </el-form>
    <div slot="footer">
        <el-button @@click="quickMcpVisible = false">{{ ncfST('Frontend.Connectors.Cancel') }}</el-button>
        <el-button type="primary" :loading="quickSaving" @@click="createQuickMcp">{{ ncfST('Frontend.Connectors.TestAndCreate') }}</el-button>
    </div>
</el-dialog>

@section scripts {
    @await Html.PartialAsync("_LocalizationScripts")
    <script>
        new Vue({
            el: "#app",
            data: function () {
                return {
                    state: @Html.Raw(Model.InitialStateJson),
                    editorVisible: false,
                    saving: false,
                    testingId: "",
                    currentType: null,
                    quickMcpVisible: false,
                    quickSaving: false,
                    quickTemplate: null,
                    quickForm: { templateKey: "", mcpName: "", connectorName: "", endpoint: "", endpointType: "http", token: "", description: "" },
                    form: { instanceId: "", name: "", connectorKey: "", description: "", enabled: true, values: {}, actionKeys: [], secretFields: [] }
                };
            },
            methods: {
                openCreate: function (item) {
                    this.currentType = item;
                    var values = {};
                    (item.fields || []).forEach(function (field) {
                        values[field.key] = field.kind === 2 && field.options && field.options.length ? field.options[0].value : "";
                    });
                    this.form = {
                        instanceId: "",
                        name: "",
                        connectorKey: item.key,
                        description: "",
                        enabled: true,
                        values: values,
                        actionKeys: (item.actions || []).map(function (action) { return action.key; }),
                        secretFields: []
                    };
                    this.editorVisible = true;
                    console.log("[Connector] open create", item.key);
                },
                openEdit: function (item) {
                    this.currentType = this.state.catalog.find(function (catalog) { return catalog.key === item.connectorKey; }) || null;
                    this.form = {
                        instanceId: item.instanceId,
                        name: item.name,
                        connectorKey: item.connectorKey,
                        description: item.description,
                        enabled: item.enabled,
                        values: Object.assign({}, item.values || {}),
                        actionKeys: (item.actionKeys || []).slice(),
                        secretFields: item.secretFields || []
                    };
                    this.editorVisible = true;
                    console.log("[Connector] open edit", item.instanceId);
                },
                openQuickMcp: function (template) {
                    if (!template) return;
                    this.quickTemplate = template;
                    this.quickForm = {
                        templateKey: template.key,
                        mcpName: template.name,
                        connectorName: "",
                        endpoint: template.endpoint || "",
                        endpointType: template.endpointType || "http",
                        token: "",
                        description: template.description || ""
                    };
                    this.quickMcpVisible = true;
                },
                createQuickMcp: async function () {
                    if (this.quickSaving) return;
                    if (!this.quickForm.mcpName || !this.quickForm.endpoint) {
                        this.$message.error(ncfST("Frontend.Connectors.McpFieldsRequired"));
                        return;
                    }
                    this.quickSaving = true;
                    try {
                        var data = await this.post("QuickMcp", this.quickForm);
                        if (!data.success) {
                            this.$message.error(data.message || ncfST("Frontend.Connectors.CreateFailed"));
                            return;
                        }
                        this.quickMcpVisible = false;
                        await this.applyState(data);
                        this.$message.success(data.message || ncfST("Frontend.Connectors.McpConnectorCreated"));
                    } catch (error) {
                        console.error("[Connector] quick MCP create failed", error);
                        this.$message.error(ncfST("Frontend.Connectors.CreateFailed"));
                    } finally {
                        this.quickSaving = false;
                    }
                },
                secretPlaceholder: function (field) {
                    if (field.kind === 1 && this.form.secretFields.indexOf(field.key) >= 0) {
                        return ncfST("Frontend.Connectors.SavedLeaveEmptyToKeepItUnchanged");
                    }
                    return field.placeholder || "";
                },
                actionLabel: function (item, actionKey) {
                    var catalog = this.state.catalog.find(function (entry) { return entry.key === item.connectorKey; });
                    var action = catalog && (catalog.actions || []).find(function (entry) { return entry.key === actionKey; });
                    return action ? action.name : actionKey;
                },
                token: function () {
                    var input = document.querySelector('input[name="__RequestVerificationToken"]');
                    return input ? input.value : "";
                },
                post: async function (handler, payload) {
                    var url = window.location.pathname + window.location.search;
                    url += (url.indexOf("?") >= 0 ? "&" : "?") + "handler=" + handler;
                    var response = await fetch(url, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "RequestVerificationToken": this.token()
                        },
                        body: JSON.stringify(payload)
                    });
                    var data = await response.json();
                    console.log("[Connector]", handler, data);
                    if (!response.ok) {
                        throw new Error(data && (data.message || data.errorMessage)
                            ? (data.message || data.errorMessage)
                            : ("HTTP " + response.status));
                    }
                    return data;
                },
                refreshState: async function () {
                    var url = window.location.pathname + window.location.search;
                    url += (url.indexOf("?") >= 0 ? "&" : "?") + "handler=State";
                    var response = await fetch(url, {
                        headers: { "X-Requested-With": "XMLHttpRequest" }
                    });
                    if (!response.ok) {
                        throw new Error("HTTP " + response.status);
                    }
                    this.state = await response.json();
                },
                applyState: async function (data) {
                    if (data && data.state) {
                        this.state = data.state;
                    } else {
                        await this.refreshState();
                    }
                },
                save: async function () {
                    if (this.saving) return;
                    this.saving = true;
                    try {
                        var data = await this.post("Save", this.form);
                        if (!data.success) {
                            this.$message.error(data.message || ncfST("Frontend.Connectors.SaveFailed"));
                            return;
                        }
                        this.editorVisible = false;
                        await this.applyState(data);
                        this.$message.success(data.message || ncfST("Frontend.Connectors.Saved"));
                    } catch (error) {
                        console.error("[Connector] save failed", error);
                        this.$message.error(ncfST("Frontend.Connectors.SaveFailedPleaseTryAgainLater"));
                    } finally {
                        this.saving = false;
                    }
                },
                testInstance: async function (item) {
                    this.testingId = item.instanceId;
                    try {
                        var data = await this.post("Test", { instanceId: item.instanceId });
                        if (data.success) this.$message.success(data.message || ncfST("Frontend.Connectors.ConnectionSucceeded"));
                        else this.$message.error(data.message || ncfST("Frontend.Connectors.ConnectionFailed"));
                        await this.refreshState();
                    } catch (error) {
                        console.error("[Connector] test failed", error);
                        this.$message.error(ncfST("Frontend.Connectors.TestFailedPleaseTryAgainLater"));
                    } finally {
                        this.testingId = "";
                    }
                },
                removeInstance: async function (item) {
                    if (!window.confirm(ncfST("Frontend.Connectors.DeleteConnectorValueReferencesAuthorizedForAgentsWillAlsoStopWorking", item.name))) return;
                    var data = await this.post("Delete", { instanceId: item.instanceId });
                    if (!data.success) {
                        this.$message.error(data.message || ncfST("Frontend.Connectors.DeleteFailed"));
                        return;
                    }
                    try {
                        await this.applyState(data);
                    } catch (error) {
                        console.error("[Connector] refresh after delete failed", error);
                        this.state.instances = this.state.instances.filter(function (entry) {
                            return entry.instanceId !== item.instanceId;
                        });
                    }
                }
            }
        });
    </script>
}
