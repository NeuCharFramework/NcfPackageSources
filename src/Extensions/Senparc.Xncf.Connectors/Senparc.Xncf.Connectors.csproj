<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.1.1.1</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Senparc.Xncf.Connectors</AssemblyName>
    <RootNamespace>Senparc.Xncf.Connectors</RootNamespace>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <GeneratePackageOnBuild Condition=" '$(Configuration)' == 'Release' ">true</GeneratePackageOnBuild>
    <GeneratePackageOnBuild Condition="'$(Configuration)'=='TemplateRelease'">true</GeneratePackageOnBuild>
    <Description>NCF connectors: store external tool accounts and provide them to Chat, Workflow, and Agent templates.</Description>
    <Copyright>Senparc</Copyright>
    <PackageTags>Senparc,NeuCharFramework,NCF,Senparc.Xncf.Connectors</PackageTags>
    <Authors>Senparc</Authors>
    <Owners>Senparc</Owners>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Title>NCF Connectors</Title>
    <PackageIcon>icon.jpg</PackageIcon>
    <PackageReleaseNotes>[2026-11-11] v0.1.0 Updated module behavior and related support.
        1. store connector accounts and protect secrets with data protection.
        2. Updated module behavior and related support.
        3. make available to Chat, Workflow, and Agent templates according to permissions.
        4. Register resolves menu names and module descriptions through XncfRegisterText.
        5. addmulti-database migrations, create the connector-instance table.
        [2026-11-19] v0.1.1 Updated module behavior, localization metadata, and English source comments
        1. Updated localized labels, resource fallbacks, and user-facing messages across affected surfaces.
        2. Kept runtime behavior and module integration aligned with the affected service and registration changes.
        [2026-11-24] v0.1.1 Integrated localization, tooling, and runtime improvements across the module.
        1. Updated functional behavior and package metadata for the current module changes.
        2. Preserved existing public APIs and runtime integration while incorporating the related improvements.</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/NeuCharFramework/NcfPackageSources</RepositoryUrl>
    <Configurations>Debug;Release;Test;TemplateRelease</Configurations>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <OutputPath>..\..\BuildOutPut</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='TemplateRelease'">
    <OutputPath>..\..\BuildOutPut</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Senparc.Xncf.Connectors.Abstractions\Senparc.Xncf.Connectors.Abstractions.csproj" />    <ProjectReference Include="..\..\Basic\Senparc.Ncf.AreaBase\Senparc.Ncf.AreaBase.csproj" />    <ProjectReference Include="..\..\Basic\Senparc.Ncf.DatabasePlant\Senparc.Ncf.DatabasePlant.csproj" />    <ProjectReference Include="..\..\Basic\Senparc.Ncf.XncfBase\Senparc.Ncf.XncfBase.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>




  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\icon.jpg" Pack="true" Visible="false" PackagePath="" />
  </ItemGroup>
</Project>
