@page
@model Senparc.Xncf.KnowledgeBase.Areas.Admin.Pages.KnowledgeBase.RecallTestModel
@using Microsoft.Extensions.Localization
@using Senparc.Xncf.KnowledgeBase
@inject IStringLocalizer<KnowledgeBaseResource> XR
@{
    ViewData["Title"] = XR["Area.KnowledgeBase.RecallTest"];
    Layout = "_Layout_Vue";
}

@section Style {
    <link href="~/css/KnowledgeBase/RecallTest/RecallTest.css" rel="stylesheet" />
}

@section breadcrumbs {
    <el-breadcrumb-item>@XR["Area.ExtensionModules"]</el-breadcrumb-item>
    <el-breadcrumb-item>@XR["Area.KnowledgeBase.Management"]</el-breadcrumb-item>
    <el-breadcrumb-item>@XR["Area.KnowledgeBase.RecallTest"]</el-breadcrumb-item>
}

<div id="app" class="recall-test-page">
    <div class="recall-test-wrap">
        <div class="recall-test-heading">
            <div>
                <h1>{{ ncfST('Frontend.KnowledgeBase.RetrievedFragmentDetails') }}</h1>
                <p>{{ ncfST('Frontend.KnowledgeBase.UseARealisticQuestionToInspectReturnedMaterialFragmentsSimilarityScoresHelp') }}</p>
            </div>
            <el-button size="small" icon="el-icon-setting" @@click="visible.searchSettingsDrawer = true">{{ ncfST('Frontend.KnowledgeBase.NotVectorized') }}</el-button>
        </div>

        <el-alert class="recall-test-guide" type="info" :closable="false" show-icon
                  :title="ncfST('Frontend.KnowledgeBase.StepsSelectAVectorizedKnowledgeBaseEnterARealisticUserQuestionInspect')">
        </el-alert>

        <div class="recall-test-layout">
            <section class="recall-test-left">
                <el-card shadow="never">
                    <div slot="header" class="panel-heading"><span>{{ ncfST('Frontend.KnowledgeBase.RunATest') }}</span></div>
                    <div class="knowledge-base-select-row">
                        <label class="kb-select-label">@XR["Area.KnowledgeBase.Management"]</label>
                        <el-select v-model="selectedKnowledgeBaseId" filterable clearable :placeholder="ncfST('Frontend.KnowledgeBase.SearchAndSelectAVectorizedKnowledgeBase')" class="kb-select">
                            <el-option v-for="item in knowledgeBaseList" :key="item.id" :label="item.label" :value="item.id" :disabled="!item.ready"></el-option>
                        </el-select>
                    </div>
                    <p class="field-tip" v-if="selectedKnowledgeBase">{{ selectedKnowledgeBase.ready ? ncfST('Frontend.KnowledgeBase.Vectorized') : ncfST('Frontend.KnowledgeBase.AfterSavingMaterialAssociationsBuiltVectorsBecomeInvalidReturnToTheList') }}</p>

                    <div class="query-box">
                        <div class="query-box-header">
                            <label class="query-label">{{ ncfST('Frontend.KnowledgeBase.TestQuestion') }}</label>
                            <span class="char-count">{{ recallContent.length }}/200</span>
                        </div>
                        <el-input type="textarea" v-model="recallContent" :maxlength="200" :rows="8"
                                  :placeholder="ncfST('Frontend.KnowledgeBase.ExampleHowDoICreateANewKnowledgeBase')" class="query-textarea"></el-input>
                        <p class="field-tip">{{ ncfST('Frontend.KnowledgeBase.EnterACompleteQuestionARealUserMightAskInsteadOfA') }}</p>
                        <div class="query-actions">
                            <span>{{ ncfST('Frontend.KnowledgeBase.ReturnUpToValueSegments', topK) }}</span>
                            <el-button type="primary" icon="el-icon-video-play" @@click="doRecall" :loading="recallLoading">{{ ncfST('Frontend.KnowledgeBase.StartTest') }}</el-button>
                        </div>
                    </div>
                </el-card>
            </section>

            <section class="recall-test-right">
                <el-card shadow="never" class="result-panel">
                    <div slot="header" class="panel-heading">
                        <span>{{ ncfST('Frontend.KnowledgeBase.TestResult') }} <em v-if="recallResults.length">{{ ncfST('Frontend.KnowledgeBase.ValueSegments', recallResults.length) }}</em></span>
                        <span v-if="lastElapsedMilliseconds != null" class="result-duration">{{ ncfST('Frontend.KnowledgeBase.DurationValueMs', lastElapsedMilliseconds) }}</span>
                    </div>
                    <div v-if="recallResults.length" class="recall-cards">
                        <article v-for="item in recallResults" :key="item.rank" class="recall-card">
                            <div class="recall-card-meta">
                                <strong>{{ ncfST('Frontend.KnowledgeBase.ItemValue', item.rank) }}</strong>
                                <el-tag size="mini" type="info">{{ ncfST('Frontend.KnowledgeBase.ItemValueSimilarity', formatScore(item.score)) }}</el-tag>
                                <template v-if="item.rerankMode && item.rerankMode !== 'None'">
                                    <el-tag size="mini" type="warning">{{ item.rerankMode === 'Llm' ? ncfST('Frontend.KnowledgeBase.LLMReranking') : ncfST('Frontend.KnowledgeBase.LexicalHybrid') }}</el-tag>
                                    <el-tag size="mini" type="success" v-if="item.rerankScore != null">{{ ncfST('Frontend.KnowledgeBase.RerankingScore') }} {{ formatScore(item.rerankScore) }}</el-tag>
                                    <el-tag size="mini" v-if="item.originalRank && item.originalRank !== item.rank">{{ ncfST('Frontend.KnowledgeBase.OriginalRankValue', item.originalRank) }}</el-tag>
                                </template>
                            </div>
                            <p class="recall-card-content">{{ item.content }}</p>
                            <div class="recall-card-source"><i class="el-icon-document"></i> {{ ncfST('Frontend.KnowledgeBase.SourceLabel') }}{{ item.sourceName || '—' }}</div>
                            <div class="recall-card-actions">
                                <a v-if="item.sourceLink" :href="item.sourceLink" target="_blank" rel="noopener noreferrer">{{ ncfST('Frontend.KnowledgeBase.OpenSource') }} <i class="el-icon-top-right"></i></a>
                                <el-button type="text" size="mini" @@click="openParagraphDetail(item)">{{ ncfST('Frontend.KnowledgeBase.ViewFullText') }}</el-button>
                            </div>
                        </article>
                    </div>
                    <div v-else class="empty-result"><i class="el-icon-search"></i><strong>{{ ncfST('Frontend.KnowledgeBase.NoTestResultsYet') }}</strong><span>{{ ncfST('Frontend.KnowledgeBase.ResultsAppearHereAfterSelectingAKnowledgeBaseAndEnteringAQuestion') }}</span></div>
                </el-card>
            </section>
        </div>

        <section class="records-section">
            <div class="records-title">{{ ncfST('Frontend.KnowledgeBase.TestRecordsOnThisPage') }}</div>
            <el-table :data="recordPageList" size="small" border>
                <el-table-column prop="queryContent" :label="ncfST('Frontend.KnowledgeBase.TestQuestion')" min-width="220" show-overflow-tooltip></el-table-column>
                <el-table-column prop="knowledgeBaseName" label='@XR["Area.KnowledgeBase.Management"]' min-width="150" show-overflow-tooltip></el-table-column>
                <el-table-column prop="resultCount" :label="ncfST('Frontend.KnowledgeBase.ReturnedFragments')" width="100" align="center"></el-table-column>
                <el-table-column :label="ncfST('Frontend.KnowledgeBase.HighestSimilarity')" width="120" align="center"><template slot-scope="scope">{{ formatScore(scope.row.highestScore) }}</template></el-table-column>
                <el-table-column prop="time" :label="ncfST('Frontend.KnowledgeBase.TestTime')" width="170" align="center"></el-table-column>
            </el-table>
            <el-pagination class="records-pagination" :current-page.sync="recordPage" :page-sizes="[5, 10, 15, 20]"
                           :page-size.sync="recordPageSize" :total="recordTotal" layout="total, sizes, prev, pager, next"
                           @@size-change="handleRecordSizeChange" @@current-change="handleRecordPageChange">
            </el-pagination>
        </section>
    </div>

    <el-drawer :title="ncfST('Frontend.KnowledgeBase.NotVectorized')" :visible.sync="visible.searchSettingsDrawer" direction="rtl" size="380px">
        <div class="search-settings-body">
            <div class="search-settings-item">
                <div class="search-settings-label">{{ ncfST('Frontend.KnowledgeBase.RetrievalMethodAlternate') }}</div>
                <div class="search-method-display"><i class="el-icon-connection"></i> {{ ncfST('Frontend.KnowledgeBase.SemanticVectorRetrieval') }}</div>
                <p class="search-method-tip">{{ ncfST('Frontend.KnowledgeBase.TheSystemVectorizesQuestionsAndMaterialFragmentsThenRanksThemBySemantic') }}</p>
            </div>
            <div class="search-settings-item">
                <div class="search-settings-label">{{ ncfST('Frontend.KnowledgeBase.ReturnedFragmentCountTopK') }}<ncf-doc-help topic="knowledge.recall.top-k"></ncf-doc-help></div>
                <p class="search-method-tip">{{ ncfST('Frontend.KnowledgeBase.StartAtFiveIncreaseItWhenResultsAreTooFewOrLower') }}</p>
                <div class="topk-row">
                    <el-slider v-model="topK" :min="1" :max="20" :step="1" show-stops></el-slider>
                    <el-input-number v-model="topK" :min="1" :max="20" :step="1" size="small" controls-position="right"></el-input-number>
                </div>
            </div>
        </div>
        <div class="search-settings-footer"><el-button type="primary" size="small" @@click="visible.searchSettingsDrawer = false">{{ ncfST('Frontend.KnowledgeBase.Done') }}</el-button></div>
    </el-drawer>

    <el-dialog :title="ncfST('Frontend.KnowledgeBase.RetrievedFragmentDetails')" :visible.sync="visible.paragraphDetailDialog" width="620px" @@close="paragraphDetailItem = null">
        <template v-if="paragraphDetailItem">
            <div class="paragraph-detail-meta">{{ ncfST('Frontend.KnowledgeBase.ItemValue', paragraphDetailItem.rank) }} · {{ ncfST('Frontend.KnowledgeBase.ItemValueSimilarity', formatScore(paragraphDetailItem.score)) }}
                <template v-if="paragraphDetailItem.rerankMode && paragraphDetailItem.rerankMode !== 'None' && paragraphDetailItem.originalRank && paragraphDetailItem.originalRank !== paragraphDetailItem.rank"> · {{ ncfST('Frontend.KnowledgeBase.OriginalRerankPositionValue', paragraphDetailItem.originalRank) }}</template>
            </div>
            <div class="paragraph-detail-source">{{ ncfST('Frontend.KnowledgeBase.SourceLabel') }}{{ paragraphDetailItem.sourceName || '—' }}</div>
            <div class="paragraph-detail-content">{{ paragraphDetailItem.content || '—' }}</div>
        </template>
    </el-dialog>
</div>

@section scripts {
    @await Html.PartialAsync("_LocalizationScripts")
    <script src="~/js/KnowledgeBase/Pages/RecallTest/recallTest.js"></script>
}
