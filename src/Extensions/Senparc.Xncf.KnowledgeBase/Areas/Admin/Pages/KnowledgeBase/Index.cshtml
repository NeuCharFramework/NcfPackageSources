@page
@model Senparc.Xncf.KnowledgeBase.Areas.Admin.Pages.KnowledgeBase.IndexModel
@{
    ViewData["Title"] = XR["Area.KnowledgeBase.Management"];
    Layout = "_Layout_Vue";
}

@section Style {
    <link href="~/css/KnowledgeBase/KnowledgeBase/KnowledgeBase.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/KnowledgeBase/RecallTest/RecallTest.css" rel="stylesheet" asp-append-version="true" />
    <style>
        /* Fallback layout: prevent a blank page when external CSS has not refreshed. */
        .el-main.admin-content:has(.knowledge-base-layout),
        .admin-content:has(.knowledge-base-layout) {
            display: block !important;
            box-sizing: border-box !important;
            width: 100% !important;
            height: calc(100vh - 96px) !important;
            min-height: 480px !important;
            padding: 0 !important;
            margin: 0 !important;
            overflow: hidden !important;
            background: #fff !important;
        }
        .admin-content:has(.knowledge-base-layout) .ifram-wrapper {
            display: block !important;
            width: 100% !important;
            height: 100% !important;
            min-height: 480px !important;
            padding: 0 !important;
            margin: 0 !important;
            overflow: hidden !important;
        }
        .knowledge-base-layout {
            display: flex !important;
            flex-direction: row !important;
            width: 100% !important;
            height: 100% !important;
            min-height: 480px !important;
            background: #fff !important;
            overflow: hidden !important;
        }
    </style>
}

@section breadcrumbs {
    <el-breadcrumb-item>@XR["Module.KnowledgeBase.MenuName"]</el-breadcrumb-item>
    <el-breadcrumb-item>@XR["Area.KnowledgeBase.Management"]</el-breadcrumb-item>
}

<div class="knowledge-base-layout">
    @* Left 15%: navigation. *@
    <div class="knowledge-base-layout-left">
        <nav class="knowledge-base-nav-panel">
            <ul class="knowledge-base-nav-list">
                <li class="knowledge-base-nav-item" :class="{ 'is-active': activeNavKey === 'list' }" @@click="onNavClick('list')">
                    <i class="el-icon-notebook-2"></i><span>{{ ncfST('Frontend.KnowledgeBase.KnowledgeBases') }}</span>
                </li>
                <li class="knowledge-base-nav-item" :class="{ 'is-active': activeNavKey === 'recall' }" @@click="onNavClick('recall')">
                    <i class="el-icon-search"></i><span>@XR["Area.KnowledgeBase.RecallTest"]</span>
                </li>
                <li class="knowledge-base-nav-item is-divider"></li>
                <li class="knowledge-base-nav-item" :class="{ 'is-active': activeNavKey === 'guide' }" @@click="onNavClick('guide')">
                    <i class="el-icon-question"></i><span>{{ ncfST('Frontend.KnowledgeBase.KnowledgeBaseGuide') }}</span>
                </li>
            </ul>
        </nav>
    </div>

    @* Main area 85%. *@
    <div class="knowledge-base-layout-main">
        @* Knowledge-base list. *@
        <div class="kb-list-panel" v-show="activeNavKey === 'list' || !activeNavKey">
            <div class="kb-top-bar">
                <div class="kb-top-search">
                    <el-input v-model="keyword"
                              size="small"
                              :placeholder="ncfST('Frontend.KnowledgeBase.SearchKnowledgeBaseName')"
                              prefix-icon="el-icon-search"
                              clearable
                              @@keyup.enter.native="handleSearch()">
                    </el-input>
                </div>
                <div class="kb-top-actions">
                    <el-button size="small" icon="el-icon-refresh" @@click="handleSearch()" :title="ncfST('Frontend.KnowledgeBase.Refresh')"></el-button>
                    <el-popover placement="bottom" :title="ncfST('Frontend.KnowledgeBase.VectorizationFailed')" trigger="click" width="140">
                        <el-checkbox-group v-model="checkedColumns" size="mini">
                            <el-checkbox v-for="item in checkBoxGroup" :key="item" :label="item" :value="item"></el-checkbox>
                        </el-checkbox-group>
                        <el-button slot="reference" size="small" icon="el-icon-s-operation" :title="ncfST('Frontend.KnowledgeBase.VectorizationFailed')"></el-button>
                    </el-popover>
                    <el-button type="primary" size="small" icon="el-icon-plus" @@click="handleEdit('','','add')">{{ ncfST('Frontend.KnowledgeBase.NewKnowledgeBase') }}</el-button>
                    <ncf-doc-help topic="knowledge.create"></ncf-doc-help>
                </div>
            </div>

            <el-alert class="kb-guide-alert"
                      :title="ncfST('Frontend.KnowledgeBase.GettingStartedCreateAKnowledgeBaseAndConfigureEmbeddingAndAVector')"
                      type="info" :closable="false" show-icon>
            </el-alert>

            <div class="kb-table-wrap">
                <el-table :data="tableData"
                          style="width:100%;"
                          size="small"
                          row-key="id"
                          border
                          stripe
                          highlight-current-row
                          ref="multipleTable"
                          @@selection-change="handleSelectionChange"
                          @@row-dblclick="handleDbClick">
                    <template slot="empty">
                        <div class="kb-empty">
                            <i class="el-icon-notebook-2"></i>
                            <strong>{{ ncfST('Frontend.KnowledgeBase.NoKnowledgeBasesYet') }}</strong>
                            <el-button type="primary" size="mini" @@click="handleEdit('','','add')">{{ ncfST('Frontend.KnowledgeBase.NewKnowledgeBase') }}</el-button>
                        </div>
                    </template>
                    <el-table-column type="selection" width="48"></el-table-column>
                    <el-table-column :label="ncfST('Frontend.KnowledgeBase.Close')" min-width="200" sortable prop="name" :filters="filterTableHeader.name" :filter-method="filterHandler">
                        <template slot-scope="scope">
                            <div class="kb-name-cell">
                                <span class="kb-name-main" :title="scope.row.name">{{ scope.row.name }}</span>
                                <span class="kb-name-sub" v-if="scope.row.content" :title="scope.row.content">{{ scope.row.content }}</span>
                            </div>
                        </template>
                    </el-table-column>
                    <el-table-column :label="ncfST('Frontend.KnowledgeBase.VectorizationStatus')" width="120" align="center">
                        <template slot-scope="scope">
                            <el-tag v-if="isKnowledgeBaseReady(scope.row)" size="mini" type="success" class="kb-status-tag">{{ ncfST('Frontend.KnowledgeBase.Vectorized') }}</el-tag>
                            <el-tag v-else size="mini" type="info" class="kb-status-tag">{{ ncfST('Frontend.KnowledgeBase.NotVectorized') }}</el-tag>
                        </template>
                    </el-table-column>
                    <el-table-column v-if="colData[0].istrue" prop="embeddingModelId" align="left" :label="ncfST('Frontend.KnowledgeBase.EmbeddingModelId')" width="140" sortable :filters="filterTableHeader.embeddingModelId" :filter-method="filterHandler"></el-table-column>
                    <el-table-column v-if="colData[1].istrue" prop="vectorDBId" align="left" :label="ncfST('Frontend.KnowledgeBase.VectorDatabaseId')" width="130" sortable :filters="filterTableHeader.vectorDBId" :filter-method="filterHandler"></el-table-column>
                    <el-table-column v-if="colData[2].istrue" prop="chatModelId" align="left" :label="ncfST('Frontend.KnowledgeBase.ChatModelId')" width="120" sortable :filters="filterTableHeader.chatModelId" :filter-method="filterHandler"></el-table-column>
                    <el-table-column v-if="colData[4].istrue" prop="content" align="left" :label="ncfST('Frontend.KnowledgeBase.Content')" min-width="160" show-overflow-tooltip sortable :filters="filterTableHeader.content" :filter-method="filterHandler"></el-table-column>
                    <el-table-column align="center" :label="ncfST('Frontend.KnowledgeBase.AddedTime')" width="170" sortable>
                        <template slot-scope="scope">
                            {{ formaTableTime(scope.row.addTime) }}
                        </template>
                    </el-table-column>
                    <el-table-column :label="ncfST('Frontend.KnowledgeBase.Actions')" align="center" fixed="right" width="300" class-name="ncf-table-actions-column">
                        <template slot-scope="scope">
                            <el-button size="mini" type="primary" icon="el-icon-setting"
                                @@click="handleElVisibleOpenBtn('drawerGroup', scope.row)">{{ ncfST('Frontend.KnowledgeBase.Configure') }}</el-button>
                            <el-button size="mini" type="success" icon="el-icon-data-analysis"
                                @@click="handleEmbeddingBtn('embedding', scope.row)">{{ ncfST('Frontend.KnowledgeBase.Vectorize') }}</el-button>
                            <el-tooltip :content="ncfST('Frontend.KnowledgeBase.More')" placement="top" :open-delay="180">
                            <el-dropdown trigger="click" @@command="handleRowCommand($event, scope.row)">
                                <el-button size="mini" type="text" icon="el-icon-more"
                                    class="ncf-table-action-more" :title="ncfST('Frontend.KnowledgeBase.More')" :aria-label="ncfST('Frontend.KnowledgeBase.More')"></el-button>
                                <el-dropdown-menu slot="dropdown">
                                    <el-dropdown-item command="edit" icon="el-icon-edit">{{ ncfST('Frontend.KnowledgeBase.Edit') }}</el-dropdown-item>
                                    <el-dropdown-item command="recall" icon="el-icon-search">{{ ncfST('Frontend.KnowledgeBase.RecallTest') }}</el-dropdown-item>
                                <el-dropdown-item command="delete" divided icon="el-icon-delete"
                                    class="ncf-table-action-danger">{{ ncfST('Frontend.KnowledgeBase.Delete') }}</el-dropdown-item>
                                </el-dropdown-menu>
                            </el-dropdown>
                            </el-tooltip>
                        </template>
                    </el-table-column>
                </el-table>
            </div>

            <div class="kb-pagination">
                <el-pagination :total="paginationQuery.total"
                               :current-page.sync="listQuery.pageIndex"
                               :page-size.sync="listQuery.pageSize"
                               :page-sizes="[10, 20, 50, 100]"
                               layout="total, sizes, prev, pager, next, jumper"
                               @@size-change="getList"
                               @@current-change="getList">
                </el-pagination>
            </div>
        </div>

        @* Recall test. *@
        <div class="kb-recall-panel" v-show="activeNavKey === 'recall'">
            <div class="recall-test-page">
                <div class="recall-test-wrap">
                    <div class="recall-test-heading">
                        <div>
                            <h1>{{ ncfST('Frontend.KnowledgeBase.RetrievedFragmentDetails') }}</h1>
                            <p>{{ ncfST('Frontend.KnowledgeBase.UseARealisticQuestionToInspectReturnedMaterialFragmentsSimilarityScoresHelp') }}</p>
                        </div>
                        <el-button size="small" icon="el-icon-setting" @@click="visible.searchSettingsDrawer = true">{{ ncfST('Frontend.KnowledgeBase.NotVectorized') }}</el-button>
                    </div>

                    <el-alert class="recall-test-guide" type="info" :closable="false" show-icon
                              :title="ncfST('Frontend.KnowledgeBase.StepsSelectAVectorizedKnowledgeBaseEnterARealisticUserQuestionInspect')">
                    </el-alert>

                    <div class="recall-test-layout">
                        <section class="recall-test-left">
                            <el-card shadow="never">
                                <div slot="header" class="panel-heading"><span>{{ ncfST('Frontend.KnowledgeBase.RunATest') }}</span></div>
                                <div class="knowledge-base-select-row">
                                    <label class="kb-select-label">@XR["Area.KnowledgeBase.Management"]</label>
                                    <el-select v-model="selectedKnowledgeBaseId" filterable clearable :placeholder="ncfST('Frontend.KnowledgeBase.SearchAndSelectAVectorizedKnowledgeBase')" class="kb-select">
                                        <el-option v-for="item in recallKnowledgeBaseList" :key="item.id" :label="item.label" :value="item.id" :disabled="!item.ready"></el-option>
                                    </el-select>
                                </div>
                                <p class="field-tip" v-if="selectedKnowledgeBase">{{ selectedKnowledgeBase.ready ? ncfST('Frontend.KnowledgeBase.Vectorized') : ncfST('Frontend.KnowledgeBase.ThisKnowledgeBaseHasNotBeenVectorizedReturnToTheKnowledgeBase') }}</p>

                                <div class="query-box">
                                    <div class="query-box-header">
                                        <label class="query-label">{{ ncfST('Frontend.KnowledgeBase.TestQuestion') }}</label>
                                        <span class="char-count">{{ recallContent.length }}/200</span>
                                    </div>
                                    <el-input type="textarea" v-model="recallContent" :maxlength="200" :rows="8"
                                              :placeholder="ncfST('Frontend.KnowledgeBase.ExampleHowDoICreateANewKnowledgeBase')" class="query-textarea"></el-input>
                                    <p class="field-tip">{{ ncfST('Frontend.KnowledgeBase.EnterACompleteQuestionARealUserMightAskInsteadOfA') }}</p>
                                    <div class="query-actions">
                                        <span>{{ ncfST('Frontend.KnowledgeBase.ReturnUpToValueSegments', topK) }}</span>
                                        <el-button type="primary" icon="el-icon-video-play" @@click="doRecall" :loading="recallLoading">{{ ncfST('Frontend.KnowledgeBase.StartTest') }}</el-button>
                                    </div>
                                </div>
                            </el-card>
                        </section>

                        <section class="recall-test-right">
                            <el-card shadow="never" class="result-panel">
                                <div slot="header" class="panel-heading">
                                    <span>{{ ncfST('Frontend.KnowledgeBase.TestResult') }} <em v-if="recallResults.length">{{ ncfST('Frontend.KnowledgeBase.ValueSegments', recallResults.length) }}</em></span>
                                    <span v-if="lastElapsedMilliseconds != null" class="result-duration">{{ ncfST('Frontend.KnowledgeBase.DurationValueMs', lastElapsedMilliseconds) }}</span>
                                </div>
                                <div v-if="recallResults.length" class="recall-cards">
                                    <article v-for="item in recallResults" :key="item.rank" class="recall-card">
                                        <div class="recall-card-meta">
                                            <strong>{{ ncfST('Frontend.KnowledgeBase.ItemValue', item.rank) }}</strong>
                                            <el-tag size="mini" type="info">{{ ncfST('Frontend.KnowledgeBase.ItemValueSimilarity', formatScore(item.score)) }}</el-tag>
                                            <template v-if="item.rerankMode && item.rerankMode !== 'None'">
                                                <el-tag size="mini" type="warning">{{ item.rerankMode === 'Llm' ? ncfST('Frontend.KnowledgeBase.LLMReranking') : ncfST('Frontend.KnowledgeBase.LexicalHybrid') }}</el-tag>
                                                <el-tag size="mini" type="success" v-if="item.rerankScore != null">{{ ncfST('Frontend.KnowledgeBase.RerankingScore') }} {{ formatScore(item.rerankScore) }}</el-tag>
                                                <el-tag size="mini" v-if="item.originalRank && item.originalRank !== item.rank">{{ ncfST('Frontend.KnowledgeBase.OriginalRankValue', item.originalRank) }}</el-tag>
                                            </template>
                                        </div>
                                        <p class="recall-card-content">{{ item.content }}</p>
                                        <div class="recall-card-source"><i class="el-icon-document"></i> {{ ncfST('Frontend.KnowledgeBase.SourceLabel') }}{{ item.sourceName || '—' }}</div>
                                        <div class="recall-card-actions">
                                            <a v-if="item.sourceLink" :href="item.sourceLink" target="_blank" rel="noopener noreferrer">{{ ncfST('Frontend.KnowledgeBase.OpenSource') }} <i class="el-icon-top-right"></i></a>
                                            <el-button type="text" size="mini" @@click="openParagraphDetail(item)">{{ ncfST('Frontend.KnowledgeBase.ViewFullText') }}</el-button>
                                        </div>
                                    </article>
                                </div>
                                <div v-else class="empty-result"><i class="el-icon-search"></i><strong>{{ ncfST('Frontend.KnowledgeBase.NoTestResultsYet') }}</strong><span>{{ ncfST('Frontend.KnowledgeBase.ResultsAppearHereAfterSelectingAKnowledgeBaseAndEnteringAQuestion') }}</span></div>
                            </el-card>
                        </section>
                    </div>

                    <section class="records-section">
                        <div class="records-title">{{ ncfST('Frontend.KnowledgeBase.TestRecordsOnThisPage') }}</div>
                        <el-table :data="recordPageList" size="small" border>
                            <el-table-column prop="queryContent" :label="ncfST('Frontend.KnowledgeBase.TestQuestion')" min-width="220" show-overflow-tooltip></el-table-column>
                            <el-table-column prop="knowledgeBaseName" label='@XR["Area.KnowledgeBase.Management"]' min-width="150" show-overflow-tooltip></el-table-column>
                            <el-table-column prop="resultCount" :label="ncfST('Frontend.KnowledgeBase.ReturnedFragments')" width="100" align="center"></el-table-column>
                            <el-table-column :label="ncfST('Frontend.KnowledgeBase.HighestSimilarity')" width="120" align="center"><template slot-scope="scope">{{ formatScore(scope.row.highestScore) }}</template></el-table-column>
                            <el-table-column prop="time" :label="ncfST('Frontend.KnowledgeBase.TestTime')" width="170" align="center"></el-table-column>
                        </el-table>
                        <el-pagination class="records-pagination" :current-page.sync="recordPage" :page-sizes="[5, 10, 15, 20]"
                                       :page-size.sync="recordPageSize" :total="recordTotal" layout="total, sizes, prev, pager, next"
                                       @@size-change="handleRecordSizeChange" @@current-change="handleRecordPageChange">
                        </el-pagination>
                    </section>
                </div>
            </div>
        </div>

        @* Usage guide. *@
        <div class="kb-guide-panel" v-show="activeNavKey === 'guide'">
            <div class="kb-guide-card">
                <h3>{{ ncfST('Frontend.KnowledgeBase.KnowledgeBaseGuide') }}</h3>
                <ol>
                    <li>{{ ncfST('Frontend.KnowledgeBase.ChooseNewKnowledgeBaseEnterANameAndSelectAnEmbeddingModel') }}</li>
                    <li>{{ ncfST('Frontend.KnowledgeBase.ChooseConfigurationInTheListToAssociateTextOrUploadSelectMaterial') }}</li>
                    <li>{{ ncfST('Frontend.KnowledgeBase.ChooseVectorizeAndWaitForCompletionTheStatusChangesToVectorizedWhen') }}</li>
                    <li>{{ ncfST('Frontend.KnowledgeBase.OpenRecallTestOnTheLeftSelectThisKnowledgeBaseAndEnter') }}</li>
                    <li>{{ ncfST('Frontend.KnowledgeBase.IfResultsArePoorReturnToConfigurationAdjustMaterialsVectorizeAgainAnd') }}</li>
                </ol>
                <div class="kb-guide-tip">{{ ncfST('Frontend.KnowledgeBase.TipChangingMaterialAssociationsInvalidatesBuiltVectorsBeSureToVectorizeAgain') }}</div>
            </div>
        </div>
    </div>

    @* Shared dialogs: create/edit, configuration, upload, and vectorization. *@
    <el-dialog :title="dialog.title"
               custom-class="kb-edit-dialog"
               :visible.sync="dialog.visible"
               :close-on-click-modal="false"
               width="640px"
               append-to-body>
        <el-form ref="dataForm"
                 class="kb-edit-form"
                 :rules="dialog.rules"
                 :model="dialog.data"
                 :disabled="dialog.disabled"
                 size="small"
                 label-position="right"
                 label-width="120px">
            <el-form-item :label="ncfST('Frontend.KnowledgeBase.Close')" prop="name">
                <el-input v-model="dialog.data.name" clearable :placeholder="ncfST('Frontend.KnowledgeBase.EnterAKnowledgeBaseName')" />
            </el-form-item>

            <el-form-item :label="ncfST('Frontend.KnowledgeBase.EmbeddingModel')" prop="embeddingModelId">
                <el-select v-model="dialog.data.embeddingModelId"
                           class="kb-edit-select"
                           popper-class="kb-edit-select-dropdown"
                           clearable
                           filterable
                           :placeholder="ncfST('Frontend.KnowledgeBase.SelectAnEmbeddingModelAlternate')"
                           style="width: 100%;">
                    <el-option v-for="item in embeddingModelData"
                               :key="item.id"
                               :label="formatSelectLabel(item, ncfST('Frontend.KnowledgeBase.ChatModel'))"
                               :value="item.id">
                    </el-option>
                </el-select>
            </el-form-item>

            <el-form-item :label="ncfST('Frontend.KnowledgeBase.VectorDatabase')" prop="vectorDBId">
                <el-select v-model="dialog.data.vectorDBId"
                           class="kb-edit-select"
                           popper-class="kb-edit-select-dropdown"
                           clearable
                           filterable
                           :placeholder="ncfST('Frontend.KnowledgeBase.SelectARedisOrQdrantVectorStore')"
                           style="width: 100%;">
                    <el-option v-for="item in vectorDBData"
                               :key="item.id"
                               :label="formatSelectLabel(item, ncfST('Frontend.KnowledgeBase.VectorDatabase'))"
                               :value="item.id">
                    </el-option>
                </el-select>
                <div v-if="!vectorDBData.length" class="kb-edit-form-inline-tip">{{ ncfST('Frontend.KnowledgeBase.NoPersistentVectorStoreIsAvailableConfigureRedisOrQdrantInAIKernel') }}</div>
            </el-form-item>

            <el-form-item :label="ncfST('Frontend.KnowledgeBase.ChatModel')" prop="chatModelId">
                <el-select v-model="dialog.data.chatModelId"
                           class="kb-edit-select"
                           popper-class="kb-edit-select-dropdown"
                           clearable
                           filterable
                           :placeholder="ncfST('Frontend.KnowledgeBase.SelectAChatModel')"
                           style="width: 100%;">
                    <el-option v-for="item in chatModelData"
                               :key="item.id"
                               :label="formatSelectLabel(item, ncfST('Frontend.KnowledgeBase.ChatModel'))"
                               :value="item.id">
                    </el-option>
                </el-select>
            </el-form-item>

            <el-divider content-position="left">{{ ncfST('Frontend.KnowledgeBase.RetrievalAndChunking') }}</el-divider>

            <el-form-item :label="ncfST('Frontend.KnowledgeBase.ChunkingStrategy')" prop="retrievalConfig.chunkingStrategy">
                <el-select v-model="dialog.data.retrievalConfig.chunkingStrategy"
                           class="kb-edit-select"
                           :placeholder="ncfST('Frontend.KnowledgeBase.SelectAChunkingStrategy')"
                           style="width: 100%;">
                    <el-option :label="ncfST('Frontend.KnowledgeBase.FixedLengthDefault')" value="Fixed"></el-option>
                    <el-option :label="ncfST('Frontend.KnowledgeBase.RecursiveStructureRecommendedForLongDocuments')" value="Recursive"></el-option>
                    <el-option :label="ncfST('Frontend.KnowledgeBase.ByParagraph')" value="Paragraph"></el-option>
                </el-select>
            </el-form-item>

            <el-form-item :label="ncfST('Frontend.KnowledgeBase.ChunkSizeOverlap')" prop="retrievalConfig.chunkSize">
                <div class="kb-chunk-size-row">
                    <el-input-number v-model="dialog.data.retrievalConfig.chunkSize"
                                     :min="100" :max="8000" :step="100" size="small" controls-position="right"></el-input-number>
                    <span class="kb-chunk-size-unit">{{ ncfST('Frontend.KnowledgeBase.CharactersOverlap') }}</span>
                    <el-input-number v-model="dialog.data.retrievalConfig.chunkOverlap"
                                     :min="0" :max="4000" :step="20" size="small" controls-position="right"></el-input-number>
                    <span class="kb-chunk-size-unit">{{ ncfST('Frontend.KnowledgeBase.CharactersOverlap') }}</span>
                </div>
            </el-form-item>

            <el-form-item :label="ncfST('Frontend.KnowledgeBase.Reranking')" prop="retrievalConfig.rerankMode">
                <el-select v-model="dialog.data.retrievalConfig.rerankMode"
                           class="kb-edit-select"
                           :placeholder="ncfST('Frontend.KnowledgeBase.SelectARerankingMode')"
                           style="width: 100%;">
                    <el-option :label="ncfST('Frontend.KnowledgeBase.OffDefault')" value="None"></el-option>
                    <el-option :label="ncfST('Frontend.KnowledgeBase.LexicalHybridNoExtraModelCall')" value="Lexical"></el-option>
                    <el-option :label="ncfST('Frontend.KnowledgeBase.LLMRerankingUsingAChatModel')" value="Llm"></el-option>
                </el-select>
            </el-form-item>

            <el-form-item v-if="dialog.data.retrievalConfig.rerankMode === 'Llm'" :label="ncfST('Frontend.KnowledgeBase.RerankingModel')">
                <el-select v-model="dialog.data.retrievalConfig.rerankModelId"
                           class="kb-edit-select"
                           clearable
                           filterable
                           :placeholder="ncfST('Frontend.KnowledgeBase.LeaveEmptyToUseThisKnowledgeBaseSChatModel')"
                           style="width: 100%;">
                    <el-option v-for="item in chatModelData"
                               :key="item.id"
                               :label="formatSelectLabel(item, ncfST('Frontend.KnowledgeBase.ChatModel'))"
                               :value="item.id">
                    </el-option>
                </el-select>
            </el-form-item>

            <el-form-item v-if="dialog.data.retrievalConfig.rerankMode !== 'None'" :label="ncfST('Frontend.KnowledgeBase.RerankingCandidateCount')">
                <div class="kb-chunk-size-row">
                    <el-input-number v-model="dialog.data.retrievalConfig.rerankCandidateCount"
                                     :min="5" :max="100" :step="5" size="small" controls-position="right"></el-input-number>
                    <span class="kb-chunk-size-unit">{{ ncfST('Frontend.KnowledgeBase.CandidatesRetrieveCandidatesFirstThenRerankToTopK') }}</span>
                </div>
            </el-form-item>

            <el-form-item v-if="dialog.data.retrievalConfig.rerankMode === 'Lexical'" :label="ncfST('Frontend.KnowledgeBase.LexicalWeight')">
                <div class="kb-chunk-size-row">
                    <el-slider v-model="dialog.data.retrievalConfig.lexicalWeight"
                               :min="0" :max="1" :step="0.05"
                               style="width: 180px;"></el-slider>
                    <span class="kb-chunk-size-unit">{{ dialog.data.retrievalConfig.lexicalWeight }}{{ ncfST('Frontend.KnowledgeBase.LexicalScoreShareOfTheFusedScore') }}</span>
                </div>
            </el-form-item>

            <el-form-item :label="ncfST('Frontend.KnowledgeBase.Source')" prop="content">
                <el-input type="textarea"
                          v-model="dialog.data.content"
                          :rows="4"
                          clearable
                          :placeholder="ncfST('Frontend.KnowledgeBase.EnterContentOptional')" />
            </el-form-item>

            <p class="kb-edit-form-tip">{{ ncfST('Frontend.KnowledgeBase.VectorStoresSupportRedisQdrantOnlyMemoryCannotPersistAcrossRequestsAfter') }}<br />{{ ncfST('Frontend.KnowledgeBase.ChangesToChunkingStrategySizeOverlapTakeEffectAfterSavingTheContent') }}</p>
        </el-form>
        <div slot="footer" class="kb-edit-dialog-footer">
            <el-button class="kb-btn-cancel" size="small" @@click="dialog.visible=false">{{ ncfST('Frontend.KnowledgeBase.EnterAnAttributeName') }}</el-button>
            <el-button class="kb-btn-confirm" size="small" :loading="dialog.updateLoading" :disabled="dialog.disabled" @@click="updateData">{{ ncfST('Frontend.KnowledgeBase.Done') }}</el-button>
        </div>
    </el-dialog>

    @* Drawer for creating or editing knowledge-base associations. *@
    <el-drawer :visible.sync="visible.drawerGroup" direction="rtl" :with-header="false" :wrapper-closable="false"
               :close-on-press-escape="false" size="960px" append-to-body>
        <div class="drawerRtl">
            <div class="drawerRtl__header">
                <div class="drawerRtl__header__title">{{ ncfST('Frontend.KnowledgeBase.ManageKnowledgeBaseMaterials') }}</div>
                <div class="drawerRtl__header__close" @@click="handleElVisibleClose('drawerGroup')">&times;</div>
            </div>
            <div class="drawerRtl__body">
                <el-form v-if="visible.drawerGroup" ref="groupELForm" :model="groupForm" :rules="groupFormRules"
                         :size="elSize" label-position="left" label-width="130px" class="drawerForm-container">
                    <el-form-item :label="ncfST('Frontend.KnowledgeBase.Source')">
                        <el-select size="mini" v-model="groupForm.contentType" :placeholder="ncfST('Frontend.KnowledgeBase.Source')">
                            <el-option v-for="item in contentTypeData" :key="item.value" :label="item.label" :value="item.value"></el-option>
                        </el-select>
                    </el-form-item>
                    <el-alert v-if="groupForm.contentType === 2"
                              :title="ncfST('Frontend.KnowledgeBase.AfterSavingMaterialAssociationsBuiltVectorsBecomeInvalidReturnToTheList')"
                              type="warning" :closable="false" show-icon style="margin-bottom: 16px;">
                    </el-alert>
                    <el-form-item v-if="groupForm.contentType === 2" :label="ncfST('Frontend.KnowledgeBase.SelectKnowledgeBaseMaterials')" prop="files">
                        <div class="groupFMB">
                            <div class="df-wn flex-ac flex-jsb" style="gap: 10px;margin-bottom: 10px;">
                                <div class="df-wn flex-ac" style="gap: 10px;">
                                    <el-input v-model="fileQueryList.filter" size="small"
                                              :placeholder="ncfST('Frontend.KnowledgeBase.SearchByFileName')" style="width:auto;"></el-input>
                                    <el-button size="small" icon="el-icon-search"
                                               @@click="handleConfigFileSearch">{{ ncfST('Frontend.KnowledgeBase.EnterTheEmbeddingModelId') }}</el-button>
                                </div>
                            </div>
                            <div class="df-wn flex-ac flex-jsb" style="gap: 10px;margin-bottom: 10px;">
                                <div class="df-wn flex-ac" style="gap: 10px;">
                                    <el-button size="small" type="primary" icon="el-icon-upload2"
                                               @@click="handleElVisibleOpenBtn('dialogFile')">{{ ncfST('Frontend.KnowledgeBase.UploadKnowledgeBaseMaterials') }}</el-button>
                                    <el-button size="small" icon="el-icon-close"
                                               @@click="clearConfigFileSelection">{{ ncfST('Frontend.KnowledgeBase.ClearSelectionAlternate') }}</el-button>
                                </div>
                            </div>
                            <div class="df-wn flex-as flex-js" style="gap: 10px;margin-bottom: 10px;">
                                <span class="groupFMB_ma_label">{{ ncfST('Frontend.KnowledgeBase.SelectedMaterials') }}</span>
                                <div class="groupFMB_ma_list">
                                    <div class="df flex-ac flex-js" style="gap:10px">
                                        <div v-for="(item,index) in groupForm.files" :key="item.id"
                                             class="df-wn flex-ac groupFMB_ma_list_item">
                                            <span class="groupFMB_ma_list_item_text">{{ item.name }}</span>
                                            <i class="el-icon-close cursorPointer"
                                               @@click="groupMembersCancel(item,index)"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <el-table ref="groupAgentTable" key="groupAgentTable" :data="fileList" max-height="380"
                                      style="width: 100%;margin-bottom: 10px;border: 1px solid rgba(229, 229, 229, 1);"
                                      @@selection-change="handleConfigFileSelectionChange">
                                <el-table-column type="selection" width="30"></el-table-column>
                                <el-table-column prop="fileName" :label="ncfST('Frontend.KnowledgeBase.AvailableMaterials')" width="200"
                                                 show-overflow-tooltip></el-table-column>
                                <el-table-column prop="fileSize" :label="ncfST('Frontend.KnowledgeBase.Delete')" width="100">
                                </el-table-column>
                                <el-table-column :label="ncfST('Frontend.KnowledgeBase.UploadFile')" width="130" align="center">
                                    <template slot-scope="scope">
                                        {{ formaTableTime(scope.row.uploadTime) }}
                                    </template>
                                </el-table-column>
                                <el-table-column fixed="right" :label="ncfST('Frontend.KnowledgeBase.RecallTest')" width="130" class-name="ncf-table-actions-column">
                                    <template slot-scope="{ row }">
                                        <el-button size="small"
                                                   @@click="removeConfigFileSelection(row)">{{ ncfST('Frontend.KnowledgeBase.ClearSelection') }}</el-button>
                                    </template>
                                </el-table-column>
                            </el-table>
                            <div class="df-wn flex-ac flex-jsb" style="margin-top:10px;flex-wrap:wrap;gap:8px;">
                                <span class="el-pagination__total" style="margin-right:12px;">{{ ncfST('Frontend.KnowledgeBase.ValueMaterialsSelected', groupForm.files.length) }}</span>
                                <el-pagination :current-page.sync="fileQueryList.pageIndex"
                                               :page-size="fileQueryList.pageSize"
                                               :page-sizes="[10, 20, 50,100]"
                                               :total="fileListTotal"
                                               layout="total, sizes, prev, pager, next, jumper"
                                               @@size-change="handleConfigFileSizeChange"
                                               @@current-change="handleConfigFilePageChange">
                                </el-pagination>
                            </div>
                        </div>
                    </el-form-item>
                    <el-form-item v-if="groupForm.contentType === 1 || groupForm.contentType === 3" :label="ncfST('Frontend.KnowledgeBase.Source')">
                        <el-input type="textarea" v-model="groupForm.content" :rows="4" :placeholder="ncfST('Frontend.KnowledgeBase.VectorizationOfKnowledgeBaseValueIsComplete')"></el-input>
                    </el-form-item>
                </el-form>
            </div>
            <div class="drawerRtl__footer text-right">
                <el-button :size="elSize" @@click="handleElVisibleClose('drawerGroup')">{{ ncfST('Frontend.KnowledgeBase.EnterAnAttributeName') }}</el-button>
                <el-button :size="elSize" type="primary" @@click="handleElVisibleSubmit('drawerGroup')">{{ ncfST('Frontend.KnowledgeBase.Done') }}</el-button>
            </div>
        </div>
    </el-drawer>

    @* Upload dialog inside the configuration view. *@
    <el-dialog :title="ncfST('Frontend.KnowledgeBase.UploadKnowledgeBaseMaterials')"
               :visible.sync="visible.dialogFile"
               width="480px"
               :close-on-click-modal="false"
               append-to-body
               @@close="handleDialogFileClose">
        <el-upload class="upload-demo"
                   ref="configUploadRef"
                   action="/api/Senparc.Xncf.KnowledgeBase/CommonService/Xncf.KnowledgeBase_CommonService.UploadAsync"
                   :auto-upload="true"
                   :multiple="true"
                   :show-file-list="true"
                   :on-success="configUploadSuccess"
                   :on-error="configUploadError"
                   :file-list="configUploadFileList">
            <el-button slot="trigger" size="small" type="primary">{{ ncfST('Frontend.KnowledgeBase.SelectMaterialFiles') }}</el-button>
            <div slot="tip" class="el-upload__tip">{{ ncfST('Frontend.KnowledgeBase.OnlySafelyExtractableTextAndOfficeFilesAreSupportedUploadedFilesAre') }}</div>
        </el-upload>
        <div slot="footer" class="dialog-footer">
            <el-button size="mini" @@click="visible.dialogFile = false">{{ ncfST('Frontend.KnowledgeBase.PendingReview') }}</el-button>
        </div>
    </el-dialog>

    @* Vectorization progress: non-blocking floating task panel. *@
    <div class="kb-embedding-float" v-show="visible.embeddingProgress" :class="{ 'is-collapsed': embeddingPanelCollapsed, 'is-success': embeddingProgressStatus === 'success', 'is-error': embeddingProgressStatus === 'exception' }">
        <div class="kb-embedding-float__header" @@click="embeddingPanelCollapsed = !embeddingPanelCollapsed">
            <div class="kb-embedding-float__summary">
                <el-progress type="circle"
                             :percentage="embeddingProgressPercent"
                             :width="28"
                             :stroke-width="3"
                             :status="embeddingProgressStatus"
                             :show-text="true">
                </el-progress>
                <span class="kb-embedding-float__summary-text">
                    <template v-if="embeddingProgressStatus === 'success'">{{ ncfST('Frontend.KnowledgeBase.ProcessedValue', embeddingDoneCount + '/' + embeddingTotalCount) }}</template>
                    <template v-else-if="embeddingProgressStatus === 'exception'">{{ ncfST('Frontend.KnowledgeBase.FailedValue', embeddingDoneCount + '/' + embeddingTotalCount) }}</template>
                    <template v-else>{{ ncfST('Frontend.KnowledgeBase.ProcessingValue', embeddingDoneCount + '/' + embeddingTotalCount) }}</template>
                </span>
            </div>
            <i class="kb-embedding-float__toggle" :class="embeddingPanelCollapsed ? 'el-icon-arrow-up' : 'el-icon-arrow-down'"></i>
        </div>
        <div class="kb-embedding-float__body" v-show="!embeddingPanelCollapsed">
            <div class="kb-embedding-float__task">
                <span class="kb-embedding-float__task-name" :title="embeddingTaskName">{{ embeddingTaskName || ncfST('Frontend.KnowledgeBase.VectorizationStatus') }}</span>
                <div class="kb-embedding-float__task-bar">
                    <el-progress :percentage="embeddingProgressPercent"
                                 :status="embeddingProgressStatus"
                                 :stroke-width="6"
                                 :show-text="false">
                    </el-progress>
                </div>
                <span class="kb-embedding-float__task-pct">{{ embeddingProgressPercent }}%</span>
            </div>
            <p class="kb-embedding-float__hint">{{ embeddingProgressText }}</p>
        </div>
    </div>

    @* Vectorization result: floating result toast. *@
    <div class="kb-embedding-result-toast"
         v-show="visible.embeddingResult"
         :class="{ 'is-error': embeddingResultCard.isError }">
        <i class="kb-embedding-result-toast__close el-icon-close" @@click="closeEmbeddingResultToast"></i>
        <div class="kb-embedding-result-toast__row">
            <span class="kb-embedding-result-toast__icon" :class="embeddingResultCard.isError ? 'is-error' : 'is-success'">
                <i :class="embeddingResultCard.isError ? 'el-icon-close' : 'el-icon-check'"></i>
            </span>
            <div class="kb-embedding-result-toast__content">
                <div class="kb-embedding-result-toast__title">{{ embeddingResultCard.title }}</div>
                <div class="kb-embedding-result-toast__meta">
                    {{ ncfST('Frontend.KnowledgeBase.YourRequestForValueWasStartedAtValue', embeddingResultCard.timeText, embeddingResultCard.taskName) }}
                </div>
                <div class="kb-embedding-result-toast__stats">
                    {{ ncfST('Frontend.KnowledgeBase.ProcessedValueSucceededValueFailedValue', embeddingResultCard.total, embeddingResultCard.success, embeddingResultCard.fail) }}
                </div>
                <div class="kb-embedding-result-toast__detail" v-if="embeddingResultCard.detail">{{ embeddingResultCard.detail }}</div>
            </div>
        </div>
    </div>

    @* Recall: search settings. *@
    <el-drawer :title="ncfST('Frontend.KnowledgeBase.RetrievalSettings')" :visible.sync="visible.searchSettingsDrawer" direction="rtl" size="380px" append-to-body>
        <div class="search-settings-body">
            <div class="search-settings-item">
                <div class="search-settings-label">{{ ncfST('Frontend.KnowledgeBase.RetrievalMethodAlternate') }}</div>
                <div class="search-method-display"><i class="el-icon-connection"></i> {{ ncfST('Frontend.KnowledgeBase.SemanticVectorRetrieval') }}</div>
                <p class="search-method-tip">{{ ncfST('Frontend.KnowledgeBase.TheSystemVectorizesQuestionsAndMaterialFragmentsThenRanksThemBySemantic') }}</p>
            </div>
            <div class="search-settings-item">
                <div class="search-settings-label">{{ ncfST('Frontend.KnowledgeBase.ReturnedFragmentCountTopK') }}</div>
                <p class="search-method-tip">{{ ncfST('Frontend.KnowledgeBase.StartAtFiveIncreaseItWhenResultsAreTooFewOrLower') }}</p>
                <div class="topk-row">
                    <el-slider v-model="topK" :min="1" :max="20" :step="1" show-stops></el-slider>
                    <el-input-number v-model="topK" :min="1" :max="20" :step="1" size="small" controls-position="right"></el-input-number>
                </div>
            </div>
            <div class="search-settings-item">
                <div class="search-settings-label">{{ ncfST('Frontend.KnowledgeBase.RerankingThisTest') }}</div>
                <el-select v-model="recallRerankMode" size="small" style="width: 100%;">
                    <el-option :label="ncfST('Frontend.KnowledgeBase.FollowKnowledgeBaseSettings')" value=""></el-option>
                    <el-option :label="ncfST('Frontend.KnowledgeBase.OffDefault')" value="None"></el-option>
                    <el-option :label="ncfST('Frontend.KnowledgeBase.LexicalHybrid')" value="Lexical"></el-option>
                    <el-option :label="ncfST('Frontend.KnowledgeBase.LLMReranking')" value="Llm"></el-option>
                </el-select>
                <p class="search-method-tip" v-if="selectedKnowledgeBase">{{ ncfST('Frontend.KnowledgeBase.CurrentKnowledgeBaseConfiguration') }}{{ recallRerankSummary }}</p>
            </div>
        </div>
        <div class="search-settings-footer"><el-button type="primary" size="small" @@click="visible.searchSettingsDrawer = false">{{ ncfST('Frontend.KnowledgeBase.Done') }}</el-button></div>
    </el-drawer>

    @* Recall: fragment details. *@
    <el-dialog :title="ncfST('Frontend.KnowledgeBase.RetrievedFragmentDetails')" :visible.sync="visible.paragraphDetailDialog" width="620px" append-to-body @@close="paragraphDetailItem = null">
        <template v-if="paragraphDetailItem">
            <div class="paragraph-detail-meta">{{ ncfST('Frontend.KnowledgeBase.ItemValueSimilarity', paragraphDetailItem.rank) }} {{ formatScore(paragraphDetailItem.score) }}
                <template v-if="paragraphDetailItem.rerankMode && paragraphDetailItem.rerankMode !== 'None' && paragraphDetailItem.originalRank && paragraphDetailItem.originalRank !== paragraphDetailItem.rank"> {{ ncfST('Frontend.KnowledgeBase.OriginalRerankPositionValue', paragraphDetailItem.originalRank) }}</template>
            </div>
            <div class="paragraph-detail-source">{{ ncfST('Frontend.KnowledgeBase.SourceLabel') }}{{ paragraphDetailItem.sourceName || ncfST('Frontend.KnowledgeBase.Source') }}</div>
            <div class="paragraph-detail-content">{{ paragraphDetailItem.content || '—' }}</div>
        </template>
    </el-dialog>
</div>
@section scripts
{
    @await Html.PartialAsync("_LocalizationScripts")
    <script src="~/js/KnowledgeBase/Pages/KnowledgeBase/knowledgeBase.js" asp-append-version="true"></script>
}
