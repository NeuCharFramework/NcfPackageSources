@using System.Text.Json
@using Microsoft.Extensions.Localization
@using Senparc.Ncf.Core.Localization
@using Senparc.Xncf.KnowledgeBase
@inject IStringLocalizer<KnowledgeBaseResource> XR
@inject IStringLocalizerFactory LocalizationFactory
@{
    var sourceTranslations = FrontendTranslationCatalog.Get(
        LocalizationFactory,
        typeof(KnowledgeBaseResource));
}
<script>window.ncfRegisterSourceTranslations(@Html.Raw(JsonSerializer.Serialize(sourceTranslations)), "KnowledgeBase");</script>
