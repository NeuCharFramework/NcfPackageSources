@page
@model Senparc.Xncf.MCP.Areas.MCP.Pages.Index
@{
    ViewData["Title"] = $"{Model.XncfRegister.MenuName} - {XR["Area.Home"]}";
    Layout = "_Layout_Vue";
}

@section Style {
    <link href="~/css/MCP/index.css" rel="stylesheet" asp-append-version="true" />
}

@section breadcrumbs {
    <el-breadcrumb-item>@XR["Area.Extensions"]</el-breadcrumb-item>
    <el-breadcrumb-item>MCP Manager</el-breadcrumb-item>
    <el-breadcrumb-item>@XR["Area.Home"]</el-breadcrumb-item>
}

<div>
    <el-container>
        <el-header class="module-header">
            <span class="start-title"><i class="fa fa-dot-circle-o"></i>&nbsp;<span class="module-header-v">@XR["Area.Home"]</span></span>
        </el-header>
        <el-main>
            <div class="mcp-admin-page">
                <div class="mcp-admin-toolbar">
                    <span class="mcp-admin-toolbar__title">MCP Endpoint 管理</span>
                    <div>
                        <el-checkbox v-model="onlyEnabled" style="margin-right:12px;">仅显示已启用</el-checkbox>
                        <el-input v-model="filterText" placeholder="搜索名称 / 地址 / 描述" prefix-icon="el-icon-search"
                            clearable size="small" style="width:220px;margin-right:12px;"></el-input>
                        <el-button type="primary" size="small" icon="el-icon-plus" @@click="handleAdd">新增 Endpoint</el-button>
                    </div>
                </div>

                <el-table :data="filteredTableData" style="width:100%" v-loading="loading" row-key="id">
                    <el-table-column prop="name" label="名称" min-width="140" show-overflow-tooltip></el-table-column>
                    <el-table-column label="端点地址" min-width="220" show-overflow-tooltip>
                        <template slot-scope="scope">
                            <span class="mcp-endpoint-url">{{ scope.row.endpoint }}</span>
                        </template>
                    </el-table-column>
                    <el-table-column prop="endpointType" label="类型" width="90"></el-table-column>
                    <el-table-column prop="protocolVersion" label="协议版本" width="90"></el-table-column>
                    <el-table-column prop="description" label="描述" min-width="140" show-overflow-tooltip></el-table-column>
                    <el-table-column label="启用" width="80" align="center">
                        <template slot-scope="scope">
                            <el-switch v-model="scope.row.enabled" @@change="handleToggleEnabled(scope.row)"></el-switch>
                        </template>
                    </el-table-column>
                    <el-table-column label="最近测试" width="200">
                        <template slot-scope="scope">
                            <div class="mcp-test-status-cell" v-if="scope.row.lastTestedTime">
                                <el-tag :type="scope.row.lastTestResult ? 'success' : 'danger'" size="mini">
                                    {{ scope.row.lastTestResult ? '成功' : '失败' }}
                                </el-tag>
                                <span class="mcp-test-time">{{ formatDateTime(scope.row.lastTestedTime) }}</span>
                                <div v-if="scope.row.lastToolCount != null">工具 {{ scope.row.lastToolCount }}</div>
                            </div>
                            <span v-else style="color:#c0c4cc;">未测试</span>
                        </template>
                    </el-table-column>
                    <el-table-column label="操作" width="230" align="center">
                        <template slot-scope="scope">
                            <el-button size="mini" type="success" icon="el-icon-connection"
                                :loading="testLoadingId === scope.row.id" @@click="handleTest(scope.row)">测试</el-button>
                            <el-button size="mini" type="primary" plain icon="el-icon-edit"
                                @@click="handleEdit(scope.row)">编辑</el-button>
                            <el-button size="mini" type="danger" plain icon="el-icon-delete"
                                @@click="handleDelete(scope.row)">删除</el-button>
                        </template>
                    </el-table-column>
                </el-table>
            </div>
        </el-main>
    </el-container>

    <!-- 新增/编辑对话框 -->
    <el-dialog :title="dialogTitle" :visible.sync="dialogVisible" width="640px" :close-on-click-modal="false">
        <el-form :model="form" :rules="rules" ref="mcpForm" label-width="110px">
            <el-form-item label="名称" prop="name">
                <el-input v-model="form.name" placeholder="用于唯一标识该 MCP 端点"></el-input>
            </el-form-item>
            <el-form-item label="端点地址" prop="endpoint">
                <el-input v-model="form.endpoint" placeholder="例如 http://localhost:3001/mcp/sse"></el-input>
            </el-form-item>
            <el-form-item label="端点类型">
                <el-select v-model="form.endpointType" style="width:100%;">
                    <el-option v-for="t in endpointTypeOptions" :key="t" :label="t" :value="t"></el-option>
                </el-select>
            </el-form-item>
            <el-form-item label="协议版本">
                <el-input v-model="form.protocolVersion" placeholder="例如 1.0（可选）"></el-input>
            </el-form-item>
            <el-form-item label="描述">
                <el-input v-model="form.description" type="textarea" :rows="2" placeholder="可选"></el-input>
            </el-form-item>
            <el-form-item label="Bearer Token">
                <el-input v-model="form.bearerToken" type="textarea" :rows="2"
                    placeholder="可选，保存为 AuthConfig JSON（字段 token）"></el-input>
            </el-form-item>
            <el-form-item label="启用">
                <el-switch v-model="form.enabled"></el-switch>
            </el-form-item>
            <el-form-item label="保存前测试">
                <div class="mcp-form-test-block" style="width:100%;">
                    <el-button size="small" type="success" plain icon="el-icon-connection"
                        :loading="preTestLoading" @@click="handleTestBeforeSave">测试当前配置连接</el-button>
                    <el-alert v-if="preTestResult" :title="preTestResult.statusMessage"
                        :type="preTestResult.success ? 'success' : 'error'"
                        :description="preTestResult.success ? ('发现 ' + preTestResult.toolCount + ' 个工具（Function）') : ''"
                        show-icon :closable="false" style="margin-top:8px;"></el-alert>
                </div>
            </el-form-item>
        </el-form>
        <div slot="footer" class="dialog-footer">
            <el-button @@click="dialogVisible = false">取消</el-button>
            <el-button type="primary" @@click="handleSubmit">保存</el-button>
        </div>
    </el-dialog>

    <!-- 连接测试结果对话框（含可展开的 Function 信息） -->
    <el-dialog :title="'连接测试 - ' + testResultEndpointName" :visible.sync="testDialogVisible" width="820px" top="6vh">
        <div v-if="testResult">
            <el-alert :title="testResult.statusMessage" :type="testResult.success ? 'success' : 'error'"
                show-icon :closable="false" style="margin-bottom:12px;"></el-alert>
            <div v-if="testResult.success">
                <div style="margin-bottom:8px;color:#606266;">
                    共发现 <b>{{ testResultTools.length }}</b> 个工具（Function）。点击左侧箭头展开查看参数与输入 Schema。
                </div>
                <el-table :data="testResultTools" size="small" row-key="name"
                    :expand-row-keys="expandedTools" @@expand-change="handleToolExpandChange">
                    <el-table-column type="expand">
                        <template slot-scope="props">
                            <div style="padding:6px 24px 12px;">
                                <div v-if="props.row.parameters && props.row.parameters.length" style="margin-bottom:10px;">
                                    <div style="font-weight:600;margin-bottom:6px;">参数列表</div>
                                    <el-table :data="props.row.parameters" size="mini" class="mcp-tool-params">
                                        <el-table-column prop="name" label="参数名" min-width="140"></el-table-column>
                                        <el-table-column prop="type" label="类型" width="120"></el-table-column>
                                        <el-table-column label="必填" width="70" align="center">
                                            <template slot-scope="p">
                                                <el-tag v-if="p.row.required" type="danger" size="mini">是</el-tag>
                                                <span v-else style="color:#c0c4cc;">否</span>
                                            </template>
                                        </el-table-column>
                                        <el-table-column prop="description" label="描述" min-width="200" show-overflow-tooltip></el-table-column>
                                    </el-table>
                                </div>
                                <div>
                                    <div style="font-weight:600;margin-bottom:6px;display:flex;justify-content:space-between;align-items:center;">
                                        <span>输入 Schema（JSON）</span>
                                        <el-button size="mini" type="text" icon="el-icon-zoom-in"
                                            @@click="showSchema(props.row)">放大查看</el-button>
                                    </div>
                                    <pre class="mcp-schema-pre">{{ formatSchemaJson(props.row.inputSchemaJson) || '（无）' }}</pre>
                                </div>
                            </div>
                        </template>
                    </el-table-column>
                    <el-table-column prop="name" label="工具名称" min-width="160" show-overflow-tooltip></el-table-column>
                    <el-table-column prop="title" label="标题" min-width="120" show-overflow-tooltip></el-table-column>
                    <el-table-column label="参数数" width="80" align="center">
                        <template slot-scope="scope">{{ (scope.row.parameters || []).length }}</template>
                    </el-table-column>
                    <el-table-column prop="description" label="描述" min-width="220" show-overflow-tooltip class-name="mcp-tool-desc"></el-table-column>
                </el-table>
            </div>
            <div v-else style="color:#f56c6c;">未获取到工具列表。请检查端点地址、协议类型与鉴权信息后重试。</div>
        </div>
        <div slot="footer" class="dialog-footer">
            <el-button type="primary" @@click="testDialogVisible = false">关闭</el-button>
        </div>
    </el-dialog>

    <!-- 输入 Schema 放大查看 -->
    <el-dialog :title="schemaTitle" :visible.sync="schemaDialogVisible" width="720px" append-to-body>
        <pre class="mcp-schema-pre" style="max-height:60vh;">{{ schemaText }}</pre>
        <div slot="footer" class="dialog-footer">
            <el-button type="primary" @@click="schemaDialogVisible = false">关闭</el-button>
        </div>
    </el-dialog>
</div>

@section scripts {
    <script src="~/js/MCP/index.js" asp-append-version="true"></script>
}
