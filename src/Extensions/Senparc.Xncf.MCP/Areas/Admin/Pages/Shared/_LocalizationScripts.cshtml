@using System.Text.Json
@using Senparc.Ncf.Core.Localization
@using Senparc.Xncf.MCP
@inject Microsoft.Extensions.Localization.IStringLocalizerFactory LocalizationFactory
@{
    var sourceTranslations = FrontendTranslationCatalog.Get(
        LocalizationFactory,
        typeof(McpResource));
}
<script>
    window.ncfRegisterSourceTranslations(@Html.Raw(JsonSerializer.Serialize(sourceTranslations)), "MCP");
</script>
