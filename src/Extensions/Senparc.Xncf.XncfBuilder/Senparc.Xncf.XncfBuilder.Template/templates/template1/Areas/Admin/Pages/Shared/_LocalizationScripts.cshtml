@using System.Text.Json
@using Senparc.Ncf.Core.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizerFactory LocalizationFactory
@{
    var sourceTranslations = FrontendTranslationCatalog.Get(
        LocalizationFactory,
        typeof(Template_XncfNameResource));
}
<script>window.ncfRegisterSourceTranslations(@Html.Raw(JsonSerializer.Serialize(sourceTranslations)));</script>
