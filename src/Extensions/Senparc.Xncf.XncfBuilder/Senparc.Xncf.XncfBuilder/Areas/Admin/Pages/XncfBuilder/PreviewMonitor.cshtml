@page
@model Senparc.Xncf.XncfBuilder.Areas.XncfBuilder.Pages.PreviewMonitor
@{
    ViewData["Title"] = XncfBuilderResource.Get("XncfBuilder.Preview.Monitor", "XNCF 预览监控");
    Layout = "_Layout_Vue";
    var stateUrl = Url.Page("./PreviewMonitor", "State", new { uid = Model.Uid });
    var outputUrl = Url.Page("./PreviewMonitor", "SessionOutput", new { uid = Model.Uid });
    var stopUrl = Url.Page("./PreviewMonitor", "Stop", new { uid = Model.Uid });
    var applyDevelopmentUrl = Url.Page("./PreviewMonitor", "ApplyDevelopment", new { uid = Model.Uid });
    var discardDevelopmentUrl = Url.Page("./PreviewMonitor", "DiscardDevelopment", new { uid = Model.Uid });
}

@section breadcrumbs {
    <el-breadcrumb-item>扩展模块</el-breadcrumb-item>
    <el-breadcrumb-item>XncfBuilder</el-breadcrumb-item>
    <el-breadcrumb-item>预览监控</el-breadcrumb-item>
}

<div>
    @Html.AntiForgeryToken()
    <el-container>
        <el-header class="module-header">
            <span class="start-title">
                <i class="fa fa-dashboard"></i>&nbsp;
                <span class="module-header-v">XNCF 预览监控</span>
            </span>
        </el-header>

        <el-main>
            <el-alert
                v-if="persistenceStatus && !persistenceStatus.isAvailable"
                style="margin-bottom:16px;"
                title="预览状态数据库持久化尚未就绪"
                type="warning"
                show-icon
                :closable="false"
                :description="persistenceStatus.statusMessage + (persistenceStatus.errorMessage ? ' 原因：' + persistenceStatus.errorMessage : '')">
            </el-alert>

            <el-alert
                v-if="developmentStatus && !developmentStatus.isAvailable"
                style="margin-top:12px;"
                title="隔离开发任务数据库持久化尚未就绪"
                type="warning"
                show-icon
                :closable="false"
                :description="developmentStatus.statusMessage + (developmentStatus.errorMessage ? ' 原因：' + developmentStatus.errorMessage : '')">
            </el-alert>

            <el-alert
                title="隔离预览流水线"
                type="info"
                show-icon
                :closable="false"
                description="每个任务依次执行宿主引用校验、隔离构建、启动新预览、健康检查和原子替换。新预览通过检查前，当前可用的旧预览不会停止。">
            </el-alert>

            <el-row :gutter="16" style="margin: 18px 0;">
                <el-col :xs="12" :sm="6">
                    <el-card shadow="never">
                        <div style="color:#909399;font-size:13px;">运行中</div>
                        <div style="font-size:28px;color:#67c23a;">{{ runningCount }}</div>
                    </el-card>
                </el-col>
                <el-col :xs="12" :sm="6">
                    <el-card shadow="never">
                        <div style="color:#909399;font-size:13px;">处理中 / 排队</div>
                        <div style="font-size:28px;color:#e6a23c;">{{ workingCount }}</div>
                    </el-card>
                </el-col>
                <el-col :xs="12" :sm="6">
                    <el-card shadow="never">
                        <div style="color:#909399;font-size:13px;">失败 / 中断</div>
                        <div style="font-size:28px;color:#f56c6c;">{{ failedCount }}</div>
                    </el-card>
                </el-col>
                <el-col :xs="12" :sm="6">
                    <el-card shadow="never">
                        <div style="color:#909399;font-size:13px;">会话总数</div>
                        <div style="font-size:28px;color:#409eff;">{{ sessions.length }}</div>
                    </el-card>
                </el-col>
            </el-row>

            <div class="filter-container">
                <el-button type="primary" size="small" icon="el-icon-refresh" :loading="loading" @@click="loadState(true)">
                    刷新状态
                </el-button>
                <el-tag type="info" size="small">自动刷新：2 秒</el-tag>
                <span style="margin-left:10px;color:#909399;font-size:12px;">最近更新：{{ formatDate(updatedAt) }}</span>
            </div>

            <el-card shadow="never">
                <div slot="header" class="clearfix">
                    <span><i class="fa fa-tasks"></i>&nbsp;模块预览会话</span>
                </div>

                <el-table
                    :data="sessions"
                    row-key="sessionId"
                    border
                    stripe
                    empty-text="当前没有预览会话"
                    @@expand-change="handleExpandChange">
                    <el-table-column type="expand">
                        <template slot-scope="scope">
                            <el-steps
                                :active="pipelineActive(scope.row)"
                                finish-status="success"
                                :process-status="pipelineProcessStatus(scope.row)"
                                align-center
                                style="margin:8px 0 20px;">
                                <el-step
                                    v-for="stage in pipelineStages"
                                    :key="stage.value"
                                    :title="stage.label">
                                </el-step>
                            </el-steps>
                            <el-card shadow="never">
                                <el-row :gutter="16">
                                    <el-col :xs="24" :sm="12">
                                        <strong>会话 ID：</strong><span style="word-break:break-all;">{{ scope.row.sessionId }}</span>
                                    </el-col>
                                    <el-col :xs="24" :sm="12">
                                        <strong>环境：</strong>{{ scope.row.environmentName || '—' }}
                                    </el-col>
                                    <el-col :xs="24" :sm="12" style="margin-top:8px;">
                                        <strong>Host 启动 / 健康：</strong>{{ formatDate(scope.row.processStartedAt) }} / {{ formatDate(scope.row.healthyAt) }}
                                    </el-col>
                                    <el-col :xs="24" :sm="12" style="margin-top:8px;">
                                        <strong>Host 停止 / ExitCode：</strong>{{ formatDate(scope.row.stoppedAt) }} / {{ scope.row.exitCode === null || scope.row.exitCode === undefined ? '—' : scope.row.exitCode }}
                                    </el-col>
                                    <el-col :xs="24" :sm="12" style="margin-top:8px;">
                                        <strong>源码 SHA-256：</strong><span style="word-break:break-all;">{{ scope.row.sourceFingerprint || '尚未计算' }}</span>
                                    </el-col>
                                    <el-col :xs="24" :sm="12" style="margin-top:8px;">
                                        <strong>模块 DLL SHA-256：</strong><span style="word-break:break-all;">{{ scope.row.moduleAssemblySha256 || '尚未生成' }}</span>
                                    </el-col>
                                    <el-col :xs="24" style="margin-top:8px;">
                                        <strong>本次构建源码解决方案：</strong><span style="word-break:break-all;">{{ scope.row.solutionFilePath || '—' }}</span>
                                    </el-col>
                                    <el-col :xs="24" style="margin-top:8px;">
                                        <strong>预览部署（publish）目录：</strong><span style="word-break:break-all;">{{ scope.row.publishDirectory || '尚未创建或已回收' }}</span>
                                    </el-col>
                                </el-row>
                            </el-card>
                            <div style="margin-top:12px;font-weight:600;">最近输出（最多 300 行）</div>
                            <pre style="max-height:360px;overflow:auto;background:#1f2933;color:#e5e7eb;padding:12px;border-radius:4px;white-space:pre-wrap;word-break:break-word;" v-text="sessionOutput(scope.row)"></pre>
                        </template>
                    </el-table-column>

                    <el-table-column prop="moduleProjectName" label="模块" min-width="230"></el-table-column>
                    <el-table-column label="当前阶段" min-width="150">
                        <template slot-scope="scope">
                            <el-tag :type="tagType(scope.row)" size="small">{{ stageLabel(scope.row.stage) }}</el-tag>
                        </template>
                    </el-table-column>
                    <el-table-column label="流水线进度" min-width="250">
                        <template slot-scope="scope">
                            <el-progress
                                :percentage="scope.row.progressPercent"
                                :status="progressStatus(scope.row)"
                                :stroke-width="12">
                            </el-progress>
                            <div style="color:#606266;font-size:12px;line-height:18px;">{{ scope.row.statusMessage }}</div>
                            <div v-if="scope.row.errorMessage" style="color:#f56c6c;font-size:12px;line-height:18px;">{{ scope.row.errorMessage }}</div>
                        </template>
                    </el-table-column>
                    <el-table-column label="进程" width="100">
                        <template slot-scope="scope">{{ scope.row.processId > 0 ? scope.row.processId : '—' }}</template>
                    </el-table-column>
                    <el-table-column label="Host" min-width="135">
                        <template slot-scope="scope">
                            <el-tag :type="hostTagType(scope.row.hostStatus)" size="small">{{ hostStatusLabel(scope.row.hostStatus) }}</el-tag>
                        </template>
                    </el-table-column>
                    <el-table-column label="开始 / 更新" min-width="185">
                        <template slot-scope="scope">
                            <div>{{ formatDate(scope.row.startedAt) }}</div>
                            <div style="color:#909399;font-size:12px;">{{ formatDate(scope.row.updatedAt) }}</div>
                        </template>
                    </el-table-column>
                    <el-table-column label="操作" width="155" fixed="right">
                        <template slot-scope="scope">
                            <el-button
                                v-if="scope.row.url && scope.row.isRunning"
                                type="primary"
                                size="mini"
                                icon="el-icon-position"
                                @@click="openPreview(scope.row.url)">
                                打开
                            </el-button>
                            <el-button
                                v-if="scope.row.canStop"
                                type="danger"
                                size="mini"
                                icon="el-icon-switch-button"
                                @@click="stopSession(scope.row)">
                                停止
                            </el-button>
                        </template>
                    </el-table-column>
                </el-table>
            </el-card>

            <el-card shadow="never" style="margin-top:16px;">
                <div slot="header" class="clearfix">
                    <span><i class="fa fa-code"></i>&nbsp;隔离开发 / Sandbox 预览任务</span>
                    <span style="margin-left:8px;color:#909399;font-size:12px;">AI 只能写隔离工作区；合入必须由管理员输入确认短语。</span>
                </div>
                <el-table :data="developmentJobs" row-key="jobId" border stripe empty-text="当前没有隔离开发任务">
                    <el-table-column prop="moduleProjectName" label="模块" min-width="220"></el-table-column>
                    <el-table-column label="模式 / 阶段" min-width="175">
                        <template slot-scope="scope">
                            <div>{{ developmentModeLabel(scope.row.mode) }}</div>
                            <el-tag :type="developmentTagType(scope.row.stage)" size="small">{{ developmentStageLabel(scope.row.stage) }}</el-tag>
                        </template>
                    </el-table-column>
                    <el-table-column label="状态与差异" min-width="300">
                        <template slot-scope="scope">
                            <div>{{ scope.row.statusMessage || '—' }}</div>
                            <div style="color:#909399;font-size:12px;line-height:18px;">{{ scope.row.diffSummary || '尚未生成差异摘要' }}</div>
                            <div v-if="scope.row.errorMessage" style="color:#f56c6c;font-size:12px;line-height:18px;">{{ scope.row.errorMessage }}</div>
                        </template>
                    </el-table-column>
                    <el-table-column label="路径 / Sandbox" min-width="330">
                        <template slot-scope="scope">
                            <div style="word-break:break-all;">目标：{{ scope.row.targetSolutionFilePath || '—' }}</div>
                            <div style="word-break:break-all;color:#909399;font-size:12px;">隔离：{{ scope.row.workspaceSolutionFilePath || '—' }}</div>
                            <div v-if="scope.row.sandboxSessionId" style="font-size:12px;">Sandbox：{{ scope.row.sandboxSessionId }}</div>
                            <el-link v-if="scope.row.previewUrl" :href="scope.row.previewUrl" target="_blank" type="primary">打开 Sandbox 预览</el-link>
                        </template>
                    </el-table-column>
                    <el-table-column label="操作" width="180" fixed="right">
                        <template slot-scope="scope">
                            <el-button v-if="isAwaitingApproval(scope.row)" type="success" size="mini" @@click="applyDevelopment(scope.row)">人工合入</el-button>
                            <el-button v-if="!scope.row.isTerminal" type="danger" size="mini" @@click="discardDevelopment(scope.row)">丢弃</el-button>
                        </template>
                    </el-table-column>
                </el-table>
            </el-card>

            <el-alert
                style="margin-top:16px;"
                title="源码生成或修改完成后，调用“启动 XNCF 隔离预览”才会进入此监控队列；源码指纹用于证明本次构建对应的确切源码快照。"
                type="warning"
                show-icon
                :closable="false">
            </el-alert>
        </el-main>
    </el-container>
</div>

@section scripts {
    @await Html.PartialAsync("_LocalizationScripts")
    <script>
        new Vue({
            el: "#app",
            data: function () {
                return {
                    sessions: [],
                    stageDefinitions: [],
                    pipelineStages: [],
                    stageMap: {},
                    hostStatusMap: {},
                    persistenceStatus: null,
                    developmentJobs: [],
                    developmentStatus: null,
                    outputBySession: {},
                    expandedSessionIds: [],
                    updatedAt: null,
                    loading: false,
                    refreshTimer: null,
                    stateRequestInFlight: false,
                    stateRequestSource: null,
                    outputRequestSources: {},
                    pagePaused: false,
                    pageDisposed: false,
                    pageHideHandler: null,
                    pageShowHandler: null,
                    visibilityHandler: null,
                    stateUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(stateUrl)),
                    outputUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(outputUrl)),
                    stopUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(stopUrl)),
                    applyDevelopmentUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(applyDevelopmentUrl)),
                    discardDevelopmentUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(discardDevelopmentUrl))
                };
            },
            computed: {
                runningCount: function () {
                    return this.sessions.filter(row => this.stageName(row.stage) === "Running").length;
                },
                workingCount: function () {
                    return this.sessions.filter(row => !row.isTerminal && this.stageName(row.stage) !== "Running").length;
                },
                failedCount: function () {
                    return this.sessions.filter(row => {
                        const name = this.stageName(row.stage);
                        return name === "Failed" || name === "Interrupted";
                    }).length;
                }
            },
            mounted: function () {
                // pagehide/pageshow 同时兼容普通离页和浏览器 bfcache：离页暂停，返回后恢复。
                this.pageHideHandler = () => this.pauseMonitor();
                this.pageShowHandler = () => this.resumeMonitor();
                this.visibilityHandler = () => {
                    if (document.hidden) {
                        this.pauseMonitor();
                    } else {
                        this.resumeMonitor();
                    }
                };
                window.addEventListener("pagehide", this.pageHideHandler);
                window.addEventListener("pageshow", this.pageShowHandler);
                document.addEventListener("visibilitychange", this.visibilityHandler);
                this.loadState(false);
            },
            beforeDestroy: function () {
                this.disposeMonitor();
            },
            methods: {
                scheduleNextRefresh: function (delay) {
                    // 上一次请求结束后才安排下一次，保证状态轮询始终是单飞请求。
                    if (this.pageDisposed || this.pagePaused) return;
                    if (this.refreshTimer) window.clearTimeout(this.refreshTimer);
                    this.refreshTimer = window.setTimeout(() => this.loadState(false), delay);
                },
                pauseMonitor: function () {
                    // 及时释放浏览器同源连接，防止挂起请求阻塞其他 Admin 页面。
                    this.pagePaused = true;
                    if (this.refreshTimer) {
                        window.clearTimeout(this.refreshTimer);
                        this.refreshTimer = null;
                    }
                    if (this.stateRequestSource) this.stateRequestSource.cancel("page paused");
                    Object.keys(this.outputRequestSources).forEach(id => {
                        const source = this.outputRequestSources[id];
                        if (source) source.cancel("page paused");
                    });
                    this.outputRequestSources = {};
                },
                resumeMonitor: function () {
                    if (this.pageDisposed || document.hidden) return;
                    this.pagePaused = false;
                    this.scheduleNextRefresh(0);
                },
                disposeMonitor: function () {
                    if (this.pageDisposed) return;
                    this.pauseMonitor();
                    this.pageDisposed = true;
                    if (this.pageHideHandler) window.removeEventListener("pagehide", this.pageHideHandler);
                    if (this.pageShowHandler) window.removeEventListener("pageshow", this.pageShowHandler);
                    if (this.visibilityHandler) document.removeEventListener("visibilitychange", this.visibilityHandler);
                },
                loadState: async function (showLoading) {
                    // 超时和 in-flight 标记双重限制，即使服务端异常也不会无限堆积请求。
                    if (this.pageDisposed || this.pagePaused || this.stateRequestInFlight) return;
                    if (document.hidden && !showLoading) {
                        this.scheduleNextRefresh(2000);
                        return;
                    }

                    if (this.refreshTimer) window.clearTimeout(this.refreshTimer);
                    this.stateRequestInFlight = true;
                    this.stateRequestSource = axios.CancelToken.source();
                    if (showLoading) {
                        this.loading = true;
                    }
                    try {
                        const response = await axios.get(this.stateUrl, {
                            headers: { "Cache-Control": "no-cache" },
                            timeout: 10000,
                            cancelToken: this.stateRequestSource.token
                        });
                        this.sessions = response.data.sessions || [];
                        this.stageDefinitions = response.data.stageDefinitions || [];
                        this.hostStatusMap = (response.data.hostStatusDefinitions || []).reduce((map, item) => {
                            map[item.value] = item;
                            return map;
                        }, {});
                        this.pipelineStages = response.data.pipelineStages || [];
                        this.persistenceStatus = response.data.persistenceStatus || null;
                        this.developmentJobs = response.data.developmentJobs || [];
                        this.developmentStatus = response.data.developmentStatus || null;
                        this.stageMap = this.stageDefinitions.reduce((map, item) => {
                            map[item.value] = item;
                            return map;
                        }, {});
                        this.updatedAt = response.data.serverTime;
                        await Promise.all(this.expandedSessionIds.map(id => this.loadOutput(id)));
                    } catch (error) {
                        if (showLoading && !axios.isCancel(error)) {
                            this.$message.error(this.errorMessage(error, "状态读取失败。"));
                        }
                    } finally {
                        this.stateRequestSource = null;
                        this.stateRequestInFlight = false;
                        this.loading = false;
                        this.scheduleNextRefresh(2000);
                    }
                },
                loadOutput: async function (sessionId) {
                    // 每个展开的会话最多保留一个日志请求。
                    if (this.pageDisposed || this.pagePaused || this.outputRequestSources[sessionId]) return;
                    const requestSource = axios.CancelToken.source();
                    this.$set(this.outputRequestSources, sessionId, requestSource);
                    try {
                        const separator = this.outputUrl.indexOf("?") >= 0 ? "&" : "?";
                        const response = await axios.get(
                            this.outputUrl + separator + "sessionId=" + encodeURIComponent(sessionId),
                            { timeout: 10000, cancelToken: requestSource.token });
                        this.$set(this.outputBySession, sessionId, response.data.recentOutput || "暂无输出。");
                    } catch (error) {
                        if (!axios.isCancel(error)) {
                            this.$set(this.outputBySession, sessionId, this.errorMessage(error, "日志读取失败。"));
                        }
                    } finally {
                        if (this.outputRequestSources[sessionId] === requestSource) {
                            this.$delete(this.outputRequestSources, sessionId);
                        }
                    }
                },
                handleExpandChange: function (row, expandedRows) {
                    this.expandedSessionIds = expandedRows.map(item => item.sessionId);
                    if (this.expandedSessionIds.indexOf(row.sessionId) >= 0) {
                        this.loadOutput(row.sessionId);
                    }
                },
                stopSession: async function (row) {
                    try {
                        await this.$confirm("确定停止 " + row.moduleProjectName + " 的此预览任务吗？", "停止预览", {
                            confirmButtonText: "停止",
                            cancelButtonText: "取消",
                            type: "warning"
                        });
                        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                        const separator = this.stopUrl.indexOf("?") >= 0 ? "&" : "?";
                        const response = await axios.post(
                            this.stopUrl + separator + "sessionId=" + encodeURIComponent(row.sessionId),
                            null,
                            { headers: { "RequestVerificationToken": token } });
                        this.$message({
                            type: response.data.success ? "success" : "warning",
                            message: response.data.message
                        });
                        await this.loadState(false);
                    } catch (error) {
                        if (error !== "cancel" && error !== "close") {
                            this.$message.error(this.errorMessage(error, "停止预览失败。"));
                        }
                    }
                },
                applyDevelopment: async function (row) {
                    const expected = "APPLY " + row.moduleProjectName;
                    try {
                        const prompt = await this.$prompt(
                            "请先确认隔离工作区、差异和 Sandbox 预览。输入 " + expected + " 才会将受控差异写入目标源码。",
                            "人工合入 XNCF 模块",
                            {
                                confirmButtonText: "合入",
                                cancelButtonText: "取消",
                                inputErrorMessage: "确认短语必须完全匹配：" + expected
                            });
                        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                        const separator = this.applyDevelopmentUrl.indexOf("?") >= 0 ? "&" : "?";
                        const response = await axios.post(
                            this.applyDevelopmentUrl + separator + "jobId=" + encodeURIComponent(row.jobId)
                            + "&confirmationPhrase=" + encodeURIComponent(prompt.value),
                            null,
                            { headers: { "RequestVerificationToken": token } });
                        this.$message.success(response.data.message);
                        await this.loadState(false);
                    } catch (error) {
                        if (error !== "cancel" && error !== "close") {
                            this.$message.error(this.errorMessage(error, "合入失败。"));
                        }
                    }
                },
                discardDevelopment: async function (row) {
                    try {
                        await this.$confirm(
                            "将停止对应 Sandbox 预览并删除隔离工作区，目标源码不会改变。确定丢弃 " + row.moduleProjectName + " 吗？",
                            "丢弃隔离开发任务",
                            { confirmButtonText: "丢弃", cancelButtonText: "取消", type: "warning" });
                        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                        const separator = this.discardDevelopmentUrl.indexOf("?") >= 0 ? "&" : "?";
                        const response = await axios.post(
                            this.discardDevelopmentUrl + separator + "jobId=" + encodeURIComponent(row.jobId),
                            null,
                            { headers: { "RequestVerificationToken": token } });
                        this.$message.success(response.data.message);
                        await this.loadState(false);
                    } catch (error) {
                        if (error !== "cancel" && error !== "close") {
                            this.$message.error(this.errorMessage(error, "丢弃失败。"));
                        }
                    }
                },
                developmentModeLabel: function (mode) {
                    return mode === 0 ? "新建模块" : "修改现有模块";
                },
                developmentStageLabel: function (stage) {
                    return ["快照中", "可编写", "校验中", "Sandbox 预览中", "待审阅", "等待人工合入", "已合入", "已丢弃", "失败"][stage] || "未知";
                },
                developmentTagType: function (stage) {
                    if (stage === 6) return "success";
                    if (stage === 8) return "danger";
                    if (stage === 7) return "info";
                    return stage === 5 ? "warning" : "primary";
                },
                isAwaitingApproval: function (row) {
                    return row.stage === 5;
                },
                stageName: function (stage) {
                    return this.stageMap[stage] ? this.stageMap[stage].name : "Unknown";
                },
                stageLabel: function (stage) {
                    return this.stageMap[stage] ? this.stageMap[stage].label : "未知";
                },
                hostStatusLabel: function (status) {
                    return this.hostStatusMap[status] ? this.hostStatusMap[status].label : "未创建";
                },
                hostTagType: function (status) {
                    const name = this.hostStatusMap[status] ? this.hostStatusMap[status].name : "NotCreated";
                    if (name === "Healthy") return "success";
                    if (name === "Failed" || name === "Interrupted") return "danger";
                    if (name === "Stopped" || name === "Replaced" || name === "NotCreated") return "info";
                    return "warning";
                },
                tagType: function (row) {
                    const name = this.stageName(row.stage);
                    if (name === "Running") return "success";
                    if (name === "Failed" || name === "Interrupted") return "danger";
                    if (name === "Cancelled" || name === "Stopped" || name === "Replaced") return "info";
                    return "warning";
                },
                progressStatus: function (row) {
                    const name = this.stageName(row.stage);
                    if (name === "Failed" || name === "Interrupted") return "exception";
                    if (name === "Running") return "success";
                    if (row.isTerminal) return "warning";
                    return undefined;
                },
                pipelineActive: function (row) {
                    const name = this.stageName(row.stage);
                    if (name === "Running" || name === "Stopped" || name === "Replaced") {
                        return this.pipelineStages.length;
                    }
                    const completedOrCurrent = this.pipelineStages
                        .filter(stage => stage.progressPercent <= row.progressPercent)
                        .length;
                    return Math.max(0, completedOrCurrent - 1);
                },
                pipelineProcessStatus: function (row) {
                    const name = this.stageName(row.stage);
                    return name === "Failed" || name === "Interrupted" ? "error" : "process";
                },
                sessionOutput: function (row) {
                    return this.outputBySession[row.sessionId] || "正在读取最近输出…";
                },
                openPreview: function (url) {
                    window.open(url, "_blank", "noopener,noreferrer");
                },
                formatDate: function (value) {
                    return value ? new Date(value).toLocaleString() : "—";
                },
                errorMessage: function (error, fallback) {
                    return error && error.response && error.response.data && error.response.data.message
                        ? error.response.data.message
                        : fallback;
                }
            }
        });
    </script>
}
