@page
@using System.Globalization
@using Microsoft.Extensions.Localization
@model Senparc.Xncf.DesktopBridge.Areas.DesktopBridge.Pages.AuthHandoff
@inject IStringLocalizer<Senparc.Xncf.DesktopBridge.DesktopBridgeResource> XR
@{
    Layout = null;
    var currentCulture = CultureInfo.CurrentUICulture.Name;
}
<!doctype html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@XR["AuthHandoff.Title"]</title>
    <style>
        body { margin: 0; min-height: 100vh; display: grid; place-items: center; font-family: sans-serif; background: #f5f7fa; color: #303133; }
        main { max-width: 34rem; padding: 2rem; text-align: center; background: white; border: 1px solid #ebeef5; border-radius: 8px; }
        button { padding: .65rem 1rem; border: 0; border-radius: 4px; background: #409eff; color: white; cursor: pointer; }
        .error { color: #c45656; }
    </style>
</head>
<body>
<main>
    @if (Model.CanSubmit)
    {
        <h1>@XR["AuthHandoff.ConfirmTitle"]</h1>
        <p>@XR["AuthHandoff.ConfirmDescription"]</p>
        <p>@XR["AuthHandoff.GuiOnly"]</p>
        <form method="post" id="handoff-form">
            <input type="hidden" asp-for="RequestId" />
            <input type="hidden" asp-for="ReturnUrl" />
            <button type="submit">@XR["AuthHandoff.Authorize"]</button>
        </form>
    }
    else
    {
        <h1>@XR["AuthHandoff.FailedTitle"]</h1>
        <p class="error">@Model.ErrorMessage</p>
    }
</main>
</body>
</html>
