@page
@using System.Text.Json
@model Senparc.Xncf.DesktopBridge.Areas.DesktopBridge.Pages.Index
@{
    ViewData["Title"] = XR["Page.Title"];
    Layout = "_Layout_Vue";
    var jsonOptions = new JsonSerializerOptions(JsonSerializerDefaults.Web);
    var pendingPairingsJson = JsonSerializer.Serialize(Model.PendingPairings, jsonOptions);
    var sessionsJson = JsonSerializer.Serialize(Model.Sessions, jsonOptions);
    var notUsedJson = JsonSerializer.Serialize(XR["Page.NotUsed"].Value, jsonOptions);
}

@section breadcrumbs {
    <el-breadcrumb-item>@XR["Page.Extensions"]</el-breadcrumb-item>
    <el-breadcrumb-item>DesktopBridge</el-breadcrumb-item>
    <el-breadcrumb-item>@XR["Page.Devices"]</el-breadcrumb-item>
}

<div>
    <el-container>
        <el-header class="module-header">
            <span class="start-title">
                <i class="fa fa-desktop"></i>&nbsp;
                <span class="module-header-v">@XR["Page.Devices"]</span>
            </span>
        </el-header>

        <el-main>
            <el-alert
                title="@XR["Page.PairingInfo.Title"]"
                type="info"
                show-icon
                :closable="false"
                description="@XR["Page.PairingInfo.Description"]">
            </el-alert>

            @if (TempData["DesktopBridgeMessage"] is string message)
            {
                <el-alert
                    title="@message"
                    type="success"
                    show-icon
                    :closable="false">
                </el-alert>
            }

            <div class="filter-container">
                <el-button type="primary" size="small" icon="el-icon-refresh" @@click="refreshPage">
                    @XR["Page.Refresh"]
                </el-button>
                <el-tag type="warning" size="small">@XR["Page.PendingCount", Model.PendingPairings.Count]</el-tag>
                <el-tag type="success" size="small">@XR["Page.ActiveCount", Model.Sessions.Count]</el-tag>
            </div>

            <el-card shadow="never">
                <div slot="header" class="clearfix">
                    <span><i class="fa fa-key"></i>&nbsp;@XR["Page.PendingRequests"]</span>
                </div>

                <el-table :data="pendingPairings" border stripe empty-text="@XR["Page.EmptyPending"]">
                    <el-table-column label="@XR["Page.PairingCode"]" min-width="170">
                        <template slot-scope="scope">
                            <el-tag type="warning" effect="plain">{{ scope.row.deviceCode }}</el-tag>
                        </template>
                    </el-table-column>
                    <el-table-column prop="clientName" label="@XR["Page.DesktopClient"]" min-width="190"></el-table-column>
                    <el-table-column prop="remoteAddress" label="@XR["Page.SourceAddress"]" min-width="150"></el-table-column>
                    <el-table-column label="@XR["Page.RequestedAt"]" min-width="170">
                        <template slot-scope="scope">{{ formatDate(scope.row.createdAt) }}</template>
                    </el-table-column>
                    <el-table-column label="@XR["Page.ExpiresAt"]" min-width="170">
                        <template slot-scope="scope">{{ formatDate(scope.row.expiresAt) }}</template>
                    </el-table-column>
                    <el-table-column label="@XR["Page.Actions"]" width="170" fixed="right">
                        <template slot-scope="scope">
                            <form class="d-inline-block" method="post" asp-page-handler="Approve">
                                <input type="hidden" name="Uid" value="@Model.Uid" />
                                <input type="hidden" name="requestId" :value="scope.row.requestId" />
                                <button type="submit" class="el-button el-button--primary el-button--mini">
                                    <i class="el-icon-check"></i><span>@XR["Page.Approve"]</span>
                                </button>
                            </form>
                            <form class="d-inline-block" method="post" asp-page-handler="Deny">
                                <input type="hidden" name="Uid" value="@Model.Uid" />
                                <input type="hidden" name="requestId" :value="scope.row.requestId" />
                                <button type="submit" class="el-button el-button--danger el-button--mini">
                                    <i class="el-icon-close"></i><span>@XR["Page.Deny"]</span>
                                </button>
                            </form>
                        </template>
                    </el-table-column>
                </el-table>
            </el-card>

            <el-divider></el-divider>

            <el-card shadow="never">
                <div slot="header" class="clearfix">
                    <span><i class="fa fa-link"></i>&nbsp;@XR["Page.ActiveSessions"]</span>
                </div>

                <el-table :data="sessions" border stripe empty-text="@XR["Page.EmptySessions"]">
                    <el-table-column prop="clientName" label="@XR["Page.DesktopClient"]" min-width="190"></el-table-column>
                    <el-table-column prop="remoteAddress" label="@XR["Page.SourceAddress"]" min-width="150"></el-table-column>
                    <el-table-column prop="approvedBy" label="@XR["Page.ApprovedBy"]" min-width="130"></el-table-column>
                    <el-table-column label="@XR["Page.ApprovedAt"]" min-width="170">
                        <template slot-scope="scope">{{ formatDate(scope.row.approvedAt) }}</template>
                    </el-table-column>
                    <el-table-column label="@XR["Page.LastUsed"]" min-width="170">
                        <template slot-scope="scope">{{ scope.row.lastUsedAt ? formatDate(scope.row.lastUsedAt) : @Html.Raw(notUsedJson) }}</template>
                    </el-table-column>
                    <el-table-column label="@XR["Page.ExpiresAt"]" min-width="170">
                        <template slot-scope="scope">{{ formatDate(scope.row.expiresAt) }}</template>
                    </el-table-column>
                    <el-table-column label="@XR["Page.Status"]" width="90">
                        <template slot-scope="scope"><el-tag type="success" size="small">@XR["Page.Authorized"]</el-tag></template>
                    </el-table-column>
                    <el-table-column label="@XR["Page.Actions"]" width="100" fixed="right">
                        <template slot-scope="scope">
                            <form method="post" asp-page-handler="Revoke">
                                <input type="hidden" name="Uid" value="@Model.Uid" />
                                <input type="hidden" name="sessionId" :value="scope.row.sessionId" />
                                <button type="submit" class="el-button el-button--danger el-button--mini">
                                    <i class="el-icon-switch-button"></i><span>@XR["Page.Revoke"]</span>
                                </button>
                            </form>
                        </template>
                    </el-table-column>
                </el-table>
            </el-card>

            <el-alert
                title="@XR["Page.LegacyTokenNotice"]"
                type="warning"
                show-icon
                :closable="false">
            </el-alert>
        </el-main>
    </el-container>
</div>

@section scripts {
    <script>
        new Vue({
            el: "#app",
            data: function () {
                return {
                    pendingPairings: @Html.Raw(pendingPairingsJson),
                    sessions: @Html.Raw(sessionsJson)
                };
            },
            methods: {
                formatDate: function (value) {
                    return value ? new Date(value).toLocaleString() : "—";
                },
                refreshPage: function () {
                    window.location.reload();
                }
            }
        });
    </script>
}
