@using System.Text.Json
@using Senparc.Ncf.Core.Localization
@using Senparc.Xncf.DesktopBridge
@inject Microsoft.Extensions.Localization.IStringLocalizerFactory LocalizationFactory
@{
    var sourceTranslations = FrontendTranslationCatalog.Get(
        LocalizationFactory,
        typeof(DesktopBridgeResource));
}
<script>
    window.ncfRegisterSourceTranslations(@Html.Raw(JsonSerializer.Serialize(sourceTranslations)), "DesktopBridge");
</script>
