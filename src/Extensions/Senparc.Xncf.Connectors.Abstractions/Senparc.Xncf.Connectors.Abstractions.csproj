<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.1.1.2</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Senparc.Xncf.Connectors.Abstractions</AssemblyName>
    <RootNamespace>Senparc.Xncf.Connectors.Abstractions</RootNamespace>
    <GeneratePackageOnBuild Condition=" '$(Configuration)' == 'Release' ">true</GeneratePackageOnBuild>
    <GeneratePackageOnBuild Condition="'$(Configuration)'=='TemplateRelease'">true</GeneratePackageOnBuild>
    <Description>Module description.</Description>
    <Copyright>Senparc</Copyright>
    <PackageTags>Senparc,NeuCharFramework,NCF,Senparc.Xncf.Connectors,Abstractions</PackageTags>
    <Authors>Senparc</Authors>
    <Owners>Senparc</Owners>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Title>NCF Connectors Abstractions</Title>
    <PackageIcon>icon.jpg</PackageIcon>
    <PackageReleaseNotes>[2026-11-11] v0.1.0 Updated module behavior and related support.
        1. Updated module behavior and related support.
        2. Updated module behavior and related support.
        [2026-11-19] v0.1.1 Updated module behavior, localization metadata, and English source comments
        1. Updated affected project files while preserving existing public integration behavior.
        2. Standardized related English source comments and package metadata for the current release.
        [2026-11-24] v0.1.1 Integrated localization, tooling, and runtime improvements across the module.
        1. Updated functional behavior and package metadata for the current module changes.
        2. Preserved existing public APIs and runtime integration while incorporating the related improvements.
        [2026-11-27] v0.1.1.2 Improve source documentation, headers, and module metadata consistency.
        1. Applied standardized copyright headers, XML documentation, and localization metadata across touched sources.
    </PackageReleaseNotes>
    <RepositoryUrl>https://github.com/NeuCharFramework/NcfPackageSources</RepositoryUrl>
    <Configurations>Debug;Release;Test;TemplateRelease</Configurations>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <OutputPath>..\..\BuildOutPut</OutputPath>
    <DefineConstants>$(DefineConstants);RELEASE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <ErrorReport>prompt</ErrorReport>
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='TemplateRelease'">
    <OutputPath>..\..\BuildOutPut</OutputPath>
    <DefineConstants>$(DefineConstants);RELEASE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <ErrorReport>prompt</ErrorReport>
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\icon.jpg" Pack="true" Visible="false" PackagePath="" />
  </ItemGroup>
</Project>
