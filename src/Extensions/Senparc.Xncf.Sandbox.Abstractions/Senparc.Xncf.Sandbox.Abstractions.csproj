<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.3.1</Version>
    <AssemblyName>Senparc.Xncf.Sandbox.Abstractions</AssemblyName>
    <RootNamespace>Senparc.Xncf.Sandbox.Abstractions</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild Condition=" '$(Configuration)' == 'Release' ">true</GeneratePackageOnBuild>
    <GeneratePackageOnBuild Condition="'$(Configuration)'=='TemplateRelease'">true</GeneratePackageOnBuild>
    <Description>Module description.</Description>
    <Copyright>Senparc</Copyright>
    <PackageTags>Senparc,NeuCharFramework,NCF</PackageTags>
    <Authors>Senparc</Authors>
    <Owners>Senparc</Owners>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Title>Sandbox Environment Abstractions</Title>
    <PackageIcon>icon.jpg</PackageIcon>
    <PackageReleaseNotes>
      [2026-08-13] v0.1.0-preview1 Updated module behavior and related support.
      1. Updated module behavior and related support.
      2. Updated module behavior and related support.
      [2026-08-15] v0.2.0 Updated module behavior and related support.
      1. Updated module behavior and related support.
      2. Updated module behavior and related support.
      3. Updated module behavior and related support.
      4. Updated module behavior and related support.
      5. Updated module behavior and related support.
      [2026-09-18] v0.3.0 Updated module behavior and related support.
      1. Updated module behavior and related support.
      [2026-10-05] v0.3.0 feat: enhance Sandbox with external JupyterLab control, port mappings, session alias and raised quota
      1. Updated Senparc.Xncf.Sandbox.Abstractions project behavior and integration for the latest feature and reliability improvements.
      [2026-11-03] v0.3.1 Updated module behavior and related support.
</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/NeuCharFramework/NcfPackageSources</RepositoryUrl>
    <Configurations>Debug;Release;Test;TemplateRelease</Configurations>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <OutputPath>..\..\BuildOutPut</OutputPath>
    <DefineConstants>$(DefineConstants);RELEASE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <ErrorReport>prompt</ErrorReport>
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='TemplateRelease'">
    <OutputPath>..\..\BuildOutPut</OutputPath>
    <DefineConstants>$(DefineConstants);RELEASE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <ErrorReport>prompt</ErrorReport>
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\icon.jpg" Pack="true" Visible="false" PackagePath="" />
  </ItemGroup>
</Project>
