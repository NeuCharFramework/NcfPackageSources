@page
@model Senparc.Xncf.SenMapic.Areas.Admin.Pages.SenMapic.Task.IndexModel
@{
    ViewData["Title"] = XR["Task.Management"];
}

<div class="admin-site">
    <div class="admin-site-header">
        <el-breadcrumb separator="/">
            <el-breadcrumb-item>@XR["Area.Home"]</el-breadcrumb-item>
            <el-breadcrumb-item>@XR["Task.Management"]</el-breadcrumb-item>
        </el-breadcrumb>
    </div>

    <div class="admin-site-content">
        <div class="admin-site-content-header">
            <el-button type="primary" size="small" @@click="handleAdd">@XR["Task.Create"]</el-button>
        </div>

        <div class="admin-site-content-body">
            <el-table :data="tableData" style="width: 100%" v-loading="loading">
                <el-table-column prop="name" label="@XR["Task.Name"]" width="180"></el-table-column>
                <el-table-column prop="startUrl" label="@XR["Task.StartUrl"]" width="280"></el-table-column>
                <el-table-column prop="maxThread" label="@XR["Task.MaxThreads"]" width="120"></el-table-column>
                <el-table-column prop="maxBuildMinutes" label="@XR["Task.MaxCrawlMinutes"]" width="160"></el-table-column>
                <el-table-column prop="maxDeep" label="@XR["Task.MaxDepth"]" width="120"></el-table-column>
                <el-table-column prop="maxPageCount" label="@XR["Task.MaxPages"]" width="120"></el-table-column>
                <el-table-column prop="status" label="@XR["Common.Status"]" width="120">
                    <template slot-scope="scope">
                        <el-tag :type="getStatusType(scope.row.status)">{{getStatusText(scope.row.status)}}</el-tag>
                    </template>
                </el-table-column>
                <el-table-column label="@XR["Common.Actions"]" width="200">
                    <template slot-scope="scope">
                        <el-button size="mini" type="primary" @@click="handleStart(scope.row)" 
                                 :disabled="scope.row.status !== 0">@XR["Common.Start"]</el-button>
                        <el-button size="mini" type="danger" @@click="handleDelete(scope.row)">@XR["Common.Delete"]</el-button>
                    </template>
                </el-table-column>
            </el-table>
        </div>
    </div>

    <!-- 新增/编辑对话框 -->
    <el-dialog :title="dialogTitle" :visible.sync="dialogVisible" width="50%">
        <el-form :model="form" :rules="rules" ref="form" label-width="120px">
            <el-form-item label="@XR["Task.Name"]" prop="name">
                <el-input v-model="form.name"></el-input>
            </el-form-item>
            <el-form-item label="@XR["Task.StartUrl"]" prop="startUrl">
                <el-input v-model="form.startUrl"></el-input>
            </el-form-item>
            <el-form-item label="@XR["Task.MaxThreads"]" prop="maxThread">
                <el-input-number v-model="form.maxThread" :min="1" :max="10"></el-input-number>
            </el-form-item>
            <el-form-item label="@XR["Task.MaxCrawlTime"]" prop="maxBuildMinutes">
                <el-input-number v-model="form.maxBuildMinutes" :min="1" :max="60"></el-input-number>
            </el-form-item>
            <el-form-item label="@XR["Task.MaxDepth"]" prop="maxDeep">
                <el-input-number v-model="form.maxDeep" :min="1" :max="10"></el-input-number>
            </el-form-item>
            <el-form-item label="@XR["Task.MaxPages"]" prop="maxPageCount">
                <el-input-number v-model="form.maxPageCount" :min="1" :max="1000"></el-input-number>
            </el-form-item>
            <el-form-item label="@XR["Task.RunImmediately"]">
                <el-switch v-model="form.startImmediately"></el-switch>
            </el-form-item>
        </el-form>
        <div slot="footer" class="dialog-footer">
            <el-button @@click="dialogVisible = false">@XR["Common.Cancel"]</el-button>
            <el-button type="primary" @@click="handleSubmit">@XR["Common.Confirm"]</el-button>
        </div>
    </el-dialog>
</div>

@section scripts{
    @await Html.PartialAsync("_LocalizationScripts")
    <script src="~/js/SenMapic/task.js"></script>
}
