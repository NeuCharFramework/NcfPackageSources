@page
@model Senparc.Xncf.SenMapic.Areas.Admin.Pages.SenMapic.Task.DetailModel
@{
    ViewData["Title"] = XR["Task.Detail"];
}

<div class="admin-site">
    <div class="admin-site-header">
        <el-breadcrumb separator="/">
            <el-breadcrumb-item>@XR["Area.Home"]</el-breadcrumb-item>
            <el-breadcrumb-item>@XR["Task.Management"]</el-breadcrumb-item>
            <el-breadcrumb-item>@XR["Task.Detail"]</el-breadcrumb-item>
        </el-breadcrumb>
    </div>

    <div class="admin-site-content">
        <div class="task-info">
            <el-descriptions title="@XR["Task.Information"]" :column="2" border>
                <el-descriptions-item label="@XR["Task.Name"]">{{ task.name }}</el-descriptions-item>
                <el-descriptions-item label="@XR["Common.Status"]">
                    <el-tag :type="getStatusType(task.status)">{{getStatusText(task.status)}}</el-tag>
                </el-descriptions-item>
                <el-descriptions-item label="@XR["Task.StartTime"]">{{ task.startTime }}</el-descriptions-item>
                <el-descriptions-item label="@XR["Task.EndTime"]">{{ task.endTime }}</el-descriptions-item>
                <el-descriptions-item label="@XR["Task.CrawledPages"]">{{ task.crawledPages }}</el-descriptions-item>
                <el-descriptions-item label="@XR["Task.ErrorMessage"]">{{ task.errorMessage }}</el-descriptions-item>
            </el-descriptions>
        </div>

        <div class="url-stats" style="margin-top: 20px;">
            <el-card>
                <div slot="header">
                    <span>@XR["Task.UrlStatistics"]</span>
                </div>
                <el-row :gutter="20">
                    <el-col :span="8">
                        <div class="stat-item">
                            <div class="stat-value">{{stats.totalUrls}}</div>
                            <div class="stat-label">@XR["Task.TotalUrls"]</div>
                        </div>
                    </el-col>
                    <el-col :span="8">
                        <div class="stat-item">
                            <div class="stat-value">{{stats.successUrls}}</div>
                            <div class="stat-label">@XR["Task.SuccessCount"]</div>
                        </div>
                    </el-col>
                    <el-col :span="8">
                        <div class="stat-item">
                            <div class="stat-value">{{stats.failedUrls}}</div>
                            <div class="stat-label">@XR["Task.FailureCount"]</div>
                        </div>
                    </el-col>
                </el-row>
            </el-card>
        </div>

        <div class="url-list" style="margin-top: 20px;">
            <el-tabs v-model="activeTab" @@tab-click="handleTabClick">
                <el-tab-pane v-for="domain in domains" :key="domain" :label="domain" :name="domain">
                    <el-table :data="urlList" style="width: 100%" v-loading="loading">
                        <el-table-column prop="url" label="URL" width="300"></el-table-column>
                        <el-table-column prop="parentUrl" label="@XR["Task.ParentUrl"]" width="300"></el-table-column>
                        <el-table-column prop="deep" label="@XR["Task.Depth"]" width="80"></el-table-column>
                        <el-table-column prop="crawlTime" label="@XR["Task.CrawlTime"]" width="180"></el-table-column>
                        <el-table-column prop="pageSize" label="@XR["Task.PageSize"]" width="120"></el-table-column>
                        <el-table-column prop="statusCode" label="@XR["Task.StatusCode"]" width="100">
                            <template slot-scope="scope">
                                <el-tag :type="getHttpStatusType(scope.row.statusCode)">{{scope.row.statusCode}}</el-tag>
                            </template>
                        </el-table-column>
                        <el-table-column prop="title" label="@XR["Common.Title"]"></el-table-column>
                    </el-table>
                    <div class="pagination" style="margin-top: 20px; text-align: right;">
                        <el-pagination
                            @@size-change="handleSizeChange"
                            @@current-change="handleCurrentChange"
                            :current-page="currentPage"
                            :page-sizes="[10, 20, 50, 100]"
                            :page-size="pageSize"
                            layout="total, sizes, prev, pager, next, jumper"
                            :total="total">
                        </el-pagination>
                    </div>
                </el-tab-pane>
            </el-tabs>
        </div>
    </div>
</div>

@section scripts{
    @await Html.PartialAsync("_LocalizationScripts")
    <script src="~/js/SenMapic/task-detail.js"></script>
}
