@page
@model Senparc.Xncf.PromptRange.Areas.PromptRange.Pages.SkillModel
@{
    ViewData["Title"] = XR["Frontend.700"];
    Layout = "_Layout_Vue";
}

@section breadcrumbs {
    <el-breadcrumb-item>@XR["Area.ExtensionModules"]</el-breadcrumb-item>
    <el-breadcrumb-item>@XR["Frontend.701"]</el-breadcrumb-item>
    <el-breadcrumb-item>@XR["Frontend.700"]</el-breadcrumb-item>
}

<div id="skillPage" class="p-3">
    <div class="d-flex justify-content-between align-center mb-3">
        <div>
            <h3 class="mb-1">{{ ncfST('Frontend.700') }}</h3>
            <small class="text-muted">{{ ncfST('Frontend.760') }}</small>
        </div>
        <div class="d-flex" style="gap: 8px;">
            <el-button icon="el-icon-refresh" @@click="loadSkills">{{ ncfST('Frontend.702') }}</el-button>
            <el-button type="success" icon="el-icon-magic-stick" @@click="generationDialogVisible = true">{{ ncfST('Frontend.703') }}</el-button>
            <el-button type="primary" icon="el-icon-download" @@click="installDialogVisible = true">{{ ncfST('Frontend.704') }}</el-button>
        </div>
    </div>

    <el-alert :title="ncfST('Frontend.705')" type="info" :closable="false" class="mb-3"></el-alert>

    <el-row :gutter="16" class="mb-3">
        <el-col :span="8"><el-card shadow="never"><div class="text-muted">{{ ncfST('Frontend.706') }}</div><strong class="h4">{{ skills.length }}</strong></el-card></el-col>
        <el-col :span="8"><el-card shadow="never"><div class="text-muted">{{ ncfST('Frontend.707') }}</div><strong class="h4 text-warning">{{ draftCount }}</strong></el-card></el-col>
        <el-col :span="8"><el-card shadow="never"><div class="text-muted">{{ ncfST('Frontend.708') }}</div><strong class="h4 text-success">{{ publishedCount }}</strong></el-card></el-col>
    </el-row>

    <el-table :data="skills" v-loading="loading" border row-key="skillId">
        <el-table-column type="expand">
            <template slot-scope="scope">
                <div class="p-2">
                    <div class="text-muted mb-2">{{ scope.row.description }}</div>
                    <el-timeline>
                        <el-timeline-item v-for="version in scope.row.versions" :key="version.version"
                                          :type="version.status === 1 ? 'success' : 'warning'"
                                          :timestamp="version.version">
                            <div class="d-flex justify-content-between align-center">
                                <span>{{ version.name || version.promptCode }}</span>
                                <div>
                                    <el-tag size="mini" :type="version.status === 1 ? 'success' : 'warning'">
                                        {{ version.status === 1 ? ncfST('Frontend.771') : 'Draft' }}
                                    </el-tag>
                                    <el-button type="text" @@click="previewSkill(scope.row, version)">{{ ncfST('Frontend.709') }}</el-button>
                                </div>
                            </div>
                        </el-timeline-item>
                    </el-timeline>
                </div>
            </template>
        </el-table-column>
        <el-table-column prop="skillId" label="Skill" min-width="180"></el-table-column>
        <el-table-column prop="name" :label="ncfST('Frontend.710')" min-width="180"></el-table-column>
        <el-table-column prop="currentVersion" :label="ncfST('Frontend.711')" min-width="220"></el-table-column>
        <el-table-column :label="ncfST('Frontend.712')" width="110">
            <template slot-scope="scope"><el-tag :type="scope.row.status === 1 ? 'success' : 'warning'">{{ scope.row.status === 1 ? ncfST('Frontend.771') : 'Draft' }}</el-tag></template>
        </el-table-column>
        <el-table-column :label="ncfST('Frontend.713')" width="250" class-name="ncf-table-actions-column">
            <template slot-scope="scope">
                <el-button type="info" plain icon="el-icon-view" @@click="previewSkill(scope.row, currentVersion(scope.row))">{{ ncfST('Frontend.714') }}</el-button>
                <el-button v-if="scope.row.status !== 1" type="success" plain icon="el-icon-upload2" @@click="publishSkill(scope.row)">{{ ncfST('Frontend.715') }}</el-button>
            </template>
        </el-table-column>
    </el-table>

    <el-dialog :title="ncfST('Frontend.704')" :visible.sync="installDialogVisible" width="560px">
        <el-tabs v-model="installTab">
            <el-tab-pane label="ZIP / Release" name="zip">
                <el-input v-model="packageUrl" placeholder="https://example.com/example.skill.zip"></el-input>
            </el-tab-pane>
            <el-tab-pane :label="ncfST('Frontend.716')" name="upload">
                <input type="file" accept=".zip,application/zip,application/x-zip-compressed" @@change="selectPackage" />
                <small class="text-muted d-block mt-2">{{ ncfST('Frontend.717') }}</small>
                <div v-if="packageFile" class="mt-2 text-muted">{{ ncfST('Frontend.796', packageFile.name) }}</div>
            </el-tab-pane>
            <el-tab-pane :label="ncfST('Frontend.718')" name="github">
                <el-input v-model="githubUrl" placeholder="https://github.com/owner/repo/tree/main/skills/example"></el-input>
                <small class="text-muted">{{ ncfST('Frontend.719') }}</small>
            </el-tab-pane>
        </el-tabs>
        <div slot="footer"><el-button @@click="installDialogVisible = false">{{ ncfST('Frontend.097') }}</el-button><el-button type="primary" :loading="installing" @@click="installSkill">{{ ncfST('Frontend.720') }}</el-button></div>
    </el-dialog>

    <el-dialog :title="ncfST('Frontend.703')" :visible.sync="generationDialogVisible" width="680px">
        <el-form label-width="110px">
            <el-form-item :label="ncfST('Frontend.721')" required><el-input type="textarea" :rows="5" v-model="generation.description" :placeholder="ncfST('Frontend.722')"></el-input></el-form-item>
            <el-form-item label="SkillId"><el-input v-model="generation.skillId" :placeholder="ncfST('Frontend.761')"></el-input></el-form-item>
            <el-form-item :label="ncfST('Frontend.724')"><el-input v-model="generation.skillName" :placeholder="ncfST('Frontend.723')"></el-input></el-form-item>
            <el-form-item :label="ncfST('Frontend.725')"><el-select v-model="generation.existingSkillId" clearable filterable :placeholder="ncfST('Frontend.726')" style="width: 100%"><el-option v-for="skill in skills" :key="skill.skillId" :label="skill.name + ' (' + skill.skillId + ')'" :value="skill.skillId"></el-option></el-select></el-form-item>
            <el-form-item v-if="generation.existingSkillId" :label="ncfST('Frontend.727')"><el-select v-model="generation.existingVersion" clearable :placeholder="ncfST('Frontend.728')" style="width: 100%"><el-option v-for="version in selectedSkillVersions" :key="version.version" :label="version.version" :value="version.version"></el-option></el-select></el-form-item>
            <el-form-item :label="ncfST('Frontend.729')" required><el-select v-model="generation.modelId" :placeholder="ncfST('Frontend.730')" filterable style="width: 100%"><el-option v-for="model in chatModels" :key="model.id" :label="model.alias || model.modelId" :value="model.id"></el-option></el-select></el-form-item>
        </el-form>
        <div slot="footer"><el-button @@click="generationDialogVisible = false">{{ ncfST('Frontend.097') }}</el-button><el-button type="success" :loading="generating" @@click="generateSkill">{{ ncfST('Frontend.731') }}</el-button></div>
    </el-dialog>

    <el-dialog :title="ncfST('Frontend.732')" :visible.sync="previewDialogVisible" width="900px">
        <el-alert v-if="preview.manifestJson" title="Manifest" type="info" :closable="false" class="mb-2"><pre>{{ preview.manifestJson }}</pre></el-alert>
        <el-empty v-if="!preview.files.length" :description="ncfST('Frontend.733')"></el-empty>
        <el-tabs v-model="previewTab">
            <el-tab-pane v-for="file in preview.files" :key="file.path" :label="file.path" :name="file.path">
                <el-alert v-if="!file.isPreviewable" :title="ncfST('Frontend.734')" type="warning" :closable="false"></el-alert>
                <pre v-else class="skill-preview">{{ file.content || ncfST('Frontend.797') }}</pre>
            </el-tab-pane>
        </el-tabs>
    </el-dialog>
</div>

@section scripts {
    @await Html.PartialAsync("_PromptRangeLocalizationScripts")
<script>
    new Vue({
        el: '#app',
        data: {
            skills: [],
            loading: false,
            installing: false,
            installDialogVisible: false,
            packageUrl: '',
            githubUrl: '',
            packageFile: null,
            installTab: 'github',
            generationDialogVisible: false,
            generating: false,
            chatModels: [],
            generation: { description: '', skillId: '', skillName: '', modelId: null, existingSkillId: '', existingVersion: '' },
            previewDialogVisible: false,
            previewTab: '',
            preview: { manifestJson: '', files: [] }
        },
        mounted: function () {
            this.loadSkills();
            this.loadChatModels();
        },
        computed: {
            draftCount: function () { return this.skills.filter(function (skill) { return skill.status !== 1; }).length; },
            publishedCount: function () { return this.skills.filter(function (skill) { return skill.status === 1; }).length; },
            selectedSkillVersions: function () {
                var selected = this.skills.find(function (skill) { return skill.skillId === this.generation.existingSkillId; });
                return selected ? (selected.versions || []) : [];
            }
        },
        methods: {
            loadSkills: function () {
                var self = this;
                self.loading = true;
                axios.get('/api/Senparc.Xncf.PromptRange/SkillAppService/Xncf.PromptRange_SkillAppService.ListAsync', {
                    params: { publishedOnly: false }
                }).then(function (response) {
                    self.skills = response.data.data || response.data.Data || [];
                }).catch(function (error) {
                    self.$message.error(ncfST('Frontend.738') + (error.message || ncfST('Frontend.740')));
                }).finally(function () {
                    self.loading = false;
                });
            },
            loadChatModels: function () {
                var self = this;
                axios.get('/api/Senparc.Xncf.PromptRange/SkillAppService/Xncf.PromptRange_SkillAppService.ListChatModelsAsync')
                    .then(function (response) { self.chatModels = response.data.data || response.data.Data || []; })
                    .catch(function (error) { self.$message.error(ncfST('Frontend.739') + (error.message || ncfST('Frontend.740'))); });
            },
            selectPackage: function (event) {
                var file = event.target.files && event.target.files.length ? event.target.files[0] : null;
                if (file && file.size > 50 * 1024 * 1024) {
                    this.packageFile = null;
                    event.target.value = '';
                    this.$message.warning(ncfST('Frontend.741'));
                    return;
                }
                this.packageFile = file;
            },
            installSkill: function () {
                var self = this;
                if (self.installTab === 'upload') {
                    if (!self.packageFile) {
                        self.$message.warning(ncfST('Frontend.742'));
                        return;
                    }

                    var formData = new FormData();
                    formData.append('package', self.packageFile);
                    self.installing = true;
                    axios.post('/api/Senparc.Xncf.PromptRange/SkillAppService/Xncf.PromptRange_SkillAppService.InstallAsync', formData, {
                        headers: { 'Content-Type': 'multipart/form-data' }
                    }).then(function () {
                        self.$message.success(ncfST('Frontend.743'));
                        self.installDialogVisible = false;
                        self.packageFile = null;
                        self.loadSkills();
                    }).catch(function (error) {
                        self.$message.error(ncfST('Frontend.744') + (error.message || ncfST('Frontend.740')));
                    }).finally(function () {
                        self.installing = false;
                    });
                    return;
                }

                var url = self.installTab === 'github' ? self.githubUrl : self.packageUrl;
                if (!url || !url.toLowerCase().startsWith('https://')) {
                    self.$message.warning(ncfST('Frontend.745'));
                    return;
                }

                self.installing = true;
                axios.post('/api/Senparc.Xncf.PromptRange/SkillAppService/Xncf.PromptRange_SkillAppService.InstallFromUrlAsync', {
                    packageUrl: url
                }).then(function () {
                    self.$message.success(ncfST('Frontend.743'));
                    self.installDialogVisible = false;
                    self.packageUrl = '';
                    self.githubUrl = '';
                    self.loadSkills();
                }).catch(function (error) {
                    self.$message.error(ncfST('Frontend.746') + (error.message || ncfST('Frontend.740')));
                }).finally(function () {
                    self.installing = false;
                });
            },
            generateSkill: function () {
                var self = this;
                if (!self.generation.description || !self.generation.modelId) {
                    self.$message.warning(ncfST('Frontend.747'));
                    return;
                }
                self.generating = true;
                axios.post('/api/Senparc.Xncf.PromptRange/SkillAppService/Xncf.PromptRange_SkillAppService.GenerateAsync', self.generation)
                    .then(function () {
                        self.$message.success(ncfST('Frontend.748'));
                        self.generationDialogVisible = false;
                        self.generation = { description: '', skillId: '', skillName: '', modelId: null, existingSkillId: '', existingVersion: '' };
                        self.loadSkills();
                    }).catch(function (error) {
                        self.$message.error(ncfST('Frontend.749') + (error.message || ncfST('Frontend.740')));
                    }).finally(function () { self.generating = false; });
            },
            currentVersion: function (skill) {
                return (skill.versions && skill.versions.length) ? skill.versions[0] : { version: skill.currentVersion };
            },
            previewSkill: function (skill, version) {
                var self = this;
                axios.get('/api/Senparc.Xncf.PromptRange/SkillAppService/Xncf.PromptRange_SkillAppService.PreviewAsync', {
                    params: { skillId: skill.skillId, version: version && (version.version || version.Version || version.promptCode || version.PromptCode) }
                }).then(function (response) {
                    var payload = response && response.data ? response.data : {};
                    var data = payload.data !== undefined ? payload.data : payload.Data;
                    data = data || {};
                    var files = data.files !== undefined ? data.files : data.Files;
                    files = Array.isArray(files) ? files.map(function (file) {
                        return {
                            path: file.path !== undefined ? file.path : file.Path,
                            contentType: file.contentType !== undefined ? file.contentType : file.ContentType,
                            length: file.length !== undefined ? file.length : file.Length,
                            isPreviewable: file.isPreviewable !== undefined ? file.isPreviewable : file.IsPreviewable,
                            content: file.content !== undefined ? file.content : file.Content
                        };
                    }) : [];
                    self.preview = {
                        manifestJson: data.manifestJson !== undefined ? data.manifestJson : data.ManifestJson,
                        files: files
                    };
                    self.previewTab = files.length ? files[0].path : '';
                    self.previewDialogVisible = true;
                }).catch(function (error) { self.$message.error(ncfST('Frontend.750') + (error.message || ncfST('Frontend.740'))); });
            },
            publishSkill: function (skill) {
                var self = this;
                self.$confirm(ncfST('Frontend.751'), ncfST('Frontend.752'), {
                    type: 'warning'
                }).then(function () {
                    return axios.post('/api/Senparc.Xncf.PromptRange/SkillAppService/Xncf.PromptRange_SkillAppService.PublishAsync', {
                        skillId: skill.skillId,
                        version: skill.currentVersion
                    });
                }).then(function () {
                    self.$message.success(ncfST('Frontend.753'));
                    self.loadSkills();
                }).catch(function (error) {
                    if (error !== 'cancel') {
                        self.$message.error(ncfST('Frontend.749') + (error.message || ncfST('Frontend.740')));
                    }
                });
            }
        }
    });
</script>
<style>
    .skill-preview { max-height: 520px; overflow: auto; white-space: pre-wrap; background: #f7f8fa; padding: 16px; }
    .el-timeline { padding-left: 0; }
</style>
}
