@page
@model Senparc.Xncf.PromptRange.Areas.PromptRange.Pages.Index
@{
    ViewData["Title"] = XR["Title.Home"];
    Layout = "_Layout_Vue";
}
@section Style{
    <link href="~/css/PromptRange/index.css" rel="stylesheet" />
}
@section breadcrumbs{
    <el-breadcrumb-item>@XR["Area.ExtensionModules"]</el-breadcrumb-item>
    <el-breadcrumb-item>@XR["Area.PromptRange"]</el-breadcrumb-item>
    <el-breadcrumb-item>@XR["Area.Home"]</el-breadcrumb-item>
}

<div class="indexPage" v-cloak>
    <div class="headRow">
        <div class="leftBox">
            <div class="title">
                <div>PromptRange</div>
                <div>@XR["Area.PromptRange"]</div>
            </div>
            <div class="btn" @@click="toAIKernel">
                @XR["Dashboard.AddModel"]
            </div>
        </div>
        <img src="~/image/PromptRange/index_headBg.png" class="headBg" />
        <img src="~/image/PromptRange/index_headRight1.png" class="headRightIcon1" />
        <img src="~/image/PromptRange/index_headRight2.png" class="headRightIcon2" />
        <img src="~/image/PromptRange/index_headRight3.png" class="headRightIcon3" />
    </div>

    <div class="toolRow">
        <div class="toolLeft">
            @XR["Dashboard.DataUpdated"]{{ formatDateTime(dashboard.generatedAt) }}
        </div>
        <div class="toolRight">
            <el-button size="mini" type="primary" :loading="loading" @@click="fetchDashboard(true)">@XR["Dashboard.Refresh"]</el-button>
            <el-button size="mini" @@click="goPromptWorkbench">@XR["Dashboard.Workbench"]</el-button>
        </div>
    </div>

    <div class="overviewGrid">
        <div class="overviewCard" v-for="item in overviewCards" :key="item.key">
            <div class="label">{{ item.label }}</div>
            <div class="value">{{ item.value }}</div>
            <div class="hint">{{ item.hint }}</div>
        </div>
    </div>

    <div class="boardGrid" v-loading="loading">
        <div class="boardCard trendCard">
            <div class="cardTitleRow">
                <div class="cardTitle">{{ ncfT('PromptRange.Dashboard.Trend', dashboard.recentDays || 14) }}</div>
                <div class="cardSubTitle">@XR["Dashboard.TrendSubtitle"]</div>
            </div>
            <div id="usageTrendChart" class="chart chartTrend"></div>
        </div>

        <div class="boardCard modelCard">
            <div class="cardTitleRow">
                <div class="cardTitle">@XR["Dashboard.ModelDistribution"]</div>
                <div class="cardSubTitle">{{ ncfT('PromptRange.Dashboard.TopModels', dashboard.topModels ? dashboard.topModels.length : 0) }}</div>
            </div>
            <div id="modelUsageChart" class="chart chartModel"></div>
        </div>

        <div class="boardCard promptCard">
            <div class="cardTitleRow">
                <div class="cardTitle">@XR["Dashboard.TopPrompts"]</div>
                <a class="cardLink" :href="buildPromptUrl(null, null)">@XR["Dashboard.PromptPage"]</a>
            </div>
            <div class="tableWrap" v-if="dashboard.topPrompts && dashboard.topPrompts.length > 0">
                <table class="insightTable">
                    <thead>
                        <tr>
                            <th>Prompt</th>
                            <th>@XR["Dashboard.Range"]</th>
                            <th>@XR["Dashboard.Calls"]</th>
                            <th>@XR["Dashboard.AverageScore"]</th>
                            <th>@XR["Dashboard.LastRun"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-for="item in dashboard.topPrompts" :key="'prompt-' + item.promptId">
                            <td>
                                <a class="linkText" :href="buildPromptUrl(item.rangeId, item.promptId)">
                                    {{ item.promptName }}
                                </a>
                                <div class="subText">
                                    {{ item.fullVersion }}
                                    <span class="tagWarning" v-if="item.isDraft">@XR["Dashboard.Draft"]</span>
                                </div>
                            </td>
                            <td>{{ formatRangeName(item.rangeAlias, item.rangeName) }}</td>
                            <td>{{ item.usageCount }}</td>
                            <td :class="scoreClass(item.avgScore)">{{ formatScore(item.avgScore) }}</td>
                            <td>{{ formatDateTime(item.lastRunTime) }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <el-empty v-else description="@XR["Dashboard.EmptyPrompt"]"></el-empty>
        </div>

        <div class="boardCard rangeCard">
            <div class="cardTitleRow">
                <div class="cardTitle">@XR["Dashboard.Health"]</div>
                <div class="cardSubTitle">@XR["Dashboard.HealthSubtitle"]</div>
            </div>
            <div class="rangeList" v-if="dashboard.topRanges && dashboard.topRanges.length > 0">
                <div class="rangeItem" v-for="item in dashboard.topRanges" :key="'range-' + item.rangeId">
                    <div class="rangeTopRow">
                        <a class="linkText" :href="buildPromptUrl(item.rangeId, null)">
                            {{ formatRangeName(item.rangeAlias, item.rangeName) }}
                        </a>
                        <span class="healthText">{{ item.healthScore }} @XR["Dashboard.ScoreUnit"]</span>
                    </div>
                    <div class="rangeMeta">
                        Prompt {{ item.promptCount }} / @XR["Dashboard.Active"] {{ item.activePromptCount }} / @XR["Dashboard.Calls"] {{ item.usageCount }} / @XR["Dashboard.Draft"] {{ item.draftPromptCount }}
                    </div>
                    <div class="progressBar">
                        <span :style="{ width: clampPercent(item.healthScore) + '%' }"></span>
                    </div>
                </div>
            </div>
            <el-empty v-else description="@XR["Dashboard.EmptyRange"]"></el-empty>
        </div>

        <div class="boardCard riskCard">
            <div class="cardTitleRow">
                <div class="cardTitle">@XR["Dashboard.Risk"]</div>
                <div class="cardSubTitle">@XR["Dashboard.RiskSubtitle"]</div>
            </div>
            <div class="riskList" v-if="dashboard.riskPrompts && dashboard.riskPrompts.length > 0">
                <div class="riskItem" v-for="item in dashboard.riskPrompts" :key="'risk-' + item.promptId">
                    <div class="riskTopRow">
                        <span class="riskType">{{ item.riskType }}</span>
                        <a class="linkText" :href="buildPromptUrl(item.rangeId, item.promptId)">
                            {{ item.promptName }}
                        </a>
                    </div>
                    <div class="riskMeta">
                        {{ formatRangeName(item.rangeAlias, item.rangeName) }} · {{ item.fullVersion }} · @XR["Dashboard.Calls"] {{ item.usageCount }} · @XR["Dashboard.AverageScore"] {{ formatScore(item.avgScore) }}
                    </div>
                    <div class="riskDesc">{{ item.riskMessage }}</div>
                </div>
            </div>
            <el-empty v-else description="@XR["Dashboard.EmptyRisk"]"></el-empty>
        </div>

        <div class="boardCard insightCard">
            <div class="cardTitleRow">
                <div class="cardTitle">@XR["Dashboard.Insight"]</div>
                <div class="cardSubTitle">@XR["Dashboard.InsightSubtitle"]</div>
            </div>
            <div class="insightList" v-if="dashboard.insights && dashboard.insights.length > 0">
                <div class="insightItem"
                     v-for="(item, index) in dashboard.insights"
                     :key="'insight-' + index"
                     :class="'level-' + (item.level || 'info')">
                    <div class="insightTitle">{{ item.title }}</div>
                    <div class="insightDesc">{{ item.description }}</div>
                </div>
            </div>
            <el-empty v-else description="@XR["Dashboard.EmptyInsight"]"></el-empty>
        </div>
    </div>
</div>

@section scripts{
    @await Html.PartialAsync("_LocalizationScripts")
    <script src="~/js/PromptRange/lib/axios.min.js"></script>
    <script src="~/js/PromptRange/echarts/echarts.min.js"></script>
    <script src="~/js/PromptRange/axios.js"></script>
    <script src="~/js/PromptRange/index.js"></script>
}
