<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.2.2</Version>
    <PackageReleaseNotes>
[2026-10-24] Fix Workspace Agent deployment and support native or DLL startup.
[2026-11-03] v0.2.1 提供隔离工作区 Agent、文件系统访问和运行时连接
[2026-11-03] Rename to Senparc.Xncf.WorkspaceAgent and propagate runtime files through project references for build and publish.
</PackageReleaseNotes>
    <AssemblyName>Senparc.Xncf.WorkspaceAgent</AssemblyName>
    <RootNamespace>Senparc.Xncf.WorkspaceAgent</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Senparc.Xncf.Workspace.Abstractions\Senparc.Xncf.Workspace.Abstractions.csproj" />
  </ItemGroup>

  <Target Name="GetWorkspaceAgentRuntimeFiles" Returns="@(WorkspaceAgentRuntimeFiles)">
    <ItemGroup>
      <!-- Resolve paths in the Agent project so solution configuration mappings and custom output paths are respected. -->
      <WorkspaceAgentRuntimeFiles Include="$(TargetPath);$(ProjectDepsFilePath);$(ProjectRuntimeConfigFilePath)" />
    </ItemGroup>
  </Target>

</Project>
