<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.2.4</Version>
    <AssemblyName>Senparc.Xncf.WorkspaceAgent</AssemblyName>
    <RootNamespace>Senparc.Xncf.WorkspaceAgent</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild Condition=" '$(Configuration)' == 'Release' ">true</GeneratePackageOnBuild>
    <GeneratePackageOnBuild Condition="'$(Configuration)'=='TemplateRelease'">true</GeneratePackageOnBuild>
    <Description>Workspace isolated-runtime Agent: provides file-system access, command execution, and long-lived connection protocols.</Description>
    <Copyright>Senparc</Copyright>
    <PackageTags>Senparc,NeuCharFramework,NCF,Senparc.Xncf.Workspace,WorkspaceAgent</PackageTags>
    <Authors>Senparc</Authors>
    <Owners>Senparc</Owners>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Title>Workspace Agent</Title>
    <PackageIcon>icon.jpg</PackageIcon>
    <PackageReleaseNotes>
      [2026-10-24] Fix Workspace Agent deployment and support native or DLL startup.
      [2026-11-03] v0.2.1 Updated module behavior and related support.
      [2026-11-03] Rename to Senparc.Xncf.WorkspaceAgent and propagate runtime files through project references for build and publish.
      [2026-11-11] v0.2.2 read workspace text by line window and limit individual line size
      1. Updated module behavior and related support.
      2. Updated module behavior and related support.
      [2026-11-12] v0.2.3 Updated module behavior and related support.
      1. the file-system engine supports relative-path globs and content regex search.
      2. output clearer diagnostics on operation failure while preserving the single-line size limit.
      [2026-11-13] v0.2.4 fix missing Agent runtime files for NuGet consumers
      1. package the Agent DLL, dependency manifest, and runtime configuration into the tool directory.
      2. copy runtime files to consumer output and publish directories through the buildTransitive target.
    </PackageReleaseNotes>
    <RepositoryUrl>https://github.com/NeuCharFramework/NcfPackageSources</RepositoryUrl>
    <Configurations>Debug;Release;Test;TemplateRelease</Configurations>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <OutputPath>..\..\BuildOutPut</OutputPath>
    <DefineConstants>$(DefineConstants);RELEASE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <ErrorReport>prompt</ErrorReport>
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='TemplateRelease'">
    <OutputPath>..\..\BuildOutPut</OutputPath>
    <DefineConstants>$(DefineConstants);RELEASE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <ErrorReport>prompt</ErrorReport>
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>
      $(TargetsForTfmSpecificContentInPackage);IncludeWorkspaceAgentRuntimeFilesForTfmPackage
    </TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Senparc.Xncf.Workspace.Abstractions\Senparc.Xncf.Workspace.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\icon.jpg" Pack="true" Visible="false" PackagePath="" />
  </ItemGroup>

  <Target Name="GetWorkspaceAgentRuntimeFiles" Returns="@(WorkspaceAgentRuntimeFiles)">
    <ItemGroup>
      <!-- Resolve paths in the Agent project so solution configuration mappings and custom output paths are respected. -->
      <WorkspaceAgentRuntimeFiles Include="$(TargetPath);$(ProjectDepsFilePath);$(ProjectRuntimeConfigFilePath)" />
    </ItemGroup>
  </Target>

  <Target Name="IncludeWorkspaceAgentRuntimeFilesForTfmPackage"
          Returns="@(TfmSpecificPackageFile)">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetPath)">
        <PackagePath>tools/WorkspaceAgent/</PackagePath>
      </TfmSpecificPackageFile>
      <TfmSpecificPackageFile Include="$(ProjectDepsFilePath)">
        <PackagePath>tools/WorkspaceAgent/</PackagePath>
      </TfmSpecificPackageFile>
      <TfmSpecificPackageFile Include="$(ProjectRuntimeConfigFilePath)">
        <PackagePath>tools/WorkspaceAgent/</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Include="buildTransitive/Senparc.Xncf.WorkspaceAgent.targets"
          Pack="true"
          PackagePath="buildTransitive/Senparc.Xncf.WorkspaceAgent.targets"
          Visible="false" />
  </ItemGroup>

</Project>
