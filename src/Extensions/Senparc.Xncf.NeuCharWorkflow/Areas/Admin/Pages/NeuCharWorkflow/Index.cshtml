@page
@model Senparc.Xncf.NeuCharWorkflow.Areas.NeuCharWorkflow.Pages.IndexModel
@using Microsoft.Extensions.Localization
@using Senparc.Xncf.NeuCharWorkflow
@inject IStringLocalizer<NeuCharWorkflowResource> XR
@{
    ViewData["Title"] = XR["Title.Designer"];
    Layout = "_Layout_Vue";
}

@section breadcrumbs {
    <el-breadcrumb-item>@XR["Module.MenuName"]</el-breadcrumb-item>
    <el-breadcrumb-item>@XR["Area.Workflow"]</el-breadcrumb-item>
}

@section Style {
    <link rel="stylesheet" href="~/css/NeuCharWorkflow/common.css" />
    <link rel="stylesheet" href="~/css/NeuCharWorkflow/Workflow.css" />
}

<div class="neuchar-page workflow-page" v-loading="loading">
    <transition name="workflow-node-preview-fade">
        <section v-if="nodePreview.visible"
                 :class="['workflow-node-preview', {'is-hover-preview':nodePreview.mode==='hover'}]"
                 :style="nodePreviewStyle"
                 @@mousedown.stop
                 @@click.stop>
            <header>
                <span class="workflow-node-preview-kind">{{nodePreviewDetails.kind}}</span>
                <el-button type="text" icon="el-icon-close" title="关闭节点详情" aria-label="关闭节点详情" @@click="dismissNodePreview"></el-button>
            </header>
            <h2>{{nodePreviewDetails.title}}</h2>
            <p v-if="nodePreviewDetails.description" class="workflow-node-preview-description">{{nodePreviewDetails.description}}</p>
            <dl v-if="nodePreviewDetails.rows.length" class="workflow-node-preview-details">
                <div v-for="row in nodePreviewDetails.rows" :key="row.label+row.value">
                    <dt>{{row.label}}</dt>
                    <dd :title="row.value">{{row.value}}</dd>
                </div>
            </dl>
            <footer>
                <span>{{nodePreview.mode==='click'?'点击其它位置关闭，或 15 秒后自动关闭':'移开节点后关闭'}}</span>
                <strong>{{nodePreviewDetails.actionText}}</strong>
            </footer>
        </section>
    </transition>
    <div :class="['workflow-shell',shellClasses]">
        <aside class="workflow-list-pane">
            <div class="workflow-list-heading">
                <strong v-show="!listCollapsed">工作流</strong>
                <span v-show="!listCollapsed" class="workflow-list-actions">
                    <el-button type="text"
                               icon="el-icon-refresh"
                               title="刷新工作流列表"
                               aria-label="刷新工作流列表"
                               :disabled="editingLocked"
                               @@click="refreshWorkflowList"></el-button>
                    <el-button type="primary"
                               plain
                               size="mini"
                               icon="el-icon-plus"
                               title="新建工作流"
                               aria-label="新建工作流"
                               :disabled="editingLocked"
                               @@click="createWorkflow"></el-button>
                </span>
                <el-button type="text"
                           :icon="listCollapsed?'el-icon-s-unfold':'el-icon-s-fold'"
                           :title="listCollapsed?'展开工作流列表':'折叠工作流列表'"
                           @@click="listCollapsed=!listCollapsed"></el-button>
            </div>
            <template v-if="!listCollapsed">
                <el-input v-model="keyword" size="small" clearable prefix-icon="el-icon-search" placeholder="搜索工作流"></el-input>
                <div v-if="filteredWorkflows.length" class="workflow-list">
                    <button v-for="item in filteredWorkflows"
                            :key="item.id"
                            :class="['workflow-list-item',{active: form.id===item.id}]"
                            :disabled="editingLocked"
                            @@click="editWorkflow(item.id)">
                        <span class="workflow-list-name">{{item.name}}</span>
                        <span class="workflow-list-badges">
                            <el-tag size="mini" effect="plain" :type="workflowTriggerTagType(item)">{{workflowTriggerLabel(item)}}</el-tag>
                            <el-tag size="mini" :type="item.enabled?'success':'info'">{{item.enabled?'启用':'草稿'}}</el-tag>
                        </span>
                        <small :class="{'workflow-next-run':isIntervalWorkflow(item)}"
                               :title="workflowScheduleTitle(item)">
                            <i v-if="isIntervalWorkflow(item)" class="el-icon-time"></i>
                            {{isIntervalWorkflow(item) ? workflowScheduleText(item) : `Revision ${item.revision}`}}
                        </small>
                    </button>
                </div>
                <div v-else class="workflow-list-empty">暂无工作流</div>
            </template>
        </aside>

        <main class="workflow-editor">
            <template v-if="editing">
                <div class="workflow-command-bar">
                    <div class="workflow-command-identity">
                        <el-input v-model="form.name" size="small" :disabled="editingLocked" maxlength="200" placeholder="工作流名称"></el-input>
                        <el-tag size="mini" effect="plain">{{form.triggerType==='webhook'?'Webhook':(form.triggerType==='interval'?'间隔触发':'手动触发')}}</el-tag>
                        <span :class="['workflow-save-status',{'is-dirty':saveDirty,'is-error':saveState.status==='error'}]" :title="saveStatusText">{{saveStatusText}}</span>
                    </div>
                    <div class="workflow-command-actions" aria-label="工作流快捷操作">
                        <el-button type="primary"
                                   size="small"
                                   icon="el-icon-check"
                                   :loading="saveState.saving"
                                   :disabled="editingLocked || (form.id && !saveDirty)"
                                   title="保存（Command/Ctrl + S）"
                                   @@click="saveWorkflow({source:'manual'})">保存</el-button>
                        <el-button size="small"
                                   icon="el-icon-video-play"
                                   :disabled="!form.id || editingLocked || disconnectedNodes.length>0"
                                   :title="disconnectedNodes.length?'请先连接所有草稿节点后再测试运行':'保存并测试运行'"
                                   @@click="startWorkflow">运行</el-button>
                        <el-button v-if="run.running"
                                   size="small"
                                   type="danger"
                                   plain
                                   icon="el-icon-circle-close"
                                   :loading="run.aborting"
                                   @@click="abortWorkflow">中止</el-button>
                        <el-button size="small"
                                   plain
                                   icon="el-icon-plus"
                                   :disabled="editingLocked"
                                   title="打开添加节点面板"
                                   @@click="paletteCollapsed=false">添加节点</el-button>
                        <el-dropdown trigger="click" @@command="handleWorkflowAction">
                            <el-button size="small" plain icon="el-icon-more" title="更多工作流操作" aria-label="更多工作流操作"></el-button>
                            <el-dropdown-menu slot="dropdown">
                                <el-dropdown-item command="new" :disabled="editingLocked || saveState.saving">
                                    <i class="el-icon-plus"></i> 新建工作流
                                </el-dropdown-item>
                                <el-dropdown-item command="settings" :disabled="editingLocked">
                                    <i class="el-icon-setting"></i> 工作流设置
                                </el-dropdown-item>
                                <el-dropdown-item command="auto-layout" :disabled="editingLocked">
                                    <i class="el-icon-magic-stick"></i> 按设置自动排版
                                </el-dropdown-item>
                                <el-dropdown-item command="align-grid" :disabled="editingLocked">
                                    <i class="el-icon-s-grid"></i> 就近网格对齐
                                </el-dropdown-item>
                                <el-dropdown-item command="fit-canvas">
                                    <i class="el-icon-full-screen"></i> 适应画布
                                </el-dropdown-item>
                                <el-dropdown-item command="tasks">
                                    <i class="el-icon-document"></i> 任务列表
                                </el-dropdown-item>
                                <el-dropdown-item v-if="form.id" command="delete" divided :disabled="editingLocked">
                                    <i class="el-icon-delete"></i> 删除工作流
                                </el-dropdown-item>
                            </el-dropdown-menu>
                        </el-dropdown>
                    </div>
                </div>

                <section v-if="validationIssues.length" class="workflow-validation-panel" role="alert" aria-live="assertive">
                    <div class="workflow-validation-panel-header">
                        <strong><i class="el-icon-warning"></i> 节点检查失败</strong>
                        <el-button type="text" size="mini" @@click="clearValidationIssue">清除提示</el-button>
                    </div>
                    <button v-for="issue in validationIssues"
                            :key="(issue.nodeId || 'workflow') + '-' + issue.message"
                            type="button"
                            class="workflow-validation-item"
                            :disabled="!issue.nodeId"
                            @@click="focusValidationIssue(issue)">
                        <span class="workflow-validation-item-node">{{issue.label}}</span>
                        <span class="workflow-validation-item-message">{{issue.message}}</span>
                        <i v-if="issue.nodeId" class="el-icon-right"></i>
                    </button>
                </section>

                <el-dialog title="工作流设置"
                           :visible.sync="workflowSettingsVisible"
                           :close-on-click-modal="false"
                           width="min(720px, calc(100vw - 32px))"
                           append-to-body>
                    <el-form label-position="top" size="small" :class="{'form-locked':editingLocked}">
                        <el-form-item label="说明">
                            <el-input v-model="form.description" :disabled="editingLocked" placeholder="用一句话说明这个工作流"></el-input>
                        </el-form-item>
                        <div class="workflow-settings-grid">
                            <el-form-item label="触发方式">
                                <el-select v-model="form.triggerType" :disabled="editingLocked" @@change="syncTriggerNode">
                                    <el-option label="手动触发" value="manual"></el-option>
                                    <el-option label="间隔触发" value="interval"></el-option>
                                    <el-option label="Webhook" value="webhook"></el-option>
                                </el-select>
                            </el-form-item>
                            <el-form-item v-if="form.triggerType==='interval'" label="间隔秒数">
                                <el-input-number v-model="form.intervalSeconds" :disabled="editingLocked" :min="60" :max="31536000" :step="60"></el-input-number>
                            </el-form-item>
                            <el-form-item label="运行状态">
                                <el-switch v-model="form.enabled" :disabled="editingLocked" active-text="启用"></el-switch>
                            </el-form-item>
                            <el-form-item label="自动保存" title="只在当前页面打开且内容有变化时执行">
                                <div class="workflow-auto-save">
                                    <el-switch :value="form.autoSaveMinutes>0"
                                               :disabled="editingLocked || saveState.saving"
                                               active-text="自动保存"
                                               @@change="setAutoSaveEnabled"></el-switch>
                                    <el-input-number v-if="form.autoSaveMinutes>0"
                                                     v-model="form.autoSaveMinutes"
                                                     :disabled="editingLocked || saveState.saving"
                                                     :min="1"
                                                     :max="1440"
                                                     :step="1"
                                                     :precision="0"
                                                     controls-position="right"></el-input-number>
                                    <span v-if="form.autoSaveMinutes>0">分钟</span>
                                </div>
                            </el-form-item>
                            <el-form-item label="自动排列方向" title="影响“按设置自动排版”的层级阅读方向；默认纵向">
                                <el-radio-group v-model="form.graph.layout.direction" :disabled="editingLocked">
                                    <el-radio-button label="vertical">纵向</el-radio-button>
                                    <el-radio-button label="horizontal">横向</el-radio-button>
                                </el-radio-group>
                            </el-form-item>
                            <el-form-item label="画布对齐">
                                <div class="workflow-layout-actions">
                                    <el-button size="small"
                                               icon="el-icon-magic-stick"
                                               :disabled="editingLocked"
                                               @@click="autoLayout()">按方向重新排列</el-button>
                                    <el-button size="small"
                                               icon="el-icon-s-grid"
                                               :disabled="editingLocked"
                                               @@click="alignToNearbyGrid()">就近网格对齐</el-button>
                                </div>
                                <p class="workflow-layout-help">就近网格对齐只做有限距离吸附和防重叠；会优先保留当前阅读顺序，并避免把连线拉得更长。</p>
                            </el-form-item>
                        </div>

                        <section class="workflow-variable-settings">
                            <div class="workflow-variable-settings-heading">
                                <div>
                                    <strong>工作流变量</strong>
                                    <p>在这里声明默认值，后续受限公式用 <code v-pre>{{= vars.变量名 }}</code> 读取；安全代码节点可在本次运行中重新赋值。</p>
                                </div>
                                <el-button size="small"
                                           icon="el-icon-plus"
                                           :disabled="editingLocked || form.graph.variables.length>=30"
                                           @@click="addWorkflowVariable">添加变量</el-button>
                            </div>
                            <el-alert title="变量名只能使用字母、数字、下划线，且以字母或下划线开头。默认值可使用受限公式；不会执行 JavaScript。"
                                      type="info"
                                      :closable="false"></el-alert>
                            <div v-if="form.graph.variables.length" class="workflow-variable-list">
                                <div v-for="(variable,index) in form.graph.variables" :key="'workflow-variable-'+index" class="workflow-variable-row">
                                    <el-input v-model="variable.name"
                                              :disabled="editingLocked"
                                              maxlength="64"
                                              placeholder="变量名，例如 customerName"></el-input>
                                    <workflow-rich-text-input v-model="variable.value"
                                                              multiline
                                                              :rows="2"
                                                              :disabled="editingLocked"
                                                              :editable="false"
                                                              :maxlength="8000"
                                                              :help-text="'默认值支持受限公式，例如 {{= now() }} 或 {{= upper(vars.customerName) }}。'"></workflow-rich-text-input>
                                    <el-button type="text"
                                               class="workflow-variable-remove"
                                               :disabled="editingLocked"
                                               @@click="removeWorkflowVariable(index)">删除</el-button>
                                </div>
                            </div>
                            <p v-else class="workflow-variable-empty">尚未声明变量。先添加变量，才能在“安全代码”节点中对它赋值。</p>
                        </section>

                        <div v-if="form.triggerType==='webhook'" class="workflow-webhook-config">
                            <div class="webhook-config-heading">
                                <strong>Webhook 触发配置</strong>
                                <el-button type="text" size="mini" icon="el-icon-question" @@click="webhookHelpVisible=true">使用说明</el-button>
                            </div>
                            <div class="webhook-config-row">
                                <label>请求方法</label>
                                <el-select v-model="form.webhookMethod" :disabled="editingLocked" size="small">
                                    <el-option label="不限定（GET/POST及其他）" value="any"></el-option>
                                    <el-option label="GET" value="get"></el-option>
                                    <el-option label="POST" value="post"></el-option>
                                </el-select>
                                <label>访问密钥</label>
                                <el-input v-model="form.webhookToken" size="small" readonly placeholder="保存后自动生成">
                                    <el-button slot="append" icon="el-icon-document-copy" title="复制访问密钥" @@click="copyText(form.webhookToken)"></el-button>
                                </el-input>
                                <el-button size="small" icon="el-icon-document-copy" :disabled="!form.id" @@click="copyText(webhookUrl)">复制 URL</el-button>
                            </div>
                            <div class="webhook-parameters-heading">
                                <span>参数（{{form.webhookParameters.length}}/50）</span>
                                <el-button type="text" size="small" :disabled="editingLocked || form.webhookParameters.length>=50" @@click="addWebhookParameter">添加参数</el-button>
                            </div>
                            <div v-if="form.webhookParameters.length" class="webhook-parameters">
                                <div v-for="(parameter,index) in form.webhookParameters" :key="parameter._id" class="webhook-parameter-row">
                                    <el-input v-model="parameter.name" size="small" placeholder="参数名，例如 userId" :disabled="editingLocked"></el-input>
                                    <el-checkbox v-model="parameter.required" :disabled="editingLocked">必填</el-checkbox>
                                    <el-input v-model="parameter.description" size="small" placeholder="说明（可选）" :disabled="editingLocked"></el-input>
                                    <el-button type="text" class="webhook-parameter-remove" :disabled="editingLocked" @@click="removeWebhookParameter(index)">删除</el-button>
                                </div>
                            </div>
                            <div v-else class="webhook-parameters-empty">未配置参数：接收全部 Query、Form 与 JSON 字段。</div>
                        </div>
                    </el-form>
                    <span slot="footer" class="dialog-footer">
                        <el-button @@click="workflowSettingsVisible=false">关闭</el-button>
                    </span>
                </el-dialog>

                <el-dialog title="Webhook 使用说明"
                           :visible.sync="webhookHelpVisible"
                           width="min(620px, calc(100vw - 32px))"
                           append-to-body>
                    <div class="workflow-webhook-help">
                        <p>先保存工作流以生成调用地址和访问密钥。外部请求必须携带该密钥。</p>
                        <template v-if="form.id">
                            <p>调用地址：<code>{{webhookUrl}}</code></p>
                            <p>推荐使用请求头 <code>X-NeuChar-Webhook-Token</code> 传递访问密钥；也兼容 query 参数 <code>token</code>。</p>
                        </template>
                        <p>已定义的参数可从 Query、Form 或 JSON 请求体读取；未定义参数时，整个请求数据都会作为工作流输入。</p>
                    </div>
                    <span slot="footer" class="dialog-footer">
                        <el-button @@click="webhookHelpVisible=false">关闭</el-button>
                    </span>
                </el-dialog>

                <el-dialog :title="templateEditorTitle"
                           :visible.sync="templateEditor.visible"
                           :close-on-click-modal="false"
                           :close-on-press-escape="false"
                           @@mousedown.native.stop
                           @@mouseup.native.stop
                           width="min(760px, calc(100vw - 32px))"
                           append-to-body>
                    <p class="template-editor-help">先输入固定文字，再从下方选择上游输出或“预载输入选择”。系统会插入一个可见的占位符；同一文本可插入多个变量。</p>
                    <el-alert :title="templateExpressionHelp"
                              type="warning"
                              :closable="false"
                              show-icon></el-alert>
                    <el-input v-model="templateEditor.text"
                              type="textarea"
                              :rows="12"
                              :disabled="editingLocked"
                              :placeholder="templateEditorPlaceholder"></el-input>
                    <div v-if="templateEditor.allowBindings" class="template-editor-picker">
                        <span>插入上游值</span>
                        <el-cascader :value="templateEditor.pendingSelection"
                                     :options="upstreamOutputOptions(null)"
                                     :disabled="editingLocked || !upstreamOutputOptions(null).length"
                                     :props="{expandTrigger:'hover'}"
                                     clearable
                                     filterable
                                     placeholder="选择节点、输出或预载输入选择"
                                     @@change="appendTemplateBinding"></el-cascader>
                    </div>
                    <div v-if="templateEditor.allowBindings && templateEditor.bindings.length" class="template-binding-tags">
                        <div v-for="item in templateEditor.bindings" :key="item.token" class="template-binding-item">
                            <el-tag :disable-transitions="true"
                                    :title="templateBindingLabel(item.source)"
                                    :closable="!editingLocked"
                                    @@close="removeTemplateBinding(item.token)">
                                {{templatePlaceholder(item.token)}} · {{templateBindingLabel(item.source)}}
                            </el-tag>
                            <el-input-number v-if="item.source.requiresIndex"
                                             v-model="item.source.collectionIndex"
                                             :disabled="editingLocked"
                                             :min="0"
                                             :step="1"
                                             size="mini"
                                             controls-position="right"
                                             placeholder="列表索引"></el-input-number>
                        </div>
                    </div>
                    <el-alert :title="templateEditorBindingHelpText"
                              type="info"
                              :closable="false"
                              show-icon></el-alert>
                    <span slot="footer" class="dialog-footer">
                        <el-button @@click="templateEditor.visible=false">取消</el-button>
                        <el-button type="primary" :disabled="editingLocked" @@click="saveParameterTemplate">应用</el-button>
                    </span>
                </el-dialog>

                <div class="workflow-designer">
                    <aside ref="palette" class="workflow-palette">
                        <div class="pane-heading">
                            <strong v-show="!paletteCollapsed">添加节点</strong>
                            <el-button type="text"
                                       :icon="paletteCollapsed?'el-icon-s-unfold':'el-icon-s-fold'"
                                       :title="paletteCollapsed?'展开添加节点':'折叠添加节点'"
                                       @@click="paletteCollapsed=!paletteCollapsed"></el-button>
                        </div>
                        <div v-show="!paletteCollapsed" class="palette-content">
                            <workflow-node-picker :functions="functions"
                                                  :objects="workflowObjects"
                                                  :pinned-function-keys="pinnedFunctions"
                                                  :locked="editingLocked"
                                                  @@select-system="addSimpleNode"
                                                  @@select-function="addFunctionNode"
                                                  @@select-object="addObjectNode"
                                                  @@toggle-pin="togglePin"
                                                  @@preview-node="showNodePreview"
                                                  @@hide-preview-node="hideHoveredNodePreview"
                                                  @@drag-node="beginPaletteNodeDrag"
                                                  @@drag-end="endPaletteNodeDrag"></workflow-node-picker>
                        </div>
                    </aside>

                    <section ref="canvas"
                             class="workflow-canvas"
                             :class="{'is-panning':canvasPan.active}"
                             @@mousedown="onCanvasMouseDown"
                             @@wheel.prevent="zoomCanvas"
                             @@scroll="updateCanvasViewport"
                             @@dragover.prevent="onCanvasDragOver"
                             @@drop.prevent="onCanvasDrop"
                             @@contextmenu.prevent="onCanvasContextMenu">
                        <div class="workflow-scale-surface" :style="canvasSurfaceStyle">
                            <div ref="stage"
                                 :class="['workflow-stage', {'is-horizontal-layout':layoutDirection==='horizontal'}]"
                                 :style="canvasStageStyle">
                                <svg class="workflow-wires" :width="canvasSize.width" :height="canvasSize.height" aria-hidden="true">
                                    <defs>
                                        <marker id="workflow-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8 Z"></path></marker>
                                    </defs>
                                    <g v-for="edge in form.graph.edges" :key="edge.id" :class="{'edge-insert-candidate':activeInsertionEdgeId===edge.id,'loop-scope-edge-highlight':isLoopScopeEdgeHighlighted(edge)}">
                                        <path :d="edgePath(edge)" marker-end="url(#workflow-arrow)"></path>
                                        <text v-if="['true','false','break'].includes(edge.sourceHandle)" :x="edgeLabelX(edge)" :y="edgeLabelY(edge)">{{edge.sourceHandle==='true'?'真':(edge.sourceHandle==='false'?'假':'break')}}</text>
                                    </g>
                                    <path v-if="connectionDraft.sourceId" class="draft-wire" :d="draftEdgePath()"></path>
                                </svg>
                                <div v-if="selectionBox.active" class="workflow-selection-box" :style="selectionBoxStyle"></div>

                                <button v-for="edge in form.graph.edges"
                                        :key="'delete-'+edge.id"
                                        type="button"
                                        class="edge-delete"
                                        :style="edgeDeletePosition(edge)"
                                        :disabled="editingLocked"
                                        title="删除连线"
                                        @@mousedown.stop
                                        @@click.stop="removeEdge(edge)">×</button>
                                <button v-for="edge in form.graph.edges"
                                        :key="'insert-'+edge.id"
                                        type="button"
                                        class="edge-insert"
                                        :style="edgeInsertPosition(edge)"
                                        :disabled="editingLocked"
                                        title="在线中插入节点"
                                        aria-label="在线中插入节点"
                                        @@mousedown.stop
                                        @@click.stop="openEdgeInsertMenu(edge)">+</button>

                                <section v-if="edgeInsertMenu.visible"
                                         class="workflow-edge-insert-menu"
                                         :style="edgeInsertMenuStyle"
                                         @@mousedown.stop
                                         @@click.stop
                                         @@wheel.stop>
                                    <header class="workflow-edge-insert-heading">
                                        <span><i class="el-icon-plus"></i> 在线中插入节点</span>
                                        <el-button type="text" icon="el-icon-close" title="关闭" @@click="closeEdgeInsertMenu"></el-button>
                                    </header>
                                    <p>原连线会替换为“上游 → 新节点 → 下游”。</p>
                                    <workflow-node-picker :functions="functions"
                                                          :objects="workflowObjects"
                                                          :pinned-function-keys="pinnedFunctions"
                                                          :locked="editingLocked"
                                                          edge-insert
                                                          @@select-system="insertSimpleNode"
                                                          @@select-function="insertFunctionNode"
                                                          @@select-object="insertObjectNode"
                                                          @@toggle-pin="togglePin"
                                                          @@preview-node="showNodePreview"
                                                          @@hide-preview-node="hideHoveredNodePreview"
                                                          @@drag-node="beginPaletteNodeDrag"
                                                          @@drag-end="endPaletteNodeDrag"></workflow-node-picker>
                                </section>

                                <section v-if="canvasNodeInsertMenu.visible"
                                         class="workflow-edge-insert-menu workflow-canvas-node-insert-menu"
                                         :style="canvasNodeInsertMenuStyle"
                                         @@mousedown.stop
                                         @@click.stop
                                         @@wheel.stop>
                                    <header class="workflow-edge-insert-heading">
                                        <span><i class="el-icon-plus"></i> 在此处新增节点</span>
                                        <el-button type="text" icon="el-icon-close" title="关闭" @@click="closeCanvasNodeInsertMenu"></el-button>
                                    </header>
                                    <p>双击节点添加到右键所选位置；也可直接拖放到画布。</p>
                                    <workflow-node-picker :functions="functions"
                                                          :objects="workflowObjects"
                                                          :pinned-function-keys="pinnedFunctions"
                                                          :locked="editingLocked"
                                                          @@select-system="addCanvasContextSimpleNode"
                                                          @@select-function="addCanvasContextFunctionNode"
                                                          @@select-object="addCanvasContextObjectNode"
                                                          @@toggle-pin="togglePin"
                                                          @@preview-node="showNodePreview"
                                                          @@hide-preview-node="hideHoveredNodePreview"
                                                          @@drag-node="beginPaletteNodeDrag"
                                                          @@drag-end="endPaletteNodeDrag"></workflow-node-picker>
                                </section>

                                <article v-for="(node,index) in form.graph.nodes"
                                         :key="node.id"
                                         :data-node-id="node.id"
                                         :class="['workflow-node','node-'+node.type,'state-'+nodeState(node),{selected:isNodeSelected(node),'is-multi-selected':selectedNodeIds.length>1 && isNodeSelected(node),'validation-error':!!nodeValidationError(node),'loop-scope-highlight':isLoopScopeHighlighted(node),'loop-label-highlight':isLoopLabelHighlighted(node)}]"
                                         :style="{left:node.x+'px',top:node.y+'px'}"
                                         :title="nodeValidationError(node) || ''"
                                         @@mousedown.stop="startDrag($event,node)"
                                         @@contextmenu.stop.prevent="openNodeContextMenu($event,node)">
                                    <template v-if="node.type==='loop-end'">
                                        <button type="button" class="node-port node-input node-input-continue" :class="{ready:!!connectionDraft.sourceId}" title="连接到 continue 输入端" @@mousedown.stop @@mouseup.stop="completeConnection(node,'continue')">continue</button>
                                        <button type="button" class="node-port node-input node-input-break" :class="{ready:!!connectionDraft.sourceId}" title="连接到 break 输入端" @@mousedown.stop @@mouseup.stop="completeConnection(node,'break')">break</button>
                                    </template>
                                    <button v-else-if="!node.type.endsWith('trigger')"
                                            type="button"
                                            class="node-port node-input"
                                            :class="{ready:!!connectionDraft.sourceId}"
                                            title="拖到此处完成连接"
                                            @@mousedown.stop
                                            @@mouseup.stop="completeConnection(node)"></button>
                                    <div class="workflow-node-body">
                                        <span class="node-index">{{index+1}}</span>
                                        <div>
                                            <strong>{{node.name}}</strong>
                                            <small>{{nodeSummary(node)}}</small>
                                        </div>
                                        <span v-if="nodeState(node)" class="node-run-state">
                                            <i v-if="nodeState(node)==='running'" class="el-icon-loading"></i>
                                            <i v-else-if="nodeState(node)==='success'" class="el-icon-success"></i>
                                            <i v-else class="el-icon-error"></i>
                                        </span>
                                        <el-button v-else-if="!node.type.endsWith('trigger')" type="text" icon="el-icon-delete" :disabled="editingLocked" @@click.stop="removeNode(node)"></el-button>
                                    </div>
                                    <span v-if="nodeValidationError(node)" class="workflow-node-validation-badge" :title="nodeValidationError(node)" aria-label="节点检查失败">!</span>
                                    <template v-if="node.type==='condition'">
                                        <button type="button" class="node-port node-output node-output-true" title="拖动真分支" @@mousedown.stop="beginConnection($event,node,'true')">真</button>
                                        <button type="button" class="node-port node-output node-output-false" title="拖动假分支" @@mousedown.stop="beginConnection($event,node,'false')">假</button>
                                        <button type="button" class="node-port node-output node-output-break" title="拖动 break：跳出当前循环" @@mousedown.stop="beginConnection($event,node,'break')">break</button>
                                    </template>
                                    <button v-else-if="node.type!=='end'"
                                            type="button"
                                            class="node-port node-output node-output-default"
                                            title="拖动连接后续节点"
                                            @@mousedown.stop="beginConnection($event,node,'default')"></button>
                                </article>
                                <div v-if="connectionDraft.sourceId" class="connection-hint">从“{{connectionSourceName}}”拖到目标节点{{layoutDirection==='horizontal'?'左侧':'顶部'}}端口；松开到空白处可取消。</div>
                            </div>
                        </div>
                        <div class="canvas-zoom-controls" :style="canvasZoomControlsStyle" @@mousedown.stop @@wheel.stop>
                            <button type="button" title="缩小" aria-label="缩小画布" :disabled="canvasZoom<=0.02" @@click.stop="changeCanvasZoom(-.1)"><i class="el-icon-minus"></i></button>
                            <input type="range" min="0.02" max="2" step="0.01" :value="canvasZoom" :aria-valuetext="canvasZoomPercent+'%'" @@input="onCanvasZoomInput" @@click.stop>
                            <button type="button" title="放大" aria-label="放大画布" :disabled="canvasZoom>=2" @@click.stop="changeCanvasZoom(.1)"><i class="el-icon-plus"></i></button>
                            <button type="button" class="canvas-zoom-reset" title="恢复 100%" @@click.stop="resetCanvasZoom">{{canvasZoomPercent}}%</button>
                        </div>
                        <div v-if="showMinimap" class="canvas-minimap" :style="minimapStyle" @@mousedown.stop @@wheel.stop>
                            <div class="canvas-minimap-surface"
                                 :style="{width:minimapMetrics.width+'px',height:minimapMetrics.height+'px'}"
                                 title="点击定位画布"
                                 @@click.stop="moveCanvasFromMinimap">
                                <svg class="canvas-minimap-wires" :width="minimapMetrics.width" :height="minimapMetrics.height" aria-hidden="true">
                                    <line v-for="edge in form.graph.edges"
                                          :key="'minimap-'+edge.id"
                                          :x1="minimapEdgeStart(edge).x"
                                          :y1="minimapEdgeStart(edge).y"
                                          :x2="minimapEdgeEnd(edge).x"
                                          :y2="minimapEdgeEnd(edge).y"></line>
                                </svg>
                                <span v-for="node in form.graph.nodes"
                                      :key="'minimap-node-'+node.id"
                                      :class="['canvas-minimap-node','node-'+node.type,{selected:selectedNodeId===node.id}]"
                                      :style="minimapNodeStyle(node)"></span>
                                <span class="canvas-minimap-viewport" :style="minimapViewportStyle"></span>
                            </div>
                        </div>
                        <div v-if="contextMenu.visible"
                             class="workflow-context-menu"
                             :style="{left:contextMenu.x+'px',top:contextMenu.y+'px'}"
                             @@mousedown.stop
                             @@click.stop>
                            <span v-if="selectedNodeIds.length>1" class="workflow-context-menu-summary">已选择 {{selectedNodeIds.length}} 个节点</span>
                            <button type="button"
                                    :disabled="editingLocked || !selectedDuplicableNodes.length"
                                    @@click="duplicateContextNode">复制</button>
                            <button type="button"
                                    :disabled="editingLocked || !selectedDeletableNodes.length"
                                    @@click="removeContextNode">删除</button>
                        </div>
                        <div v-if="canvasContextMenu.visible"
                             class="workflow-context-menu workflow-canvas-context-menu"
                             :style="{left:canvasContextMenu.x+'px',top:canvasContextMenu.y+'px'}"
                             @@mousedown.stop
                             @@click.stop>
                            <button type="button"
                                    :disabled="editingLocked"
                                    @@click="openCanvasNodeInsertMenu"><i class="el-icon-plus"></i> 新增节点</button>
                            <span class="workflow-context-menu-divider"></span>
                            <button type="button" :disabled="editingLocked" @@click="autoLayoutFromCanvasMenu"><i class="el-icon-magic-stick"></i> 按设置自动排版</button>
                            <button type="button" :disabled="editingLocked" @@click="alignGridFromCanvasMenu"><i class="el-icon-s-grid"></i> 就近网格对齐</button>
                            <button type="button" @@click="fitCanvasFromCanvasMenu"><i class="el-icon-full-screen"></i> 适应画布</button>
                        </div>
                    </section>

                    <aside ref="inspector" class="workflow-inspector">
                        <div class="pane-heading">
                            <strong v-show="!inspectorCollapsed">节点设置</strong>
                            <el-button type="text"
                                       :icon="inspectorCollapsed?'el-icon-s-unfold':'el-icon-s-fold'"
                                       :title="inspectorCollapsed?'展开节点设置':'折叠节点设置'"
                                       @@click="inspectorCollapsed=!inspectorCollapsed"></el-button>
                        </div>
                        <div v-show="!inspectorCollapsed" class="inspector-content">
                            <template v-if="selectedNode">
                                <el-form label-position="top" size="small" :class="{'form-locked':editingLocked}">
                                    <el-form-item label="名称"><el-input v-model="selectedNode.name" :disabled="editingLocked"></el-input></el-form-item>

                                    <template v-if="selectedNode.type==='condition'">
                                        <el-form-item label="条件为真时">
                                            <el-select clearable :disabled="editingLocked" :value="targetFor(selectedNode,'true')" placeholder="也可直接拖拽连线" @@change="setTarget(selectedNode,'true',$event)">
                                                <el-option v-for="target in availableTargets(selectedNode,'true')" :key="target.id" :label="target.name" :value="target.id"></el-option>
                                            </el-select>
                                        </el-form-item>
                                        <el-form-item label="条件为假时">
                                            <el-select clearable :disabled="editingLocked" :value="targetFor(selectedNode,'false')" placeholder="也可直接拖拽连线" @@change="setTarget(selectedNode,'false',$event)">
                                                <el-option v-for="target in availableTargets(selectedNode,'false')" :key="target.id" :label="target.name" :value="target.id"></el-option>
                                            </el-select>
                                        </el-form-item>
                                        <el-form-item label="循环控制（可选）">
                                            <el-select v-model="selectedNode.config.breakOn" :disabled="editingLocked" clearable placeholder="普通条件判断">
                                                <el-option label="不启用 break" value=""></el-option>
                                                <el-option label="条件为真时跳出循环" value="true"></el-option>
                                                <el-option label="条件为假时跳出循环" value="false"></el-option>
                                            </el-select>
                                            <p class="node-config-help">启用后，把节点的 break 端口连接到当前“循环结束”的 break 输入端；另一结果继续走真/假分支。</p>
                                        </el-form-item>
                                        <el-form-item label="break 后续节点">
                                            <el-select clearable :disabled="editingLocked" :value="targetFor(selectedNode,'break')" placeholder="仅在循环控制启用时使用" @@change="setTarget(selectedNode,'break',$event)">
                                                <el-option v-for="target in availableTargets(selectedNode,'break')" :key="target.id" :label="target.name" :value="target.id"></el-option>
                                            </el-select>
                                        </el-form-item>
                                    </template>
                                    <el-form-item v-else-if="selectedNode.type==='parallel'" label="并行分支">
                                        <div class="workflow-parallel-branches">
                                            <strong>{{outgoingEdges(selectedNode.id).length}} 个后续分支</strong>
                                            <span>请从节点右侧输出端依次拖拽到每个要同时运行的节点。</span>
                                        </div>
                                    </el-form-item>
                                    <el-form-item v-else-if="selectedNode.type!=='end'" label="后续节点">
                                        <el-select clearable :disabled="editingLocked" :value="targetFor(selectedNode,'default')" placeholder="也可直接拖拽连线" @@change="setTarget(selectedNode,'default',$event)">
                                            <el-option v-for="target in availableTargets(selectedNode,'default')" :key="target.id" :label="target.name" :value="target.id"></el-option>
                                        </el-select>
                                    </el-form-item>

                                    <template v-if="selectedNode.type==='function' && selectedFunction">
                                        <el-alert v-if="!selectedFunction.moduleAvailable" title="模块未安装或未开启，节点不可执行" type="warning" :closable="false"></el-alert>
                                        <el-alert v-if="selectedFunction.catalogError" title="Function 参数元数据读取异常，请检查模块日志" type="warning" :closable="false"></el-alert>
                                        <el-alert v-if="incomingEdges(selectedNode.id).length>1" title="此 Function 有多个上游；任一有效来源到达都可以触发，单次工作流运行中该节点最多执行一次。" type="info" :closable="false"></el-alert>
                                        <div class="workflow-object-card workflow-function-card">
                                            <div class="workflow-object-card-header">
                                                <div>
                                                    <strong>{{selectedFunction.functionName}}</strong>
                                                    <small>{{selectedFunction.moduleName}} · {{selectedFunction.functionKey}}</small>
                                                </div>
                                                <div class="workflow-function-actions">
                                                    <el-button v-if="functionPageUrl(selectedFunction,'settings')"
                                                               type="primary"
                                                               plain
                                                               size="mini"
                                                               icon="el-icon-setting"
                                                               :disabled="editingLocked"
                                                               @@click="openFunctionPage(selectedFunction,'settings')">设置</el-button>
                                                    <el-button v-if="functionPageUrl(selectedFunction,'run')"
                                                               type="success"
                                                               plain
                                                               size="mini"
                                                               icon="el-icon-video-play"
                                                               :disabled="editingLocked"
                                                               @@click="openFunctionPage(selectedFunction,'run')">执行</el-button>
                                                </div>
                                            </div>
                                        </div>
                                        <div v-for="parameter in functionParameters(selectedFunction)" :key="parameter.name" class="parameter-editor">
                                            <label class="parameter-label">
                                                <span>{{parameterDisplayName(parameter)}}</span>
                                                <code v-if="hasParameterFieldName(parameter)" class="parameter-field-name">{{parameter.name}}</code>
                                                <el-tooltip v-if="parameterDescription(parameter)"
                                                            effect="dark"
                                                            placement="top-start"
                                                            :content="parameterDescription(parameter)">
                                                    <i class="el-icon-info parameter-description-icon" aria-label="参数说明"></i>
                                                </el-tooltip>
                                                <el-tooltip v-if="parameter.metadataError"
                                                            effect="dark"
                                                            placement="top-start"
                                                            :content="parameter.metadataError">
                                                    <i class="el-icon-warning-outline parameter-metadata-warning" aria-label="参数元数据异常"></i>
                                                </el-tooltip>
                                                <em v-if="parameter.required">必填</em>
                                            </label>

                                            <template v-if="isTemplateValue(selectedNode.config.parameters[parameter.name])">
                                                <div class="parameter-template-card">
                                                    <div class="parameter-template-summary">{{parameterTemplateSummary(selectedNode.config.parameters[parameter.name])}}</div>
                                                    <div class="parameter-template-tags">
                                                        <el-tag v-for="item in parameterTemplateBindings(selectedNode.config.parameters[parameter.name])"
                                                                :key="item.token"
                                                                size="mini"
                                                                :title="templateBindingLabel(item.source)">
                                                            {{templatePlaceholder(item.token)}}
                                                        </el-tag>
                                                        <el-tag v-if="formulaParameterCompatibility(parameter,selectedNode.config.parameters[parameter.name])"
                                                                :type="formulaParameterCompatibility(parameter,selectedNode.config.parameters[parameter.name]).level"
                                                                size="mini">
                                                            {{formulaParameterCompatibility(parameter,selectedNode.config.parameters[parameter.name]).text}}
                                                        </el-tag>
                                                    </div>
                                                    <div class="parameter-template-actions">
                                                        <el-button type="text" size="mini" :disabled="editingLocked" @@click="openParameterTemplateEditor(selectedNode,parameter)">编辑文本与变量</el-button>
                                                        <el-button type="text" size="mini" :disabled="editingLocked" @@click="resetParameterManual(selectedNode,parameter)">改为手动输入</el-button>
                                                    </div>
                                                </div>
                                            </template>
                                            <template v-else-if="!isBinding(selectedNode.config.parameters[parameter.name])">
                                                <workflow-rich-text-input v-if="parameter.parameterType===0"
                                                                          v-model="selectedNode.config.parameters[parameter.name]"
                                                                          :disabled="editingLocked"
                                                                          :editable="canUseTemplate(parameter)"
                                                                          :help-text="functionParameterFormulaHelp(parameter)"
                                                                          placeholder="手动输入或使用公式"
                                                                          @@edit-template="openParameterTemplateEditor(selectedNode,parameter)"></workflow-rich-text-input>
                                                <div v-if="formulaParameterCompatibility(parameter,selectedNode.config.parameters[parameter.name])"
                                                     :class="['parameter-formula-compatibility','binding-'+formulaParameterCompatibility(parameter,selectedNode.config.parameters[parameter.name]).level]">
                                                    {{formulaParameterCompatibility(parameter,selectedNode.config.parameters[parameter.name]).text}}
                                                </div>
                                                <el-input v-else-if="parameter.parameterType===3"
                                                          type="password"
                                                          :disabled="editingLocked"
                                                          v-model="selectedNode.config.parameters[parameter.name]"
                                                          placeholder="手动输入"></el-input>
                                                <el-select v-else-if="parameter.parameterType===1"
                                                           v-model="selectedNode.config.parameters[parameter.name]"
                                                           :disabled="editingLocked"
                                                           :filterable="parameter.filterable"
                                                           :allow-create="parameter.allowCreate">
                                                    <el-option v-for="option in parameter.options" :key="option.value" :label="option.text" :value="option.value"></el-option>
                                                </el-select>
                                                <el-checkbox-group v-else-if="parameter.parameterType===2" v-model="selectedNode.config.parameters[parameter.name]" :disabled="editingLocked">
                                                    <el-checkbox v-for="option in parameter.options" :key="option.value" :label="option.value">{{option.text}}</el-checkbox>
                                                </el-checkbox-group>
                                                <el-switch v-else-if="parameter.parameterType===4" v-model="selectedNode.config.parameters[parameter.name]" :disabled="editingLocked"></el-switch>
                                            </template>

                                            <div v-else :class="['binding-card','binding-'+bindingCompatibility(selectedNode,parameter).level]">
                                                <div>
                                                    <i class="el-icon-connection"></i>
                                                    {{bindingCompatibility(selectedNode,parameter).text}}
                                                </div>
                                                <el-button type="text" size="mini" :disabled="editingLocked" @@click="resetParameterManual(selectedNode,parameter)">改为手动输入</el-button>
                                                <el-input-number v-if="resolvedBindingFor(selectedNode,parameter).requiresIndex"
                                                                 v-model="selectedNode.config.parameters[parameter.name].$source.collectionIndex"
                                                                 :disabled="editingLocked"
                                                                 :min="0"
                                                                 :step="1"
                                                                 size="mini"
                                                                 controls-position="right"
                                                                 placeholder="列表索引"></el-input-number>
                                                <el-input-number v-if="resolvedBindingFor(selectedNode,parameter).isArray && !expectedShape(parameter).isArray"
                                                                 v-model="selectedNode.config.parameters[parameter.name].$source.itemIndex"
                                                                 :disabled="editingLocked"
                                                                 :min="0"
                                                                 :step="1"
                                                                 size="mini"
                                                                 controls-position="right"
                                                                 placeholder="数组索引"></el-input-number>
                                            </div>

                                            <div class="upstream-picker">
                                                <span>或完整关联上游输出 / Function 预载输入选择</span>
                                                <el-cascader :value="bindingSelection(selectedNode,parameter)"
                                                             :options="upstreamOutputOptions(parameter)"
                                                             :disabled="editingLocked || !upstreamOutputOptions(parameter).length"
                                                             :props="{expandTrigger:'hover'}"
                                                             clearable
                                                             filterable
                                                             placeholder="选择节点、输出或预载输入选择"
                                                             @@change="setParameterBinding(selectedNode,parameter,$event)"></el-cascader>
                                            </div>
                                        </div>
                                    </template>

                                    <template v-if="selectedNode.type==='condition'">
                                        <el-form-item label="左值">
                                            <workflow-rich-text-input v-if="!isBinding(selectedNode.config.left)"
                                                                      v-model="selectedNode.config.left"
                                                                      :disabled="editingLocked"
                                                                      :help-text="'可使用 {{input}} 或受限公式，也可以插入上游输出作为文本片段。'"
                                                                      placeholder="手动输入、公式或插入变量"
                                                                      @@edit-template="openNodeTemplateEditor(selectedNode,'left',{fieldLabel:'条件左值'})"></workflow-rich-text-input>
                                            <el-cascader :value="configBindingSelection(selectedNode,'left')" :options="upstreamOutputOptions(null)" :disabled="editingLocked || !upstreamOutputOptions(null).length" clearable filterable placeholder="关联上游 Output" @@change="setConfigBinding(selectedNode,'left',$event)"></el-cascader>
                                        </el-form-item>
                                        <el-form-item label="判断">
                                            <el-select v-model="selectedNode.config.operator" :disabled="editingLocked">
                                                <el-option label="等于" value="equals"></el-option><el-option label="包含" value="contains"></el-option><el-option label="不等于" value="not-equals"></el-option><el-option label="开头是" value="starts-with"></el-option><el-option label="结尾是" value="ends-with"></el-option>
                                            </el-select>
                                        </el-form-item>
                                        <el-form-item label="右值">
                                            <workflow-rich-text-input v-if="!isBinding(selectedNode.config.right)"
                                                                      v-model="selectedNode.config.right"
                                                                      :disabled="editingLocked"
                                                                      :help-text="'可使用 {{input}} 或受限公式，也可以插入上游输出作为文本片段。'"
                                                                      placeholder="手动输入、公式或插入变量"
                                                                      @@edit-template="openNodeTemplateEditor(selectedNode,'right',{fieldLabel:'条件右值'})"></workflow-rich-text-input>
                                            <el-cascader :value="configBindingSelection(selectedNode,'right')" :options="upstreamOutputOptions(null)" :disabled="editingLocked || !upstreamOutputOptions(null).length" clearable filterable placeholder="关联上游 Output" @@change="setConfigBinding(selectedNode,'right',$event)"></el-cascader>
                                        </el-form-item>
                                    </template>
                                    <el-form-item v-if="selectedNode.type==='delay'" label="等待秒数（单节点最多 30 秒）">
                                        <el-input-number v-model="selectedNode.config.seconds" :disabled="editingLocked" :min="0" :max="30"></el-input-number>
                                    </el-form-item>
                                    <template v-if="selectedNode.type==='loop'">
                                        <el-form-item label="重复次数（For）">
                                            <div v-if="isTemplateValue(selectedNode.config.count)" class="workflow-loop-count-binding workflow-loop-count-formula">
                                                <strong>使用语法计算次数：{{parameterTemplateSummary(selectedNode.config.count)}}</strong>
                                                <span>运行时结果必须是 1–100000 的整数；可使用 <code v-pre>{{= toInt(input) }}</code> 或插入上游输出。</span>
                                                <div class="parameter-template-actions">
                                                    <el-button type="text" size="mini" :disabled="editingLocked" @@click="openNodeTemplateEditor(selectedNode,'count',{fieldLabel:'循环次数'})">编辑语法</el-button>
                                                    <el-button type="text" size="mini" :disabled="editingLocked" @@click="resetNodeTemplateManual(selectedNode,'count')">改为固定次数</el-button>
