                                        <button type="button" class="node-port node-output node-output-false" :title="ncfST('Frontend.262')" @@mousedown.stop="beginConnection($event,node,'false')">{{ ncfST('Frontend.172') }}</button>
                                        <button type="button" class="node-port node-output node-output-break" :title="ncfST('Frontend.261')" @@mousedown.stop="beginConnection($event,node,'break')">break</button>
