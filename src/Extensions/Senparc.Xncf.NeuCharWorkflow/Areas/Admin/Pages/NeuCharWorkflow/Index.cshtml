                                        <el-alert title="安全代码节点总会透传原始输入；它只修改 vars 中已声明的变量。相同执行波次内会先按画布顺序执行安全代码，再启动其他独立节点。" type="info" :closable="false"></el-alert>
                                    </template>
                                    <template v-if="selectedNode.type==='aggregate'">
                                        <el-form-item label="汇总输出内容" required>
                                            <template v-if="isTemplateValue(selectedNode.config.outputTemplate)">
                                                <div class="parameter-template-card workflow-rich-text-template-card">
                                                    <div class="parameter-template-summary">{{parameterTemplateSummary(selectedNode.config.outputTemplate)}}</div>
                                                    <div class="parameter-template-actions">
                                                        <el-button type="text" size="mini" :disabled="editingLocked" @@click="openNodeTemplateEditor(selectedNode,'outputTemplate',{fieldLabel:'汇总输出内容',allowBindings:false})">编辑公式文本</el-button>
                                                        <el-button type="text" size="mini" :disabled="editingLocked" @@click="resetNodeTemplateManual(selectedNode,'outputTemplate')">改为手动输入</el-button>
                                                    </div>
                                                </div>
                                            </template>
                                            <workflow-rich-text-input v-else
                                                                      v-model="selectedNode.config.outputTemplate"
                                                                      multiline
                                                                      :rows="4"
                                                                      :disabled="editingLocked"
                                                                      :maxlength="8000"
                                                                      :show-word-limit="true"
                                                                      :help-text="'支持 {{input}} 保留聚合数组，也支持 {{= length(input) }}、{{= join(input, \'，\') }} 等受限公式；不执行任意 JavaScript。'"
                                                                      edit-label="编辑公式"
                                                                      placeholder="例如：共 {{= length(input) }} 项：{{= join(input, '，') }}"
                                                                      @@edit-template="openNodeTemplateEditor(selectedNode,'outputTemplate',{fieldLabel:'汇总输出内容',allowBindings:false})"></workflow-rich-text-input>
                                            <p v-pre class="node-config-help">必须设置。<code>{{input}}</code> 保留聚合数组；<code>{{= length(input) }}</code>、<code>{{= join(input, '，') }}</code> 等为受限表达式，不执行任意 JavaScript。</p>
                                        </el-form-item>
                                        <el-alert title="聚合会等待所有已激活的上游分支结束，再按连线顺序汇总，并只向下游输出一次。" type="info" :closable="false"></el-alert>
                                    </template>
                                    <el-alert v-if="selectedNode.type==='merge'" title="逐项合流不会等待全部输入：每条输入都会独立向下游发出一次。下游按稳定的执行计划顺序串行运行，单次工作流最多处理 5000 次逐项激活。" type="info" :closable="false"></el-alert>
                                    <el-alert v-if="selectedNode.type==='parallel'" title="并行节点将同一输入同时分发到所有后续分支；各分支独立运行。" type="info" :closable="false"></el-alert>
                                    <template v-if="selectedNode.type==='console'">
                                        <el-form-item label="Console 打印内容">
                                            <template v-if="isTemplateValue(selectedNode.config.printTemplate)">
                                                <div class="parameter-template-card workflow-rich-text-template-card">
                                                    <div class="parameter-template-summary">{{parameterTemplateSummary(selectedNode.config.printTemplate)}}</div>
                                                    <div class="parameter-template-tags">
                                                        <el-tag v-for="item in parameterTemplateBindings(selectedNode.config.printTemplate)" :key="item.token" size="mini" :title="templateBindingLabel(item.source)">{{templatePlaceholder(item.token)}}</el-tag>
                                                    </div>
                                                    <div class="parameter-template-actions">
                                                        <el-button type="text" size="mini" :disabled="editingLocked" @@click="openNodeTemplateEditor(selectedNode,'printTemplate',{fieldLabel:'Console 打印内容'})">编辑公式文本</el-button>
                                                        <el-button type="text" size="mini" :disabled="editingLocked" @@click="resetNodeTemplateManual(selectedNode,'printTemplate')">改为手动输入</el-button>
                                                    </div>
                                                </div>
                                            </template>
                                            <workflow-rich-text-input v-else
                                                                      v-model="selectedNode.config.printTemplate"
                                                                      multiline
                                                                      :rows="4"
                                                                      :disabled="editingLocked"
                                                                      :maxlength="8000"
                                                                      :show-word-limit="true"
                                                                      :help-text="'默认 {{input}} 会打印当前输入；也支持受限公式和上游变量。仅影响 Console 展示，不改变下游输入。'"
                                                                      placeholder="默认：{{input}}"
                                                                      @@edit-template="openNodeTemplateEditor(selectedNode,'printTemplate',{fieldLabel:'Console 打印内容'})"></workflow-rich-text-input>
                                            <p v-pre class="node-config-help">默认 <code>{{input}}</code> 打印当前输入。此配置仅影响 Console 展示，节点仍向下游透传原始输入。</p>
                                        </el-form-item>
                                        <el-alert title="运行到此节点时，会按上述模板在页面底部 Console 打印内容；原始输入会继续向下游传递。" type="info" :closable="false"></el-alert>
                                    </template>
                                    <el-alert v-if="selectedNode.type==='neubell'" title="运行时会创建一条 Workflow 纽铃提醒；从 Footer 点击提醒会进入任务列表并按上方设置进行消费。" type="info" :closable="false"></el-alert>
                                </el-form>
                            </template>
                            <div v-else class="inspector-empty">选择画布中的节点进行设置</div>
                        </div>
                    </aside>
                </div>

                <section :class="['workflow-run-dock','run-'+run.status,{expanded:run.consoleOpen}]">
                    <div class="run-status-bar">
                        <span class="run-status-dot"></span>
                        <strong>{{runStatusText}}</strong>
                        <span v-if="run.error" class="run-error">{{run.error}}</span>
                        <el-input v-model="run.input" :disabled="editingLocked" size="small" placeholder="测试输入（传入触发器）"></el-input>
                        <el-button type="primary" size="small" icon="el-icon-video-play" :loading="run.validating || run.running" :disabled="!form.id" @@click="startWorkflow">校验并运行</el-button>
                        <el-button v-if="run.running" type="danger" size="small" plain icon="el-icon-circle-close" :loading="run.aborting" @@click="abortWorkflow">中止</el-button>
                        <el-button type="text" size="small" :icon="run.consoleOpen?'el-icon-arrow-down':'el-icon-arrow-up'" @@click="run.consoleOpen=!run.consoleOpen">Console</el-button>
                    </div>
                    <div v-if="run.humanInteractions.length" class="workflow-human-quick-panel">
                        <div class="workflow-human-quick-copy">
                            <i class="el-icon-user-solid"></i>
                            <span><strong>Workflow 等待 Human</strong> · {{run.humanInteractions.length}} 个待处理请求</span>
                            <small v-if="run.humanInteractions[0].prompt">{{run.humanInteractions[0].prompt}}</small>
                        </div>
                        <el-button type="warning" size="small" plain @@click="openHumanInteraction(run.humanInteractions[0])">快速处理</el-button>
                    </div>
                    <el-dialog title="Workflow Human-in-the-Loop"
                               :visible.sync="run.humanReplyVisible"
                               width="560px"
                               append-to-body
                               @@close="closeHumanInteractionDialog">
                        <template v-if="run.humanReplyRequest">
                            <el-alert v-if="requiresHumanTextInput(run.humanReplyRequest)"
                                      title="当前轮次需要 Human 输入，提交后 Workflow 会继续等待或向下执行。"
                                      type="info"
                                      :closable="false"
                                      show-icon></el-alert>
                            <el-alert v-else
                                      title="Agent 请求执行工具，请确认是否允许本次调用。"
                                      type="warning"
                                      :closable="false"
                                      show-icon></el-alert>
                            <p class="workflow-human-prompt">{{run.humanReplyRequest.prompt}}</p>
                            <pre v-if="run.humanReplyRequest.toolArguments" class="workflow-human-tool-arguments">{{run.humanReplyRequest.toolArguments}}</pre>
                            <el-input v-if="requiresHumanTextInput(run.humanReplyRequest)"
                                      v-model="run.humanReplyInput"
                                      type="textarea"
                                      :rows="5"
                                      maxlength="8000"
                                      show-word-limit
                                      placeholder="输入 Human 回复"></el-input>
                        </template>
                        <span slot="footer" class="dialog-footer">
                            <el-button @@click="closeHumanInteractionDialog">稍后处理</el-button>
                            <el-button v-if="run.humanReplyRequest && !requiresHumanTextInput(run.humanReplyRequest)"
                                       type="danger"
                                       plain
                                       :loading="run.humanReplySubmitting"
                                       @@click="resolveHumanInteraction(false)">拒绝</el-button>
                            <el-button type="primary"
                                       :loading="run.humanReplySubmitting"
                                       @@click="resolveHumanInteraction(true)">{{run.humanReplyRequest && requiresHumanTextInput(run.humanReplyRequest)?'提交并继续':'同意并继续'}}</el-button>
                        </span>
                    </el-dialog>
                    <div v-show="run.consoleOpen" class="workflow-console">
                        <div class="console-toolbar">
                            <span>执行 Console · {{run.events.length}} 条</span>
                            <el-button type="text" size="mini" :disabled="run.running" @@click="clearConsole">清空</el-button>
                        </div>
                        <div ref="consoleLog" class="console-log">
                            <div v-for="(event,index) in run.events" :key="event.sequence+'-'+index" :class="['console-line','console-'+event.status]">
                                <time>{{event.timestamp ? event.timestamp.substring(11,19) : '--:--:--'}}</time>
                                <strong>{{event.nodeName || 'Workflow'}}</strong>
                                <span>{{event.message}}</span>
                                <pre v-if="event.output">{{event.output}}</pre>
                            </div>
                            <div v-if="!run.events.length" class="console-empty">运行后，这里会显示校验结果、当前节点、执行状态和 Console 节点输出。</div>
                        </div>
                    </div>
                </section>
            </template>
            <div v-else class="neuchar-empty">
                <i class="fa fa-random fa-3x"></i>
                <h3>选择或创建一个工作流</h3>
                <p>从触发器开始添加节点；节点支持拖动排版、拖拽端口连线以及上游 Output 参数关联。</p>
            </div>
        </main>
    </div>
</div>

@section scripts {
    @* Keep this template outside the shared #app Vue root. Otherwise the root compiler
       evaluates its v-for variables (such as fn) in the page scope before the child
       component receives the template. *@
    <script type="text/x-template" id="workflow-node-picker-template">
        <div class="workflow-node-picker" :class="{'is-edge-insert':edgeInsert}">
            <div class="workflow-node-picker-filters">
                <el-input v-model="keyword" size="small" clearable prefix-icon="el-icon-search" placeholder="搜索节点、Function、模块或对象"></el-input>
                <el-select v-model="module" size="small" clearable filterable placeholder="全部模块">
                    <el-option v-for="name in moduleNames" :key="name" :label="name" :value="name"></el-option>
                </el-select>
            </div>

            <template v-if="filteredSystemNodes.length">
                <el-divider>系统节点</el-divider>
                <div class="palette-system-grid">
                    <el-button v-for="node in filteredSystemNodes" :key="node.type" plain :icon="node.icon" :class="['node-picker-system-button','node-picker-'+node.type]" :disabled="locked || (edgeInsert && node.type === 'end')" :title="edgeInsert && node.type === 'end'?'结束节点不能插入到连线中':''" draggable="true" @@dragstart.native="startSystemDrag($event,node)" @@dragend.native="finishDrag" @@mouseenter.native="previewSystem(node,'hover',$event)" @@mouseleave.native="hideSystemPreview(node)" @@click="previewSystem(node,'click',$event)" @@dblclick.native="selectSystem(node)">{{node.label}}</el-button>
                </div>
            </template>

            <template v-if="filteredFunctions.length">
                <el-divider>NeuCharPivot Function</el-divider>
                <div class="palette-functions">
                <button v-for="fn in filteredFunctions"
                        :key="functionIdentity(fn)"
                        :class="['palette-item','node-picker-function',{'is-unavailable':!fn.moduleAvailable}]"
                        :disabled="locked"
                        draggable="true"
                        @@dragstart="startFunctionDrag($event,fn)"
                        @@dragend="finishDrag"
                        @@mouseenter="previewNode('function',fn,'hover',$event)"
                        @@mouseleave="hideNodePreview('function',fn)"
                        @@click="previewNode('function',fn,'click',$event)"
                        @@dblclick="selectFunction(fn)">
                    <span class="palette-item-copy">
                        <strong>{{fn.functionName}}</strong>
                        <small>{{fn.moduleName}} · {{fn.moduleAvailable?'可用':'模块未安装或未开启'}}</small>
                        <small v-if="fn.catalogError" class="palette-error">参数元数据读取失败，已保留 Function</small>
                    </span>
                    <span role="button"
                          :class="['palette-pin',{active:isPinned(fn)}]"
                          :title="isPinned(fn)?'取消置顶':'置顶'"
                          @@click.stop="$emit('toggle-pin', fn)">
                        <i :class="isPinned(fn)?'el-icon-star-on':'el-icon-star-off'"></i>
                    </span>
                </button>
                </div>
            </template>

            <template v-if="filteredObjects.length">
                <el-divider>AgentsManager / A2A</el-divider>
                <button v-for="object in filteredObjects"
                        :key="object.providerId+object.objectId"
                        :class="['palette-item','node-picker-'+object.kind,{'is-a2a-object':object.kind==='a2a','is-unavailable':!object.enabled}]"
                        :disabled="locked"
                        draggable="true"
                        @@dragstart="startObjectDrag($event,object)"
                        @@dragend="finishDrag"
                        @@mouseenter="previewNode('object',object,'hover',$event)"
                        @@mouseleave="hideNodePreview('object',object)"
                        @@click="previewNode('object',object,'click',$event)"
                        @@dblclick="selectObject(object)">
                    <span class="palette-item-copy">
                        <strong>{{object.name}}</strong>
                        <small>{{objectKindLabel(object)}} · {{object.enabled?'可用':'不可用'}}</small>
                    </span>
                    <el-tag v-if="object.kind==='a2a'" size="mini" type="warning" effect="plain">A2A</el-tag>
                </button>
            </template>
            <div v-if="!filteredSystemNodes.length && !filteredFunctions.length && !filteredObjects.length" class="palette-empty">没有匹配的节点</div>
        </div>
    </script>
    <script src="~/js/NeuCharWorkflow/common.js"></script>
    <script src="~/js/NeuCharWorkflow/Workflow.js"></script>
}
