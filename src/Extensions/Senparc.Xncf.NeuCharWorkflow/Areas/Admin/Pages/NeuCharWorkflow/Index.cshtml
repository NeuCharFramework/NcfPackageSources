@page
@model Senparc.Xncf.NeuCharWorkflow.Areas.NeuCharWorkflow.Pages.IndexModel
@using Microsoft.Extensions.Localization
@using Senparc.Xncf.NeuCharWorkflow
@inject IStringLocalizer<NeuCharWorkflowResource> XR
@{
    ViewData["Title"] = XR["Title.Designer"];
    Layout = "_Layout_Vue";
}

@section breadcrumbs {
    <el-breadcrumb-item>@XR["Module.MenuName"]</el-breadcrumb-item>
    <el-breadcrumb-item>@XR["Area.Workflow"]</el-breadcrumb-item>
}

@section Style {
    <link rel="stylesheet" href="~/css/NeuCharWorkflow/common.css" />
    <link rel="stylesheet" href="~/css/NeuCharWorkflow/Workflow.css" />
}

<div class="neuchar-page workflow-page" v-loading="loading">
    <transition name="workflow-node-preview-fade">
        <section v-if="nodePreview.visible"
                 :class="['workflow-node-preview', {'is-hover-preview':nodePreview.mode==='hover'}]"
                 :style="nodePreviewStyle"
                 @@mousedown.stop
                 @@click.stop>
            <header>
                <span class="workflow-node-preview-kind">{{nodePreviewDetails.kind}}</span>
                <el-button type="text" icon="el-icon-close" :title="ncfST('Frontend.179')" :aria-label="ncfST('Frontend.179')" @@click="dismissNodePreview"></el-button>
            </header>
            <h2>{{nodePreviewDetails.title}}</h2>
            <p v-if="nodePreviewDetails.description" class="workflow-node-preview-description">{{nodePreviewDetails.description}}</p>
            <dl v-if="nodePreviewDetails.rows.length" class="workflow-node-preview-details">
                <div v-for="row in nodePreviewDetails.rows" :key="row.label+row.value">
                    <dt>{{row.label}}</dt>
                    <dd :title="row.value">{{row.value}}</dd>
                </div>
            </dl>
            <footer>
                <span>{{nodePreview.mode==='click'?ncfST('Frontend.493'):ncfST('Frontend.492')}}</span>
                <strong>{{nodePreviewDetails.actionText}}</strong>
            </footer>
        </section>
    </transition>
    <div :class="['workflow-shell',shellClasses]">
        <aside class="workflow-list-pane">
            <div class="workflow-list-heading">
                <strong v-show="!listCollapsed">{{ ncfST('Frontend.011') }}</strong>
                <span v-show="!listCollapsed" class="workflow-list-actions">
                    <el-button type="text"
                               icon="el-icon-refresh"
                               :title="ncfST('Frontend.186')"
                               :aria-label="ncfST('Frontend.186')"
                               :disabled="editingLocked"
                               @@click="refreshWorkflowList"></el-button>
                    <el-button type="primary"
                               plain
                               size="mini"
                               icon="el-icon-plus"
                               :title="ncfST('Frontend.280')"
                               :aria-label="ncfST('Frontend.280')"
                               :disabled="editingLocked"
                               @@click="createWorkflow"></el-button>
                </span>
                <el-button type="text"
                           :icon="listCollapsed?'el-icon-s-unfold':'el-icon-s-fold'"
                           :title="listCollapsed?ncfST('Frontend.186'):ncfST('Frontend.480')"
                           @@click="listCollapsed=!listCollapsed"></el-button>
            </div>
            <template v-if="!listCollapsed">
                        <el-input v-model="keyword" size="small" clearable prefix-icon="el-icon-search" :placeholder="ncfST('Frontend.272')"></el-input>
                <div v-if="filteredWorkflows.length" class="workflow-list">
                    <button v-for="item in filteredWorkflows"
                            :key="item.id"
                            :class="['workflow-list-item',{active: form.id===item.id}]"
                            :disabled="editingLocked"
                            @@click="editWorkflow(item.id)">
                        <span class="workflow-list-name" :title="item.name">{{item.name}}</span>
                        <span class="workflow-list-badges">
                            <el-tag size="mini" effect="plain" :type="workflowTriggerTagType(item)">{{workflowTriggerLabel(item)}}</el-tag>
                            <el-tag size="mini" :type="item.enabled?'success':'info'">{{item.enabled ? ncfST('Frontend.044') : ncfST('Frontend.606') }}</el-tag>
                        </span>
                        <small :class="{'workflow-next-run':isIntervalWorkflow(item)}"
                               :title="workflowScheduleTitle(item)">
                            <i v-if="isIntervalWorkflow(item)" class="el-icon-time"></i>
                            {{isIntervalWorkflow(item) ? workflowScheduleText(item) : `Revision ${item.revision}`}}
                        </small>
                    </button>
                </div>
                <div v-else class="workflow-list-empty">{{ ncfST('Frontend.282') }}</div>
            </template>
        </aside>

        <main class="workflow-editor">
            <template v-if="editing">
                <div class="workflow-command-bar">
                    <div class="workflow-command-identity">
                        <el-input v-model="form.name" size="small" :disabled="editingLocked" maxlength="200" :placeholder="ncfST('Frontend.225')"></el-input>
                        <el-tag size="mini" effect="plain">{{form.triggerType==='webhook'?ncfST('Frontend.470'):(form.triggerType==='interval'?ncfST('Frontend.471'):(form.triggerType==='chat'?ncfST('Frontend.132'):ncfST('Frontend.248')))}}</el-tag>
                        <span :class="['workflow-save-status',{'is-dirty':saveDirty,'is-error':saveState.status==='error'}]" :title="saveStatusText">{{saveStatusText}}</span>
                    </div>
                    <div class="workflow-command-actions" :aria-label="ncfST('Frontend.480')">
                        <el-button type="primary"
                                   size="small"
                                   icon="el-icon-check"
                                   :loading="saveState.saving"
                                   :disabled="editingLocked || (form.id && !saveDirty)"
                                   :title="ncfST('Frontend.170')"
                                   @@click="saveWorkflow({source:'manual'})">{{ ncfST('Frontend.166') }}</el-button>
                        <el-button size="small"
                                   icon="el-icon-video-play"
                                   :disabled="!form.id || editingLocked || disconnectedNodes.length>0"
                                   :title="disconnectedNodes.length?ncfST('Frontend.457'):ncfST('Frontend.292')"
                                   @@click="startWorkflow">{{ ncfST('Frontend.292') }}</el-button>
                        <el-button v-if="form.id"
                                   size="small"
                                   icon="el-icon-tickets"
                                   @@click="openWorkflowTasks">{{ ncfST('Frontend.070') }}</el-button>
                        <el-button v-if="form.id && form.triggerType==='chat'"
                                   size="small"
                                   icon="el-icon-chat-dot-round"
                                   :title="ncfST('Frontend.254')"
                                   @@click="openChatPage">{{ ncfST('Frontend.334') }}</el-button>
                        <el-button v-if="form.id"
                                   size="small"
                                   icon="el-icon-data-analysis"
                                   @@click="openWorkflowAnalytics">{{ ncfST('Frontend.031') }}</el-button>
                        <el-dropdown v-if="form.id" size="small" @@command="exportWorkflow">
                            <el-button size="small" icon="el-icon-download">{{ ncfST('Frontend.055') }}<i class="el-icon-arrow-down el-icon--right"></i></el-button>
                            <el-dropdown-menu slot="dropdown">
                                <el-dropdown-item command="json">JSON</el-dropdown-item>
                                <el-dropdown-item command="yaml">YAML</el-dropdown-item>
                            </el-dropdown-menu>
                        </el-dropdown>
                        <el-button size="small" icon="el-icon-upload2" :disabled="editingLocked" @@click="chooseWorkflowImport">{{ ncfST('Frontend.054') }}</el-button>
                        <input ref="workflowImportInput" type="file" accept=".json,.yaml,.yml,application/json,application/yaml,text/yaml" style="display:none" @@change="importWorkflowFile">
                        <el-button v-if="form.id"
                                   size="small"
                                   type="warning"
                                   plain
                                   icon="el-icon-loading"
                                   :title="ncfST('Frontend.070')"
                                   @@click="openWorkflowTasks('running')">{{ ncfST('Frontend.077') }} {{form.runningCount}}</el-button>
                        <el-button v-if="run.running"
                                   size="small"
                                   type="danger"
                                   plain
                                   icon="el-icon-circle-close"
                                   :loading="run.aborting"
                                   @@click="abortWorkflow">{{ ncfST('Frontend.509') }}</el-button>
                        <el-button size="small"
                                   plain
                                   icon="el-icon-plus"
                                   :disabled="editingLocked"
                                   :title="ncfST('Frontend.256')"
                                   @@click="paletteCollapsed=false">{{ ncfST('Frontend.305') }}</el-button>
                        <el-dropdown trigger="click" @@command="handleWorkflowAction">
                            <el-button size="small" plain icon="el-icon-more" :title="ncfST('Frontend.283')" :aria-label="ncfST('Frontend.283')"></el-button>
                            <el-dropdown-menu slot="dropdown">
                                <el-dropdown-item command="new" :disabled="editingLocked || saveState.saving">
                                    <i class="el-icon-plus"></i> {{ ncfST('Frontend.280') }}
                                </el-dropdown-item>
                                <el-dropdown-item command="settings" :disabled="editingLocked">
                                    <i class="el-icon-setting"></i> {{ ncfST('Frontend.481') }}
                                </el-dropdown-item>
                                <el-dropdown-item command="auto-layout" :disabled="editingLocked">
                                    <i class="el-icon-magic-stick"></i> {{ ncfST('Frontend.266') }}
                                </el-dropdown-item>
                                <el-dropdown-item command="align-grid" :disabled="editingLocked">
                                    <i class="el-icon-s-grid"></i> {{ ncfST('Frontend.221') }}
                                </el-dropdown-item>
                                <el-dropdown-item command="fit-canvas">
                                    <i class="el-icon-full-screen"></i> {{ ncfST('Frontend.363') }}
                                </el-dropdown-item>
                                <el-dropdown-item command="tasks">
                                    <i class="el-icon-document"></i> {{ ncfST('Frontend.070') }}
                                </el-dropdown-item>
                                <el-dropdown-item v-if="form.id" command="delete" divided :disabled="editingLocked">
                                    <i class="el-icon-delete"></i> {{ ncfST('Frontend.026') }}
                                </el-dropdown-item>
                            </el-dropdown-menu>
                        </el-dropdown>
                    </div>
                </div>

                <section v-if="validationIssues.length" class="workflow-validation-panel" role="alert" aria-live="assertive">
                    <div class="workflow-validation-panel-header">
                            <strong><i class="el-icon-warning"></i> {{ ncfST('Frontend.340') }}</strong>
                        <el-button type="text" size="mini" @@click="clearValidationIssue">{{ ncfST('Frontend.034') }}</el-button>
                    </div>
                    <button v-for="issue in validationIssues"
                            :key="(issue.nodeId || 'workflow') + '-' + issue.message"
                            type="button"
                            class="workflow-validation-item"
                            :disabled="!issue.nodeId"
                            @@click="focusValidationIssue(issue)">
                        <span class="workflow-validation-item-node">{{issue.label}}</span>
                        <span class="workflow-validation-item-message">{{issue.message}}</span>
                        <i v-if="issue.nodeId" class="el-icon-right"></i>
                    </button>
                </section>

                <el-dialog :title="ncfST('Frontend.481')"
                           :visible.sync="workflowSettingsVisible"
                           :close-on-click-modal="false"
                           width="min(720px, calc(100vw - 32px))"
                           append-to-body>
                    <el-form label-position="top" size="small" :class="{'form-locked':editingLocked}">
                        <el-form-item :label="ncfST('Frontend.346')">
                            <el-input v-model="form.description" :disabled="editingLocked" :placeholder="ncfST('Frontend.312')"></el-input>
                        </el-form-item>
                        <div class="workflow-settings-grid">
                            <el-form-item :label="ncfST('Frontend.343')">
                                <el-select v-model="form.triggerType" :disabled="editingLocked" @@change="syncTriggerNode">
                                    <el-option :label="ncfST('Frontend.248')" value="manual"></el-option>
                                    <el-option :label="ncfST('Frontend.373')" value="interval"></el-option>
                                    <el-option label="Webhook" value="webhook"></el-option>
                                    <el-option :label="ncfST('Frontend.132')" value="chat"></el-option>
                                </el-select>
                            </el-form-item>
                            <el-form-item v-if="form.triggerType==='interval'" :label="ncfST('Frontend.372')">
                                <el-input-number v-model="form.intervalSeconds" :disabled="editingLocked" :min="60" :max="31536000" :step="60"></el-input-number>
                            </el-form-item>
                            <el-form-item :label="ncfST('Frontend.359')">
                                <el-switch v-model="form.enabled" :disabled="editingLocked" :active-text="ncfST('Frontend.650')"></el-switch>
                            </el-form-item>
                            <el-form-item :label="ncfST('Frontend.336')" :title="ncfST('Frontend.196')">
                                <div class="workflow-auto-save">
                                    <el-switch :value="form.autoSaveMinutes>0"
                                               :disabled="editingLocked || saveState.saving"
                                               :active-text="ncfST('Frontend.336')"
                                               @@change="setAutoSaveEnabled"></el-switch>
                                    <el-input-number v-if="form.autoSaveMinutes>0"
                                                     v-model="form.autoSaveMinutes"
                                                     :disabled="editingLocked || saveState.saving"
                                                     :min="1"
                                                     :max="1440"
                                                     :step="1"
                                                     :precision="0"
                                                     controls-position="right"></el-input-number>
                                <span v-if="form.autoSaveMinutes>0">{{ ncfST('Frontend.181') }}</span>
                                </div>
                            </el-form-item>
                            <el-form-item :label="ncfST('Frontend.338')" :title="ncfST('Frontend.236')">
                                <el-radio-group v-model="form.graph.layout.direction" :disabled="editingLocked">
                                    <el-radio-button label="vertical">Vertical</el-radio-button>
                                    <el-radio-button label="horizontal">Horizontal</el-radio-button>
                                </el-radio-group>
                            </el-form-item>
                            <el-form-item :label="ncfST('Frontend.315')">
                                <div class="workflow-layout-actions">
                                    <el-button size="small"
                                               icon="el-icon-magic-stick"
                                               :disabled="editingLocked"
                                               @@click="autoLayout()">{{ ncfST('Frontend.265') }}</el-button>
                                    <el-button size="small"
                                               icon="el-icon-s-grid"
                                               :disabled="editingLocked"
                                               @@click="alignToNearbyGrid()">{{ ncfST('Frontend.221') }}</el-button>
                                </div>
                                <p class="workflow-layout-help">{{ ncfST('Frontend.222') }}</p>
                            </el-form-item>
                        </div>

                        <section class="workflow-variable-settings">
                            <div class="workflow-variable-settings-heading">
                                <div>
                                    <strong>{{ ncfST('Frontend.224') }}</strong>
                                    <p>{{ ncfST('Frontend.208') }} <code v-pre>{{= vars.variableName }}</code> {{ ncfST('Frontend.351') }}</p>
                                </div>
                                <el-button size="small"
                                           icon="el-icon-plus"
                                           :disabled="editingLocked || form.graph.variables.length>=30"
                                           @@click="addWorkflowVariable">{{ ncfST('Frontend.304') }}</el-button>
                            </div>
                            <el-alert :title="ncfST('Frontend.194')"
                                      type="info"
                                      :closable="false"></el-alert>
                            <div v-if="form.graph.variables.length" class="workflow-variable-list">
                                <div v-for="(variable,index) in form.graph.variables" :key="'workflow-variable-'+index" class="workflow-variable-row">
                                    <el-input v-model="variable.name"
                                              :disabled="editingLocked"
                                              maxlength="64"
                                              :placeholder="ncfST('Frontend.195')"></el-input>
                                    <workflow-rich-text-input v-model="variable.value"
                                                              multiline
                                                              :rows="2"
                                                              :disabled="editingLocked"
                                                              :editable="false"
                                                              :maxlength="8000"
                                                              :help-text="ncfST('Frontend.194')"></workflow-rich-text-input>
                                    <el-button type="text"
                                               class="workflow-variable-remove"
                                               :disabled="editingLocked"
                                               @@click="removeWorkflowVariable(index)">{{ ncfST('Frontend.026') }}</el-button>
                                </div>
                            </div>
                            <p v-else class="workflow-variable-empty">{{ ncfST('Frontend.219') }}</p>
                        </section>

                        <div v-if="form.triggerType==='webhook'" class="workflow-webhook-config">
                            <div class="webhook-config-heading">
                                <strong>{{ ncfST('Frontend.146') }}</strong>
                                <el-button type="text" size="mini" icon="el-icon-question" @@click="webhookHelpVisible=true">{{ ncfST('Frontend.162') }}</el-button>
                            </div>
                            <div class="webhook-config-row">
                                <label>{{ ncfST('Frontend.350') }}</label>
                                <el-select v-model="form.webhookMethod" :disabled="editingLocked" size="small">
                                    <el-option :label="ncfST('Frontend.151')" value="any"></el-option>
                                    <el-option label="GET" value="get"></el-option>
                                    <el-option label="POST" value="post"></el-option>
                                </el-select>
                                <label>{{ ncfST('Frontend.345') }}</label>
                                <el-input v-model="form.webhookToken" size="small" readonly :placeholder="ncfST('Frontend.169')">
                                    <el-button slot="append" icon="el-icon-document-copy" :title="ncfST('Frontend.211')" @@click="copyText(form.webhookToken)"></el-button>
                                </el-input>
                                <el-button size="small" icon="el-icon-document-copy" :disabled="!form.id" @@click="copyText(webhookUrl)">{{ ncfST('Frontend.210') }}</el-button>
                            </div>
                            <div class="webhook-parameters-heading">
                                <span>{{ ncfST('Frontend.381', form.webhookParameters.length) }}</span>
                                <el-button type="text" size="small" :disabled="editingLocked || form.webhookParameters.length>=50" @@click="addWebhookParameter">{{ ncfST('Frontend.303') }}</el-button>
                            </div>
                            <div v-if="form.webhookParameters.length" class="webhook-parameters">
                                <div v-for="(parameter,index) in form.webhookParameters" :key="parameter._id" class="webhook-parameter-row">
                                    <el-input v-model="parameter.name" size="small" :placeholder="ncfST('Frontend.190')" :disabled="editingLocked"></el-input>
                                    <el-checkbox v-model="parameter.required" :disabled="editingLocked">{{ ncfST('Frontend.239') }}</el-checkbox>
                                    <el-input v-model="parameter.description" size="small" :placeholder="ncfST('Frontend.347')" :disabled="editingLocked"></el-input>
                                    <el-button type="text" class="webhook-parameter-remove" :disabled="editingLocked" @@click="removeWebhookParameter(index)">{{ ncfST('Frontend.183') }}</el-button>
                                </div>
                            </div>
                            <div v-else class="webhook-parameters-empty">{{ ncfST('Frontend.287') }}</div>
                        </div>

                        <div v-if="form.triggerType==='chat'" class="workflow-webhook-config workflow-chat-config">
                            <div class="webhook-config-heading">
                                <strong>{{ ncfST('Frontend.133') }}</strong>
                            </div>
                            <div class="webhook-config-row">
                                <label>{{ ncfST('Frontend.373') }}</label>
                                <el-input v-model="form.chatTitle" :disabled="editingLocked" size="small" maxlength="100" :placeholder="ncfST('Frontend.316')"></el-input>
                                <el-checkbox v-model="form.chatAllowGuest" :disabled="editingLocked">{{ ncfST('Frontend.174') }}</el-checkbox>
                            </div>
                            <div class="webhook-config-row">
                                <label>{{ ncfST('Frontend.297') }}</label>
                                <el-input v-model="form.chatGreeting" :disabled="editingLocked" size="small" type="textarea" :rows="2" maxlength="500" :placeholder="ncfST('Frontend.375')"></el-input>
                            </div>
                            <div class="webhook-config-row">
                                <label>{{ ncfST('Frontend.334') }}</label>
                                <el-input v-model="chatUrl" size="small" readonly :placeholder="ncfST('Frontend.168')"></el-input>
                                <el-button size="small" icon="el-icon-document-copy" :disabled="!form.id" @@click="copyText(chatUrl,'Chat')">{{ ncfST('Frontend.210') }}</el-button>
                                <el-button size="small" type="primary" plain icon="el-icon-chat-dot-round" :disabled="!form.id" @@click="openChatPage">{{ ncfST('Frontend.178') }}</el-button>
                            </div>
                            <div class="webhook-parameters-empty">{{ ncfST('Frontend.314') }}</div>
                        </div>
                    </el-form>
                    <span slot="footer" class="dialog-footer">
                        <el-button @@click="workflowSettingsVisible=false">{{ ncfST('Frontend.178') }}</el-button>
                    </span>
                </el-dialog>

                <el-dialog :title="ncfST('Frontend.145')"
                           :visible.sync="webhookHelpVisible"
                           width="min(620px, calc(100vw - 32px))"
                           append-to-body>
                    <div class="workflow-webhook-help">
                        <p>{{ ncfST('Frontend.175') }}</p>
                        <template v-if="form.id">
                            <p>{{ ncfST('Frontend.352') }}<code>{{webhookUrl}}</code></p>
                            <p>{{ ncfST('Frontend.160') }} <code>X-NeuChar-Webhook-Token</code></p>
                        </template>
                        <p>{{ ncfST('Frontend.229') }}</p>
                    </div>
                    <span slot="footer" class="dialog-footer">
                        <el-button @@click="webhookHelpVisible=false">{{ ncfST('Frontend.178') }}</el-button>
                    </span>
                </el-dialog>

                <el-dialog :title="templateEditorTitle"
                           :visible.sync="templateEditor.visible"
                           :close-on-click-modal="false"
                           :close-on-press-escape="false"
                           @@mousedown.native.stop
                           @@mouseup.native.stop
                           width="min(760px, calc(100vw - 32px))"
                           append-to-body>
                    <p class="template-editor-help">{{ ncfST('Frontend.176') }}</p>
                    <el-alert :title="templateExpressionHelp"
                              type="warning"
                              :closable="false"
                              show-icon></el-alert>
                    <div class="template-editor-layout">
                        <div class="template-editor-main">
                            <el-input ref="templateEditorInput"
                                      v-model="templateEditor.text"
                                      type="textarea"
                                      :rows="12"
                                      :disabled="editingLocked"
                                      :placeholder="templateEditorPlaceholder"
                                      @@input="captureTemplateSelection"
                                      @@click.native="captureTemplateSelection"
                                      @@keyup.native="captureTemplateSelection"
                                      @@select.native="captureTemplateSelection"></el-input>
                            <div v-if="templateEditor.allowBindings" class="template-editor-picker">
                        <span>{{ ncfST('Frontend.271') }}</span>
                        <el-cascader :value="templateEditor.pendingSelection"
                                     :options="upstreamOutputOptions(null)"
                                     :disabled="editingLocked || !upstreamOutputOptions(null).length"
                                     :props="{expandTrigger:'hover'}"
                                     clearable
                                     filterable
                                     :placeholder="ncfST('Frontend.368')"
                                     @@change="appendTemplateBinding"></el-cascader>
                    </div>
                    <div v-if="templateEditor.allowBindings && templateEditor.bindings.length" class="template-binding-tags">
                        <div v-for="item in templateEditor.bindings" :key="item.token" class="template-binding-item">
                            <el-tag :disable-transitions="true"
                                    :title="templateBindingLabel(item.source)"
                                    :closable="!editingLocked"
                                    @@close="removeTemplateBinding(item.token)">
                                {{templatePlaceholder(item.token)}} · {{templateBindingLabel(item.source)}}
                            </el-tag>
                            <el-input-number v-if="item.source.requiresIndex"
                                             v-model="item.source.collectionIndex"
                                             :disabled="editingLocked"
                                             :min="0"
                                             :step="1"
                                             size="mini"
                                             controls-position="right"
                                             :placeholder="ncfST('Frontend.182')"></el-input-number>
                        </div>
                    </div>
                    <el-alert :title="templateEditorBindingHelpText"
                              type="info"
                              :closable="false"
                              show-icon></el-alert>
                        </div>
                        <aside class="template-editor-formulas">
                            <div class="template-editor-formulas-heading">
                                <strong>{{ ncfST('Frontend.273') }}</strong>
                                <small>{{ ncfST('Frontend.310') }}</small>
                            </div>
                            <div v-for="group in templateEditorFormulaGroups" :key="group.category" class="template-editor-formula-group">
                                <span class="template-editor-formula-category">{{group.category}}</span>
                                <el-tooltip v-for="formula in group.items"
                                            :key="formula.name"
                                            effect="dark"
                                            placement="left"
                                            :content="formula.description">
                                    <button type="button"
                                            class="template-editor-formula-button"
                                            :disabled="editingLocked"
