                                            <p class="node-config-help">{{ ncfST('Frontend.197') }}</p>
                                        </el-form-item>
                                        <el-form-item :label="ncfST('Frontend.159')">
                                            <workflow-rich-text-input v-model="selectedNode.config.prompt"
                                                                      multiline
                                                                      :rows="4"
                                                                      :disabled="editingLocked"
                                                                      :help-text="ncfST('Frontend.612')"
                                                                      placeholder="{{input}}"
                                                                      @@edit-template="openNodeTemplateEditor(selectedNode,'prompt',{fieldLabel:ncfST('Frontend.159')})"></workflow-rich-text-input>
                                            <el-cascader :value="configBindingSelection(selectedNode,'prompt')" :options="upstreamOutputOptions(null)" :disabled="editingLocked || !upstreamOutputOptions(null).length" clearable filterable :placeholder="ncfST('Frontend.177')" @@change="setConfigBinding(selectedNode,'prompt',$event)"></el-cascader>
                                        </el-form-item>
                                        <el-alert :title="ncfST('Frontend.214')" type="info" :closable="false"></el-alert>
                                    </template>
                                    <template v-if="selectedNode.type==='code'">
                                        <el-form-item :label="ncfST('Frontend.477')" required>
                                            <p class="node-config-help">{{ ncfST('Frontend.360') }} <code v-pre>{{input}}</code>、<code v-pre>{{= vars.variableName }}</code> {{ ncfST('Frontend.205') }}</p>
                                            <div v-if="selectedNode.config.assignments && selectedNode.config.assignments.length" class="workflow-code-assignments">
                                                <div v-for="(assignment,index) in selectedNode.config.assignments" :key="'code-assignment-'+index" class="workflow-code-assignment-row">
                                                    <el-select v-model="assignment.name"
                                                               :disabled="editingLocked"
                                                               filterable
                                                               :placeholder="ncfST('Frontend.364')">
                                                        <el-option v-for="variable in form.graph.variables"
                                                                   :key="variable.name || ('variable-'+index)"
                                                                   :label="variable.name || ncfST('Frontend.674')"
                                                                   :value="variable.name"
                                                                   :disabled="!variable.name"></el-option>
                                                    </el-select>
                                                    <workflow-rich-text-input :value="formulaValueText(assignment.value)"
                                                                              @@input="setCodeAssignmentValue(assignment,$event)"
                                                                              multiline
                                                                              :rows="2"
                                                                              :disabled="editingLocked"
                                                                              :editable="true"
                                                                              :maxlength="8000"
                                                                              :edit-label="ncfST('Frontend.328')"
                                                                              :help-text="ncfST('Frontend.675')"
                                                                              @@edit-template="openCodeAssignmentTemplateEditor(selectedNode,index)"></workflow-rich-text-input>
                                                    <el-button type="text"
                                                               :disabled="editingLocked"
                                                                              @@click="removeCodeAssignment(selectedNode,index)">{{ ncfST('Frontend.183') }}</el-button>
                                                </div>
                                            </div>
                                            <p v-else class="workflow-variable-empty">{{ ncfST('Frontend.220') }}</p>
                                            <el-button size="small"
                                                       icon="el-icon-plus"
                                                       :disabled="editingLocked || !form.graph.variables.length || (selectedNode.config.assignments || []).length>=30"
                                                       @@click="addCodeAssignment(selectedNode)">{{ ncfST('Frontend.306') }}</el-button>
                                        </el-form-item>
                                        <el-alert :title="ncfST('Frontend.215')" type="info" :closable="false"></el-alert>
                                    </template>
                                    <template v-if="selectedNode.type==='aggregate'">
                                        <el-form-item :label="ncfST('Frontend.299')" required>
                                            <template v-if="isTemplateValue(selectedNode.config.outputTemplate)">
                                                <div class="parameter-template-card workflow-rich-text-template-card">
                                                    <div class="parameter-template-summary">{{parameterTemplateSummary(selectedNode.config.outputTemplate)}}</div>
                                                    <div class="parameter-template-actions">
                                                        <el-button type="text" size="mini" :disabled="editingLocked" @@click="openNodeTemplateEditor(selectedNode,'outputTemplate',{fieldLabel:ncfST('Frontend.299'),allowBindings:false})">{{ ncfST('Frontend.329') }}</el-button>
                                                        <el-button type="text" size="mini" :disabled="editingLocked" @@click="resetNodeTemplateManual(selectedNode,'outputTemplate')">{{ ncfST('Frontend.275') }}</el-button>
                                                    </div>
                                                </div>
                                            </template>
                                            <workflow-rich-text-input v-else
                                                                      v-model="selectedNode.config.outputTemplate"
                                                                      multiline
                                                                      :rows="4"
                                                                      :disabled="editingLocked"
                                                                      :maxlength="8000"
                                                                      :show-word-limit="true"
                                                                      :help-text="ncfST('Frontend.320')"
                                                                      :edit-label="ncfST('Frontend.328')"
                                                                      :placeholder="ncfST('Frontend.388')"
                                                                      @@edit-template="openNodeTemplateEditor(selectedNode,'outputTemplate',{fieldLabel:ncfST('Frontend.299'),allowBindings:false})"></workflow-rich-text-input>
                                            <p v-pre class="node-config-help">{{ ncfST('Frontend.240') }} <code>{{input}}</code> {{ ncfST('Frontend.171') }} <code>{{= length(input) }}</code>、<code>{{= join(input, '，') }}</code> {{ ncfST('Frontend.320') }}</p>
                                        </el-form-item>
                                        <el-alert :title="ncfST('Frontend.335')" type="info" :closable="false"></el-alert>
                                    </template>
                                    <el-alert v-if="selectedNode.type==='merge'" :title="ncfST('Frontend.369')" type="info" :closable="false"></el-alert>
                                    <el-alert v-if="selectedNode.type==='parallel'" :title="ncfST('Frontend.231')" type="info" :closable="false"></el-alert>
                                    <template v-if="selectedNode.type==='console'">
                                        <el-form-item :label="ncfST('Frontend.426')" >
                                            <template v-if="isTemplateValue(selectedNode.config.printTemplate)">
                                                <div class="parameter-template-card workflow-rich-text-template-card">
                                                    <div class="parameter-template-summary">{{parameterTemplateSummary(selectedNode.config.printTemplate)}}</div>
                                                    <div class="parameter-template-tags">
                                                        <el-tag v-for="item in parameterTemplateBindings(selectedNode.config.printTemplate)" :key="item.token" size="mini" :title="templateBindingLabel(item.source)">{{templatePlaceholder(item.token)}}</el-tag>
                                                    </div>
                                                    <div class="parameter-template-actions">
                                                        <el-button type="text" size="mini" :disabled="editingLocked" @@click="openNodeTemplateEditor(selectedNode,'printTemplate',{fieldLabel:ncfST('Frontend.426')})">{{ ncfST('Frontend.329') }}</el-button>
                                                        <el-button type="text" size="mini" :disabled="editingLocked" @@click="resetNodeTemplateManual(selectedNode,'printTemplate')">{{ ncfST('Frontend.275') }}</el-button>
                                                    </div>
                                                </div>
                                            </template>
                                            <workflow-rich-text-input v-else
                                                                      v-model="selectedNode.config.printTemplate"
                                                                      multiline
                                                                      :rows="4"
                                                                      :disabled="editingLocked"
                                                                      :maxlength="8000"
                                                                      :show-word-limit="true"
                                                                      :help-text="ncfST('Frontend.252')"
                                                                      placeholder="{{input}}"
                                                                      @@edit-template="openNodeTemplateEditor(selectedNode,'printTemplate',{fieldLabel:ncfST('Frontend.426')})"></workflow-rich-text-input>
                                            <p v-pre class="node-config-help">{{ ncfST('Frontend.252') }}</p>
                                        </el-form-item>
                                        <el-alert :title="ncfST('Frontend.355')" type="info" :closable="false"></el-alert>
                                    </template>
                                    <el-alert v-if="selectedNode.type==='neubell'" :title="ncfST('Frontend.356')" type="info" :closable="false"></el-alert>
                                </el-form>
                            </template>
                            <div v-else class="inspector-empty">{{ ncfST('Frontend.367') }}</div>
                        </div>
                    </aside>
                </div>

                <section :class="['workflow-run-dock','run-'+run.status,{expanded:run.consoleOpen}]">
                    <div class="run-status-bar">
                        <span class="run-status-dot"></span>
                        <strong>{{runStatusText}}</strong>
                        <span v-if="run.error" class="run-error">{{run.error}}</span>
                        <el-input v-model="run.input" :disabled="editingLocked" size="small" :placeholder="ncfST('Frontend.300')"></el-input>
                        <el-button type="primary" size="small" icon="el-icon-video-play" :loading="run.validating || run.running" :disabled="!form.id" @@click="startWorkflow">{{ ncfST('Frontend.292') }}</el-button>
                        <el-button v-if="run.running" type="danger" size="small" plain icon="el-icon-circle-close" :loading="run.aborting" @@click="abortWorkflow">{{ ncfST('Frontend.510') }}</el-button>
                        <el-button type="text" size="small" :icon="run.consoleOpen?'el-icon-arrow-down':'el-icon-arrow-up'" @@click="run.consoleOpen=!run.consoleOpen">Console</el-button>
                    </div>
                    <div v-if="run.humanInteractions.length" class="workflow-human-quick-panel">
                        <div class="workflow-human-quick-copy">
                            <i class="el-icon-user-solid"></i>
                            <span><strong>{{ ncfST('Frontend.147') }}</strong> · {{ ncfST('Frontend.389', run.humanInteractions.length) }}</span>
                            <small v-if="run.humanInteractions[0].prompt">{{run.humanInteractions[0].prompt}}</small>
                        </div>
                        <el-button type="warning" size="small" plain @@click="openHumanInteraction(run.humanInteractions[0])">{{ ncfST('Frontend.241') }}</el-button>
                    </div>
                    <el-dialog :title="ncfST('Frontend.676')"
                               :visible.sync="run.humanReplyVisible"
                               width="560px"
                               append-to-body
                               @@close="closeHumanInteractionDialog">
                        <template v-if="run.humanReplyRequest">
                            <el-alert v-if="requiresHumanTextInput(run.humanReplyRequest)"
                                      :title="ncfST('Frontend.235')"
                                      type="info"
                                      :closable="false"
                                      show-icon></el-alert>
                            <el-alert v-else
                                      :title="ncfST('Frontend.131')"
                                      type="warning"
                                      :closable="false"
                                      show-icon></el-alert>
                            <p class="workflow-human-prompt">{{run.humanReplyRequest.prompt}}</p>
                            <pre v-if="run.humanReplyRequest.toolArguments" class="workflow-human-tool-arguments">{{run.humanReplyRequest.toolArguments}}</pre>
                            <el-input v-if="requiresHumanTextInput(run.humanReplyRequest)"
                                      v-model="run.humanReplyInput"
                                      type="textarea"
                                      :rows="5"
                                      maxlength="8000"
                                      show-word-limit
                                      :placeholder="ncfST('Frontend.353')"></el-input>
                        </template>
                        <span slot="footer" class="dialog-footer">
                            <el-button @@click="closeHumanInteractionDialog">{{ ncfST('Frontend.319') }}</el-button>
                            <el-button v-if="run.humanReplyRequest && !requiresHumanTextInput(run.humanReplyRequest)"
                                       type="danger"
                                       plain
                                       :loading="run.humanReplySubmitting"
                                       @@click="resolveHumanInteraction(false)">{{ ncfST('Frontend.259') }}</el-button>
                            <el-button type="primary"
                                       :loading="run.humanReplySubmitting"
                                       @@click="resolveHumanInteraction(true)">{{run.humanReplyRequest && requiresHumanTextInput(run.humanReplyRequest)?ncfST('Frontend.677'):ncfST('Frontend.678')}}</el-button>
                        </span>
                    </el-dialog>
                    <div v-show="run.consoleOpen" class="workflow-console">
                        <div class="console-toolbar">
                            <span>{{ ncfST('Frontend.404') }} · {{run.events.length}}</span>
                            <el-button type="text" size="mini" :disabled="run.running" @@click="clearConsole">{{ ncfST('Frontend.307') }}</el-button>
                        </div>
                        <div ref="consoleLog" class="console-log">
                            <div v-for="(event,index) in run.events" :key="event.sequence+'-'+index" :class="['console-line','console-'+event.status]">
                                <time>{{event.timestamp ? event.timestamp.substring(11,19) : '--:--:--'}}</time>
                                <strong>{{event.nodeName || 'Workflow'}}</strong>
                                <span>{{event.message}}</span>
                                <el-button v-if="hasAgentGroupConversation(event)"
                                           type="text"
                                           size="mini"
                                           icon="el-icon-chat-dot-round"
                                           @@click="openAgentGroupConversation(event.objectReference)">{{ ncfST('Frontend.095') }}</el-button>
                                <pre v-if="event.output">{{event.output}}</pre>
                            </div>
                            <div v-if="!run.events.length" class="console-empty">{{ ncfST('Frontend.379') }}</div>
                        </div>
                    </div>
                </section>
            </template>
            <div v-else class="neuchar-empty">
                <i class="fa fa-random fa-3x"></i>
                <h3>{{ ncfST('Frontend.366') }}</h3>
                <p>{{ ncfST('Frontend.156') }}</p>
            </div>
        </main>
    </div>
</div>

@section scripts {
    <partial name="~/Areas/Admin/Pages/Shared/_LocalizationScripts.cshtml" />
    @* Keep this template outside the shared #app Vue root. Otherwise the root compiler
       evaluates its v-for variables (such as fn) in the page scope before the child
       component receives the template. *@
    <script type="text/x-template" id="workflow-node-picker-template">
        <div class="workflow-node-picker" :class="{'is-edge-insert':edgeInsert}">
            <div class="workflow-node-picker-filters">
                <el-input v-model="keyword" size="small" clearable prefix-icon="el-icon-search" :placeholder="ncfST('Frontend.433')"></el-input>
                <el-select v-model="module" size="small" clearable filterable :placeholder="ncfST('Frontend.434')">
                    <el-option v-for="name in moduleNames" :key="name" :label="name" :value="name"></el-option>
                </el-select>
            </div>

            <template v-if="filteredSystemNodes.length">
                <el-divider>{{ ncfST('Frontend.431') }}</el-divider>
                <div class="palette-system-grid">
                    <el-button v-for="node in filteredSystemNodes" :key="node.type" plain :icon="node.icon" :class="['node-picker-system-button','node-picker-'+node.type]" :disabled="locked || (edgeInsert && node.type === 'end')" :title="edgeInsert && node.type === 'end'?ncfST('Frontend.496'):''" draggable="true" @@dragstart.native="startSystemDrag($event,node)" @@dragend.native="finishDrag" @@mouseenter.native="previewSystem(node,'hover',$event)" @@mouseleave.native="hideNodePreview('system',node)" @@click="previewSystem(node,'click',$event)" @@dblclick.native="selectSystem(node)">{{node.label}}</el-button>
                </div>
            </template>

            <template v-if="filteredFunctions.length">
                <el-divider>NeuCharPivot Function</el-divider>
                <div class="palette-functions">
                <button v-for="fn in filteredFunctions"
                        :key="functionIdentity(fn)"
                        :class="['palette-item','node-picker-function',{'is-unavailable':!fn.moduleAvailable}]"
                        :disabled="locked"
                        draggable="true"
                        @@dragstart="startFunctionDrag($event,fn)"
                        @@dragend="finishDrag"
                        @@mouseenter="previewNode('function',fn,'hover',$event)"
                        @@mouseleave="hideNodePreview('function',fn)"
                        @@click="previewNode('function',fn,'click',$event)"
                        @@dblclick="selectFunction(fn)">
                    <span class="palette-item-copy">
                        <strong>{{fn.functionName}}</strong>
                        <small>{{fn.moduleName}} · {{fn.moduleAvailable?ncfST('Frontend.435'):ncfST('Frontend.437')}}</small>
                        <small v-if="fn.catalogError" class="palette-error">{{ ncfST('Frontend.505') }}</small>
                    </span>
                    <span role="button"
                          :class="['palette-pin',{active:isPinned(fn)}]"
                          :title="isPinned(fn)?ncfST('Frontend.679'):ncfST('Frontend.680')"
                          @@click.stop="$emit('toggle-pin', fn)">
                        <i :class="isPinned(fn)?'el-icon-star-on':'el-icon-star-off'"></i>
                    </span>
                </button>
                </div>
            </template>

            <template v-if="filteredObjects.length">
                <el-divider>AgentsManager / A2A</el-divider>
                <button v-for="object in filteredObjects"
                        :key="object.providerId+object.objectId"
                        :class="['palette-item','node-picker-'+object.kind,{'is-a2a-object':object.kind==='a2a','is-unavailable':!object.enabled}]"
                        :disabled="locked"
                        draggable="true"
                        @@dragstart="startObjectDrag($event,object)"
                        @@dragend="finishDrag"
                        @@mouseenter="previewNode('object',object,'hover',$event)"
                        @@mouseleave="hideNodePreview('object',object)"
                        @@click="previewNode('object',object,'click',$event)"
                        @@dblclick="selectObject(object)">
                    <span class="palette-item-copy">
                        <strong>{{object.name}}</strong>
                        <small>{{objectKindLabel(object)}} · {{object.enabled?ncfST('Frontend.435'):ncfST('Frontend.436')}}</small>
                    </span>
                    <el-tag v-if="object.kind==='a2a'" size="mini" type="warning" effect="plain">A2A</el-tag>
                </button>
            </template>
            <div v-if="!filteredSystemNodes.length && !filteredFunctions.length && !filteredObjects.length" class="palette-empty">{{ ncfST('Frontend.456') }}</div>
        </div>
    </script>
    <script src="~/js/NeuCharWorkflow/common.js"></script>
    <script src="~/js/NeuCharWorkflow/Workflow.js"></script>
}
