@page
@model Senparc.Xncf.NeuCharWorkflow.Areas.NeuCharWorkflow.Pages.ReplayModel
@using Microsoft.Extensions.Localization
@using Senparc.Xncf.NeuCharWorkflow
@inject IStringLocalizer<NeuCharWorkflowResource> XR
@{
    ViewData["Title"] = XR["Title.Replay"];
    Layout = "_Layout_Vue";
}

@section breadcrumbs {
    <el-breadcrumb-item>@XR["Module.MenuName"]</el-breadcrumb-item>
    <el-breadcrumb-item><a href="/Admin/NeuCharWorkflow/Tasks">@XR["Area.Tasks"]</a></el-breadcrumb-item>
    <el-breadcrumb-item>@XR["Area.Replay"]</el-breadcrumb-item>
}

@section Style {
    <link rel="stylesheet" href="~/css/NeuCharWorkflow/common.css" />
    <link rel="stylesheet" href="~/css/NeuCharWorkflow/Replay.css" />
}

<div class="workflow-replay-page" v-loading="loading">
    <el-alert v-if="loadError" :title="loadError" type="warning" :closable="false" class="workflow-replay-alert"></el-alert>
    <template v-else-if="replay">
        <header class="workflow-replay-header">
            <div>
                <div class="workflow-replay-eyebrow">{{ncfST('Frontend.NeuCharWorkflow.ReadOnlyRunReplayValue', replay.executionLogId)}}</div>
                <h2>{{ replay.workflowName }}</h2>
                <p>{{ncfST('Frontend.NeuCharWorkflow.RanAtValueValueTheCanvasIsASnapshotFromThatTime', formatDate(replay.startedAt), statusText(replay.status))}}</p>
            </div>
            <div class="workflow-replay-actions">
                <el-button icon="el-icon-back" @@click="backToTasks">{{ncfST('Frontend.NeuCharWorkflow.BackToTaskList')}}</el-button>
                <el-button icon="el-icon-tickets" @@click="openWorkflowTasks">{{ncfST('Frontend.NeuCharWorkflow.ViewTasksForThisWorkflow')}}</el-button>
                <el-button icon="el-icon-data-analysis" @@click="openWorkflowAnalytics">{{ncfST('Frontend.NeuCharWorkflow.ViewAnalytics')}}</el-button>
                <el-button type="primary" plain icon="el-icon-copy-document" :loading="copying" @@click="copyReplay">{{ncfST('Frontend.NeuCharWorkflow.CopyAndEditTheCurrentWorkflow')}}</el-button>
                <el-button type="primary" icon="el-icon-edit-outline" @@click="openLatestWorkflow">{{ncfST('Frontend.NeuCharWorkflow.ViewLatestWorkflow')}}</el-button>
            </div>
        </header>

        <section class="workflow-replay-controls" :aria-label="ncfST('Frontend.NeuCharWorkflow.ReplayControls')">
            <div class="workflow-replay-step-summary">
                <strong>{{ stepLabel }}</strong>
                <span>{{ replay.events.length ? ncfST('Frontend.NeuCharWorkflow.ValueNodeEventsTotal', replay.events.length) : ncfST('Frontend.NeuCharWorkflow.ThisRunHasNoNodeEvents') }}</span>
            </div>
            <div class="workflow-replay-buttons">
                <el-button size="small" icon="el-icon-d-arrow-left" :disabled="stepIndex < 0" @@click="resetPlayback">{{ncfST('Frontend.NeuCharWorkflow.StartAlternate')}}</el-button>
                <el-button size="small" icon="el-icon-arrow-left" :disabled="stepIndex <= 0" @@click="previousStep">{{ncfST('Frontend.NeuCharWorkflow.PreviousStep')}}</el-button>
                <el-button size="small" type="primary" :icon="playing ? 'el-icon-video-pause' : 'el-icon-video-play'" :disabled="!replay.events.length" @@click="togglePlayback">{{ playing ? ncfST('Frontend.NeuCharWorkflow.Pause') : ncfST('Frontend.NeuCharWorkflow.Play') }}</el-button>
                <el-button size="small" icon="el-icon-arrow-right" :disabled="stepIndex >= replay.events.length - 1" @@click="nextStep">{{ncfST('Frontend.NeuCharWorkflow.NextStep')}}</el-button>
                <el-button size="small" icon="el-icon-d-arrow-right" :disabled="stepIndex >= replay.events.length - 1" @@click="finishPlayback">{{ncfST('Frontend.NeuCharWorkflow.End')}}</el-button>
            </div>
        </section>

        <div class="workflow-replay-layout">
            <aside class="workflow-replay-timeline">
                <h3>{{ncfST('Frontend.NeuCharWorkflow.ExecutionSteps')}}</h3>
                <div class="workflow-replay-timeline-list">
                    <button type="button" :class="['workflow-replay-timeline-item',{active:stepIndex===-1}]" @@click="resetPlayback">
                        <span class="workflow-replay-timeline-dot"></span><span><strong>{{ncfST('Frontend.NeuCharWorkflow.Start')}}</strong><small>{{ncfST('Frontend.NeuCharWorkflow.LoadRunSnapshot')}}</small></span>
                    </button>
                    <button v-for="(item,index) in visibleTimelineEvents" :key="item.sequence"
                            type="button" :class="['workflow-replay-timeline-item',{active:stepIndex===index,passed:index<=stepIndex,failed:item.status==='failed'}]"
                            @@click="goToStep(index)">
                        <span class="workflow-replay-timeline-dot"></span>
                        <span><strong>{{ item.nodeName }}</strong><small>{{ eventSummary(item) }}</small></span>
                    </button>
                    <el-button v-if="hasMoreTimelineEvents"
                               class="workflow-replay-load-more"
                               type="text"
                               size="mini"
                               @@click="loadMoreTimelineEvents">
                        {{ncfST('Frontend.NeuCharWorkflow.ShowMoreStepsValueValue', visibleTimelineEvents.length, replay.events.length)}}
                    </el-button>
                </div>
            </aside>

            <main ref="canvasViewport" class="workflow-replay-canvas-wrap">
                <div class="workflow-replay-canvas" :style="canvasStyle">
                    <svg class="workflow-replay-edges" :viewBox="`0 0 ${canvasSize.width} ${canvasSize.height}`" :width="canvasSize.width" :height="canvasSize.height" aria-hidden="true">
                        <line v-for="edge in graph.edges" :key="edge.id || `${edge.source}-${edge.target}`"
                              :x1="edgeStartX(edge)" :y1="edgeStartY(edge)" :x2="edgeEndX(edge)" :y2="edgeEndY(edge)" />
                    </svg>
                    <article v-for="node in graph.nodes" :key="node.id" :class="['workflow-replay-node',`state-${nodeState(node.id)}`, {selected:currentEvent && currentEvent.nodeId===node.id}]"
                             :style="nodeStyle(node)">
                        <span class="workflow-replay-node-status"></span>
                        <strong>{{ node.name || node.type }}</strong>
                        <small>{{ nodeTypeText(node.type) }}</small>
                    </article>
                </div>
            </main>

            <aside class="workflow-replay-detail">
                <h3>{{ currentEvent ? ncfST('Frontend.NeuCharWorkflow.CurrentStep') : ncfST('Frontend.NeuCharWorkflow.RunOverview') }}</h3>
                <template v-if="currentEvent">
                    <el-tag size="mini" :type="eventType(currentEvent.status)">{{ eventStatusText(currentEvent.status) }}</el-tag>
                    <h4>{{ currentEvent.nodeName }}</h4>
                    <p>{{ currentEvent.message || ncfST('Frontend.NeuCharWorkflow.NodeStatusUpdated') }}</p>
                    <time>{{ formatDate(currentEvent.timestamp) }}</time>
                    <section class="workflow-replay-value">
                        <h5>{{ncfST('Frontend.NeuCharWorkflow.InputParameters')}}</h5>
                        <pre v-if="currentEvent.input" class="workflow-replay-input">{{ currentEvent.input }}</pre>
                        <p v-else class="workflow-replay-missing-input">{{ncfST('Frontend.NeuCharWorkflow.ThisHistoricalStepHasNoSavedInputRecord')}}</p>
                    </section>
                    <section v-if="currentEvent.output" class="workflow-replay-value">
                        <h5>{{ncfST('Frontend.NeuCharWorkflow.OutputResult')}}</h5>
                        <pre class="workflow-replay-output">{{ currentEvent.output }}</pre>
                    </section>
                    <el-button v-if="hasAgentGroupConversation(currentEvent)"
                               size="small"
                               type="primary"
                               plain
                               icon="el-icon-chat-dot-round"
                               @@click="openAgentGroupConversation(currentEvent.objectReference)">{{ncfST('Frontend.NeuCharWorkflow.ViewAgentGroupConversation')}}</el-button>
                </template>
                <template v-else>
                    <el-tag size="mini" :type="replay.succeeded ? 'success' : 'danger'">{{ statusText(replay.status) }}</el-tag>
                    <p>{{ replay.succeeded ? (replay.resultSummary || ncfST('Frontend.NeuCharWorkflow.RunCompleted')) : (replay.errorMessage || ncfST('Frontend.NeuCharWorkflow.RunFailedAlternate')) }}</p>
                    <p class="workflow-replay-detail-note">{{ncfST('Frontend.NeuCharWorkflow.ClickAStepOnTheLeftOrUseThePlaybackControlsTo')}}</p>
                </template>
            </aside>
        </div>
    </template>
</div>

@section scripts {
    @await Html.PartialAsync("_LocalizationScripts")
    <script src="~/js/NeuCharWorkflow/common.js" asp-append-version="true"></script>
    <script src="~/js/NeuCharWorkflow/Replay.js" asp-append-version="true"></script>
}
