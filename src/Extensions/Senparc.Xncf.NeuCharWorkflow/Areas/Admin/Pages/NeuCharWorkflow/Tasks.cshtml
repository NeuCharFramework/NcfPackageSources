@page
@model Senparc.Xncf.NeuCharWorkflow.Areas.NeuCharWorkflow.Pages.TasksModel
@using Microsoft.Extensions.Localization
@using Senparc.Xncf.NeuCharWorkflow
@inject IStringLocalizer<NeuCharWorkflowResource> XR
@{
    ViewData["Title"] = XR["Title.Tasks"];
    Layout = "_Layout_Vue";
}

@section breadcrumbs {
    <el-breadcrumb-item>@XR["Module.MenuName"]</el-breadcrumb-item>
    <el-breadcrumb-item>@XR["Area.Tasks"]</el-breadcrumb-item>
}

@section Style {
    <link rel="stylesheet" href="~/css/NeuCharWorkflow/common.css" />
    <link rel="stylesheet" href="~/css/NeuCharWorkflow/Tasks.css" />
}

<div class="neuchar-page workflow-tasks-page" v-loading="loading">
    <div class="neuchar-page-header workflow-tasks-header">
        <div>
            <h2>{{ncfST('Frontend.070')}}</h2>
            <p>{{ncfST('Frontend.071')}}</p>
        </div>
        <div class="workflow-tasks-header-actions">
            <el-tag v-if="workflowIdFilter"
                    closable
                    size="small"
                    type="primary"
                    @@close="clearWorkflowFilter">{{ncfST('Frontend.072', workflowIdFilter)}}</el-tag>
            <el-input v-model="keyword" size="small" clearable prefix-icon="el-icon-search" :placeholder="ncfST('Frontend.073')"></el-input>
            <el-button size="small" icon="el-icon-data-analysis" @@click="openAnalytics">{{ncfST('Frontend.074')}}</el-button>
            <el-button size="small" icon="el-icon-delete" type="danger" plain :loading="cleaning" @@click="quickCleanTasks">{{ncfST('Frontend.004')}}</el-button>
            <el-button size="small" icon="el-icon-refresh" :loading="loading" @@click="refreshTasks">{{ncfST('Frontend.003')}}</el-button>
        </div>
    </div>
    <el-alert v-if="neuBellConsumeMessage"
              :title="neuBellConsumeMessage"
              :type="neuBellConsumeError ? 'warning' : 'success'"
              :closable="false"
              class="workflow-task-consume-status"></el-alert>

    <section class="workflow-task-summary" :aria-label="ncfST('Frontend.006')">
        <button type="button" :class="['workflow-task-summary-card',{active:statusFilter===''}]" @@click="selectStatus('')">
            <strong>{{summaryCount('all')}}</strong><span>{{ncfST('Frontend.075')}}</span>
            <el-tag v-if="statusFilter===''" size="mini" type="primary" effect="plain">{{ncfST('Frontend.076')}}</el-tag>
        </button>
        <button type="button" :class="['workflow-task-summary-card',{active:statusFilter==='running'}]" @@click="selectStatus('running')">
            <strong>{{summaryCount('running')}}</strong><span>{{ncfST('Frontend.008')}}</span>
            <el-tag v-if="statusFilter==='running'" size="mini" type="primary" effect="plain">{{ncfST('Frontend.076')}}</el-tag>
        </button>
        <button type="button" :class="['workflow-task-summary-card',{active:statusFilter==='success'}]" @@click="selectStatus('success')">
            <strong>{{summaryCount('success')}}</strong><span>{{ncfST('Frontend.009')}}</span>
            <el-tag v-if="statusFilter==='success'" size="mini" type="primary" effect="plain">{{ncfST('Frontend.076')}}</el-tag>
        </button>
        <button type="button" :class="['workflow-task-summary-card',{active:statusFilter==='failed'}]" @@click="selectStatus('failed')">
            <strong>{{summaryCount('failed')}}</strong><span>{{ncfST('Frontend.010')}}</span>
            <el-tag v-if="statusFilter==='failed'" size="mini" type="primary" effect="plain">{{ncfST('Frontend.076')}}</el-tag>
        </button>
    </section>

    <section class="workflow-task-table-wrap">
        <el-table v-if="filteredTasks.length" :data="filteredTasks" size="small" class="workflow-task-table" :row-class-name="taskRowClass" @@row-click="openTask">
            <el-table-column :label="ncfST('Frontend.011')" min-width="180">
                <template slot-scope="scope">
                    <div class="workflow-task-workflow">
                        <strong>{{scope.row.workflowName}}</strong>
                        <small>#{{scope.row.workflowId}} · {{sourceText(scope.row.source)}}</small>
                    </div>
                </template>
            </el-table-column>
            <el-table-column :label="ncfST('Frontend.012')" width="118">
                <template slot-scope="scope">
                    <el-tag size="mini" :type="statusType(scope.row.status)" effect="dark">{{statusText(scope.row.status)}}</el-tag>
                </template>
            </el-table-column>
            <el-table-column :label="ncfST('Frontend.013')" width="172">
                <template slot-scope="scope">{{formatDate(scope.row.startedAt)}}</template>
            </el-table-column>
            <el-table-column :label="ncfST('Frontend.014')" width="172">
                <template slot-scope="scope">{{scope.row.finishedAt ? formatDate(scope.row.finishedAt) : '—'}}</template>
            </el-table-column>
            <el-table-column :label="ncfST('Frontend.015')" min-width="260">
                <template slot-scope="scope">
                    <span :class="['workflow-task-message',{error:scope.row.status==='failed'}]">{{summaryText(scope.row)}}</span>
                </template>
            </el-table-column>
            <el-table-column :label="ncfST('Frontend.016')" width="210" align="right" class-name="ncf-table-actions-column">
                <template slot-scope="scope">
                    <el-button v-if="scope.row.status==='running'" type="danger" size="mini" plain icon="el-icon-circle-close"
                               :loading="abortingTaskId===scope.row.taskId"
                               @@click.stop="abortTask(scope.row)">{{ncfST('Frontend.017')}}</el-button>
                    <el-button type="primary" size="mini" plain icon="el-icon-video-play"
                               :disabled="scope.row.status!=='running' && !scope.row.replayAvailable"
                               @@click.stop="openTask(scope.row)">
                        {{scope.row.status==='running' ? ncfST('Frontend.018') : (scope.row.replayAvailable ? ncfST('Frontend.019') : ncfST('Frontend.020'))}}
                    </el-button>
                </template>
            </el-table-column>
        </el-table>
        <div v-else class="neuchar-empty workflow-task-empty">
            <i class="el-icon-document"></i>
            <h3>{{tasks.length ? ncfST('Frontend.079') : ncfST('Frontend.080')}}</h3>
            <p>{{tasks.length ? ncfST('Frontend.081') : ncfST('Frontend.082')}}</p>
        </div>
        <div v-if="tasks.length" class="workflow-task-load-state" aria-live="polite">
            <i v-if="loadingMore" class="el-icon-loading"></i>
            <span v-if="loadingMore">{{ncfST('Frontend.083')}}</span>
            <span v-else-if="hasMore">{{ncfST('Frontend.084')}}</span>
            <span v-else>{{ncfST('Frontend.021')}}</span>
        </div>
    </section>
</div>

@section scripts {
    @await Html.PartialAsync("_LocalizationScripts")
    <script src="~/js/NeuCharWorkflow/common.js" asp-append-version="true"></script>
    <script src="~/js/NeuCharWorkflow/Tasks.js" asp-append-version="true"></script>
}
