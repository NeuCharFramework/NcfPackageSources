@page
@model Senparc.Xncf.NeuCharWorkflow.Areas.NeuCharWorkflow.Pages.AnalyticsModel
@using Microsoft.Extensions.Localization
@using Senparc.Xncf.NeuCharWorkflow
@inject IStringLocalizer<NeuCharWorkflowResource> XR
@{
    ViewData["Title"] = XR["Frontend.NeuCharWorkflow.WorkflowAnalytics"];
    Layout = "_Layout_Vue";
}

@section breadcrumbs {
    <el-breadcrumb-item>@XR["Module.MenuName"]</el-breadcrumb-item>
    <el-breadcrumb-item><a href="/Admin/NeuCharWorkflow/Tasks">@XR["Area.Tasks"]</a></el-breadcrumb-item>
    <el-breadcrumb-item>@XR["Frontend.NeuCharWorkflow.WorkflowAnalytics"]</el-breadcrumb-item>
}

@section Style {
    <link rel="stylesheet" href="~/css/NeuCharWorkflow/common.css" />
    <link rel="stylesheet" href="~/css/NeuCharWorkflow/Analytics.css" />
}

<div class="neuchar-page workflow-analytics-page" v-loading="loading">
    <div class="neuchar-page-header workflow-analytics-header">
        <div>
            <h2>{{ncfST('Frontend.NeuCharWorkflow.WorkflowAnalytics')}}</h2>
            <p>{{ncfST('Frontend.NeuCharWorkflow.RunHealthExternalResourceCallsAndReplayableExecutionRecords')}}</p>
        </div>
        <div class="workflow-analytics-header-actions">
            <el-button size="small" icon="el-icon-tickets" @@click="openTasks">{{ncfST('Frontend.NeuCharWorkflow.WorkflowTaskList')}}</el-button>
            <el-button size="small" icon="el-icon-refresh" :loading="loading" @@click="loadData">{{ncfST('Frontend.NeuCharWorkflow.Refresh')}}</el-button>
        </div>
    </div>

    <section class="workflow-analytics-filters" :aria-label="ncfST('Frontend.NeuCharWorkflow.AnalyticsFilters')">
        <el-date-picker v-model="filters.dateRange"
                        type="daterange"
                        size="small"
                        value-format="yyyy-MM-dd"
                        :range-separator="ncfST('Frontend.NeuCharWorkflow.To')"
                        :start-placeholder="ncfST('Frontend.NeuCharWorkflow.StartDate')"
                        :end-placeholder="ncfST('Frontend.NeuCharWorkflow.EndDate')"
                        :clearable="true"
                        @@change="applyFilters"></el-date-picker>
        <el-select v-model="filters.workflowId"
                   size="small"
                   clearable
                   filterable
                   :placeholder="ncfST('Frontend.NeuCharWorkflow.AllWorkflows')"
                   @@change="applyFilters">
            <el-option v-for="item in workflowOptions"
                       :key="item.objectId"
                       :label="item.label"
                       :value="item.objectId"></el-option>
        </el-select>
        <el-select v-model="filters.status"
                   size="small"
                   clearable
                   :placeholder="ncfST('Frontend.NeuCharWorkflow.AllStatuses')"
                   @@change="applyFilters">
            <el-option :label="ncfST('Frontend.NeuCharWorkflow.Running')" value="running"></el-option>
            <el-option :label="ncfST('Frontend.NeuCharWorkflow.Success')" value="success"></el-option>
            <el-option :label="ncfST('Frontend.NeuCharWorkflow.Failed')" value="failed"></el-option>
        </el-select>
        <el-select v-model="filters.resourceType"
                   size="small"
                   clearable
                   :placeholder="ncfST('Frontend.NeuCharWorkflow.AllResourceTypes')"
                   @@change="applyResourceType">
            <el-option v-for="item in resourceTypes"
                       :key="item.value"
                       :label="item.label"
                       :value="item.value"></el-option>
        </el-select>
        <el-select v-model="filters.resourceKey"
                   size="small"
                   clearable
                   filterable
                   :placeholder="ncfST('Frontend.NeuCharWorkflow.AllExternalResources')"
                   @@change="applyResourceFilter">
            <el-option v-for="item in resourceOptions"
                       :key="resourceKey(item)"
                       :label="item.label"
                       :value="resourceKey(item)"></el-option>
        </el-select>
        <el-input v-model="filters.keyword"
                  size="small"
                  clearable
                  prefix-icon="el-icon-search"
                  :placeholder="ncfST('Frontend.NeuCharWorkflow.SearchWorkflowsResourcesOrErrors')"
                  @@keyup.enter.native="applyFilters"></el-input>
        <el-button size="small" type="primary" icon="el-icon-search" @@click="applyFilters">{{ncfST('Frontend.NeuCharWorkflow.Query')}}</el-button>
        <el-button size="small" icon="el-icon-refresh-left" @@click="resetFilters">{{ncfST('Frontend.NeuCharWorkflow.Reset')}}</el-button>
    </section>

    <section class="workflow-analytics-summary" :aria-label="ncfST('Frontend.NeuCharWorkflow.RunOverview')">
        <button type="button"
                :class="['workflow-analytics-summary-card',{active:!filters.status}]"
                @@click="selectStatus('')">
            <strong>{{formatNumber(summary.totalRuns)}}</strong>
            <span>{{ncfST('Frontend.NeuCharWorkflow.TotalRuns')}}</span>
        </button>
        <button type="button"
                :class="['workflow-analytics-summary-card is-running',{active:filters.status==='running'}]"
                @@click="selectStatus('running')">
            <strong>{{formatNumber(summary.runningCount)}}</strong>
            <span>{{ncfST('Frontend.NeuCharWorkflow.Running')}}</span>
        </button>
        <button type="button"
                :class="['workflow-analytics-summary-card is-success',{active:filters.status==='success'}]"
                @@click="selectStatus('success')">
            <strong>{{formatNumber(summary.successCount)}}</strong>
            <span>{{ncfST('Frontend.NeuCharWorkflow.Success')}}</span>
        </button>
        <button type="button"
                :class="['workflow-analytics-summary-card is-failed',{active:filters.status==='failed'}]"
                @@click="selectStatus('failed')">
            <strong>{{formatNumber(summary.failedCount)}}</strong>
            <span>{{ncfST('Frontend.NeuCharWorkflow.Failed')}}</span>
        </button>
        <div class="workflow-analytics-summary-card">
            <strong>{{formatPercent(summary.successRate)}}</strong>
            <span>{{ncfST('Frontend.NeuCharWorkflow.SuccessRate')}}</span>
        </div>
        <div class="workflow-analytics-summary-card">
            <strong>{{formatDuration(summary.averageDurationSeconds)}}</strong>
            <span>{{ncfST('Frontend.NeuCharWorkflow.AverageDuration')}}</span>
        </div>
    </section>

    <div class="workflow-analytics-grid">
        <section class="workflow-analytics-panel workflow-analytics-trend-panel">
            <div class="workflow-analytics-panel-header">
                <div>
                    <h3>{{ncfST('Frontend.NeuCharWorkflow.RunTrend')}}</h3>
                    <small>{{ncfST('Frontend.NeuCharWorkflow.StatisticsByStartDate')}}</small>
                </div>
                <el-tag size="mini" type="info" effect="plain">{{ncfST('Frontend.NeuCharWorkflow.ValueDays', trend.length)}}</el-tag>
            </div>
            <div v-if="trend.length" class="workflow-analytics-trend-list">
                <div v-for="item in trend" :key="item.date" class="workflow-analytics-trend-row">
                    <span class="workflow-analytics-trend-date">{{item.date}}</span>
                    <div class="workflow-analytics-trend-bars">
                        <span class="workflow-analytics-bar is-success"
                              :style="{width: trendWidth(item.success)}"></span>
                        <span class="workflow-analytics-bar is-failed"
                              :style="{width: trendWidth(item.failed)}"></span>
                        <span class="workflow-analytics-bar is-running"
                              :style="{width: trendWidth(item.running)}"></span>
                    </div>
                    <strong>{{item.total}}</strong>
                </div>
            </div>
            <div v-else class="workflow-analytics-empty">{{ncfST('Frontend.NeuCharWorkflow.NoRunsInTheCurrentFilterRange')}}</div>
        </section>

        <section class="workflow-analytics-panel">
            <div class="workflow-analytics-panel-header">
                <div>
                    <h3>{{ncfST('Frontend.NeuCharWorkflow.ExternalResourceCalls')}}</h3>
                    <small>{{ncfST('Frontend.NeuCharWorkflow.ValueCallsValueResources', formatNumber(summary.resourceCallCount), formatNumber(summary.resourceCount))}}</small>
                </div>
            </div>
            <el-table v-if="resources.length"
                      :data="resources"
                      size="small"
                      class="workflow-analytics-table"
                      @@row-click="selectResourceRow">
                <el-table-column :label="ncfST('Frontend.NeuCharWorkflow.Resource')" min-width="220">
                    <template slot-scope="scope">
                        <div class="workflow-analytics-resource">
                            <el-tag size="mini" effect="plain">{{scope.row.typeLabel}}</el-tag>
                            <strong>{{scope.row.name}}</strong>
                        </div>
                    </template>
                </el-table-column>
                <el-table-column :label="ncfST('Frontend.NeuCharWorkflow.Calls')" width="72" prop="callCount"></el-table-column>
                <el-table-column :label="ncfST('Frontend.NeuCharWorkflow.SuccessRate')" width="92">
                    <template slot-scope="scope">{{resourceSuccessRate(scope.row)}}</template>
                </el-table-column>
                <el-table-column :label="ncfST('Frontend.NeuCharWorkflow.WorkflowsInvolved')" width="96" prop="workflowCount"></el-table-column>
            </el-table>
            <div v-else class="workflow-analytics-empty">{{ncfST('Frontend.NeuCharWorkflow.NoResourceCallsInTheCurrentFilterRange')}}</div>
        </section>
    </div>

    <section class="workflow-analytics-panel">
        <div class="workflow-analytics-panel-header">
            <div>
                <h3>{{ncfST('Frontend.NeuCharWorkflow.WorkflowHealth')}}</h3>
                <small>{{ncfST('Frontend.NeuCharWorkflow.ClickAWorkflowNameToOpenItsTaskScope')}}</small>
            </div>
        </div>
        <el-table v-if="workflows.length" :data="workflows" size="small" class="workflow-analytics-table">
            <el-table-column :label="ncfST('Frontend.NeuCharWorkflow.Workflow')" min-width="220">
                <template slot-scope="scope">
                    <button type="button" class="workflow-analytics-link" @@click="openWorkflow(scope.row.workflowId)">
                        {{scope.row.workflowName}}
                    </button>
                </template>
            </el-table-column>
            <el-table-column :label="ncfST('Frontend.NeuCharWorkflow.Runs')" width="78" prop="runCount"></el-table-column>
            <el-table-column :label="ncfST('Frontend.NeuCharWorkflow.Success')" width="78" prop="successCount"></el-table-column>
            <el-table-column :label="ncfST('Frontend.NeuCharWorkflow.Failed')" width="78" prop="failedCount"></el-table-column>
            <el-table-column :label="ncfST('Frontend.NeuCharWorkflow.SuccessRate')" width="96">
                <template slot-scope="scope">{{formatPercent(scope.row.successRate)}}</template>
            </el-table-column>
            <el-table-column :label="ncfST('Frontend.NeuCharWorkflow.AverageDuration')" width="116">
                <template slot-scope="scope">{{formatDuration(scope.row.averageDurationSeconds)}}</template>
            </el-table-column>
            <el-table-column :label="ncfST('Frontend.NeuCharWorkflow.RecentRuns')" width="172">
                <template slot-scope="scope">{{formatDate(scope.row.lastRunAt)}}</template>
            </el-table-column>
        </el-table>
        <div v-else class="workflow-analytics-empty">{{ncfST('Frontend.NeuCharWorkflow.NoWorkflowRunsInTheCurrentFilterRange')}}</div>
    </section>

    <section class="workflow-analytics-panel">
        <div class="workflow-analytics-panel-header">
            <div>
                <h3>{{ncfST('Frontend.NeuCharWorkflow.RunDetails')}}</h3>
                <small>{{ncfST('Frontend.NeuCharWorkflow.ClickARecordToOpenTheLiveRunOrReadOnlyReplay')}}</small>
            </div>
            <div class="workflow-analytics-pagination">
                <el-button size="mini" icon="el-icon-arrow-left" :disabled="page<=1 || loading" @@click="changePage(page-1)">{{ncfST('Frontend.NeuCharWorkflow.PreviousPage')}}</el-button>
                <span>{{ncfST('Frontend.NeuCharWorkflow.PageValue', page)}}</span>
                <el-button size="mini" icon="el-icon-arrow-right" :disabled="!hasMore || loading" @@click="changePage(page+1)">{{ncfST('Frontend.NeuCharWorkflow.NextPage')}}</el-button>
            </div>
        </div>
        <el-table v-if="runs.length" :data="runs" size="small" class="workflow-analytics-table" @@row-click="openRun">
            <el-table-column :label="ncfST('Frontend.NeuCharWorkflow.Workflow')" min-width="190">
                <template slot-scope="scope">
                    <strong>{{scope.row.workflowName}}</strong>
                    <small class="workflow-analytics-subline">#{{scope.row.workflowId}} · {{sourceText(scope.row.source)}}</small>
                </template>
            </el-table-column>
            <el-table-column :label="ncfST('Frontend.NeuCharWorkflow.Status')" width="90">
                <template slot-scope="scope">
                    <el-tag size="mini" effect="dark" :type="statusType(scope.row.status)">{{statusText(scope.row.status)}}</el-tag>
                </template>
            </el-table-column>
            <el-table-column :label="ncfST('Frontend.NeuCharWorkflow.StartTime')" width="172">
                <template slot-scope="scope">{{formatDate(scope.row.startedAt)}}</template>
            </el-table-column>
            <el-table-column :label="ncfST('Frontend.NeuCharWorkflow.Duration')" width="100">
                <template slot-scope="scope">{{formatDuration(scope.row.durationSeconds)}}</template>
            </el-table-column>
            <el-table-column :label="ncfST('Frontend.NeuCharWorkflow.Resource')" min-width="250">
                <template slot-scope="scope">
                    <span class="workflow-analytics-resource-list">
                        {{resourceNames(scope.row.resources)}}
                    </span>
                </template>
            </el-table-column>
            <el-table-column :label="ncfST('Frontend.NeuCharWorkflow.Result')" min-width="250">
                <template slot-scope="scope">{{scope.row.error || scope.row.summary || '—'}}</template>
            </el-table-column>
        </el-table>
        <div v-else class="workflow-analytics-empty">{{ncfST('Frontend.NeuCharWorkflow.NoWorkflowRunsInTheCurrentFilterRange')}}</div>
    </section>
</div>

@section scripts {
    @await Html.PartialAsync("_LocalizationScripts")
    <script src="~/js/NeuCharWorkflow/common.js" asp-append-version="true"></script>
    <script src="~/js/NeuCharWorkflow/Analytics.js" asp-append-version="true"></script>
}
