@page
@model Senparc.Web.Pages.Install.IndexModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>NCF 安装</title>
    <style>

        body, a {
            color: #535353;
        }

        h2 {
            text-align: center;
            color: #09c821;
            margin: 30px 0px;
        }

        a {
            text-decoration-line: underline;
        }

        .wrapper {
            width: 50%;
            margin: 50px auto;
        }

        #footer {
            text-align: center;
            position: absolute;
            display: inline-block;
            width: 50%;
            bottom: 10%;
            /*margin: 240px 0px 50px 0px;*/
        }

        .logo {
            text-align: center;
            margin-bottom: 80px;
        }

            .logo img {
                width: 280px;
            }

        a.option_block {
            padding: 15px 20px;
            border: 1px solid #940b91;
            box-shadow: 0 0 15px #940b91;
            margin: 30px auto;
            clear: both;
            overflow: hidden;
            display: block;
            width: 200px;
            text-align: center;
            text-decoration: none;
        }

            a.option_block:hover {
                background: #610f6a;
                color: #ffffff;
            }

        .install_notice {
            margin: 20px auto;
            text-align: center;
            color: #808080;
            font-size: 80%;
        }

        .install-confirm-mask {
            position: fixed;
            inset: 0;
            display: none;
            align-items: center;
            justify-content: center;
            background: rgba(0, 0, 0, .45);
            z-index: 1000;
        }

        .install-confirm-dialog {
            width: min(420px, calc(100% - 40px));
            padding: 24px;
            border-radius: 8px;
            background: #fff;
            box-shadow: 0 12px 36px rgba(0, 0, 0, .25);
        }

        .install-confirm-actions {
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            margin-top: 24px;
        }
    </style>
    <script>
        function showInstallConfirmation() {
            document.getElementById('install_confirm_mask').style.display = 'flex';
            return false;
        }

        function hideInstallConfirmation() {
            document.getElementById('install_confirm_mask').style.display = 'none';
        }

        function confirmInstall() {
            hideInstallConfirmation();
            document.getElementById('install_form').submit();
        }
    </script>
</head>
<body>
    <div class="wrapper">
        <div class="logo">
            <img src="~/images/logo-login-ncf.png" />
        </div>
        @switch (Model.Step)
        {
            case 0:
                <form method="post" id="install_form">
                    <a href="javascript:void(0);" onclick="return showInstallConfirmation()" class="option_block">立即安装</a>
                    <p class="install_notice">注意：安装完成后此页面将失效！</p>
                </form>
                <div id="install_confirm_mask" class="install-confirm-mask" role="dialog" aria-modal="true" aria-labelledby="install_confirm_title">
                    <div class="install-confirm-dialog">
                        <h3 id="install_confirm_title">确定开始安装吗？</h3>
                        <p>安装完成后，本安装页面将不可继续使用。</p>
                        <div class="install-confirm-actions">
                            <button type="button" onclick="hideInstallConfirmation()">取消</button>
                            <button type="button" onclick="confirmInstall()">立即安装</button>
                        </div>
                    </div>
                </div>
                break;
            case 1:
                <h2>NeuCharFramework<br />初始化安装成功！</h2>
                <div>
                    <p>请保存好以下信息：</p>
                    <p>管理员账号：<strong>@Model.AdminUserName</strong></p>
                    <p>管理员密码：<strong>@Model.AdminPassword</strong></p>
                    <p>注意：本页面已经失效，请保存好管理员账号及密码，密码无法找回明文！</p>
                    <p class="center">&gt; <a asp-page="/Index" asp-area="Admin">点击这里登录</a> &lt;</p>
                </div>
                break;
            default:
                break;
        }
        <div id="footer">
            苏州盛派网络科技有限公司 版权所有
        </div>
    </div>
</body>
</html>

