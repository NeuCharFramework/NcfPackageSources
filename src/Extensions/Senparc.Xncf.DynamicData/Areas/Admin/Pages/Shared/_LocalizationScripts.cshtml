@using System.Text.Json
@using Microsoft.Extensions.Localization
@using Senparc.Ncf.Core.Localization
@using Senparc.Xncf.DynamicData
@inject IStringLocalizer<DynamicDataResource> XR
@inject IStringLocalizerFactory LocalizationFactory
@{
    var translations = XR.GetAllStrings(includeParentCultures: true)
        .ToDictionary(item => $"DynamicData.{item.Name}", item => item.Value);
    var sourceTranslations = FrontendTranslationCatalog.Get(
        LocalizationFactory,
        typeof(DynamicDataResource));
}
<script>
    window.ncfI18n = Object.assign(window.ncfI18n || {}, @Html.Raw(JsonSerializer.Serialize(translations)));
    window.ncfRegisterSourceTranslations(@Html.Raw(JsonSerializer.Serialize(sourceTranslations)));
</script>
