@page
@model Senparc.Xncf.DynamicData.Areas.DynamicData.Pages.Index
@{
    ViewData["Title"] = XR["Frontend.DynamicData.DynamicDataHome"];
    Layout = "_Layout_Vue";
}

@section breadcrumbs{
    <el-breadcrumb-item>@XR["Area.Extensions"]</el-breadcrumb-item>
    <el-breadcrumb-item>@XR["Module.DynamicData.MenuName"]</el-breadcrumb-item>
    <el-breadcrumb-item>@XR["Area.Home"]</el-breadcrumb-item>
}

<div>
    <el-container>
        <el-header class="module-header">
            <span class="start-title"> <i class="fa fa-dot-circle-o"></i>&nbsp;<span class="module-header-v">{{ ncfST('Area.Home') }}</span></span>
        </el-header>

        <!-- A SideMenu can also be added here -->
        @*<el-aside width="200px">
            <el-menu background-color="#304156" default-active="1"
                        text-color="#bfcbd9" active-text-color="#409eff">
                @(await Html.PartialAsync("_SideMenu"))
            </el-menu>
        </el-aside>*@
        <el-main>
            <h3>@Model.XncfRegister.MenuName / @Model.XncfRegister.Name</h3>
            <h4>@Model.XncfRegister.Description</h4>
            <br />
            <i>{{ ncfST('Frontend.DynamicData.ThisModuleWasGeneratedAutomatically') }}</i>
        </el-main>
    </el-container>
</div>


@section scripts{
    @await Html.PartialAsync("_LocalizationScripts")
    <script>
        new Vue({
            el: "#app"
        });
    </script>
}
