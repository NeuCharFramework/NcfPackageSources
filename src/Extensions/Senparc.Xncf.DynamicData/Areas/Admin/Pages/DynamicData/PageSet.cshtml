@page
@model Senparc.Xncf.DynamicData.Areas.Admin.Pages.DynamicData.PageSetModel
@{
    ViewData["Title"] = XR["Frontend.DynamicData.DynamicDataInterfaceSettings"];
    Layout = "_Layout_Vue";
}

@section Style {
    <link href="~/css/DynamicData/interfaceSet.css" rel="stylesheet" />
    @* <meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests"> *@
}

@section breadcrumbs {
    <el-breadcrumb-item>@XR["Area.Extensions"]</el-breadcrumb-item>
    <el-breadcrumb-item>@XR["Module.DynamicData.MenuName"]</el-breadcrumb-item>
    <el-breadcrumb-item>@XR["Frontend.DynamicData.DynamicDataInterfaceSettings"]</el-breadcrumb-item>
}

<div class="interfaceSet-page">
        <el-button type="primary" icon="el-icon-plus" :size="elSize" @@click="createLayout">{{ ncfST('Frontend.DynamicData.AddAlternate') }}</el-button>
    <section class="df flex-as flex-js cardArea">
        <div v-for="item in layoutList" :key="item.id" class="df-wn flex-dc flex-ac cardItem">
            <img :src="item.thumbnail" :alt="ncfST('Frontend.DynamicData.Thumbnail')" class="cardItem_thumbnail" />
            <div class="cardItem_title">
                {{ item.name }}
            </div>
            <div class="cardItem_description" :title="item.description">
                {{ item.description }}
            </div>
            <div class="df-wn flex-jsb cardItem_operation">
                <span class="cardItem_operation_state" :class="[getStateClass(item.state)]">
                    {{ getStateText(item.state) }}
                </span>
                <el-popover placement="bottom-end" width="80" v-model="item.operationVisible">
                    <div class="cardItem_operation_popover">
                        <div class="cardItem_operation_popover-item" @@click="copyLayout(item)">{{ ncfST('Frontend.DynamicData.CopyLayout') }}</div>
                        <div class="cardItem_operation_popover-item" @@click="viewLayout(item)">{{ ncfST('Frontend.DynamicData.ViewLayout') }}</div>
                        <div class="cardItem_operation_popover-item" @@click="deleteLayout(item)">{{ ncfST('Frontend.DynamicData.Delete') }}</div>
                    </div>
                    <i slot="reference" class="el-icon-more df flex-ac flex-jc stateColor-grey cardItem_operation_operationBtn"></i>
                </el-popover>
            </div>
        </div>
    </section>
</div>

 @section scripts {
    @await Html.PartialAsync("_LocalizationScripts")
    <script src="~/js/DynamicData/lib/axios.min.js"></script>
    <script src="~/js/DynamicData/axios.js"></script>
    <script src="~/js/DynamicData/interfaceSet.js"></script>
}
