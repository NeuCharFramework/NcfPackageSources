@page
@model Senparc.Xncf.AIAgentsHub.Areas.AIAgentsHub.Pages.Index
@{
    ViewData["Title"] = $"{Model.XncfRegister.MenuName} - {XR["Area.Home"]}";
    Layout = "_Layout_Vue";
}

@section breadcrumbs{
    <el-breadcrumb-item>@XR["Area.Extensions"]</el-breadcrumb-item>
    <el-breadcrumb-item>AI Agent Hub</el-breadcrumb-item>
    <el-breadcrumb-item>@XR["Area.Home"]</el-breadcrumb-item>
}

<div>
    <el-container>
        <el-header class="module-header">
            <span class="start-title"> <i class="fa fa-dot-circle-o"></i>&nbsp;<span class="module-header-v">@XR["Area.Home"]</span></span>
        </el-header>

        <!-- 此处也可以加 SideMenu -->
        @*<el-aside width="200px">
            <el-menu background-color="#304156" default-active="1"
                        text-color="#bfcbd9" active-text-color="#409eff">
                @(await Html.PartialAsync("_SideMenu"))
            </el-menu>
        </el-aside>*@
        <el-main>
            <h3>@Model.XncfRegister.MenuName / @Model.XncfRegister.Name</h3>
            <h4>@Model.XncfRegister.Description</h4>
            <br />
            <i>@XR["Page.AutoGeneratedModule"]</i>
        </el-main>
    </el-container>
</div>


@section scripts{
    <script>
        new Vue({
            el: "#app"
        });
    </script>
}
