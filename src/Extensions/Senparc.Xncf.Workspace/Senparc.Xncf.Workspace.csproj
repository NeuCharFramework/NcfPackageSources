<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.2.8</Version>
    <PackageReleaseNotes>      [2026-10-21] v0.1.1 提供按所有者隔离的工作区存储，并持久化元数据
      1、支持工作区创建、文件访问、命令执行与访问策略
      2、描述符支持所有者类型、Agent 模板关联与存储提供方
      3、持久化工作区元数据，并在模块安装时迁移数据库
      [2026-10-24] v0.2.1 复用共享 Docker 隔离运行时
      1、Workspace Docker Agent 通过 IIsolatedRuntimeProvider 启动
      2、与 Sandbox 统一镜像、挂载、网络、资源和安全参数生成
      [2026-10-24] v0.2.0 统一 Workspace Agent 与远程编辑
      1、文件、搜索、补丁与执行统一通过跨平台长驻 Agent
      2、新增 Docker 隔离运行时与 Docker-free NativeAgent 安全回退
      3、新增 DesktopBridge + Admin JWT 双重保护的 VS Code/Cursor 网关
      4、新增 ETag、原子写入、二进制文件、变更流和现代管理页面
      [2026-11-03] v0.2.2 补齐 Workspace 标准 EF 设计时迁移链路
      1、接入 Senparc.Web.DatabasePlant 作为迁移启动项目
      2、补充六类数据库的设计时 DbContext 工厂
      3、支持租户隔离的 Workspace 文件管理、流式大文件上传及持久化
      4、提供工作区文件预览和跨模块文件引用
    [2026-11-03] Add shared contextual documentation for Workspace access boundaries.
    [2026-11-03] Use Senparc.Xncf.WorkspaceAgent and transitive runtime content instead of configuration-dependent copy paths.
      [2026-11-05] v0.2.7 调整 Workspace 首页布局、帮助入口与独立样式
      1、工作区列表由表格改为卡片布局，保留创建、上传进度、文档帮助与设备配对入口
      2、页面收敛为「我的工作区 + 连接指南」，去除运行时状态胶囊、工作区 UUID/属主/存储标签与“安全与协议”区块
      3、工作区列表帮助改为指向创建与上传，不再指向聊天执行权限
      4、首页改为引用独立的 Workspace 样式表
      5、Dependency update from Senparc.Ncf.AreaBase to 0.23.10
      6、Dependency update from Senparc.Ncf.Core to 0.30.4-preview10
      7、Dependency update from Senparc.Ncf.XncfBase to 0.28.2
      [2026-11-11] v0.2.7 统一模块注册显示名称与说明的多语言资源
      1、Register 通过 XncfRegisterText 用稳定资源键和中文基准文本解析菜单名称与模块说明。
      2、补齐模块多语言资源，缺少翻译时沿当前语言、英语、简体中文回退。
      [2026-11-12] v0.2.8 统一 Workspace 模块注册文案与多语言资源
      1、模块注册显示名称与说明使用稳定资源键解析。
      2、补齐 Workspace 资源文案，保持宿主语言切换后的显示一致性。
    </PackageReleaseNotes>
    <AssemblyName>Senparc.Xncf.Workspace</AssemblyName>
    <RootNamespace>Senparc.Xncf.Workspace</RootNamespace>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Senparc.Xncf.Workspace.Tests" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Oracle.EntityFrameworkCore" Version="8.23.60" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.10" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.10" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.2" />
    <PackageReference Include="DM.Microsoft.EntityFrameworkCore" Version="8.0.0.28188" />
    <ProjectReference Include="..\Senparc.Xncf.WorkspaceAgent\Senparc.Xncf.WorkspaceAgent.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Senparc.Xncf.Workspace.Abstractions\Senparc.Xncf.Workspace.Abstractions.csproj" />
    <ProjectReference Include="..\..\Basic\Senparc.Ncf.AreaBase\Senparc.Ncf.AreaBase.csproj" />
    <ProjectReference Include="..\..\Basic\Senparc.Ncf.Core\Senparc.Ncf.Core.csproj" />
    <ProjectReference Include="..\..\Basic\Senparc.Ncf.IsolatedRuntime\Senparc.Ncf.IsolatedRuntime.csproj" />
    <ProjectReference Include="..\..\Basic\Senparc.Ncf.Shared.Abstractions\Senparc.Ncf.Shared.Abstractions.csproj" />
    <ProjectReference Include="..\..\Basic\Senparc.Ncf.XncfBase\Senparc.Ncf.XncfBase.csproj" />
  </ItemGroup>

  <Target Name="IncludeWorkspaceAgentRuntimeFiles" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveProjectReferences">
    <MSBuild Projects="@(_MSBuildProjectReferenceExistent)"
             Targets="GetWorkspaceAgentRuntimeFiles"
             Properties="%(_MSBuildProjectReferenceExistent.SetConfiguration);%(_MSBuildProjectReferenceExistent.SetPlatform);%(_MSBuildProjectReferenceExistent.SetTargetFramework)"
             RemoveProperties="%(_MSBuildProjectReferenceExistent.GlobalPropertiesToRemove);$(_GlobalPropertiesToRemoveFromProjectReferences)"
             Condition="'%(_MSBuildProjectReferenceExistent.Filename)' == 'Senparc.Xncf.WorkspaceAgent'">
      <Output TaskParameter="TargetOutputs" ItemName="WorkspaceAgentRuntimeFiles" />
    </MSBuild>
    <ItemGroup>
      <Content Include="@(WorkspaceAgentRuntimeFiles)"
               TargetPath="%(Filename)%(Extension)"
               CopyToOutputDirectory="PreserveNewest"
               CopyToPublishDirectory="PreserveNewest"
               Pack="false" />
    </ItemGroup>
  </Target>

</Project>
