@page
@using Microsoft.Extensions.Localization
@model Senparc.Xncf.Workspace.Areas.Workspace.Pages.Index
@using Senparc.Xncf.Workspace
@inject IStringLocalizer<WorkspaceResource> XR
@{
    ViewData["Title"] = XR["Area.Menu.Admin"];
    Layout = "_Layout_Vue";
}

@section Style {
    <link rel="stylesheet" href="~/css/Admin/Workspace/Index.css" asp-append-version="true" />
}

@section breadcrumbs {
    <el-breadcrumb-item>@XR["Frontend.001"]</el-breadcrumb-item>
    <el-breadcrumb-item>Workspace</el-breadcrumb-item>
    <el-breadcrumb-item>@XR["Frontend.002"]</el-breadcrumb-item>
}

<div class="workspace-shell">
    <input ref="workspaceUploadInput" type="file" hidden multiple
        @@change="handleWorkspaceUpload" />

    <div class="workspace-hero">
        <div class="workspace-hero-icon"><i class="fa fa-code"></i></div>
        <div>
            <h1>@XR["Frontend.003"]</h1>
            <p>@XR["Frontend.036"]</p>
        </div>
    </div>

    @if (TempData["WorkspaceMessage"] is string message)
    {
        <el-alert class="workspace-alert" title="@message" type="success" show-icon :closable="false"></el-alert>
    }
    @if (TempData["WorkspaceError"] is string error)
    {
        <el-alert class="workspace-alert" title="@error" type="error" show-icon :closable="false"></el-alert>
    }

    <section class="ws-metrics" v-if="report.actorId">
        <article class="ws-metric">
            <span class="ws-metric-kicker">{{ ncfST('Frontend.004') }}</span>
            <strong>{{ report.ownSummary.workspaceCount }}</strong>
            <span class="ws-metric-detail">{{ ncfST('{0} 个文件 · {1}', report.ownSummary.fileCount, formatFileSize(report.ownSummary.usedBytes)) }}</span>
        </article>
        <article class="ws-metric is-other" v-if="report.isSuperAdmin">
            <span class="ws-metric-kicker">{{ ncfST('Frontend.005') }}</span>
            <strong>{{ report.otherSummary.workspaceCount }}</strong>
            <span class="ws-metric-detail">{{ ncfST('{0} 个文件 · {1}', report.otherSummary.fileCount, formatFileSize(report.otherSummary.usedBytes)) }}</span>
        </article>
        <article class="ws-metric is-total" v-if="report.isSuperAdmin">
            <span class="ws-metric-kicker">{{ ncfST('Frontend.006') }}</span>
            <strong>{{ report.visibleSummary.workspaceCount }}</strong>
            <span class="ws-metric-detail">{{ ncfST('{0} 个文件 · {1}', report.visibleSummary.fileCount, formatFileSize(report.visibleSummary.usedBytes)) }}</span>
        </article>
    </section>
    <p class="ws-note" v-if="report.actorId">
        {{ ncfST('Frontend.037', report.actorId, formatFileSize(report.quotaBytes)) }}
        <span v-if="report.isSuperAdmin">{{ ncfST('Frontend.038') }}</span>
    </p>

    <section class="ws-section">
        <div class="ws-section-head">
            <h2>{{ ncfST('Frontend.004') }}<ncf-doc-help topic="workspace.manage"></ncf-doc-help></h2>
            <span class="count-pill">{{ ncfST('Frontend.039', report.ownWorkspaces.length) }}</span>
        </div>

        <form method="post" asp-page-handler="Create" class="ws-create">
            <input type="hidden" name="Uid" value="@Model.Uid" />
            <el-input name="NewWorkspaceName" :placeholder="ncfST('Frontend.040')" maxlength="100" show-word-limit></el-input>
            <button type="submit" class="ws-create-btn">
                <i class="fa fa-plus"></i>{{ ncfST('Frontend.007') }}
            </button>
        </form>

        <div class="ws-empty" v-if="!report.ownWorkspaces.length">
            <i class="fa fa-folder-o"></i>
            <h3>{{ ncfST('Frontend.008') }}</h3>
            <p>{{ ncfST('Frontend.018') }}</p>
        </div>

        <div class="ws-board" v-if="report.ownWorkspaces.length">
            <article class="ws-card" v-for="ws in report.ownWorkspaces" :key="ws.id">
                <header class="ws-card-head">
                    <div class="ws-card-icon"><i class="fa fa-cube"></i></div>
                    <div class="ws-card-title">
                        <h3 :title="ws.name">{{ ws.name }}</h3>
                        <span class="ws-badge is-own" v-if="report.isSuperAdmin">{{ ncfST('Frontend.054') }}</span>
                    </div>
                </header>
                <div class="ws-card-figures">
                    <div><span>{{ ncfST('Frontend.013') }}</span><strong>{{ ws.fileCount }}</strong></div>
                    <div><span>{{ ncfST('Frontend.014') }}</span><strong>{{ ws.directoryCount }}</strong></div>
                    <div><span>{{ ncfST('Frontend.015') }}</span><strong>{{ formatFileSize(ws.usedBytes) }}</strong></div>
                </div>
                <div class="ws-card-usage">
                    <el-progress :percentage="usagePercent(ws)" :stroke-width="6" :show-text="false" :status="usageStatus(ws)"></el-progress>
                    <span>{{ formatFileSize(ws.usedBytes) }} / {{ formatFileSize(ws.quotaBytes) }}</span>
                </div>
                <footer class="ws-card-foot">
                    <div class="ws-card-time">
                        <span :title="formatDate(ws.createdUtc)">{{ ncfST('Frontend.041', relativeTime(ws.createdUtc)) }}</span>
                        <span :title="formatDate(ws.lastAccessedUtc)">{{ ncfST('Frontend.042', relativeTime(ws.lastAccessedUtc)) }}</span>
                    </div>
                    <div class="ws-card-actions">
                        <el-button
                            type="primary"
                            size="small"
                            :loading="manualUploadWorkspaceId === ws.id && manualUploading"
                            :disabled="manualUploading || clearing"
                            @@click="chooseWorkspaceUpload(ws.id)">
                            <i class="el-icon-upload2"></i>{{ ncfST('Frontend.016') }}
                        </el-button>
                        <el-button
                            type="danger"
                            size="small"
                            plain
                            :disabled="manualUploading || clearing"
                            @@click="clearWorkspace(ws)">
                            <i class="fa fa-eraser"></i>{{ ncfST('Frontend.017') }}
                        </el-button>
                    </div>
                </footer>
            </article>
        </div>
    </section>

    <section class="ws-section" v-if="report.isSuperAdmin">
        <div class="ws-section-head">
            <h2>{{ ncfST('Frontend.009') }}</h2>
            <span class="count-pill">{{ ncfST('Frontend.039', report.otherWorkspaces.length) }}</span>
        </div>
        <p class="ws-note">{{ ncfST('Frontend.043') }}</p>
        <div class="ws-empty" v-if="!report.otherWorkspaces.length">
            <i class="fa fa-folder-o"></i>
            <h3>{{ ncfST('Frontend.019') }}</h3>
            <p>{{ ncfST('Frontend.044') }}</p>
        </div>
        <div class="ws-board" v-if="report.otherWorkspaces.length">
            <article class="ws-card is-other" v-for="ws in report.otherWorkspaces" :key="ws.id">
                <header class="ws-card-head">
                    <div class="ws-card-icon"><i class="fa fa-cube"></i></div>
                    <div class="ws-card-title">
                        <h3 :title="ws.name">{{ ws.name }}</h3>
                        <span class="ws-badge is-other">{{ ncfST('Frontend.045', ws.ownerId) }}</span>
                    </div>
                </header>
                <div class="ws-card-figures">
                    <div><span>{{ ncfST('Frontend.013') }}</span><strong>{{ ws.fileCount }}</strong></div>
                    <div><span>{{ ncfST('Frontend.014') }}</span><strong>{{ ws.directoryCount }}</strong></div>
                    <div><span>{{ ncfST('Frontend.015') }}</span><strong>{{ formatFileSize(ws.usedBytes) }}</strong></div>
                </div>
                <div class="ws-card-usage">
                    <el-progress :percentage="usagePercent(ws)" :stroke-width="6" :show-text="false" :status="usageStatus(ws)"></el-progress>
                    <span>{{ formatFileSize(ws.usedBytes) }} / {{ formatFileSize(ws.quotaBytes) }}</span>
                </div>
                <footer class="ws-card-foot">
                    <div class="ws-card-time">
                        <span :title="formatDate(ws.createdUtc)">{{ ncfST('Frontend.041', relativeTime(ws.createdUtc)) }}</span>
                        <span :title="formatDate(ws.lastAccessedUtc)">{{ ncfST('Frontend.042', relativeTime(ws.lastAccessedUtc)) }}</span>
                    </div>
                    <div class="ws-card-actions">
                        <el-button
                            type="danger"
                            size="small"
                            plain
                            :disabled="manualUploading || clearing"
                            @@click="clearWorkspace(ws)">
                            <i class="fa fa-eraser"></i>{{ ncfST('Frontend.017') }}
                        </el-button>
                    </div>
                </footer>
            </article>
        </div>
    </section>

    <section class="ws-section">
        <div class="ws-section-head">
            <h2>{{ ncfST('Frontend.010') }}</h2>
        </div>
        <div class="ws-guide">
            <div>
                <h3><i class="fa fa-desktop"></i>{{ ncfST('Frontend.011') }}</h3>
                <ol class="step-list">
                    <li data-step="1">{{ ncfST('Frontend.046') }}</li>
                    <li data-step="2">{{ ncfST('Frontend.047') }}</li>
                    <li data-step="3">{{ ncfST('Frontend.048') }}</li>
                    <li data-step="4">{{ ncfST('Frontend.049') }}</li>
                </ol>
            </div>
            <div class="ws-guide-side">
                <p>{{ ncfST('Frontend.052') }}</p>
                <a class="el-button ws-pair-btn el-button--default el-button--small" href="/Admin/DesktopBridge/Index?uid=E9A9D870-A285-4BCE-9D4D-26A219C41252">
                    <i class="fa fa-desktop"></i><span>{{ ncfST('Frontend.012') }}</span>
                </a>
            </div>
        </div>
    </section>

    <form method="post" asp-page-handler="Clear" ref="clearForm" class="ws-clear-form">
        <input type="hidden" name="Uid" value="@Model.Uid" />
        <input type="hidden" name="workspaceId" ref="clearWorkspaceId" value="" />
    </form>

    <div class="ws-upload-toast" v-if="manualUploading">
        <div class="toast-file"><i class="fa fa-cloud-upload"></i>{{ manualUploadFileName }}</div>
        <el-progress :percentage="manualUploadProgress" :stroke-width="8" :show-text="true"></el-progress>
    </div>
</div>


@section scripts {
    @await Html.PartialAsync("_LocalizationScripts")
    <script>
        new Vue({
            el: "#app",
            data: function () {
                return {
                    manualUploadWorkspaceId: '',
                    manualUploadFileName: '',
                    manualUploadProgress: 0,
                    manualUploading: false,
                    clearing: false,
                    report: @Html.Raw(Model.ClientReportJson)
                };
            },
            methods: {
                formatDate: function (value) {
                    return value ? new Date(value).toLocaleString() : "—";
                },
                relativeTime: function (value) {
                    if (!value) return "—";
                    var diff = Date.now() - new Date(value).getTime();
                    if (diff < 0) diff = 0;
                    var min = Math.floor(diff / 60000);
                    if (min < 1) return ncfST("刚刚");
                    if (min < 60) return ncfST("{0} 分钟前", min);
                    var hour = Math.floor(min / 60);
                    if (hour < 24) return ncfST("{0} 小时前", hour);
                    var day = Math.floor(hour / 24);
                    if (day < 30) return ncfST("{0} 天前", day);
                    var month = Math.floor(day / 30);
                    if (month < 12) return ncfST("{0} 个月前", month);
                    return ncfST("{0} 年前", Math.floor(month / 12));
                },
                chooseWorkspaceUpload: function (workspaceId) {
                    this.manualUploadWorkspaceId = workspaceId;
                    this.manualUploadProgress = 0;
                    this.$refs.workspaceUploadInput.value = "";
                    this.$refs.workspaceUploadInput.click();
                },
                handleWorkspaceUpload: async function (event) {
                    var files = Array.from(event.target.files || []);
                    event.target.value = "";
                    if (!files.length || !this.manualUploadWorkspaceId) return;

                    this.manualUploading = true;
                    try {
                        var capabilitiesResponse = await service.get(
                            "/api/Senparc.Areas.Admin/WorkspaceFiles/capabilities",
                            { customAlert: true });
                        var capabilities = capabilitiesResponse.data || {};
                        var maxFileBytes = Number(capabilities.maxFileBytes);
                        if (!Number.isFinite(maxFileBytes) || maxFileBytes <= 0) {
                            throw new Error(ncfST("无法取得 Workspace 上传限制。"));
                        }

                        for (var file of files) {
                            if (!file || file.size <= 0 || file.size > maxFileBytes) {
                                throw new Error(ncfST("{0} 为空或超过 {1}。", file.name, this.formatFileSize(maxFileBytes)));
                            }

                            this.manualUploadFileName = file.name;
                            this.manualUploadProgress = 0;
                            var form = new FormData();
                            form.append("file", file, file.name);
                            var response = await service.post(
                                "/api/Senparc.Areas.Admin/WorkspaceFiles/"
                                    + encodeURIComponent(this.manualUploadWorkspaceId) + "/upload",
                                form,
                                {
                                    customAlert: true,
                                    onUploadProgress: function (progressEvent) {
                                        if (progressEvent && progressEvent.total) {
                                            this.manualUploadProgress = Math.min(
                                                100,
                                                Math.round(progressEvent.loaded * 100 / progressEvent.total));
                                        }
                                    }.bind(this)
                                });
                            if (!response.data || !response.data.file) {
                                throw new Error(ncfST("{0} 上传响应无效。", file.name));
                            }
                            this.$message.success(ncfST("{0} 已上传到 Workspace/input。", file.name));
                        }
                    } catch (error) {
                        console.error(ncfST("Workspace 手动上传失败："), error);
                        this.$message.error(
                            (error.response && error.response.data && error.response.data.message)
                            || error.message
                            || ncfST("Workspace 手动上传失败。"));
                    } finally {
                        this.manualUploading = false;
                        this.manualUploadProgress = 0;
                        this.manualUploadFileName = "";
                        this.manualUploadWorkspaceId = "";
                    }
                },
                formatFileSize: function (bytes) {
                    var size = Number(bytes);
                    if (!Number.isFinite(size) || size <= 0) return "0 B";
                    if (size >= 1024 * 1024 * 1024) return (size / (1024 * 1024 * 1024)).toFixed(2) + " GB";
                    if (size >= 1024 * 1024) return (size / (1024 * 1024)).toFixed(1) + " MB";
                    if (size >= 1024) return (size / 1024).toFixed(1) + " KB";
                    return Math.round(size) + " B";
                },
                usagePercent: function (ws) {
                    var quota = Number(ws.quotaBytes);
                    if (!Number.isFinite(quota) || quota <= 0) return 0;
                    return Math.min(100, Math.round(Number(ws.usedBytes) * 100 / quota));
                },
                usageStatus: function (ws) {
                    return Number(ws.usedBytes) > Number(ws.quotaBytes) ? "exception" : "";
                },
                clearWorkspace: function (ws) {
                    if (!ws || !ws.id || this.clearing || this.manualUploading) return;
                    var message = ws.scope === "Other"
                        ? ncfST("这将清空其他管理员 #{0} 的工作区「{1}」。文件会被删除，并恢复为新建时的 input、output、logs 空目录。工作区本身会保留。此操作不可撤销。", ws.ownerId, ws.name)
                        : ncfST("这将清空你自己的工作区「{0}」。文件会被删除，并恢复为新建时的 input、output、logs 空目录。工作区本身会保留。此操作不可撤销。", ws.name);
                    if (!window.confirm(message)) return;
                    this.clearing = true;
                    this.$refs.clearWorkspaceId.value = ws.id;
                    this.$refs.clearForm.submit();
                }
            }
        });
    </script>
}
