<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.1.0-preview1</Version>
    <PackageReleaseNotes>
      [2026-08-13] v0.1.0-preview1 扩展工作流模块的对象与事件契约
      1、新增工作流对象编辑地址、元数据及模块事件契约，支持宿主集成
    </PackageReleaseNotes>
    <AssemblyName>Senparc.Xncf.NeuCharWorkflow.Abstractions</AssemblyName>
    <RootNamespace>Senparc.Xncf.NeuCharWorkflow.Abstractions</RootNamespace>
    <LangVersion>10.0</LangVersion>
    <GeneratePackageOnBuild Condition=" '$(Configuration)' == 'Release' ">true</GeneratePackageOnBuild>
    <Description>NeuChar Workflow module contracts for external workflow objects and notifications.</Description>
    <PackageTags>Senparc,NeuCharFramework,NCF,Workflow</PackageTags>
    <Authors>Senparc</Authors>
    <Owners>Senparc</Owners>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/NeuCharFramework/NcfPackageSources</RepositoryUrl>
    <Configurations>Debug;Release;Test;TemplateRelease</Configurations>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Basic\Senparc.Ncf.Shared.Abstractions\Senparc.Ncf.Shared.Abstractions.csproj" />
  </ItemGroup>
</Project>
