<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.3.2</Version>
    <AssemblyName>Senparc.Xncf.NeuCharWorkflow.Abstractions</AssemblyName>
    <RootNamespace>Senparc.Xncf.NeuCharWorkflow.Abstractions</RootNamespace>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild Condition=" '$(Configuration)' == 'Release' ">true</GeneratePackageOnBuild>
    <GeneratePackageOnBuild Condition="'$(Configuration)'=='TemplateRelease'">true</GeneratePackageOnBuild>
    <Description>NeuChar Workflow module contracts for external workflow objects and notifications.</Description>
    <Copyright>Senparc</Copyright>
    <PackageTags>Senparc,NeuCharFramework,NCF,Workflow,Abstractions</PackageTags>
    <Authors>Senparc</Authors>
    <Owners>Senparc</Owners>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Title>NeuChar workflow Abstractions</Title>
    <PackageIcon>icon.jpg</PackageIcon>
    <PackageReleaseNotes>[2026-08-13] v0.1.0-preview1 Updated module behavior and related support.
        1. Updated module behavior and related support.
        [2026-08-17] v0.2.0 Updated module behavior and related support.
        1. Updated module behavior and related support.
        2. Updated module behavior and related support.
        3. Updated module behavior and related support.
        [2026-08-29] v0.3.0 Updated module behavior and related support.
        1. Updated module behavior and related support.
        2. Updated module behavior and related support.
        [2026-11-03] v0.3.1 Dependency update from Senparc.Ncf.Shared.Abstractions to 0.7.0-preview1
        [2026-11-19] v0.3.2 Localized Workflow designer and runtime surfaces
        1. Updated affected project files while preserving existing public integration behavior.
        2. Standardized related English source comments and package metadata for the current release.
        [2026-11-24] v0.3.2 Enhanced workflow chat tools, editing commands, navigation, and localization behavior.
        1. Updated functional behavior and package metadata for the current module changes.
        2. Preserved existing public APIs and runtime integration while incorporating the related improvements.</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/NeuCharFramework/NcfPackageSources</RepositoryUrl>
    <Configurations>Debug;Release;Test;TemplateRelease</Configurations>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <OutputPath>..\..\BuildOutPut</OutputPath>
    <DefineConstants>$(DefineConstants);RELEASE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <ErrorReport>prompt</ErrorReport>
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='TemplateRelease'">
    <OutputPath>..\..\BuildOutPut</OutputPath>
    <DefineConstants>$(DefineConstants);RELEASE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <ErrorReport>prompt</ErrorReport>
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\icon.jpg" Pack="true" Visible="false" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Basic\Senparc.Ncf.Shared.Abstractions\Senparc.Ncf.Shared.Abstractions.csproj" />
  </ItemGroup>
</Project>
