@page
@model ApplicationsModel
@{
    ViewData["Title"] = XR["Title.Applications"].Value;
    Layout = "_Layout_Vue";
}

@section Style {
    <partial name="_NcbLiveStyle" />
}

@section breadcrumbs {
    <el-breadcrumb-item>@XR["Area.Extensions"]</el-breadcrumb-item>
    <el-breadcrumb-item>@XR["Area.NeuCharBoxLive"]</el-breadcrumb-item>
    <el-breadcrumb-item>@XR["Area.NeuCharBoxLive.Applications"]</el-breadcrumb-item>
}

@* v-pre: visitor text must never be compiled as a Vue template. *@
<div class="ncb" v-pre>
    <h3>@XR["Area.NeuCharBoxLive.Applications"]</h3>
    <partial name="_NcbLiveNav" model="@("Applications")" />
    <p class="muted lead">@XR["App.Lead", Model.PerCodeDaily]</p>

    @if (Model.Rows.Count == 0)
    {
        <p class="muted">@XR["App.None"]</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>@XR["App.Th.Submitted", Model.UsageZone]</th>
                    <th>@XR["App.Th.Email"]</th>
                    <th>@XR["App.Th.Name"]</th>
                    <th>@XR["App.Th.Interest"]</th>
                    <th>@XR["App.Th.Scene"]</th>
                    <th>@XR["App.Th.WouldTry"]</th>
                    <th>@XR["App.Th.Status"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    var a = r.App;
                    <tr id="application-@a.Id" class="@(Model.Approved == a.Id ? "hl" : null)">
                        <td class="nowrap">@AdminTime.InZone16(a.Submitted, Model.Zone)</td>
                        <td>@a.Email</td>
                        <td>@a.Name</td>
                        <td>@a.Interest</td>
                        <td>@a.Scene</td>
                        <td class="text">@a.WouldTry</td>
                        <td>
                            <span class="tag @a.Status">@AdminText.Of(XR, "App.Status.", a.Status)</span>
                            @if (r.Code is { } c)
                            {
                                <div class="nowrap">@c.Code@(c.Disabled ? " " + XR["App.CodeDisabled"].Value : "")</div>
                            }
                            else if (a.CodeId is { } missing)
                            {
                                <div class="muted">@XR["App.CodeMissing", missing]</div>
                            }
                        </td>
                        <td>
                            @if (a.Status != "approved")
                            {
                                <form method="post" class="inline" asp-page-handler="Approve" asp-route-id="@a.Id" asp-route-uid="@Model.Uid">
                                    <button type="submit" class="el-button el-button--primary el-button--mini">@XR["App.Approve"]</button>
                                </form>
                            }
                            @if (a.Status == "new")
                            {
                                <form method="post" class="inline" asp-page-handler="Decline" asp-route-id="@a.Id" asp-route-uid="@Model.Uid"
                                      data-confirm="@XR["App.DeclineConfirm", a.Email]">
                                    <button type="submit" class="el-button el-button--mini">@XR["App.Decline"]</button>
                                </form>
                            }
                            @if (r.Message is { } message)
                            {
                                <textarea id="message-@a.Id" class="msg" readonly>@message</textarea>
                                <button type="button" class="el-button el-button--mini" data-copy="message-@a.Id" data-copied="@XR["Common.Copied"]">@XR["Common.Copy"]</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@section scripts {
    <partial name="_NcbLiveScript" />
}
