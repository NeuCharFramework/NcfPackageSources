@page
@model RunsModel
@using System.Globalization
@{
    ViewData["Title"] = "NeuCharBox Live - Runs";
    Layout = "_Layout_Vue";
    string N(long n) => n.ToString("N0", CultureInfo.InvariantCulture);
    var todayAll = RunsModel.Sum(Model.TodayTotals);
    var allTime = RunsModel.Sum(Model.AllTotals);
}

@section Style {
    <partial name="_NcbLiveStyle" />
}

@section breadcrumbs {
    <el-breadcrumb-item>@XR["Area.Extensions"]</el-breadcrumb-item>
    <el-breadcrumb-item>NeuCharBox Live</el-breadcrumb-item>
    <el-breadcrumb-item>Runs</el-breadcrumb-item>
}

@* v-pre: request text, plans and summaries are visitor and model text and must never be compiled as a Vue template. *@
<div class="ncb" v-pre>
    <h3>Runs</h3>
    <partial name="_NcbLiveNav" model="@("Runs")" />

    <p class="lead">
        <b>Token spend today</b> (usage day @Model.Today.ToString("yyyy-MM-dd"), @Model.UsageZone):
        @N(Model.TokensToday) of @N(Model.DailyTokenBudget) tokens (DailyTokenBudget).
        <span class="muted">Finished runs only; the kill switch also counts runs still in flight.</span>
    </p>
    <p class="lead">
        <a asp-page-handler="Csv" asp-route-uid="@Model.Uid">Download every run as CSV</a>
        <span class="muted">(UTF-8, times in UTC, for the handover cost estimate)</span>
    </p>

    @foreach (var (title, rows, sum) in new[] { ("Today", Model.TodayTotals, todayAll), ("All time", Model.AllTotals, allTime) })
    {
        <h4>@title</h4>
        @if (rows.Count == 0)
        {
            <p class="muted">No runs.</p>
        }
        else
        {
            <table class="small">
                <thead>
                    <tr>
                        <th>Model</th>
                        <th class="num">Requests</th>
                        <th class="num">of which what-ifs</th>
                        <th class="num">Prompt tokens</th>
                        <th class="num">Completion tokens</th>
                        <th class="num">Tokens</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in sum is null ? rows : rows.Append(sum))
                    {
                        <tr>
                            <td>@t.Model</td>
                            <td class="num">@N(t.Runs)</td>
                            <td class="num">@N(t.WhatIfs)</td>
                            <td class="num">@N(t.PromptTokens)</td>
                            <td class="num">@N(t.CompletionTokens)</td>
                            <td class="num">@N(t.Tokens)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }

    <h4>Latest @RunsModel.Shown runs</h4>
    @if (Model.Rows.Count == 0)
    {
        <p class="muted">No runs yet.</p>
    }
    else
    {
        <p class="muted lead">Newest first. Request text, plans and summaries are blanked 30 days after the run; the numbers stay.
            "running" means no end yet; "unfinished" means the server stopped before the run ended.</p>
        <table>
            <thead>
                <tr>
                    <th class="num">#</th>
                    <th>Started (ET)</th>
                    <th>Code</th>
                    <th>Scene</th>
                    <th>Request</th>
                    <th>Plan and summary</th>
                    <th>Outcome</th>
                    <th class="num">Calls</th>
                    <th class="num">Tokens (prompt + completion)</th>
                    <th class="num">Latency</th>
                    <th>Model</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    var s = r.Start;
                    var e = r.End;
                    var status = RunStatus.Of(r, RunStatus.ProcessStarted);
                    <tr>
                        <td class="num">@r.Id</td>
                        <td class="nowrap">@AdminTime.Eastern16(s.Started)</td>
                        <td class="nowrap">@s.Code</td>
                        <td>@s.Scene</td>
                        <td class="text">
                            @if (string.IsNullOrEmpty(s.Text))
                            {
                                <span class="muted">(blanked)</span>
                            }
                            else
                            {
                                @s.Text
                            }
                            @if (s.WhatIf)
                            {
                                <div><span class="tag">what-if: @s.WhatIfDevice</span></div>
                            }
                        </td>
                        <td class="text">
                            @if (e?.Summary is { Length: > 0 } summary)
                            {
                                <div>@summary</div>
                            }
                            @if (e?.PlanJson is { Length: > 0 } plan)
                            {
                                <details>
                                    <summary class="muted">plan</summary>
                                    <pre>@plan</pre>
                                </details>
                            }
                        </td>
                        <td><span class="tag @status">@status</span></td>
                        <td class="num">@(e is null ? "" : N(e.Calls))</td>
                        <td class="num">@(e is null ? "" : $"{N(e.PromptTokens)} + {N(e.CompletionTokens)}")</td>
                        <td class="num">@(e is null ? "" : (e.LatencyMs / 1000.0).ToString("0.0", CultureInfo.InvariantCulture) + " s")</td>
                        <td>@s.Model</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@section scripts {
    <partial name="_NcbLiveScript" />
}
