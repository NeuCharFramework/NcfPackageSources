@page
@model RunsModel
@using System.Globalization
@{
    ViewData["Title"] = XR["Title.Runs"].Value;
    Layout = "_Layout_Vue";
    string N(long n) => n.ToString("N0", CultureInfo.InvariantCulture);
    var allModels = XR["Runs.AllModels"].Value;
    var todayAll = RunsModel.Sum(Model.TodayTotals, allModels);
    var allTime = RunsModel.Sum(Model.AllTotals, allModels);
}

@section Style {
    <partial name="_NcbLiveStyle" />
}

@section breadcrumbs {
    <el-breadcrumb-item>@XR["Area.Extensions"]</el-breadcrumb-item>
    <el-breadcrumb-item>@XR["Area.NeuCharBoxLive"]</el-breadcrumb-item>
    <el-breadcrumb-item>@XR["Area.NeuCharBoxLive.Runs"]</el-breadcrumb-item>
}

@* v-pre: request text, plans and summaries are visitor and model text and must never be compiled as a Vue template. *@
<div class="ncb" v-pre>
    <h3>@XR["Area.NeuCharBoxLive.Runs"]</h3>
    <partial name="_NcbLiveNav" model="@("Runs")" />

    <p class="lead">
        <b>@XR["Runs.SpendToday"]</b>
        @XR["Runs.SpendDetail", Model.Today.ToString("yyyy-MM-dd"), Model.UsageZone, N(Model.TokensToday), N(Model.DailyTokenBudget)]
        <span class="muted">@XR["Runs.SpendNote"]</span>
    </p>
    <p class="lead">
        <a asp-page-handler="Csv" asp-route-uid="@Model.Uid">@XR["Runs.CsvLink"]</a>
        <span class="muted">@XR["Runs.CsvNote"]</span>
    </p>

    @foreach (var (title, rows, sum) in new[] { (XR["Runs.Today"].Value, Model.TodayTotals, todayAll), (XR["Runs.AllTime"].Value, Model.AllTotals, allTime) })
    {
        <h4>@title</h4>
        @if (rows.Count == 0)
        {
            <p class="muted">@XR["Runs.NoRuns"]</p>
        }
        else
        {
            <table class="small">
                <thead>
                    <tr>
                        <th>@XR["Runs.Th.Model"]</th>
                        <th class="num">@XR["Runs.Th.Requests"]</th>
                        <th class="num">@XR["Runs.Th.WhatIfs"]</th>
                        <th class="num">@XR["Runs.Th.PromptTokens"]</th>
                        <th class="num">@XR["Runs.Th.CompletionTokens"]</th>
                        <th class="num">@XR["Runs.Th.Tokens"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in sum is null ? rows : rows.Append(sum))
                    {
                        <tr>
                            <td>@t.Model</td>
                            <td class="num">@N(t.Runs)</td>
                            <td class="num">@N(t.WhatIfs)</td>
                            <td class="num">@N(t.PromptTokens)</td>
                            <td class="num">@N(t.CompletionTokens)</td>
                            <td class="num">@N(t.Tokens)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }

    <h4>@XR["Runs.Latest", RunsModel.Shown]</h4>
    @if (Model.Rows.Count == 0)
    {
        <p class="muted">@XR["Runs.NoneYet"]</p>
    }
    else
    {
        <p class="muted lead">@XR["Runs.Lead"]</p>
        <table>
            <thead>
                <tr>
                    <th class="num">#</th>
                    <th>@XR["Runs.Th.Started", Model.UsageZone]</th>
                    <th>@XR["Runs.Th.Code"]</th>
                    <th>@XR["Runs.Th.Scene"]</th>
                    <th>@XR["Runs.Th.Request"]</th>
                    <th>@XR["Runs.Th.PlanSummary"]</th>
                    <th>@XR["Runs.Th.Outcome"]</th>
                    <th class="num">@XR["Runs.Th.Calls"]</th>
                    <th class="num">@XR["Runs.Th.TokensPC"]</th>
                    <th class="num">@XR["Runs.Th.Latency"]</th>
                    <th>@XR["Runs.Th.Model"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    var s = r.Start;
                    var e = r.End;
                    var status = RunStatus.Of(r, RunStatus.ProcessStarted);
                    <tr>
                        <td class="num">@r.Id</td>
                        <td class="nowrap">@AdminTime.InZone16(s.Started, Model.Zone)</td>
                        <td class="nowrap">@s.Code</td>
                        <td>@s.Scene</td>
                        <td class="text">
                            @if (string.IsNullOrEmpty(s.Text))
                            {
                                <span class="muted">@XR["Runs.Blanked"]</span>
                            }
                            else
                            {
                                @s.Text
                            }
                            @if (s.WhatIf)
                            {
                                <div><span class="tag">@XR["Runs.WhatIf", s.WhatIfDevice ?? ""]</span></div>
                            }
                        </td>
                        <td class="text">
                            @if (e?.Summary is { Length: > 0 } summary)
                            {
                                <div>@summary</div>
                            }
                            @if (e?.PlanJson is { Length: > 0 } plan)
                            {
                                <details>
                                    <summary class="muted">@XR["Runs.Plan"]</summary>
                                    <pre>@plan</pre>
                                </details>
                            }
                        </td>
                        <td><span class="tag @status">@AdminText.Of(XR, "Runs.Outcome.", status)</span></td>
                        <td class="num">@(e is null ? "" : N(e.Calls))</td>
                        <td class="num">@(e is null ? "" : $"{N(e.PromptTokens)} + {N(e.CompletionTokens)}")</td>
                        <td class="num">@(e is null ? "" : (e.LatencyMs / 1000.0).ToString("0.0", CultureInfo.InvariantCulture) + " s")</td>
                        <td>@s.Model</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@section scripts {
    <partial name="_NcbLiveScript" />
}
