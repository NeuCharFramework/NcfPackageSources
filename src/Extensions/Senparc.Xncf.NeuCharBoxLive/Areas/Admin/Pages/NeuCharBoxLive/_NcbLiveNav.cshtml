@model string
@* The four pages; the model is the current page's name. *@
<nav>
    <a asp-page="./Settings" asp-route-uid="@Context.Request.Query["uid"]" class="@(Model == "Settings" ? "on" : null)">@XR["Area.NeuCharBoxLive.Settings"]</a>
    <a asp-page="./Codes" asp-route-uid="@Context.Request.Query["uid"]" class="@(Model == "Codes" ? "on" : null)">@XR["Area.NeuCharBoxLive.Codes"]</a>
    <a asp-page="./Applications" asp-route-uid="@Context.Request.Query["uid"]" class="@(Model == "Applications" ? "on" : null)">@XR["Area.NeuCharBoxLive.Applications"]</a>
    <a asp-page="./Runs" asp-route-uid="@Context.Request.Query["uid"]" class="@(Model == "Runs" ? "on" : null)">@XR["Area.NeuCharBoxLive.Runs"]</a>
</nav>
