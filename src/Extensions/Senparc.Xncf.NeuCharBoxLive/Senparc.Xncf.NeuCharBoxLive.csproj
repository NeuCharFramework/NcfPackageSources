<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.1.0-preview1</Version>
    <PackageReleaseNotes>
      [2026-11-09] v0.1.0-preview1 终审修正：NcbLive 配置值无法转换时模块照常注册（DbContext 不再被跳过）并关闭 Live（config）；模块未在服务时申请与邀请码检查答 503 live_off；NCF 就绪前不读数据库；AI Kernel 读不到时设置页不再抛错；保存后等运行时刷新；未接入 /live/api 时记错误；模型失败日志不带异常对象；不再注册 CORS 服务；旧版键告警
      [2026-11-09] v0.1.0-preview1 加入 NcfPackageSources 解决方案与模拟站点；新增 README 与 Live API 契约文档；菜单名称与说明改走资源文件（英文、简体中文）；补全文件头说明
      [2026-11-09] v0.1.0-preview1 新增设置页作为模块首页（状态、今日用量、试用链接、开关、模型、限额、额外来源）；后台全部文字改走资源文件（英文、简体中文），时间按使用日所在时区显示
      [2026-11-09] v0.1.0-preview1 模块在 UseXncfModule 中自行接入 /live/api 分支（按运行时来源的 CORS、私有网络预检、JSON 404/405），移除隧道守卫，宿主无需改 Program.cs；模块关闭时保留设置中的额外来源
      [2026-11-08] v0.1.0-preview1 Live 只在模块已安装且开放、未启用多租户、设置已启用且选了 AI Kernel 模型时开启（ModuleLiveRuntime，每 5 秒及保存设置后刷新）
      [2026-11-08] v0.1.0-preview1 模型客户端改由 AI Kernel 模型构建（NeuCharAI、AzureOpenAI、OpenAI、DeepSeek），移除 NeuChar 环境变量密钥
      [2026-11-08] v0.1.0-preview1 新增设置表（Senparc_NeuCharBoxLive_Settings）与 LiveSettingsService，补齐六种数据库的迁移
      [2026-11-08] v0.1.0-preview1 首次加入 NcfPackageSources（从 ncb/live 迁移）
    </PackageReleaseNotes>
    <AssemblyName>Senparc.Xncf.NeuCharBoxLive</AssemblyName>
    <RootNamespace>Senparc.Xncf.NeuCharBoxLive</RootNamespace>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <GeneratePackageOnBuild Condition=" '$(Configuration)' == 'Release' ">true</GeneratePackageOnBuild>
    <Description>NeuCharBox live AI demo: invite-only live sessions</Description>
    <Title>NeuCharBox Live</Title>
    <Authors>Senparc</Authors>
    <Owners>Senparc</Owners>
    <Copyright>Senparc</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>Senparc,NeuCharFramework,NCF,Senparc.Xncf.NeuCharBoxLive</PackageTags>
    <PackageIcon>icon.jpg</PackageIcon>
    <RepositoryUrl>https://github.com/NeuCharFramework/NcfPackageSources</RepositoryUrl>
    <Configurations>Debug;Release;Test;TemplateRelease</Configurations>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);XNCF_HAS_DATABASE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <OutputPath>..\..\BuildOutPut</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Senparc.CO2NET.WebApi" Version="2.1.9-preview" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.5.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.6" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- The engine's scenes (Engine/Scenes/*.json) are read through GetManifestResourceStream. -->
    <EmbeddedResource Include="Engine\Scenes\*.json" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Basic\Senparc.Ncf.AreaBase\Senparc.Ncf.AreaBase.csproj" />
    <ProjectReference Include="..\..\Basic\Senparc.Ncf.DatabasePlant\Senparc.Ncf.DatabasePlant.csproj" />
    <ProjectReference Include="..\..\Basic\Senparc.Ncf.Service\Senparc.Ncf.Service.csproj" />
    <ProjectReference Include="..\..\Basic\Senparc.Ncf.XncfBase\Senparc.Ncf.XncfBase.csproj" />
    <ProjectReference Include="..\System\Senparc.Xncf.AreasBase\[5955]Senparc.Xncf.AreasBase.csproj" />
    <ProjectReference Include="..\Senparc.Xncf.AIKernel\Senparc.Xncf.AIKernel.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\icon.jpg" Pack="true" Visible="false" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="App_Data\Database\SenparcConfig.config" />
    <None Include="App_Data\Database\SenparcConfig.config" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Senparc.Xncf.NeuCharBoxLive.Tests" />
  </ItemGroup>
</Project>
