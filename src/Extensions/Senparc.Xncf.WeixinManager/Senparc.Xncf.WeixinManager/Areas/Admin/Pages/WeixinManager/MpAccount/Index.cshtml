@page
@model Senparc.Xncf.WeixinManager.Areas.Admin.WeixinManager.MpAccount_IndexModel
@{
    ViewData["Title"] = XR["Frontend.WeixinManager.OfficialAccountManagement"];
    Layout = "_Layout_Vue";
}

@section breadcrumbs {
    <el-breadcrumb-item>@XR["Frontend.WeixinManager.ExtensionModules"]</el-breadcrumb-item>
    <el-breadcrumb-item>@XR["Frontend.WeixinManager.ModuleManagement"]</el-breadcrumb-item>
    <el-breadcrumb-item>@XR["Frontend.WeixinManager.WeixinManagement"]</el-breadcrumb-item>
    <el-breadcrumb-item>@XR["Frontend.WeixinManager.OfficialAccountManagement"]</el-breadcrumb-item>
}

<div>
    <div class="admin-role">
        <ncf-doc-help topic="weixin.accounts"></ncf-doc-help>
        <div class="filter-container">
            <el-button size="small" class="filter-item" type="primary" icon="el-icon-plus" @@click="add">{{ ncfST('Frontend.WeixinManager.Add') }}</el-button>
            <el-button size="small" class="filter-item" type="danger" icon="el-icon-delete" @@click="del">{{ ncfST('Frontend.WeixinManager.Delete') }}</el-button>
        </div>
        <el-table :data="tableData"
                  border
                  @@selection-change="handleSelectionChange"
                  style="width: 100%">
            <el-table-column type="selection"
                             align="center"
                             width="40">
            </el-table-column>
            <el-table-column align="center"
                             width="45"
                             label="#">
                <template slot-scope="scope">
                    {{ scope.row.id}}
                </template>
            </el-table-column>
            <el-table-column align="center"
                             :label="ncfST('Frontend.WeixinManager.Name')">
                <template slot-scope="scope">
                    {{ scope.row.name}}
                </template>
            </el-table-column>
            <el-table-column align="center"
                             label="AppId">
                <template slot-scope="scope">
                    {{ scope.row.appId}}
                </template>
            </el-table-column>
            <el-table-column align="center"
                             label="AppSecret">
                <template slot-scope="scope">
                    <el-popover placement="top-start"
                                width="180"
                                trigger="hover"
                                :content="scope.row.appSecret">
                        <span slot="reference">
                            <i class="fa fa-map-marker fa-shield"></i> ****
                        </span>
                    </el-popover>
                </template>
            </el-table-column>
            <el-table-column align="center"
                             label="Token">
                <template slot-scope="scope">
                    <el-popover placement="top-start"
                                width="180"
                                trigger="hover"
                                :content="scope.row.token">
                        <span slot="reference">
                            <i class="fa fa-map-marker fa-shield"></i> ****
                        </span>
                    </el-popover>
                </template>
            </el-table-column>

            <el-table-column align="center"
                             label="EncodingAESKey">
                <template slot-scope="scope">
                    <el-popover placement="top-start"
                                width="180"
                                trigger="hover"
                                :content="scope.row.encodingAESKey">
                        <span slot="reference">
                            <i class="fa fa-map-marker fa-shield"></i> ****
                        </span>
                    </el-popover>
                </template>
            </el-table-column>
            <el-table-column align="center"
                             :label="ncfST('Frontend.WeixinManager.Notes')">
                <template slot-scope="scope">
                    {{ scope.row.adminRemark}}
                </template>
            </el-table-column>
            <el-table-column align="center"
                             :label="ncfST('Frontend.WeixinManager.Description')">
                <template slot-scope="scope">
                    {{ scope.row.remark}}
                </template>
            </el-table-column>
            <el-table-column align="center"
                             width="145"
                             :label="ncfST('Frontend.WeixinManager.AddedTime')">
                <template slot-scope="scope">
                    {{formaTableTime(scope.row.addTime)}}
                </template>
            </el-table-column>
            <el-table-column align="center"
                             width="80"
                             :label="ncfST('Frontend.WeixinManager.MessageURL')">
                <template slot-scope="scope">
                    <a :href="'/WeixinMp/'+ scope.row.name + '?parameter=' + scope.row.id" :title="ncfST('Frontend.WeixinManager.YourDomainAlternate') + '/WeixinMp/' + scope.row.name + '?parameter=' + scope.row.id"><i class="fa fa-external-link"></i> {{ ncfST('Frontend.WeixinManager.Open') }}</a>
                </template>
            </el-table-column>
            <el-table-column :label="ncfST('Frontend.WeixinManager.Actions')" align="center" width="200" fixed="right" class-name="ncf-table-actions-column">
                <template slot-scope="scope">
                    <el-button size="mini" type="primary" icon="el-icon-edit"
                               @@click="edit(scope.$index, scope.row)">{{ ncfST('Frontend.WeixinManager.Edit') }}</el-button>
                    <el-button size="mini" type="info" icon="el-icon-user"
                               @@click="openUserMan(scope.row.id)">{{ ncfST('Frontend.WeixinManager.UserManagement') }}</el-button>
                </template>
            </el-table-column>
        </el-table>
        <pagination :total="searchData.total"
                    :page.sync="searchData.pageIndex"
                    :limit.sync="searchData.pageSize"
                    @@pagination="fetchData"></pagination>
    </div>
    <!-- Add/edit modal -->
    <el-dialog :title="dialog.title" :visible.sync="dialog.visible" width="40%" :close-on-click-modal="false">
        <el-form :model="mpAccountForm" :rules="mpAccountRule" ref="ref_mpAccountForm" label-width="140px" class="demo-ruleForm">
            <el-form-item :label="ncfST('Frontend.WeixinManager.OfficialAccountName')" prop="name">
                <el-input v-model="mpAccountForm.name"></el-input>
            </el-form-item>
            <el-form-item label="AppId" prop="appId">
                <el-input v-model="mpAccountForm.appId"></el-input>
            </el-form-item>
            <el-form-item label="AppSecret" prop="appSecret">
                <el-input v-model="mpAccountForm.appSecret"></el-input>
            </el-form-item>
            <el-form-item label="Token" prop="token">
                <el-input v-model="mpAccountForm.token"></el-input>
            </el-form-item>
            <el-form-item label="EncodingAESKey" prop="encodingAESKey">
                <el-input v-model="mpAccountForm.encodingAESKey"></el-input>
            </el-form-item>
            <el-form-item label="PromptRangeCode" prop="promptRangeCode">
                <el-input v-model="mpAccountForm.promptRangeCode"></el-input>
            </el-form-item>
            <el-form-item :label="ncfST('Frontend.WeixinManager.Notes')" prop="adminRemark">
                <el-input v-model="mpAccountForm.adminRemark"></el-input>
            </el-form-item>
            <el-form-item label="URL">
                <template>
                    <p>{{ ncfST('Frontend.WeixinManager.ServerAddressURLConfiguredInTheWeChatAdminConsole') }}</p>
                    <p v-if="dialog.data.id > 0"><a :href="'/WeixinMp/'+ dialog.data.name + '?parameter=' + dialog.data.id"><i class="fa fa-external-link"></i> {{ ncfST('Frontend.WeixinManager.YourDomain') }}/WeixinMp/{{mpAccountForm.name}}?parameter={{dialog.data.id}}</a></p>
                    <p>{{ ncfST('Frontend.WeixinManager.NoteTheOfficialAccountNameMustMatchTheNameInMpMessageHandlerName') }}</p>
                </template>
            </el-form-item>
        </el-form>
        <div slot="footer" class="dialog-footer">
            <el-button @@click="dialog.visible = false">{{ ncfST('Frontend.WeixinManager.Cancel') }}</el-button>
            <el-button :loading="dialog.loading" type="primary" @@click="saveMpAccount">{{ ncfST('Frontend.WeixinManager.Confirm') }}</el-button>
        </div>
    </el-dialog>
</div>
@section scripts {
    @await Html.PartialAsync("_LocalizationScripts")
    <script>
        var app = new Vue({
            el: '#app',
            data: {
                searchData: {
                    pageIndex: 1,
                    pageSize: 10,
                    total: 0
                },
                tableData: [],
                dialog: {
                    visible: false,
                    title: '',
                    loading: false,
                    data: {
                        id: 0
                    }
                },
                mpAccountForm: {
                    name: '',
                    appId: '',
                    appSecret: '',
                    token: '',
                    encodingAESKey: '',
                    promptRangeCode: '',
                    adminRemark: ''
                },
                mpAccountRule: {
                    name: [
                        { required: true, message: ncfST('Frontend.WeixinManager.EnterOfficialAccountName'), trigger: 'blur' },
                        { min: 1, max: 100, message: ncfST('Frontend.WeixinManager.LengthMustBeBetweenOneAnd100'), trigger: 'blur' }
                    ],
                    appId: [
                        { required: true, message: ncfST('Frontend.WeixinManager.EnterAppId'), trigger: 'blur' },
                        { min: 1, max: 100, message: ncfST('Frontend.WeixinManager.LengthMustBeBetweenOneAnd100'), trigger: 'blur' }
                    ],
                    appSecret: [
                        { required: true, message: ncfST('Frontend.WeixinManager.EnterAppSecret'), trigger: 'blur' },
                        { min: 1, max: 100, message: ncfST('Frontend.WeixinManager.LengthMustBeBetweenOneAnd100'), trigger: 'blur' }
                    ],
                    token: [
                        { required: true, message: ncfST('Frontend.WeixinManager.EnterToken'), trigger: 'blur' },
                        { min: 1, max: 500, message: ncfST('Frontend.WeixinManager.LengthMustBeBetweenOneAnd500'), trigger: 'blur' }
                    ],
                    encodingAESKey: [
                        { min: 0, max: 500, message: ncfST('Frontend.WeixinManager.LengthMustBeBetweenOneAnd500'), trigger: 'blur' }
                    ],
                    promptRangeCode: [
                        { min: 0, max: 500, message: ncfST('Frontend.WeixinManager.LengthMustBeBetweenOneAnd100'), trigger: 'blur' }
                    ],
                    adminRemark: [
                        { min: 0, max: 100, message: ncfST('Frontend.WeixinManager.LengthMustBeBetweenOneAnd100'), trigger: 'blur' }
                    ]
                },
                uid: '',
                multipleSelection: []
            },
            mounted() {
            },
            created() {
                this.fetchData();
                this.uid = resizeUrl().uid;
            },
            methods: {
                // Open user management.
                openUserMan(id) {
                    window.location.href='/Admin/WeixinManager/WeixinUser?mpid=' + id + '&uid=' + this.uid
            },
                fetchData: function () {
                    return service.get(`@Url.Page("Index")?handler=Ajax&pageIndex=${this.searchData.pageIndex}&pageSize=${this.searchData.pageSize}`).then(res => {
                        var responseData = res.data.data;
                        responseData.list.map(ele => {
                            ele.selected = false;
                        })
                        this.tableData = responseData.list;
                        this.searchData.total = responseData.count;
                    });
                },
                add: function () {
                    this.dialog.visible = true;
                    this.dialog.title = ncfST('Frontend.WeixinManager.AddOfficialAccount');
                    this.dialog.data.id = 0;
                    this.mpAccountForm = {
                        name: '',
                        appId: '',
                        appSecret: '',
                        token: '',
                        encodingAESKey: '',
                        promptRangeCode: '',
                        adminRemark: ''
                    }
                },
                edit: function (index, row) {
                    this.dialog.data.id = row.id;
                    this.dialog.visible = true;
                    this.dialog.title = ncfST('Frontend.WeixinManager.EditOfficialAccount');
                    service.get('@Url.Page("Edit")?handler=Ajax&id=' + row.id).then(res => {
                        const responseData = res.data.data;
                        //debugger
                        this.mpAccountForm = {
                            name: responseData.name,
                            appId: responseData.appId,
                            appSecret: responseData.appSecret,
                            token: responseData.token,
                            encodingAESKey: responseData.encodingAESKey,
                            promptRangeCode: responseData.promptRangeCode,
                            adminRemark: responseData.adminRemark
                        }
                    });
                },
                //users: function (index, row) {
                //    //
                //},
                saveMpAccount: function () {
                    // Save.
                    var obj = JSON.parse(JSON.stringify(this.mpAccountForm));
                    obj.id = this.dialog.data.id;
                    this.$refs.ref_mpAccountForm.validate().then(res => {
                        return service.post('@Url.Page("Edit")?handler=Ajax', obj);
                    }).then(res => {
                        var message = ncfST('Frontend.WeixinManager.OfficialAccountAddedSuccessfully');
                        if (this.dialog.data.id > 0) {
                            message = ncfST('Frontend.WeixinManager.OfficialAccountUpdatedSuccessfully');
                        }
                        this.$notify({
                            title: ncfST('Frontend.WeixinManager.Success'),
                            message: message,
                            type: 'success',
                            duration: 2000
                        });
                        this.dialog.visible = false;
                        return this.fetchData();
                    }).catch(e => {
                        console.info(e);
                    });
                },
                del: function () {
                    var delIds = this.multipleSelection;
                    if (delIds.length === 0) {
                        this.$notify({
                            title: ncfST('Frontend.WeixinManager.Warning'),
                            message: ncfST('Frontend.WeixinManager.SelectAtLeastOneOfficialAccount'),
                            type: 'warning',
                            duration: 2000
                        });
                        return;
                    }

                    var ids = [];
                    delIds.forEach(ele => {
                        ids.push(ele.id);
                    })

                    app.$confirm(ncfST('Frontend.WeixinManager.DeleteAllSelectedItems'), { type: 'warning' }).then(res => {
                        return service.post('@Url.Page("Index")?handler=Delete', ids);
                    }).then(res => {
                        this.$notify({
                            title: ncfST('Frontend.WeixinManager.Success'),
                            message: ncfST('Frontend.WeixinManager.SuccessfullyDeletedValueItems', ids.length),
                            type: 'success',
                            duration: 2000
                        });
                        return this.fetchData();
                    }).catch(e => {
                        //
                    })
                },
                handleSelectionChange(val) {
                    this.multipleSelection = val;
                }
            }
        });
    </script>
}
