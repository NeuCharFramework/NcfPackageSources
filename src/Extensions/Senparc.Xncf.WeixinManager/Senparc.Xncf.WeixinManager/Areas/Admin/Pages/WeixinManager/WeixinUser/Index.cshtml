@page
@model Senparc.Xncf.WeixinManager.Areas.Admin.WeixinManager.WeixinUser_IndexModel
@{
    //var namePrefix = Model.MpAccountDto != null ? $"{Model.MpAccountDto.Name}'s" : "All";
    //ViewData["Title"] = $"{namePrefix} users";
    Layout = "_Layout_Vue";
}
@section breadcrumbs {
    <el-breadcrumb-item>{{ ncfST('Frontend.WeixinManager.ExtensionModules') }}</el-breadcrumb-item>
    <el-breadcrumb-item>{{ ncfST('Frontend.WeixinManager.ModuleManagement') }}</el-breadcrumb-item>
    <el-breadcrumb-item>{{ ncfST('Frontend.WeixinManager.WeixinManagement') }}</el-breadcrumb-item>
    <el-breadcrumb-item>{{docTitle}}</el-breadcrumb-item>
}

<div id="app" v-cloak>
    <div class="admin-role">
        <div class="filter-container">
            <template v-if="mpAccountDto">
                <el-button size="small" class="filter-item" type="primary" icon="el-icon-plus" :loading="addLoading" @@click="addUser('add')">{{ ncfST('Frontend.WeixinManager.AddNewFollowers') }}</el-button>
                <el-button size="small" class="filter-item" type="primary" @@click="asyncUser" :loading="isLoading"><i class="fa fa-exchange"></i> {{ ncfST('Frontend.WeixinManager.SyncAllFollowers') }}</el-button>
                <el-button size="small" class="filter-item" type="danger" icon="el-icon-delete" @@click="del">{{ ncfST('Frontend.WeixinManager.Delete') }}</el-button>
                <span><small>{{ ncfST('Frontend.WeixinManager.NoteIfThereAreManyUsersThisMayTakeAVeryLong') }}</small></span>
            </template>
        </div>
        <el-table :data="tableData"
                  border
                  @@selection-change="handleSelectionChange"
                  style="width: 100%">
            <el-table-column type="selection"
                             align="center"
                             width="40">
            </el-table-column>
            <el-table-column align="center"
                             width="45"
                             label="#">
                <template slot-scope="scope">
                    {{ scope.row.id}}
                </template>
            </el-table-column>
            <el-table-column align="center"
                             :label="ncfST('Frontend.WeixinManager.Nickname')">
                <template slot-scope="scope">
                    {{ scope.row.nickName}}
                </template>
            </el-table-column>
            <el-table-column align="center"
                             width="65"
                             :label="ncfST('Frontend.WeixinManager.Avatar')">
                <template slot-scope="scope">
                    <el-image style="width: 50px; height: 50px"
                              :src="scope.row.headImgUrl"></el-image>
                </template>
            </el-table-column>

            <el-table-column align="center"
                             :label="ncfST('Frontend.WeixinManager.Gender')">
                <template slot-scope="scope">
                    <span v-if="scope.row.sex == 1">{{ ncfST('Frontend.WeixinManager.Male') }}</span>
                    <span v-if="scope.row.sex == 2">{{ ncfST('Frontend.WeixinManager.Female') }}</span>
                    <span v-if="scope.row.sex != 2 && scope.row.sex != 1">{{ ncfST('Frontend.WeixinManager.Unknown') }}</span>
                </template>
            </el-table-column>

            <el-table-column align="center"
                             :label="ncfST('Frontend.WeixinManager.Region')">
                <template slot-scope="scope">
                    {{scope.row.country}}&nbsp;
                    {{scope.row.province}}&nbsp;
                    {{scope.row.city}}
                </template>
            </el-table-column>

            <el-table-column align="center"
                             :label="ncfST('Frontend.WeixinManager.Group')">
                <template slot-scope="scope">
                    {{ scope.row.groupid}}
                </template>
            </el-table-column>
            <el-table-column align="center"
                             :label="ncfST('Frontend.WeixinManager.FollowedAt')">
                <template slot-scope="scope">
                    {{ formaTableTime(scope.row.subscribe_Time)}}
                </template>
            </el-table-column>

            <el-table-column align="center"
                             :label="ncfST('Frontend.WeixinManager.FollowStatus')">
                <template slot-scope="scope">
                    <span v-if="scope.row.subscribe == 1">{{ ncfST('Frontend.WeixinManager.Following') }}</span>
                    <span v-if="scope.row.subscribe != 1">{{ ncfST('Frontend.WeixinManager.NotFollowing') }}</span>
                </template>
            </el-table-column>
            <el-table-column align="center"
                             :label="ncfST('Frontend.WeixinManager.FollowSource')">
                <template slot-scope="scope">
                    {{scope.row.subscribe_Scene}}
                </template>
            </el-table-column>
            <el-table-column align="center"
                             :label="ncfST('Frontend.WeixinManager.Tags')">
                <template slot-scope="scope">
                    <template v-if="scope.row.userTags_WeixinUsers.length == 0">
                        {{ ncfST('Frontend.WeixinManager.None') }}
                    </template>
                    <template v-if="scope.row.userTags_WeixinUsers.length > 0">
                        <ul>
                            <li v-for="item in scope.row.userTags_WeixinUsers">
                                {{item.userTag.name}}
                            </li>
                        </ul>
                    </template>
                </template>
            </el-table-column>
            <el-table-column align="center"
                             :label="ncfST('Frontend.WeixinManager.Notes')">
                <template slot-scope="scope">
                    {{scope.row.adminRemark}}
                </template>
            </el-table-column>
            <el-table-column align="center"
                             :label="ncfST('Frontend.WeixinManager.Description')">
                <template slot-scope="scope">
                    {{scope.row.adminRemark}}
                </template>
            </el-table-column>
            <el-table-column align="center"
                             width="145"
                             :label="ncfST('Frontend.WeixinManager.AddedTime')">
                <template slot-scope="scope">
                    {{formaTableTime(scope.row.addTime)}}
                </template>
            </el-table-column>
            @*<el-table-column label="Actions" align="center" width="100"fixed="right">
                <template slot-scope="scope">
                    <el-popconfirm placement="top" title="Confirm deleting this user?" @@on-confirm="deleteCheck(scope.$index, scope.row)">
                        <el-button size="mini" type="danger" slot="reference">Delete</el-button>
                    </el-popconfirm>
                </template>
            </el-table-column>*@
        </el-table>
        <pagination :total="searchData.total"
                    :page.sync="searchData.pageIndex"
                    :limit.sync="searchData.pageSize"
                    @@pagination="fetchData"></pagination>
    </div>
</div>

@section scripts {
    @await Html.PartialAsync("_LocalizationScripts")
    @*<script src="~/js/Admin/mpaccount.js"></script>*@
    <script>
        var app = new Vue({
            el: '#app',
            data: {
                searchData: {
                    pageIndex: 1,
                    pageSize: 10,
                    total: 0
                },
                tableData: [],
                mpAccountDto: null,
                uid: '',
                multipleSelection: [],
                docTitle: '',
                isLoading: false,
                addLoading:false
            },
            mounted() {
            },
            created() {
                this.fetchData();
                this.uid = resizeUrl().uid;
            },
            methods: {
                fetchData: function () {
                    var mpId = resizeUrl().mpid || null;
                    return service.get(`@Url.Page("Index")?handler=Ajax&pageIndex=${this.searchData.pageIndex}&pageSize=${this.searchData.pageSize}&mpId=${mpId}`).then(res => {
                        var responseData = res.data.data;
                        responseData.weixinUserDtos.list.map(ele => {
                            ele.selected = false;
                            //subscribe_Time
                            ele.subscribeTime = '';
                        })
                        this.tableData = responseData.weixinUserDtos.list;
                        this.mpAccountDto = responseData.mpAccountDto;
                        this.searchData.total = responseData.weixinUserDtos.count;
                        this.docTitle = this.mpAccountDto !== null
                            ? ncfT('WeixinManager.User.AccountUsers', this.mpAccountDto.name)
                            : ncfT('WeixinManager.User.AllUsers');
                        document.title = this.docTitle;
                    });
                },
                deleteCheck: function (index, row) {
                    //
                },
                addUser: function (synctype) {
                      if (synctype === 'all') {
                        this.isLoading = true;
                    } else {
                        this.addLoading = true;
                    }
                    var mpId = resizeUrl().mpid;
                    return service.get(`@Url.Page("Index")?handler=SyncUser&mpId=${mpId}&synctype=${synctype}`).then(res => {
                        this.isLoading = false;
                        this.addLoading = false;
                        return this.fetchData();
                    }).catch(e => {
                        this.isLoading = false;
                        this.addLoading = false;
                    });
                },
                asyncUser: function () {
                    this.addUser('all');
                },
                handleSelectionChange(val) {
                    this.multipleSelection = val;
                },
                del: function () {
                    var delIds = this.multipleSelection;
                    if (delIds.length === 0) {
                        this.$notify({
                            title: ncfST('Frontend.WeixinManager.Warning'),
                            message: ncfST('Frontend.WeixinManager.SelectAtLeastOneOfficialAccount'),
                            type: 'warning',
                            duration: 2000
                        });
                        return;
                    }

                    var ids = [];
                    delIds.forEach(ele => {
                        ids.push(ele.id);
                    })

                    app.$confirm(ncfST('Frontend.WeixinManager.DeleteAllSelectedItems'), { type: 'warning' }).then(res => {
                        return service.post('@Url.Page("Index")?handler=Delete', ids);
                    }).then(res => {
                        this.$notify({
                            title: ncfST('Frontend.WeixinManager.Success'),
                            message: ncfST('Frontend.WeixinManager.SuccessfullyDeletedValueItems', ids.length),
                            type: 'success',
                            duration: 2000
                        });
                        return this.fetchData();
                    }).catch(e => {
                        //
                    })
                },
            }
        });
    </script>
}
