@using System.Text.Json
@using Microsoft.Extensions.Localization
@using Senparc.Ncf.Core.Localization
@using Senparc.Xncf.WeixinManager
@inject IStringLocalizer<WeixinManagerResource> XR
@inject IStringLocalizerFactory LocalizationFactory
@{
    var translations = XR.GetAllStrings(true).ToDictionary(x => $"WeixinManager.{x.Name}", x => x.Value);
    var sourceTranslations = FrontendTranslationCatalog.Get(
        LocalizationFactory,
        typeof(WeixinManagerResource));
}
<script>
    window.ncfI18n = Object.assign(window.ncfI18n || {}, @Html.Raw(JsonSerializer.Serialize(translations)));
    window.ncfRegisterSourceTranslations(@Html.Raw(JsonSerializer.Serialize(sourceTranslations)), "WeixinManager");
</script>
