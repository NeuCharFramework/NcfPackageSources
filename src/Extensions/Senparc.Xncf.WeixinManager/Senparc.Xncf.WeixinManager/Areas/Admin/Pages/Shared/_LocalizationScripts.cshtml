@using System.Text.Json
@using Microsoft.Extensions.Localization
@using Senparc.Xncf.WeixinManager
@inject IStringLocalizer<WeixinManagerResource> XR
@{
    var translations = XR.GetAllStrings(true).ToDictionary(x => $"WeixinManager.{x.Name}", x => x.Value);
    var sourceTranslations = XR.GetAllStrings(true).Where(x => x.Name.StartsWith("Frontend.", StringComparison.Ordinal))
        .Select(x => x.Value.Split(new[] { "||" }, 2, StringSplitOptions.None)).Where(x => x.Length == 2)
        .GroupBy(x => x[0]).ToDictionary(x => x.Key, x => x.First()[1]);
}
<script>
    window.ncfI18n = Object.assign(window.ncfI18n || {}, @Html.Raw(JsonSerializer.Serialize(translations)));
    window.ncfRegisterSourceTranslations(@Html.Raw(JsonSerializer.Serialize(sourceTranslations)));
</script>
