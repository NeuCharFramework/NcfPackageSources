@page
@model Senparc.Xncf.FileManager.Areas.FileManager.Pages.Index
@{
    ViewData["Title"] = "文件资源管理";
    Layout = "_Layout_Vue";
}

@section breadcrumbs {
    <el-breadcrumb-item>扩展模块</el-breadcrumb-item>
    <el-breadcrumb-item>文件资源管理</el-breadcrumb-item>
}

@section Style {
    <link rel="stylesheet" href="~/css/Admin/FileManager/index.css" asp-append-version="true" />
    <style>
        /* ========== 清除父级对布局节点的控制 ========== */
        .el-main.admin-content:has(.file-manager-layout),
        .admin-content:has(.file-manager-layout) {
            all: unset;
            display: block !important;
            box-sizing: border-box !important;
            width: 100% !important;
            height: calc(100vh - 96px) !important;
            padding: 0 !important;
            margin: 0 !important;
            overflow: hidden !important;
            background: #fff !important;
        }

        .admin-content:has(.file-manager-layout) .ifram-wrapper {
            all: unset;
            display: block !important;
            box-sizing: border-box !important;
            width: 100% !important;
            height: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
            overflow: hidden !important;
        }

        /* ========== 根布局：横向 flex ========== */
        .file-manager-layout {
            display: flex !important;
            flex-direction: row !important;
            flex-wrap: nowrap !important;
            align-items: stretch !important;
            box-sizing: border-box !important;
            width: 100% !important;
            height: 100% !important;
            min-height: 480px !important;
            margin: 0 !important;
            padding: 0 !important;
            background: #fff !important;
            overflow: hidden !important;
            float: none !important;
            position: relative !important;
        }

        /* ========== 左栏 / 主区域 ========== */
        .file-manager-layout-left,
        .file-manager-layout-main {
            box-sizing: border-box !important;
            height: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            overflow: hidden !important;
            float: none !important;
            position: relative !important;
        }

        .file-manager-layout-left {
            flex: 0 0 15% !important;
            width: 15% !important;
            max-width: 15% !important;
            border-right: 1px solid #ebeef5 !important;
            background: #f5f7fa !important;
        }

        .file-manager-layout-main {
            flex: 1 1 85% !important;
            width: 85% !important;
            min-width: 0 !important;
            background: #fff !important;
            display: flex !important;
            flex-direction: column !important;
        }

        /* 文件浏览：主区域内再分 树 + 表 */
        .file-manager-layout-main .file-manager-browser {
            display: flex;
            flex-direction: row;
            align-items: stretch;
            box-sizing: border-box;
            width: 100%;
            height: 100%;
            min-height: 0;
            overflow: hidden;
        }

        .file-manager-layout-main .file-manager-tree-wrap {
            flex: 0 0 18%;
            width: 18%;
            max-width: 280px;
            min-width: 180px;
            height: 100%;
            border-right: 1px solid #ebeef5;
            background: #fff;
            overflow: hidden;
        }

        .file-manager-layout-main .file-manager-content-wrap {
            flex: 1 1 auto;
            min-width: 0;
            height: 100%;
            overflow: hidden;
            background: #fff;
        }

        /* ========== 左栏：导航 ========== */
        .file-manager-layout-left .file-manager-nav-panel {
            box-sizing: border-box;
            width: 100%;
            height: 100%;
            overflow-x: hidden;
            overflow-y: auto;
        }

        .file-manager-layout-left .file-manager-nav-list {
            list-style: none;
            margin: 0;
            padding: 8px 0;
        }

        .file-manager-layout-left .file-manager-nav-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 14px;
            font-size: 13px;
            color: #606266;
            cursor: pointer;
            user-select: none;
        }

        .file-manager-layout-left .file-manager-nav-item i {
            width: 16px;
            text-align: center;
            color: #909399;
            font-size: 14px;
        }

        .file-manager-layout-left .file-manager-nav-item:hover {
            color: #303133;
            background: #eef1f6;
        }

        .file-manager-layout-left .file-manager-nav-item.is-active {
            color: #409eff;
            background: #ecf5ff;
            font-weight: 500;
        }

        .file-manager-layout-left .file-manager-nav-item.is-active i {
            color: #409eff;
        }

        .file-manager-layout-left .file-manager-nav-item.is-divider {
            height: 1px;
            padding: 0;
            margin: 8px 14px;
            background: #e4e7ed;
            cursor: default;
            pointer-events: none;
        }

        /* ========== 中栏：目录树 ========== */
        .file-manager-layout-main .file-manager-tree-wrap .file-manager-tree-panel {
            display: flex;
            flex-direction: column;
            box-sizing: border-box;
            width: 100%;
            height: 100%;
            overflow: hidden;
        }

        .file-manager-layout-main .file-manager-tree-wrap .file-manager-org-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            flex-shrink: 0;
            padding: 14px 12px 10px;
            border-bottom: 1px solid #f0f2f5;
        }

        .file-manager-layout-main .file-manager-tree-wrap .file-manager-org-name {
            font-size: 13px;
            font-weight: 600;
            color: #303133;
            line-height: 1.4;
            word-break: break-all;
        }

        .file-manager-layout-main .file-manager-tree-wrap .file-manager-org-toggle {
            flex-shrink: 0;
            color: #909399;
            cursor: pointer;
        }

        .file-manager-layout-main .file-manager-tree-wrap .file-manager-tree-search {
            flex-shrink: 0;
            padding: 8px 10px;
            border-bottom: 1px solid #f0f2f5;
        }

        .file-manager-layout-main .file-manager-tree-wrap .file-manager-tree-body {
            flex: 1;
            min-height: 0;
            overflow: auto;
            padding: 6px 0 12px;
        }

        .file-manager-layout-main .file-manager-tree-wrap .file-manager-root-node {
            display: flex;
            align-items: center;
            gap: 6px;
            margin: 0 8px 4px;
            padding: 7px 10px;
            border-radius: 4px;
            color: #606266;
            cursor: pointer;
            font-size: 13px;
        }

        .file-manager-layout-main .file-manager-tree-wrap .file-manager-root-node:hover,
        .file-manager-layout-main .file-manager-tree-wrap .file-manager-root-node.is-active {
            color: #409eff;
            background: #ecf5ff;
        }

        .file-manager-layout-main .file-manager-tree-wrap .file-manager-tree-node {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            min-width: 0;
        }

        .file-manager-layout-main .file-manager-tree-wrap .file-manager-tree-label {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font-size: 13px;
        }

        .file-manager-layout-main .file-manager-tree-wrap .file-manager-tree-actions {
            display: none;
            white-space: nowrap;
        }

        .file-manager-layout-main .file-manager-tree-wrap .el-tree-node__content:hover .file-manager-tree-actions {
            display: inline-flex;
        }

        .file-manager-layout-main .file-manager-tree-wrap .file-manager-tree-actions .el-button {
            margin-left: 2px;
            padding: 2px;
        }

        .file-manager-layout-main .file-manager-tree-wrap .el-tree {
            background: transparent;
        }

        .file-manager-layout-main .file-manager-tree-wrap .el-tree-node__content {
            height: 32px;
        }

        /* ========== 右栏：文件表 ========== */
        .file-manager-layout-main .file-manager-main-panel {
            display: flex;
            flex-direction: column;
            box-sizing: border-box;
            width: 100%;
            height: 100%;
            overflow: hidden;
        }

        .file-manager-layout-main .file-manager-top-bar {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-shrink: 0;
            padding: 12px 16px;
            border-bottom: 1px solid #f0f2f5;
        }

        .file-manager-layout-main .file-manager-top-search {
            flex: 1;
            max-width: 420px;
            min-width: 0;
        }

        .file-manager-layout-main .file-manager-top-actions {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
        }

        .file-manager-layout-main .file-manager-nav-bar {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
            padding: 10px 16px;
            border-bottom: 1px solid #f0f2f5;
            color: #909399;
            font-size: 13px;
        }

        .file-manager-layout-main .file-manager-back-link {
            color: #409eff;
            text-decoration: none;
            white-space: nowrap;
        }

        .file-manager-layout-main .file-manager-back-link:hover {
            color: #66b1ff;
        }

        .file-manager-layout-main .file-manager-nav-divider {
            color: #dcdfe6;
        }

        .file-manager-layout-main .file-manager-nav-bar .el-breadcrumb {
            line-height: 1;
        }

        .file-manager-layout-main .file-manager-table-wrap {
            flex: 1;
            min-height: 0;
            padding: 0 16px;
            overflow: auto;
        }

        .file-manager-layout-main .file-manager-pagination {
            display: flex;
            justify-content: flex-end;
            flex-shrink: 0;
            padding: 12px 16px;
            border-top: 1px solid #f0f2f5;
        }

        .file-manager-layout-main .file-manager-empty {
            display: flex;
            min-height: 280px;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 12px;
            color: #909399;
        }

        .file-manager-layout-main .file-manager-empty i {
            color: #c0c4cc;
            font-size: 48px;
        }

        .file-manager-layout-main .file-manager-empty strong {
            color: #606266;
            font-size: 14px;
        }

        .file-manager-file-name-cell {
            display: flex;
            flex-direction: column;
            align-items: stretch;
            gap: 6px;
            min-width: 0;
        }

        .file-manager-file-name-main {
            display: flex;
            align-items: center;
            gap: 8px;
            min-width: 0;
        }

        .file-manager-file-name-text {
            flex: 1;
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .file-manager-file-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
            padding-left: 0;
        }

        .file-manager-file-tags .el-tag {
            max-width: 120px;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .file-manager-favorite-star {
            flex-shrink: 0;
            font-size: 16px;
            color: #c0c4cc;
            cursor: pointer;
            line-height: 1;
            transition: color 0.15s ease, transform 0.15s ease;
        }

        .file-manager-favorite-star:hover {
            color: #f7ba2a;
            transform: scale(1.08);
        }

        .file-manager-favorite-star.is-on {
            color: #f7ba2a;
        }

        .file-manager-favorite-name-cell {
            display: flex;
            flex-direction: column;
            gap: 4px;
            min-width: 0;
            padding: 4px 0;
        }

        .file-manager-favorite-name {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            color: #303133;
        }

        .file-manager-favorite-path {
            font-size: 12px;
            color: #909399;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        /* ========== 数据面板：占满 file-manager-layout-main ========== */
        .file-manager-layout-main .file-manager-dashboard-panel {
            box-sizing: border-box;
            flex: 1 1 auto;
            width: 100%;
            height: 100%;
            min-height: 0;
            padding: 12px;
            overflow: auto;
            background: #f0f2f5;
        }

        .file-manager-dashboard-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            grid-template-rows: minmax(300px, 1fr) minmax(300px, 1fr);
            gap: 12px;
            width: 100%;
            height: 100%;
            min-height: calc(100vh - 140px);
        }

        .file-manager-dash-chart {
            flex: 1;
            min-height: 240px;
            width: 100%;
        }

        .file-manager-dash-card {
            display: flex;
            flex-direction: column;
            min-height: 0;
            background: #fff;
            border: 1px solid #e4e7ed;
            border-radius: 4px;
            overflow: hidden;
        }

        .file-manager-dash-card-header {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-shrink: 0;
            padding: 12px 14px 0;
            font-size: 14px;
            font-weight: 600;
            color: #303133;
        }

        .file-manager-dash-card-header .el-icon-question {
            color: #c0c4cc;
            font-size: 14px;
            cursor: help;
        }

        .file-manager-dash-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            flex-wrap: wrap;
            flex-shrink: 0;
            padding: 10px 14px;
        }

        .file-manager-dash-meta {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            flex-wrap: wrap;
            flex-shrink: 0;
            padding: 8px 14px 0;
            font-size: 12px;
            color: #909399;
        }

        .file-manager-dash-used-tag {
            padding: 2px 8px;
            border-radius: 2px;
            background: #f0f9eb;
            color: #67c23a;
            font-size: 12px;
            white-space: nowrap;
        }

        .file-manager-dash-org-list {
            flex: 1;
            min-height: 0;
            margin: 8px 0 0;
            padding: 0 14px 12px;
            overflow: auto;
        }

        .file-manager-dash-org-head,
        .file-manager-dash-org-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 10px 0;
            border-bottom: 1px solid #f0f2f5;
            font-size: 13px;
        }

        .file-manager-dash-org-head {
            color: #909399;
            font-weight: 500;
            position: sticky;
            top: 0;
            background: #fff;
            z-index: 1;
        }

        .file-manager-dash-org-row {
            color: #606266;
        }

        .file-manager-dash-org-name {
            display: flex;
            align-items: center;
            gap: 6px;
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .file-manager-dash-org-name i {
            color: #409eff;
            flex-shrink: 0;
        }

        .file-manager-dash-org-size {
            flex-shrink: 0;
            color: #909399;
        }

        .file-manager-folder-input {
            display: none !important;
        }

        .file-manager-folder-upload-summary,
        .file-manager-upload-target {
            margin: 12px 0;
        }

        .file-manager-upload-note {
            margin-top: 10px;
        }

        /* ========== 上传对话框（图1样式） ========== */
        .file-manager-upload-dialog .el-dialog__header {
            padding: 14px 20px;
            border-bottom: 1px solid #ebeef5;
        }

        .file-manager-upload-dialog .el-dialog__title {
            font-size: 15px;
            font-weight: 600;
            color: #303133;
            line-height: 1.4;
        }

        .file-manager-upload-dialog .el-dialog__body {
            padding: 16px 20px 8px;
        }

        .file-manager-upload-dialog .el-dialog__footer {
            padding: 12px 20px 16px;
            border-top: 1px solid #ebeef5;
        }

        .file-manager-upload-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 12px;
        }

        .file-manager-upload-dropzone {
            width: 100%;
        }

        .file-manager-upload-dropzone .el-upload {
            width: 100%;
        }

        .file-manager-upload-dropzone .el-upload-dragger {
            width: 100%;
            height: 220px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px dashed #c0c4cc;
            border-radius: 4px;
            background: #fff;
        }

        .file-manager-upload-dropzone .el-upload-dragger:hover {
            border-color: #409eff;
        }

        .file-manager-upload-drop-hint {
            color: #c0c4cc;
            font-size: 18px;
            line-height: 1.6;
            text-align: center;
            padding: 0 24px;
            pointer-events: none;
        }

        .file-manager-upload-tip {
            margin-top: 10px;
            color: #909399;
            font-size: 12px;
            line-height: 1.6;
        }

        .file-manager-upload-filelist {
            margin-top: 12px;
            max-height: 180px;
            overflow: auto;
        }

        .file-manager-upload-start-btn {
            background-color: #67c23a !important;
            border-color: #67c23a !important;
            color: #fff !important;
        }

        .file-manager-upload-start-btn:hover,
        .file-manager-upload-start-btn:focus {
            background-color: #85ce61 !important;
            border-color: #85ce61 !important;
            color: #fff !important;
        }

        .file-manager-guide {
            margin: 0;
            padding-left: 22px;
            color: #606266;
            line-height: 1.9;
        }

        /* ========== 设置：占满 file-manager-layout-main ========== */
        .file-manager-layout-main .file-manager-settings-panel {
            box-sizing: border-box;
            flex: 1 1 auto;
            display: flex;
            flex-direction: column;
            width: 100%;
            height: 100%;
            min-height: 0;
            padding: 20px 28px;
            overflow: auto;
            background: #fff;
        }

        .file-manager-settings-title {
            margin: 0 0 8px;
            font-size: 18px;
            font-weight: 600;
            color: #303133;
        }

        .file-manager-settings-desc {
            margin: 0 0 24px;
            font-size: 13px;
            color: #909399;
            line-height: 1.6;
        }

        .file-manager-settings-form {
            max-width: 640px;
        }

        .file-manager-settings-form .el-form-item__label {
            color: #606266;
            font-weight: 500;
        }

        .file-manager-settings-hint {
            margin-top: 6px;
            font-size: 12px;
            color: #909399;
            line-height: 1.5;
        }

        .file-manager-settings-actions {
            margin-top: 8px;
            display: flex;
            gap: 12px;
        }

        /* ========== 标签管理：占满 file-manager-layout-main ========== */
        .file-manager-layout-main .file-manager-tags-panel {
            box-sizing: border-box;
            flex: 1 1 auto;
            display: flex;
            flex-direction: column;
            width: 100%;
            height: 100%;
            min-height: 0;
            padding: 16px 20px;
            overflow: hidden;
            background: #fff;
        }

        .file-manager-tags-filter {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px 16px;
            flex-shrink: 0;
            margin-bottom: 16px;
        }

        .file-manager-tags-filter-item {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .file-manager-tags-filter-item > span {
            color: #606266;
            font-size: 13px;
            white-space: nowrap;
        }

        .file-manager-tags-filter-item .el-input,
        .file-manager-tags-filter-item .el-select {
            width: 200px;
        }

        .file-manager-tags-filter-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .file-manager-tags-toolbar {
            display: flex;
            justify-content: flex-end;
            flex-wrap: wrap;
            gap: 8px;
            flex-shrink: 0;
            margin-bottom: 12px;
        }

        .file-manager-tags-table-wrap {
            flex: 1;
            min-height: 0;
            overflow: auto;
        }

        .file-manager-tags-empty {
            display: flex;
            min-height: 320px;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 12px;
            color: #909399;
        }

        .file-manager-tags-empty i {
            font-size: 48px;
            color: #c0c4cc;
        }

        .file-manager-tags-empty strong {
            color: #606266;
            font-size: 14px;
            font-weight: 400;
        }

        .tag-row-actions {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 8px;
            padding: 8px 12px 8px 48px;
            background: #f5f7fa;
        }

        .tag-row-actions .el-button {
            margin: 0;
            color: #fff;
            background: #606266;
            border-color: #606266;
        }

        .tag-row-actions .el-button:hover,
        .tag-row-actions .el-button:focus {
            background: #909399;
            border-color: #909399;
            color: #fff;
        }

        .file-manager-tags-table-wrap .el-table .el-table__expand-icon {
            color: #909399;
        }

        .file-manager-tags-type-tag {
            border: none;
        }

        /* ========== 回收站：占满 file-manager-layout-main ========== */
        .file-manager-layout-main .file-manager-recycle-panel {
            box-sizing: border-box;
            flex: 1 1 auto;
            display: flex;
            flex-direction: column;
            width: 100%;
            height: 100%;
            min-height: 0;
            padding: 0;
            overflow: hidden;
            background: #fff;
        }

        .file-manager-recycle-header {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            flex-shrink: 0;
            padding: 12px 16px;
            border-bottom: 1px solid #f0f2f5;
            position: relative;
            z-index: 2;
        }

        .file-manager-recycle-empty-dialog .file-manager-recycle-empty-body {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 8px 0 4px;
        }

        .file-manager-recycle-empty-dialog .file-manager-recycle-empty-body > i {
            font-size: 24px;
            color: #e6a23c;
            line-height: 1.2;
            margin-top: 2px;
        }

        .file-manager-recycle-empty-dialog .file-manager-recycle-empty-text strong {
            display: block;
            font-size: 16px;
            color: #303133;
            font-weight: 500;
            margin-bottom: 8px;
        }

        .file-manager-recycle-empty-dialog .file-manager-recycle-empty-text p {
            margin: 0;
            color: #606266;
            font-size: 14px;
        }

        .file-manager-recycle-table-wrap {
            flex: 1;
            min-height: 0;
            overflow: auto;
            padding: 0 16px;
        }

        .file-manager-recycle-empty {
            display: flex;
            min-height: 360px;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 12px;
            color: #909399;
        }

        .file-manager-recycle-empty i {
            font-size: 52px;
            color: #c0c4cc;
        }

        .file-manager-recycle-empty strong {
            color: #606266;
            font-size: 14px;
            font-weight: 400;
        }

        .file-manager-recycle-pagination {
            display: flex;
            justify-content: flex-end;
            flex-shrink: 0;
            padding: 12px 16px;
            border-top: 1px solid #f0f2f5;
        }

        /* ========== 收藏：占满 file-manager-layout-main ========== */
        .file-manager-layout-main .file-manager-favorite-panel {
            box-sizing: border-box;
            flex: 1 1 auto;
            display: flex;
            flex-direction: column;
            width: 100%;
            height: 100%;
            min-height: 0;
            padding: 0;
            overflow: hidden;
            background: #fff;
        }

        .file-manager-favorite-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-shrink: 0;
            padding: 12px 16px;
            border-bottom: 1px solid #f0f2f5;
        }

        .file-manager-favorite-search {
            flex: 1;
            max-width: 420px;
            min-width: 0;
        }

        .file-manager-favorite-table-wrap {
            flex: 1;
            min-height: 0;
            overflow: auto;
            padding: 0 16px;
        }

        .file-manager-favorite-empty {
            display: flex;
            min-height: 360px;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 12px;
            color: #909399;
        }

        .file-manager-favorite-empty i {
            font-size: 52px;
            color: #c0c4cc;
        }

        .file-manager-favorite-empty strong {
            color: #606266;
            font-size: 14px;
            font-weight: 400;
        }

        .file-manager-favorite-pagination {
            display: flex;
            justify-content: flex-end;
            flex-shrink: 0;
            padding: 12px 16px;
            border-top: 1px solid #f0f2f5;
        }

        /* ========== 首页：占满 file-manager-layout-main ========== */
        .file-manager-layout-main .file-manager-home-panel {
            box-sizing: border-box;
            flex: 1 1 auto;
            display: flex;
            flex-direction: column;
            width: 100%;
            height: 100%;
            min-height: 0;
            padding: 0;
            overflow: hidden;
            background: #fff;
        }

        .file-manager-home-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-shrink: 0;
            padding: 12px 16px;
            border-bottom: 1px solid #f0f2f5;
        }

        .file-manager-home-search {
            flex: 1;
            max-width: 420px;
            min-width: 0;
        }

        .file-manager-home-actions {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
        }

        .file-manager-home-banner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
            flex-shrink: 0;
            margin: 16px;
            padding: 24px 28px;
            border-radius: 8px;
            background: linear-gradient(90deg, #eef4ff 0%, #f3e9ff 55%, #e8f3ff 100%);
            overflow: hidden;
        }

        .file-manager-home-banner-text {
            flex: 1;
            min-width: 0;
        }

        .file-manager-home-banner-text h3 {
            margin: 0 0 10px;
            font-size: 20px;
            font-weight: 600;
            color: #3a5ccc;
            line-height: 1.4;
        }

        .file-manager-home-banner-text p {
            margin: 0;
            font-size: 13px;
            color: #606266;
            line-height: 1.7;
        }

        .file-manager-home-banner-art {
            flex-shrink: 0;
            width: 180px;
            height: 110px;
            border-radius: 8px;
            background: linear-gradient(145deg, #ffffff 0%, #dbe7ff 100%);
            border: 1px solid rgba(64, 158, 255, 0.18);
            box-shadow: 0 8px 20px rgba(64, 158, 255, 0.12);
            position: relative;
        }

        .file-manager-home-banner-art::before,
        .file-manager-home-banner-art::after {
            content: '';
            position: absolute;
            border-radius: 4px;
            background: #fff;
            border: 1px solid #dcdfe6;
        }

        .file-manager-home-banner-art::before {
            left: 18px;
            top: 18px;
            width: 86px;
            height: 64px;
        }

        .file-manager-home-banner-art::after {
            right: 16px;
            bottom: 16px;
            width: 70px;
            height: 52px;
            background: #f5f7fa;
        }

        .file-manager-home-quick-access {
            flex-shrink: 0;
            margin: 16px 16px 0;
        }

        .file-manager-home-quick-title {
            margin: 0 0 12px;
            font-size: 15px;
            font-weight: 600;
            color: #303133;
        }

        .file-manager-home-quick-list {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }

        .file-manager-home-quick-card {
            display: flex;
            align-items: center;
            gap: 10px;
            width: 220px;
            max-width: 100%;
            padding: 10px 12px;
            border: 1px solid #ebeef5;
            border-radius: 6px;
            background: #fff;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
            cursor: default;
        }

        .file-manager-home-quick-card:hover {
            border-color: #c6e2ff;
            background: #f5f9ff;
        }

        .file-manager-home-quick-icon {
            flex-shrink: 0;
            width: 32px;
            height: 32px;
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #e8f5e9;
            color: #67c23a;
            font-size: 18px;
        }

        .file-manager-home-quick-name {
            flex: 1;
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font-size: 13px;
            color: #303133;
        }

        .file-manager-home-quick-more {
            flex-shrink: 0;
            padding: 0;
            color: #909399;
        }

        /* ========== 新增分类 / 新增标签 对话框 ========== */
        .tag-manage-dialog .el-dialog__body {
            padding: 16px 24px 8px;
        }

        .tag-manage-dialog .el-form-item {
            margin-bottom: 18px;
        }

        .tag-manage-name-field {
            position: relative;
        }

        .tag-manage-name-field .el-input__inner {
            padding-right: 42px;
        }

        .tag-manage-lang-badge {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            z-index: 2;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 24px;
            height: 18px;
            padding: 0 4px;
            border-radius: 2px;
            background: #f0f2f5;
            color: #909399;
            font-size: 11px;
            font-weight: 600;
            line-height: 1;
            pointer-events: none;
        }

        .tag-manage-dialog .el-textarea .el-input__count {
            background: transparent;
        }

        .file-manager-home-recent {
            flex: 1;
            min-height: 0;
            display: flex;
            flex-direction: column;
            padding: 0 16px 0;
            overflow: hidden;
        }

        .file-manager-home-recent-title {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-shrink: 0;
            margin-bottom: 10px;
            font-size: 15px;
            font-weight: 600;
            color: #303133;
        }

        /* 文件行「标签管理」对话框 */
        .file-tag-dialog .file-tag-dialog-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 12px;
        }

        .file-tag-dialog .file-tag-dialog-label {
            font-size: 14px;
            color: #303133;
            font-weight: 500;
        }

        .file-tag-dialog .file-tag-dialog-hint {
            margin: 0 0 10px;
            font-size: 12px;
            color: #909399;
            line-height: 1.5;
        }

        .file-tag-dialog .file-tag-dialog-select {
            width: 100%;
            margin-bottom: 12px;
        }

        .file-tag-dialog .file-tag-dialog-box {
            min-height: 100px;
            padding: 12px;
            border: 1px solid #dcdfe6;
            border-radius: 4px;
            background: #fff;
            display: flex;
            flex-wrap: wrap;
            align-content: flex-start;
            gap: 8px;
        }

        .file-tag-dialog .file-tag-dialog-empty {
            width: 100%;
            text-align: center;
            color: #c0c4cc;
            font-size: 13px;
            padding: 28px 0;
            line-height: 1.6;
        }

        .file-manager-home-recent-title i {
            color: #909399;
            cursor: pointer;
        }

        .file-manager-home-table-wrap {
            flex: 1;
            min-height: 0;
            overflow: auto;
        }

        .file-manager-home-empty {
            display: flex;
            min-height: 280px;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 12px;
            color: #909399;
        }

        .file-manager-home-empty i {
            font-size: 52px;
            color: #c0c4cc;
        }

        .file-manager-home-empty strong {
            color: #606266;
            font-size: 14px;
            font-weight: 400;
        }
    </style>
}

<div class="file-manager-layout">
    @Html.AntiForgeryToken()

    @* 左栏 15%：分类导航 *@
    <div class="file-manager-layout-left">
        <nav class="file-manager-nav-panel">
            <ul class="file-manager-nav-list">
                <li class="file-manager-nav-item" :class="{ 'is-active': activeNavKey === 'home' }" @@click="onNavClick({ key: 'home', label: '首页' })">
                    <i class="el-icon-s-home"></i><span>首页</span>
                </li>
                <li class="file-manager-nav-item" :class="{ 'is-active': activeNavKey === 'favorite' }" @@click="onNavClick({ key: 'favorite', label: '收藏' })">
                    <i :class="activeNavKey === 'favorite' ? 'el-icon-star-on' : 'el-icon-star-off'"></i><span>收藏</span>
                </li>
                <li class="file-manager-nav-item" :class="{ 'is-active': activeNavKey === 'enterprise' }" @@click="onNavClick({ key: 'enterprise', label: '企业文档', scope: 100 })">
                    <i class="el-icon-folder"></i><span>企业文档</span>
                </li>
                <li class="file-manager-nav-item" :class="{ 'is-active': activeNavKey === 'recycle' }" @@click="onNavClick({ key: 'recycle', label: '回收站' })">
                    <i class="el-icon-delete"></i><span>回收站</span>
                </li>
                <li class="file-manager-nav-item is-divider"></li>
                <li class="file-manager-nav-item" :class="{ 'is-active': activeNavKey === 'dashboard' }" @@click="onNavClick({ key: 'dashboard', label: '数据面板' })">
                    <i class="el-icon-data-line"></i><span>数据面板</span>
                </li>
                <li class="file-manager-nav-item" :class="{ 'is-active': activeNavKey === 'tags' }" @@click="onNavClick({ key: 'tags', label: '标签管理' })">
                    <i class="el-icon-price-tag"></i><span>标签管理</span>
                </li>
                <li class="file-manager-nav-item" :class="{ 'is-active': activeNavKey === 'settings' }" @@click="onNavClick({ key: 'settings', label: '设置' })">
                    <i class="el-icon-setting"></i><span>设置</span>
                </li>
            </ul>
        </nav>
    </div>

    @* 主区域 85%：文件浏览（树+表）或数据面板 *@
    <div class="file-manager-layout-main">
        <div class="file-manager-browser" v-if="activeNavKey !== 'dashboard' && activeNavKey !== 'tags' && activeNavKey !== 'recycle' && activeNavKey !== 'favorite' && activeNavKey !== 'home' && activeNavKey !== 'settings'">
            <div class="file-manager-tree-wrap">
                <aside class="file-manager-tree-panel">
                    <div class="file-manager-org-header">
                        <span class="file-manager-org-name">山西米立信息技术有限公司</span>
                        <i class="el-icon-s-operation file-manager-org-toggle"></i>
                    </div>
                    <div class="file-manager-tree-search">
                        <el-input
                            v-model="treeFilter"
                            size="small"
                            placeholder="搜索目录"
                            prefix-icon="el-icon-search"
                            clearable>
                        </el-input>
                    </div>
                    <div class="file-manager-tree-body">
                        <div
                            class="file-manager-root-node"
                            :class="{ 'is-active': currentFolderId === null }"
                            @@click="enterFolder(null)">
                            <i class="el-icon-folder-opened"></i>
                            <span>{{ rootFolderName }}</span>
                        </div>
                        <el-tree
                            :key="folderTreeKey"
                            ref="folderTree"
                            :data="folderTree"
                            :props="folderTreeProps"
                            node-key="id"
                            lazy
                            highlight-current
                            :expand-on-click-node="false"
                            :load="loadFolderChildren"
                            :filter-node-method="filterFolderNode"
                            @@node-click="onFolderNodeClick">
                            <span class="file-manager-tree-node" slot-scope="{ node, data }">
                                <span class="file-manager-tree-label"><i class="el-icon-folder"></i> {{ data.name }}</span>
                                <span class="file-manager-tree-actions">
                                    <el-button type="text" icon="el-icon-edit" @@click.stop="showEditFolderDialog(data)"></el-button>
                                    <el-button type="text" icon="el-icon-delete" @@click.stop="deleteFolder(data)"></el-button>
                                </span>
                            </span>
                        </el-tree>
                    </div>
                </aside>
            </div>

            <div class="file-manager-content-wrap">
                <main class="file-manager-main-panel">
                    <div class="file-manager-top-bar">
                        <div class="file-manager-top-search">
                            <el-input
                                v-model="fileSearchKeyword"
                                size="small"
                                placeholder="搜索文件/文件夹"
                                prefix-icon="el-icon-search"
                                clearable>
                            </el-input>
                        </div>
                        <div class="file-manager-top-actions">
                            <el-button size="small" icon="el-icon-refresh" @@click="reloadFolderTree" title="刷新"></el-button>
                            <el-dropdown trigger="click" @@command="handleCreateCommand">
                                <el-button size="small">
                                    新建<i class="el-icon-arrow-down el-icon--right"></i>
                                </el-button>
                                <el-dropdown-menu slot="dropdown">
                                    <el-dropdown-item command="folder">新建文件夹</el-dropdown-item>
                                </el-dropdown-menu>
                            </el-dropdown>
                            <el-dropdown trigger="click" @@command="handleUploadCommand">
                                <el-button type="primary" size="small">
                                    上传<i class="el-icon-arrow-down el-icon--right"></i>
                                </el-button>
                                <el-dropdown-menu slot="dropdown">
                                    <el-dropdown-item command="files">上传文件</el-dropdown-item>
                                    <el-dropdown-item command="folder">上传文件夹</el-dropdown-item>
                                </el-dropdown-menu>
                            </el-dropdown>
                        </div>
                    </div>

                    <div class="file-manager-nav-bar">
                        <a
                            v-if="canGoParent"
                            class="file-manager-back-link"
                            href="javascript:void(0)"
                            @@click="enterParentFolder">返回上一级</a>
                        <span v-if="canGoParent" class="file-manager-nav-divider">|</span>
                        <el-breadcrumb separator="/">
                            <el-breadcrumb-item><a href="javascript:void(0)" @@click="enterFolder(null)">{{ rootFolderName }}</a></el-breadcrumb-item>
                            <el-breadcrumb-item><span>{{ orgName }}</span></el-breadcrumb-item>
                            <el-breadcrumb-item v-for="item in folderPath" :key="item.id">
                                <a href="javascript:void(0)" @@click="enterFolder(item.id)">{{ item.name }}</a>
                            </el-breadcrumb-item>
                        </el-breadcrumb>
                    </div>

                    <div class="file-manager-table-wrap">
                        <el-table :data="displayTableData" v-loading="tableLoading" border stripe>
                            <template slot="empty">
                                <div class="file-manager-empty">
                                    <i class="el-icon-document"></i>
                                    <strong>暂无文档</strong>
                                    <el-button type="primary" size="mini" @@click="showUploadDialog">上传文件</el-button>
                                </div>
                            </template>
                            <el-table-column type="selection" width="48"></el-table-column>
                            <el-table-column label="文件名" min-width="260">
                                <template slot-scope="scope">
                                    <div class="file-manager-file-name-cell">
                                        <div class="file-manager-file-name-main">
                                            <span class="file-manager-file-name-text" :title="scope.row.fileName">{{ scope.row.fileName }}</span>
                                            <i
                                                class="file-manager-favorite-star"
                                                :class="isFileFavorited(scope.row) ? 'el-icon-star-on is-on' : 'el-icon-star-off'"
                                                :title="isFileFavorited(scope.row) ? '取消收藏' : '收藏'"
                                                @@click.stop="toggleFavorite(scope.row)">
                                            </i>
                                        </div>
                                        <div class="file-manager-file-tags" v-if="getFileTagLabels(scope.row).length">
                                            <el-tag
                                                v-for="(tag, index) in getFileTagLabels(scope.row)"
                                                :key="tag + '-' + index"
                                                size="mini"
                                                type="info"
                                                effect="plain">{{ tag }}</el-tag>
                                        </div>
                                    </div>
                                </template>
                            </el-table-column>
                            <el-table-column label="更新者" width="120" show-overflow-tooltip>
                                <template slot-scope="scope">{{ updatedByLabel(scope.row) }}</template>
                            </el-table-column>
                            <el-table-column prop="fileSize" label="大小" width="110">
                                <template slot-scope="scope">{{ formatFileSize(scope.row.fileSize) }}</template>
                            </el-table-column>
                            <el-table-column prop="uploadTime" label="更新时间" width="170">
                                <template slot-scope="scope">{{ dateFormatter(scope.row.uploadTime) }}</template>
                            </el-table-column>
                            <el-table-column label="操作" width="120" fixed="right">
                                <template slot-scope="scope">
                                    <el-dropdown trigger="click" @@command="handleRowCommand($event, scope.row)">
                                        <el-button type="text" size="mini">更多<i class="el-icon-arrow-down el-icon--right"></i></el-button>
                                        <el-dropdown-menu slot="dropdown">
                                            <el-dropdown-item command="download">下载</el-dropdown-item>
                                            <el-dropdown-item v-if="isSiteAsset" command="togglePublish">{{ scope.row.accessLevel === 100 ? '取消公开' : '公开' }}</el-dropdown-item>
                                            <el-dropdown-item v-if="isSiteAsset && scope.row.publicUrl" command="copyUrl">复制 URL</el-dropdown-item>
                                            <el-dropdown-item command="editNote">编辑备注</el-dropdown-item>
                                            <el-dropdown-item command="toggleQuickAccess" icon="el-icon-s-opportunity">
                                                {{ isInQuickAccess(scope.row) ? '从快速访问移除' : '添加至快速访问' }}
                                            </el-dropdown-item>
                                            <el-dropdown-item command="manageTags" icon="el-icon-price-tag">标签管理</el-dropdown-item>
                                            <el-dropdown-item command="delete" divided icon="el-icon-delete">删除</el-dropdown-item>
                                        </el-dropdown-menu>
                                    </el-dropdown>
                                </template>
                            </el-table-column>
                        </el-table>
                    </div>

                    <div class="file-manager-pagination">
                        <el-pagination
                            @@current-change="handleCurrentChange"
                            @@size-change="handleSizeChange"
                            :current-page="page.page"
                            :page-sizes="[10, 20, 30, 40]"
                            :page-size="page.size"
                            layout="total, sizes, prev, pager, next, jumper"
                            :total="total">
                        </el-pagination>
                    </div>
                </main>
            </div>
        </div>

        <div class="file-manager-dashboard-panel" v-if="activeNavKey === 'dashboard' && dashboard">
            <div class="file-manager-dashboard-grid">
                <section class="file-manager-dash-card">
                    <div class="file-manager-dash-card-header">
                        <span>文件库容量统计</span>
                        <i class="el-icon-question" title="仅统计企业文档：展示文件数量与总大小随时间变化"></i>
                    </div>
                    <div class="file-manager-dash-toolbar">
                        <el-radio-group v-model="dashboard.capacityRange" size="mini" @@change="onDashboardRangeChange">
                            <el-radio-button label="7d">过去7天</el-radio-button>
                            <el-radio-button label="30d">过去一个月</el-radio-button>
                            <el-radio-button label="365d">过去一年</el-radio-button>
                        </el-radio-group>
                        <el-date-picker
                            v-model="dashboard.capacityDates"
                            type="daterange"
                            size="mini"
                            value-format="yyyy-MM-dd"
                            range-separator="~"
                            start-placeholder="开始日期"
                            end-placeholder="结束日期"
                            style="width: 240px;"
                            @@change="loadDashboardStats">
                        </el-date-picker>
                    </div>
                    <div ref="capacityChart" class="file-manager-dash-chart"></div>
                </section>

                <section class="file-manager-dash-card">
                    <div class="file-manager-dash-card-header">
                        <span>企业文档容量统计</span>
                        <i class="el-icon-question" title="展示企业文档库当前已使用空间"></i>
                    </div>
                    <div class="file-manager-dash-meta">
                        <span>统计截止时间：{{ dashboard.statsCutoff }}</span>
                        <span class="file-manager-dash-used-tag">企业文档已使用：{{ dashboard.enterpriseUsed }}</span>
                    </div>
                    <div class="file-manager-dash-org-list">
                        <div class="file-manager-dash-org-head">
                            <span>租户/组织名称</span>
                            <span>已用空间</span>
                        </div>
                        <div class="file-manager-dash-org-row" v-for="org in dashboard.orgUsages" :key="org.name">
                            <span class="file-manager-dash-org-name"><i class="el-icon-office-building"></i>{{ org.name }}</span>
                            <span class="file-manager-dash-org-size">{{ org.size }}</span>
                        </div>
                    </div>
                </section>

                <section class="file-manager-dash-card">
                    <div class="file-manager-dash-card-header">
                        <span>文件大小统计</span>
                        <i class="el-icon-question" title="按文件类型统计占用容量占比"></i>
                    </div>
                    <div class="file-manager-dash-meta">
                        <span>统计截止时间：{{ dashboard.statsCutoff }}</span>
                    </div>
                    <div ref="sizeChart" class="file-manager-dash-chart"></div>
                </section>

                <section class="file-manager-dash-card">
                    <div class="file-manager-dash-card-header">
                        <span>文件个数统计</span>
                        <i class="el-icon-question" title="按文件类型统计文件数量占比"></i>
                    </div>
                    <div class="file-manager-dash-meta">
                        <span>统计截止时间：{{ dashboard.statsCutoff }}</span>
                    </div>
                    <div ref="countChart" class="file-manager-dash-chart"></div>
                </section>
            </div>
        </div>

        <div class="file-manager-settings-panel" v-if="activeNavKey === 'settings' && uploadSettings">
            <h2 class="file-manager-settings-title">上传设置</h2>
            <p class="file-manager-settings-desc">配置文件上传的允许类型、大小上限以及需要拦截的扩展名。保存后立即对后续上传生效（本机浏览器记忆）。</p>
            <el-form class="file-manager-settings-form" label-position="top" size="small">
                <el-form-item label="允许上传的文件类型">
                    <el-input
                        type="textarea"
                        :rows="8"
                        v-model="uploadSettings.allowedTypesText"
                        placeholder="每行一个扩展名，例如：.docx&#10;.xlsx&#10;.pdf">
                    </el-input>
                    <div class="file-manager-settings-hint">支持每行一个扩展名，也可使用逗号分隔。建议带点号（如 .docx）。留空表示不限制允许列表（仍受下方过滤类型约束）。</div>
                </el-form-item>
                <el-form-item label="单文件上传大小上限（MB）">
                    <el-input-number
                        v-model="uploadSettings.maxSizeMb"
                        :min="1"
                        :max="512"
                        :step="1"
                        controls-position="right">
                    </el-input-number>
                    <div class="file-manager-settings-hint">默认 50 MB；超过此大小的文件将在上传前被拦截。</div>
                </el-form-item>
                <el-form-item label="需要过滤的文件类型">
                    <el-input
                        type="textarea"
                        :rows="6"
                        v-model="uploadSettings.blockedTypesText"
                        placeholder="每行一个扩展名，例如：.exe&#10;.bat&#10;.js">
                    </el-input>
                    <div class="file-manager-settings-hint">黑名单扩展名，命中后禁止上传（优先级高于允许列表）。</div>
                </el-form-item>
                <div class="file-manager-settings-actions">
                    <el-button type="primary" @@click="saveUploadSettings">保存设置</el-button>
                    <el-button @@click="resetUploadSettings">恢复默认</el-button>
                </div>
            </el-form>
        </div>

        <div class="file-manager-tags-panel" v-if="activeNavKey === 'tags' && tagManager">
            <div class="file-manager-tags-filter">
                <div class="file-manager-tags-filter-item">
                    <span>搜索</span>
                    <el-input
                        v-model="tagManager.keyword"
                        size="small"
                        placeholder="搜索标签名称"
                        prefix-icon="el-icon-search"
                        clearable
                        @@keyup.enter.native="searchTags">
                    </el-input>
                </div>
                <div class="file-manager-tags-filter-item">
                    <span>分类</span>
                    <el-select v-model="tagManager.category" size="small" placeholder="选择分类" clearable>
                        <el-option
                            v-for="item in tagManager.categoryOptions"
                            :key="item.value"
                            :label="item.label"
                            :value="item.value">
                        </el-option>
                    </el-select>
                </div>
                <div class="file-manager-tags-filter-item">
                    <span>状态</span>
                    <el-select v-model="tagManager.status" size="small" placeholder="全部" clearable>
                        <el-option label="全部" value=""></el-option>
                        <el-option label="启用" value="enabled"></el-option>
                        <el-option label="停用" value="disabled"></el-option>
                    </el-select>
                </div>
                <div class="file-manager-tags-filter-actions">
                    <el-button type="primary" size="small" icon="el-icon-search" @@click="searchTags"></el-button>
                    <el-button type="text" size="small" @@click="resetTagFilters">重置</el-button>
                </div>
            </div>

            <div class="file-manager-tags-toolbar">
                <el-button type="primary" size="small" @@click="createTag">新增标签</el-button>
                <el-button size="small" @@click="createTagCategory">新增分类</el-button>
                <el-button size="small" @@click="expandTagRows">
                    {{ tagManager.treeExpanded ? '收起' : '展开' }}<i class="el-icon-arrow-down el-icon--right"></i>
                </el-button>
                <el-button size="small" :disabled="!tagManager.selectedIds.length" @@click="enableSelectedTags">启用</el-button>
                <el-button size="small" :disabled="!tagManager.selectedIds.length" @@click="disableSelectedTags">停用</el-button>
                <el-button size="small" @@click="importTags">导入</el-button>
                <el-button size="small" @@click="exportTags">导出</el-button>
            </div>

            <div class="file-manager-tags-table-wrap">
                <el-table
                    :key="'tag-tree-' + (tagManager.treeExpandKey || 0)"
                    ref="tagTable"
                    :data="tagManager.displayList"
                    row-key="id"
                    border
                    stripe
                    height="100%"
                    :tree-props="{ children: 'children', hasChildren: 'hasChildren' }"
                    :default-expand-all="!!tagManager.treeExpanded"
                    @@selection-change="onTagSelectionChange">
                    <template slot="empty">
                        <div class="file-manager-tags-empty">
                            <i class="el-icon-document"></i>
                            <strong>暂无数据</strong>
                        </div>
                    </template>
                    <el-table-column type="expand" width="44">
                        <template slot-scope="scope">
                            <div class="tag-row-actions">
                                <el-button size="mini" @@click="editTagRow(scope.row)">编辑</el-button>
                                <el-button size="mini" @@click="deleteTagRow(scope.row)">删除</el-button>
                                <el-button size="mini" @@click="toggleTagRowStatus(scope.row)">
                                    {{ isTagRowEnabled(scope.row) ? '停用' : '启用' }}
                                </el-button>
                                <el-button
                                    v-if="isTagCategoryRow(scope.row)"
                                    size="mini"
                                    @@click="createTagUnder(scope.row)">新增标签</el-button>
                                <el-button
                                    v-if="isTagCategoryRow(scope.row)"
                                    size="mini"
                                    @@click="createTagCategoryUnder(scope.row)">新增分类</el-button>
                            </div>
                        </template>
                    </el-table-column>
                    <el-table-column type="selection" width="48"></el-table-column>
                    <el-table-column prop="name" label="名称" min-width="200" show-overflow-tooltip></el-table-column>
                    <el-table-column prop="type" label="类型" width="120">
                        <template slot-scope="scope">
                            <el-tag
                                class="file-manager-tags-type-tag"
                                size="mini"
                                :type="scope.row.nodeType === 'tag' ? '' : 'primary'"
                                effect="plain">{{ scope.row.type }}</el-tag>
                        </template>
                    </el-table-column>
                    <el-table-column prop="status" label="状态" width="100">
                        <template slot-scope="scope">
                            <el-tag :type="isTagRowEnabled(scope.row) ? 'success' : 'info'" size="mini">
                                {{ isTagRowEnabled(scope.row) ? '启用' : '已停用' }}
                            </el-tag>
                        </template>
                    </el-table-column>
                    <el-table-column prop="tagCount" label="标签数量" width="110">
                        <template slot-scope="scope">
                            {{ scope.row.nodeType === 'tag' ? '-' : (scope.row.tagCount || 0) }}
                        </template>
                    </el-table-column>
                    <el-table-column prop="updatedAt" label="最后更新时间" width="170"></el-table-column>
                    <el-table-column prop="updatedBy" label="最后更新人" width="120" show-overflow-tooltip></el-table-column>
                    <el-table-column prop="admin" label="管理员" width="120" show-overflow-tooltip>
                        <template slot-scope="scope">
                            {{ scope.row.nodeType === 'tag' ? '-' : (scope.row.admin || '-') }}
                        </template>
                    </el-table-column>
                    <el-table-column width="48" align="center">
                        <template slot="header">
                            <i class="el-icon-s-operation" title="列设置"></i>
                        </template>
                        <template slot-scope="scope">
                            <el-button type="text" icon="el-icon-more" size="mini" @@click="openTagRowMenu(scope.row)"></el-button>
                        </template>
                    </el-table-column>
                </el-table>
            </div>
        </div>

        <div class="file-manager-recycle-panel" v-if="activeNavKey === 'recycle' && recycleBin">
            <div class="file-manager-recycle-header">
                <el-button
                    type="primary"
                    size="small"
                    icon="el-icon-delete"
                    :loading="!!recycleBin.emptying"
                    @@click.stop.prevent="emptyRecycleBin">一键清空</el-button>
            </div>
            <div class="file-manager-recycle-table-wrap">
                <el-table
                    :data="recycleBin.displayList"
                    border
                    stripe
                    height="100%"
                    @@selection-change="onRecycleSelectionChange">
                    <template slot="empty">
                        <div class="file-manager-recycle-empty">
                            <i class="el-icon-document"></i>
                            <strong>暂无文档</strong>
                        </div>
                    </template>
                    <el-table-column type="selection" width="48"></el-table-column>
                    <el-table-column label="文件名称" min-width="280">
                        <template slot-scope="scope">
                            <div class="file-manager-favorite-name-cell">
                                <span class="file-manager-favorite-name" :title="scope.row.fileName">{{ scope.row.fileName }}</span>
                                <div class="file-manager-favorite-path" :title="scope.row.folderPathText">{{ scope.row.folderPathText }}</div>
                            </div>
                        </template>
                    </el-table-column>
                    <el-table-column prop="updatedBy" label="更新者" width="120" show-overflow-tooltip>
                        <template slot-scope="scope">{{ scope.row.updatedBy || updatedByLabel(scope.row) }}</template>
                    </el-table-column>
                    <el-table-column prop="fileSize" label="大小" width="110">
                        <template slot-scope="scope">{{ formatFileSize(scope.row.fileSize) }}</template>
                    </el-table-column>
                    <el-table-column prop="deletedAt" label="删除时间" width="180">
                        <template slot-scope="scope">{{ dateFormatter(scope.row.deletedAt) }}</template>
                    </el-table-column>
                </el-table>
            </div>
            <div class="file-manager-recycle-pagination">
                <el-pagination
                    @@current-change="handleRecyclePageChange"
                    @@size-change="handleRecycleSizeChange"
                    :current-page="recycleBin.page"
                    :page-sizes="[10, 20, 30, 40]"
                    :page-size="recycleBin.size"
                    layout="total, sizes, prev, pager, next, jumper"
                    :total="recycleBin.total">
                </el-pagination>
            </div>
        </div>

        <div class="file-manager-favorite-panel" v-if="activeNavKey === 'favorite' && favoriteList">
            <div class="file-manager-favorite-header">
                <div class="file-manager-favorite-search">
                    <el-input
                        v-model="favoriteList.keyword"
                        size="small"
                        placeholder="搜索文件/文件夹"
                        prefix-icon="el-icon-search"
                        clearable
                        @@input="searchFavorites"
                        @@keyup.enter.native="searchFavorites">
                    </el-input>
                </div>
            </div>
            <div class="file-manager-favorite-table-wrap">
                <el-table
                    :data="favoriteList.displayList"
                    border
                    stripe
                    height="100%">
                    <template slot="empty">
                        <div class="file-manager-favorite-empty">
                            <i class="el-icon-document"></i>
                            <strong>暂无文档</strong>
                        </div>
                    </template>
                    <el-table-column label="文件名称" min-width="280">
                        <template slot-scope="scope">
                            <div class="file-manager-favorite-name-cell">
                                <div class="file-manager-file-name-cell">
                                    <span class="file-manager-favorite-name" :title="scope.row.fileName">{{ scope.row.fileName }}</span>
                                    <i
                                        class="file-manager-favorite-star is-on el-icon-star-on"
                                        title="取消收藏"
                                        @@click.stop="toggleFavorite(scope.row)">
                                    </i>
                                </div>
                                <div class="file-manager-favorite-path" :title="scope.row.folderPathText">{{ scope.row.folderPathText }}</div>
                            </div>
                        </template>
                    </el-table-column>
                    <el-table-column prop="updatedBy" label="更新者" width="120" show-overflow-tooltip>
                        <template slot-scope="scope">{{ scope.row.updatedBy || updatedByLabel(scope.row) }}</template>
                    </el-table-column>
                    <el-table-column prop="fileSize" label="大小" width="110">
                        <template slot-scope="scope">{{ formatFileSize(scope.row.fileSize) }}</template>
                    </el-table-column>
                    <el-table-column label="更新时间" width="180">
                        <template slot-scope="scope">{{ dateFormatter(scope.row.updatedAt || scope.row.uploadTime) }}</template>
                    </el-table-column>
                </el-table>
            </div>
            <div class="file-manager-favorite-pagination">
                <el-pagination
                    @@current-change="handleFavoritePageChange"
                    @@size-change="handleFavoriteSizeChange"
                    :current-page="favoriteList.page"
                    :page-sizes="[10, 20, 30, 40]"
                    :page-size="favoriteList.size"
                    layout="total, sizes, prev, pager, next, jumper"
                    :total="favoriteList.total">
                </el-pagination>
            </div>
        </div>

        <div class="file-manager-home-panel" v-if="activeNavKey === 'home' && homePage">
            <div class="file-manager-home-header">
                <div class="file-manager-home-search">
                    <el-input
                        v-model="homePage.keyword"
                        size="small"
                        placeholder="搜索文件/文件夹"
                        prefix-icon="el-icon-search"
                        clearable
                        @@input="searchHomeRecent"
                        @@keyup.enter.native="searchHomeRecent">
                    </el-input>
                </div>
                <div class="file-manager-home-actions">
                    <el-dropdown trigger="click" @@command="handleCreateCommand">
                        <el-button size="small">
                            新建<i class="el-icon-arrow-down el-icon--right"></i>
                        </el-button>
                        <el-dropdown-menu slot="dropdown">
                            <el-dropdown-item command="folder">新建文件夹</el-dropdown-item>
                        </el-dropdown-menu>
                    </el-dropdown>
                    <el-dropdown trigger="click" @@command="handleUploadCommand">
                        <el-button type="primary" size="small">
                            上传<i class="el-icon-arrow-down el-icon--right"></i>
                        </el-button>
                        <el-dropdown-menu slot="dropdown">
                            <el-dropdown-item command="files">上传文件</el-dropdown-item>
                            <el-dropdown-item command="folder">上传文件夹</el-dropdown-item>
                        </el-dropdown-menu>
                    </el-dropdown>
                </div>
            </div>

            <div class="file-manager-home-banner" v-if="!(homePage.quickAccess && homePage.quickAccess.length)">
                <div class="file-manager-home-banner-text">
                    <h3>灵活使用快速访问，畅享高效工作!</h3>
                    <p>可将常用的文件和文件夹添加至「快速访问」，方便查找和使用。点击列表“更多”即可手动添加或移除快速访问</p>
                </div>
                <div class="file-manager-home-banner-art" aria-hidden="true"></div>
            </div>

            <div class="file-manager-home-quick-access" v-else>
                <div class="file-manager-home-quick-title">快速访问</div>
                <div class="file-manager-home-quick-list">
                    <div class="file-manager-home-quick-card" v-for="item in homePage.quickAccess" :key="item.id">
                        <span class="file-manager-home-quick-icon"><i class="el-icon-document"></i></span>
                        <span class="file-manager-home-quick-name" :title="item.fileName">{{ item.fileName }}</span>
                        <el-dropdown trigger="click" @@command="handleQuickAccessCommand($event, item)">
                            <el-button type="text" class="file-manager-home-quick-more" icon="el-icon-more"></el-button>
                            <el-dropdown-menu slot="dropdown">
                                <el-dropdown-item command="remove">从快速访问移除</el-dropdown-item>
                            </el-dropdown-menu>
                        </el-dropdown>
                    </div>
                </div>
            </div>

            <div class="file-manager-home-recent">
                <div class="file-manager-home-recent-title">
                    <span>最近访问</span>
                    <i class="el-icon-sort" title="排序"></i>
                </div>
                <div class="file-manager-home-table-wrap">
                    <el-table
                        :data="homePage.displayList"
                        border
                        stripe
                        height="100%">
                        <template slot="empty">
                            <div class="file-manager-home-empty">
                                <i class="el-icon-document"></i>
                                <strong>暂无文档</strong>
                            </div>
                        </template>
                        <el-table-column prop="fileName" label="文件名称" min-width="200" show-overflow-tooltip sortable></el-table-column>
                        <el-table-column prop="updatedBy" label="更新者" width="120" show-overflow-tooltip></el-table-column>
                        <el-table-column prop="fileSize" label="大小" width="110">
                            <template slot-scope="scope">{{ formatFileSize(scope.row.fileSize) }}</template>
                        </el-table-column>
                        <el-table-column prop="updatedAt" label="更新时间" width="170">
                            <template slot-scope="scope">{{ dateFormatter(scope.row.updatedAt) }}</template>
                        </el-table-column>
                        <el-table-column prop="accessedAt" label="访问时间" width="170">
                            <template slot-scope="scope">{{ dateFormatter(scope.row.accessedAt) }}</template>
                        </el-table-column>
                    </el-table>
                </div>
            </div>
        </div>
    </div>
</div>

<el-dialog
    :title="getUploadDialogTitle()"
    :visible.sync="uploadDialog.visible"
    width="720px"
    custom-class="file-manager-upload-dialog"
    append-to-body
    @@closed="cancelUpload">
    <div class="file-manager-upload-toolbar">
        <el-dropdown trigger="click" @@command="handleUploadPickerCommand">
            <el-button size="small">
                上传文件<i class="el-icon-arrow-down el-icon--right"></i>
            </el-button>
            <el-dropdown-menu slot="dropdown">
                <el-dropdown-item command="files">上传文件</el-dropdown-item>
                <el-dropdown-item command="folder">上传文件夹</el-dropdown-item>
            </el-dropdown-menu>
        </el-dropdown>
        <el-button type="text" size="small" @@click="clearUploadList">清空列表</el-button>
    </div>

    <el-upload
        ref="upload"
        class="file-manager-upload-dropzone"
        action="#"
        drag
        :auto-upload="false"
        :multiple="true"
        :show-file-list="false"
        :on-change="handleFileChange"
        :before-upload="beforeUpload"
        :file-list="uploadDialog.fileList">
        <div class="file-manager-upload-drop-hint">请将需要上传的文件/文件夹拖到此处</div>
    </el-upload>
    <input ref="folderUploadInput" class="file-manager-folder-input" type="file" webkitdirectory directory multiple @@change="handleFolderSelection" />

    <div v-if="uploadDialog.fileList.length" class="file-manager-upload-filelist">
        <el-table :data="uploadDialog.fileList" size="mini" border max-height="180">
            <el-table-column prop="name" label="文件名" min-width="220" show-overflow-tooltip></el-table-column>
            <el-table-column label="大小" width="100">
                <template slot-scope="scope">{{ formatFileSize(scope.row.size || (scope.row.raw && scope.row.raw.size) || 0) }}</template>
            </el-table-column>
            <el-table-column label="备注" min-width="160">
                <template slot-scope="scope">
                    <el-input v-model="scope.row.description" size="mini" placeholder="可选备注"></el-input>
                </template>
            </el-table-column>
        </el-table>
    </div>

    <el-alert
        v-if="uploadFolderSummary"
        class="file-manager-folder-upload-summary"
        type="success"
        :closable="false"
        show-icon
        :title="uploadFolderSummary">
    </el-alert>
    <div class="file-manager-upload-tip">{{ uploadExtensionHint }}。选择文件夹后会保留完整层级结构；每批最多 20 个文件，系统会自动分批上传。</div>
    <el-progress v-if="uploadDialog.uploading" :percentage="uploadDialog.progress" :stroke-width="10" status="success" style="margin-top: 10px;"></el-progress>

    <span slot="footer" class="dialog-footer">
        <el-button
            class="file-manager-upload-start-btn"
            size="small"
            @@click="submitUpload"
            :loading="uploadDialog.uploading">
            开始上传
        </el-button>
    </span>
</el-dialog>

<el-dialog :title="folderDialog.editing ? '编辑文件夹' : '新建文件夹'" :visible.sync="folderDialog.visible" width="420px" append-to-body>
    <el-form :model="folderDialog.form" label-width="80px">
        <el-form-item label="名称"><el-input v-model="folderDialog.form.name" placeholder="请输入文件夹名称"></el-input></el-form-item>
        <el-form-item label="备注"><el-input type="textarea" v-model="folderDialog.form.description" placeholder="可选" rows="3"></el-input></el-form-item>
    </el-form>
    <span slot="footer" class="dialog-footer">
        <el-button @@click="folderDialog.visible=false">取消</el-button>
        <el-button type="primary" @@click="submitFolder" :loading="folderDialog.loading">确定</el-button>
    </span>
</el-dialog>

<el-dialog title="编辑备注" :visible.sync="noteDialog.visible" width="420px" append-to-body>
    <el-input type="textarea" v-model="noteDialog.note" rows="4" placeholder="请输入文件备注"></el-input>
    <span slot="footer" class="dialog-footer">
        <el-button @@click="noteDialog.visible=false">取消</el-button>
        <el-button type="primary" @@click="submitNote" :loading="noteDialog.loading">保存</el-button>
    </span>
</el-dialog>

<el-dialog
    :visible.sync="recycleEmptyDialog.visible"
    width="420px"
    custom-class="file-manager-recycle-empty-dialog"
    append-to-body
    :close-on-click-modal="false"
    :close-on-press-escape="!(recycleBin && recycleBin.emptying)"
    :show-close="!(recycleBin && recycleBin.emptying)">
    <div class="file-manager-recycle-empty-body">
        <i class="el-icon-warning"></i>
        <div class="file-manager-recycle-empty-text">
            <strong>文件清空后将彻底删除，无法恢复？</strong>
            <p>确定继续吗？</p>
        </div>
    </div>
    <span slot="footer" class="dialog-footer">
        <el-button :disabled="!!(recycleBin && recycleBin.emptying)" @@click.stop="cancelEmptyRecycleBin">取消</el-button>
        <el-button type="danger" :loading="!!(recycleBin && recycleBin.emptying)" @@click.stop="confirmEmptyRecycleBin">确定</el-button>
    </span>
</el-dialog>

<el-dialog
    title="标签管理"
    :visible.sync="fileTagDialog.visible"
    width="520px"
    custom-class="file-tag-dialog"
    append-to-body
    @@closed="onFileTagDialogClosed">
    <div class="file-tag-dialog-toolbar">
        <span class="file-tag-dialog-label">为文件设置标签</span>
    </div>
    <p class="file-tag-dialog-hint">可选标签来自「标签管理」中已维护的数据；选择后将写入当前文件的标识字段。</p>
    <el-select
        class="file-tag-dialog-select"
        v-model="fileTagDialog.selectedIds"
        multiple
        filterable
        clearable
        collapse-tags
        placeholder="请选择标签（来自标签管理）"
        :disabled="!(fileTagCatalogOptions && fileTagCatalogOptions.length)">
        <el-option-group
            v-for="group in fileTagCatalogGroups"
            :key="group.id"
            :label="group.name">
            <el-option
                v-for="item in group.tags"
                :key="item.id"
                :label="item.name"
                :value="item.id"
                :disabled="item.status === '已停用' || item.status === '停用'">
            </el-option>
        </el-option-group>
    </el-select>
    <div class="file-tag-dialog-box">
        <template v-if="fileTagDialog.selectedIds && fileTagDialog.selectedIds.length">
            <el-tag
                v-for="item in selectedFileTagItems"
                :key="item.id"
                size="small"
                closable
                @@close="removeSelectedFileTag(item.id)">{{ item.name }}</el-tag>
        </template>
        <div v-else class="file-tag-dialog-empty">
            <template v-if="fileTagCatalogOptions && fileTagCatalogOptions.length">请从上方选择标签</template>
            <template v-else>暂无可用标签，请先在左侧「标签管理」中新增标签</template>
        </div>
    </div>
    <span slot="footer" class="dialog-footer">
        <el-button @@click="fileTagDialog.visible=false">取消</el-button>
        <el-button type="primary" @@click="submitFileTags" :loading="fileTagDialog.loading">确定</el-button>
    </span>
</el-dialog>

<el-dialog
    :title="tagCategoryDialog.editing ? '编辑分类' : '新增分类'"
