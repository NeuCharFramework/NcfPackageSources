                vm.saveUploadSettings = function () {
                    if (!this.uploadSettings) this.uploadSettings = this.getDefaultUploadSettings();
                    var maxSizeMb = Number(this.uploadSettings.maxSizeMb);
                    if (!maxSizeMb || maxSizeMb < 1) maxSizeMb = 1;
                    if (maxSizeMb > 512) maxSizeMb = 512;
                    this.uploadSettings.maxSizeMb = maxSizeMb;
                    try {
                        localStorage.setItem(
                            this.uploadSettingsStorageKey || 'ncf.fileManager.uploadSettings',
                            JSON.stringify({
                                allowedTypesText: this.uploadSettings.allowedTypesText || '',
                                maxSizeMb: maxSizeMb,
                                blockedTypesText: this.uploadSettings.blockedTypesText || ''
                            })
                        );
                        this.$message.success('上传设置已保存');
                    } catch (e) {
                        this.$message.error('保存失败，请检查浏览器本地存储是否可用');
                    }
                };
                vm.resetUploadSettings = function () {
                    this.uploadSettings = this.getDefaultUploadSettings();
                    try {
                        localStorage.setItem(
                            this.uploadSettingsStorageKey || 'ncf.fileManager.uploadSettings',
                            JSON.stringify({
                                allowedTypesText: this.uploadSettings.allowedTypesText || '',
                                maxSizeMb: this.uploadSettings.maxSizeMb,
                                blockedTypesText: this.uploadSettings.blockedTypesText || ''
                            })
                        );
                        this.$message.success('已恢复默认上传设置');
                    } catch (e) {
                        this.$message.error('恢复默认失败');
                    }
                };
                vm.getMaxUploadSizeBytes = function () {
                    var mb = (this.uploadSettings && Number(this.uploadSettings.maxSizeMb)) || 50;
                    return Math.max(1, mb) * 1024 * 1024;
                };
                vm.validateUploadFile = function (fileName, fileSize) {
                    var name = fileName || '';
                    var extMatch = /\.[^.\\/]+$/.exec(name);
                    var ext = extMatch ? extMatch[0].toLowerCase() : '';
                    var blocked = this.parseExtensionList((this.uploadSettings && this.uploadSettings.blockedTypesText) || '');
                    if (ext && blocked.indexOf(ext) !== -1) {
                        return '文件“' + name + '”类型 ' + ext + ' 已被过滤，无法上传。';
                    }
                    var allowed = this.parseExtensionList((this.uploadSettings && this.uploadSettings.allowedTypesText) || '');
                    if (allowed.length && (!ext || allowed.indexOf(ext) === -1)) {
                        return '文件“' + name + '”类型不在允许上传列表中。';
                    }
                    var maxBytes = this.getMaxUploadSizeBytes();
                    if (fileSize > maxBytes) {
                        return '文件“' + name + '”超过 ' + Math.round(maxBytes / 1024 / 1024) + ' MB，无法上传。';
                    }
                    return '';
                };
                if (!vm.__uploadSettingsLoaded) {
                    vm.__uploadSettingsLoaded = true;
                    vm.loadUploadSettingsFromStorage();
                }

                // 未重编 index.js 时，仍用设置校验上传
                if (typeof vm.createUploadBatches === 'function' && !vm.__uploadSettingsBatchPatched) {
                    vm.__uploadSettingsBatchPatched = true;
                    var originalCreateUploadBatches = vm.createUploadBatches.bind(vm);
                    vm.createUploadBatches = function (fileList) {
                        var self = this;
                        var maxBytes = typeof this.getMaxUploadSizeBytes === 'function'
                            ? this.getMaxUploadSizeBytes()
                            : (50 * 1024 * 1024);
                        var maxMb = Math.round(maxBytes / 1024 / 1024);
                        var maxFilesPerUpload = 20;
                        var maxTotalUploadBytes = 100 * 1024 * 1024;
                        var batches = [];
                        var batch = [];
                        var batchBytes = 0;
                        (fileList || []).forEach(function (file) {
                            var rawFile = file.raw || file;
                            if (!rawFile || !rawFile.size) throw new Error('存在无法读取的文件，请重新选择。');
                            if (typeof self.validateUploadFile === 'function') {
                                var reason = self.validateUploadFile(file.name || rawFile.name, rawFile.size);
                                if (reason) throw new Error(reason);
                            } else if (rawFile.size > maxBytes) {
                                throw new Error('文件“' + file.name + '”超过 ' + maxMb + ' MB，无法上传。');
                            }
                            if (batch.length && (batch.length >= maxFilesPerUpload || batchBytes + rawFile.size > maxTotalUploadBytes)) {
                                batches.push(batch);
                                batch = [];
                                batchBytes = 0;
                            }
                            batch.push(file);
                            batchBytes += rawFile.size;
                        });
                        if (batch.length) batches.push(batch);
                        return batches;
                    };
                    // keep reference to avoid unused warning in some bundlers
                    void originalCreateUploadBatches;
                }

                if (typeof vm.searchHomeRecent !== 'function') {
                    vm.searchHomeRecent = function () {
                        if (!this.homePage) return;
                        var keyword = (this.homePage.keyword || '').trim().toLowerCase();
                        this.homePage.displayList = (this.homePage.list || []).filter(function (row) {
                            if (!keyword) return true;
                            return String(row.fileName || '').toLowerCase().indexOf(keyword) !== -1;
                        });
                    };
                }

                if (!vm.$options.computed) vm.$options.computed = {};
                if (typeof vm.getUploadDialogTitle !== 'function') {
                    vm.getUploadDialogTitle = function () {
                        var segments = [this.rootFolderName || '根目录'].concat((this.folderPath || []).map(function (item) { return item.name; }));
                        return '上传文件到 【/' + segments.join('/') + '】 --支持断点续传';
                    };
                }

                if (typeof vm.handleUploadPickerCommand !== 'function') {
                    vm.handleUploadPickerCommand = function (command) {
                        if (command === 'files') {
                            this.triggerUploadFilePicker && this.triggerUploadFilePicker();
                            return;
                        }
                        if (command === 'folder' && this.chooseUploadFolder) this.chooseUploadFolder();
                    };
                    vm.triggerUploadFilePicker = function () {
                        var upload = this.$refs.upload;
                        if (!upload) return;
                        if (upload.$refs && upload.$refs['upload-inner'] && typeof upload.$refs['upload-inner'].handleClick === 'function') {
                            upload.$refs['upload-inner'].handleClick();
                            return;
                        }
                        var input = upload.$el && upload.$el.querySelector('input[type="file"]');
                        if (input) input.click();
                    };
                    vm.clearUploadList = function () {
                        this.uploadDialog.fileList = [];
                        this.uploadDialog.mode = 'files';
                        this.uploadDialog.folderRootName = '';
                        this.uploadDialog.progress = 0;
                        if (this.$refs.upload) this.$refs.upload.clearFiles();
                    };
                }

                if (!vm.tagManager) {
                    Vue.set(vm, 'tagManager', {
                        keyword: '',
                        category: '',
                        status: '',
                        selectedIds: [],
                        categoryOptions: [],
                        list: [],
                        displayList: [],
                        tags: [],
                        treeExpanded: true,
                        treeExpandKey: 0
                    });
                } else {
                    if (!Array.isArray(vm.tagManager.tags)) Vue.set(vm.tagManager, 'tags', []);
                    if (vm.tagManager.treeExpanded == null) Vue.set(vm.tagManager, 'treeExpanded', true);
                    if (vm.tagManager.treeExpandKey == null) Vue.set(vm.tagManager, 'treeExpandKey', 0);
                }
                if (!vm.__tagManagerLoaded) {
                    vm.__tagManagerLoaded = true;
                    if (typeof vm.loadTagManagerFromStorage === 'function') vm.loadTagManagerFromStorage();
                }

                vm.getOrCreateChart = function (el) {
                    if (!el || typeof echarts === 'undefined') return null;
                    return (echarts.getInstanceByDom && echarts.getInstanceByDom(el)) || echarts.init(el);
                };
                vm.buildCapacityDates = function () {
                    var dates = this.dashboard && this.dashboard.capacityDates;
                    if (Array.isArray(dates) && dates[0] && dates[1]) {
                        var list = [];
                        var cursor = new Date(dates[0]);
                        var endDate = new Date(dates[1]);
                        while (cursor <= endDate && list.length < 366) {
                            list.push(pad(cursor.getMonth() + 1) + '-' + pad(cursor.getDate()));
                            cursor.setDate(cursor.getDate() + 1);
                        }
                        if (list.length) return list;
                    }
                    var days = this.dashboard && this.dashboard.capacityRange === '365d' ? 365 : (this.dashboard && this.dashboard.capacityRange === '30d' ? 30 : 7);
                    var result = [];
                    var now = new Date();
                    for (var i = days - 1; i >= 0; i--) {
                        var d = new Date(now);
                        d.setDate(now.getDate() - i);
                        result.push(pad(d.getMonth() + 1) + '-' + pad(d.getDate()));
                    }
                    return result;
                };
                vm.onDashboardRangeChange = function () {
                    var end = new Date();
                    var start = new Date();
                    var days = this.dashboard.capacityRange === '365d' ? 365 : (this.dashboard.capacityRange === '30d' ? 30 : 7);
                    start.setDate(end.getDate() - (days - 1));
                    this.dashboard.capacityDates = [fmtDate(start), fmtDate(end)];
                    this.loadDashboardStats();
                };
                vm.loadDashboardStats = async function () {
                    if (!this.dashboard) return;
                    var pageUrlLocal = window.location.pathname || '/Admin/FileManager/Index';
                    try {
                        var url = pageUrlLocal + '?handler=DashboardStats';
                        var dates = this.dashboard.capacityDates;
                        if (Array.isArray(dates) && dates[0] && dates[1]) {
                            url += '&startDate=' + encodeURIComponent(dates[0]) + '&endDate=' + encodeURIComponent(dates[1]);
                        }
                        var response = await axios.get(url);
                        var result = response && response.data && response.data.data !== undefined ? response.data.data : (response && response.data);
                        result = result || {};
                        if (result.statsCutoff) this.dashboard.statsCutoff = result.statsCutoff;
                        if (result.enterpriseUsed) this.dashboard.enterpriseUsed = result.enterpriseUsed;
                        if (result.totalCount != null) this.dashboard.totalCount = result.totalCount;
                        if (result.totalSizeBytes != null) this.dashboard.totalSizeBytes = result.totalSizeBytes;
                        if (Array.isArray(result.orgUsages)) this.dashboard.orgUsages = result.orgUsages;
                        if (result.sizeTotalLabel) this.dashboard.sizeTotalLabel = result.sizeTotalLabel;
                        if (result.countTotalLabel != null) this.dashboard.countTotalLabel = String(result.countTotalLabel);
                        if (Array.isArray(result.sizeSlices)) this.dashboard.sizeSlices = result.sizeSlices;
                        if (Array.isArray(result.countSlices)) this.dashboard.countSlices = result.countSlices;
                        if (Array.isArray(result.capacityTrend)) this.dashboard.capacityTrend = result.capacityTrend;
                    } catch (e) {
                        this.dashboard.capacityTrend = this.buildCapacityDates().map(function (date) {
                            return { date: date, fileCount: 0, totalSizeBytes: 0 };
                        });
                    }
                    var self = this;
                    this.$nextTick(function () { self.refreshDashboardCharts(); });
                };
                vm.refreshDashboardCharts = function () {
                    if (this.activeNavKey !== 'dashboard' || typeof echarts === 'undefined') return;
                    var trend = Array.isArray(this.dashboard.capacityTrend) && this.dashboard.capacityTrend.length
                        ? this.dashboard.capacityTrend
                        : this.buildCapacityDates().map(function (date) { return { date: date, fileCount: 0, totalSizeBytes: 0 }; });
                    var labels = trend.map(function (x) { return x.date; });
                    var fileCounts = trend.map(function (x) { return Number(x.fileCount || 0); });
                    var sizeMb = trend.map(function (x) { return Number(((Number(x.totalSizeBytes || 0)) / (1024 * 1024)).toFixed(2)); });
                    var capacityChart = this.getOrCreateChart(this.$refs.capacityChart);
                    if (capacityChart) {
                        capacityChart.setOption({
                            color: ['#409eff', '#67c23a'],
                            tooltip: {
                                trigger: 'axis',
                                formatter: function (params) {
                                    if (!params || !params.length) return '';
                                    var lines = [params[0].axisValue];
                                    params.forEach(function (p) {
                                        var unit = p.seriesName === '文件数量' ? ' 个' : ' MB';
                                        lines.push(p.marker + p.seriesName + '：' + p.data + unit);
                                    });
                                    return lines.join('<br/>');
                                }
                            },
                            legend: { bottom: 0, data: ['文件数量', '总大小'] },
                            grid: { left: 48, right: 56, top: 28, bottom: 48 },
                            xAxis: { type: 'category', boundaryGap: false, data: labels },
                            yAxis: [
                                { type: 'value', name: '数量', minInterval: 1, axisLabel: { formatter: '{value}' }, splitLine: { lineStyle: { type: 'dashed' } } },
                                { type: 'value', name: '大小', axisLabel: { formatter: '{value}MB' }, splitLine: { show: false } }
                            ],
                            series: [
                                { name: '文件数量', type: 'line', smooth: true, yAxisIndex: 0, data: fileCounts, areaStyle: { opacity: 0.08 } },
                                { name: '总大小', type: 'line', smooth: true, yAxisIndex: 1, data: sizeMb }
                            ]
                        }, true);
                    }
                    var sizeSlices = (this.dashboard.sizeSlices || []).filter(function (x) { return Number(x.value) > 0; });
                    var sizeChart = this.getOrCreateChart(this.$refs.sizeChart);
                    if (sizeChart) {
                        sizeChart.setOption({
                            tooltip: { trigger: 'item', formatter: '{b}: {c} MB ({d}%)' },
                            legend: { bottom: 0 },
                            series: [{
                                type: 'pie', radius: ['48%', '68%'], center: ['50%', '46%'],
                                label: { formatter: '{b}\n{d}%' },
                                data: (sizeSlices.length ? sizeSlices : this.dashboard.sizeSlices).map(function (x) {
                                    return { name: x.name, value: Number(x.value || 0), itemStyle: { color: x.color } };
                                })
                            }],
                            graphic: [{ type: 'text', left: 'center', top: '42%', style: { text: this.dashboard.sizeTotalLabel || '0B', fill: '#303133', fontSize: 22, fontWeight: 600, textAlign: 'center' } }]
                        }, true);
                    }
                    var countSlices = (this.dashboard.countSlices || []).filter(function (x) { return Number(x.value) > 0; });
                    var countChart = this.getOrCreateChart(this.$refs.countChart);
                    if (countChart) {
                        countChart.setOption({
                            tooltip: { trigger: 'item', formatter: '{b}: {c} 个 ({d}%)' },
                            legend: { bottom: 0 },
                            series: [{
                                type: 'pie', radius: ['48%', '68%'], center: ['50%', '46%'],
                                label: { formatter: '{b}\n{c}个' },
                                data: (countSlices.length ? countSlices : this.dashboard.countSlices).map(function (x) {
                                    return { name: x.name, value: Number(x.value || 0), itemStyle: { color: x.color } };
                                })
                            }],
                            graphic: [{ type: 'text', left: 'center', top: '42%', style: { text: String(this.dashboard.countTotalLabel || '0'), fill: '#303133', fontSize: 28, fontWeight: 600, textAlign: 'center' } }]
                        }, true);
                    }
                    [capacityChart, sizeChart, countChart].forEach(function (c) { if (c) c.resize(); });
                };

                // 修复列表解析：PagedList 序列化为数组时，原先取 result.data/items 会得到空表
                vm.getList = async function () {
                    var pageUrlLocal = window.location.pathname || '/Admin/FileManager/Index';
                    this.tableLoading = true;
                    try {
                        var url = pageUrlLocal + '?handler=List&page=' + this.page.page + '&pageSize=' + this.page.size + '&resourceScope=' + this.resourceScope;
                        if (this.currentFolderId != null) url += '&folderId=' + encodeURIComponent(this.currentFolderId);
                        var response = await axios.get(url);
                        var result = response && response.data && response.data.data !== undefined ? response.data.data : (response && response.data);
                        if (Array.isArray(result)) {
                            this.tableData = typeof this.filterOutRecycledFiles === 'function' ? this.filterOutRecycledFiles(result) : result;
                            this.total = result.length;
                        } else {
                            var items = (result && (result.items || result.data)) || [];
                            this.tableData = typeof this.filterOutRecycledFiles === 'function' ? this.filterOutRecycledFiles(items) : items;
                            this.total = (result && (result.totalCount != null ? result.totalCount : result.total)) || 0;
                        }
                        if (typeof this.syncFavoriteFlagsOnTable === 'function') this.syncFavoriteFlagsOnTable();
                        if (typeof this.applyFileTagsToTable === 'function') this.applyFileTagsToTable();
                    } catch (error) {
                        var data = error && error.response && error.response.data;
                        var message = typeof data === 'string' ? data : (data && (data.errorMessage || data.message || data.title));
                        this.$message.error('获取文件列表失败：' + (message || (error && error.message) || '请求失败'));
                    } finally {
                        this.tableLoading = false;
                    }
                };

                if (!vm.fileTagDialog) {
                    Vue.set(vm, 'fileTagDialog', {
                        visible: false,
                        loading: false,
                        row: null,
                        selectedIds: []
                    });
                } else if (!Array.isArray(vm.fileTagDialog.selectedIds)) {
                    Vue.set(vm.fileTagDialog, 'selectedIds', []);
                }
                if (!vm.fileTagStorageKey) Vue.set(vm, 'fileTagStorageKey', 'ncf.fileManager.fileTags');
                if (!vm.fileTagMap) Vue.set(vm, 'fileTagMap', {});

                vm.getFileTagItems = function (row) {
                    if (!row) return [];
                    if (Array.isArray(row.tagItems) && row.tagItems.length) {
                        return row.tagItems.map(function (item) {
                            if (typeof item === 'string') return { id: item, name: item };
                            return { id: item.id, name: item.name || item.id };
                        });
                    }
                    var fromMap = this.fileTagMap && row.id != null ? this.fileTagMap[String(row.id)] : null;
                    if (Array.isArray(fromMap) && fromMap.length) {
                        return fromMap.map(function (item) {
                            if (typeof item === 'string') return { id: item, name: item };
                            return { id: item.id, name: item.name || item.id };
                        });
                    }
                    if (Array.isArray(row.tags) && row.tags.length) {
                        return row.tags.map(function (item) {
                            if (typeof item === 'string') return { id: item, name: item };
                            return { id: item.id, name: item.name || item.id };
                        });
                    }
                    return [];
                };
                vm.getFileTagLabels = function (row) {
                    return this.getFileTagItems(row).map(function (item) { return item.name; }).filter(Boolean);
                };
                vm.removeSelectedFileTag = function (tagId) {
                    if (!this.fileTagDialog || !Array.isArray(this.fileTagDialog.selectedIds)) return;
                    this.fileTagDialog.selectedIds = this.fileTagDialog.selectedIds.filter(function (id) { return id !== tagId; });
                };
                vm.loadFileTagMapFromStorage = function () {
                    try {
                        var raw = localStorage.getItem(this.fileTagStorageKey || 'ncf.fileManager.fileTags');
                        var map = raw ? JSON.parse(raw) : {};
                        this.fileTagMap = map && typeof map === 'object' && !Array.isArray(map) ? map : {};
                    } catch (e) {
                        this.fileTagMap = {};
                    }
                };
                vm.saveFileTagMapToStorage = function () {
                    try {
                        localStorage.setItem(
                            this.fileTagStorageKey || 'ncf.fileManager.fileTags',
                            JSON.stringify(this.fileTagMap || {})
                        );
                    } catch (e) { /* ignore */ }
                };
                vm.applyFileTagsToTable = function () {
                    var self = this;
                    if (!this.fileTagMap) this.loadFileTagMapFromStorage();
                    (this.tableData || []).forEach(function (row) {
                        var mapped = self.fileTagMap && row.id != null ? self.fileTagMap[String(row.id)] : null;
                        var finalItems = Array.isArray(mapped)
                            ? mapped.map(function (item) {
                                if (typeof item === 'string') return { id: item, name: item };
                                return { id: item.id, name: item.name || item.id };
                            })
                            : [];
                        self.$set(row, 'tagItems', finalItems);
                        self.$set(row, 'tags', finalItems.map(function (item) { return item.name; }));
                        self.$set(row, 'tagIds', finalItems.map(function (item) { return item.id; }));
                    });
                };
                vm.showFileTagDialog = function (row) {
                    if (typeof this.loadTagManagerFromStorage === 'function') this.loadTagManagerFromStorage();
                    this.loadFileTagMapFromStorage();
                    var catalog = (this.tagManager && this.tagManager.tags) || [];
                    if (!catalog.length) {
                        this.$message.warning('请先在「标签管理」中维护标签后再设置');
                    }
                    var existingItems = this.getFileTagItems(row);
                    var selectedIds = existingItems.map(function (item) { return item.id; }).filter(Boolean);
                    this.fileTagDialog = {
                        visible: true,
                        loading: false,
                        row: row,
                        selectedIds: selectedIds
                    };
                };
                vm.onFileTagDialogClosed = function () {
                    if (!this.fileTagDialog) return;
                    this.fileTagDialog.loading = false;
                    this.fileTagDialog.row = null;
                    this.fileTagDialog.selectedIds = [];
                };
                vm.submitFileTags = function () {
                    var row = this.fileTagDialog && this.fileTagDialog.row;
                    if (!row || row.id == null) return;
                    this.fileTagDialog.loading = true;
                    try {
                        var selectedIds = (this.fileTagDialog.selectedIds || []).slice();
                        var catalogMap = {};
                        ((this.tagManager && this.tagManager.tags) || []).forEach(function (tag) {
                            catalogMap[tag.id] = tag;
                        });
                        var items = selectedIds.map(function (id) {
                            var hit = catalogMap[id];
                            return hit
                                ? { id: hit.id, name: hit.name, categoryId: hit.categoryId || '' }
                                : { id: id, name: String(id) };
                        });
                        if (!this.fileTagMap) this.fileTagMap = {};
                        this.$set(this.fileTagMap, String(row.id), items);
                        this.saveFileTagMapToStorage();
                        this.$set(row, 'tagItems', items);
                        this.$set(row, 'tags', items.map(function (item) { return item.name; }));
                        this.$set(row, 'tagIds', items.map(function (item) { return item.id; }));
                        this.fileTagDialog.visible = false;
                        this.$message.success(items.length ? '文件标签已更新' : '已清空文件标签');
                    } finally {
                        this.fileTagDialog.loading = false;
                    }
                };
                if (!vm.__fileTagsLoaded) {
                    vm.__fileTagsLoaded = true;
                    vm.loadFileTagMapFromStorage();
                }

                var originalHandleRowCommand = vm.handleRowCommand && vm.handleRowCommand.bind(vm);
                vm.handleRowCommand = function (command, row) {
                    if (command === 'manageTags') return this.showFileTagDialog(row);
                    if (command === 'toggleQuickAccess') return this.toggleQuickAccess(row);
                    if (typeof originalHandleRowCommand === 'function') return originalHandleRowCommand(command, row);
                };

                if (typeof vm.getList === 'function' && !vm.__fileListPatched) {
                    vm.__fileListPatched = true;
                    vm.getList();
                }
            }
            apply();
        })();
    </script>
}
