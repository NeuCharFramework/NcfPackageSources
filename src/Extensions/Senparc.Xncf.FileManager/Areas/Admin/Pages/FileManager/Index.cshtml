@page
@model Senparc.Xncf.FileManager.Areas.FileManager.Pages.Index
@{
    ViewData["Title"] = "文件资源管理";
    Layout = "_Layout_Vue";
}

@section breadcrumbs {
    <el-breadcrumb-item>扩展模块</el-breadcrumb-item>
    <el-breadcrumb-item>文件资源管理</el-breadcrumb-item>
}

@section style {
    <link rel="stylesheet" href="~/css/Admin/FileManager/index.css" />
}

<div class="file-manager-layout">
    @Html.AntiForgeryToken()
    <aside class="file-manager-folders">
        <el-card shadow="never">
            <div slot="header" class="file-manager-card-header">
                <span>{{ resourceScopeName }}文件夹</span>
                <el-button type="text" size="mini" @@click="showCreateFolderDialog">新建</el-button>
            </div>
            <el-button class="file-manager-root-button" :class="{ 'is-active': currentFolderId === null }" type="text" @@click="enterFolder(null)">
                <i class="el-icon-folder-opened"></i> 根目录
            </el-button>
            <el-tree
                :key="folderTreeKey"
                ref="folderTree"
                :data="folderTree"
                :props="folderTreeProps"
                node-key="id"
                lazy
                highlight-current
                :expand-on-click-node="false"
                :load="loadFolderChildren"
                @@node-click="onFolderNodeClick">
                <span class="file-manager-tree-node" slot-scope="{ node, data }">
                    <span><i class="el-icon-folder"></i> {{ data.name }}</span>
                    <span class="file-manager-tree-actions">
                        <el-button type="text" icon="el-icon-edit" @@click.stop="showEditFolderDialog(data)"></el-button>
                        <el-button type="text" icon="el-icon-delete" @@click.stop="deleteFolder(data)"></el-button>
                    </span>
                </span>
            </el-tree>
        </el-card>
    </aside>

    <main class="file-manager-content">
        <div class="filter-container file-manager-toolbar">
            <el-select v-model="resourceScope" size="small" class="file-manager-scope-select" @@change="changeResourceScope">
                <el-option :value="100" label="知识库源文件"></el-option>
                <el-option :value="200" label="站点静态资源"></el-option>
            </el-select>
            <el-button type="primary" icon="el-icon-upload" size="small" @@click="showUploadDialog">上传文件</el-button>
            <el-button size="small" icon="el-icon-refresh" @@click="reloadFolderTree">刷新</el-button>
            <el-button type="text" size="small" icon="el-icon-question" @@click="guideDialogVisible = true">使用说明</el-button>
        </div>

        <el-alert
            class="file-manager-scope-hint"
            type="info"
            :closable="false"
            show-icon
            :title="scopeHint">
        </el-alert>

        <div class="folder-breadcrumb">
            <el-breadcrumb separator="/">
                <el-breadcrumb-item><a href="javascript:void(0)" @@click="enterFolder(null)">根目录</a></el-breadcrumb-item>
                <el-breadcrumb-item v-for="item in folderPath" :key="item.id">
                    <a href="javascript:void(0)" @@click="enterFolder(item.id)">{{ item.name }}</a>
                </el-breadcrumb-item>
            </el-breadcrumb>
        </div>

        <el-table :data="tableData" v-loading="tableLoading" border>
            <template slot="empty">
                <div class="file-manager-empty">
                    <i class="el-icon-folder-opened"></i>
                    <strong>{{ resourceScopeName }}还没有文件</strong>
                    <span>{{ isSiteAsset ? '先上传资源，确认预览后再公开并复制 URL。' : '先上传可提取资料，再到知识库中关联并向量化。' }}</span>
                    <el-button type="primary" size="mini" @@click="showUploadDialog">上传第一个文件</el-button>
                </div>
            </template>
            <el-table-column prop="fileName" label="文件名" min-width="190"></el-table-column>
            <el-table-column prop="fileSize" label="大小" width="110">
                <template slot-scope="scope">{{ formatFileSize(scope.row.fileSize) }}</template>
            </el-table-column>
            <el-table-column prop="fileType" label="类型" width="110">
                <template slot-scope="scope">{{ fileTypeLabel(scope.row.fileType) }}</template>
            </el-table-column>
            <el-table-column prop="contentType" label="MIME" min-width="150"></el-table-column>
            <el-table-column v-if="isSiteAsset" label="发布状态" width="110">
                <template slot-scope="scope">
                    <el-tag :type="scope.row.accessLevel === 100 ? 'success' : 'info'" size="mini">
                        {{ scope.row.accessLevel === 100 ? '已公开' : '私有' }}
                    </el-tag>
                </template>
            </el-table-column>
            <el-table-column prop="description" label="备注" min-width="180">
                <template slot-scope="scope">
                    <el-input v-model="scope.row.description" size="small" @@blur="handleNoteChange(scope.row)"></el-input>
                </template>
            </el-table-column>
            <el-table-column prop="uploadTime" label="上传时间" width="170">
                <template slot-scope="scope">{{ dateFormatter(scope.row.uploadTime) }}</template>
            </el-table-column>
            <el-table-column label="操作" width="310">
                <template slot-scope="scope">
                    <el-button type="primary" size="mini" @@click="downloadFile(scope.row)">下载</el-button>
                    <el-button v-if="isSiteAsset" size="mini" @@click="setPublication(scope.row, scope.row.accessLevel !== 100)">
                        {{ scope.row.accessLevel === 100 ? '取消公开' : '公开' }}
                    </el-button>
                    <el-button v-if="isSiteAsset && scope.row.publicUrl" size="mini" @@click="copyPublicUrl(scope.row)">复制 URL</el-button>
                    <el-button type="danger" size="mini" @@click="deleteFile(scope.row)">删除</el-button>
                </template>
            </el-table-column>
        </el-table>

        <div class="pagination-container">
            <el-pagination
                @@current-change="handleCurrentChange"
                @@size-change="handleSizeChange"
                :current-page="page.page"
                :page-sizes="[10, 20, 30, 40]"
                :page-size="page.size"
                layout="total, sizes, prev, pager, next"
                :total="total">
            </el-pagination>
        </div>
    </main>

    <el-dialog title="上传文件" :visible.sync="uploadDialog.visible" width="540px">
        <el-upload
            ref="upload"
            action="#"
            :auto-upload="false"
            :multiple="true"
            :show-file-list="true"
            :on-change="handleFileChange"
            :before-upload="beforeUpload"
            :file-list="uploadDialog.fileList">
            <el-button slot="trigger" size="small" type="primary">选择文件</el-button>
            <el-button size="small" icon="el-icon-folder-opened" @@click.stop="chooseUploadFolder">选择文件夹</el-button>
            <div slot="tip" class="el-upload__tip">{{ uploadExtensionHint }}。选择文件夹后会保留其完整层级结构；每批最多 20 个文件，系统会自动分批上传。</div>
        </el-upload>
        <input ref="folderUploadInput" class="file-manager-folder-input" type="file" webkitdirectory directory multiple @@change="handleFolderSelection" />
        <el-alert v-if="uploadFolderSummary" class="file-manager-folder-upload-summary" type="success" :closable="false" show-icon :title="uploadFolderSummary"></el-alert>
        <el-alert class="file-manager-upload-target" type="info" show-icon :closable="false" title="上传位置" :description="uploadTargetText"></el-alert>
        <el-progress v-if="uploadDialog.uploading" :percentage="uploadDialog.progress" :stroke-width="10" status="success"></el-progress>
        <div v-for="file in uploadDialog.fileList" :key="file.uid" class="file-manager-upload-note">
            <el-input v-model="file.description" :placeholder="file.name + ' 的备注'" size="small"></el-input>
        </div>
        <span slot="footer" class="dialog-footer">
            <el-button @@click="cancelUpload">取消</el-button>
            <el-button type="primary" @@click="submitUpload" :loading="uploadDialog.uploading">上传</el-button>
        </span>
    </el-dialog>

    <el-dialog :title="folderDialog.editing ? '编辑文件夹' : '新建文件夹'" :visible.sync="folderDialog.visible" width="420px">
        <el-form :model="folderDialog.form" label-width="80px">
            <el-form-item label="名称"><el-input v-model="folderDialog.form.name" placeholder="请输入文件夹名称"></el-input></el-form-item>
            <el-form-item label="备注"><el-input type="textarea" v-model="folderDialog.form.description" placeholder="可选" rows="3"></el-input></el-form-item>
        </el-form>
        <span slot="footer" class="dialog-footer">
            <el-button @@click="folderDialog.visible=false">取消</el-button>
            <el-button type="primary" @@click="submitFolder" :loading="folderDialog.loading">确定</el-button>
        </span>
    </el-dialog>

    <el-dialog title="文件资源管理使用说明" :visible.sync="guideDialogVisible" width="520px">
        <ol class="file-manager-guide">
            <li><strong>先选用途：</strong>知识库资料和站点静态资源会物理隔离，不能互相转换。</li>
            <li><strong>再放位置：</strong>在左侧选择或新建文件夹；刷新页面后，当前用途和文件夹会保留在地址栏中。</li>
            <li v-if="!isSiteAsset"><strong>知识库资料：</strong>上传后到“知识库管理 → 配置”关联资料，保存后点击“向量化”。</li>
            <li v-else><strong>站点资源：</strong>上传默认私有；确认无误后点“公开”，再复制生成的 URL 到站点内容中。</li>
        </ol>
        <span slot="footer" class="dialog-footer"><el-button type="primary" @@click="guideDialogVisible = false">我知道了</el-button></span>
    </el-dialog>
</div>

@section scripts {
    <partial name="~/Areas/Admin/Pages/Shared/_LocalizationScripts.cshtml" />
    <script src="~/js/Admin/FileManager/index.js" asp-append-version="true"></script>
}
