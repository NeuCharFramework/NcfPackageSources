@page
@model Senparc.Xncf.FileManager.Areas.FileManager.Pages.Index
@{
    ViewData["Title"] = "文件资源管理";
    Layout = "_Layout_Vue";
}

@section breadcrumbs {
    <el-breadcrumb-item>扩展模块</el-breadcrumb-item>
    <el-breadcrumb-item>文件资源管理</el-breadcrumb-item>
}

@section Style {
    <link rel="stylesheet" href="~/css/Admin/FileManager/index.css" asp-append-version="true" />
    <style>
        /* ========== 清除父级对布局节点的控制 ========== */
        .el-main.admin-content:has(.file-manager-layout),
        .admin-content:has(.file-manager-layout) {
            all: unset;
            display: block !important;
            box-sizing: border-box !important;
            width: 100% !important;
            height: calc(100vh - 96px) !important;
            padding: 0 !important;
            margin: 0 !important;
            overflow: hidden !important;
            background: #fff !important;
        }

        .admin-content:has(.file-manager-layout) .ifram-wrapper {
            all: unset;
            display: block !important;
            box-sizing: border-box !important;
            width: 100% !important;
            height: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
            overflow: hidden !important;
        }

        /* ========== 根布局：横向 flex ========== */
        .file-manager-layout {
            display: flex !important;
            flex-direction: row !important;
            flex-wrap: nowrap !important;
            align-items: stretch !important;
            box-sizing: border-box !important;
            width: 100% !important;
            height: 100% !important;
            min-height: 480px !important;
            margin: 0 !important;
            padding: 0 !important;
            background: #fff !important;
            overflow: hidden !important;
            float: none !important;
            position: relative !important;
        }

        /* ========== 左栏 / 主区域 ========== */
        .file-manager-layout-left,
        .file-manager-layout-main {
            box-sizing: border-box !important;
            height: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            overflow: hidden !important;
            float: none !important;
            position: relative !important;
        }

        .file-manager-layout-left {
            flex: 0 0 15% !important;
            width: 15% !important;
            max-width: 15% !important;
            border-right: 1px solid #ebeef5 !important;
            background: #f5f7fa !important;
        }

        .file-manager-layout-main {
            flex: 1 1 85% !important;
            width: 85% !important;
            min-width: 0 !important;
            background: #fff !important;
            display: flex !important;
            flex-direction: column !important;
        }

        /* 文件浏览：主区域内再分 树 + 表 */
        .file-manager-layout-main .file-manager-browser {
            display: flex;
            flex-direction: row;
            align-items: stretch;
            box-sizing: border-box;
            width: 100%;
            height: 100%;
            min-height: 0;
            overflow: hidden;
        }

        .file-manager-layout-main .file-manager-tree-wrap {
            flex: 0 0 18%;
            width: 18%;
            max-width: 280px;
            min-width: 180px;
            height: 100%;
            border-right: 1px solid #ebeef5;
            background: #fff;
            overflow: hidden;
        }

        .file-manager-layout-main .file-manager-content-wrap {
            flex: 1 1 auto;
            min-width: 0;
            height: 100%;
            overflow: hidden;
            background: #fff;
        }

        /* ========== 左栏：导航 ========== */
        .file-manager-layout-left .file-manager-nav-panel {
            box-sizing: border-box;
            width: 100%;
            height: 100%;
            overflow-x: hidden;
            overflow-y: auto;
        }

        .file-manager-layout-left .file-manager-nav-list {
            list-style: none;
            margin: 0;
            padding: 8px 0;
        }

        .file-manager-layout-left .file-manager-nav-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 14px;
            font-size: 13px;
            color: #606266;
            cursor: pointer;
            user-select: none;
        }

        .file-manager-layout-left .file-manager-nav-item i {
            width: 16px;
            text-align: center;
            color: #909399;
            font-size: 14px;
        }

        .file-manager-layout-left .file-manager-nav-item:hover {
            color: #303133;
            background: #eef1f6;
        }

        .file-manager-layout-left .file-manager-nav-item.is-active {
            color: #409eff;
            background: #ecf5ff;
            font-weight: 500;
        }

        .file-manager-layout-left .file-manager-nav-item.is-active i {
            color: #409eff;
        }

        .file-manager-layout-left .file-manager-nav-item.is-divider {
            height: 1px;
            padding: 0;
            margin: 8px 14px;
            background: #e4e7ed;
            cursor: default;
            pointer-events: none;
        }

        /* ========== 中栏：目录树 ========== */
        .file-manager-layout-main .file-manager-tree-wrap .file-manager-tree-panel {
            display: flex;
            flex-direction: column;
            box-sizing: border-box;
            width: 100%;
            height: 100%;
            overflow: hidden;
        }

        .file-manager-layout-main .file-manager-tree-wrap .file-manager-org-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            flex-shrink: 0;
            padding: 14px 12px 10px;
            border-bottom: 1px solid #f0f2f5;
        }

        .file-manager-layout-main .file-manager-tree-wrap .file-manager-org-name {
            font-size: 13px;
            font-weight: 600;
            color: #303133;
            line-height: 1.4;
            word-break: break-all;
        }

        .file-manager-layout-main .file-manager-tree-wrap .file-manager-org-toggle {
            flex-shrink: 0;
            color: #909399;
            cursor: pointer;
        }

        .file-manager-layout-main .file-manager-tree-wrap .file-manager-tree-search {
            flex-shrink: 0;
            padding: 8px 10px;
            border-bottom: 1px solid #f0f2f5;
        }

        .file-manager-layout-main .file-manager-tree-wrap .file-manager-tree-body {
            flex: 1;
            min-height: 0;
            overflow: auto;
            padding: 6px 0 12px;
        }

        .file-manager-layout-main .file-manager-tree-wrap .file-manager-root-node {
            display: flex;
            align-items: center;
            gap: 6px;
            margin: 0 8px 4px;
            padding: 7px 10px;
            border-radius: 4px;
            color: #606266;
            cursor: pointer;
            font-size: 13px;
        }

        .file-manager-layout-main .file-manager-tree-wrap .file-manager-root-node:hover,
        .file-manager-layout-main .file-manager-tree-wrap .file-manager-root-node.is-active {
            color: #409eff;
            background: #ecf5ff;
        }

        .file-manager-layout-main .file-manager-tree-wrap .file-manager-tree-node {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            min-width: 0;
        }

        .file-manager-layout-main .file-manager-tree-wrap .file-manager-tree-label {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font-size: 13px;
        }

        .file-manager-layout-main .file-manager-tree-wrap .file-manager-tree-actions {
            display: none;
            white-space: nowrap;
        }

        .file-manager-layout-main .file-manager-tree-wrap .el-tree-node__content:hover .file-manager-tree-actions {
            display: inline-flex;
        }

        .file-manager-layout-main .file-manager-tree-wrap .file-manager-tree-actions .el-button {
            margin-left: 2px;
            padding: 2px;
        }

        .file-manager-layout-main .file-manager-tree-wrap .el-tree {
            background: transparent;
        }

        .file-manager-layout-main .file-manager-tree-wrap .el-tree-node__content {
            height: 32px;
        }

        /* ========== 右栏：文件表 ========== */
        .file-manager-layout-main .file-manager-main-panel {
            display: flex;
            flex-direction: column;
            box-sizing: border-box;
            width: 100%;
            height: 100%;
            overflow: hidden;
        }

        .file-manager-layout-main .file-manager-top-bar {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-shrink: 0;
            padding: 12px 16px;
            border-bottom: 1px solid #f0f2f5;
        }

        .file-manager-layout-main .file-manager-top-search {
            flex: 1;
            max-width: 420px;
            min-width: 0;
        }

        .file-manager-layout-main .file-manager-top-actions {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
        }

        .file-manager-layout-main .file-manager-nav-bar {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
            padding: 10px 16px;
            border-bottom: 1px solid #f0f2f5;
            color: #909399;
            font-size: 13px;
        }

        .file-manager-layout-main .file-manager-back-link {
            color: #409eff;
            text-decoration: none;
            white-space: nowrap;
        }

        .file-manager-layout-main .file-manager-back-link:hover {
            color: #66b1ff;
        }

        .file-manager-layout-main .file-manager-nav-divider {
            color: #dcdfe6;
        }

        .file-manager-layout-main .file-manager-nav-bar .el-breadcrumb {
            line-height: 1;
        }

        .file-manager-layout-main .file-manager-table-wrap {
            flex: 1;
            min-height: 0;
            padding: 0 16px;
            overflow: auto;
        }

        .file-manager-layout-main .file-manager-pagination {
            display: flex;
            justify-content: flex-end;
            flex-shrink: 0;
            padding: 12px 16px;
            border-top: 1px solid #f0f2f5;
        }

        .file-manager-layout-main .file-manager-empty {
            display: flex;
            min-height: 280px;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 12px;
            color: #909399;
        }

        .file-manager-layout-main .file-manager-empty i {
            color: #c0c4cc;
            font-size: 48px;
        }

        .file-manager-layout-main .file-manager-empty strong {
            color: #606266;
            font-size: 14px;
        }

        .file-manager-file-name-cell {
            display: flex;
            align-items: center;
            gap: 8px;
            min-width: 0;
        }

        .file-manager-file-name-text {
            flex: 1;
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .file-manager-favorite-star {
            flex-shrink: 0;
            font-size: 16px;
            color: #c0c4cc;
            cursor: pointer;
            line-height: 1;
            transition: color 0.15s ease, transform 0.15s ease;
        }

        .file-manager-favorite-star:hover {
            color: #f7ba2a;
            transform: scale(1.08);
        }

        .file-manager-favorite-star.is-on {
            color: #f7ba2a;
        }

        .file-manager-favorite-name-cell {
            display: flex;
            flex-direction: column;
            gap: 4px;
            min-width: 0;
            padding: 4px 0;
        }

        .file-manager-favorite-name {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            color: #303133;
        }

        .file-manager-favorite-path {
            font-size: 12px;
            color: #909399;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        /* ========== 数据面板：占满 file-manager-layout-main ========== */
        .file-manager-layout-main .file-manager-dashboard-panel {
            box-sizing: border-box;
            flex: 1 1 auto;
            width: 100%;
            height: 100%;
            min-height: 0;
            padding: 12px;
            overflow: auto;
            background: #f0f2f5;
        }

        .file-manager-dashboard-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            grid-template-rows: minmax(300px, 1fr) minmax(300px, 1fr);
            gap: 12px;
            width: 100%;
            height: 100%;
            min-height: calc(100vh - 140px);
        }

        .file-manager-dash-chart {
            flex: 1;
            min-height: 240px;
            width: 100%;
        }

        .file-manager-dash-card {
            display: flex;
            flex-direction: column;
            min-height: 0;
            background: #fff;
            border: 1px solid #e4e7ed;
            border-radius: 4px;
            overflow: hidden;
        }

        .file-manager-dash-card-header {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-shrink: 0;
            padding: 12px 14px 0;
            font-size: 14px;
            font-weight: 600;
            color: #303133;
        }

        .file-manager-dash-card-header .el-icon-question {
            color: #c0c4cc;
            font-size: 14px;
            cursor: help;
        }

        .file-manager-dash-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            flex-wrap: wrap;
            flex-shrink: 0;
            padding: 10px 14px;
        }

        .file-manager-dash-meta {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            flex-wrap: wrap;
            flex-shrink: 0;
            padding: 8px 14px 0;
            font-size: 12px;
            color: #909399;
        }

        .file-manager-dash-used-tag {
            padding: 2px 8px;
            border-radius: 2px;
            background: #f0f9eb;
            color: #67c23a;
            font-size: 12px;
            white-space: nowrap;
        }

        .file-manager-dash-org-list {
            flex: 1;
            min-height: 0;
            margin: 8px 0 0;
            padding: 0 14px 12px;
            overflow: auto;
        }

        .file-manager-dash-org-head,
        .file-manager-dash-org-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 10px 0;
            border-bottom: 1px solid #f0f2f5;
            font-size: 13px;
        }

        .file-manager-dash-org-head {
            color: #909399;
            font-weight: 500;
            position: sticky;
            top: 0;
            background: #fff;
            z-index: 1;
        }

        .file-manager-dash-org-row {
            color: #606266;
        }

        .file-manager-dash-org-name {
            display: flex;
            align-items: center;
            gap: 6px;
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .file-manager-dash-org-name i {
            color: #409eff;
            flex-shrink: 0;
        }

        .file-manager-dash-org-size {
            flex-shrink: 0;
            color: #909399;
        }

        .file-manager-folder-input {
            display: none !important;
        }

        .file-manager-folder-upload-summary,
        .file-manager-upload-target {
            margin: 12px 0;
        }

        .file-manager-upload-note {
            margin-top: 10px;
        }

        /* ========== 上传对话框（图1样式） ========== */
        .file-manager-upload-dialog .el-dialog__header {
            padding: 14px 20px;
            border-bottom: 1px solid #ebeef5;
        }

        .file-manager-upload-dialog .el-dialog__title {
            font-size: 15px;
            font-weight: 600;
            color: #303133;
            line-height: 1.4;
        }

        .file-manager-upload-dialog .el-dialog__body {
            padding: 16px 20px 8px;
        }

        .file-manager-upload-dialog .el-dialog__footer {
            padding: 12px 20px 16px;
            border-top: 1px solid #ebeef5;
        }

        .file-manager-upload-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 12px;
        }

        .file-manager-upload-dropzone {
            width: 100%;
        }

        .file-manager-upload-dropzone .el-upload {
            width: 100%;
        }

        .file-manager-upload-dropzone .el-upload-dragger {
            width: 100%;
            height: 220px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px dashed #c0c4cc;
            border-radius: 4px;
            background: #fff;
        }

        .file-manager-upload-dropzone .el-upload-dragger:hover {
            border-color: #409eff;
        }

        .file-manager-upload-drop-hint {
            color: #c0c4cc;
            font-size: 18px;
            line-height: 1.6;
            text-align: center;
            padding: 0 24px;
            pointer-events: none;
        }

        .file-manager-upload-tip {
            margin-top: 10px;
            color: #909399;
            font-size: 12px;
            line-height: 1.6;
        }

        .file-manager-upload-filelist {
            margin-top: 12px;
            max-height: 180px;
            overflow: auto;
        }

        .file-manager-upload-start-btn {
            background-color: #67c23a !important;
            border-color: #67c23a !important;
            color: #fff !important;
        }

        .file-manager-upload-start-btn:hover,
        .file-manager-upload-start-btn:focus {
            background-color: #85ce61 !important;
            border-color: #85ce61 !important;
            color: #fff !important;
        }

        .file-manager-guide {
            margin: 0;
            padding-left: 22px;
            color: #606266;
            line-height: 1.9;
        }

        /* ========== 标签管理：占满 file-manager-layout-main ========== */
        .file-manager-layout-main .file-manager-tags-panel {
            box-sizing: border-box;
            flex: 1 1 auto;
            display: flex;
            flex-direction: column;
            width: 100%;
            height: 100%;
            min-height: 0;
            padding: 16px 20px;
            overflow: hidden;
            background: #fff;
        }

        .file-manager-tags-filter {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px 16px;
            flex-shrink: 0;
            margin-bottom: 16px;
        }

        .file-manager-tags-filter-item {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .file-manager-tags-filter-item > span {
            color: #606266;
            font-size: 13px;
            white-space: nowrap;
        }

        .file-manager-tags-filter-item .el-input,
        .file-manager-tags-filter-item .el-select {
            width: 200px;
        }

        .file-manager-tags-filter-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .file-manager-tags-toolbar {
            display: flex;
            justify-content: flex-end;
            flex-wrap: wrap;
            gap: 8px;
            flex-shrink: 0;
            margin-bottom: 12px;
        }

        .file-manager-tags-table-wrap {
            flex: 1;
            min-height: 0;
            overflow: auto;
        }

        .file-manager-tags-empty {
            display: flex;
            min-height: 320px;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 12px;
            color: #909399;
        }

        .file-manager-tags-empty i {
            font-size: 48px;
            color: #c0c4cc;
        }

        .file-manager-tags-empty strong {
            color: #606266;
            font-size: 14px;
            font-weight: 400;
        }

        /* ========== 回收站：占满 file-manager-layout-main ========== */
        .file-manager-layout-main .file-manager-recycle-panel {
            box-sizing: border-box;
            flex: 1 1 auto;
            display: flex;
            flex-direction: column;
            width: 100%;
            height: 100%;
            min-height: 0;
            padding: 0;
            overflow: hidden;
            background: #fff;
        }

        .file-manager-recycle-header {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            flex-shrink: 0;
            padding: 12px 16px;
            border-bottom: 1px solid #f0f2f5;
            position: relative;
            z-index: 2;
        }

        .file-manager-recycle-empty-dialog .file-manager-recycle-empty-body {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 8px 0 4px;
        }

        .file-manager-recycle-empty-dialog .file-manager-recycle-empty-body > i {
            font-size: 24px;
            color: #e6a23c;
            line-height: 1.2;
            margin-top: 2px;
        }

        .file-manager-recycle-empty-dialog .file-manager-recycle-empty-text strong {
            display: block;
            font-size: 16px;
            color: #303133;
            font-weight: 500;
            margin-bottom: 8px;
        }

        .file-manager-recycle-empty-dialog .file-manager-recycle-empty-text p {
            margin: 0;
            color: #606266;
            font-size: 14px;
        }

        .file-manager-recycle-table-wrap {
            flex: 1;
            min-height: 0;
            overflow: auto;
            padding: 0 16px;
        }

        .file-manager-recycle-empty {
            display: flex;
            min-height: 360px;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 12px;
            color: #909399;
        }

        .file-manager-recycle-empty i {
            font-size: 52px;
            color: #c0c4cc;
        }

        .file-manager-recycle-empty strong {
            color: #606266;
            font-size: 14px;
            font-weight: 400;
        }

        .file-manager-recycle-pagination {
            display: flex;
            justify-content: flex-end;
            flex-shrink: 0;
            padding: 12px 16px;
            border-top: 1px solid #f0f2f5;
        }

        /* ========== 收藏：占满 file-manager-layout-main ========== */
        .file-manager-layout-main .file-manager-favorite-panel {
            box-sizing: border-box;
            flex: 1 1 auto;
            display: flex;
            flex-direction: column;
            width: 100%;
            height: 100%;
            min-height: 0;
            padding: 0;
            overflow: hidden;
            background: #fff;
        }

        .file-manager-favorite-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-shrink: 0;
            padding: 12px 16px;
            border-bottom: 1px solid #f0f2f5;
        }

        .file-manager-favorite-search {
            flex: 1;
            max-width: 420px;
            min-width: 0;
        }

        .file-manager-favorite-table-wrap {
            flex: 1;
            min-height: 0;
            overflow: auto;
            padding: 0 16px;
        }

        .file-manager-favorite-empty {
            display: flex;
            min-height: 360px;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 12px;
            color: #909399;
        }

        .file-manager-favorite-empty i {
            font-size: 52px;
            color: #c0c4cc;
        }

        .file-manager-favorite-empty strong {
            color: #606266;
            font-size: 14px;
            font-weight: 400;
        }

        .file-manager-favorite-pagination {
            display: flex;
            justify-content: flex-end;
            flex-shrink: 0;
            padding: 12px 16px;
            border-top: 1px solid #f0f2f5;
        }

        /* ========== 首页：占满 file-manager-layout-main ========== */
        .file-manager-layout-main .file-manager-home-panel {
            box-sizing: border-box;
            flex: 1 1 auto;
            display: flex;
            flex-direction: column;
            width: 100%;
            height: 100%;
            min-height: 0;
            padding: 0;
            overflow: hidden;
            background: #fff;
        }

        .file-manager-home-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-shrink: 0;
            padding: 12px 16px;
            border-bottom: 1px solid #f0f2f5;
        }

        .file-manager-home-search {
            flex: 1;
            max-width: 420px;
            min-width: 0;
        }

        .file-manager-home-actions {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
        }

        .file-manager-home-banner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
            flex-shrink: 0;
            margin: 16px;
            padding: 24px 28px;
            border-radius: 8px;
            background: linear-gradient(90deg, #eef4ff 0%, #f3e9ff 55%, #e8f3ff 100%);
            overflow: hidden;
        }

        .file-manager-home-banner-text {
            flex: 1;
            min-width: 0;
        }

        .file-manager-home-banner-text h3 {
            margin: 0 0 10px;
            font-size: 20px;
            font-weight: 600;
            color: #3a5ccc;
            line-height: 1.4;
        }

        .file-manager-home-banner-text p {
            margin: 0;
            font-size: 13px;
            color: #606266;
            line-height: 1.7;
        }

        .file-manager-home-banner-art {
            flex-shrink: 0;
            width: 180px;
            height: 110px;
            border-radius: 8px;
            background: linear-gradient(145deg, #ffffff 0%, #dbe7ff 100%);
            border: 1px solid rgba(64, 158, 255, 0.18);
            box-shadow: 0 8px 20px rgba(64, 158, 255, 0.12);
            position: relative;
        }

        .file-manager-home-banner-art::before,
        .file-manager-home-banner-art::after {
            content: '';
            position: absolute;
            border-radius: 4px;
            background: #fff;
            border: 1px solid #dcdfe6;
        }

        .file-manager-home-banner-art::before {
            left: 18px;
            top: 18px;
            width: 86px;
            height: 64px;
        }

        .file-manager-home-banner-art::after {
            right: 16px;
            bottom: 16px;
            width: 70px;
            height: 52px;
            background: #f5f7fa;
        }

        .file-manager-home-recent {
            flex: 1;
            min-height: 0;
            display: flex;
            flex-direction: column;
            padding: 0 16px 0;
            overflow: hidden;
        }

        .file-manager-home-recent-title {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-shrink: 0;
            margin-bottom: 10px;
            font-size: 15px;
            font-weight: 600;
            color: #303133;
        }

        /* 文件行「标签管理」对话框 */
        .file-tag-dialog .file-tag-dialog-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 12px;
        }

        .file-tag-dialog .file-tag-dialog-label {
            font-size: 14px;
            color: #303133;
            font-weight: 500;
        }

        .file-tag-dialog .file-tag-dialog-add {
            padding: 0;
            font-size: 14px;
            color: #409EFF;
        }

        .file-tag-dialog .file-tag-dialog-box {
            min-height: 160px;
            padding: 12px;
            border: 1px solid #dcdfe6;
            border-radius: 4px;
            background: #fff;
            display: flex;
            flex-wrap: wrap;
            align-content: flex-start;
            gap: 8px;
        }

        .file-tag-dialog .file-tag-dialog-empty {
            width: 100%;
            text-align: center;
            color: #c0c4cc;
            font-size: 13px;
            padding: 48px 0;
            line-height: 1.6;
        }

        .file-tag-dialog .file-tag-dialog-input {
            width: 140px;
        }

        .file-manager-home-recent-title i {
            color: #909399;
            cursor: pointer;
        }

        .file-manager-home-table-wrap {
            flex: 1;
            min-height: 0;
            overflow: auto;
        }

        .file-manager-home-empty {
            display: flex;
            min-height: 280px;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 12px;
            color: #909399;
        }

        .file-manager-home-empty i {
            font-size: 52px;
            color: #c0c4cc;
        }

        .file-manager-home-empty strong {
            color: #606266;
            font-size: 14px;
            font-weight: 400;
        }
    </style>
}

<div class="file-manager-layout">
    @Html.AntiForgeryToken()

    @* 左栏 15%：分类导航 *@
    <div class="file-manager-layout-left">
        <nav class="file-manager-nav-panel">
            <ul class="file-manager-nav-list">
                <li class="file-manager-nav-item" :class="{ 'is-active': activeNavKey === 'home' }" @@click="onNavClick({ key: 'home', label: '首页' })">
                    <i class="el-icon-s-home"></i><span>首页</span>
                </li>
                <li class="file-manager-nav-item" :class="{ 'is-active': activeNavKey === 'favorite' }" @@click="onNavClick({ key: 'favorite', label: '收藏' })">
                    <i :class="activeNavKey === 'favorite' ? 'el-icon-star-on' : 'el-icon-star-off'"></i><span>收藏</span>
                </li>
                <li class="file-manager-nav-item" :class="{ 'is-active': activeNavKey === 'enterprise' }" @@click="onNavClick({ key: 'enterprise', label: '企业文档', scope: 100 })">
                    <i class="el-icon-folder"></i><span>企业文档</span>
                </li>
                <li class="file-manager-nav-item" :class="{ 'is-active': activeNavKey === 'recycle' }" @@click="onNavClick({ key: 'recycle', label: '回收站' })">
                    <i class="el-icon-delete"></i><span>回收站</span>
                </li>
                <li class="file-manager-nav-item is-divider"></li>
                <li class="file-manager-nav-item" :class="{ 'is-active': activeNavKey === 'dashboard' }" @@click="onNavClick({ key: 'dashboard', label: '数据面板' })">
                    <i class="el-icon-data-line"></i><span>数据面板</span>
                </li>
                <li class="file-manager-nav-item" :class="{ 'is-active': activeNavKey === 'tags' }" @@click="onNavClick({ key: 'tags', label: '标签管理' })">
                    <i class="el-icon-price-tag"></i><span>标签管理</span>
                </li>
                <li class="file-manager-nav-item" :class="{ 'is-active': activeNavKey === 'settings' }" @@click="onNavClick({ key: 'settings', label: '设置' })">
                    <i class="el-icon-setting"></i><span>设置</span>
                </li>
            </ul>
        </nav>
    </div>

    @* 主区域 85%：文件浏览（树+表）或数据面板 *@
    <div class="file-manager-layout-main">
        <div class="file-manager-browser" v-if="activeNavKey !== 'dashboard' && activeNavKey !== 'tags' && activeNavKey !== 'recycle' && activeNavKey !== 'favorite' && activeNavKey !== 'home'">
            <div class="file-manager-tree-wrap">
                <aside class="file-manager-tree-panel">
                    <div class="file-manager-org-header">
                        <span class="file-manager-org-name">山西米立信息技术有限公司</span>
                        <i class="el-icon-s-operation file-manager-org-toggle"></i>
                    </div>
                    <div class="file-manager-tree-search">
                        <el-input
                            v-model="treeFilter"
                            size="small"
                            placeholder="搜索目录"
                            prefix-icon="el-icon-search"
                            clearable>
                        </el-input>
                    </div>
                    <div class="file-manager-tree-body">
                        <div
                            class="file-manager-root-node"
                            :class="{ 'is-active': currentFolderId === null }"
                            @@click="enterFolder(null)">
                            <i class="el-icon-folder-opened"></i>
                            <span>{{ rootFolderName }}</span>
                        </div>
                        <el-tree
                            :key="folderTreeKey"
                            ref="folderTree"
                            :data="folderTree"
                            :props="folderTreeProps"
                            node-key="id"
                            lazy
                            highlight-current
                            :expand-on-click-node="false"
                            :load="loadFolderChildren"
                            :filter-node-method="filterFolderNode"
                            @@node-click="onFolderNodeClick">
                            <span class="file-manager-tree-node" slot-scope="{ node, data }">
                                <span class="file-manager-tree-label"><i class="el-icon-folder"></i> {{ data.name }}</span>
                                <span class="file-manager-tree-actions">
                                    <el-button type="text" icon="el-icon-edit" @@click.stop="showEditFolderDialog(data)"></el-button>
                                    <el-button type="text" icon="el-icon-delete" @@click.stop="deleteFolder(data)"></el-button>
                                </span>
                            </span>
                        </el-tree>
                    </div>
                </aside>
            </div>

            <div class="file-manager-content-wrap">
                <main class="file-manager-main-panel">
                    <div class="file-manager-top-bar">
                        <div class="file-manager-top-search">
                            <el-input
                                v-model="fileSearchKeyword"
                                size="small"
                                placeholder="搜索文件/文件夹"
                                prefix-icon="el-icon-search"
                                clearable>
                            </el-input>
                        </div>
                        <div class="file-manager-top-actions">
                            <el-button size="small" icon="el-icon-refresh" @@click="reloadFolderTree" title="刷新"></el-button>
                            <el-dropdown trigger="click" @@command="handleCreateCommand">
                                <el-button size="small">
                                    新建<i class="el-icon-arrow-down el-icon--right"></i>
                                </el-button>
                                <el-dropdown-menu slot="dropdown">
                                    <el-dropdown-item command="folder">新建文件夹</el-dropdown-item>
                                </el-dropdown-menu>
                            </el-dropdown>
                            <el-dropdown trigger="click" @@command="handleUploadCommand">
                                <el-button type="primary" size="small">
                                    上传<i class="el-icon-arrow-down el-icon--right"></i>
                                </el-button>
                                <el-dropdown-menu slot="dropdown">
                                    <el-dropdown-item command="files">上传文件</el-dropdown-item>
                                    <el-dropdown-item command="folder">上传文件夹</el-dropdown-item>
                                </el-dropdown-menu>
                            </el-dropdown>
                        </div>
                    </div>

                    <div class="file-manager-nav-bar">
                        <a
                            v-if="canGoParent"
                            class="file-manager-back-link"
                            href="javascript:void(0)"
                            @@click="enterParentFolder">返回上一级</a>
                        <span v-if="canGoParent" class="file-manager-nav-divider">|</span>
                        <el-breadcrumb separator="/">
                            <el-breadcrumb-item><a href="javascript:void(0)" @@click="enterFolder(null)">{{ rootFolderName }}</a></el-breadcrumb-item>
                            <el-breadcrumb-item><span>{{ orgName }}</span></el-breadcrumb-item>
                            <el-breadcrumb-item v-for="item in folderPath" :key="item.id">
                                <a href="javascript:void(0)" @@click="enterFolder(item.id)">{{ item.name }}</a>
                            </el-breadcrumb-item>
                        </el-breadcrumb>
                    </div>

                    <div class="file-manager-table-wrap">
                        <el-table :data="displayTableData" v-loading="tableLoading" border stripe>
                            <template slot="empty">
                                <div class="file-manager-empty">
                                    <i class="el-icon-document"></i>
                                    <strong>暂无文档</strong>
                                    <el-button type="primary" size="mini" @@click="showUploadDialog">上传文件</el-button>
                                </div>
                            </template>
                            <el-table-column type="selection" width="48"></el-table-column>
                            <el-table-column label="文件名" min-width="260">
                                <template slot-scope="scope">
                                    <div class="file-manager-file-name-cell">
                                        <span class="file-manager-file-name-text" :title="scope.row.fileName">{{ scope.row.fileName }}</span>
                                        <i
                                            class="file-manager-favorite-star"
                                            :class="isFileFavorited(scope.row) ? 'el-icon-star-on is-on' : 'el-icon-star-off'"
                                            :title="isFileFavorited(scope.row) ? '取消收藏' : '收藏'"
                                            @@click.stop="toggleFavorite(scope.row)">
                                        </i>
                                    </div>
                                </template>
                            </el-table-column>
                            <el-table-column label="更新者" width="120" show-overflow-tooltip>
                                <template slot-scope="scope">{{ updatedByLabel(scope.row) }}</template>
                            </el-table-column>
                            <el-table-column prop="fileSize" label="大小" width="110">
                                <template slot-scope="scope">{{ formatFileSize(scope.row.fileSize) }}</template>
                            </el-table-column>
                            <el-table-column prop="uploadTime" label="更新时间" width="170">
                                <template slot-scope="scope">{{ dateFormatter(scope.row.uploadTime) }}</template>
                            </el-table-column>
                            <el-table-column label="操作" width="120" fixed="right">
                                <template slot-scope="scope">
                                    <el-dropdown trigger="click" @@command="handleRowCommand($event, scope.row)">
                                        <el-button type="text" size="mini">更多<i class="el-icon-arrow-down el-icon--right"></i></el-button>
                                        <el-dropdown-menu slot="dropdown">
                                            <el-dropdown-item command="download">下载</el-dropdown-item>
                                            <el-dropdown-item v-if="isSiteAsset" command="togglePublish">{{ scope.row.accessLevel === 100 ? '取消公开' : '公开' }}</el-dropdown-item>
                                            <el-dropdown-item v-if="isSiteAsset && scope.row.publicUrl" command="copyUrl">复制 URL</el-dropdown-item>
                                            <el-dropdown-item command="editNote">编辑备注</el-dropdown-item>
                                            <el-dropdown-item command="manageTags" icon="el-icon-price-tag">标签管理</el-dropdown-item>
                                            <el-dropdown-item command="delete" divided icon="el-icon-delete">删除</el-dropdown-item>
                                        </el-dropdown-menu>
                                    </el-dropdown>
                                </template>
                            </el-table-column>
                        </el-table>
                    </div>

                    <div class="file-manager-pagination">
                        <el-pagination
                            @@current-change="handleCurrentChange"
                            @@size-change="handleSizeChange"
                            :current-page="page.page"
                            :page-sizes="[10, 20, 30, 40]"
                            :page-size="page.size"
                            layout="total, sizes, prev, pager, next, jumper"
                            :total="total">
                        </el-pagination>
                    </div>
                </main>
            </div>
        </div>

        <div class="file-manager-dashboard-panel" v-if="activeNavKey === 'dashboard' && dashboard">
            <div class="file-manager-dashboard-grid">
                <section class="file-manager-dash-card">
                    <div class="file-manager-dash-card-header">
                        <span>文件库容量统计</span>
                        <i class="el-icon-question" title="仅统计企业文档：展示文件数量与总大小随时间变化"></i>
                    </div>
                    <div class="file-manager-dash-toolbar">
                        <el-radio-group v-model="dashboard.capacityRange" size="mini" @@change="onDashboardRangeChange">
                            <el-radio-button label="7d">过去7天</el-radio-button>
                            <el-radio-button label="30d">过去一个月</el-radio-button>
                            <el-radio-button label="365d">过去一年</el-radio-button>
                        </el-radio-group>
                        <el-date-picker
                            v-model="dashboard.capacityDates"
                            type="daterange"
                            size="mini"
                            value-format="yyyy-MM-dd"
                            range-separator="~"
                            start-placeholder="开始日期"
                            end-placeholder="结束日期"
                            style="width: 240px;"
                            @@change="loadDashboardStats">
                        </el-date-picker>
                    </div>
                    <div ref="capacityChart" class="file-manager-dash-chart"></div>
                </section>

                <section class="file-manager-dash-card">
                    <div class="file-manager-dash-card-header">
                        <span>企业文档容量统计</span>
                        <i class="el-icon-question" title="展示企业文档库当前已使用空间"></i>
                    </div>
                    <div class="file-manager-dash-meta">
                        <span>统计截止时间：{{ dashboard.statsCutoff }}</span>
                        <span class="file-manager-dash-used-tag">企业文档已使用：{{ dashboard.enterpriseUsed }}</span>
                    </div>
                    <div class="file-manager-dash-org-list">
                        <div class="file-manager-dash-org-head">
                            <span>租户/组织名称</span>
                            <span>已用空间</span>
                        </div>
                        <div class="file-manager-dash-org-row" v-for="org in dashboard.orgUsages" :key="org.name">
                            <span class="file-manager-dash-org-name"><i class="el-icon-office-building"></i>{{ org.name }}</span>
                            <span class="file-manager-dash-org-size">{{ org.size }}</span>
                        </div>
                    </div>
                </section>

                <section class="file-manager-dash-card">
                    <div class="file-manager-dash-card-header">
                        <span>文件大小统计</span>
                        <i class="el-icon-question" title="按文件类型统计占用容量占比"></i>
                    </div>
                    <div class="file-manager-dash-meta">
                        <span>统计截止时间：{{ dashboard.statsCutoff }}</span>
                    </div>
                    <div ref="sizeChart" class="file-manager-dash-chart"></div>
                </section>

                <section class="file-manager-dash-card">
                    <div class="file-manager-dash-card-header">
                        <span>文件个数统计</span>
                        <i class="el-icon-question" title="按文件类型统计文件数量占比"></i>
                    </div>
                    <div class="file-manager-dash-meta">
                        <span>统计截止时间：{{ dashboard.statsCutoff }}</span>
                    </div>
                    <div ref="countChart" class="file-manager-dash-chart"></div>
                </section>
            </div>
        </div>

        <div class="file-manager-tags-panel" v-if="activeNavKey === 'tags' && tagManager">
            <div class="file-manager-tags-filter">
                <div class="file-manager-tags-filter-item">
                    <span>搜索</span>
                    <el-input
                        v-model="tagManager.keyword"
                        size="small"
                        placeholder="搜索标签名称"
                        prefix-icon="el-icon-search"
                        clearable
                        @@keyup.enter.native="searchTags">
                    </el-input>
                </div>
                <div class="file-manager-tags-filter-item">
                    <span>分类</span>
                    <el-select v-model="tagManager.category" size="small" placeholder="选择分类" clearable>
                        <el-option
                            v-for="item in tagManager.categoryOptions"
                            :key="item.value"
                            :label="item.label"
                            :value="item.value">
                        </el-option>
                    </el-select>
                </div>
                <div class="file-manager-tags-filter-item">
                    <span>状态</span>
                    <el-select v-model="tagManager.status" size="small" placeholder="全部" clearable>
                        <el-option label="全部" value=""></el-option>
                        <el-option label="启用" value="enabled"></el-option>
                        <el-option label="停用" value="disabled"></el-option>
                    </el-select>
                </div>
                <div class="file-manager-tags-filter-actions">
                    <el-button type="primary" size="small" icon="el-icon-search" @@click="searchTags"></el-button>
                    <el-button type="text" size="small" @@click="resetTagFilters">重置</el-button>
                </div>
            </div>

            <div class="file-manager-tags-toolbar">
                <el-button type="primary" size="small" @@click="createTag">新增标签</el-button>
                <el-button size="small" @@click="createTagCategory">新增分类</el-button>
                <el-button size="small" @@click="expandTagRows">
                    展开<i class="el-icon-arrow-down el-icon--right"></i>
                </el-button>
                <el-button size="small" :disabled="!tagManager.selectedIds.length" @@click="enableSelectedTags">启用</el-button>
                <el-button size="small" :disabled="!tagManager.selectedIds.length" @@click="disableSelectedTags">停用</el-button>
                <el-button size="small" @@click="importTags">导入</el-button>
                <el-button size="small" @@click="exportTags">导出</el-button>
            </div>

            <div class="file-manager-tags-table-wrap">
                <el-table
                    :data="tagManager.displayList"
                    border
                    stripe
                    height="100%"
                    @@selection-change="onTagSelectionChange">
                    <template slot="empty">
                        <div class="file-manager-tags-empty">
                            <i class="el-icon-document"></i>
                            <strong>暂无数据</strong>
                        </div>
                    </template>
                    <el-table-column type="selection" width="48"></el-table-column>
                    <el-table-column prop="name" label="名称" min-width="160" show-overflow-tooltip></el-table-column>
                    <el-table-column prop="type" label="类型" width="120" show-overflow-tooltip></el-table-column>
                    <el-table-column prop="status" label="状态" width="100">
                        <template slot-scope="scope">
                            <el-tag :type="scope.row.status === '启用' ? 'success' : 'info'" size="mini">{{ scope.row.status }}</el-tag>
                        </template>
                    </el-table-column>
                    <el-table-column prop="tagCount" label="标签数量" width="110"></el-table-column>
                    <el-table-column prop="updatedAt" label="最后更新时间" width="170"></el-table-column>
                    <el-table-column prop="updatedBy" label="最后更新人" width="120" show-overflow-tooltip></el-table-column>
                    <el-table-column prop="admin" label="管理员" width="120" show-overflow-tooltip></el-table-column>
                    <el-table-column width="48" align="center">
                        <template slot="header">
                            <i class="el-icon-s-operation" title="列设置"></i>
                        </template>
                        <template slot-scope="scope">
                            <el-button type="text" icon="el-icon-more" size="mini" @@click="openTagRowMenu(scope.row)"></el-button>
                        </template>
                    </el-table-column>
                </el-table>
            </div>
        </div>

        <div class="file-manager-recycle-panel" v-if="activeNavKey === 'recycle' && recycleBin">
            <div class="file-manager-recycle-header">
                <el-button
                    type="primary"
                    size="small"
                    icon="el-icon-delete"
                    :loading="!!recycleBin.emptying"
                    @@click.stop.prevent="emptyRecycleBin">一键清空</el-button>
            </div>
            <div class="file-manager-recycle-table-wrap">
                <el-table
                    :data="recycleBin.displayList"
                    border
                    stripe
                    height="100%"
                    @@selection-change="onRecycleSelectionChange">
                    <template slot="empty">
                        <div class="file-manager-recycle-empty">
                            <i class="el-icon-document"></i>
                            <strong>暂无文档</strong>
                        </div>
                    </template>
                    <el-table-column type="selection" width="48"></el-table-column>
                    <el-table-column label="文件名称" min-width="280">
                        <template slot-scope="scope">
                            <div class="file-manager-favorite-name-cell">
                                <span class="file-manager-favorite-name" :title="scope.row.fileName">{{ scope.row.fileName }}</span>
                                <div class="file-manager-favorite-path" :title="scope.row.folderPathText">{{ scope.row.folderPathText }}</div>
                            </div>
                        </template>
                    </el-table-column>
