                    }
                    if (item && item.key === 'recycle') {
                        if (!this.recycleBin) {
                            Vue.set(this, 'recycleBin', {
                                list: [],
                                displayList: [],
                                selectedIds: [],
                                page: 1,
                                size: 20,
                                total: 0,
                                emptying: false
                            });
                        }
                        if (!this.recycleEmptyDialog) {
                            Vue.set(this, 'recycleEmptyDialog', { visible: false });
                        }
                        this.$set(this.recycleBin, 'emptying', false);
                        this.activeNavKey = 'recycle';
                        if (typeof this.loadRecycleFromStorage === 'function') this.loadRecycleFromStorage();
                        else if (typeof this.loadRecycleBin === 'function') this.loadRecycleBin();
                        return;
                    }
                    if (item && item.key === 'favorite') {
                        if (!this.favoriteList) {
                            Vue.set(this, 'favoriteList', {
                                keyword: '',
                                list: [],
                                displayList: [],
                                page: 1,
                                size: 20,
                                total: 0
                            });
                        }
                        this.activeNavKey = 'favorite';
                        if (typeof this.searchFavorites === 'function') this.searchFavorites();
                        return;
                    }
                    if (item && item.key === 'home') {
                        if (!this.homePage) {
                            Vue.set(this, 'homePage', {
                                keyword: '',
                                list: [],
                                displayList: [],
                                quickAccess: []
                            });
                        }
                        this.activeNavKey = 'home';
                        if (typeof this.loadQuickAccessFromStorage === 'function') this.loadQuickAccessFromStorage();
                        if (typeof this.searchHomeRecent === 'function') this.searchHomeRecent();
                        return;
                    }
                    if (item && item.key === 'settings') {
                        if (!this.uploadSettings) {
                            Vue.set(this, 'uploadSettings', {
                                allowedTypesText: '',
                                maxSizeMb: 50,
                                blockedTypesText: ''
                            });
                        }
                        this.activeNavKey = 'settings';
                        if (typeof this.loadUploadSettingsFromStorage === 'function') this.loadUploadSettingsFromStorage();
                        return;
                    }
                    if (typeof originalOnNavClick === 'function') return originalOnNavClick(item);
                };

                // 标签树形列表 + 行扩展操作（覆盖旧版扁平列表实现）
                if (!vm.tagManager) {
                    Vue.set(vm, 'tagManager', {
                        keyword: '', category: '', status: '', selectedIds: [],
                        categoryOptions: [], list: [], displayList: [], tags: [],
                        treeExpanded: true, treeExpandKey: 0
                    });
                } else {
                    if (vm.tagManager.treeExpanded == null) Vue.set(vm.tagManager, 'treeExpanded', true);
                    if (vm.tagManager.treeExpandKey == null) Vue.set(vm.tagManager, 'treeExpandKey', 0);
                    if (!Array.isArray(vm.tagManager.tags)) Vue.set(vm.tagManager, 'tags', []);
                }
                if (!vm.tagCategoryDialog) {
                    Vue.set(vm, 'tagCategoryDialog', {
                        visible: false, loading: false, editing: false,
                        form: { id: '', name: '', description: '', parentId: '', admin: '' }
                    });
                } else if (vm.tagCategoryDialog.editing == null) {
                    Vue.set(vm.tagCategoryDialog, 'editing', false);
                }
                if (!vm.tagCreateDialog) {
                    Vue.set(vm, 'tagCreateDialog', {
                        visible: false, loading: false, editing: false,
                        form: { id: '', name: '', description: '', categoryId: '' }
                    });
                } else if (vm.tagCreateDialog.editing == null) {
                    Vue.set(vm.tagCreateDialog, 'editing', false);
                }
                if (!vm.tagAdminOptions) Vue.set(vm, 'tagAdminOptions', ['管理员', '当前用户']);
                if (!vm.tagManagerStorageKey) Vue.set(vm, 'tagManagerStorageKey', 'ncf.fileManager.tagManager');

                vm.isTagRowEnabled = function (row) { return !!(row && row.status === '启用'); };
                vm.isTagCategoryRow = function (row) { return !!(row && row.nodeType !== 'tag'); };
                vm.matchTagStatusFilter = function (statusValue, filter) {
                    var enabled = statusValue === '启用';
                    if (filter === 'enabled') return enabled;
                    if (filter === 'disabled') return !enabled;
                    return true;
                };
                vm.buildTagTreeDisplay = function () {
                    if (!this.tagManager) return [];
                    var keyword = (this.tagManager.keyword || '').trim().toLowerCase();
                    var categoryFilter = this.tagManager.category || '';
                    var statusFilter = this.tagManager.status || '';
                    var self = this;
                    var categoryMap = {};
                    var categories = (this.tagManager.list || []).map(function (row) {
                        var cat = Object.assign({}, row, { nodeType: 'category', children: [] });
                        categoryMap[cat.id] = cat;
                        return cat;
                    });
                    categories.forEach(function (cat) {
                        var hasParent = !!(cat.parentId && categoryMap[cat.parentId]);
                        cat.type = hasParent ? '二级分类' : '一级分类';
                        cat.level = hasParent ? 2 : 1;
                        if (hasParent) {
                            categoryMap[cat.parentId].children.push(cat);
                            cat.__linked = true;
                        }
                    });
                    (this.tagManager.tags || []).forEach(function (row) {
                        var tag = Object.assign({}, row, {
                            nodeType: 'tag', type: '标签', tagCount: '-', admin: '-', children: []
                        });
                        if (tag.categoryId && categoryMap[tag.categoryId]) {
                            categoryMap[tag.categoryId].children.push(tag);
                        }
                    });
                    categories.forEach(function (cat) {
                        cat.tagCount = (cat.children || []).filter(function (c) { return c.nodeType === 'tag'; }).length;
                    });
                    function prune(node) {
                        var children = (node.children || []).map(prune).filter(Boolean);
                        var nameOk = !keyword || String(node.name || '').toLowerCase().indexOf(keyword) !== -1;
                        var statusOk = self.matchTagStatusFilter(node.status, statusFilter);
                        if ((nameOk && statusOk) || children.length) {
                            return Object.assign({}, node, { children: children });
                        }
                        return null;
                    }
                    var roots = categories.filter(function (cat) { return !cat.__linked; });
                    if (categoryFilter && categoryMap[categoryFilter]) roots = [categoryMap[categoryFilter]];
                    return roots.map(prune).filter(Boolean);
                };
                vm.searchTags = function () {
                    if (!this.tagManager) return;
                    this.tagManager.displayList = this.buildTagTreeDisplay();
                };
                vm.resetTagFilters = function () {
                    if (!this.tagManager) return;
                    this.tagManager.keyword = '';
                    this.tagManager.category = '';
                    this.tagManager.status = '';
                    this.searchTags();
                };
                vm.onTagSelectionChange = function (rows) {
                    this.tagManager.selectedIds = (rows || []).map(function (row) { return row.id; });
                };
                vm.expandTagRows = function () {
                    if (!this.tagManager) return;
                    this.tagManager.treeExpanded = !this.tagManager.treeExpanded;
                    this.tagManager.treeExpandKey = (this.tagManager.treeExpandKey || 0) + 1;
                };
                vm.createTagUnder = function (row) {
                    if (!this.isTagCategoryRow(row)) return;
                    this.createTag(row.id);
