@using System.Text.Json
@using Microsoft.Extensions.Localization
@using Senparc.Ncf.Core.Localization
@using Senparc.Xncf.FileManager
@inject IStringLocalizer<FileManagerResource> XR
@inject IStringLocalizerFactory LocalizationFactory
@{
    var sourceTranslations = FrontendTranslationCatalog.Get(
        LocalizationFactory,
        typeof(FileManagerResource));
}
<script>window.ncfRegisterSourceTranslations(@Html.Raw(JsonSerializer.Serialize(sourceTranslations)), "FileManager");</script>
