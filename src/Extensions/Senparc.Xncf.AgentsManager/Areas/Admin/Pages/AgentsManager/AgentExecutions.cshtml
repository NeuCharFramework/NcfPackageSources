@page
@model Senparc.Xncf.AgentsManager.Areas.AgentsManager.Pages.AgentExecutionsModel
@{
    ViewData["Title"] = "独立 Agent 执行";
    Layout = "_Layout_Vue";
}

@section breadcrumbs {
    <el-breadcrumb-item>扩展模块</el-breadcrumb-item>
    <el-breadcrumb-item>Agents 管理模块</el-breadcrumb-item>
    <el-breadcrumb-item>独立 Agent 执行</el-breadcrumb-item>
}

@section Style {
    <link rel="stylesheet" href="~/css/AgentsManager/agent-executions.css" asp-append-version="true" />
}

<div id="agent-executions-app" class="agent-executions-page">
    <header class="agent-executions-header">
        <div>
            <h1>独立 Agent 执行</h1>
            <p>统一查看直接调用、Workflow 和外部入口产生的 Agent 任务。</p>
        </div>
        <div class="agent-executions-actions">
            <el-button icon="el-icon-back" @@click="backToAgents">返回 AgentsManager</el-button>
            <el-button type="primary" icon="el-icon-video-play" @@click="startDialogVisible = true">执行 Agent</el-button>
            <el-button icon="el-icon-refresh" :loading="loading" @@click="loadTasks">刷新</el-button>
        </div>
    </header>

    <div class="agent-executions-layout">
        <section class="agent-executions-list-panel">
            <div class="agent-executions-list-toolbar">
                <el-input v-model="filter" clearable prefix-icon="el-icon-search" placeholder="搜索任务名称"
                          @@change="loadTasks"></el-input>
                <el-select v-model="status" clearable placeholder="全部状态" @@change="loadTasks">
                    <el-option label="等待" :value="0"></el-option>
                    <el-option label="运行中" :value="1"></el-option>
                    <el-option label="暂停" :value="2"></el-option>
                    <el-option label="完成" :value="3"></el-option>
                    <el-option label="取消" :value="4"></el-option>
                    <el-option label="失败" :value="5"></el-option>
                </el-select>
            </div>
            <el-table :data="tasks" size="small" height="calc(100vh - 250px)" highlight-current-row
                      @@row-click="selectTask" v-loading="loading">
                <el-table-column label="任务" min-width="190">
                    <template slot-scope="scope">
                        <div class="agent-execution-task-name">
                            <strong>{{scope.row.name}}</strong>
                            <small>{{scope.row.agentTemplateName}} · {{sourceText(scope.row.source)}}</small>
                        </div>
                    </template>
                </el-table-column>
                <el-table-column label="状态" width="92">
                    <template slot-scope="scope">
                        <el-tag size="mini" :type="statusType(scope.row.status)">
                            {{statusText(scope.row.status)}}
                        </el-tag>
                    </template>
                </el-table-column>
                <el-table-column label="Token" width="85">
                    <template slot-scope="scope">{{formatNumber(scope.row.totalTokens)}}</template>
                </el-table-column>
                <el-table-column label="开始时间" width="145">
                    <template slot-scope="scope">{{formatDate(scope.row.startTime)}}</template>
                </el-table-column>
            </el-table>
        </section>

        <section class="agent-executions-detail-panel" v-loading="detailLoading">
            <template v-if="detail">
                <div class="agent-executions-detail-header">
                    <div>
                        <h2>{{detail.name}}</h2>
                        <div class="agent-executions-detail-subtitle">
                            {{detail.agentTemplateName}} · {{sourceText(detail.source)}} · #{{detail.id}}
                        </div>
                    </div>
                    <div class="agent-executions-detail-actions">
                        <el-button v-if="isRunning(detail.status)" type="warning" icon="el-icon-close"
                                   @@click="cancelTask">取消</el-button>
                        <el-button icon="el-icon-refresh" @@click="loadDetail(detail.id)">刷新详情</el-button>
                    </div>
                </div>

                <div class="agent-executions-summary">
                    <div><span>状态</span><strong>{{statusText(detail.status)}}</strong></div>
                    <div><span>输入 Token</span><strong>{{formatNumber(detail.totalPromptTokens)}}</strong></div>
                    <div><span>输出 Token</span><strong>{{formatNumber(detail.totalCompletionTokens)}}</strong></div>
                    <div><span>工具调用</span><strong>{{formatNumber(detail.toolCallCount)}}</strong></div>
                    <div><span>模型</span><strong :title="detail.modelDescription">{{detail.modelDescription || '未返回模型信息'}}</strong></div>
                </div>

                <el-alert v-if="humanRequests.length" type="warning" :closable="false" class="agent-executions-approval">
                    <div class="agent-executions-approval-title">等待人工审批</div>
                    <div v-for="request in humanRequests" :key="request.requestId" class="agent-executions-approval-item">
                        <span>工具：{{request.toolName || '未命名工具'}}</span>
                        <el-button size="mini" type="danger" plain @@click="resolveHumanRequest(request, false)">拒绝</el-button>
                        <el-button size="mini" type="primary" @@click="resolveHumanRequest(request, true)">批准</el-button>
                    </div>
                </el-alert>

                <div class="agent-executions-io">
                    <div>
                        <h3>输入</h3>
                        <pre>{{detail.promptCommand}}</pre>
                    </div>
                    <div>
                        <h3>最终输出</h3>
                        <pre>{{detail.output || detail.errorMessage || '尚未产生最终输出'}}</pre>
                    </div>
                </div>

                <div class="agent-executions-events">
                    <h3>执行过程</h3>
                    <div v-if="!events.length" class="agent-executions-empty">暂无过程事件</div>
                    <article v-for="event in events" :key="event.sequence"
                             :class="['agent-execution-event', 'agent-execution-event--' + event.eventType]">
                        <div class="agent-execution-event-head">
                            <strong>{{eventTitle(event)}}</strong>
                            <time>{{formatDate(event.timestamp)}}</time>
                        </div>
                        <p v-if="event.message">{{event.message}}</p>
                        <pre v-if="event.text">{{event.text}}</pre>
                        <div v-if="event.toolName" class="agent-execution-tool">
                            <div><b>工具：</b>{{event.toolName}}</div>
                            <div v-if="event.toolArguments"><b>参数：</b><pre>{{event.toolArguments}}</pre></div>
                            <div v-if="event.toolResult"><b>结果：</b><pre>{{event.toolResult}}</pre></div>
                            <div v-if="event.errorMessage" class="agent-execution-error"><b>错误：</b>{{event.errorMessage}}</div>
                        </div>
                        <small v-if="event.totalTokens">Token：{{formatNumber(event.totalTokens)}}</small>
                    </article>
                </div>
            </template>
            <div v-else class="agent-executions-empty agent-executions-empty--detail">
                选择一条独立 Agent 执行任务查看详情。
            </div>
        </section>
    </div>
</div>

<el-dialog title="执行独立 Agent" :visible.sync="startDialogVisible" width="620px" :close-on-click-modal="false">
    <el-form label-width="120px">
        <el-form-item label="Agent">
            <el-select v-model="startForm.agentTemplateId" filterable placeholder="选择 Agent" style="width:100%;">
                <el-option v-for="agent in agents" :key="agent.id" :label="agent.name" :value="agent.id"></el-option>
            </el-select>
        </el-form-item>
        <el-form-item label="任务名称">
            <el-input v-model="startForm.name" placeholder="可选"></el-input>
        </el-form-item>
        <el-form-item label="输入">
            <el-input v-model="startForm.input" type="textarea" :rows="7" maxlength="20000" show-word-limit
                      placeholder="输入本次 Agent 任务"></el-input>
        </el-form-item>
        <el-form-item label="允许工具">
            <el-switch v-model="startForm.allowFunctionCalls" active-text="允许" inactive-text="关闭"></el-switch>
        </el-form-item>
    </el-form>
    <div slot="footer">
        <el-button @@click="startDialogVisible = false">取消</el-button>
        <el-button type="primary" :loading="starting" @@click="startTask">开始执行</el-button>
    </div>
</el-dialog>

@section scripts {
    <script src="~/js/AgentsManager/lib/axios.min.js"></script>
    <script src="~/js/AgentsManager/axios.js"></script>
    <script src="~/js/AgentsManager/agent-executions.js" asp-append-version="true"></script>
}
