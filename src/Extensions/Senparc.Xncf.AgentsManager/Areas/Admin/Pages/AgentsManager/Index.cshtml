    :show-close="false" :close-on-click-modal="false" :close-on-press-escape="false">
    <el-alert type="warning" :closable="false" :title="ncfST('Frontend.AgentsManager.AnATwoAAgentCardExposesOnlyTheNameDescriptionAnd')" show-icon></el-alert>
    <el-alert v-if="publishedA2AForm.enable" type="warning" :closable="false" show-icon style="margin-top:12px;"
        :title="ncfST('Frontend.AgentsManager.PublicServiceIsEnabledAuthenticatedExternalSystemsCanCallThisAgentConfirm')"></el-alert>
    <el-alert v-if="publishedA2AForm.enable && publishedA2AForm.authenticationMode === 0" type="error" :closable="false" show-icon style="margin-top:12px;"
        :title="ncfST('Frontend.AgentsManager.InboundAuthenticationIsDisabledUseThisOnlyOnAnIsolatedControlledNetwork')"></el-alert>
    <el-alert v-if="publishedA2AForm.enable && publishedA2AForm.allowFunctionCalls" type="error" :closable="false" show-icon style="margin-top:12px;"
        :title="ncfST('Frontend.AgentsManager.LocalToolCallsAreEnabledExternalRequestsMayIndirectlyTriggerFunctionMCPSupplemental')"></el-alert>
    <el-form v-if="visible.dialogPublishedA2A" ref="publishedA2AELForm" :model="publishedA2AForm" :rules="publishedA2AFormRules"
        :size="elSize" label-position="left" label-width="150px" style="margin-top:20px;">
        <el-form-item :label="ncfST('Frontend.AgentsManager.EnablePublicService')">
            <el-switch v-model="publishedA2AForm.enable" :active-text="ncfST('Frontend.AgentsManager.AllowATwoACalls')" :inactive-text="ncfST('Frontend.AgentsManager.SaveConfigurationOnly')"></el-switch>
        </el-form-item>
        <el-form-item :label="ncfST('Frontend.AgentsManager.PublicIdentifier')" prop="publicAgentKey">
            <el-input v-model="publishedA2AForm.publicAgentKey" :placeholder="ncfST('Frontend.AgentsManager.ForExampleResearchAgent')"></el-input>
            <div class="form-help-text">{{ ncfST('Frontend.AgentsManager.OnlyLowercaseLettersDigitsAndHyphensAreAllowedTheAddressRemainsStable') }}</div>
        </el-form-item>
        <el-form-item :label="ncfST('Frontend.AgentsManager.AgentCardName')">
            <el-input v-model="publishedA2AForm.cardName" :placeholder="ncfST('Frontend.AgentsManager.LeaveEmptyToUseTheLocalAgentName')"></el-input>
        </el-form-item>
        <el-form-item :label="ncfST('Frontend.AgentsManager.PublicDescription')">
            <el-input type="textarea" v-model="publishedA2AForm.cardDescription" :rows="3" :placeholder="ncfST('Frontend.AgentsManager.UsedByRemoteSystemsToChooseAnAgentDoNotEnterPrompts')"></el-input>
        </el-form-item>
        <el-form-item :label="ncfST('Frontend.AgentsManager.SkillIdentifierName')">
            <div style="display:flex;gap:8px;">
                <el-input v-model="publishedA2AForm.skillId" placeholder="chat" style="width:35%;"></el-input>
                <el-input v-model="publishedA2AForm.skillName" :placeholder="ncfST('Frontend.AgentsManager.LeaveEmptyToUseTheCardName')"></el-input>
            </div>
        </el-form-item>
        <el-form-item :label="ncfST('Frontend.AgentsManager.PublicSkillDescription')">
            <el-input type="textarea" v-model="publishedA2AForm.skillDescription" :rows="2" :placeholder="ncfST('Frontend.AgentsManager.LeaveEmptyToUseThePublicDescription')"></el-input>
        </el-form-item>
        <el-form-item :label="ncfST('Frontend.AgentsManager.InboundAuthentication')">
            <el-select v-model="publishedA2AForm.authenticationMode" style="width:100%;">
                <el-option :label="ncfST('Frontend.AgentsManager.NoneControlledNetworksOnly')" :value="0"></el-option>
                <el-option label="Bearer Token" :value="1"></el-option>
                <el-option :label="ncfST('Frontend.AgentsManager.CustomRequestHeader')" :value="2"></el-option>
            </el-select>
        </el-form-item>
        <el-form-item v-if="publishedA2AForm.authenticationMode === 2" :label="ncfST('Frontend.AgentsManager.RequestHeaderName')">
            <el-input v-model="publishedA2AForm.authHeaderName" :placeholder="ncfST('Frontend.AgentsManager.ForExampleXATwoAToken')"></el-input>
        </el-form-item>
        <el-form-item v-if="publishedA2AForm.authenticationMode !== 0" :label="ncfST('Frontend.AgentsManager.DeploymentSecretName')">
            <el-input v-model="publishedA2AForm.authSecretKey" :placeholder="ncfST('Frontend.AgentsManager.ForExamplePartnerNcf')"></el-input>
            <div class="form-help-text">{{ ncfST('Frontend.AgentsManager.MaintainedHere') }} A2A:InboundSecrets:{{ publishedA2AForm.authSecretKey || 'secret-name' }}.</div>
        </el-form-item>
        <el-form-item :label="ncfST('Frontend.AgentsManager.MaximumInputCharacters')">
            <el-input-number v-model="publishedA2AForm.maxInputCharacters" :min="512" :max="100000" :step="1000"></el-input-number>
        </el-form-item>
        <el-form-item :label="ncfST('Frontend.AgentsManager.AllowLocalToolCalls')">
            <el-switch v-model="publishedA2AForm.allowFunctionCalls" :active-text="ncfST('Frontend.AgentsManager.ExplicitlyAllowed')" :inactive-text="ncfST('Frontend.AgentsManager.SecureDefaultOff')"></el-switch>
            <div class="form-help-text" style="color:#d97706;">{{ ncfST('Frontend.AgentsManager.WhenEnabledExternalRequestsMayIndirectlyTriggerFunctionsOrMCPToolsConfigured') }}</div>
        </el-form-item>
        <el-form-item v-if="publishedA2AForm.agentCardUrl" :label="ncfST('Frontend.AgentsManager.AgentCardURL')">
            <el-input :value="publishedA2AForm.agentCardUrl" readonly>
                <el-button slot="append" icon="el-icon-document-copy" @@click="copyPublishedA2AUrl">{{ ncfST('Frontend.AgentsManager.Copy') }}</el-button>
            </el-input>
        </el-form-item>
    </el-form>
    <div slot="footer" class="dialog-footer">
        <el-button @@click="closePublishedA2AEditor">{{ ncfST('Frontend.AgentsManager.OutputTokens') }}</el-button>
        <el-button type="primary" @@click="savePublishedA2A">{{ ncfST('Frontend.AgentsManager.Save') }}</el-button>
    </div>
</el-dialog>
@section scripts {
    @await Html.PartialAsync("_AgentsManagerLocalizationScripts")
    <script src="~/js/AgentsManager/lib/axios.min.js"></script>
    <script src="~/js/PromptRange/lib/marked.min.js"></script>
    <script type="module" src="~/js/AgentsManager/three-loader.js" asp-append-version="true"></script>
}
