@* Group create/edit drawer. *@
<el-drawer :visible.sync="visible.drawerGroup" direction="rtl" :with-header="false" :wrapper-closable="false"
    :close-on-press-escape="false" size="960px">
    <div class="drawerRtl">
        @* Content header, including the title and close icon. *@
        <div class="drawerRtl__header">
            <div class="drawerRtl__header__title">{{ groupForm.id ? ncfST('Frontend.AgentsManager.EditGroup') : ncfST('Frontend.AgentsManager.AddGroup') }} </div>
            <div class="drawerRtl__header__close" @@click="handleElVisibleClose('drawerGroup')">&times;</div>
        </div>
        @* Main content area. *@
        <div class="drawerRtl__body">
            <el-form v-if="visible.drawerGroup" ref="groupELForm" :model="groupForm" :rules="groupFormRules"
                :size="elSize" label-position="left" label-width="130px" class="drawerForm-container">
                <el-form-item :label="ncfST('Frontend.AgentsManager.GroupName')" prop="name">
                    <el-input v-model="groupForm.name" :placeholder="ncfST('Frontend.AgentsManager.PleaseFillIn')"></el-input>
                </el-form-item>
                <el-form-item :label="ncfST('Frontend.AgentsManager.EnabledAlternate')" prop="enable">
                    <el-checkbox v-model="groupForm.enable">{{ ncfST('Frontend.AgentsManager.EnableThisGroup') }}</el-checkbox>
                    <div class="form-help-text">{{ ncfST('Frontend.AgentsManager.NewGroupsAreEnabledByDefaultDisabledGroupsDoNotCreateNew') }}</div>
