                </el-form-item>
                <el-form-item v-if="!agentForm.isHuman" :label="ncfST('Frontend.487')">
                    <el-select v-model="agentForm.connectorInstanceIds" multiple filterable clearable style="width:100%"
                               :placeholder="ncfST('Frontend.351')" :loading="connectorOptionsLoading">
                        <el-option v-for="item in connectorOptions" :key="item.instanceId"
                                   :label="item.name + ' · ' + item.connectorName" :value="item.instanceId"></el-option>
                    </el-select>
                    <div class="form-help-text">{{ ncfST('Frontend.388') }}</div>
                </el-form-item>
                <el-form-item label="MCP Endpoints" prop="mcpEndpoints">
