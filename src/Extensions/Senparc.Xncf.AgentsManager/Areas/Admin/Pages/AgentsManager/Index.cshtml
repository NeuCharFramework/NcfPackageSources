@page
@model Senparc.Xncf.AgentsManager.Areas.AgentsManager.Pages.Index
@using Senparc.Xncf.AgentsManager.Models.DatabaseModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "AgentsManager";
    ViewData["AdminFooterAiInitialMessage"] = "/run-agent-group ";
    Layout = "_Layout_Vue";
}
@section Style {
    <link href="~/css/AgentsManager/fontawesome/all.min.css" rel="stylesheet" />
    <link href="~/css/AgentsManager/index.css" rel="stylesheet" />
    <link href="~/css/AgentsManager/studio.css" rel="stylesheet" asp-append-version="true" />
    <meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests">
}

@section breadcrumbs {
    <el-breadcrumb-item>{{ncfST('Frontend.AgentsManager.ExtensionModules')}}</el-breadcrumb-item>
    <el-breadcrumb-item>{{ncfST('Frontend.AgentsManager.AgentsManager')}}</el-breadcrumb-item>
    <el-breadcrumb-item>{{ncfST('Frontend.AgentsManager.Home')}}</el-breadcrumb-item>
}

<el-tabs v-model="tabsActiveName" class="pageTabs agentsManager-rootTabs" @@tab-click="handleTabsClick">
    <el-tab-pane name="first">
        <span slot="label" class="agentsManager-tabLabel">
            <i class="el-icon-s-custom" aria-hidden="true"></i>
            <span>{{ncfST('Frontend.AgentsManager.Agent')}}</span>
        </span>
        <div class="tabPane-container" :class="{'studio-layout':agentListViewMode === 'three' && scrollbarAgentIndex === ''}">
            @* Sidebar *@
            <div class="sidebar-container">
                <div class="sidebar-head-container">
                    <div class="df-wn flex-ac flex-jsb sidebar-title-row">
                        <div class="sidebar-titleRow-title text-ellipsis">{{ncfST('Frontend.AgentsManager.AgentList')}} <ncf-doc-help topic="agents.manage"></ncf-doc-help></div>
                        <div class="sidebar-titleRow-actions">
                            <el-button class="sidebar-titleRow-add" type="primary" size="mini" icon="el-icon-plus"
                                :title="ncfST('Frontend.AgentsManager.AddAlternate')" @@click="handleElVisibleOpenBtn('drawerAgent')">{{ncfST('Frontend.AgentsManager.AddAlternate')}}</el-button>
                            <div class="sidebar-titleRow-icon sidebar-titleRow-icon-remote df-wn flex-ac flex-jc"
                                :title="ncfST('Frontend.AgentsManager.ManageRemoteATwoAAgents')" @@click="openRemoteAgentManager">
                                <i class="el-icon-connection"></i>
                            </div>
                        </div>
                    </div>
                    <div class="df-wn flex-ac flex-jsb sidebar-search-row">
                        <el-input v-model="agentQueryList.filter" :placeholder="ncfST('Frontend.AgentsManager.SearchByName')" suffix-icon="el-icon-search"
                            class="sidebar-searchRow-input" @@change="handleFilterChange($event,'agent')"></el-input>
                        <el-popover placement="bottom" width="90" trigger="click" v-model="agentFCPVisible" popper-class="filter-popover">
                            <div class="popover-filterCriteria">
                                <div class="sortRow" @@click="handleFilterCriteria('agent','timeSort')">
                                    <span class="sortRowText">{{ncfST('Frontend.AgentsManager.SortByTime')}}</span>
                                    <div class="sortRowIconBox">
                                        <i class="el-icon-caret-top sortRowIconTriangle"
                                            :class="{'sortRowIconActive':agentQueryList.timeSort}"></i>
                                        <i class="el-icon-caret-bottom sortRowIconTriangle"
                                            :class="{'sortRowIconActive':!agentQueryList.timeSort}"></i>
                                    </div>
                                </div>
                                <div class="sortRow sortRowDivision" style="margin-top: 5px; cursor: auto;">
                                    <span class="sortRowText">{{ncfST('Frontend.AgentsManager.SelectStatus')}}</span>
                                </div>
                                <div v-for="(fitem,findex) in agentFilterCriteria" :key="findex" class="sortRow"
                                    @@click="handleFilterCriteria('agent',fitem.value)">
                                    <span class="sortRowText">{{ fitem.label }}</span>
                                    <i v-if="fitem.checked" class="el-icon-check sortRowIcon"></i>
                                </div>
                            </div>
                            <i slot="reference" class="el-icon-more sidebar-searchRow-icon"></i>
                        </el-popover>
                    </div>
                </div>
                <el-scrollbar class="sidebar-main-container" wrap-class="scrollbar-wrapper">
                    <template v-if="agentList&&agentList.length">
                        <div class="sidebar-agentitem text-ellipsis"
                            :class="{'sidebar-agentitem_active':scrollbarAgentIndex === ''}"
                            @@click="handleAgentViewAll">
                            <i class="el-icon-s-custom sidebar-all-item-icon" aria-hidden="true"></i>
                            {{ncfST('Frontend.AgentsManager.AllAgents')}}
                        </div>
                        <div v-for="(item,index) in agentList" :key="item.id" class="sidebar-agentitem text-ellipsis"
                            :class="{'sidebar-agentitem_active':scrollbarAgentIndex === item.id}" :title="item.name"
                            @@click="handleAgentView(item,index)">
                            {{ item.name }}
                        </div>
                    </template>
                    <div v-else class="df-wn flex-ac flex-jc emptyData"
                        style="flex-grow: 1;font-size: 14px;color: #5e6d82;margin-top:150px;">{{ncfST('Frontend.AgentsManager.NoData')}}</div>
                </el-scrollbar>
            </div>
            @* Main content *@
            <div class="main-container"
                :class="[scrollbarAgentIndex === ''? 'agent-container':'agentDetails-container']">
                @* Agent list *@
                <template v-if="scrollbarAgentIndex === ''">
                    <div class="agent-view-mode-row">
                        <el-radio-group v-model="agentListViewMode" size="mini" @@change="handleAgentListViewModeChange">
                            <el-radio-button label="panel">{{ncfST('Frontend.AgentsManager.PanelView')}}</el-radio-button>
                            <el-radio-button label="three">{{ncfST('Frontend.AgentsManager.ThreeDView')}}</el-radio-button>
                            <el-radio-button label="stats">{{ncfST('Frontend.AgentsManager.StatisticsChart')}}</el-radio-button>
                        </el-radio-group>
                        <el-button size="mini" type="warning" plain icon="el-icon-connection" style="margin-left:10px;"
                            @@click="openRemoteAgentManager">{{ncfST('Frontend.AgentsManager.ManageRemoteATwoAAgents')}}</el-button>
                    </div>
                    <el-scrollbar v-if="agentListViewMode === 'panel'" class="sidebar-agent-container" wrap-class="scrollbar-wrapper">
                        <div ref="agentElListBox" class="agent-listWrap">
                            <div v-for="(aitem,aindex) in agentList" :key="aindex" class="agent-cardBox">
                                <div class="agentCard-stateboxStack">
                                    <div class="agentCard-statebox" :class="[getStatusColor(aitem,'1')]">
                                        {{ getStatusText(aitem,'1') }}
                                    </div>
                                    <el-tag v-if="aitem.hasPublishedA2A" :type="aitem.publishedA2AEnabled ? 'warning' : 'info'"
                                        size="mini" class="agentCard-a2aBadge">A2A</el-tag>
                                </div>
                                <div class="agentCard-upperHalfbox">
                                    <div class="df-wn flex-ac flex-jc avatarBox">
                                        <img :src="aitem.avastar | showAvatar" alt="" class="upperHalfbox_avatar">
                                    </div>
                                    <div class="upperHalfbox_describe_title text-ellipsis" :title="aitem.name">{{
                                        aitem.name }}</div>
                                </div>
                                <div class="agentCard-middleHalfbox text-ellipsis-2line" :title="aitem.description">{{
                                    aitem.description }}
                                </div>
                                <div class="agentCard-statistics">
                                    <span>{{ncfST('Frontend.AgentsManager.CompletedRounds')}} {{ formatUsageCount(aitem.completedConversationRounds) }}</span>
                                    <span>Token {{ formatUsageCount(aitem.totalTokens) }}</span>
                                    <button v-if="aitem.knowledgeBaseId" type="button" class="agentCard-knowledgeBaseLink text-ellipsis"
                                        :title="`${aitem.knowledgeBaseName || ncfST('Frontend.AgentsManager.KnowledgeBaseAlternate')} (${getKnowledgeBaseBindingInfo(aitem.knowledgeBaseId).text}) - ${ncfST('Frontend.AgentsManager.ManageMaterials')}`"
                                        @@click.stop="openKnowledgeBase(aitem.knowledgeBaseId, 'materials')">
                                        {{ aitem.knowledgeBaseName || ncfST('Frontend.AgentsManager.KnowledgeBaseAlternate') }} · {{ getKnowledgeBaseBindingInfo(aitem.knowledgeBaseId).text }}
                                    </button>
                                    <span v-else class="text-ellipsis" :title="ncfST('Frontend.AgentsManager.NoKnowledgeBaseBound')">{{ncfST('Frontend.AgentsManager.NoKnowledgeBaseBound')}}</span>
                                </div>
                                <div class="agentCard-lowerHalfbox">
                                    <div class="lowerHalfbox_label">{{ncfST('Frontend.AgentsManager.Participating')}}</div>
                                    <div class="lowerHalfbox_quantity">{{ aitem.chattingCount }}</div>
                                    <div class="lowerHalfbox_label">{{ncfST('Frontend.AgentsManager.Score')}}</div>
                                    <div class="lowerHalfbox_score">{{ aitem.score }}</div>
                                    <button type="button" class="lowerHalfbox_operation"
                                        @@click="handleEditDrawerOpenBtn('drawerAgent',aitem)">{{ncfST('Frontend.AgentsManager.Edit')}}</button>
                                    <button type="button" class="lowerHalfbox_operation lowerHalfbox_operation--a2a"
                                        :title="aitem.hasPublishedA2A ? ncfST('Frontend.AgentsManager.ManageATwoAPublishing') : ncfST('Frontend.AgentsManager.PublishAsATwoA')"
                                        @@click="openPublishedA2AEditor(aitem)">{{ aitem.hasPublishedA2A ? ncfST('Frontend.AgentsManager.ManageATwoAPublishing') : ncfST('Frontend.AgentsManager.PublishAsATwoA') }}</button>
                                    <button type="button" class="lowerHalfbox_operation" :title="ncfST('Frontend.AgentsManager.ViewTasksAssociatedWithThisAgent')"
                                        @@click="handleAgentView(aitem,aindex)">{{ncfST('Frontend.AgentsManager.ViewTasks')}}</button>
                                </div>
                            </div>
                            <div v-for="fitem in fillCardNum" :key="fitem" style="flex-grow: 1;flex-basis: 315px;">
                            </div>
                            <div v-if="agentList.length === 0" class="df-wn flex-ac flex-jc emptyData"
                                style="flex-grow: 1;font-size: 14px;color: #5e6d82;margin-top:150px;">{{ ncfST('Frontend.AgentsManager.NoData') }}</div>
                        </div>

                    </el-scrollbar>
                    <div v-else-if="agentListViewMode === 'three'">
                        <partial name="~/Areas/Admin/Pages/AgentsManager/_Studio.cshtml" />
                    </div>
                    <div v-else class="agent-statistics-wrap">
                        <div class="agent-statistics-toolbar">
                            <div>
                                <div class="agent-statistics-toolbar__title">{{ncfST('Frontend.AgentsManager.AgentStatisticsChart')}}</div>
                                <div class="agent-statistics-toolbar__hint">{{ ncfST('Frontend.AgentsManager.TileAreaRepresentsTheRelativeSizeOfTheSelectedMetricClickA') }}</div>
                            </div>
                            <div class="agent-statistics-toolbar__actions">
                                <el-select v-model="agentStatisticMetric" size="mini" style="width:150px;">
                                    <el-option v-for="option in agentStatisticMetricOptions" :key="option.value"
                                        :label="option.label" :value="option.value"></el-option>
                                </el-select>
                                <el-button size="mini" icon="el-icon-refresh" @@click="refreshAgentStatistics">{{ncfST('Frontend.AgentsManager.RefreshData')}}</el-button>
                            </div>
                        </div>
                        <div class="agent-statistics-summary">
                            <div class="agent-statistics-summary__item">
                                <span>{{ ncfST('Frontend.AgentsManager.LocalAgents') }}</span>
                                <strong>{{ formatUsageCount(agentList.length) }}</strong>
                            </div>
                            <div class="agent-statistics-summary__item">
                                <span>{{ agentStatisticMetricLabel }}{{ ncfST('Frontend.AgentsManager.Total') }}</span>
                                <strong>{{ formatAgentStatisticValue(agentStatisticMetricTotal) }} {{ agentStatisticMetricUnit }}</strong>
                            </div>
                            <div class="agent-statistics-summary__item agent-statistics-summary__note">
                                <span>{{ncfST('Frontend.AgentsManager.StatisticsScope')}}</span>
                                <strong>{{ncfST('Frontend.AgentsManager.InheritHILLevel')}}</strong>
                            </div>
                        </div>
                        <el-scrollbar class="agent-statistics-scrollbar" wrap-class="scrollbar-wrapper">
                            <div v-if="agentStatisticTiles.length" class="agent-statistics-grid">
                                <button v-for="tile in agentStatisticTiles" :key="tile.agent.id" type="button"
                                    class="agent-statistics-tile" :class="{'is-disabled': !tile.agent.enable, 'is-a2a': tile.agent.hasPublishedA2A}"
                                    :style="agentStatisticTileStyle(tile)" :title="tile.title"
                                    @@click="handleAgentStatisticTileClick(tile.agent)">
                                    <span class="agent-statistics-tile__status">{{ getStatusText(tile.agent,'1') }}</span>
                                    <span v-if="tile.agent.hasPublishedA2A" class="agent-statistics-tile__a2a">A2A</span>
                                    <span class="agent-statistics-tile__name">{{ tile.agent.name }}</span>
                                    <span class="agent-statistics-tile__value">{{ formatAgentStatisticValue(tile.value) }} {{ agentStatisticMetricUnit }}</span>
                                    <span class="agent-statistics-tile__action"><i class="el-icon-edit" aria-hidden="true"></i> {{ ncfST('Frontend.AgentsManager.Edit') }}</span>
                                </button>
                            </div>
                            <div v-else class="agent-statistics-empty">{{ncfST('Frontend.AgentsManager.NoData')}}</div>
                        </el-scrollbar>
                    </div>
                </template>
                @* Agent details *@
                <template v-else-if="agentDetails">
                    <div class="df-wn flex-ac flex-js agentDetails-head">
                        <div class="df-wn flex-ac flex-js agentDetails-head-item1">
                            <div class="df-wn flex-ac flex-jc avatarBox">
                                <img :src="agentDetails.agentTemplateDto.avastar | showAvatar" alt="">
                            </div>
                            <div class="df-wn flex-dc namebox itemBox">
                                <div class="name text-ellipsis">
                                    {{ agentDetails.agentTemplateDto.name }}
                                </div>
                                <div class="btn" @@click="handleEditDrawerOpenBtn('drawerAgent',agentDetails)">
                                    {{ ncfST('Frontend.AgentsManager.Edit') }}
                                </div>
                            </div>
                        </div>
                        <div class="df-wn flex-dc flex-jsb agentDetails-head-item2">
                            <div class="df-wn flex-ac flex-js itemBox">
                                <span class="label" style="width: 80px;">{{ ncfST('Frontend.AgentsManager.Groups') }}</span>
                                <span class="numerical">{{ agentDetails.participationGroup || 0 }}</span>
                            </div>
                            <div class="df-wn flex-ac flex-js itemBox">
                                <span class="label" style="width: 80px;">{{ ncfST('Frontend.AgentsManager.Tasks') }}</span>
                                <span class="numerical">{{ agentDetails.participationInTasks || 0 }}</span>
                            </div>
                            <div class="df-wn flex-ac flex-js itemBox">
                                <span class="label" style="width: 80px;">{{ ncfST('Frontend.AgentsManager.RunningTasks') }}</span>
                                <span class="numerical">{{ agentDetails.agentTemplateDto.chattingCount || 0 }}</span>
                            </div>
                        </div>
                        <div class="df-wn flex-dc flex-jsb agentDetails-head-item3">
                            <div class="df-wn flex-ac flex-js itemBox">
                                <span class="label">{{ ncfST('Frontend.AgentsManager.Range') }}</span>
                                <span class="value">
                                    {{ agentDetails.promptRangeDto ? handlePromptShowName('1',agentDetails) : ncfST('Frontend.AgentsManager.ManualEntry') }}
                                </span>
                            </div>
                            <div class="df-wn flex-ac flex-js itemBox">
                                <span class="label">{{ ncfST('Frontend.AgentsManager.Tactic') }}</span>
                                <span class="value">
                                    {{ agentDetails.promptItemDto ? handlePromptShowName('2',agentDetails) : '--' }}
                                </span>
                                <span v-if="agentDetails.promptItemDto" class="btnText"
                                    @@click="jumpPromptRange('promptRange',agentDetails.promptItemDto)">{{ ncfST('Frontend.AgentsManager.Run') }}</span>
                            </div>
                            <div class="df-wn flex-ac flex-js itemBox">
                                <span class="label">{{ ncfST('Frontend.AgentsManager.Model') }}</span>
                                <span class="value">{{ agentDetails.aiModelDto ? agentDetails.aiModelDto.deploymentName
                                    : '' }}</span>
                                <span class="btnText"
                                    @@click="jumpPromptRange('model',agentDetails.aiModelDto)">{{ ncfST('Frontend.AgentsManager.ManageAIModels') }}</span>
                            </div>
                        </div>
                        <div class="df-wn flex-dc flex-jsb agentDetails-head-item4">
                            <div class="df-wn flex-ac flex-js itemBox">
                                <span class="label">{{ ncfST('Frontend.AgentsManager.ModelParameters') }}</span>
                                <span class="btnText"
                                    @@click="jumpPromptRange('modelParameter',agentDetails.promptItemDto)">{{ ncfST('Frontend.AgentsManager.Details') }}</span>
                            </div>
                            <div class="df-wn flex-ac flex-js itemBox">
                                <span class="label">{{ ncfST('Frontend.AgentsManager.ModelScore') }}</span>
                                <span class="value">{{ agentDetails.promptItemDto ?
                                    agentDetails.promptItemDto.evalAvgScore : '' }}</span>
                            </div>
                            <div class="df-wn flex-ac flex-js itemBox">
                                <span class="label">{{ ncfST('Frontend.AgentsManager.Status') }}</span>
                                <span class="value">{{ getStatusText(agentDetails,'1') }}</span>
                                <span class="btnText"
                                    :style="{'color': agentDetails.agentTemplateDto.enable ? '#F56C6C' : '#2a82e4' }"
                                    @@click="setAgentState('stop', agentDetails)">{{
                                    agentDetails.agentTemplateDto.enable ? ncfST('Frontend.AgentsManager.Disabled') : ncfST('Frontend.AgentsManager.Enabled') }}</span>
                            </div>
                        </div>
                    </div>
                    <div class="agentDetails-statistics">
                        <span class="agentDetails-knowledgeBase">
                            <span>{{ ncfST('Frontend.AgentsManager.KnowledgeBase') }}</span>
                            <el-button v-if="agentDetails.agentTemplateDto.knowledgeBaseId" type="text" size="mini"
                                @@click="openKnowledgeBase(agentDetails.agentTemplateDto.knowledgeBaseId, 'materials')">
                                {{ agentDetails.agentTemplateDto.knowledgeBaseName || ncfST('Frontend.AgentsManager.KnowledgeBaseAlternate') }}
                            </el-button>
                            <span v-else>{{ ncfST('Frontend.AgentsManager.NotBound') }}</span>
                            <el-tag v-if="agentDetails.agentTemplateDto.knowledgeBaseId" size="mini"
                                :type="getKnowledgeBaseBindingInfo(agentDetails.agentTemplateDto.knowledgeBaseId).type">
                                {{ getKnowledgeBaseBindingInfo(agentDetails.agentTemplateDto.knowledgeBaseId).text }}
                            </el-tag>
                            <el-button v-if="agentDetails.agentTemplateDto.knowledgeBaseId" type="text" size="mini"
                                @@click="openKnowledgeBase(agentDetails.agentTemplateDto.knowledgeBaseId, 'materials')">{{ ncfST('Frontend.AgentsManager.Materials') }}</el-button>
                            <el-button v-if="agentDetails.agentTemplateDto.knowledgeBaseId" type="text" size="mini"
                                @@click="openKnowledgeBase(agentDetails.agentTemplateDto.knowledgeBaseId, 'edit')">{{ ncfST('Frontend.AgentsManager.Settings') }}</el-button>
                        </span>
                        <span>{{ ncfST('Frontend.AgentsManager.CompletedConversationRounds') }}{{ formatUsageCount(agentDetails.agentTemplateDto.completedConversationRounds) }}</span>
                        <span>{{ ncfST('Frontend.AgentsManager.CompletedTasks') }}{{ formatUsageCount(agentDetails.agentTemplateDto.completedTaskCount) }}</span>
                        <span>{{ ncfST('Frontend.AgentsManager.InputTokensLabel') }}{{ formatUsageCount(agentDetails.agentTemplateDto.promptTokens) }}</span>
                        <span>{{ ncfST('Frontend.AgentsManager.OutputTokensLabel') }}{{ formatUsageCount(agentDetails.agentTemplateDto.completionTokens) }}</span>
                        <span>{{ ncfST('Frontend.AgentsManager.TotalTokens') }}{{ formatUsageCount(agentDetails.agentTemplateDto.totalTokens) }}</span>
                        <span>{{ ncfST('Frontend.AgentsManager.AverageResponse') }}{{ formatResponseMilliseconds(agentDetails.agentTemplateDto.averageResponseMilliseconds) }}</span>
                        <span>{{ ncfST('Frontend.AgentsManager.LastActivity') }}{{ formatActivityTime(agentDetails.agentTemplateDto.lastActiveTime) }}</span>
                    </div>
                    <div class="df-wn agentDetails-main">
                        <div class="agentDetails-main-left">
                            <el-tabs v-model="agentDetailsTabsActiveName" class="pageTabs"
                                @@tab-click="handleAgentDetailsTabsClick">
                                <el-tab-pane :label="ncfST('Frontend.AgentsManager.GroupsAlternate')" name="first">
                                    <div class="agentDetails-main-left-list">
                                        <div class="agentDetails-main-left-list-filter">
                                            <el-input v-model="agentDetailsGroupQueryList.filter" :placeholder="ncfST('Frontend.AgentsManager.SearchByName')"
                                                suffix-icon="el-icon-search"
                                                @@change="handleFilterChange($event,'agentGroup')"></el-input>
                                        </div>
                                        <el-scrollbar class="sidebar-agentDetails-main-left"
                                            wrap-class="scrollbar-wrapper">
                                            <template v-if="agentDetailsGroupList&&agentDetailsGroupList.length">
                                                <div v-for="(item,index) in agentDetailsGroupList" :key="index"
                                                    class="sidebar-agentitem text-ellipsis"
                                                    :class="{'sidebar-agentitem_active':agentDetailsGroupIndex === index}"
                                                    :title="item.name"
                                                    @@click="handleGroupView('agentGroup',item,index)">
                                                    {{ item.name }}
                                                </div>
                                            </template>
                                            <div v-else class="df-wn flex-ac flex-jc emptyData"
                                                style="flex-grow: 1;font-size: 14px;color: #5e6d82;margin-top:150px;">
                                                {{ ncfST('Frontend.AgentsManager.NoData') }}</div>
                                        </el-scrollbar>
                                    </div>
                                </el-tab-pane>
                                <el-tab-pane :label="ncfST('Frontend.AgentsManager.Jobs')" name="second">
                                    <div class="agentDetails-main-left-list">
                                        <div class="agentDetails-main-left-list-filter">
                                            <el-input v-model="agentDetailsTaskQueryList.filter" :placeholder="ncfST('Frontend.AgentsManager.SearchByName')"
                                                suffix-icon="el-icon-search"
                                                @@change="handleFilterChange($event,'agentTask')"></el-input>
                                        </div>
                                        <el-scrollbar class="sidebar-agentDetails-main-left"
                                            wrap-class="scrollbar-wrapper">
                                            <template v-if="agentDetailsTaskList&&agentDetailsTaskList.length">
                                                <div v-for="(item,index) in agentDetailsTaskList" :key="index"
                                                    class="sidebar-agentitem text-ellipsis"
                                                    :class="{'sidebar-agentitem_active':agentDetailsTaskIndex === index}"
                                                    :title="item.name" @@click="handleTaskView('agentTask',item,index)">
                                                    {{ item.name }}
                                                </div>
                                            </template>
                                            <div v-else class="df-wn flex-ac flex-jc emptyData"
                                                style="flex-grow: 1;font-size: 14px;color: #5e6d82;margin-top:150px;">
                                                {{ ncfST('Frontend.AgentsManager.NoData') }}</div>
                                        </el-scrollbar>
                                    </div>
                                </el-tab-pane>
                            </el-tabs>
                        </div>
                        <div class="agentDetails-main-right">
                            <template v-if="agentDetailsTabsActiveName === 'first'">
                                @* Group details *@
                                <template v-if="agentDetailsGroupShowType === '1'">
                                    <div class="df-wn flex-ac flex-js groupInfoRow">
                                        <template
                                            v-if="agentDetailsGroupDetails&&agentDetailsGroupDetails.chatGroupDto">
                                            <div class="groupInfoRow-name text-ellipsis"
                                                :title="agentDetailsGroupDetails.chatGroupDto.name">{{
                                                agentDetailsGroupDetails.chatGroupDto.name }}
                                            </div>
                                            <div class="df-wn groupInfoRow-operation">
                                                <el-button type="danger" size="mini"
                                                    @@click="setAgentState('delete',agentDetailsGroupDetails)">{{ ncfST('Frontend.AgentsManager.LeaveGroup') }}</el-button>
                                <el-button type="primary" size="mini" :disabled="!agentDetailsGroupDetails.chatGroupDto.enable"
                                    @@click="handleElVisibleOpenBtn('drawerGroupStart',agentDetailsGroupDetails)">{{ ncfST('Frontend.AgentsManager.Start') }}</el-button>
                                <el-button :type="agentDetailsGroupDetails.chatGroupDto.enable ? 'warning' : 'success'" size="mini"
                                    @@click="setGroupState(agentDetailsGroupDetails)">{{ agentDetailsGroupDetails.chatGroupDto.enable ? ncfST('Frontend.AgentsManager.Disabled') : ncfST('Frontend.AgentsManager.Enabled') }}</el-button>
                                <el-button type="primary" size="mini"
                                    @@click="handleEditDrawerOpenBtn('drawerGroup',agentDetailsGroupDetails)">{{ ncfST('Frontend.AgentsManager.Edit') }}</el-button>
                                                <el-button type="primary" size="mini"
                                                    @@click="handleTaskStartBatch('agentGroupTaskBatch',agentDetailsGroupDetails)">{{ ncfST('Frontend.AgentsManager.StartSelected') }}</el-button>
                                                <el-button type="warning" size="mini"
                                                    @@click="handleTaskForceStopBatch('agentGroupTaskBatch',agentDetailsGroupDetails)">{{ ncfST('Frontend.AgentsManager.StopSelected') }}</el-button>
                                                <el-button type="danger" size="mini"
                                                    @@click="handleTaskDeleteBatch('agentGroupTaskBatch',agentDetailsGroupDetails)">{{ ncfST('Frontend.AgentsManager.DeleteSelected') }}</el-button>
                                            </div>
                                        </template>
