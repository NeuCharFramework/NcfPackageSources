                                <div class="df-wn flex-dc taskrecord-listWrap">
                                    <div v-for="ritem in taskHistoryList" :key="ritem.id"
                                        :class="['taskrecord-listWrap-item', { 'taskrecord-listWrap-item-streaming': ritem._streaming }]"
