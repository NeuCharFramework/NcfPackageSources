                                    </div>
                                    <div class="taskmain-members-usage-item">
                                        <span class="taskmain-members-usage-label">总 Token（输入+输出）</span>
                                        <span class="taskmain-members-usage-value">{{ formatUsageCount(taskUsageSummaryByType.task.totalTokens) }}</span>
                                    </div>
                                    <div class="taskmain-members-usage-item">
                                        <span class="taskmain-members-usage-label">平均响应时长</span>
                                        <span class="taskmain-members-usage-value">{{ formatResponseMilliseconds(taskUsageSummaryByType.task.averageResponseMilliseconds) }}</span>
                                    </div>
                                    <div class="taskmain-members-usage-item">
                                        <span class="taskmain-members-usage-label">最大时长</span>
                                        <span class="taskmain-members-usage-value">{{ formatResponseMilliseconds(taskUsageSummaryByType.task.maxResponseMilliseconds) }}</span>
                                    </div>
                                </div>
                            </div>
                            <el-input v-model="taskMemberfilter" placeholder="请输入名称搜索" suffix-icon="el-icon-search" style="margin-bottom: 15px;" @@input="handleTaskFilterChange($event,'task')"></el-input>
                            <div class="taskmain-members-title">
                                机器人·{{ taskMemberList ? taskMemberList.length : 0 }}
                            </div>
                            <el-scrollbar class="sidebar-taskmembers-container" wrap-class="scrollbar-wrapper">
                                <div class="df-wn flex-dc taskmain-members-listWrap">
                                    <participant-quick-action
                                        v-for="mitem in taskMemberList"
                                        :key="mitem.participantKey || ('local-' + mitem.id)"
                                        v-show="mitem.name.includes(taskMemberfilter)"
                                        :participant="mitem"
                                        :quick-info="getParticipantQuickInfo('task', mitem)"
                                        :testing="isRemoteAgentTesting(mitem.id)"
                                        @@test-remote="testTaskRemoteAgent(mitem)">
                                    </participant-quick-action>
                                </div>
                            </el-scrollbar>
                        </div>
                    </div>
                </template>
                <div v-else class="df-wn flex-ac flex-jc emptyData"
                    style="flex-grow: 1;font-size: 14px;color: #5e6d82;margin-top:150px;">暂无数据</div>
            </div>
        </div>
    </el-tab-pane>
</el-tabs>

<el-dialog title="任务用量统计" :visible.sync="usageAnalyticsVisible" width="86%" :close-on-click-modal="false">
    <div class="usage-analytics-toolbar">
        <span class="usage-analytics-title">任务：{{ usageAnalyticsTaskName }}（#{{ usageAnalyticsTaskId }}）</span>
        <el-date-picker
            v-model="usageAnalyticsDateRange"
            type="datetimerange"
            range-separator="至"
            start-placeholder="开始时间"
            end-placeholder="结束时间"
            value-format="yyyy-MM-dd HH:mm:ss"
            size="mini">
        </el-date-picker>
        <el-select v-model="usageAnalyticsAgentId" clearable filterable size="mini" placeholder="全部 Agents">
            <el-option v-for="item in usageAnalyticsAgentOptions" :key="'usage-agent-' + item.id" :label="item.name" :value="item.id"></el-option>
        </el-select>
        <el-button size="mini" type="primary" @@click="loadUsageAnalytics">查询</el-button>
        <el-button size="mini" @@click="resetUsageAnalyticsFilters">重置</el-button>
    </div>

    <div class="usage-analytics-overview" v-loading="usageAnalyticsLoading">
        <div class="usage-card">
            <div class="label">消息总数</div>
            <div class="value">{{ usageAnalyticsData.overview.messageCount || 0 }}</div>
        </div>
        <div class="usage-card">
            <div class="label">总 Token</div>
            <div class="value">{{ usageAnalyticsData.overview.totalTokens || 0 }}</div>
        </div>
        <div class="usage-card">
            <div class="label">输入 / 输出 Token</div>
            <div class="value">{{ usageAnalyticsData.overview.promptTokens || 0 }} / {{ usageAnalyticsData.overview.completionTokens || 0 }}</div>
        </div>
        <div class="usage-card">
            <div class="label">平均响应时长</div>
            <div class="value">{{ Number(usageAnalyticsData.overview.averageResponseMilliseconds || 0).toFixed(1) }} ms</div>
        </div>
        <div class="usage-card">
            <div class="label">P95 / 最大时长</div>
            <div class="value">{{ usageAnalyticsData.overview.p95ResponseMilliseconds || 0 }} / {{ usageAnalyticsData.overview.maxResponseMilliseconds || 0 }} ms</div>
        </div>
    </div>

    <el-tabs>
        <el-tab-pane label="单轮对话">
            <el-table :data="usageAnalyticsData.roundStats" size="mini" height="280">
                <el-table-column prop="roundIndex" label="轮次" width="80"></el-table-column>
                <el-table-column prop="messageCount" label="消息数" width="90"></el-table-column>
                <el-table-column prop="promptTokens" label="输入 Token" width="110"></el-table-column>
                <el-table-column prop="completionTokens" label="输出 Token" width="110"></el-table-column>
                <el-table-column prop="totalTokens" label="总 Token" width="110"></el-table-column>
                <el-table-column label="平均响应(ms)">
                    <template slot-scope="{ row }">{{ Number(row.averageResponseMilliseconds || 0).toFixed(1) }}</template>
                </el-table-column>
            </el-table>
        </el-tab-pane>
        <el-tab-pane label="单个 Agents">
            <el-table :data="usageAnalyticsData.agentStats" size="mini" height="280">
                <el-table-column prop="agentTemplateId" label="Agent ID" width="95"></el-table-column>
                <el-table-column prop="agentName" label="Agent"></el-table-column>
                <el-table-column prop="messageCount" label="消息数" width="90"></el-table-column>
                <el-table-column prop="totalTokens" label="总 Token" width="120"></el-table-column>
                <el-table-column label="平均响应(ms)" width="140">
                    <template slot-scope="{ row }">{{ Number(row.averageResponseMilliseconds || 0).toFixed(1) }}</template>
                </el-table-column>
            </el-table>
        </el-tab-pane>
        <el-tab-pane label="按时间统计">
            <el-table :data="usageAnalyticsData.timelineStats" size="mini" height="280">
                <el-table-column label="时间桶（小时）" min-width="180">
                    <template slot-scope="{ row }">{{ row.bucketTime | showFormatDate }}</template>
                </el-table-column>
                <el-table-column prop="messageCount" label="消息数" width="90"></el-table-column>
                <el-table-column prop="totalTokens" label="总 Token" width="120"></el-table-column>
                <el-table-column label="平均响应(ms)" width="140">
                    <template slot-scope="{ row }">{{ Number(row.averageResponseMilliseconds || 0).toFixed(1) }}</template>
                </el-table-column>
            </el-table>
        </el-tab-pane>
    </el-tabs>
</el-dialog>

@* 抽屉 新增|编辑 智能体 540px *@
<el-drawer :visible.sync="visible.drawerAgent" direction="rtl" :with-header="false" :wrapper-closable="false"
    :close-on-press-escape="false" size="960px">
    <div class="drawerRtl">
        @* 内容中的头（包括标题和关闭图标） *@
        <div class="drawerRtl__header">
            <div class="drawerRtl__header__title">{{ agentForm.id ? '编辑智能体' : '新增智能体' }}</div>
            <div class="drawerRtl__header__close" @@click="handleElVisibleClose('drawerAgent')">&times;</div>
        </div>
        @* 内容中的主体内容 *@
        <div class="drawerRtl__body">
            <el-form v-if="visible.drawerAgent" ref="agentELForm" :model="agentForm" :rules="agentFormRules"
                :size="elSize" label-position="left" label-width="130px" class="drawerForm-container">
                <el-form-item label="智能体名称" prop="name">
                    <div class="agentNameFormField">
                        <el-input v-model="agentForm.name" placeholder="请填写"></el-input>
                        <el-button v-if="agentForm.id" size="small" type="danger" plain icon="el-icon-delete"
                            @@click="handleAgentDelete(agentForm, { closeEditor: true })">删除智能体</el-button>
                    </div>
                </el-form-item>
                <el-form-item label="SystemMessage" required>
                    <el-radio-group v-model="agentForm.systemMessageType" @@change="handleSystemMessageTypeChange">
                        <el-radio label="1" border>自选</el-radio>
                        <el-radio label="2" border>手动</el-radio>
                    </el-radio-group>
                </el-form-item>
                <el-form-item v-show="agentForm.systemMessageType === '1'" label="自选" prop="systemMessage">
                    @* @change="handleChange($event,'')" *@
                    <load-more-select v-model="agentForm.systemMessage" service-type="systemMessage"
                        direction="vertical" placeholder="请选择" @@options-loaded="handleSystemMessageOptionsLoaded" />
                </el-form-item>
                <el-form-item v-if="agentForm.systemMessageType === '2'" label="手动输入" prop="systemMessage">
                    <el-input  
                       type="textarea"  
                       v-model="agentForm.systemMessage"  
                       @@change="handleIdentify"  
                       placeholder="请填写"  
                       :rows="4">  
                    </el-input>
                    
                </el-form-item>
                <el-form-item label="是否启用" prop="enable">
                    <el-checkbox v-model="agentForm.enable">启用智能体</el-checkbox>
                </el-form-item>
                <el-form-item v-if="agentForm.id" label="A2A 对外服务">
                    <el-button size="small" type="warning" plain icon="el-icon-connection" @@click="openPublishedA2AEditor(agentForm)">配置 / 发布为 A2A Agent</el-button>
                    <div class="form-help-text">发布后将生成标准 Agent Card，供任意兼容 A2A 的系统发现和调用。</div>
                </el-form-item>
                <el-form-item label="绑定知识库" prop="knowledgeBaseId">
                    <el-select v-model="agentForm.knowledgeBaseId" clearable filterable style="width:100%" placeholder="不绑定知识库">
                        <el-option v-for="item in knowledgeBaseOptions" :key="item.id"
                            :label="getKnowledgeBaseOptionLabel(item)"
                            :value="item.id" :disabled="!item.isEmbedded"></el-option>
                    </el-select>
                    <div v-if="agentForm.knowledgeBaseId" class="knowledgeBase-shortcuts">
                        <el-tag size="mini" :type="getKnowledgeBaseBindingInfo(agentForm.knowledgeBaseId).type">
                            {{ getKnowledgeBaseBindingInfo(agentForm.knowledgeBaseId).text }}
                        </el-tag>
                        <el-button size="mini" type="primary" plain icon="el-icon-folder-opened"
                            @@click="openKnowledgeBase(agentForm.knowledgeBaseId, 'materials')">管理资料</el-button>
                        <el-button size="mini" plain icon="el-icon-setting"
                            @@click="openKnowledgeBase(agentForm.knowledgeBaseId, 'edit')">编辑设置</el-button>
                        <el-button size="mini" type="text" icon="el-icon-refresh"
                            @@click="refreshKnowledgeBaseOptions">刷新状态</el-button>
                    </div>
                    <div class="form-help-text">
                        绑定后会在模型调用前优先执行 RAG 召回；召回失败时保留模型回退能力。
                        <template v-if="getKnowledgeBaseBindingInfo(agentForm.knowledgeBaseId).text === '旧版向量化，待发布'">旧版向量数据需要在知识库中重新向量化，才能升级为 Agent 可安全隔离检索的发布集合。</template>
                    </div>
                </el-form-item>
                <el-form-item label="外接平台" prop="hookRobotType">
                    <el-select v-model="agentForm.hookRobotType" style="width:100%" placeholder="请选择">
                        <el-option label="None" :value="0"></el-option>
                        <el-option label="WeChatMp" :value="1"></el-option>
                        <el-option label="WeChatWorkRobot" :value="2"></el-option>
                    </el-select>
                </el-form-item>
                <el-form-item label="外接平台参数" prop="hookRobotParameter">
                    <el-input v-model="agentForm.hookRobotParameter" placeholder="请填写" :disabled="agentForm.hookRobotType === 0"></el-input>
                </el-form-item>
                <el-form-item label="Agent 头像" prop="avastar">
                    <div class="df-wn flex-ac flex-js agentForm-agentAvatarBox">
                        <div v-for="(aitem,aindex) in agentAvatarList" :key="aindex"
                            class="df-wn flex-ac flex-jc agentAvatarBoxItem"
                            :class="{'agentAvatarBoxItem-active':aitem === agentForm.avastar}"
                            @@click="handleFormValidateField('agentELForm','agentForm','avastar',aitem)">
                            <img :src="aitem" alt="">
                        </div>
                    </div>
                </el-form-item>
                <el-form-item label="Function Calls" prop="functionCallNames">
                    <div class="function-call-container">
                        <div style="margin-bottom: 8px;">
                            <el-switch
                                v-model="agentAutoAttachXncf"
                                @@change="handleAutoAttachXncfChange"
                                active-text="自动附加所有 XNCF 功能插件"
                                inactive-text="手动选择">
                            </el-switch>
                            <el-tooltip content="开启后将自动附加所有已注册的 XNCF 功能插件，使智能体能自动识别并触发对应模块的功能" placement="top">
                                <i class="el-icon-question" style="margin-left: 6px; color: #909399;"></i>
                            </el-tooltip>
                        </div>
                        <div class="function-call-tags">
                            <el-tag
                                v-for="tag in agentForm.functionCallNames ? agentForm.functionCallNames.split(',').filter(x => x) : []"
                                :key="tag"
                                closable
                                :disable-transitions="false"
                                @@close="handleFunctionCallClose(tag)"
                                class="function-call-tag">
                                {{tag}}
                            </el-tag>
                            <el-input
                                v-if="functionCallInputVisible"
                                ref="functionCallInput"
                                v-model="functionCallInputValue"
                                class="input-new-tag"
                                size="small"
                                placeholder="可输入 Plugin 类名，或带有命名空间的完整名称"
                                @@keyup.enter.native="handleFunctionCallInputConfirm"
                                @@blur="handleFunctionCallInputConfirm">
                            </el-input>
                            <el-button v-else class="button-new-tag" size="small" @@click="showFunctionCallInput">+ 添加</el-button>
                        </div>
                        
                        <div class="plugin-types-container" v-if="availablePluginTypes.length">
                            <div class="plugin-types-title">可用插件类型:</div>
                            <div class="plugin-types-list">
                                <el-button
                                    v-for="pluginType in availablePluginTypes"
                                    :key="pluginType"
                                    size="small"
                                    type="info"
                                    plain
                                    class="plugin-type-btn"
                                    @@click="handleAddPluginType(pluginType)">
                                    {{ pluginType }}
                                </el-button>
                            </div>
                        </div>
                    </div>
                </el-form-item>
                
                <el-form-item label="MCP Endpoints" prop="mcpEndpoints">
                    <div class="mcp-endpoints-container">
                        <div class="mcp-endpoints-list">
                            <div v-for="(endpoint, name) in parsedMcpEndpoints" :key="name" class="mcp-endpoint-item">
                                <div class="mcp-endpoint-info">
                                    <span class="mcp-endpoint-name">{{name}}</span>
                                    <span class="mcp-endpoint-url">{{endpoint.url}}</span>
                                    <div v-if="endpoint.testResult && endpoint.testResult.success" class="mcp-endpoint-test-result">
                                        <div class="test-status success">连接成功</div>
                                        <el-button size="mini" type="primary" plain @@click="showMcpToolsDialog(endpoint)">
                                            查看工具列表 ({{endpoint.testResult.tools ? endpoint.testResult.tools.length : 0}})
                                        </el-button>
                                    </div>
                                    <div v-else-if="endpoint.testResult && !endpoint.testResult.success" class="mcp-endpoint-test-result">
                                        <div class="test-status failed">连接失败: {{endpoint.testResult.message}}</div>
                                    </div>
                                </div>
                                <div class="mcp-endpoint-actions">
                                    <el-button 
                                        size="mini" 
                                        type="success" 
                                        icon="el-icon-connection" 
                                        circle 
                                        @@click="testMcpEndpoint(name, endpoint)"
                                        :loading="endpoint.testing"
                                        style="margin-right: 5px;"
                                        title="测试连接">
                                    </el-button>
                                    <el-button 
                                        size="mini" 
                                        type="primary" 
                                        icon="el-icon-edit" 
                                        circle 
                                        @@click="handleMcpEndpointEdit(name, endpoint)"
                                        style="margin-right: 5px;">
                                    </el-button>
                                    <el-button 
                                        size="mini" 
                                        type="danger" 
                                        icon="el-icon-delete" 
                                        circle 
                                        @@click="handleMcpEndpointRemove(name)">
                                    </el-button>
                                </div>
                            </div>
                        </div>
                        
                        <div class="mcp-endpoint-add" v-if="!mcpEndpointInputVisible">
                            <el-button class="button-new-endpoint" size="small" @@click="showMcpEndpointInput">+ 添加 MCP Endpoint</el-button>
                        </div>
                        
                        <div v-if="mcpEndpointInputVisible" class="mcp-endpoint-input-form">
                            <div class="mcp-endpoint-form-title">{{ mcpEndpointEditMode ? '编辑 MCP Endpoint' : '添加 MCP Endpoint' }}</div>
                            <el-input
                                ref="mcpEndpointNameInput"
                                v-model="mcpEndpointNameValue"
                                class="input-endpoint-name"
                                size="small"
                                placeholder="Endpoint 名称 (例如: mcp-server-NCF-7)"
                                style="margin-bottom: 10px; width: 100%">
                            </el-input>
                            
                            <el-input
                                ref="mcpEndpointUrlInput"
                                v-model="mcpEndpointUrlValue"
                                class="input-endpoint-url"
                                size="small"
                                placeholder="Endpoint URL (例如: http://localhost:5000/mcp/sse)"
                                style="margin-bottom: 10px; width: 100%">
                            </el-input>
                            
                            <div class="endpoint-input-actions">
                                <el-button size="small" type="primary" @@click="handleMcpEndpointInputConfirm">确认</el-button>
                                <el-button size="small" @@click="cancelMcpEndpointInput">取消</el-button>
                            </div>
                        </div>
                    </div>
                </el-form-item>
                
                <el-form-item label="备注" prop="description">
                    <el-input type="textarea" v-model="agentForm.description" :rows="4" placeholder="请填写(仅管理员可见)"></el-input>
                </el-form-item>
            </el-form>
        </div>
        @* 内容中固定的footer *@
        <div class="drawerRtl__footer text-right">
            <el-button :size="elSize" @@click="handleElVisibleClose('drawerAgent')">取消</el-button>
            <el-button :size="elSize" type="primary" @@click="handleElVisibleSubmit('drawerAgent')">确认</el-button>
        </div>
    </div>
</el-drawer>
@* 抽屉 远程 A2A 智能体管理 *@
<el-drawer :visible.sync="visible.drawerRemoteAgent" direction="rtl" :with-header="false" :wrapper-closable="false"
    :close-on-press-escape="false" size="900px">
    <div class="drawerRtl">
        <div class="drawerRtl__header">
            <div class="drawerRtl__header__title"><el-tag type="warning" size="mini">REMOTE A2A</el-tag> 远程智能体</div>
            <div class="drawerRtl__header__close" @@click="visible.drawerRemoteAgent = false">&times;</div>
        </div>
        <div class="drawerRtl__body">
            <div class="df-wn flex-ac flex-jsb" style="gap:10px;margin-bottom:14px;">
                <el-input v-model="remoteAgentQueryList.filter" size="small" placeholder="按名称筛选"
                    @@change="getRemoteAgentListData"></el-input>
                <div class="df-wn flex-ac" style="gap:8px;">
                    <el-button type="warning" plain size="small" icon="el-icon-connection" :loading="remoteAgentBatchTesting"
                        @@click="testAllRemoteAgents">测试全部</el-button>
                    <el-button type="primary" size="small" icon="el-icon-plus" @@click="openRemoteAgentEditor()">新增远程 A2A</el-button>
                </div>
            </div>
            <div class="form-help-text" style="margin-bottom:12px;">数据库仅保存密钥引用；实际令牌请在部署配置 <code>A2A:Secrets:密钥名</code> 中维护。</div>
            <el-table :data="remoteAgentList" max-height="560" style="width:100%;border:1px solid rgba(229,229,229,1);">
                <el-table-column label="类型" width="105">
                    <template slot-scope="{ row }"><el-tag type="warning" size="mini">A2A 远程</el-tag></template>
                </el-table-column>
                <el-table-column prop="name" label="智能体" width="145" show-overflow-tooltip></el-table-column>
                <el-table-column prop="agentCardUrl" label="Agent Card 地址" min-width="220" show-overflow-tooltip></el-table-column>
                <el-table-column label="连接" width="90">
                    <template slot-scope="{ row }">
                        <el-tag :type="row.connectionStatus === 1 ? 'success' : (row.connectionStatus === 2 ? 'danger' : 'info')" size="mini">{{ remoteConnectionStatusText(row.connectionStatus) }}</el-tag>
                    </template>
                </el-table-column>
                <el-table-column label="状态" width="75">
                    <template slot-scope="{ row }"><el-tag :type="row.enable ? 'success' : 'info'" size="mini">{{ row.enable ? '启用' : '停用' }}</el-tag></template>
                </el-table-column>
                <el-table-column label="操作" width="260" fixed="right">
                    <template slot-scope="{ row }">
                        <el-button type="primary" size="mini" @@click="openRemoteAgentEditor(row)">编辑</el-button>
                        <el-button size="mini" :loading="isRemoteAgentTesting(row.id)" :disabled="remoteAgentBatchTesting"
                            @@click="testRemoteAgent(row)">测试</el-button>
                        <el-button size="mini" @@click="setRemoteAgentEnable(row,!row.enable)">{{ row.enable ? '停用' : '启用' }}</el-button>
                        <el-button type="danger" size="mini" @@click="deleteRemoteAgent(row)">删除</el-button>
                    </template>
                </el-table-column>
            </el-table>
        </div>
    </div>
</el-drawer>
<el-dialog :visible.sync="visible.dialogRemoteAgentEditor" :title="remoteAgentForm.id ? '编辑远程 A2A 智能体' : '新增远程 A2A 智能体'" width="620px" :close-on-click-modal="false">
    <el-form v-if="visible.dialogRemoteAgentEditor" ref="remoteAgentELForm" :model="remoteAgentForm" :rules="remoteAgentFormRules" :size="elSize" label-width="150px">
        <el-form-item label="名称" prop="name"><el-input v-model="remoteAgentForm.name" placeholder="例如：外部研究助手"></el-input></el-form-item>
        <el-form-item label="类型"><el-tag type="warning">A2A 远程智能体</el-tag></el-form-item>
        <el-form-item label="Agent Card 地址" prop="agentCardUrl"><el-input v-model="remoteAgentForm.agentCardUrl" placeholder="https://host/.well-known/agent-card.json"></el-input></el-form-item>
        <el-form-item label="是否启用"><el-switch v-model="remoteAgentForm.enable"></el-switch></el-form-item>
        <el-form-item label="连接超时（秒）"><el-input-number v-model="remoteAgentForm.timeoutSeconds" :min="5" :max="600"></el-input-number></el-form-item>
        <el-form-item label="鉴权方式">
            <el-select v-model="remoteAgentForm.authenticationMode" style="width:100%;">
                <el-option label="无鉴权" :value="0"></el-option>
                <el-option label="Bearer Token" :value="1"></el-option>
                <el-option label="自定义请求头" :value="2"></el-option>
            </el-select>
        </el-form-item>
        <el-form-item v-if="remoteAgentForm.authenticationMode === 2" label="请求头名称"><el-input v-model="remoteAgentForm.authHeaderName" placeholder="例如 X-API-Key"></el-input></el-form-item>
        <el-form-item v-if="remoteAgentForm.authenticationMode !== 0" label="部署密钥名"><el-input v-model="remoteAgentForm.authSecretKey" placeholder="只填写密钥名，不填写令牌正文"></el-input></el-form-item>
        <el-form-item label="说明"><el-input v-model="remoteAgentForm.description" type="textarea" :rows="3" placeholder="可选，仅管理员可见"></el-input></el-form-item>
    </el-form>
    <span slot="footer">
        <el-button :size="elSize" @@click="closeRemoteAgentEditor">取消</el-button>
        <el-button :size="elSize" type="primary" @@click="saveRemoteAgent">保存</el-button>
    </span>
</el-dialog>
@* 抽屉 新增|编辑 组 *@
<el-drawer :visible.sync="visible.drawerGroup" direction="rtl" :with-header="false" :wrapper-closable="false"
    :close-on-press-escape="false" size="960px">
    <div class="drawerRtl">
        @* 内容中的头（包括标题和关闭图标） *@
        <div class="drawerRtl__header">
            <div class="drawerRtl__header__title">{{ groupForm.id ? '编辑组' : '新增组' }} </div>
            <div class="drawerRtl__header__close" @@click="handleElVisibleClose('drawerGroup')">&times;</div>
        </div>
        @* 内容中的主体内容 *@
        <div class="drawerRtl__body">
            <el-form v-if="visible.drawerGroup" ref="groupELForm" :model="groupForm" :rules="groupFormRules"
                :size="elSize" label-position="left" label-width="130px" class="drawerForm-container">
                <el-form-item label="组名称" prop="name">
                    <el-input v-model="groupForm.name" placeholder="请填写"></el-input>
                </el-form-item>
                <el-form-item label="是否启用" prop="enable">
                    <el-checkbox v-model="groupForm.enable">启用该组</el-checkbox>
                    <div class="form-help-text">新建组默认启用。停用后不会创建新任务，也不会作为 Workflow 节点使用。</div>
                </el-form-item>
                <el-form-item label="本地成员" prop="members">
                    <div class="groupFMB">
                        <div class="df-wn flex-ac flex-jsb" style="gap: 10px;margin-bottom: 10px;">
                            <div class="df-wn flex-ac" style="gap: 10px;">
                                <el-input v-model="groupAgentQueryList.filter" size="small"
                                    placeholder="请填写"></el-input>
                                <el-button size="small" icon="el-icon-search"
                                    @@click="handleFilterChange(groupAgentQueryList.filter,'groupAgent')">搜索</el-button>
                            </div>
                            <div class="groupFMB_filter_addBtn" @@click="handleElVisibleOpenBtn('dialogGroupAgent')">
                                新增智能体
                            </div>
                        </div>
                        <div class="df-wn flex-as flex-js" style="gap: 10px;margin-bottom: 10px;">
                            <span class="groupFMB_ma_label">已选择:</span>
                            <div class="groupFMB_ma_list">
                                <div class="df flex-ac flex-js" style="gap:10px">
                                    <div v-for="(item,index) in groupForm.members" :key="item.id"
                                        class="df-wn flex-ac groupFMB_ma_list_item">
                                        <el-tag type="primary" size="mini" style="margin-right:4px;">本地</el-tag>
                                        <span class="groupFMB_ma_list_item_text">{{ item.name }}</span>
                                        <i class="el-icon-close cursorPointer"
                                            @@click="groupMembersCancel(item,index)"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <el-table ref="groupAgentTable" key="groupAgentTable" :data="groupAgentList" max-height="447"
                            style="width: 100%;margin-bottom: 10px;border: 1px solid rgba(229, 229, 229, 1);"
                            @@selection-change="handleSelectionChange">
                            <el-table-column type="selection" width="30"></el-table-column>
                            <el-table-column prop="name" label="智能体名称" width="130"
                                show-overflow-tooltip></el-table-column>
                            <el-table-column prop="score" label="评分" width="100">
                            </el-table-column>
                            <el-table-column prop="description" label="描述" min-width="100">
                            </el-table-column>
                            <el-table-column fixed="right" label="操作" width="100">
                                <template slot-scope="{ row }">
                                    <el-button type="primary" size="small"
                                        @@click="handleEditDrawerOpenBtn('dialogGroupAgent',row)">编辑</el-button>
                                </template>
                            </el-table-column>
                        </el-table>
                        @* <el-pagination small layout="prev, pager, next" :total="groupAgentTotal"
                        @@current-change="getAgentListData($event,'groupAgent')"
                        @@prev-click="getAgentListData($event,'groupAgent')"
                        @@next-click="getAgentListData($event,'groupAgent')">
                        </el-pagination> *@
                    </div>
                </el-form-item>
                <el-form-item label="远程 A2A 成员">
                    <div class="groupFMB">
                        <div class="df-wn flex-ac flex-jsb" style="gap:10px;margin-bottom:10px;">
                            <div class="df-wn flex-ac" style="gap:10px;">
                                <el-input v-model="groupRemoteAgentQueryList.filter" size="small" placeholder="按名称筛选"
                                    @@change="getRemoteAgentListData('groupRemoteAgent')"></el-input>
                                <el-button size="small" icon="el-icon-search" @@click="getRemoteAgentListData('groupRemoteAgent')">搜索</el-button>
                            </div>
                            <el-button type="warning" plain size="small" icon="el-icon-connection" @@click="openRemoteAgentManager">管理远程 A2A</el-button>
                        </div>
                        <div class="df-wn flex-as flex-js" style="gap:10px;margin-bottom:10px;">
                            <span class="groupFMB_ma_label">已选择:</span>
                            <div class="groupFMB_ma_list">
                                <div class="df flex-ac flex-js" style="gap:10px">
                                    <div v-for="item in groupForm.remoteMembers" :key="'remote-'+item.id"
                                        class="df-wn flex-ac groupFMB_ma_list_item" style="border-color:#f59e0b;background:#fffbeb;">
                                        <el-tag type="warning" size="mini" style="margin-right:4px;">A2A</el-tag>
                                        <span class="groupFMB_ma_list_item_text">{{ item.name }}</span>
                                        <i class="el-icon-close cursorPointer" @@click="groupRemoteMembersCancel(item)"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <el-table ref="groupRemoteAgentTable" key="groupRemoteAgentTable" :data="groupRemoteAgentList" max-height="260"
                            style="width:100%;margin-bottom:8px;border:1px solid rgba(245,158,11,.35);"
                            @@selection-change="handleRemoteSelectionChange">
                            <el-table-column type="selection" width="36"></el-table-column>
                            <el-table-column label="类型" width="78"><template slot-scope="{ row }"><el-tag type="warning" size="mini">A2A</el-tag></template></el-table-column>
                            <el-table-column prop="name" label="智能体名称" width="150" show-overflow-tooltip></el-table-column>
                            <el-table-column prop="agentCardUrl" label="Agent Card 地址" min-width="190" show-overflow-tooltip></el-table-column>
                            <el-table-column label="连接" width="90"><template slot-scope="{ row }"><el-tag :type="row.connectionStatus === 1 ? 'success' : (row.connectionStatus === 2 ? 'danger' : 'info')" size="mini">{{ remoteConnectionStatusText(row.connectionStatus) }}</el-tag></template></el-table-column>
                        </el-table>
                        <div class="form-help-text">远程成员默认仅收到任务指令和当前轮的文本结论；不会收到工具调用、原始模型内容或完整历史。</div>
                    </div>
                </el-form-item>
                <el-form-item label="上下文共享">
                    <el-select v-model="groupForm.contextSharingMode" clearable placeholder="远程成员默认：指令 + 关键结论" style="width:100%;">
                        <el-option label="兼容旧组：完整历史（仅无远程成员）" :value="0"></el-option>
                        <el-option label="任务指令 + 当前轮关键结论" :value="1"></el-option>
                        <el-option label="仅任务指令" :value="2"></el-option>
                    </el-select>
                    <div class="form-help-text">混合群组会采用所有远程成员要求中最严格的策略；本地群未设置时保持升级前行为。</div>
                </el-form-item>
                <el-form-item label="群主" prop="adminAgentTemplateId">
                    @* @change="handleChange($event,'')" *@
                    <load-more-select v-model="groupForm.adminAgentTemplateId" service-type='agent' placeholder="请选择" />
                </el-form-item>
                <el-form-item label="对接人" prop="enterAgentTemplateId">
                    @* @change="handleChange($event,'')" *@
                    <load-more-select v-model="groupForm.enterAgentTemplateId" service-type='agent' placeholder="请选择" />
                </el-form-item>
                <el-form-item label="说明">
                    <el-input type="textarea" v-model="groupForm.description" :rows="4" placeholder="请填写"></el-input>
                </el-form-item>
            </el-form>
        </div>
        @* 内容中固定的footer *@
        <div class="drawerRtl__footer text-right">
            <el-button :size="elSize" @@click="handleElVisibleClose('drawerGroup')">取消</el-button>
            <el-button :size="elSize" type="primary" @@click="handleElVisibleSubmit('drawerGroup')">确认</el-button>
        </div>
    </div>
</el-drawer>
@* 抽屉 启动 组 *@
<el-drawer :visible.sync="visible.drawerGroupStart" direction="rtl" :with-header="false" :wrapper-closable="false"
    :close-on-press-escape="false" size="960px">
    <div class="drawerRtl">
        @* 内容中的头（包括标题和关闭图标） *@
        <div class="drawerRtl__header">
            <div class="drawerRtl__header__title">启动群组</div>
            <div class="drawerRtl__header__close" @@click="handleElVisibleClose('drawerGroupStart')">&times;</div>
        </div>
        @* 内容中的主体内容 *@
        <div class="drawerRtl__body">
            <el-form v-if="visible.drawerGroupStart" ref="groupStartELForm" :model="groupStartForm"
                :rules="groupStartFormRules" :size="elSize" label-position="left" label-width="130px"
                class="drawerForm-container">
                <el-form-item label="选择群组" prop="groupName">
                    <el-input v-model="groupStartForm.groupName" disabled placeholder="请填写"></el-input>
                </el-form-item>
                <el-form-item label="任务标题" prop="name">
                    <el-input v-model="groupStartForm.name" placeholder="请填写"></el-input>
                </el-form-item>
                <el-form-item label="选择模型" prop="aiModelId">
                    @* @change="handleChange($event,'')" *@
                    <load-more-select v-model="groupStartForm.aiModelId" service-type="model" direction="vertical"
                        placeholder="请选择" />
                </el-form-item>
                <el-form-item label="个性化智能体" prop="personality">
                    <el-checkbox v-model="groupStartForm.personality">采用个性化参数运行智能体</el-checkbox>
                </el-form-item>
                <el-form-item label="可提及的组员">
                    <div class="groupStartMentions" v-loading="groupStartParticipantLoading">
                        <div class="form-help-text">点击组员即可在下方任务描述的当前光标位置插入提及。</div>
                        <div v-if="groupStartParticipants.length" class="groupStartMentions__list">
                            <div v-for="participant in groupStartParticipants" :key="participant.participantKey"
                                class="groupStartMentions__participant">
                                <el-button type="primary" plain size="small" class="groupStartMentions__item"
                                    @@click="insertGroupStartMention(participant)">
                                    <span class="groupStartMentions__name">@@{{ participant.name }}</span>
                                    <el-tag v-if="participant.agentKind === 'RemoteA2A'" type="warning" size="mini">A2A</el-tag>
                                    <el-tag v-for="roleName in participant.roles" :key="participant.participantKey + '-' + roleName"
                                        type="info" effect="plain" size="mini">{{ roleName }}</el-tag>
                                </el-button>
                                <div class="groupStartMentions__details">
                                    <template v-if="participant.agentKind === 'RemoteA2A'">
                                        <el-tag :type="remoteParticipantAvailabilityType(participant)" size="mini"
                                            :title="participant.lastHealthCheckMessage || ''">{{ remoteParticipantAvailabilityText(participant) }}</el-tag>
                                        <span>超时 {{ participant.timeoutSeconds || 60 }} 秒</span>
                                        <span v-if="participant.lastHealthCheckAt">检测 {{ participant.lastHealthCheckAt | showFormatDate }}</span>
                                        <el-button type="text" size="mini" :loading="isRemoteAgentTesting(participant.id)"
                                            @@click.stop="testGroupStartRemoteAgent(participant)">测试</el-button>
                                    </template>
                                    <template v-else>
                                        <el-tag :type="participant.enable ? 'success' : 'info'" size="mini">{{ participant.enable ? '本地已启用' : '本地已停用' }}</el-tag>
                                    </template>
                                    <span v-if="participant.description" class="groupStartMentions__description text-ellipsis" :title="participant.description">{{ participant.description }}</span>
                                </div>
                            </div>
                        </div>
                        <div v-else class="groupStartMentions__empty">当前群组没有可提及的组员。</div>
                    </div>
                </el-form-item>
                <el-form-item label="任务描述" prop="promptCommand">
                    <el-input ref="groupStartPromptCommand" type="textarea" v-model="groupStartForm.promptCommand" :rows="8"
                        placeholder="我能帮你做什么" @@focus="rememberGroupStartPromptCaret"
                        @@click.native="rememberGroupStartPromptCaret" @@keyup.native="rememberGroupStartPromptCaret"
                        @@select.native="rememberGroupStartPromptCaret"></el-input>
                </el-form-item>
                <el-form-item label="说明" prop="description">
                    <el-input type="textarea" v-model="groupStartForm.description" :rows="8"
                        placeholder="请填写"></el-input>
                </el-form-item>
            </el-form>
        </div>
        @* 内容中固定的footer *@
        <div class="drawerRtl__footer text-right">
            <el-button :size="elSize" @@click="handleElVisibleClose('drawerGroupStart')">取消</el-button>
            <el-button :size="elSize" type="primary" @@click="handleElVisibleSubmit('drawerGroupStart')">确认</el-button>
        </div>
    </div>
</el-drawer>
@* Dialog 智能体 新增 *@
<el-dialog :title="agentForm.id ? '编辑智能体' : '新增智能体'" :visible.sync="visible.dialogGroupAgent" :show-close="false"
    :close-on-click-modal="false" :close-on-press-escape="false">
    <el-form v-if="visible.dialogGroupAgent" ref="agentELForm" :model="agentForm" :rules="agentFormRules" :size="elSize"
        label-position="left" label-width="130px" class="drawerForm-container">
        <el-form-item label="智能体名称" prop="name">
            <el-input v-model="agentForm.name" placeholder="请填写"></el-input>
        </el-form-item>
        <el-form-item label="SystemMessage" required>
            <el-radio-group v-model="agentForm.systemMessageType" @@change="handleSystemMessageTypeChange">
                <el-radio label="1" border>自选</el-radio>
                <el-radio label="2" border>手动</el-radio>
            </el-radio-group>
        </el-form-item>
        <el-form-item v-show="agentForm.systemMessageType === '1'" label="自选" prop="systemMessage">
            <load-more-select v-model="agentForm.systemMessage" service-type="systemMessage" direction="vertical"
                placeholder="请选择" @@options-loaded="handleSystemMessageOptionsLoaded" />
        </el-form-item>
        <el-form-item v-if="agentForm.systemMessageType === '2'" label="手动输入" prop="systemMessage">
            <el-input v-model="agentForm.systemMessage" placeholder="请填写"></el-input>
        </el-form-item>
        <el-form-item label="是否启用" prop="enable">
            <el-checkbox v-model="agentForm.enable">启用智能体</el-checkbox>
        </el-form-item>
        <el-form-item label="绑定知识库" prop="knowledgeBaseId">
            <el-select v-model="agentForm.knowledgeBaseId" clearable filterable style="width:100%" placeholder="不绑定知识库">
                <el-option v-for="item in knowledgeBaseOptions" :key="item.id"
                    :label="getKnowledgeBaseOptionLabel(item)"
                    :value="item.id" :disabled="!item.isEmbedded"></el-option>
            </el-select>
            <div v-if="agentForm.knowledgeBaseId" class="knowledgeBase-shortcuts">
                <el-tag size="mini" :type="getKnowledgeBaseBindingInfo(agentForm.knowledgeBaseId).type">
                    {{ getKnowledgeBaseBindingInfo(agentForm.knowledgeBaseId).text }}
                </el-tag>
                <el-button size="mini" type="primary" plain icon="el-icon-folder-opened"
                    @@click="openKnowledgeBase(agentForm.knowledgeBaseId, 'materials')">管理资料</el-button>
                <el-button size="mini" plain icon="el-icon-setting"
                    @@click="openKnowledgeBase(agentForm.knowledgeBaseId, 'edit')">编辑设置</el-button>
            </div>
        </el-form-item>
        <el-form-item label="说明" prop="description">
            <el-input type="textarea" v-model="agentForm.description" :rows="4" placeholder="请填写"></el-input>
        </el-form-item>
        <el-form-item label="外接平台" prop="hookRobotType">
            <el-select v-model="agentForm.hookRobotType" style="width:100%" placeholder="请选择">
                <el-option label="None" :value="0"></el-option>
                <el-option label="WeChatMp" :value="1"></el-option>
                <el-option label="WeChatWorkRobot" :value="2"></el-option>
            </el-select>
        </el-form-item>
        <el-form-item label="外接平台参数" prop="hookRobotParameter">
            <el-input v-model="agentForm.hookRobotParameter" placeholder="请填写" :disabled="agentForm.hookRobotType === 0"></el-input>
        </el-form-item>
        <el-form-item label="Agent 头像" prop="avastar">
            <div class="df-wn flex-ac flex-js agentForm-agentAvatarBox">
                <div v-for="(aitem,aindex) in agentAvatarList" :key="aindex"
                    class="df-wn flex-ac flex-jc agentAvatarBoxItem"
                    :class="{'agentAvatarBoxItem-active':aitem === agentForm.avastar}"
                    @@click="handleFormValidateField('agentELForm','agentForm','avastar',aitem)">
                    <img :src="aitem" alt="">
                </div>
            </div>
        </el-form-item>
        <el-form-item label="Function Calls" prop="functionCallNames">
            <div class="function-call-container">
                <div style="margin-bottom: 8px;">
                    <el-switch
                        v-model="agentAutoAttachXncf"
                        @@change="handleAutoAttachXncfChange"
                        active-text="自动附加所有 XNCF 功能插件"
                        inactive-text="手动选择">
                    </el-switch>
                    <el-tooltip content="开启后将自动附加所有已注册的 XNCF 功能插件，使智能体能自动识别并触发对应模块的功能" placement="top">
                        <i class="el-icon-question" style="margin-left: 6px; color: #909399;"></i>
                    </el-tooltip>
                </div>
                <div class="function-call-tags">
                    <el-tag
                        v-for="tag in agentForm.functionCallNames ? agentForm.functionCallNames.split(',').filter(x => x) : []"
                        :key="tag"
                        closable
                        :disable-transitions="false"
                        @@close="handleFunctionCallClose(tag)"
                        class="function-call-tag">
                        {{tag}}
                    </el-tag>
                    <el-input
                        v-if="functionCallInputVisible"
                        ref="functionCallInput"
                        v-model="functionCallInputValue"
                        class="input-new-tag"
                        size="small"
                        placeholder="可输入 Plugin 类名，或带有命名空间的完整名称"
                        @@keyup.enter.native="handleFunctionCallInputConfirm"
                        @@blur="handleFunctionCallInputConfirm">
                    </el-input>
                    <el-button v-else class="button-new-tag" size="small" @@click="showFunctionCallInput">+ 添加</el-button>
                </div>
                
                <div class="plugin-types-container" v-if="availablePluginTypes.length">
                    <div class="plugin-types-title">可用插件类型:</div>
                    <div class="plugin-types-list">
                        <el-button
                            v-for="pluginType in availablePluginTypes"
                            :key="pluginType"
                            size="small"
                            type="info"
                            plain
                            class="plugin-type-btn"
                            @@click="handleAddPluginType(pluginType)">
                            {{ pluginType }}
                        </el-button>
                    </div>
                </div>
            </div>
        </el-form-item>
        
        <el-form-item label="MCP Endpoints" prop="mcpEndpoints">
            <div class="mcp-endpoints-container">
                <div class="mcp-endpoints-list">
                    <div v-for="(endpoint, name) in parsedMcpEndpoints" :key="name" class="mcp-endpoint-item">
                        <div class="mcp-endpoint-info">
                            <span class="mcp-endpoint-name">{{name}}</span>
                            <span class="mcp-endpoint-url">{{endpoint.url}}</span>
                            <div v-if="endpoint.testResult && endpoint.testResult.success" class="mcp-endpoint-test-result">
                                <div class="test-status success">连接成功</div>
                                <el-button size="mini" type="primary" plain @@click="showMcpToolsDialog(endpoint)">
                                    查看工具列表 ({{endpoint.testResult.tools ? endpoint.testResult.tools.length : 0}})
                                </el-button>
                            </div>
                            <div v-else-if="endpoint.testResult && !endpoint.testResult.success" class="mcp-endpoint-test-result">
                                <div class="test-status failed">连接失败: {{endpoint.testResult.message}}</div>
                            </div>
                        </div>
                        <div class="mcp-endpoint-actions">
                            <el-button 
                                size="mini" 
                                type="success" 
                                icon="el-icon-connection" 
                                circle 
                                @@click="testMcpEndpoint(name, endpoint)"
                                :loading="endpoint.testing"
                                style="margin-right: 5px;"
                                title="测试连接">
                            </el-button>
                            <el-button 
                                size="mini" 
                                type="primary" 
                                icon="el-icon-edit" 
                                circle 
                                @@click="handleMcpEndpointEdit(name, endpoint)"
                                style="margin-right: 5px;">
                            </el-button>
                            <el-button 
                                size="mini" 
                                type="danger" 
                                icon="el-icon-delete" 
                                circle 
                                @@click="handleMcpEndpointRemove(name)">
                            </el-button>
                        </div>
                    </div>
                </div>
                
                <div class="mcp-endpoint-add" v-if="!mcpEndpointInputVisible">
                    <el-button class="button-new-endpoint" size="small" @@click="showMcpEndpointInput">+ 添加 MCP Endpoint</el-button>
                </div>
                
                <div v-if="mcpEndpointInputVisible" class="mcp-endpoint-input-form">
                    <div class="mcp-endpoint-form-title">{{ mcpEndpointEditMode ? '编辑 MCP Endpoint' : '添加 MCP Endpoint' }}</div>
                    <el-input
                        ref="mcpEndpointNameInput"
                        v-model="mcpEndpointNameValue"
                        class="input-endpoint-name"
                        size="small"
                        placeholder="Endpoint 名称 (例如: mcp-server-NCF-7)"
                        style="margin-bottom: 10px; width: 100%">
                    </el-input>
                    
                    <el-input
                        ref="mcpEndpointUrlInput"
                        v-model="mcpEndpointUrlValue"
                        class="input-endpoint-url"
                        size="small"
                        placeholder="Endpoint URL (例如: http://localhost:5000/mcp/sse)"
                        style="margin-bottom: 10px; width: 100%">
                    </el-input>
                    
                    <div class="endpoint-input-actions">
                        <el-button size="small" type="primary" @@click="handleMcpEndpointInputConfirm">确认</el-button>
                        <el-button size="small" @@click="cancelMcpEndpointInput">取消</el-button>
                    </div>
                </div>
            </div>
        </el-form-item>
    </el-form>
    <div slot="footer" class="dialog-footer">
        <el-button @@click="handleElVisibleClose('dialogGroupAgent')">取 消</el-button>
        <el-button type="primary" @@click="handleElVisibleSubmit('dialogGroupAgent')">确 定</el-button>
    </div>
</el-dialog>
@* Dialog Carousel 智能体 参数列表 *@
<el-dialog title="智能体参数" :visible.sync="visible.dialogAgentParameter" :show-close="false" :close-on-click-modal="false"
    :close-on-press-escape="false" width="80%">
    <div class="dialog-agentParameters">
        <el-tabs v-model="agentParameterTabsValue">
            <el-tab-pane v-for="(item, index) in agentParameterList" :key="item.name" :label="item.name" :name="index">
                <div class="df-wn flex-as flex-jsb agentParameters-head">
                        <div class="df-wn flex-ac flex-js headavatar">
                            <div class="df-wn flex-ac flex-jc avatarBox">
                                <img :src="item.avastar | showAvatar" alt="">
                            </div>
                            <div class="namebox">
                                <div class="name text-ellipsis">
                                    {{ item.name }}
                                </div>
                                <div class="description text-ellipsis-3line">
                                    {{ item.description }}
                                </div>
                            </div>
                            <div class="agentParameters-head-actions">
                                <el-tag v-if="item.agentKind === 'RemoteA2A'" type="warning" size="mini">远程 A2A</el-tag>
                                <el-button v-else-if="item.id" type="primary" plain size="mini" icon="el-icon-edit"
                                    @@click="openAgentParameterEditor(item)">快速编辑</el-button>
                            </div>
                        </div>
                        <div class="df-wn flex-dc flex-jsb headitem">
                            <div class="df-wn flex-ac flex-js itemBox">
                                <span class="label">靶场:</span>
                                <span class="value">
                                    {{ handlePromptShowName('1',item) }}
                                </span>
                            </div>
                            <div class="df-wn flex-ac flex-js itemBox">
                                <span class="label">靶道:</span>
                                <span class="value">
                                    {{ handlePromptShowName('2',item) }}
                                </span>
                            </div>
                            <div class="df-wn flex-ac flex-js itemBox">
                                <span class="label">模型:</span>
                                <span class="value">{{ item.aiModelDto ? item.aiModelDto.deploymentName : '' }}</span>
                            </div>
                        </div>
                        <div class="df-wn flex-dc flex-jsb headitem">
                            <div class="df-wn flex-ac flex-js itemBox">
                                <span class="label">Top_p:</span>
                                <span class="value">{{ item.promptItemDto ?item.promptItemDto.topP : '' }} </span>
                            </div>
                            <div class="df-wn flex-ac flex-js itemBox">
                                <span class="label">MaxToken:</span>
                                <span class="value">{{ item.promptItemDto ?item.promptItemDto.maxToken : '' }} </span>
                            </div>
                            <div class="df-wn flex-ac flex-js itemBox">
                                <span class="label">Presence_penalty:</span>
                                <span class="value">{{ item.promptItemDto ?item.promptItemDto.presencePenalty : '' }} </span>
                            </div>
                        </div>
                        <div class="df-wn flex-dc flex-jsb headitem">
                            <div class="df-wn flex-ac flex-js itemBox">
                                <span class="label">Temperature:</span>
                                <span class="value">{{ item.promptItemDto ?item.promptItemDto.temperature : '' }} </span>
                            </div>
                            <div class="df-wn flex-ac flex-js itemBox">
                                <span class="label">Frequeny_penalty:</span>
                                <span class="value">{{ item.promptItemDto ?item.promptItemDto.frequencyPenalty : '' }} </span>
                            </div>
                            <div class="df-wn flex-ac flex-js itemBox">
                                <span class="label">StopSequences:</span>
                                <span class="value">{{ item.promptItemDto ?item.promptItemDto.stopSequences : '' }} </span>
                            </div>
                        </div>
                </div>
                <div class="df-wn flex-as agentParameters-main">
                    <div class="promptContent">
                        <div class="prompt-title">
                            Prompt
                        </div>
                        <div class="prompt-value" style="white-space: pre-wrap;">
                            {{ item.promptItemDto ? item.promptItemDto.content : (item.systemMessage || '') }}
                        </div>
                    </div>
                    <div class="promptResult">
                        <div class="prompt-title">
                            <div>
                                <img src="~/images/AgentsManager/prompt_selectPrompt.svg" alt="" style="width: 15px;height:15px;" />
                                <span class="label">靶场:</span>
                                <span class="value">{{ item.promptRangeDto ? item.promptRangeDto.alias : '--' }}</span>
                            </div>
                            <div>
                                <span class="label">靶道:</span>
                                <span class="value">{{ item.promptItemDto ? item.promptItemDto.fullVersion : '--' }}</span>
                            </div>
                            <div>
                                <span class="label">瞄准:</span>
                                <span class="value">{{ item.promptItemDto ? (item.promptItemDto.nickName || '--') : '--' }}</span>
                            </div>
                            <div>
                                <span class="label">平均分:</span>
                                <span class="value">{{ item.promptItemDto ? scoreFormatter(item.promptItemDto.evalAvgScore) : '--' }}</span>
                            </div>
                            <div>
                                <span class="label">最高分:</span>
                                <span class="value">{{ item.promptItemDto ? scoreFormatter(item.promptItemDto.evalMaxScore) : '--' }}</span>
                            </div>
                        </div>
                        <div class="prompt-value">
                            @* <i class="far fa-bullseye-arrow" ></i> *@
                            <div v-for="(oitem,oindex) in item.outputList" :key="oitem.id" class="contentBoxItem">
                    <div class="promptResult_Item_Title">
                        <div class="promptReultTimeArea">
                            <span>{{oitem.addTime}} [耗时(毫秒):{{oitem.costTime}}]</span>
                        </div>
                        <div class="copyButtonArea">
                            <a href="javascript:void(0);" @@click="copyText('2',oitem)" title="复制带格式的 HTML 代码"><i class="fa fa-copy"></i> HTML</a>
                            <a href="javascript:void(0);" @@click="copyText('1',oitem)" title="复制原始内容（例如将复制 markdown 标记）"><i class="fa fa-copy"></i> 原始</a>
                        </div>
                    </div>
                    <task-html-renderer class="contentRow" :content="oitem.resultStringHtml" />
                </div>
                        </div>
                    </div>
                </div>
            </el-tab-pane>
        </el-tabs>
    </div>
    <div slot="footer" class="dialog-footer">
        <el-button type="primary" @@click="handleElVisibleClose('dialogAgentParameter')">关 闭</el-button>
    </div>
</el-dialog>
@* Dialog 任务描述 *@
<el-dialog title="任务描述" :visible.sync="visible.dialogTaskDescription" :show-close="false" :close-on-click-modal="false"
    :close-on-press-escape="false">
    <div class="dialog-describeContent">
        {{ describeContent }}
    </div>
    <div slot="footer" class="dialog-footer">
        <el-button type="text" @@click="taskDescriptionCopy">
            <i class="far fa-clone"></i>
            一键复制
        </el-button>
        <el-button @@click="handleElVisibleClose('dialogTaskDescription')">关 闭</el-button>
    </div>
</el-dialog>
@* Dialog 任务评价 *@
<el-dialog title="任务评价" :visible.sync="visible.dialogTaskEvaluation" :show-close="false" :close-on-click-modal="false"
    :close-on-press-escape="false">
    <el-form v-if="visible.dialogTaskEvaluation" ref="evaluationELForm" :model="evaluationForm"
        :rules="evaluationFormRules" :size="elSize" label-position="top" label-width="130px"
        class="drawerForm-container">
        <el-form-item label="请输入评分(0-10分)" prop="score">
            @* <el-input v-model="evaluationForm.score" placeholder="请填写"
            @@input="handleInputNum($event,'evaluationForm.score')"></el-input> *@
            <el-slider v-model="evaluationForm.score" min="0" max="10" step="0.1"></el-slider>
        </el-form-item>
        <el-form-item label="请输入评价" prop="evaluation">
            <el-input type="textarea" v-model="evaluationForm.evaluation" :rows="4" placeholder="请填写"></el-input>
        </el-form-item>
    </el-form>
    <div slot="footer" class="dialog-footer">
        <el-button type="primary" @@click="handleElVisibleSubmit('dialogTaskEvaluation')">确 定</el-button>
        <el-button @@click="handleElVisibleClose('dialogTaskEvaluation')">取 消</el-button>
    </div>
</el-dialog>
@* Dialog MCP工具列表 *@
<el-dialog title="MCP 工具列表" :visible.sync="visible.dialogMcpTools" :append-to-body="true" width="80%" :show-close="true" :destroy-on-close="false" center>
    <div v-if="currentMcpTools && currentMcpTools.length > 0">
        <el-table :data="currentMcpTools" style="width: 100%">
            <el-table-column prop="name" label="工具名称" width="180"></el-table-column>
            <el-table-column prop="description" label="描述"></el-table-column>
            <el-table-column label="参数" width="300">
                <template slot-scope="scope">
                    <div v-if="scope.row.parameters && scope.row.parameters.length > 0">
                        <div v-for="param in scope.row.parameters" :key="param.name" class="param-item-table">
                            <strong>{{param.name}}</strong>: {{param.description}}
                        </div>
                    </div>
                    <span v-else>无参数</span>
                </template>
            </el-table-column>
        </el-table>
    </div>
    <div v-else class="empty-tools">
        <div class="empty-text">没有可用的工具</div>
    </div>
    <div class="dialog-footer" slot="footer">
        <el-button type="primary" @@click="visible.dialogMcpTools = false">关闭</el-button>
    </div>
</el-dialog>
@* Dialog 将本地 Agent 发布为标准 A2A 服务 *@
<el-dialog title="发布本地 Agent 为 A2A 服务" :visible.sync="visible.dialogPublishedA2A" width="720px"
    :show-close="false" :close-on-click-modal="false" :close-on-press-escape="false">
    <el-alert type="warning" :closable="false" title="A2A Agent Card 仅公开名称、描述和技能；不会公开 Prompt、密钥或内部工具信息。" show-icon></el-alert>
    <el-alert v-if="publishedA2AForm.enable" type="warning" :closable="false" show-icon style="margin-top:12px;"
        title="对外服务已启用：通过鉴权的外部系统可以调用此 Agent。请确认 Prompt、知识库和回复内容均允许对外共享，并通过 HTTPS、网关限流和监控控制调用范围与模型成本。"></el-alert>
    <el-alert v-if="publishedA2AForm.enable && publishedA2AForm.authenticationMode === 0" type="error" :closable="false" show-icon style="margin-top:12px;"
        title="当前未启用入站鉴权。请仅在隔离、受控网络中使用；公网或跨组织调用必须改用 Bearer Token 或自定义请求头。"></el-alert>
    <el-alert v-if="publishedA2AForm.enable && publishedA2AForm.allowFunctionCalls" type="error" :closable="false" show-icon style="margin-top:12px;"
        title="本地工具调用已开放。外部请求可能间接触发 Function / MCP 的读写或外部访问；请只开放最小权限工具并仅信任明确的调用方。"></el-alert>
    <el-form v-if="visible.dialogPublishedA2A" ref="publishedA2AELForm" :model="publishedA2AForm" :rules="publishedA2AFormRules"
        :size="elSize" label-position="left" label-width="150px" style="margin-top:20px;">
        <el-form-item label="启用对外服务">
            <el-switch v-model="publishedA2AForm.enable" active-text="允许 A2A 调用" inactive-text="仅保存配置"></el-switch>
        </el-form-item>
        <el-form-item label="公开标识" prop="publicAgentKey">
            <el-input v-model="publishedA2AForm.publicAgentKey" placeholder="例如 research-agent"></el-input>
            <div class="form-help-text">只允许小写字母、数字和连字符；地址在启用后保持稳定。</div>
        </el-form-item>
        <el-form-item label="Agent Card 名称">
            <el-input v-model="publishedA2AForm.cardName" placeholder="留空则使用本地 Agent 名称"></el-input>
        </el-form-item>
        <el-form-item label="公开描述">
            <el-input type="textarea" v-model="publishedA2AForm.cardDescription" :rows="3" placeholder="供远程系统选择 Agent 使用；不要填写 Prompt 或内部信息"></el-input>
        </el-form-item>
        <el-form-item label="技能标识 / 名称">
            <div style="display:flex;gap:8px;">
                <el-input v-model="publishedA2AForm.skillId" placeholder="chat" style="width:35%;"></el-input>
                <el-input v-model="publishedA2AForm.skillName" placeholder="留空则使用 Card 名称"></el-input>
            </div>
        </el-form-item>
        <el-form-item label="技能公开描述">
            <el-input type="textarea" v-model="publishedA2AForm.skillDescription" :rows="2" placeholder="留空则使用公开描述"></el-input>
        </el-form-item>
        <el-form-item label="入站鉴权">
            <el-select v-model="publishedA2AForm.authenticationMode" style="width:100%;">
                <el-option label="无（仅适合受控网络）" :value="0"></el-option>
                <el-option label="Bearer Token" :value="1"></el-option>
                <el-option label="自定义请求头" :value="2"></el-option>
            </el-select>
        </el-form-item>
        <el-form-item v-if="publishedA2AForm.authenticationMode === 2" label="请求头名称">
            <el-input v-model="publishedA2AForm.authHeaderName" placeholder="例如 X-A2A-Token"></el-input>
        </el-form-item>
        <el-form-item v-if="publishedA2AForm.authenticationMode !== 0" label="部署密钥名">
            <el-input v-model="publishedA2AForm.authSecretKey" placeholder="例如 partner-ncf"></el-input>
            <div class="form-help-text">令牌正文请部署在 A2A:InboundSecrets:{{ publishedA2AForm.authSecretKey || '密钥名' }}，不会保存到数据库。</div>
        </el-form-item>
        <el-form-item label="最大输入字符数">
            <el-input-number v-model="publishedA2AForm.maxInputCharacters" :min="512" :max="100000" :step="1000"></el-input-number>
        </el-form-item>
        <el-form-item label="允许本地工具调用">
            <el-switch v-model="publishedA2AForm.allowFunctionCalls" active-text="显式允许" inactive-text="安全默认关闭"></el-switch>
            <div class="form-help-text" style="color:#d97706;">开启后，外部请求可能间接触发该本地 Agent 已配置的 Function / MCP 工具，请只对受信任的调用方开放。</div>
        </el-form-item>
        <el-form-item v-if="publishedA2AForm.agentCardUrl" label="Agent Card 地址">
            <el-input :value="publishedA2AForm.agentCardUrl" readonly>
                <el-button slot="append" icon="el-icon-document-copy" @@click="copyPublishedA2AUrl">复制</el-button>
            </el-input>
        </el-form-item>
    </el-form>
    <div slot="footer" class="dialog-footer">
        <el-button @@click="closePublishedA2AEditor">关 闭</el-button>
        <el-button type="primary" @@click="savePublishedA2A">保 存</el-button>
    </div>
</el-dialog>
@section scripts {
    <partial name="~/Areas/Admin/Pages/Shared/_LocalizationScripts.cshtml" />
    <script src="~/js/AgentsManager/lib/axios.min.js"></script>
    <script src="~/js/PromptRange/lib/marked.min.js"></script>
    <script type="module" src="~/js/AgentsManager/three-loader.js"></script>
}
