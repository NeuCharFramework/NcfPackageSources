@* Start group drawer. *@
<el-drawer :visible.sync="visible.drawerGroupStart" direction="rtl" :with-header="false" :wrapper-closable="false"
    :close-on-press-escape="false" size="960px">
    <div class="drawerRtl">
        @* Content header, including the title and close icon. *@
        <div class="drawerRtl__header">
            <div class="drawerRtl__header__title">{{ncfST('Frontend.AgentsManager.StartGroup')}}</div>
            <div class="drawerRtl__header__close" @@click="handleElVisibleClose('drawerGroupStart')">&times;</div>
        </div>
        @* Main content area. *@
        <div class="drawerRtl__body">
            <el-form v-if="visible.drawerGroupStart" ref="groupStartELForm" :model="groupStartForm"
                :rules="groupStartFormRules" :size="elSize" label-position="left" label-width="130px"
                class="drawerForm-container">
                <el-form-item :label="ncfST('Frontend.AgentsManager.SelectGroup')" prop="groupName">
                    <el-input v-model="groupStartForm.groupName" disabled :placeholder="ncfST('Frontend.AgentsManager.PleaseFillIn')"></el-input>
                </el-form-item>
                <el-form-item :label="ncfST('Frontend.AgentsManager.TaskTitle')" prop="name">
                    <el-input v-model="groupStartForm.name" :placeholder="ncfST('Frontend.AgentsManager.PleaseFillIn')"></el-input>
                </el-form-item>
                <el-form-item :label="ncfST('Frontend.AgentsManager.SelectModel')" prop="aiModelId">
                    @* @change="handleChange($event,'')" *@
                    <load-more-select v-model="groupStartForm.aiModelId" service-type="model" :chat-only="true" direction="vertical"
                        :placeholder="ncfST('Frontend.AgentsManager.SelectAlternate')" />
                </el-form-item>
                <el-form-item :label="ncfST('Frontend.AgentsManager.PersonalizedAgent')" prop="personality">
                    <el-checkbox v-model="groupStartForm.personality">{{ncfST('Frontend.AgentsManager.RunAgentWithPersonalizedParameters')}}</el-checkbox>
                </el-form-item>
                <el-form-item :label="ncfST('Frontend.AgentsManager.ToolCallApproval')" prop="requireHumanApproval">
                    <el-checkbox v-model="groupStartForm.requireHumanApproval">{{ ncfST('Frontend.AgentsManager.CompatibilitySwitchRequireApprovalBeforeEveryToolCall') }}</el-checkbox>
                    <div class="form-help-text">{{ ncfST('Frontend.AgentsManager.WhenEnabledThisOverridesTheMorePermissiveToolPermissionsBelowNewConfigurations') }}</div>
                </el-form-item>
                <el-form-item :label="ncfST('Frontend.AgentsManager.HILLevel')" prop="humanInTheLoopLevel">
                    <el-select v-model="groupStartForm.humanInTheLoopLevel" style="width:100%;">
                        <el-option :label="ncfST('Frontend.AgentsManager.LZeroFullyAutomaticPluginsMCPExecuteAutomatically')" :value="0"></el-option>
                        <el-option :label="ncfST('Frontend.AgentsManager.LOneRiskBasedApprovalMCPDefaultApproval')" :value="1"></el-option>
                        <el-option :label="ncfST('Frontend.AgentsManager.LTwoToolApprovalConfirmEveryToolFirst')" :value="2"></el-option>
                        <el-option :label="ncfST('Frontend.AgentsManager.LThreeHumanParticipantToolApproval')" :value="3"></el-option>
                    </el-select>
                    <div class="form-help-text">{{ ncfST('Frontend.AgentsManager.WhenAGroupHasHumanMembersItPausesForATextReply') }}</div>
                </el-form-item>
                <el-form-item label="Plugin tool permissions" prop="pluginToolPermission">
                    <el-select v-model="groupStartForm.pluginToolPermission" style="width:100%;">
                        <el-option label="Inherit HIL level" :value="0"></el-option>
                        <el-option label="Automatic execution" :value="1"></el-option>
                        <el-option label="Approval before execution" :value="2"></el-option>
                        <el-option label="Prohibited" :value="3"></el-option>
                    </el-select>
                </el-form-item>
                <el-form-item :label="ncfST('Frontend.AgentsManager.MCPToolPermissions')" prop="mcpToolPermission">
                    <el-select v-model="groupStartForm.mcpToolPermission" style="width:100%;">
                        <el-option label="Inherit HIL level" :value="0"></el-option>
                        <el-option label="Automatic execution" :value="1"></el-option>
                        <el-option label="Approval before execution" :value="2"></el-option>
                        <el-option label="Prohibited" :value="3"></el-option>
                    </el-select>
                </el-form-item>
                <el-form-item v-if="groupStartParticipants.some(participant => participant.agentKind === 'Human')"
                              :label="ncfST('Frontend.AgentsManager.HumanParticipant')"
                              prop="includeHumanParticipant">
                    <el-switch v-model="groupStartForm.includeHumanParticipant"
                               :disabled="true"
                               @@change="markGroupStartHumanParticipantTouched"
                               :active-text="ncfST('Frontend.AgentsManager.AddAHumanTextParticipant')"
                               :inactive-text="ncfST('Frontend.AgentsManager.LoadingGroupConfiguration')"></el-switch>
                </el-form-item>
                <el-form-item label="Maximum conversation rounds" prop="chatMaxRound">
                    <el-input-number v-model="groupStartForm.chatMaxRound"
                                     :min="1"
                                     :max="50"
                                     :step="1"
                                     controls-position="right"></el-input-number>
                </el-form-item>
                <el-form-item :label="ncfST('Frontend.AgentsManager.MentionableGroupMembers')">
                    <div class="groupStartMentions" v-loading="groupStartParticipantLoading">
                        <div class="form-help-text">{{ ncfST('Frontend.AgentsManager.ClickAMemberToInsertAMentionAtTheCurrentCursorPosition') }}</div>
                        <div v-if="groupStartParticipants.length" class="groupStartMentions__list">
                            <div v-for="participant in groupStartParticipants" :key="participant.participantKey"
                                class="groupStartMentions__participant">
                                <el-button type="primary" plain size="small" class="groupStartMentions__item"
                                    @@click="insertGroupStartMention(participant)">
                                    <span class="groupStartMentions__name">@@{{ participant.name }}</span>
                                    <el-tag v-if="participant.agentKind === 'RemoteA2A'" type="warning" size="mini">A2A</el-tag>
                                    <el-tag v-for="roleName in participant.roles" :key="participant.participantKey + '-' + roleName"
                                        type="info" effect="plain" size="mini">{{ roleName }}</el-tag>
                                </el-button>
                                <div class="groupStartMentions__details">
                                    <template v-if="participant.agentKind === 'RemoteA2A'">
                                        <el-tag :type="remoteParticipantAvailabilityType(participant)" size="mini"
                                            :title="participant.lastHealthCheckMessage || ''">{{ remoteParticipantAvailabilityText(participant) }}</el-tag>
                                        <span>{{ participant.timeoutSeconds || 60 }} {{ ncfST('Frontend.AgentsManager.Sec') }}</span>
                                        <span v-if="participant.lastHealthCheckAt">{{ ncfST('Frontend.AgentsManager.ConnectionCheck') }} {{ participant.lastHealthCheckAt | showFormatDate }}</span>
                                        <el-button type="text" size="mini" :loading="isRemoteAgentTesting(participant.id)"
                                            @@click.stop="testGroupStartRemoteAgent(participant)">{{ ncfST('Frontend.AgentsManager.Test') }}</el-button>
                                    </template>
                                    <template v-else>
                                            <el-tag :type="participant.enable ? 'success' : 'info'" size="mini">{{ participant.enable ? ncfST('Frontend.AgentsManager.Enabled') : ncfST('Frontend.AgentsManager.Disabled') }}</el-tag>
                                    </template>
                                    <span v-if="participant.description" class="groupStartMentions__description text-ellipsis" :title="participant.description">{{ participant.description }}</span>
                                </div>
                            </div>
                        </div>
                        <div v-else class="groupStartMentions__empty">{{ ncfST('Frontend.AgentsManager.TheCurrentGroupHasNoMentionableMembers') }}</div>
                    </div>
                </el-form-item>
                <el-form-item :label="ncfST('Frontend.AgentsManager.ConnectorsForThisRun')">
                    <el-switch v-model="groupStartForm.limitConnectors"
                               :active-text="ncfST('Frontend.AgentsManager.UseOnlyTheSelectedConnectors')"
                               :inactive-text="ncfST('Frontend.AgentsManager.UseConnectorsAuthorizedByEachAgent')"></el-switch>
                    <div v-if="groupStartForm.limitConnectors" style="margin-top:10px;">
                        <el-select v-model="groupStartForm.connectorInstanceIds" multiple filterable clearable
                                   style="width:100%" :placeholder="ncfST('Frontend.AgentsManager.LeaveUnselectedToUseNoConnectorThisTime')"
                                   :loading="connectorOptionsLoading">
                            <el-option v-for="item in connectorOptions" :key="item.instanceId"
                                       :label="item.name + ' · ' + item.connectorName" :value="item.instanceId"></el-option>
                        </el-select>
                    </div>
                    <div class="form-help-text">{{ ncfST('Frontend.AgentsManager.TheAgentTemplateHasNoAuthorizedConnectorsSelectingOneHereWillNot') }}</div>
                </el-form-item>
                <el-form-item :label="ncfST('Frontend.AgentsManager.TaskDescription')" prop="promptCommand">
                    <el-input ref="groupStartPromptCommand" type="textarea" v-model="groupStartForm.promptCommand" :rows="8"
                        :placeholder="ncfST('Frontend.AgentsManager.WhatCanIHelpYouWith')" @@focus="rememberGroupStartPromptCaret"
                        @@click.native="rememberGroupStartPromptCaret" @@keyup.native="rememberGroupStartPromptCaret"
                        @@select.native="rememberGroupStartPromptCaret"></el-input>
                </el-form-item>
                <el-form-item :label="ncfST('Frontend.AgentsManager.DescriptionAlternate')" prop="description">
                    <el-input type="textarea" v-model="groupStartForm.description" :rows="8"
                        :placeholder="ncfST('Frontend.AgentsManager.PleaseFillIn')"></el-input>
                </el-form-item>
            </el-form>
        </div>
        @* Fixed content footer. *@
        <div class="drawerRtl__footer text-right">
            <el-button :size="elSize" @@click="handleElVisibleClose('drawerGroupStart')">{{ ncfST('Frontend.AgentsManager.CancelAlternate') }}</el-button>
            <el-button :size="elSize" type="primary" @@click="handleElVisibleSubmit('drawerGroupStart')">{{ ncfST('Frontend.AgentsManager.OK') }}</el-button>
        </div>
    </div>
</el-drawer>
@* Add-agent dialog. *@
<el-dialog :title="agentForm.id ? ncfST('Frontend.AgentsManager.EditAgent') : ncfST('Frontend.AgentsManager.AddAgent')" :visible.sync="visible.dialogGroupAgent" :show-close="false"
    :close-on-click-modal="false" :close-on-press-escape="false">
    <el-form v-if="visible.dialogGroupAgent" ref="agentELForm" :model="agentForm" :rules="agentFormRules" :size="elSize"
        label-position="left" label-width="130px" class="drawerForm-container">
        <el-alert v-if="agentForm.isSystemAgent"
                  :title="ncfST('Frontend.AgentsManager.SystemAgentValue', agentForm.systemAgentKind || agentForm.name)"
                  :description="agentForm.isHuman ? ncfST('Frontend.AgentsManager.HumanInputIsProvidedByTheSignedInUserNoModelOr') : ncfST('Frontend.AgentsManager.SystemAgentsAreCreatedOrMaintainedByModulesForExamplePromptCatalyzerConfirm')"
                  type="info"
                  :closable="false"
                  show-icon
                  style="margin-bottom:16px;"></el-alert>
        <el-form-item :label="ncfST('Frontend.AgentsManager.AgentName')" prop="name">
            <el-input v-model="agentForm.name" :placeholder="ncfST('Frontend.AgentsManager.PleaseFillIn')" :disabled="agentForm.isHuman"></el-input>
        </el-form-item>
        <el-form-item v-if="!agentForm.isHuman" label="SystemMessage" required>
            <el-radio-group v-model="agentForm.systemMessageType" @@change="handleSystemMessageTypeChange">
                <el-radio label="1" border>{{ ncfST('Frontend.AgentsManager.Select') }}</el-radio>
                <el-radio label="2" border>{{ ncfST('Frontend.AgentsManager.Manual') }}</el-radio>
            </el-radio-group>
        </el-form-item>
        <el-form-item v-if="!agentForm.isHuman && agentForm.systemMessageType === '1'" :label="ncfST('Frontend.AgentsManager.Select')" prop="systemMessage">
            <load-more-select v-model="agentForm.systemMessage" service-type="systemMessage" direction="vertical"
                :placeholder="ncfST('Frontend.AgentsManager.SelectAlternate')" @@options-loaded="handleSystemMessageOptionsLoaded" />
        </el-form-item>
        <el-form-item v-if="!agentForm.isHuman && agentForm.systemMessageType === '2'" :label="ncfST('Frontend.AgentsManager.ManualEntry')" prop="systemMessage">
            <el-input v-model="agentForm.systemMessage" type="textarea" :rows="4" :placeholder="ncfST('Frontend.AgentsManager.PleaseFillIn')"></el-input>
            <div v-if="agentForm.id" style="margin-top:8px;">
                <el-button size="small" type="primary" plain icon="el-icon-magic-stick"
                           :loading="agentPromptConversionLoading"
                           @@click="convertAgentPromptToPromptRange">{{ ncfST('Frontend.AgentsManager.GenerateInPromptRangeAndRunScoring') }}</el-button>
            </div>
        </el-form-item>
        <el-form-item :label="ncfST('Frontend.AgentsManager.BindModel')" prop="modelBinding">
            <el-radio-group v-model="agentForm.modelBinding" @@change="handleAgentModelBindingChange">
                <el-radio :label="0" border :disabled="agentForm.isHuman">{{ ncfST('Frontend.AgentsManager.InheritFromPromptRange') }}</el-radio>
                <el-radio :label="1" border>{{ ncfST('Frontend.AgentsManager.FollowGroupTask') }}</el-radio>
                <el-radio :label="2" border>{{ ncfST('Frontend.AgentsManager.SelectAIModelManually') }}</el-radio>
            </el-radio-group>
            <div v-if="agentForm.modelBinding === 2" style="margin-top:10px;">
                <load-more-select v-model="agentForm.aiModelId" service-type="model" :chat-only="true"
                                  direction="vertical" :placeholder="ncfST('Frontend.AgentsManager.SelectAChatModel')" />
            </div>
            <div class="form-help-text" v-if="agentForm.systemMessageType === '2' && !agentForm.isHuman">{{ ncfST('Frontend.AgentsManager.AManualPromptRequiresManuallySelectingAChatAIModel') }}</div>
        </el-form-item>
        <el-form-item v-if="!agentForm.isHuman" :label="ncfST('Frontend.AgentsManager.EnabledAlternate')" prop="enable">
            <el-checkbox v-model="agentForm.enable">{{ ncfST('Frontend.AgentsManager.EnableAgent') }}</el-checkbox>
        </el-form-item>
        <el-form-item :label="ncfST('Frontend.AgentsManager.BindKnowledgeBase')" prop="knowledgeBaseId">
            <el-select v-model="agentForm.knowledgeBaseId" clearable filterable style="width:100%" :placeholder="ncfST('Frontend.AgentsManager.DoNotBindAKnowledgeBase')">
                <el-option v-for="item in knowledgeBaseOptions" :key="item.id"
                    :label="getKnowledgeBaseOptionLabel(item)"
                    :value="item.id" :disabled="!item.isEmbedded"></el-option>
            </el-select>
            <div v-if="agentForm.knowledgeBaseId" class="knowledgeBase-shortcuts">
                <el-tag size="mini" :type="getKnowledgeBaseBindingInfo(agentForm.knowledgeBaseId).type">
                    {{ getKnowledgeBaseBindingInfo(agentForm.knowledgeBaseId).text }}
                </el-tag>
                <el-button size="mini" type="primary" plain icon="el-icon-folder-opened"
                    @@click="openKnowledgeBase(agentForm.knowledgeBaseId, 'materials')">{{ ncfST('Frontend.AgentsManager.ManageMaterials') }}</el-button>
                <el-button size="mini" plain icon="el-icon-setting"
                    @@click="openKnowledgeBase(agentForm.knowledgeBaseId, 'edit')">{{ ncfST('Frontend.AgentsManager.EditSettings') }}</el-button>
            </div>
        </el-form-item>
        <el-form-item :label="ncfST('Frontend.AgentsManager.DescriptionAlternate')" prop="description">
            <el-input type="textarea" v-model="agentForm.description" :rows="4" :placeholder="ncfST('Frontend.AgentsManager.PleaseFillIn')"></el-input>
        </el-form-item>
        <el-form-item :label="ncfST('Frontend.AgentsManager.ExternalPlatform')" prop="hookRobotType">
            <el-select v-model="agentForm.hookRobotType" style="width:100%" :placeholder="ncfST('Frontend.AgentsManager.SelectAlternate')">
                <el-option label="None" :value="0"></el-option>
                <el-option label="WeChatMp" :value="1"></el-option>
                <el-option label="WeChatWorkRobot" :value="2"></el-option>
            </el-select>
        </el-form-item>
