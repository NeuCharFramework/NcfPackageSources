                                        v-show="historyMatchesMemberFilter(ritem, taskMemberfilter, taskMemberfilterList)">
                                        <div class="taskrecord-listWrap-item-head">
                                            <div class="taskrecord-item-meta-top">
                                                <span class="df-wn flex-ac flex-jc avatarBox">
                                                    <img :src="getTaskSenderInfo('task',ritem).avastar | showAvatar"
                                                        alt="">
                                                </span>
                                                <span class="name">{{ getTaskSenderName('task', ritem) }}</span>
                                                <span class="time">{{ ritem.addTime | showFormatDate }}</span>
                                                <span class="usage-inline" v-if="ritem.totalTokens || ritem.responseMilliseconds">{{ formatTaskHistoryUsage(ritem) }}</span>
                                            </div>
                                        </div>
                                        <task-html-renderer :content="ritem.messageHtml" />
                                    </div>
                                </div>
                            </el-scrollbar>
                        </div>
                        <div class="taskmain-members">
                            <div class="taskmain-members-usage">
                                <div class="taskmain-members-usage-title">{{ ncfST('Frontend.070') }}</div>
                                <div class="taskmain-members-usage-list">
                                    <div class="taskmain-members-usage-item">
                                        <span class="taskmain-members-usage-label">{{ ncfST('Frontend.071') }}</span>
                                        <span class="taskmain-members-usage-value">{{ formatUsageCount(taskUsageSummaryByType.task.messageCount) }}</span>
                                    </div>
                                    <div class="taskmain-members-usage-item">
                                        <span class="taskmain-members-usage-label">{{ ncfST('Frontend.072') }}</span>
                                        <span class="taskmain-members-usage-value">{{ formatUsageCount(taskUsageSummaryByType.task.totalTokens) }}</span>
                                    </div>
                                    <div class="taskmain-members-usage-item">
                                        <span class="taskmain-members-usage-label">{{ ncfST('Frontend.073') }}</span>
                                        <span class="taskmain-members-usage-value">{{ formatResponseMilliseconds(taskUsageSummaryByType.task.averageResponseMilliseconds) }}</span>
                                    </div>
                                    <div class="taskmain-members-usage-item">
                                        <span class="taskmain-members-usage-label">{{ ncfST('Frontend.074') }}</span>
                                        <span class="taskmain-members-usage-value">{{ formatResponseMilliseconds(taskUsageSummaryByType.task.maxResponseMilliseconds) }}</span>
                                    </div>
                                </div>
                            </div>
                            <el-input v-model="taskMemberfilter" :placeholder="ncfST('Frontend.007')" suffix-icon="el-icon-search" style="margin-bottom: 15px;" @@input="handleTaskFilterChange($event,'task')"></el-input>
                            <div class="taskmain-members-title">
                                {{ ncfST('Frontend.343') }}：{{ taskHumanParticipantStatusText(taskDetails) }} · {{ ncfST('Frontend.075') }}{{ taskMemberList ? taskMemberList.length : 0 }}
                            </div>
                            <el-scrollbar class="sidebar-taskmembers-container" wrap-class="scrollbar-wrapper">
                                <div class="df-wn flex-dc taskmain-members-listWrap">
                                    <participant-quick-action
                                        v-for="mitem in taskMemberList"
                                        :key="mitem.participantKey || ('local-' + mitem.id)"
                                        v-show="mitem.name.includes(taskMemberfilter)"
                                        :participant="mitem"
                                        :quick-info="getParticipantQuickInfo('task', mitem)"
                                        :testing="isRemoteAgentTesting(mitem.id)"
                                        @@edit-agent="openParticipantAgentEditor(mitem)"
                                        @@test-remote="testTaskRemoteAgent(mitem)">
                                    </participant-quick-action>
                                </div>
                            </el-scrollbar>
                        </div>
                    </div>
                </template>
                <div v-else class="df-wn flex-ac flex-jc emptyData"
                    style="flex-grow: 1;font-size: 14px;color: #5e6d82;margin-top:150px;">暂无数据</div>
            </div>
        </div>
    </el-tab-pane>
</el-tabs>

<el-dialog :title="ncfST('Frontend.076')" :visible.sync="usageAnalyticsVisible" width="86%" :close-on-click-modal="false">
    <div class="usage-analytics-toolbar">
        <span class="usage-analytics-title">{{ ncfST('Frontend.077') }}{{ usageAnalyticsTaskName }}（#{{ usageAnalyticsTaskId }}）</span>
        <el-date-picker
            v-model="usageAnalyticsDateRange"
            type="datetimerange"
            :range-separator="ncfST('Frontend.078')"
            :start-placeholder="ncfST('Frontend.079')"
            :end-placeholder="ncfST('Frontend.080')"
            value-format="yyyy-MM-dd HH:mm:ss"
            size="mini">
        </el-date-picker>
        <el-select v-model="usageAnalyticsAgentId" clearable filterable size="mini" :placeholder="ncfST('Frontend.081')">
            <el-option v-for="item in usageAnalyticsAgentOptions" :key="'usage-agent-' + item.id" :label="item.name" :value="item.id"></el-option>
        </el-select>
        <el-button size="mini" type="primary" @@click="loadUsageAnalytics">{{ ncfST('Frontend.082') }}</el-button>
        <el-button size="mini" @@click="resetUsageAnalyticsFilters">{{ ncfST('Frontend.083') }}</el-button>
    </div>

    <div class="usage-analytics-overview" v-loading="usageAnalyticsLoading">
        <div class="usage-card">
            <div class="label">{{ ncfST('Frontend.071') }}</div>
            <div class="value">{{ usageAnalyticsData.overview.messageCount || 0 }}</div>
        </div>
        <div class="usage-card">
            <div class="label">{{ ncfST('Frontend.084') }}</div>
            <div class="value">{{ usageAnalyticsData.overview.totalTokens || 0 }}</div>
        </div>
        <div class="usage-card">
            <div class="label">{{ ncfST('Frontend.085') }}</div>
            <div class="value">{{ usageAnalyticsData.overview.promptTokens || 0 }} / {{ usageAnalyticsData.overview.completionTokens || 0 }}</div>
        </div>
        <div class="usage-card">
            <div class="label">{{ ncfST('Frontend.073') }}</div>
            <div class="value">{{ Number(usageAnalyticsData.overview.averageResponseMilliseconds || 0).toFixed(1) }} ms</div>
        </div>
        <div class="usage-card">
            <div class="label">{{ ncfST('Frontend.086') }}</div>
            <div class="value">{{ usageAnalyticsData.overview.p95ResponseMilliseconds || 0 }} / {{ usageAnalyticsData.overview.maxResponseMilliseconds || 0 }} ms</div>
        </div>
    </div>

    <el-tabs>
        <el-tab-pane :label="ncfST('Frontend.087')">
            <el-table :data="usageAnalyticsData.roundStats" size="mini" height="280">
                <el-table-column prop="roundIndex" :label="ncfST('Frontend.088')" width="80"></el-table-column>
                <el-table-column prop="messageCount" :label="ncfST('Frontend.089')" width="90"></el-table-column>
                <el-table-column prop="promptTokens" :label="ncfST('Frontend.090')" width="110"></el-table-column>
                <el-table-column prop="completionTokens" :label="ncfST('Frontend.091')" width="110"></el-table-column>
                <el-table-column prop="totalTokens" :label="ncfST('Frontend.084')" width="110"></el-table-column>
                <el-table-column :label="ncfST('Frontend.092')">
                    <template slot-scope="{ row }">{{ Number(row.averageResponseMilliseconds || 0).toFixed(1) }}</template>
                </el-table-column>
            </el-table>
        </el-tab-pane>
        <el-tab-pane :label="ncfST('Frontend.093')">
            <el-table :data="usageAnalyticsData.agentStats" size="mini" height="280">
                <el-table-column prop="agentTemplateId" label="Agent ID" width="95"></el-table-column>
                <el-table-column prop="agentName" label="Agent"></el-table-column>
                <el-table-column prop="messageCount" :label="ncfST('Frontend.089')" width="90"></el-table-column>
                <el-table-column prop="totalTokens" :label="ncfST('Frontend.084')" width="120"></el-table-column>
                <el-table-column :label="ncfST('Frontend.092')" width="140">
                    <template slot-scope="{ row }">{{ Number(row.averageResponseMilliseconds || 0).toFixed(1) }}</template>
                </el-table-column>
            </el-table>
        </el-tab-pane>
        <el-tab-pane :label="ncfST('Frontend.094')">
            <el-table :data="usageAnalyticsData.timelineStats" size="mini" height="280">
                <el-table-column :label="ncfST('Frontend.095')" min-width="180">
                    <template slot-scope="{ row }">{{ row.bucketTime | showFormatDate }}</template>
                </el-table-column>
                <el-table-column prop="messageCount" :label="ncfST('Frontend.089')" width="90"></el-table-column>
                <el-table-column prop="totalTokens" :label="ncfST('Frontend.084')" width="120"></el-table-column>
                <el-table-column :label="ncfST('Frontend.092')" width="140">
                    <template slot-scope="{ row }">{{ Number(row.averageResponseMilliseconds || 0).toFixed(1) }}</template>
                </el-table-column>
            </el-table>
        </el-tab-pane>
    </el-tabs>
</el-dialog>

@* Agent create/edit drawer (540px). *@
<el-drawer :visible.sync="visible.drawerAgent" direction="rtl" :with-header="false" :wrapper-closable="false"
    :close-on-press-escape="false" size="960px">
    <div class="drawerRtl">
        @* Content header, including the title and close icon. *@
        <div class="drawerRtl__header">
            <div class="drawerRtl__header__title">{{ agentForm.id ? ncfST('Frontend.096') : ncfST('Frontend.097') }}</div>
            <div class="drawerRtl__header__close" @@click="handleElVisibleClose('drawerAgent')">&times;</div>
        </div>
        @* Main content area. *@
        <div class="drawerRtl__body">
            <el-form v-if="visible.drawerAgent" ref="agentELForm" :model="agentForm" :rules="agentFormRules"
                :size="elSize" label-position="left" label-width="130px" class="drawerForm-container">
                <el-alert v-if="agentForm.isSystemAgent"
                          :title="ncfST('Frontend.585', agentForm.systemAgentKind || agentForm.name)"
                          :description="agentForm.isHuman ? ncfST('Frontend.586') : ncfST('Frontend.587')"
                          type="info"
                          :closable="false"
                          show-icon
                          style="margin-bottom:16px;"></el-alert>
                <el-form-item :label="ncfST('Frontend.098')" prop="name">
                    <div class="agentNameFormField">
                        <el-input v-model="agentForm.name" :placeholder="ncfST('Frontend.099')" :disabled="agentForm.isHuman"></el-input>
                        <el-button v-if="agentForm.id && !agentForm.isHuman" size="small" type="danger" plain icon="el-icon-delete"
                            @@click="handleAgentDelete(agentForm, { closeEditor: true })">{{ ncfST('Frontend.018') }}</el-button>
                    </div>
                </el-form-item>
                <el-form-item v-if="!agentForm.isHuman" label="SystemMessage" required>
                    <el-radio-group v-model="agentForm.systemMessageType" @@change="handleSystemMessageTypeChange">
                        <el-radio label="1" border>{{ ncfST('Frontend.100') }}</el-radio>
                        <el-radio label="2" border>{{ ncfST('Frontend.101') }}</el-radio>
                    </el-radio-group>
                </el-form-item>
                <el-form-item v-if="!agentForm.isHuman && agentForm.systemMessageType === '1'" :label="ncfST('Frontend.100')" prop="systemMessage">
                    @* @change="handleChange($event,'')" *@
                    <load-more-select v-model="agentForm.systemMessage" service-type="systemMessage"
                        direction="vertical" :placeholder="ncfST('Frontend.102')" @@options-loaded="handleSystemMessageOptionsLoaded" />
                </el-form-item>
                <el-form-item v-if="!agentForm.isHuman && agentForm.systemMessageType === '2'" :label="ncfST('Frontend.103')" prop="systemMessage">
                    <el-input
                       type="textarea"
                       v-model="agentForm.systemMessage"  
                       @@change="handleIdentify"  
                       :placeholder="ncfST('Frontend.099')"  
                       :rows="4">  
                    </el-input>
                    <div v-if="agentForm.id && !agentForm.isHuman" style="margin-top:8px;">
                        <el-button size="small" type="primary" plain icon="el-icon-magic-stick"
                                   :loading="agentPromptConversionLoading"
                                   @@click="convertAgentPromptToPromptRange">{{ ncfST('Frontend.451') }}</el-button>
                        <div class="form-help-text">{{ ncfST('Frontend.588') }}</div>
                    </div>
                </el-form-item>
                <el-form-item :label="ncfST('Frontend.463')" prop="modelBinding">
                    <el-radio-group v-model="agentForm.modelBinding" @@change="handleAgentModelBindingChange">
                        <el-radio :label="0" border :disabled="agentForm.isHuman">{{ ncfST('Frontend.358') }}</el-radio>
                        <el-radio :label="1" border>{{ ncfST('Frontend.478') }}</el-radio>
                        <el-radio :label="2" border>{{ ncfST('Frontend.411') }}</el-radio>
                    </el-radio-group>
                    <div v-if="agentForm.modelBinding === 2" style="margin-top:10px;">
                        <load-more-select v-model="agentForm.aiModelId" service-type="model" :chat-only="true"
                                          direction="vertical" :placeholder="ncfST('Frontend.476')" />
                    </div>
                    <div class="form-help-text" v-if="agentForm.systemMessageType === '2' && !agentForm.isHuman">{{ ncfST('Frontend.589') }}</div>
                    <div class="form-help-text" v-else-if="agentForm.isHuman">{{ ncfST('Frontend.590') }}</div>
                </el-form-item>
                <el-form-item v-if="!agentForm.isHuman" :label="ncfST('Frontend.104')" prop="enable">
                    <el-checkbox v-model="agentForm.enable">{{ ncfST('Frontend.105') }}</el-checkbox>
                </el-form-item>
                <el-form-item v-if="agentForm.id && !agentForm.isHuman" label="A2A">
                    <el-button size="small" type="warning" plain icon="el-icon-connection" @@click="openPublishedA2AEditor(agentForm)">{{ ncfST('Frontend.490') }}</el-button>
                    <div class="form-help-text">{{ ncfST('Frontend.383') }}</div>
                </el-form-item>
                <el-form-item :label="ncfST('Frontend.464')" prop="knowledgeBaseId">
                    <el-select v-model="agentForm.knowledgeBaseId" clearable filterable style="width:100%" :placeholder="ncfST('Frontend.352')">
                        <el-option v-for="item in knowledgeBaseOptions" :key="item.id"
                            :label="getKnowledgeBaseOptionLabel(item)"
                            :value="item.id" :disabled="!item.isEmbedded"></el-option>
                    </el-select>
                    <div v-if="agentForm.knowledgeBaseId" class="knowledgeBase-shortcuts">
                        <el-tag size="mini" :type="getKnowledgeBaseBindingInfo(agentForm.knowledgeBaseId).type">
                            {{ getKnowledgeBaseBindingInfo(agentForm.knowledgeBaseId).text }}
                        </el-tag>
                        <el-button size="mini" type="primary" plain icon="el-icon-folder-opened"
                            @@click="openKnowledgeBase(agentForm.knowledgeBaseId, 'materials')">{{ ncfST('Frontend.459') }}</el-button>
                        <el-button size="mini" plain icon="el-icon-setting"
                            @@click="openKnowledgeBase(agentForm.knowledgeBaseId, 'edit')">{{ ncfST('Frontend.469') }}</el-button>
                        <el-button size="mini" type="text" icon="el-icon-refresh"
                            @@click="refreshKnowledgeBaseOptions">{{ ncfST('Frontend.381') }}</el-button>
                    </div>
                    <div class="form-help-text">
                        {{ ncfST('Frontend.581') }}
                        <template v-if="getKnowledgeBaseBindingInfo(agentForm.knowledgeBaseId).text === '旧版向量化，待发布'">{{ ncfST('Frontend.429') }}</template>
                    </div>
                </el-form-item>
                <el-form-item :label="ncfST('Frontend.106')" prop="hookRobotType">
                    <el-select v-model="agentForm.hookRobotType" style="width:100%" :placeholder="ncfST('Frontend.102')">
                        <el-option label="None" :value="0"></el-option>
                        <el-option label="WeChatMp" :value="1"></el-option>
                        <el-option label="WeChatWorkRobot" :value="2"></el-option>
                    </el-select>
                </el-form-item>
                <el-form-item :label="ncfST('Frontend.107')" prop="hookRobotParameter">
                    <el-input v-model="agentForm.hookRobotParameter" :placeholder="ncfST('Frontend.099')" :disabled="agentForm.hookRobotType === 0"></el-input>
                </el-form-item>
                <el-form-item :label="ncfST('Frontend.189')" prop="avastar">
                    <div class="df-wn flex-ac flex-js agentForm-agentAvatarBox">
                        <div v-for="(aitem,aindex) in agentAvatarList" :key="aindex"
                            class="df-wn flex-ac flex-jc agentAvatarBoxItem"
                            :class="{'agentAvatarBoxItem-active':aitem === agentForm.avastar}"
                            @@click="handleFormValidateField('agentELForm','agentForm','avastar',aitem)">
                            <img :src="aitem" alt="">
                        </div>
                    </div>
                </el-form-item>
                <el-form-item :label="ncfST('Frontend.399')">
                    <div class="function-binding-summary">
                        <div class="function-binding-summary__copy">
                            <strong>{{ functionBindingSummary }}</strong>
                            <span>{{ ncfST('Frontend.472') }}</span>
                        </div>
                        <el-button type="primary" plain icon="el-icon-setting"
                            @@click="openFunctionBindingDrawer">{{ ncfST('Frontend.458') }}</el-button>
                    </div>
