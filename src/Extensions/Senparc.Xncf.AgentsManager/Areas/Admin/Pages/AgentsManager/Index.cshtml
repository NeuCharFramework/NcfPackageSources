                <el-form-item :label="ncfST('Frontend.AgentsManager.ExternalPlatformParameters')" prop="hookRobotParameter">
                    <el-input v-model="agentForm.hookRobotParameter" :placeholder="ncfST('Frontend.AgentsManager.PleaseFillIn')" :disabled="agentForm.hookRobotType === 0"></el-input>
                </el-form-item>
                <el-form-item :label="ncfST('Frontend.AgentsManager.AgentAvatar')" prop="avastar">
                    <div class="df-wn flex-ac flex-js agentForm-agentAvatarBox">
                        <div v-for="(aitem,aindex) in agentAvatarList" :key="aindex"
                            class="df-wn flex-ac flex-jc agentAvatarBoxItem"
                            :class="{'agentAvatarBoxItem-active':aitem === agentForm.avastar}"
                            @@click="handleFormValidateField('agentELForm','agentForm','avastar',aitem)">
