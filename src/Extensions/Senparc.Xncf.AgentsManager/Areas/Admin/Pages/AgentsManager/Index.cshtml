                            <span>{{oitem.addTime}} [{{ ncfST('Frontend.196') }}{{oitem.costTime}}]</span>
                        </div>
                        <div class="copyButtonArea">
                            <a href="javascript:void(0);" @@click="copyText('2',oitem)" :title="ncfST('Frontend.197')"><i class="fa fa-copy"></i> HTML</a>
                            <a href="javascript:void(0);" @@click="copyText('1',oitem)" :title="ncfST('Frontend.198')"><i class="fa fa-copy"></i> {{ ncfST('Frontend.199') }}</a>
                        </div>
                    </div>
                    <task-html-renderer class="contentRow" :content="oitem.resultStringHtml" />
                </div>
                        </div>
                    </div>
                </div>
            </el-tab-pane>
        </el-tabs>
    </div>
    <div slot="footer" class="dialog-footer">
        <el-button type="primary" @@click="handleElVisibleClose('dialogAgentParameter')">{{ ncfST('Frontend.200') }}</el-button>
    </div>
</el-dialog>
@* Task description dialog. *@
<el-dialog :title="ncfST('Frontend.361')" :visible.sync="visible.dialogTaskDescription" :show-close="false" :close-on-click-modal="false"
    :close-on-press-escape="false" width="720px">
    <div class="dialog-describeContent">
        {{ describeContent }}
    </div>
    <div v-if="taskDescriptionDetails && taskDescriptionDetails.executionPolicyCaptured"
        class="task-policy-summary">
        <div class="task-policy-summary__title">{{ ncfST('Frontend.440') }}</div>
        <dl>
            <dt>{{ ncfST('Frontend.341') }}</dt>
            <dd>{{taskHumanInTheLoopLevelText(taskDescriptionDetails.humanInTheLoopLevel)}}</dd>
            <dt>Plugin tool permissions</dt>
            <dd>{{taskToolPermissionText(taskDescriptionDetails.pluginToolPermission)}}</dd>
            <dt>{{ ncfST('Frontend.349') }}</dt>
            <dd>{{taskToolPermissionText(taskDescriptionDetails.mcpToolPermission)}}</dd>
            <dt>{{ ncfST('Frontend.343') }}</dt>
            <dd>{{taskDescriptionDetails.includeHumanParticipant ? 'Included' : 'Skipped'}}</dd>
            <dt>Maximum conversation rounds</dt>
            <dd>{{taskDescriptionDetails.chatMaxRound}}</dd>
            <dt>Personalized parameters</dt>
            <dd>{{taskDescriptionDetails.isPersonality ? ncfST('Frontend.044') : 'Disabled'}}</dd>
            <dt>Legacy forced approval</dt>
            <dd>{{taskDescriptionDetails.requireHumanApproval ? ncfST('Frontend.044') : 'Disabled'}}</dd>
        </dl>
    </div>
    <el-alert v-else-if="taskDescriptionDetails"
        :title="ncfST('Frontend.444')"
        type="info" :closable="false" show-icon style="margin-top:16px;"></el-alert>
    <div slot="footer" class="dialog-footer">
        <el-button type="text" @@click="taskDescriptionCopy">
            <i class="far fa-clone"></i>
            {{ ncfST('Frontend.518') }}
        </el-button>
        <el-button @@click="handleElVisibleClose('dialogTaskDescription')">{{ ncfST('Frontend.200') }}</el-button>
    </div>
</el-dialog>
@* Task evaluation dialog. *@
<el-dialog :title="ncfST('Frontend.201')" :visible.sync="visible.dialogTaskEvaluation" :show-close="false" :close-on-click-modal="false"
    :close-on-press-escape="false">
    <el-form v-if="visible.dialogTaskEvaluation" ref="evaluationELForm" :model="evaluationForm"
        :rules="evaluationFormRules" :size="elSize" label-position="top" label-width="130px"
        class="drawerForm-container">
        <el-form-item :label="ncfST('Frontend.202')" prop="score">
            @* <el-input v-model="evaluationForm.score" placeholder="Please enter"
            @@input="handleInputNum($event,'evaluationForm.score')"></el-input> *@
            <el-slider v-model="evaluationForm.score" min="0" max="10" step="0.1"></el-slider>
        </el-form-item>
        <el-form-item :label="ncfST('Frontend.203')" prop="evaluation">
            <el-input type="textarea" v-model="evaluationForm.evaluation" :rows="4" :placeholder="ncfST('Frontend.099')"></el-input>
        </el-form-item>
    </el-form>
    <div slot="footer" class="dialog-footer">
        <el-button type="primary" @@click="handleElVisibleSubmit('dialogTaskEvaluation')">{{ ncfST('Frontend.192') }}</el-button>
        <el-button @@click="handleElVisibleClose('dialogTaskEvaluation')">{{ ncfST('Frontend.191') }}</el-button>
    </div>
</el-dialog>
@* MCP tool list dialog. *@
<el-dialog :title="ncfST('Frontend.254')" :visible.sync="visible.dialogMcpTools" :append-to-body="true" width="80%" :show-close="true" :destroy-on-close="false" center>
    <div v-if="currentMcpTools && currentMcpTools.length > 0">
        <el-table :data="currentMcpTools" style="width: 100%">
            <el-table-column prop="name" :label="ncfST('Frontend.398')" width="180"></el-table-column>
            <el-table-column prop="description" :label="ncfST('Frontend.131')"></el-table-column>
            <el-table-column :label="ncfST('Frontend.123')" width="300">
                <template slot-scope="scope">
                    <div v-if="scope.row.parameters && scope.row.parameters.length > 0">
                        <div v-for="param in scope.row.parameters" :key="param.name" class="param-item-table">
                            <strong>{{param.name}}</strong>: {{param.description}}
                        </div>
                    </div>
                    <span v-else>{{ ncfST('Frontend.253') }}</span>
                </template>
            </el-table-column>
        </el-table>
    </div>
    <div v-else class="empty-tools">
        <div class="empty-text">{{ ncfST('Frontend.249') }}</div>
    </div>
    <div class="dialog-footer" slot="footer">
        <el-button type="primary" @@click="visible.dialogMcpTools = false">{{ ncfST('Frontend.255') }}</el-button>
    </div>
</el-dialog>
@* Human text-turn dialog; NeuBell clicks only navigate and the business path consumes the notice after submission. *@
<el-dialog :title="ncfST('Frontend.400')" :visible.sync="toolApprovalDialogVisible" width="760px"
    :before-close="deferToolApproval" :close-on-click-modal="false" :close-on-press-escape="false">
    <template v-if="toolApprovalRequest">
        <el-alert type="warning" :closable="false" show-icon
            :title="toolApprovalRequest.text || toolApprovalRequest.prompt || ncfST('Frontend.400')"></el-alert>
        <div class="tool-approval-summary">
            <span class="tool-approval-summary__label">{{ ncfST('Frontend.398') }}</span>
            <strong>{{toolApprovalRequest.humanToolName || toolApprovalRequest.toolName || ncfST('Frontend.398')}}</strong>
            <span v-if="toolApprovalRequest.fromAgentName || toolApprovalRequest.agentName"
                class="tool-approval-summary__agent">
                Agent：{{toolApprovalRequest.fromAgentName || toolApprovalRequest.agentName}}
            </span>
        </div>
        <div class="tool-approval-arguments">
            <div class="tool-approval-arguments__title">{{ ncfST('Frontend.396') }}</div>
            <pre>{{toolApprovalArgumentText}}</pre>
        </div>
    </template>
    <div slot="footer" class="dialog-footer">
        <el-button @@click="deferToolApproval" :disabled="toolApprovalSubmitting">{{ ncfST('Frontend.457') }}</el-button>
        <el-button @@click="resolveToolApproval(false)" :loading="toolApprovalSubmitting">{{ ncfST('Frontend.416') }}</el-button>
        <el-button type="primary" @@click="resolveToolApproval(true)" :loading="toolApprovalSubmitting">{{ ncfST('Frontend.413') }}</el-button>
    </div>
</el-dialog>
<el-dialog :title="ncfST('Frontend.344')" :visible.sync="humanReplyDialogVisible" width="680px"
    :close-on-click-modal="false" :close-on-press-escape="false" :show-close="false">
    <el-alert type="warning" :closable="false" show-icon
        :title="ncfST('Frontend.405')"></el-alert>
    <div style="margin:16px 0 10px; white-space:pre-wrap; color:#4a5568;">
        {{ humanReplyRequest ? (humanReplyRequest.text || humanReplyRequest.prompt || ncfST('Frontend.562')) : '' }}
    </div>
    <el-input v-model="humanReplyText" type="textarea" :rows="7" maxlength="10000" show-word-limit
        :placeholder="ncfST('Frontend.475')"></el-input>
    <div slot="footer" class="dialog-footer">
        <el-button @@click="closeHumanReplyDialog" :disabled="humanReplySubmitting">{{ ncfST('Frontend.457') }}</el-button>
        <el-button type="primary" @@click="submitHumanReply" :loading="humanReplySubmitting">{{ ncfST('Frontend.418') }}</el-button>
    </div>
</el-dialog>
@* Publish the local Agent as a standard A2A service dialog. *@
<el-dialog :title="ncfST('Frontend.384')" :visible.sync="visible.dialogPublishedA2A" width="720px"
    :show-close="false" :close-on-click-modal="false" :close-on-press-escape="false">
    <el-alert type="warning" :closable="false" :title="ncfST('Frontend.332')" show-icon></el-alert>
    <el-alert v-if="publishedA2AForm.enable" type="warning" :closable="false" show-icon style="margin-top:12px;"
        :title="ncfST('Frontend.397')"></el-alert>
    <el-alert v-if="publishedA2AForm.enable && publishedA2AForm.authenticationMode === 0" type="error" :closable="false" show-icon style="margin-top:12px;"
        :title="ncfST('Frontend.406')"></el-alert>
    <el-alert v-if="publishedA2AForm.enable && publishedA2AForm.allowFunctionCalls" type="error" :closable="false" show-icon style="margin-top:12px;"
        :title="ncfST('Frontend.495')"></el-alert>
    <el-form v-if="visible.dialogPublishedA2A" ref="publishedA2AELForm" :model="publishedA2AForm" :rules="publishedA2AFormRules"
        :size="elSize" label-position="left" label-width="150px" style="margin-top:20px;">
        <el-form-item :label="ncfST('Frontend.392')">
            <el-switch v-model="publishedA2AForm.enable" :active-text="ncfST('Frontend.515')" :inactive-text="ncfST('Frontend.582')"></el-switch>
        </el-form-item>
        <el-form-item :label="ncfST('Frontend.374')" prop="publicAgentKey">
            <el-input v-model="publishedA2AForm.publicAgentKey" placeholder="例如 research-agent"></el-input>
            <div class="form-help-text">{{ ncfST('Frontend.385') }}</div>
        </el-form-item>
        <el-form-item :label="ncfST('Frontend.337')">
            <el-input v-model="publishedA2AForm.cardName" :placeholder="ncfST('Frontend.454')"></el-input>
        </el-form-item>
        <el-form-item :label="ncfST('Frontend.373')">
            <el-input type="textarea" v-model="publishedA2AForm.cardDescription" :rows="3" :placeholder="ncfST('Frontend.368')"></el-input>
        </el-form-item>
        <el-form-item label="Skill ID / name">
            <div style="display:flex;gap:8px;">
                <el-input v-model="publishedA2AForm.skillId" placeholder="chat" style="width:35%;"></el-input>
                <el-input v-model="publishedA2AForm.skillName" :placeholder="ncfST('Frontend.452')"></el-input>
            </div>
        </el-form-item>
        <el-form-item label="Skill description">
            <el-input type="textarea" v-model="publishedA2AForm.skillDescription" :rows="2" :placeholder="ncfST('Frontend.453')"></el-input>
        </el-form-item>
        <el-form-item :label="ncfST('Frontend.372')">
            <el-select v-model="publishedA2AForm.authenticationMode" style="width:100%;">
                <el-option label="None (controlled networks only)" :value="0"></el-option>
                <el-option label="Bearer Token" :value="1"></el-option>
                <el-option :label="ncfST('Frontend.471')" :value="2"></el-option>
            </el-select>
        </el-form-item>
        <el-form-item v-if="publishedA2AForm.authenticationMode === 2" label="Request header name">
            <el-input v-model="publishedA2AForm.authHeaderName" placeholder="例如 X-A2A-Token"></el-input>
        </el-form-item>
        <el-form-item v-if="publishedA2AForm.authenticationMode !== 0" :label="ncfST('Frontend.489')">
            <el-input v-model="publishedA2AForm.authSecretKey" placeholder="例如 partner-ncf"></el-input>
            <div class="form-help-text">{{ ncfST('Frontend.355') }} A2A:InboundSecrets:{{ publishedA2AForm.authSecretKey || 'secret-name' }}.</div>
        </el-form-item>
        <el-form-item :label="ncfST('Frontend.492')">
            <el-input-number v-model="publishedA2AForm.maxInputCharacters" :min="512" :max="100000" :step="1000"></el-input-number>
        </el-form-item>
        <el-form-item :label="ncfST('Frontend.371')">
            <el-switch v-model="publishedA2AForm.allowFunctionCalls" :active-text="ncfST('Frontend.516')" :inactive-text="ncfST('Frontend.583')"></el-switch>
            <div class="form-help-text" style="color:#d97706;">{{ ncfST('Frontend.404') }}</div>
        </el-form-item>
        <el-form-item v-if="publishedA2AForm.agentCardUrl" :label="ncfST('Frontend.338')">
            <el-input :value="publishedA2AForm.agentCardUrl" readonly>
                <el-button slot="append" icon="el-icon-document-copy" @@click="copyPublishedA2AUrl">{{ ncfST('Frontend.394') }}</el-button>
            </el-input>
        </el-form-item>
    </el-form>
    <div slot="footer" class="dialog-footer">
        <el-button @@click="closePublishedA2AEditor">{{ ncfST('Frontend.091') }}</el-button>
        <el-button type="primary" @@click="savePublishedA2A">{{ ncfST('Frontend.369') }}</el-button>
    </div>
</el-dialog>
