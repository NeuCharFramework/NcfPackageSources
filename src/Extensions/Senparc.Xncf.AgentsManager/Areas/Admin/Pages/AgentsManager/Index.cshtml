@* Task description dialog. *@
<el-dialog :title="ncfST('Frontend.AgentsManager.TaskDescriptionAndExecutionStrategy')" :visible.sync="visible.dialogTaskDescription" :show-close="false" :close-on-click-modal="false"
    :close-on-press-escape="false" width="720px">
    <div class="dialog-describeContent">
        {{ describeContent }}
    </div>
    <div v-if="taskDescriptionDetails && taskDescriptionDetails.executionPolicyCaptured"
        class="task-policy-summary">
        <div class="task-policy-summary__title">{{ ncfST('Frontend.AgentsManager.RunPolicy') }}</div>
        <dl>
            <dt>{{ ncfST('Frontend.AgentsManager.HILLevel') }}</dt>
            <dd>{{taskHumanInTheLoopLevelText(taskDescriptionDetails.humanInTheLoopLevel)}}</dd>
            <dt>Plugin tool permissions</dt>
            <dd>{{taskToolPermissionText(taskDescriptionDetails.pluginToolPermission)}}</dd>
            <dt>{{ ncfST('Frontend.AgentsManager.MCPToolPermissions') }}</dt>
            <dd>{{taskToolPermissionText(taskDescriptionDetails.mcpToolPermission)}}</dd>
            <dt>{{ ncfST('Frontend.AgentsManager.HumanParticipant') }}</dt>
            <dd>{{taskDescriptionDetails.includeHumanParticipant ? 'Included' : 'Skipped'}}</dd>
            <dt>Maximum conversation rounds</dt>
            <dd>{{taskDescriptionDetails.chatMaxRound}}</dd>
            <dt>Personalized parameters</dt>
            <dd>{{taskDescriptionDetails.isPersonality ? ncfST('Frontend.AgentsManager.Enabled') : 'Disabled'}}</dd>
            <dt>Legacy forced approval</dt>
            <dd>{{taskDescriptionDetails.requireHumanApproval ? ncfST('Frontend.AgentsManager.Enabled') : 'Disabled'}}</dd>
        </dl>
    </div>
    <el-alert v-else-if="taskDescriptionDetails"
        :title="ncfST('Frontend.AgentsManager.ThisTaskWasCreatedBeforePolicyRecordingWasEnabledItsHistoricalHIL')"
        type="info" :closable="false" show-icon style="margin-top:16px;"></el-alert>
    <div slot="footer" class="dialog-footer">
        <el-button type="text" @@click="taskDescriptionCopy">
            <i class="far fa-clone"></i>
            {{ ncfST('Frontend.AgentsManager.CopyAlternate') }}
        </el-button>
        <el-button @@click="handleElVisibleClose('dialogTaskDescription')">{{ ncfST('Frontend.AgentsManager.CloseAlternate') }}</el-button>
    </div>
</el-dialog>
