                        </div>
                    </div>
                </el-form-item>
                <el-form-item :label="ncfST('Frontend.AgentsManager.ToolsAndWorkflows')">
                    <div class="function-binding-summary">
                        <div class="function-binding-summary__copy">
                            <strong>{{ functionBindingSummary }}</strong>
                            <span>{{ ncfST('Frontend.AgentsManager.LetTheModelCallFunctionRenderWorkflowOrCompatiblePluginsAsNeeded') }}</span>
                        </div>
                        <el-button type="primary" plain icon="el-icon-setting"
                            @@click="openFunctionBindingDrawer">{{ ncfST('Frontend.AgentsManager.ManageBindings') }}</el-button>
                    </div>
                    <div class="function-binding-chips" v-if="agentForm.functionBindings && agentForm.functionBindings.length">
                        <el-tag v-for="binding in agentForm.functionBindings.slice(0, 6)"
                            :key="(binding.kind || 'plugin') + ':' + binding.key"
                            size="mini" closable
                            @@close="removeFunctionBinding(binding)">
                            {{ binding.name || binding.key }}
                        </el-tag>
                        <span v-if="agentForm.functionBindings.length > 6" class="form-help-text">
                            {{ ncfST('Frontend.AgentsManager.ValueMoreClickManageBindingsToView', agentForm.functionBindings.length - 6) }}
                        </span>
                    </div>
                </el-form-item>
                <el-form-item v-if="!agentForm.isHuman" :label="ncfST('Frontend.AgentsManager.ConnectorPermissions')">
                    <el-select v-model="agentForm.connectorInstanceIds" multiple filterable clearable style="width:100%"
                               :placeholder="ncfST('Frontend.AgentsManager.DoNotAuthorizeAnyConnector')" :loading="connectorOptionsLoading">
                        <el-option v-for="item in connectorOptions" :key="item.instanceId"
                                   :label="item.name + ' · ' + item.connectorName" :value="item.instanceId"></el-option>
                    </el-select>
                    <div class="form-help-text">{{ ncfST('Frontend.AgentsManager.OnlyConnectorsSelectedHereCanBeCalledByThisAgentLeaveEmpty') }}</div>
                </el-form-item>
                <el-form-item label="MCP Endpoints" prop="mcpEndpoints">
                    <div class="mcp-endpoints-container">
                        <div class="mcp-endpoints-list">
                            <div v-for="(endpoint, name) in parsedMcpEndpoints" :key="name" class="mcp-endpoint-item">
                                <div class="mcp-endpoint-info">
                                    <span class="mcp-endpoint-name">{{name}}</span>
                                    <span class="mcp-endpoint-url">{{endpoint.url}}</span>
                                    <div v-if="endpoint.testResult && endpoint.testResult.success" class="mcp-endpoint-test-result">
                                        <div class="test-status success">{{ ncfST('Frontend.AgentsManager.ConnectedSuccessfully') }}</div>
                                        <el-button size="mini" type="primary" plain @@click="showMcpToolsDialog(endpoint)">
                                            {{ ncfST('Frontend.AgentsManager.ViewTools') }} ({{endpoint.testResult.tools ? endpoint.testResult.tools.length : 0}})
                                        </el-button>
                                    </div>
                                    <div v-else-if="endpoint.testResult && !endpoint.testResult.success" class="mcp-endpoint-test-result">
                                        <div class="test-status failed">{{ ncfST('Frontend.AgentsManager.ConnectionFailed') }} {{endpoint.testResult.message}}</div>
                                    </div>
                                </div>
                                <div class="mcp-endpoint-actions">
                                    <el-button 
                                        size="mini" 
                                        type="success" 
                                        icon="el-icon-connection" 
                                        circle 
                                        @@click="testMcpEndpoint(name, endpoint)"
                                        :loading="endpoint.testing"
                                        style="margin-right: 5px;"
                                        :title="ncfST('Frontend.AgentsManager.TestConnection')">
                                    </el-button>
                                    <el-button 
                                        size="mini" 
                                        type="primary" 
                                        icon="el-icon-edit" 
                                        circle 
                                        @@click="handleMcpEndpointEdit(name, endpoint)"
                                        style="margin-right: 5px;">
                                    </el-button>
                                    <el-button 
                                        size="mini" 
                                        type="danger" 
                                        icon="el-icon-delete" 
                                        circle 
                                        @@click="handleMcpEndpointRemove(name)">
                                    </el-button>
                                </div>
                            </div>
                        </div>
                        
                        <div class="mcp-endpoint-add" v-if="!mcpEndpointInputVisible">
                            <el-button class="button-new-endpoint" size="small" @@click="showMcpEndpointInput">{{ ncfST('Frontend.AgentsManager.AddMCPEndpoint') }}</el-button>
                            <el-button class="button-new-endpoint" size="small" type="primary" plain icon="el-icon-s-order"
                                @@click="openMcpSelectDrawer">{{ ncfST('Frontend.AgentsManager.SelectFromTheMCPList') }}</el-button>
                        </div>
                        
                        <div v-if="mcpEndpointInputVisible" class="mcp-endpoint-input-form">
                            <div class="mcp-endpoint-form-title">{{ mcpEndpointEditMode ? ncfST('Frontend.AgentsManager.EditMCPEndpoint') : ncfST('Frontend.AgentsManager.AddMCPEndpointAlternate') }}</div>
                            <el-input
                                ref="mcpEndpointNameInput"
                                v-model="mcpEndpointNameValue"
                                class="input-endpoint-name"
                                size="small"
                                :placeholder="ncfST('Frontend.AgentsManager.EndpointNameForExampleMcpServerNCFSeven')"
                                style="margin-bottom: 10px; width: 100%">
                            </el-input>
                            
                            <el-input
                                ref="mcpEndpointUrlInput"
                                v-model="mcpEndpointUrlValue"
                                class="input-endpoint-url"
                                size="small"
                                placeholder="Endpoint URL (for example: http://localhost:5000/mcp/sse)"
                                style="margin-bottom: 10px; width: 100%">
                            </el-input>
                            
                            <div class="endpoint-input-actions">
                                <el-button size="small" type="primary" @@click="handleMcpEndpointInputConfirm">{{ ncfST('Frontend.AgentsManager.Confirm') }}</el-button>
                                <el-button size="small" @@click="cancelMcpEndpointInput">{{ ncfST('Frontend.AgentsManager.CancelAlternate') }}</el-button>
                            </div>
                        </div>
                    </div>
                </el-form-item>
                
                <el-form-item :label="ncfST('Frontend.AgentsManager.Notes')" prop="description">
                    <el-input type="textarea" v-model="agentForm.description" :rows="4" :placeholder="ncfST('Frontend.AgentsManager.OptionalVisibleToAdministratorsOnly')"></el-input>
                </el-form-item>
            </el-form>
        </div>
        @* Fixed content footer. *@
        <div class="drawerRtl__footer text-right">
            <el-button :size="elSize" @@click="handleElVisibleClose('drawerAgent')">{{ ncfST('Frontend.AgentsManager.CancelAlternate') }}</el-button>
            <el-button :size="elSize" type="primary" @@click="handleElVisibleSubmit('drawerAgent')">{{ ncfST('Frontend.AgentsManager.OK') }}</el-button>
        </div>
    </div>
</el-drawer>
@* FunctionRender / Workflow / Plugin binding drawer. *@
<el-drawer :visible.sync="visible.drawerFunctionBindings" direction="rtl" :with-header="false"
    :wrapper-closable="false" :close-on-press-escape="false" size="620px">
    <div class="drawerRtl function-binding-drawer">
        <div class="drawerRtl__header">
            <div class="drawerRtl__header__title">
                {{ ncfST('Frontend.AgentsManager.ToolAndWorkflowBindings') }}
                <span class="function-binding-drawer__agent">{{ agentForm.name || ncfST('Frontend.AgentsManager.AddAgent') }}</span>
            </div>
            <div class="drawerRtl__header__close" @@click="visible.drawerFunctionBindings = false">&times;</div>
        </div>
        <div class="drawerRtl__body" v-loading="functionBindingLoading">
            <el-alert type="info" :closable="false" show-icon
                :title="ncfST('Frontend.AgentsManager.OnlyWorkflowsAvailableToTheCurrentAdministratorAreShownPermissionsAndCircular')"
                style="margin-bottom:12px;"></el-alert>
            <el-tabs v-model="functionBindingTab" class="function-binding-tabs">
                <el-tab-pane name="function">
                    <span slot="label"><i class="el-icon-set-up"></i> FunctionRender</span>
                </el-tab-pane>
                <el-tab-pane name="workflow">
                    <span slot="label"><i class="el-icon-s-operation"></i> Workflow</span>
                </el-tab-pane>
                <el-tab-pane name="plugin">
                    <span slot="label"><i class="el-icon-s-tools"></i> {{ ncfST('Frontend.AgentsManager.PluginCompatibility') }}</span>
                </el-tab-pane>
            </el-tabs>
            <el-input v-model="functionBindingSearch" clearable prefix-icon="el-icon-search"
                :placeholder="ncfST('Frontend.AgentsManager.SearchNameModuleOrDescription')" style="margin-bottom:12px;"></el-input>
            <div v-if="!filteredFunctionBindingOptions.length" class="function-binding-empty">
                {{ ncfST('Frontend.AgentsManager.NoBindingsAreAvailableForSelection') }}
            </div>
            <div v-else class="function-binding-option-list">
                <div v-for="option in filteredFunctionBindingOptions"
                    :key="option.kind + ':' + option.key"
                    class="function-binding-option"
                    :class="{'is-unavailable': option.available === false}">
                    <el-checkbox :value="isFunctionBindingSelected(option)"
                        :disabled="option.available === false"
                        @@change="toggleFunctionBinding(option, $event)">
                        <span class="function-binding-option__name">{{ option.name || option.key }}</span>
                        <span class="function-binding-option__meta">
                            <template v-if="option.moduleName">{{ option.moduleName }} · </template>
                            <template v-if="option.parameterCount">Params {{ option.parameterCount }} · </template>
                            {{ option.available === false ? ncfST('Frontend.AgentsManager.ModuleUnavailable') : ncfST('Frontend.AgentsManager.Callable') }}
                        </span>
                    </el-checkbox>
                    <div v-if="option.description" class="function-binding-option__description">
                        {{ option.description }}
                    </div>
                </div>
            </div>
        </div>
        <div class="drawerRtl__footer text-right">
            <span class="function-binding-footer-summary">{{ functionBindingSummary }}</span>
            <el-button :size="elSize" type="primary" @@click="visible.drawerFunctionBindings = false">{{ ncfST('Frontend.AgentsManager.Confirm') }}</el-button>
        </div>
    </div>
</el-drawer>
@* MCP endpoint selection drawer; the MCP module is queried through EventBus. *@
<el-drawer :visible.sync="visible.drawerMcpSelect" direction="rtl" :with-header="false"
    :wrapper-closable="true" size="620px">
    <div class="drawerRtl mcp-select-drawer">
        <div class="drawerRtl__header">
            <div class="drawerRtl__header__title">
                {{ ncfST('Frontend.AgentsManager.SelectFromTheMCPList') }}
                <span class="function-binding-drawer__agent">{{ agentForm.name || ncfST('Frontend.AgentsManager.AddAgent') }}</span>
            </div>
            <div class="drawerRtl__header__close" @@click="visible.drawerMcpSelect = false">&times;</div>
        </div>
        <div class="drawerRtl__body" v-loading="mcpSelectLoading">
            <el-alert v-if="mcpModuleAvailable && mcpEndpointOptions.length" type="info" :closable="false" show-icon
                :title="ncfST('Frontend.AgentsManager.TheseEndpointsComeFromTheMCPModuleRegistrySelectOneToAdd')"
                style="margin-bottom:12px;"></el-alert>
            <el-alert v-else-if="!mcpModuleAvailable && !mcpSelectLoading" type="warning" :closable="false" show-icon
                :title="mcpSelectMessage || ncfST('Frontend.AgentsManager.NoMCPEndpointsAreAvailableForSelection')"
                style="margin-bottom:12px;"></el-alert>
            <el-input v-model="mcpSelectSearch" clearable prefix-icon="el-icon-search"
                :placeholder="ncfST('Frontend.AgentsManager.SearchNameURLOrDescription')" style="margin-bottom:12px;"></el-input>
            <div v-if="!filteredMcpEndpointOptions.length && !mcpSelectLoading" class="function-binding-empty">
                {{ ncfST('Frontend.AgentsManager.NoMCPEndpointsAreAvailableForSelection') }}
            </div>
            <div v-else class="function-binding-option-list">
                <div v-for="option in filteredMcpEndpointOptions"
                    :key="option.id"
                    class="function-binding-option mcp-select-option">
                    <el-checkbox :value="isMcpOptionSelected(option)"
                        @@change="toggleMcpSelect(option, $event)">
                        <span class="function-binding-option__name">{{ option.name }}</span>
                        <span class="function-binding-option__meta">
                            <template v-if="option.endpointType">{{ option.endpointType }} · </template>
                            <template v-if="option.lastTestResult === true">{{ ncfST('Frontend.AgentsManager.Connected') }}</template>
                            <template v-else-if="option.lastTestResult === false">{{ ncfST('Frontend.AgentsManager.ConnectionTestFailedAlternate') }}</template>
                            <template v-else>{{ ncfST('Frontend.AgentsManager.NotTested') }}</template>
                            <template v-if="option.lastToolCount"> · Tools {{ option.lastToolCount }}</template>
                        </span>
                    </el-checkbox>
                    <div class="mcp-select-option__endpoint">{{ option.endpoint }}</div>
                    <div v-if="option.description" class="function-binding-option__description">
                        {{ option.description }}
                    </div>
                </div>
            </div>
        </div>
        <div class="drawerRtl__footer text-right">
            <span class="function-binding-footer-summary">{{ ncfST('Frontend.AgentsManager.ValueEndpointsAreConfigured', Object.keys(parsedMcpEndpoints).length) }}</span>
            <el-button :size="elSize" type="primary" @@click="visible.drawerMcpSelect = false">{{ ncfST('Frontend.AgentsManager.Confirm') }}</el-button>
        </div>
    </div>
</el-drawer>
@* Remote A2A agent management drawer. *@
<el-drawer :visible.sync="visible.drawerRemoteAgent" direction="rtl" :with-header="false" :wrapper-closable="false"
    :close-on-press-escape="false" size="900px">
    <div class="drawerRtl">
        <div class="drawerRtl__header">
            <div class="drawerRtl__header__title"><el-tag type="warning" size="mini">REMOTE A2A</el-tag> {{ ncfST('Frontend.AgentsManager.RemoteAgent') }}</div>
            <div class="drawerRtl__header__close" @@click="visible.drawerRemoteAgent = false">&times;</div>
        </div>
        <div class="drawerRtl__body">
            <div class="df-wn flex-ac flex-jsb" style="gap:10px;margin-bottom:14px;">
                <el-input v-model="remoteAgentQueryList.filter" size="small" :placeholder="ncfST('Frontend.AgentsManager.FilterByName')"
                    @@change="getRemoteAgentListData"></el-input>
                <div class="df-wn flex-ac" style="gap:8px;">
                    <el-button type="warning" plain size="small" icon="el-icon-connection" :loading="remoteAgentBatchTesting"
                        @@click="testAllRemoteAgents">{{ ncfST('Frontend.AgentsManager.TestAll') }}</el-button>
                    <el-button type="primary" size="small" icon="el-icon-plus" @@click="openRemoteAgentEditor()">{{ ncfST('Frontend.AgentsManager.AddRemoteATwoA') }}</el-button>
                </div>
            </div>
            <div class="form-help-text" style="margin-bottom:12px;">{{ ncfST('Frontend.AgentsManager.EnterOnlyTheSecretNameNotTheTokenValue') }}</div>
            <el-table :data="remoteAgentList" max-height="560" style="width:100%;border:1px solid rgba(229,229,229,1);">
                <el-table-column :label="ncfST('Frontend.AgentsManager.Type')" width="105">
                    <template slot-scope="{ row }"><el-tag type="warning" size="mini">{{ ncfST('Frontend.AgentsManager.RemoteATwoAAgents') }}</el-tag></template>
                </el-table-column>
                <el-table-column prop="name" :label="ncfST('Frontend.AgentsManager.Agent')" width="145" show-overflow-tooltip></el-table-column>
                <el-table-column prop="agentCardUrl" :label="ncfST('Frontend.AgentsManager.AgentCardURL')" min-width="220" show-overflow-tooltip></el-table-column>
                <el-table-column :label="ncfST('Frontend.AgentsManager.Connection')" width="90">
                    <template slot-scope="{ row }">
                        <el-tag :type="row.connectionStatus === 1 ? 'success' : (row.connectionStatus === 2 ? 'danger' : 'info')" size="mini">{{ remoteConnectionStatusText(row.connectionStatus) }}</el-tag>
                    </template>
                </el-table-column>
                <el-table-column :label="ncfST('Frontend.AgentsManager.StatusAlternate')" width="75">
                    <template slot-scope="{ row }"><el-tag :type="row.enable ? 'success' : 'info'" size="mini">{{ row.enable ? ncfST('Frontend.AgentsManager.Enabled') : ncfST('Frontend.AgentsManager.Disabled') }}</el-tag></template>
                </el-table-column>
                <el-table-column :label="ncfST('Frontend.AgentsManager.Actions')" width="120" fixed="right" class-name="ncf-table-actions-column">
                    <template slot-scope="{ row }">
                        <el-button type="primary" size="mini" icon="el-icon-edit" @@click="openRemoteAgentEditor(row)">{{ ncfST('Frontend.AgentsManager.Edit') }}</el-button>
                        <el-tooltip :content="ncfST('Frontend.AgentsManager.MoreActions')" placement="top" :open-delay="180">
                            <el-dropdown trigger="click" placement="bottom-end"
                                @@command="handleRemoteAgentAction($event,row)">
                                <el-button type="text" size="mini" icon="el-icon-more"
                                    class="ncf-table-action-more" :title="ncfST('Frontend.AgentsManager.MoreActions')" :aria-label="ncfST('Frontend.AgentsManager.MoreActions')"></el-button>
                                <el-dropdown-menu slot="dropdown">
                                    <el-dropdown-item command="test"
                                        :disabled="remoteAgentBatchTesting || isRemoteAgentTesting(row.id)">
                                        <i :class="isRemoteAgentTesting(row.id) ? 'el-icon-loading' : 'el-icon-connection'"></i>
                                        {{ ncfST('Frontend.AgentsManager.TestConnection') }}
                                    </el-dropdown-item>
                                    <el-dropdown-item command="toggle">
                                        <i :class="row.enable ? 'el-icon-video-pause' : 'el-icon-video-play'"></i>
                                        {{ row.enable ? ncfST('Frontend.AgentsManager.Disabled') : ncfST('Frontend.AgentsManager.Enabled') }}
                                    </el-dropdown-item>
                                    <el-dropdown-item command="delete" divided class="ncf-table-action-danger">
                                        <i class="el-icon-delete"></i> {{ ncfST('Frontend.AgentsManager.Delete') }}
                                    </el-dropdown-item>
                                </el-dropdown-menu>
                            </el-dropdown>
                        </el-tooltip>
                    </template>
                </el-table-column>
            </el-table>
        </div>
    </div>
</el-drawer>
<el-dialog :visible.sync="visible.dialogRemoteAgentEditor" :title="ncfST('Frontend.AgentsManager.ManageRemoteATwoAAgents')" width="620px" :close-on-click-modal="false">
    <el-form v-if="visible.dialogRemoteAgentEditor" ref="remoteAgentELForm" :model="remoteAgentForm" :rules="remoteAgentFormRules" :size="elSize" label-width="150px">
