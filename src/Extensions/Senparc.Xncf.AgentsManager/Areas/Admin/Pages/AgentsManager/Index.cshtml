        <el-form-item :label="ncfST('Frontend.AgentsManager.DescriptionAlternate')"><el-input v-model="remoteAgentForm.description" type="textarea" :rows="3" :placeholder="ncfST('Frontend.AgentsManager.OptionalVisibleToAdministratorsOnly')"></el-input></el-form-item>
    </el-form>
    <span slot="footer">
        <el-button :size="elSize" @@click="closeRemoteAgentEditor">{{ ncfST('Frontend.AgentsManager.OutputTokens') }}</el-button>
        <el-button :size="elSize" type="primary" @@click="saveRemoteAgent">{{ ncfST('Frontend.AgentsManager.InputTokens') }}</el-button>
