                        </el-tooltip>
                    </div>
                    </template>
                    <div v-else class="df-wn flex-ac flex-jc emptyData"
                        style="flex-grow: 1;font-size: 14px;color: #5e6d82;margin-top:150px;">{{ ncfST('Frontend.AgentsManager.NoData') }}</div>
                </el-scrollbar>
            </div>
            @* Main content *@
            <div class="main-container agent-container">
                @* All tasks *@
                <template v-if="scrollbarTaskIndex === ''">
                    <div class="df-wn flex-ac flex-js groupInfoRow">
                        <div class="groupInfoRow-name text-ellipsis">
                            {{ ncfST('Frontend.AgentsManager.Jobs') }}
                        </div>
                        <div class="df-wn groupInfoRow-operation">
                            <el-button type="primary" size="mini"
                                @@click="handleTaskStartBatch('taskBatch')">{{ ncfST('Frontend.AgentsManager.StartSelected') }}</el-button>
                            <el-button type="warning" size="mini"
                                @@click="handleTaskForceStopBatch('taskBatch')">{{ ncfST('Frontend.AgentsManager.StopSelected') }}</el-button>
                            <el-button type="danger" size="mini"
                                @@click="handleTaskDeleteBatch('taskBatch')">{{ ncfST('Frontend.AgentsManager.DeleteSelected') }}</el-button>
                        </div>
                    </div>
                    @* 255 *@
                    <el-table ref="taskList" :data="taskList" key="taskList" :height="`calc(100vh - 300px)`"
                        style="width: 100%;" @@selection-change="handleTaskSelectionChange">
                        <el-table-column type="selection" width="30"></el-table-column>
                        <el-table-column prop="name" :label="ncfST('Frontend.AgentsManager.RunningTask')" min-width="170" show-overflow-tooltip>
                            <template slot-scope="{ row }">
                                <i :class="[taskStateIcon[row.status],taskStateColor[row.status]]"></i>
                                <span>{{ row.name }}</span>
                            </template>
                        </el-table-column>
                        <el-table-column :label="ncfST('Frontend.AgentsManager.Started')" min-width="100">
                            <template slot-scope="{ row }">
                                {{ row.startTime | showFormatDate }}
                            </template>
                        </el-table-column>
                        <el-table-column :label="ncfST('Frontend.AgentsManager.Duration')" width="100">
                            <template slot-scope="{ row }">
                                {{ calculateDuration(row.startTime,row.endTime) }}
                            </template>
                        </el-table-column>
                        <el-table-column prop="modelName" :label="ncfST('Frontend.AgentsManager.ModelName')" min-width="100" show-overflow-tooltip>
                            <template slot-scope="{ row }">
                                {{ row.modelName }}
                            </template>
                        </el-table-column>
                        <el-table-column prop="promptCommand" :label="ncfST('Frontend.AgentsManager.TaskDescription')" min-width="130" show-overflow-tooltip>
                            <template slot-scope="{ row }">
                                {{ row.promptCommand }}
                            </template>
                        </el-table-column>
                        <el-table-column fixed="right" :label="ncfST('Frontend.AgentsManager.Actions')" width="210" class-name="ncf-table-actions-column">
                            <template slot-scope="{ row,$index }">
                                <el-button type="primary" size="mini" icon="el-icon-view"
                                    @@click="handleTaskView('task', row, $index)">{{ ncfST('Frontend.AgentsManager.Details') }}</el-button>
                                <el-button type="primary" size="mini" icon="el-icon-refresh-right"
                                    @@click="handleTaskAgain('task', row)">{{ ncfST('Frontend.AgentsManager.RunAgain') }}</el-button>
                                <el-tooltip :content="ncfST('Frontend.AgentsManager.MoreActions')" placement="top" :open-delay="180">
                                    <el-dropdown trigger="click" placement="bottom-end"
                                        @@command="handleTaskAction($event,'task',row,$index)">
                                    <el-button type="text" size="mini" icon="el-icon-more"
                                        class="ncf-table-action-more" :title="ncfST('Frontend.AgentsManager.MoreActions')" :aria-label="ncfST('Frontend.AgentsManager.MoreActions')"></el-button>
                                        <el-dropdown-menu slot="dropdown">
                                            <el-dropdown-item command="parameters">
                                                <i class="el-icon-user"></i> {{ ncfST('Frontend.AgentsManager.AgentParameters') }}
                                            </el-dropdown-item>
                                            <el-dropdown-item v-if="canForceStopTask(row)" command="force-stop">
                                                <i class="el-icon-video-pause"></i> {{ ncfST('Frontend.AgentsManager.ForceStop') }}
                                            </el-dropdown-item>
                                        <el-dropdown-item command="delete" divided class="ncf-table-action-danger">
                                                <i class="el-icon-delete"></i> {{ ncfST('Frontend.AgentsManager.Delete') }}
                                            </el-dropdown-item>
                                        </el-dropdown-menu>
                                    </el-dropdown>
                                </el-tooltip>
                            </template>
                        </el-table-column>
                    </el-table>
                </template>
                <template v-else-if="taskDetails">
                    <div class="df-wn flex-ac flex-js task-header">
                        <div class="task-header_left">
                            <div class="task-header1 text-ellipsis" :title="taskDetails.name">
                                {{ taskDetails.name }}
                            </div>
                            <div class="task-header2" style="flex-shrink: 0;">
                                <i :class="[taskStateIcon[taskDetails.status],taskStateColor[taskDetails.status]]"></i>
                                {{ taskStateText[taskDetails.status] }}
                            </div>
                        </div>
                        @* type="text" *@
                        <div class="task-header_right">
                            <el-button type="primary" size="mini"
                                @@click="viewAgentParameters('taskDetail')">{{ ncfST('Frontend.AgentsManager.AgentParameters') }}</el-button>
                            <el-button type="info" size="mini"
                                @@click="openUsageAnalytics('task',taskDetails)">{{ ncfST('Frontend.AgentsManager.TaskUsageAnalytics') }}</el-button>
                            <el-button type="primary" size="mini"
                                @@click="handleTaskAgain('task',taskDetails)">{{ ncfST('Frontend.AgentsManager.RunAgain') }}</el-button>
                            <el-button type="warning" size="mini"
                                @@click="handleTaskForceStop('task',taskDetails)">{{ ncfST('Frontend.AgentsManager.ForceStop') }}</el-button>
                        </div>
                    </div>
                    <div class="df flex-ac flex-jc task-info">
                        <div class="itembox">
                            <div class="lable">{{ ncfST('Frontend.AgentsManager.TaskStartTime') }}</div>
                            <div class="value">{{ taskDetails.startTime |
                                showFormatDate }}
                            </div>
                        </div>
                        <div class="itembox">
                            <div class="lable">{{ ncfST('Frontend.AgentsManager.Model') }}</div>
                            <div class="value">{{ taskDetails.modelName }}</div>
                        </div>
                        <div class="itembox">
                            <div class="lable">{{ ncfST('Frontend.AgentsManager.TaskDescriptionLabel') }}</div>
                            <div class="value">
                                <span class="text-ellipsis">{{ taskDetails.promptCommand }}</span>
                                @* Details button *@
                                <el-button type="text" size="mini"
                                    @@click="viewTaskDescription(taskDetails)">{{ ncfST('Frontend.AgentsManager.Details') }}</el-button>
                            </div>
                        </div>
                        <div class="itembox">
                            <div class="lable">{{ ncfST('Frontend.AgentsManager.TaskEndTime') }}</div>
                            <div class="value">{{ taskDetails.endTime |
                                showFormatDate }}</div>
                        </div>
                        <div class="itembox">
                            <div class="lable">{{ ncfST('Frontend.AgentsManager.ScoreLabel') }}</div>
                            <div class="value">{{ taskDetails.score }}</div>
                        </div>
                        <div class="itembox">
                            <div class="lable">{{ ncfST('Frontend.AgentsManager.TaskReview') }}</div>
                            <div class="value">
                                @* Edit button *@
                                <el-button type="text" size="mini" @@click="taskEvaluation(taskDetails)">{{ ncfST('Frontend.AgentsManager.Edit') }}</el-button>
                            </div>
                        </div>
                    </div>
                    <div class="df-wn task-main">
                        <div class="taskmain-record">
                            <el-scrollbar ref="taskHistoryScrollbar" class="sidebar-taskrecord-container"
                                wrap-class="scrollbar-wrapper">
                                <div class="df-wn flex-dc taskrecord-listWrap">
                                    <div v-if="isTaskConversationLoading('task')" class="taskrecord-state" role="status">
                                        <i class="el-icon-loading"></i>
                                        <span>{{ ncfT('AgentsManager.Studio.LoadingConversation') }}</span>
                                    </div>
                                    <div v-else-if="!taskHistoryList.length" class="taskrecord-state">
                                        <i class="el-icon-chat-line-square"></i>
                                        <span>{{ ncfT('AgentsManager.Studio.NoConversationRecords') }}</span>
                                    </div>
                                    <div v-for="ritem in taskHistoryList" :key="ritem.id"
                                        :class="['taskrecord-listWrap-item', { 'taskrecord-listWrap-item-streaming': ritem._streaming }]"
                                        :data-history-id="ritem.id"
                                        v-show="historyMatchesMemberFilter(ritem, taskMemberfilter, taskMemberfilterList)">
                                        <div class="taskrecord-listWrap-item-head">
                                            <div class="taskrecord-item-meta-top">
                                                <span class="df-wn flex-ac flex-jc avatarBox">
                                                    <img :src="getTaskSenderInfo('task',ritem).avastar | showAvatar"
                                                        alt="">
                                                </span>
                                                <span class="name">{{ getTaskSenderName('task', ritem) }}</span>
                                                <span class="time">{{ ritem.addTime | showFormatDate }}</span>
                                                <span class="usage-inline" v-if="ritem.totalTokens || ritem.responseMilliseconds">{{ formatTaskHistoryUsage(ritem) }}</span>
                                            </div>
                                        </div>
                                        <task-html-renderer :content="ritem.messageHtml" />
                                    </div>
                                </div>
                            </el-scrollbar>
                        </div>
                        <div class="taskmain-members">
                            <div class="taskmain-members-usage">
                                <div class="taskmain-members-usage-title">{{ ncfST('Frontend.AgentsManager.UsageOverview') }}</div>
                                <div class="taskmain-members-usage-list">
                                    <div class="taskmain-members-usage-item">
                                        <span class="taskmain-members-usage-label">{{ ncfST('Frontend.AgentsManager.TotalMessages') }}</span>
                                        <span class="taskmain-members-usage-value">{{ formatUsageCount(taskUsageSummaryByType.task.messageCount) }}</span>
                                    </div>
                                    <div class="taskmain-members-usage-item">
                                        <span class="taskmain-members-usage-label">{{ ncfST('Frontend.AgentsManager.TotalTokenInputOutput') }}</span>
                                        <span class="taskmain-members-usage-value">{{ formatUsageCount(taskUsageSummaryByType.task.totalTokens) }}</span>
                                    </div>
                                    <div class="taskmain-members-usage-item">
                                        <span class="taskmain-members-usage-label">{{ ncfST('Frontend.AgentsManager.AverageResponseTime') }}</span>
                                        <span class="taskmain-members-usage-value">{{ formatResponseMilliseconds(taskUsageSummaryByType.task.averageResponseMilliseconds) }}</span>
                                    </div>
                                    <div class="taskmain-members-usage-item">
                                        <span class="taskmain-members-usage-label">{{ ncfST('Frontend.AgentsManager.MaximumDuration') }}</span>
                                        <span class="taskmain-members-usage-value">{{ formatResponseMilliseconds(taskUsageSummaryByType.task.maxResponseMilliseconds) }}</span>
                                    </div>
                                </div>
                            </div>
                            <el-input v-model="taskMemberfilter" :placeholder="ncfST('Frontend.AgentsManager.SearchByName')" suffix-icon="el-icon-search" style="margin-bottom: 15px;" @@input="handleTaskFilterChange($event,'task')"></el-input>
                            <div class="taskmain-members-title">
                                {{ ncfST('Frontend.AgentsManager.HumanParticipant') }}：{{ taskHumanParticipantStatusText(taskDetails) }} · {{ ncfST('Frontend.AgentsManager.Agents') }}{{ taskMemberList ? taskMemberList.length : 0 }}
                            </div>
                            <el-scrollbar class="sidebar-taskmembers-container" wrap-class="scrollbar-wrapper">
                                <div class="df-wn flex-dc taskmain-members-listWrap">
                                    <participant-quick-action
                                        v-for="mitem in taskMemberList"
                                        :key="mitem.participantKey || ('local-' + mitem.id)"
                                        v-show="mitem.name.includes(taskMemberfilter)"
                                        :participant="mitem"
                                        :quick-info="getParticipantQuickInfo('task', mitem)"
                                        :testing="isRemoteAgentTesting(mitem.id)"
                                        @@edit-agent="openParticipantAgentEditor(mitem)"
                                        @@test-remote="testTaskRemoteAgent(mitem)">
                                    </participant-quick-action>
                                </div>
                            </el-scrollbar>
                        </div>
                    </div>
                </template>
                <div v-else class="df-wn flex-ac flex-jc emptyData"
                    style="flex-grow: 1;font-size: 14px;color: #5e6d82;margin-top:150px;">{{ ncfST('Frontend.AgentsManager.NoData') }}</div>
            </div>
        </div>
    </el-tab-pane>
</el-tabs>

<el-dialog :title="ncfST('Frontend.AgentsManager.TaskUsageAnalytics')" :visible.sync="usageAnalyticsVisible" width="86%" :close-on-click-modal="false">
    <div class="usage-analytics-toolbar">
        <span class="usage-analytics-title">{{ ncfST('Frontend.AgentsManager.Task') }}{{ usageAnalyticsTaskName }}（#{{ usageAnalyticsTaskId }}）</span>
        <el-date-picker
            v-model="usageAnalyticsDateRange"
            type="datetimerange"
            :range-separator="ncfST('Frontend.AgentsManager.To')"
            :start-placeholder="ncfST('Frontend.AgentsManager.Started')"
            :end-placeholder="ncfST('Frontend.AgentsManager.Finished')"
            value-format="yyyy-MM-dd HH:mm:ss"
            size="mini">
        </el-date-picker>
        <el-select v-model="usageAnalyticsAgentId" clearable filterable size="mini" :placeholder="ncfST('Frontend.AgentsManager.AllAgentsAlternate')">
            <el-option v-for="item in usageAnalyticsAgentOptions" :key="'usage-agent-' + item.id" :label="item.name" :value="item.id"></el-option>
        </el-select>
        <el-button size="mini" type="primary" @@click="loadUsageAnalytics">{{ ncfST('Frontend.AgentsManager.Search') }}</el-button>
        <el-button size="mini" @@click="resetUsageAnalyticsFilters">{{ ncfST('Frontend.AgentsManager.Reset') }}</el-button>
    </div>

    <div class="usage-analytics-overview" v-loading="usageAnalyticsLoading">
        <div class="usage-card">
            <div class="label">{{ ncfST('Frontend.AgentsManager.TotalMessages') }}</div>
            <div class="value">{{ usageAnalyticsData.overview.messageCount || 0 }}</div>
        </div>
        <div class="usage-card">
            <div class="label">{{ ncfST('Frontend.AgentsManager.TotalToken') }}</div>
            <div class="value">{{ usageAnalyticsData.overview.totalTokens || 0 }}</div>
        </div>
        <div class="usage-card">
            <div class="label">{{ ncfST('Frontend.AgentsManager.InputOutputToken') }}</div>
            <div class="value">{{ usageAnalyticsData.overview.promptTokens || 0 }} / {{ usageAnalyticsData.overview.completionTokens || 0 }}</div>
        </div>
        <div class="usage-card">
            <div class="label">{{ ncfST('Frontend.AgentsManager.AverageResponseTime') }}</div>
            <div class="value">{{ Number(usageAnalyticsData.overview.averageResponseMilliseconds || 0).toFixed(1) }} ms</div>
        </div>
        <div class="usage-card">
            <div class="label">{{ ncfST('Frontend.AgentsManager.P95MaxDuration') }}</div>
            <div class="value">{{ usageAnalyticsData.overview.p95ResponseMilliseconds || 0 }} / {{ usageAnalyticsData.overview.maxResponseMilliseconds || 0 }} ms</div>
        </div>
    </div>

    <el-tabs>
        <el-tab-pane :label="ncfST('Frontend.AgentsManager.ConversationRounds')">
            <el-table :data="usageAnalyticsData.roundStats" size="mini" height="280">
                <el-table-column prop="roundIndex" :label="ncfST('Frontend.AgentsManager.Round')" width="80"></el-table-column>
                <el-table-column prop="messageCount" :label="ncfST('Frontend.AgentsManager.Messages')" width="90"></el-table-column>
                <el-table-column prop="promptTokens" :label="ncfST('Frontend.AgentsManager.InputTokens')" width="110"></el-table-column>
                <el-table-column prop="completionTokens" :label="ncfST('Frontend.AgentsManager.OutputTokens')" width="110"></el-table-column>
                <el-table-column prop="totalTokens" :label="ncfST('Frontend.AgentsManager.TotalToken')" width="110"></el-table-column>
                <el-table-column :label="ncfST('Frontend.AgentsManager.AverageResponseMs')">
                    <template slot-scope="{ row }">{{ Number(row.averageResponseMilliseconds || 0).toFixed(1) }}</template>
                </el-table-column>
            </el-table>
        </el-tab-pane>
        <el-tab-pane :label="ncfST('Frontend.AgentsManager.IndividualAgents')">
            <el-table :data="usageAnalyticsData.agentStats" size="mini" height="280">
                <el-table-column prop="agentTemplateId" label="Agent ID" width="95"></el-table-column>
                <el-table-column prop="agentName" label="Agent"></el-table-column>
                <el-table-column prop="messageCount" :label="ncfST('Frontend.AgentsManager.Messages')" width="90"></el-table-column>
                <el-table-column prop="totalTokens" :label="ncfST('Frontend.AgentsManager.TotalToken')" width="120"></el-table-column>
                <el-table-column :label="ncfST('Frontend.AgentsManager.AverageResponseMs')" width="140">
                    <template slot-scope="{ row }">{{ Number(row.averageResponseMilliseconds || 0).toFixed(1) }}</template>
                </el-table-column>
            </el-table>
        </el-tab-pane>
        <el-tab-pane :label="ncfST('Frontend.AgentsManager.ByTime')">
            <el-table :data="usageAnalyticsData.timelineStats" size="mini" height="280">
                <el-table-column :label="ncfST('Frontend.AgentsManager.TimeBucketHours')" min-width="180">
                    <template slot-scope="{ row }">{{ row.bucketTime | showFormatDate }}</template>
                </el-table-column>
                <el-table-column prop="messageCount" :label="ncfST('Frontend.AgentsManager.Messages')" width="90"></el-table-column>
                <el-table-column prop="totalTokens" :label="ncfST('Frontend.AgentsManager.TotalToken')" width="120"></el-table-column>
                <el-table-column :label="ncfST('Frontend.AgentsManager.AverageResponseMs')" width="140">
                    <template slot-scope="{ row }">{{ Number(row.averageResponseMilliseconds || 0).toFixed(1) }}</template>
                </el-table-column>
            </el-table>
        </el-tab-pane>
    </el-tabs>
</el-dialog>

@* Agent create/edit drawer (540px). *@
<el-drawer :visible.sync="visible.drawerAgent" direction="rtl" :with-header="false" :wrapper-closable="false"
    :close-on-press-escape="false" size="960px">
    <div class="drawerRtl">
        @* Content header, including the title and close icon. *@
        <div class="drawerRtl__header">
            <div class="drawerRtl__header__title">{{ agentForm.id ? ncfST('Frontend.AgentsManager.EditAgent') : ncfST('Frontend.AgentsManager.AddAgent') }}</div>
            <div class="drawerRtl__header__close" @@click="handleElVisibleClose('drawerAgent')">&times;</div>
        </div>
        @* Main content area. *@
        <div class="drawerRtl__body">
            <el-form v-if="visible.drawerAgent" ref="agentELForm" :model="agentForm" :rules="agentFormRules"
                :size="elSize" label-position="left" label-width="130px" class="drawerForm-container">
                <el-alert v-if="agentForm.isSystemAgent"
                          :title="ncfST('Frontend.AgentsManager.SystemAgentValue', agentForm.systemAgentKind || agentForm.name)"
                          :description="agentForm.isHuman ? ncfST('Frontend.AgentsManager.HumanInputIsProvidedByTheSignedInUserNoModelOr') : ncfST('Frontend.AgentsManager.SystemAgentsAreCreatedOrMaintainedByModulesForExamplePromptCatalyzerConfirm')"
                          type="info"
                          :closable="false"
                          show-icon
                          style="margin-bottom:16px;"></el-alert>
                <el-form-item :label="ncfST('Frontend.AgentsManager.AgentName')" prop="name">
                    <div class="agentNameFormField">
                        <el-input v-model="agentForm.name" :placeholder="ncfST('Frontend.AgentsManager.PleaseFillIn')" :disabled="agentForm.isHuman"></el-input>
                        <el-button v-if="agentForm.id && !agentForm.isHuman" size="small" type="danger" plain icon="el-icon-delete"
                            @@click="handleAgentDelete(agentForm, { closeEditor: true })">{{ ncfST('Frontend.AgentsManager.Delete') }}</el-button>
                    </div>
                </el-form-item>
                <el-form-item v-if="!agentForm.isHuman" label="SystemMessage" required>
                    <el-radio-group v-model="agentForm.systemMessageType" @@change="handleSystemMessageTypeChange">
                        <el-radio label="1" border>{{ ncfST('Frontend.AgentsManager.Select') }}</el-radio>
                        <el-radio label="2" border>{{ ncfST('Frontend.AgentsManager.Manual') }}</el-radio>
                    </el-radio-group>
                </el-form-item>
                <el-form-item v-if="!agentForm.isHuman && agentForm.systemMessageType === '1'" :label="ncfST('Frontend.AgentsManager.Select')" prop="systemMessage">
                    @* @change="handleChange($event,'')" *@
                    <load-more-select v-model="agentForm.systemMessage" service-type="systemMessage"
                        direction="vertical" :placeholder="ncfST('Frontend.AgentsManager.SelectAlternate')" @@options-loaded="handleSystemMessageOptionsLoaded" />
                </el-form-item>
                <el-form-item v-if="!agentForm.isHuman && agentForm.systemMessageType === '2'" :label="ncfST('Frontend.AgentsManager.ManualEntry')" prop="systemMessage">
                    <el-input
                       type="textarea"
                       v-model="agentForm.systemMessage"  
                       @@change="handleIdentify"  
                       :placeholder="ncfST('Frontend.AgentsManager.PleaseFillIn')"
                       :rows="4">  
                    </el-input>
                    <div v-if="agentForm.id && !agentForm.isHuman" style="margin-top:8px;">
                        <el-button size="small" type="primary" plain icon="el-icon-magic-stick"
                                   :loading="agentPromptConversionLoading"
                                   @@click="convertAgentPromptToPromptRange">{{ ncfST('Frontend.AgentsManager.GenerateInPromptRangeAndRunScoring') }}</el-button>
                        <div class="form-help-text">{{ ncfST('Frontend.AgentsManager.CreateAPromptRangeWithTheCurrentPlainTextPromptAndSelected') }}</div>
                    </div>
                </el-form-item>
                <el-form-item :label="ncfST('Frontend.AgentsManager.BindModel')" prop="modelBinding">
                    <el-radio-group v-model="agentForm.modelBinding" @@change="handleAgentModelBindingChange">
                        <el-radio :label="0" border :disabled="agentForm.isHuman">{{ ncfST('Frontend.AgentsManager.InheritFromPromptRange') }}</el-radio>
                        <el-radio :label="1" border>{{ ncfST('Frontend.AgentsManager.FollowGroupTask') }}</el-radio>
                        <el-radio :label="2" border>{{ ncfST('Frontend.AgentsManager.SelectAIModelManually') }}</el-radio>
                    </el-radio-group>
                    <div v-if="agentForm.modelBinding === 2" style="margin-top:10px;">
                        <load-more-select v-model="agentForm.aiModelId" service-type="model" :chat-only="true"
                                          direction="vertical" :placeholder="ncfST('Frontend.AgentsManager.SelectAChatModel')" />
                    </div>
                    <div class="form-help-text" v-if="agentForm.systemMessageType === '2' && !agentForm.isHuman">{{ ncfST('Frontend.AgentsManager.ThisManualPromptHasNoInheritablePromptRangeModelSelectAChatAIModel') }}</div>
                    <div class="form-help-text" v-else-if="agentForm.isHuman">{{ ncfST('Frontend.AgentsManager.HumanDoesNotCallAModelThisBindingPreservesTheSystemAgentAlternate') }}</div>
                </el-form-item>
                <el-form-item v-if="!agentForm.isHuman" :label="ncfST('Frontend.AgentsManager.EnabledAlternate')" prop="enable">
                    <el-checkbox v-model="agentForm.enable">{{ ncfST('Frontend.AgentsManager.EnableAgent') }}</el-checkbox>
                </el-form-item>
                <el-form-item v-if="agentForm.id && !agentForm.isHuman" label="A2A">
                    <el-button size="small" type="warning" plain icon="el-icon-connection" @@click="openPublishedA2AEditor(agentForm)">{{ ncfST('Frontend.AgentsManager.ConfigurePublishAsATwoAAgent') }}</el-button>
                    <div class="form-help-text">{{ ncfST('Frontend.AgentsManager.PublishingCreatesAStandardAgentCardDiscoverableAndCallableByAnyA') }}</div>
                </el-form-item>
                <el-form-item :label="ncfST('Frontend.AgentsManager.BindKnowledgeBase')" prop="knowledgeBaseId">
                    <el-select v-model="agentForm.knowledgeBaseId" clearable filterable style="width:100%" :placeholder="ncfST('Frontend.AgentsManager.DoNotBindAKnowledgeBase')">
                        <el-option v-for="item in knowledgeBaseOptions" :key="item.id"
                            :label="getKnowledgeBaseOptionLabel(item)"
                            :value="item.id" :disabled="!item.isEmbedded"></el-option>
                    </el-select>
                    <div v-if="agentForm.knowledgeBaseId" class="knowledgeBase-shortcuts">
                        <el-tag size="mini" :type="getKnowledgeBaseBindingInfo(agentForm.knowledgeBaseId).type">
                            {{ getKnowledgeBaseBindingInfo(agentForm.knowledgeBaseId).text }}
                        </el-tag>
                        <el-button size="mini" type="primary" plain icon="el-icon-folder-opened"
                            @@click="openKnowledgeBase(agentForm.knowledgeBaseId, 'materials')">{{ ncfST('Frontend.AgentsManager.ManageMaterials') }}</el-button>
                        <el-button size="mini" plain icon="el-icon-setting"
                            @@click="openKnowledgeBase(agentForm.knowledgeBaseId, 'edit')">{{ ncfST('Frontend.AgentsManager.EditSettings') }}</el-button>
                        <el-button size="mini" type="text" icon="el-icon-refresh"
                            @@click="refreshKnowledgeBaseOptions">{{ ncfST('Frontend.AgentsManager.RefreshStatus') }}</el-button>
                    </div>
                    <div class="form-help-text">
                        {{ ncfST('Frontend.AgentsManager.AfterBindingRAGRetrievalRunsBeforeModelCallsModelFallbackRemainsAvailable') }}
                        <template v-if="getKnowledgeBaseBindingInfo(agentForm.knowledgeBaseId).status === 'legacy'">{{ ncfST('Frontend.AgentsManager.LegacyVectorDataMustBeReVectorizedInTheKnowledgeBaseBefore') }}</template>
