                                        <div class="test-status success">{{ ncfST('Frontend.114') }}</div>
                                        <el-button size="mini" type="primary" plain @@click="showMcpToolsDialog(endpoint)">
                                            {{ ncfST('Frontend.115') }} ({{endpoint.testResult.tools ? endpoint.testResult.tools.length : 0}})
                                        </el-button>
                                    </div>
                                    <div v-else-if="endpoint.testResult && !endpoint.testResult.success" class="mcp-endpoint-test-result">
                                        <div class="test-status failed">{{ ncfST('Frontend.116') }} {{endpoint.testResult.message}}</div>
                                    </div>
                                </div>
                                <div class="mcp-endpoint-actions">
                                    <el-button 
                                        size="mini" 
                                        type="success" 
                                        icon="el-icon-connection" 
                                        circle 
