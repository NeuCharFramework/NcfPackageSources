@page
@model Senparc.Xncf.Sandbox.Areas.Sandbox.Pages.Setup
@using Microsoft.Extensions.Localization
@using Senparc.Xncf.Sandbox
@inject IStringLocalizer<SandboxResource> XR
@{
    ViewData["Title"] = $"{Model.XncfRegister.MenuName} - {XR["Frontend.Sandbox.EnvironmentSetup"]}";
    Layout = "_Layout_Vue";
}

@section breadcrumbs{
    <el-breadcrumb-item>@XR["Frontend.Sandbox.ExtensionModules"]</el-breadcrumb-item>
    <el-breadcrumb-item>@Model.XncfRegister.MenuName</el-breadcrumb-item>
    <el-breadcrumb-item>@XR["Frontend.Sandbox.EnvironmentSetup"]</el-breadcrumb-item>
}

<div>
    <el-container>
        <el-header class="module-header">
            <span class="start-title"><i class="fa fa-wrench"></i>&nbsp;<span class="module-header-v">{{ ncfST('Frontend.Sandbox.EnvironmentSetup') }}</span></span>
        </el-header>
        <el-main>
            <el-alert
                :title="dockerAvailable ? ncfST('Frontend.Sandbox.DockerIsReadyYouCanContinueCreatingSandboxes') : ncfST('Frontend.Sandbox.DockerIsNotReadyCompleteTheManualInstallationAndPrePullThe')"
                :type="dockerAvailable ? 'success' : 'warning'"
                :closable="false"
                show-icon>
            </el-alert>

            <el-card shadow="never" style="margin-top:16px;">
                <div slot="header" class="clearfix">
                    <span>{{ ncfST('Frontend.Sandbox.LocalCheck') }}</span>
                    <el-button style="float:right;padding:3px 0" type="text" @@click="probe">{{ ncfST('Frontend.Sandbox.CheckAgain') }}</el-button>
                </div>
                <p><strong>{{ ncfST('Frontend.Sandbox.StatusLabel') }}</strong>{{ dockerAvailable ? ncfST('Frontend.Sandbox.Available') : ncfST('Frontend.Sandbox.Unavailable') }}</p>
                <p style="color:#666;">{{ statusMessage }}</p>
                <p style="margin-top:8px;">
                    <strong>{{ ncfST('Frontend.Sandbox.ImageRegistryPrefixLabel') }}</strong>
                    <span v-if="hasRegistryPrefix">{{ registryPrefix }}</span>
                    <span v-else style="color:#888;">{{ ncfST('Frontend.Sandbox.NotConfiguredPublicDefaultImagesAreUsedSeeDocumentation') }}</span>
                </p>
            </el-card>

            <el-card shadow="never" style="margin-top:16px;">
                <div slot="header">{{ ncfST('Frontend.Sandbox.ManualConfigurationChecklistSummary') }}</div>
                <ol style="line-height:1.8;padding-left:20px;">
                    <li>{{ ncfST('Frontend.Sandbox.InstallAndStartDockerOrACompatibleCLIOnTheSameMachineAlternate') }}</li>
                    <li>{{ ncfST('Frontend.Sandbox.PrePullTheRequiredImagesAccordingToTheOfficialDocumentationUseThe') }}</li>
                    <li>{{ ncfST('Frontend.Sandbox.ForAnInternalRegistryConfigureThePrefixOrOverridesInSenparcXncfSandboxImages') }}</li>
                    <li>{{ ncfST('Frontend.Sandbox.AfterTheCheckPassesOpenTheModuleFunctionCreateSandboxChoosePython') }}</li>
                </ol>
                <p style="margin-top:12px;">
                    <ncf-doc-help topic="sandbox.setup"></ncf-doc-help>
                    <a
                        class="el-button el-button--default"
                        href="/Admin/Sandbox/Index?uid=@Model.XncfModuleUid"
                        @@click.prevent="openSandboxPanel">
                        {{ ncfST('Frontend.Sandbox.OpenSandboxPanel') }}
                    </a>
                </p>
                <p style="color:#888;font-size:12px;margin-top:8px;">
                    {{ ncfST('Frontend.Sandbox.Documentation') }}<a :href="docsUrl" target="_blank" rel="noopener">{{ docsUrl }}</a>
                </p>
            </el-card>
        </el-main>
    </el-container>
</div>

@section scripts{
    @await Html.PartialAsync("_LocalizationScripts")
    <script>
        new Vue({
            el: "#app",
            data() {
                return {
                    moduleUid: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.XncfModuleUid)),
                    dockerAvailable: @(Model.DockerAvailable ? "true" : "false"),
                    statusMessage: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DockerStatusMessage)),
                    docsUrl: NcfDocHelp.resolve('sandbox.setup', document.documentElement.lang),
                    hasRegistryPrefix: @(Model.HasRegistryPrefix ? "true" : "false"),
                    registryPrefix: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RegistryPrefix ?? ""))
                };
            },
            methods: {
                openSandboxPanel() {
                    const href = '/Admin/Sandbox/Index?uid=' + encodeURIComponent(this.moduleUid);
                    const parentWindow = window.parent;
                    if (parentWindow !== window &&
                        typeof parentWindow.ncfOpenAdminPage === 'function') {
                        parentWindow.ncfOpenAdminPage(href, ncfST('Frontend.Sandbox.OpenSandboxPanel'));
                        return;
                    }

                    window.location.assign(href);
                },
                async probe() {
                    const res = await axios.get('?handler=Probe');
                    if (res.data) {
                        this.dockerAvailable = !!res.data.dockerAvailable;
                        this.statusMessage = res.data.message || '';
                        this.hasRegistryPrefix = !!res.data.hasRegistryPrefix;
                        this.registryPrefix = res.data.registryPrefix || '';
                    }
                }
            }
        });
    </script>
}
