@page
@model Senparc.Xncf.Sandbox.Areas.Sandbox.Pages.Setup
@using Microsoft.Extensions.Localization
@using Senparc.Xncf.Sandbox
@inject IStringLocalizer<SandboxResource> XR
@{
    ViewData["Title"] = $"{Model.XncfRegister.MenuName} - {XR["Frontend.004"]}";
    Layout = "_Layout_Vue";
}

@section breadcrumbs{
    <el-breadcrumb-item>@XR["Frontend.001"]</el-breadcrumb-item>
    <el-breadcrumb-item>@Model.XncfRegister.MenuName</el-breadcrumb-item>
    <el-breadcrumb-item>@XR["Frontend.004"]</el-breadcrumb-item>
}

<div>
    <el-container>
        <el-header class="module-header">
            <span class="start-title"><i class="fa fa-wrench"></i>&nbsp;<span class="module-header-v">{{ ncfST('Frontend.004') }}</span></span>
        </el-header>
        <el-main>
            <el-alert
                :title="dockerAvailable ? ncfST('Frontend.092') : ncfST('Frontend.093')"
                :type="dockerAvailable ? 'success' : 'warning'"
                :closable="false"
                show-icon>
            </el-alert>

            <el-card shadow="never" style="margin-top:16px;">
                <div slot="header" class="clearfix">
                    <span>{{ ncfST('Frontend.051') }}</span>
                    <el-button style="float:right;padding:3px 0" type="text" @@click="probe">{{ ncfST('Frontend.052') }}</el-button>
                </div>
                <p><strong>{{ ncfST('Frontend.072') }}</strong>{{ dockerAvailable ? ncfST('Frontend.053') : ncfST('Frontend.054') }}</p>
                <p style="color:#666;">{{ statusMessage }}</p>
                <p style="margin-top:8px;">
                    <strong>{{ ncfST('Frontend.080') }}</strong>
                    <span v-if="hasRegistryPrefix">{{ registryPrefix }}</span>
                    <span v-else style="color:#888;">{{ ncfST('Frontend.056') }}</span>
                </p>
            </el-card>

            <el-card shadow="never" style="margin-top:16px;">
                <div slot="header">{{ ncfST('Frontend.057') }}</div>
                <ol style="line-height:1.8;padding-left:20px;">
                    <li>{{ ncfST('Frontend.094') }}</li>
                    <li>{{ ncfST('Frontend.070') }}</li>
                    <li>{{ ncfST('Frontend.095') }}</li>
                    <li>{{ ncfST('Frontend.071') }}</li>
                </ol>
                <p style="margin-top:12px;">
                    <ncf-doc-help topic="sandbox.setup"></ncf-doc-help>
                    <a class="el-button el-button--default" href="/Admin/Sandbox/Index?uid=@Model.XncfModuleUid">{{ ncfST('Frontend.058') }}</a>
                </p>
                <p style="color:#888;font-size:12px;margin-top:8px;">
                    {{ ncfST('Frontend.059') }}<a :href="docsUrl" target="_blank" rel="noopener">{{ docsUrl }}</a>
                </p>
            </el-card>
        </el-main>
    </el-container>
</div>

@section scripts{
    @await Html.PartialAsync("_LocalizationScripts")
    <script>
        new Vue({
            el: "#app",
            data() {
                return {
                    dockerAvailable: @(Model.DockerAvailable ? "true" : "false"),
                    statusMessage: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DockerStatusMessage)),
                    docsUrl: NcfDocHelp.resolve('sandbox.setup', document.documentElement.lang),
                    hasRegistryPrefix: @(Model.HasRegistryPrefix ? "true" : "false"),
                    registryPrefix: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RegistryPrefix ?? ""))
                };
            },
            methods: {
                async probe() {
                    const res = await axios.get('?handler=Probe');
                    if (res.data) {
                        this.dockerAvailable = !!res.data.dockerAvailable;
                        this.statusMessage = res.data.message || '';
                        this.hasRegistryPrefix = !!res.data.hasRegistryPrefix;
                        this.registryPrefix = res.data.registryPrefix || '';
                    }
                }
            }
        });
    </script>
}
