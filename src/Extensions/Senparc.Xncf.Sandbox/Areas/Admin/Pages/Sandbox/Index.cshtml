@page
@model Senparc.Xncf.Sandbox.Areas.Sandbox.Pages.Index
@{
    ViewData["Title"] = $"{Model.XncfRegister.MenuName}";
    Layout = "_Layout_Vue";
}

@section Style{
    <link href="~/css/Sandbox/index.css" rel="stylesheet" />
}

@section breadcrumbs{
    <el-breadcrumb-item>扩展模块</el-breadcrumb-item>
    <el-breadcrumb-item>@Model.XncfRegister.MenuName</el-breadcrumb-item>
    <el-breadcrumb-item>面板</el-breadcrumb-item>
}

<div class="sandboxPage" v-cloak>
    @Html.AntiForgeryToken()

    <section class="sandboxHero" aria-labelledby="sandbox-page-title">
        <div class="sandboxHeroCopy">
            <div class="sandboxEyebrow"><i class="fa fa-cube"></i> Sandbox Runtime</div>
            <h1 id="sandbox-page-title">沙箱面板</h1>
            <p>集中查看会话状态，并通过模块 Function 创建、执行和清理隔离运行环境。</p>
            <div class="sandboxHeroActions">
                <el-button type="primary" icon="el-icon-plus" @@click="openFunction('Create')">创建沙箱</el-button>
                <el-button icon="el-icon-setting" @@click="openSetup">环境准备</el-button>
            </div>
        </div>
        <div class="sandboxRuntimeSummary" aria-label="沙箱运行概览">
            <div class="runtimeSummaryIcon"><i class="fa fa-cubes"></i></div>
            <div class="runtimeSummaryMetrics">
                <div>
                    <span>已登记会话</span>
                    <strong>{{ sessionStats.total }}</strong>
                </div>
                <div>
                    <span>运行中</span>
                    <strong>{{ sessionStats.running }}</strong>
                </div>
                <div>
                    <span>交互式会话</span>
                    <strong>{{ sessionStats.interactive }}</strong>
                </div>
            </div>
        </div>
    </section>

    <div class="sandboxToolRow">
        <div class="sandboxToolMeta">状态更新于 {{ formatDateTime(lastUpdatedAt) }}</div>
        <div class="sandboxToolActions">
            <el-button size="mini" icon="el-icon-refresh" :loading="loading" @@click="reload">刷新</el-button>
            <el-button size="mini" icon="el-icon-menu" @@click="openFunction()">全部 Function</el-button>
            <el-button size="mini" icon="el-icon-document" @@click="openDocs">环境文档</el-button>
        </div>
    </div>

    <section class="sandboxOverviewGrid" aria-label="会话概览">
        <div class="sandboxOverviewCard">
            <div class="overviewIcon iconBlue"><i class="fa fa-cubes"></i></div>
            <div>
                <div class="overviewLabel">全部会话</div>
                <div class="overviewValue">{{ sessionStats.total }}</div>
                <div class="overviewHint">已登记</div>
            </div>
        </div>
        <div class="sandboxOverviewCard">
            <div class="overviewIcon iconGreen"><i class="fa fa-play"></i></div>
            <div>
                <div class="overviewLabel">运行中</div>
                <div class="overviewValue">{{ sessionStats.running }}</div>
                <div class="overviewHint">当前可用</div>
            </div>
        </div>
        <div class="sandboxOverviewCard">
            <div class="overviewIcon iconTeal"><i class="fa fa-desktop"></i></div>
            <div>
                <div class="overviewLabel">交互式会话</div>
                <div class="overviewValue">{{ sessionStats.interactive }}</div>
                <div class="overviewHint">Notebook / 预览</div>
            </div>
        </div>
        <div class="sandboxOverviewCard">
            <div class="overviewIcon iconAmber"><i class="fa fa-exclamation-triangle"></i></div>
            <div>
                <div class="overviewLabel">待处理</div>
                <div class="overviewValue">{{ sessionStats.attention }}</div>
                <div class="overviewHint">失败或已过期</div>
            </div>
        </div>
    </section>

    <section class="sandboxBoardGrid">
        <section class="sandboxBoardCard sandboxQuickActions" aria-labelledby="sandbox-function-title">
            <div class="sandboxBoardTitleRow">
                <div>
                    <h2 id="sandbox-function-title">Function 快捷操作</h2>
                    <p>使用模块已注册的执行入口，参数校验和结果日志保持与模块 Function 页面一致。</p>
                </div>
                <el-button size="mini" icon="el-icon-right" @@click="openFunction()">打开模块 Function</el-button>
            </div>
            <div class="sandboxShortcutList">
                <div class="sandboxShortcut">
                    <div class="shortcutIcon shortcutCreate"><i class="el-icon-plus"></i></div>
                    <div class="shortcutContent">
                        <h3>创建沙箱</h3>
                        <p>选择运行模板与运行时，创建独立会话。</p>
                    </div>
                    <el-button type="primary" size="mini" icon="el-icon-plus" @@click="openFunction('Create')">创建</el-button>
                </div>
                <div class="sandboxShortcut">
                    <div class="shortcutIcon shortcutExec"><i class="el-icon-caret-right"></i></div>
                    <div class="shortcutContent">
                        <h3>执行代码</h3>
                        <p>在 Exec 模板会话中提交短任务代码。</p>
                    </div>
                    <el-button type="success" size="mini" icon="el-icon-caret-right" @@click="openFunction('Exec')">执行</el-button>
                </div>
                <div class="sandboxShortcut">
                    <div class="shortcutIcon shortcutDestroy"><i class="el-icon-delete"></i></div>
                    <div class="shortcutContent">
                        <h3>销毁沙箱</h3>
                        <p>输入 SessionId，停止并清理指定会话。</p>
                    </div>
                    <el-button type="danger" size="mini" icon="el-icon-delete" @@click="openFunction('Destroy')">销毁</el-button>
                </div>
            </div>
        </section>

        <section class="sandboxBoardCard sandboxEnvironment" aria-labelledby="sandbox-environment-title">
            <div class="sandboxBoardTitleRow">
                <div>
                    <h2 id="sandbox-environment-title">运行环境</h2>
                    <p>Docker 可用性、镜像前缀和部署说明统一在环境准备页检查。</p>
                </div>
            </div>
            <div class="sandboxEnvironmentRows">
                <div>
                    <span><i class="fa fa-code"></i> Exec</span>
                    <strong>Python / C#</strong>
                </div>
                <div>
                    <span><i class="fa fa-book"></i> Notebook</span>
                    <strong>JupyterLab</strong>
                </div>
                <div>
                    <span><i class="fa fa-shield"></i> 生命周期</span>
                    <strong>TTL 自动回收</strong>
                </div>
            </div>
            <el-button class="sandboxEnvironmentButton" type="primary" plain icon="el-icon-setting" @@click="openSetup">检查环境</el-button>
        </section>

        <section class="sandboxBoardCard sandboxSessions" aria-labelledby="sandbox-sessions-title" v-loading="loading">
            <div class="sandboxBoardTitleRow">
                <div>
                    <h2 id="sandbox-sessions-title">沙箱会话</h2>
                    <p>通过站点反向代理访问交互式会话，访问链接不暴露容器 token。</p>
                </div>
                <el-tag size="mini" type="info">{{ sessionStats.total }} 个会话</el-tag>
            </div>
            <el-table :data="sessions" class="sandboxSessionTable" empty-text="暂无沙箱会话">
                <el-table-column prop="sessionId" label="SessionId" min-width="190" show-overflow-tooltip></el-table-column>
                <el-table-column label="模板" min-width="150">
                    <template slot-scope="scope">
                        <span class="templateName">{{ templateName(scope.row.templateKey) }}</span>
                    </template>
                </el-table-column>
                <el-table-column prop="runtimeKind" label="运行时" width="94"></el-table-column>
                <el-table-column label="状态" width="108">
                    <template slot-scope="scope">
                        <el-tag :type="statusTagType(scope.row.status)" size="mini">{{ statusText(scope.row.status) }}</el-tag>
                    </template>
                </el-table-column>
                <el-table-column prop="hostPort" label="端口" width="80">
                    <template slot-scope="scope">{{ scope.row.hostPort || '-' }}</template>
                </el-table-column>
                <el-table-column label="访问" width="104">
                    <template slot-scope="scope">
                        <el-tooltip v-if="scope.row.accessUrl" content="打开交互式会话" placement="top">
                            <el-button type="text" size="mini" icon="el-icon-top-right" @@click="openAccessUrl(scope.row.accessUrl)">打开</el-button>
                        </el-tooltip>
                        <span v-else class="sessionMuted">-</span>
                    </template>
                </el-table-column>
                <el-table-column label="TTL" min-width="160">
                    <template slot-scope="scope">
                        <span :class="{ sessionMuted: !canUpdateTtl(scope.row), ttlUnlimited: scope.row.isTtlUnlimited }">
                            {{ ttlDisplay(scope.row) }}
                        </span>
                    </template>
                </el-table-column>
                <el-table-column label="操作" width="150" align="center">
                    <template slot-scope="scope">
                        <el-tooltip v-if="canUpdateTtl(scope.row)" content="延长或修改 TTL" placement="top">
                            <el-button type="primary" size="mini" circle icon="el-icon-time" @@click="openTtlDialog(scope.row)"></el-button>
                        </el-tooltip>
                        <el-tooltip v-if="canDestroySession(scope.row)" content="销毁运行环境" placement="top">
                            <el-button type="warning" size="mini" circle icon="el-icon-video-pause" @@click="destroySession(scope.row.sessionId)"></el-button>
                        </el-tooltip>
                        <el-tooltip v-if="canDeleteRecord(scope.row)" content="永久删除会话记录" placement="top">
                            <el-button type="danger" size="mini" circle icon="el-icon-delete" @@click="deleteSessionRecord(scope.row.sessionId)"></el-button>
                        </el-tooltip>
                    </template>
                </el-table-column>
            </el-table>
        </section>
    </section>

    <el-dialog title="修改 TTL" :visible.sync="ttlDialog.visible" width="420px" :close-on-click-modal="false">
        <div v-if="ttlDialog.session" class="ttlDialog">
            <div class="ttlSessionId">{{ ttlDialog.session.sessionId }}</div>
            <el-radio-group v-model="ttlDialog.keepAlive">
                <el-radio :label="false">定时回收</el-radio>
                <el-radio :label="true">永久保持</el-radio>
            </el-radio-group>
            <el-input-number
                v-if="!ttlDialog.keepAlive"
                v-model="ttlDialog.minutes"
                :min="1"
                :max="240"
                :step="5"
                controls-position="right"
                class="ttlMinutesInput">
            </el-input-number>
            <div class="ttlDialogHint">
                <template v-if="ttlDialog.keepAlive">该会话不会被 TTL 扫描自动销毁，须由管理员手动销毁。</template>
                <template v-else>保存后从当前时刻重新计算，到期由后台自动销毁。</template>
            </div>
        </div>
        <span slot="footer">
            <el-button @@click="ttlDialog.visible = false">取消</el-button>
            <el-button type="primary" :loading="ttlDialog.saving" @@click="saveTtl">保存</el-button>
        </span>
    </el-dialog>
</div>

@section scripts{
    @{
        var jsonCamel = new System.Text.Json.JsonSerializerOptions
        {
            PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
        };
    }
    <script>
        new Vue({
            el: "#app",
            data() {
                return {
                    loading: false,
                    docsUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DocsUrl)),
                    moduleUid: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.XncfModuleUid)),
                    lastUpdatedAt: new Date(),
                    nowTick: Date.now(),
                    countdownTimer: null,
                    stateRefreshTimer: null,
                    ttlDialog: {
                        visible: false,
                        saving: false,
                        session: null,
                        minutes: 45,
                        keepAlive: false
                    },
                    // 须 camelCase：与 axios/?handler=State 及 el-table prop 一致（首屏默认 PascalCase 会导致列空白）
                    sessions: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Sessions, jsonCamel))
                };
            },
            created() {
                this.countdownTimer = window.setInterval(() => {
                    this.nowTick = Date.now();
                }, 1000);
                this.stateRefreshTimer = window.setInterval(() => {
                    this.refreshState().catch(() => {});
                }, 30000);
            },
            beforeDestroy() {
                window.clearInterval(this.countdownTimer);
                window.clearInterval(this.stateRefreshTimer);
            },
            computed: {
                sessionStats() {
                    const rows = this.sessions || [];
                    return {
                        total: rows.length,
                        running: rows.filter(row => this.statusKey(row.status) === '1' || this.statusKey(row.status) === 'running').length,
                        interactive: rows.filter(row => !!row.accessUrl).length,
                        attention: rows.filter(row => ['4', '5', 'failed', 'expired'].includes(this.statusKey(row.status))).length
                    };
                }
            },
            methods: {
                statusKey(status) {
                    return String(status === null || typeof status === 'undefined' ? '' : status).toLowerCase();
                },
                statusText(status) {
                    // SandboxSessionStatus: Creating=0, Running=1, Stopping=2, Stopped=3, Failed=4, Expired=5
                    const map = {
                        0: '创建中',
                        1: '运行中',
                        2: '停止中',
                        3: '已停止',
                        4: '失败',
                        5: '已过期',
                        creating: '创建中',
                        running: '运行中',
                        stopping: '停止中',
                        stopped: '已停止',
                        failed: '失败',
                        expired: '已过期'
                    };
                    return map[this.statusKey(status)] || ('未知(' + status + ')');
                },
                statusTagType(status) {
                    const map = {
                        '0': 'info',
                        '1': 'success',
                        '2': 'warning',
                        '3': 'info',
                        '4': 'danger',
                        '5': 'warning',
                        creating: 'info',
                        running: 'success',
                        stopping: 'warning',
                        stopped: 'info',
                        failed: 'danger',
                        expired: 'warning'
                    };
                    return map[this.statusKey(status)] || 'info';
                },
                canDestroySession(row) {
                    return ['0', '1', '2', '4', 'creating', 'running', 'stopping', 'failed']
                        .includes(this.statusKey(row && row.status));
                },
                canDeleteRecord(row) {
                    return ['3', '4', '5', 'stopped', 'failed', 'expired']
                        .includes(this.statusKey(row && row.status));
                },
                templateName(templateKey) {
                    const names = {
                        'python-exec': 'Python Exec',
                        'csharp-exec': 'C# Exec',
                        'jupyter-python': 'JupyterLab Python',
                        'jupyter-csharp': 'JupyterLab C#',
                        'ncf-preview': 'NCF/XNCF Preview'
                    };
                    return names[templateKey] || templateKey || '-';
                },
                formatDateTime(value) {
                    const date = value instanceof Date ? value : new Date(value);
                    if (Number.isNaN(date.getTime())) {
                        return '-';
                    }

                    return new Intl.DateTimeFormat('zh-CN', {
                        hour: '2-digit',
                        minute: '2-digit',
                        second: '2-digit'
                    }).format(date);
                },
                isRunning(status) {
                    const key = this.statusKey(status);
                    return key === '0' || key === '1' || key === 'creating' || key === 'running';
                },
                canUpdateTtl(row) {
                    return !!row && this.isRunning(row.status);
                },
                ttlDisplay(row) {
                    if (!row) {
                        return '-';
                    }

                    if (row.isTtlUnlimited) {
                        return '永久保持';
                    }

                    if (!this.isRunning(row.status)) {
                        return this.statusText(row.status);
                    }

                    const expiresAt = new Date(row.expiresAtUtc).getTime();
                    if (Number.isNaN(expiresAt)) {
                        return '-';
                    }

                    const remaining = expiresAt - this.nowTick;
                    if (remaining <= 0) {
                        return '等待回收';
                    }

                    const totalSeconds = Math.floor(remaining / 1000);
                    const hours = Math.floor(totalSeconds / 3600);
                    const minutes = Math.floor((totalSeconds % 3600) / 60);
                    const seconds = totalSeconds % 60;
                    const prefix = hours > 0 ? String(hours).padStart(2, '0') + ':' : '';
                    return prefix + String(minutes).padStart(2, '0') + ':' + String(seconds).padStart(2, '0');
                },
                ttlMinutesFromNow(row) {
                    if (!row || row.isTtlUnlimited) {
                        return 45;
                    }

                    const expiresAt = new Date(row.expiresAtUtc).getTime();
                    const remainingMinutes = Math.ceil((expiresAt - Date.now()) / 60000);
                    return Math.min(240, Math.max(1, Number.isNaN(remainingMinutes) ? 45 : remainingMinutes));
                },
                getFunctionUrl(functionKey, action) {
                    const search = new URLSearchParams({ uid: this.moduleUid });
                    if (functionKey) {
                        search.set('functionKey', functionKey);
                        search.set('action', action || 'run');
                    }

                    const anchor = functionKey ? '#function-' + encodeURIComponent(functionKey) : '';
                    return '/Admin/XncfModule/Start/?' + search.toString() + anchor;
                },
                openFunction(functionKey) {
                    if (functionKey && window.NeuCharPivotFunction &&
                        typeof window.NeuCharPivotFunction.open === 'function') {
                        window.NeuCharPivotFunction.open({
                            moduleUid: this.moduleUid,
                            functionKey: functionKey
                        });
                        return;
                    }
                    window.location.assign(this.getFunctionUrl(functionKey, functionKey ? 'run' : 'settings'));
                },
                openSetup() {
                    window.location.assign('/Admin/Sandbox/Setup?uid=' + encodeURIComponent(this.moduleUid));
                },
                openDocs() {
                    window.open(this.docsUrl, '_blank', 'noopener');
                },
                openAccessUrl(accessUrl) {
                    window.open(accessUrl, '_blank', 'noopener');
                },
                async reload() {
                    this.loading = true;
                    try {
                        await this.refreshState();
                    } catch (error) {
                        this.$message.error('刷新沙箱会话失败，请检查服务状态。');
                    } finally {
                        this.loading = false;
                    }
                },
                async refreshState() {
                    const res = await axios.get('?handler=State');
                    this.sessions = (res.data && res.data.sessions) || [];
                    this.lastUpdatedAt = new Date();
                },
                openTtlDialog(row) {
                    if (!this.canUpdateTtl(row)) {
                        return;
                    }

                    this.ttlDialog.session = row;
                    this.ttlDialog.keepAlive = !!row.isTtlUnlimited;
                    this.ttlDialog.minutes = this.ttlMinutesFromNow(row);
                    this.ttlDialog.visible = true;
                },
                async saveTtl() {
                    const dialog = this.ttlDialog;
                    if (!dialog.session) {
                        return;
                    }

                    const form = new FormData();
                    form.append('sessionId', dialog.session.sessionId);
                    form.append('keepAlive', String(dialog.keepAlive));
                    if (!dialog.keepAlive) {
                        form.append('ttlMinutes', String(dialog.minutes));
                    }
                    form.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]')?.value || '');

                    dialog.saving = true;
                    try {
                        await axios.post('?handler=UpdateTtl', form);
                        dialog.visible = false;
                        this.$message.success(dialog.keepAlive ? '已设为永久保持。' : 'TTL 已更新。');
                        await this.reload();
                    } catch (error) {
                        this.$message.error('更新 TTL 失败，请检查会话状态和 TTL 设置。');
                    } finally {
                        dialog.saving = false;
                    }
                },
                async destroySession(sessionId) {
                    if (!sessionId) {
                        return;
                    }

                    if (this.$confirm) {
                        try {
                            await this.$confirm('销毁后将停止并删除对应运行环境，是否继续？', '销毁沙箱', {
                                confirmButtonText: '销毁',
                                cancelButtonText: '取消',
                                type: 'warning'
                            });
                        } catch {
                            return;
                        }
                    }

                    const form = new FormData();
                    form.append('sessionId', sessionId);
                    form.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]')?.value || '');
                    this.loading = true;
                    try {
                        await axios.post('?handler=Destroy', form);
                        this.$message.success('沙箱会话已销毁。');
                        await this.reload();
                    } catch (error) {
                        this.$message.error('销毁沙箱会话失败，请检查服务日志。');
                    } finally {
                        this.loading = false;
                    }
                },
                async deleteSessionRecord(sessionId) {
                    if (!sessionId) {
                        return;
                    }

                    if (this.$confirm) {
                        try {
                            await this.$confirm('该操作将永久删除会话记录，且无法恢复。请确认运行环境已经销毁，是否继续？', '删除会话记录', {
                                confirmButtonText: '永久删除',
                                cancelButtonText: '取消',
                                type: 'warning'
                            });
                        } catch {
                            return;
                        }
                    }

                    const form = new FormData();
                    form.append('sessionId', sessionId);
                    form.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]')?.value || '');
                    this.loading = true;
                    try {
                        await axios.post('?handler=Delete', form);
                        this.$message.success('沙箱会话记录已删除。');
                        await this.reload();
                    } catch (error) {
                        this.$message.error('删除会话记录失败，请先销毁运行环境或检查服务日志。');
                    } finally {
                        this.loading = false;
                    }
                }
            }
        });
    </script>
}
