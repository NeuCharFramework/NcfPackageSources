@page
@model Senparc.Xncf.Sandbox.Areas.Sandbox.Pages.Index
@using Microsoft.Extensions.Localization
@using Senparc.Xncf.Sandbox
@inject IStringLocalizer<SandboxResource> XR
@{
    ViewData["Title"] = $"{Model.XncfRegister.MenuName}";
    Layout = "_Layout_Vue";
}

@section Style{
    <link href="~/css/Sandbox/index.css" rel="stylesheet" />
}

@section breadcrumbs{
    <el-breadcrumb-item>@XR["Frontend.001"]</el-breadcrumb-item>
    <el-breadcrumb-item>@Model.XncfRegister.MenuName</el-breadcrumb-item>
    <el-breadcrumb-item>@XR["Frontend.002"]</el-breadcrumb-item>
}

<div class="sandboxPage" v-cloak>
    @Html.AntiForgeryToken()

    <section class="sandboxHero" :aria-label="ncfST('Frontend.003')" aria-labelledby="sandbox-page-title">
        <div class="sandboxHeroCopy">
            <div class="sandboxEyebrow"><i class="fa fa-cube"></i> Sandbox Runtime</div>
            <h1 id="sandbox-page-title">{{ ncfST('Frontend.003') }}</h1>
            <p>{{ ncfST('Frontend.081') }}</p>
            <div class="sandboxHeroActions">
                <el-button type="primary" icon="el-icon-plus" @@click="openFunction('Create')">{{ ncfST('Frontend.021') }}</el-button>
                <el-button icon="el-icon-setting" @@click="openSetup">{{ ncfST('Frontend.004') }}</el-button>
            </div>
        </div>
        <div class="sandboxRuntimeSummary" :aria-label="ncfST('Frontend.005')">
            <div class="runtimeSummaryIcon"><i class="fa fa-cubes"></i></div>
            <div class="runtimeSummaryMetrics">
                <div>
                    <span>{{ ncfST('Frontend.006') }}</span>
                    <strong>{{ sessionStats.total }}</strong>
                </div>
                <div>
                    <span>{{ ncfST('Frontend.007') }}</span>
                    <strong>{{ sessionStats.running }}</strong>
                </div>
                <div>
                    <span>{{ ncfST('Frontend.008') }}</span>
                    <strong>{{ sessionStats.interactive }}</strong>
                </div>
            </div>
        </div>
    </section>

    <div class="sandboxToolRow">
        <div class="sandboxToolMeta">{{ ncfST('Frontend.082', formatDateTime(lastUpdatedAt)) }}</div>
        <div class="sandboxToolActions">
            <el-button size="mini" icon="el-icon-refresh" :loading="loading" @@click="reload">{{ ncfST('Frontend.009') }}</el-button>
            <el-button size="mini" icon="el-icon-menu" @@click="openFunction()">{{ ncfST('Frontend.010') }}</el-button>
            <el-button size="mini" icon="el-icon-document" @@click="openDocs">{{ ncfST('Frontend.011') }}</el-button>
        </div>
    </div>

    <section class="sandboxOverviewGrid" :aria-label="ncfST('Frontend.012')">
        <div class="sandboxOverviewCard">
            <div class="overviewIcon iconBlue"><i class="fa fa-cubes"></i></div>
            <div>
                <div class="overviewLabel">{{ ncfST('Frontend.013') }}</div>
                <div class="overviewValue">{{ sessionStats.total }}</div>
                <div class="overviewHint">{{ ncfST('Frontend.014') }}</div>
            </div>
        </div>
        <div class="sandboxOverviewCard">
            <div class="overviewIcon iconGreen"><i class="fa fa-play"></i></div>
            <div>
                <div class="overviewLabel">{{ ncfST('Frontend.007') }}</div>
                <div class="overviewValue">{{ sessionStats.running }}</div>
                <div class="overviewHint">{{ ncfST('Frontend.015') }}</div>
            </div>
        </div>
        <div class="sandboxOverviewCard">
            <div class="overviewIcon iconTeal"><i class="fa fa-desktop"></i></div>
            <div>
                <div class="overviewLabel">{{ ncfST('Frontend.008') }}</div>
                <div class="overviewValue">{{ sessionStats.interactive }}</div>
                <div class="overviewHint">{{ ncfST('Frontend.016') }}</div>
            </div>
        </div>
        <div class="sandboxOverviewCard">
            <div class="overviewIcon iconAmber"><i class="fa fa-exclamation-triangle"></i></div>
            <div>
                <div class="overviewLabel">{{ ncfST('Frontend.017') }}</div>
                <div class="overviewValue">{{ sessionStats.attention }}</div>
                <div class="overviewHint">{{ ncfST('Frontend.018') }}</div>
            </div>
        </div>
    </section>

    <section class="sandboxBoardGrid">
        <section class="sandboxBoardCard sandboxQuickActions" :aria-label="ncfST('Frontend.019')" aria-labelledby="sandbox-function-title">
            <div class="sandboxBoardTitleRow">
                <div>
                    <h2 id="sandbox-function-title">{{ ncfST('Frontend.019') }}</h2>
                    <p>{{ ncfST('Frontend.063') }}</p>
                </div>
                <el-button size="mini" icon="el-icon-right" @@click="openFunction()">{{ ncfST('Frontend.020') }}</el-button>
            </div>
            <div class="sandboxShortcutList">
                <div class="sandboxShortcut">
                    <div class="shortcutIcon shortcutCreate"><i class="el-icon-plus"></i></div>
                    <div class="shortcutContent">
                        <h3>{{ ncfST('Frontend.021') }}</h3>
                        <p>{{ ncfST('Frontend.077') }}</p>
                    </div>
                    <el-button type="primary" size="mini" icon="el-icon-plus" @@click="openFunction('Create')">{{ ncfST('Frontend.065') }}</el-button>
                </div>
                <div class="sandboxShortcut">
                    <div class="shortcutIcon shortcutExec"><i class="el-icon-caret-right"></i></div>
                    <div class="shortcutContent">
                        <h3>{{ ncfST('Frontend.022') }}</h3>
                        <p>{{ ncfST('Frontend.066') }}</p>
                    </div>
                    <el-button type="success" size="mini" icon="el-icon-caret-right" @@click="openFunction('Exec')">{{ ncfST('Frontend.069') }}</el-button>
                </div>
                <div class="sandboxShortcut">
                    <div class="shortcutIcon shortcutDestroy"><i class="el-icon-delete"></i></div>
                    <div class="shortcutContent">
                        <h3>{{ ncfST('Frontend.023') }}</h3>
                        <p>{{ ncfST('Frontend.076') }}</p>
                    </div>
                    <el-button type="danger" size="mini" icon="el-icon-delete" @@click="openFunction('Destroy')">{{ ncfST('Frontend.079') }}</el-button>
                </div>
            </div>
        </section>

        <section class="sandboxBoardCard sandboxEnvironment" :aria-label="ncfST('Frontend.024')" aria-labelledby="sandbox-environment-title">
            <div class="sandboxBoardTitleRow">
                <div>
                    <h2 id="sandbox-environment-title">{{ ncfST('Frontend.024') }}</h2>
                    <p>{{ ncfST('Frontend.060') }}</p>
                </div>
            </div>
            <div class="sandboxEnvironmentRows">
                <div>
                    <span><i class="fa fa-code"></i> Exec</span>
                    <strong>Python / C#</strong>
                </div>
                <div>
                    <span><i class="fa fa-book"></i> Notebook</span>
                    <strong>JupyterLab</strong>
                </div>
                <div>
                    <span><i class="fa fa-shield"></i> {{ ncfST('Frontend.025') }}</span>
                    <strong>{{ ncfST('Frontend.026') }}</strong>
                </div>
            </div>
            <el-button class="sandboxEnvironmentButton" type="primary" plain icon="el-icon-setting" @@click="openSetup">{{ ncfST('Frontend.027') }}</el-button>
        </section>

        <section class="sandboxBoardCard sandboxSessions" :aria-label="ncfST('Frontend.028')" aria-labelledby="sandbox-sessions-title" v-loading="loading">
            <div class="sandboxBoardTitleRow">
                <div>
                    <h2 id="sandbox-sessions-title">{{ ncfST('Frontend.028') }}</h2>
                    <p>{{ ncfST('Frontend.078') }}</p>
                </div>
                <el-tag size="mini" type="info">{{ ncfST('Frontend.083', sessionStats.total) }}</el-tag>
            </div>
            <el-table :data="sessions" class="sandboxSessionTable" :empty-text="ncfST('Frontend.084')">
                <el-table-column prop="sessionId" label="SessionId" min-width="190" show-overflow-tooltip></el-table-column>
                <el-table-column :label="ncfST('Frontend.029')" min-width="150">
                    <template slot-scope="scope">
                        <span class="templateName">{{ templateName(scope.row.templateKey) }}</span>
                    </template>
                </el-table-column>
                <el-table-column :label="ncfST('Frontend.030')" min-width="130" show-overflow-tooltip>
                    <template slot-scope="scope">
                        <span v-if="scope.row.alias" class="aliasName">{{ scope.row.alias }}</span>
                        <span v-else class="sessionMuted">-</span>
                    </template>
                </el-table-column>
                <el-table-column prop="runtimeKind" :label="ncfST('Frontend.031')" width="94"></el-table-column>
                <el-table-column :label="ncfST('Frontend.032')" width="108">
                    <template slot-scope="scope">
                        <el-tag :type="statusTagType(scope.row.status)" size="mini">{{ statusText(scope.row.status) }}</el-tag>
                    </template>
                </el-table-column>
                <el-table-column prop="hostPort" :label="ncfST('Frontend.033')" width="80">
                    <template slot-scope="scope">{{ scope.row.hostPort || '-' }}</template>
                </el-table-column>
                <el-table-column :label="ncfST('Frontend.034')" min-width="150" show-overflow-tooltip>
                    <template slot-scope="scope">
                        <span v-if="scope.row.extraPorts" class="extraPortsText">{{ scope.row.extraPorts }}</span>
                        <span v-else class="sessionMuted">-</span>
                    </template>
                </el-table-column>
                <el-table-column :label="ncfST('Frontend.035')" width="104">
                    <template slot-scope="scope">
                        <el-tooltip v-if="scope.row.accessUrl" :content="ncfST('Frontend.036')" placement="top">
                            <el-button type="text" size="mini" icon="el-icon-top-right" @@click="openAccessUrl(scope.row.accessUrl)">{{ ncfST('Frontend.037') }}</el-button>
                        </el-tooltip>
                        <span v-else class="sessionMuted">-</span>
                    </template>
                </el-table-column>
                <el-table-column label="TTL" min-width="160">
                    <template slot-scope="scope">
                        <span :class="{ sessionMuted: !canUpdateTtl(scope.row), ttlUnlimited: scope.row.isTtlUnlimited }">
                            {{ ttlDisplay(scope.row) }}
                        </span>
                    </template>
                </el-table-column>
                <el-table-column :label="ncfST('Frontend.038')" width="190" align="center" class-name="ncf-table-actions-column">
                    <template slot-scope="scope">
                        <el-tooltip v-if="canEditAlias(scope.row)" :content="scope.row.alias ? ncfST('Frontend.039') : ncfST('Frontend.040')" placement="top">
                            <el-button type="success" size="mini" circle icon="el-icon-edit" @@click="openAliasDialog(scope.row)"></el-button>
                        </el-tooltip>
                        <el-tooltip v-if="canUpdateTtl(scope.row)" :content="ncfST('Frontend.041')" placement="top">
                            <el-button type="primary" size="mini" circle icon="el-icon-time" @@click="openTtlDialog(scope.row)"></el-button>
                        </el-tooltip>
                        <el-tooltip v-if="canDestroySession(scope.row)" :content="ncfST('Frontend.042')" placement="top">
                            <el-button type="warning" size="mini" circle icon="el-icon-video-pause" @@click="destroySession(scope.row.sessionId)"></el-button>
                        </el-tooltip>
                        <el-tooltip v-if="canDeleteRecord(scope.row)" :content="ncfST('Frontend.043')" placement="top">
                            <el-button type="danger" size="mini" circle icon="el-icon-delete" @@click="deleteSessionRecord(scope.row.sessionId)"></el-button>
                        </el-tooltip>
                    </template>
                </el-table-column>
            </el-table>
        </section>
    </section>

    <el-dialog :title="ncfST('Frontend.044')" :visible.sync="aliasDialog.visible" width="440px" :close-on-click-modal="false">
        <div v-if="aliasDialog.session" class="aliasDialog">
            <div class="aliasSessionId">{{ aliasDialog.session.sessionId }}</div>
            <el-input
                v-model="aliasDialog.alias"
                :placeholder="ncfST('Frontend.045')"
                maxlength="128"
                show-word-limit
                clearable>
            </el-input>
            <div class="aliasDialogHint">
                {{ ncfST('Frontend.085') }}
            </div>
        </div>
        <span slot="footer">
            <el-button @@click="aliasDialog.visible = false">{{ ncfST('Frontend.046') }}</el-button>
            <el-button type="primary" :loading="aliasDialog.saving" @@click="saveAlias">{{ ncfST('Frontend.047') }}</el-button>
        </span>
    </el-dialog>

    <el-dialog :title="ncfST('Frontend.048')" :visible.sync="ttlDialog.visible" width="420px" :close-on-click-modal="false">
        <div v-if="ttlDialog.session" class="ttlDialog">
            <div class="ttlSessionId">{{ ttlDialog.session.sessionId }}</div>
            <el-radio-group v-model="ttlDialog.keepAlive">
                <el-radio :label="false">{{ ncfST('Frontend.049') }}</el-radio>
                <el-radio :label="true">{{ ncfST('Frontend.050') }}</el-radio>
            </el-radio-group>
            <el-input-number
                v-if="!ttlDialog.keepAlive"
                v-model="ttlDialog.minutes"
                :min="1"
                :max="240"
                :step="5"
                controls-position="right"
                class="ttlMinutesInput">
            </el-input-number>
            <div class="ttlDialogHint">
                <template v-if="ttlDialog.keepAlive">{{ ncfST('Frontend.075') }}</template>
                <template v-else>{{ ncfST('Frontend.064') }}</template>
            </div>
        </div>
        <span slot="footer">
            <el-button @@click="ttlDialog.visible = false">{{ ncfST('Frontend.046') }}</el-button>
            <el-button type="primary" :loading="ttlDialog.saving" @@click="saveTtl">{{ ncfST('Frontend.047') }}</el-button>
        </span>
    </el-dialog>
</div>

@section scripts{
    <partial name="~/Areas/Admin/Pages/Shared/_LocalizationScripts.cshtml" />
    @{
        var jsonCamel = new System.Text.Json.JsonSerializerOptions
        {
            PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
        };
    }
    <script>
        new Vue({
            el: "#app",
            data() {
                return {
                    loading: false,
                    docsUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DocsUrl)),
                    moduleUid: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.XncfModuleUid)),
                    lastUpdatedAt: new Date(),
                    nowTick: Date.now(),
                    countdownTimer: null,
                    stateRefreshTimer: null,
                    ttlDialog: {
                        visible: false,
                        saving: false,
                        session: null,
                        minutes: 45,
                        keepAlive: false
                    },
                    aliasDialog: {
                        visible: false,
                        saving: false,
                        session: null,
                        alias: ''
                    },
                    // Keep camelCase to match axios/?handler=State and el-table props.
                    sessions: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Sessions, jsonCamel))
                };
            },
            created() {
                this.countdownTimer = window.setInterval(() => {
                    this.nowTick = Date.now();
                }, 1000);
                this.stateRefreshTimer = window.setInterval(() => {
                    this.refreshState().catch(() => {});
                }, 30000);
            },
            beforeDestroy() {
                window.clearInterval(this.countdownTimer);
                window.clearInterval(this.stateRefreshTimer);
            },
            computed: {
                sessionStats() {
                    const rows = this.sessions || [];
                    return {
                        total: rows.length,
                        running: rows.filter(row => this.statusKey(row.status) === '1' || this.statusKey(row.status) === 'running').length,
                        interactive: rows.filter(row => !!row.accessUrl).length,
                        attention: rows.filter(row => ['4', '5', 'failed', 'expired'].includes(this.statusKey(row.status))).length
                    };
                }
            },
            methods: {
                statusKey(status) {
                    return String(status === null || typeof status === 'undefined' ? '' : status).toLowerCase();
                },
                statusText(status) {
                    // SandboxSessionStatus: Creating=0, Running=1, Stopping=2, Stopped=3, Failed=4, Expired=5
                    const map = {
                        0: 'Frontend.086',
                        1: 'Frontend.007',
                        2: 'Frontend.087',
                        3: 'Frontend.088',
                        4: 'Frontend.089',
                        5: 'Frontend.090',
                        creating: 'Frontend.086',
                        running: 'Frontend.007',
                        stopping: 'Frontend.087',
                        stopped: 'Frontend.088',
                        failed: 'Frontend.089',
                        expired: 'Frontend.090'
                    };
                    const key = map[this.statusKey(status)];
                    return key ? ncfST(key) : ncfST('Frontend.091', status);
                },
                statusTagType(status) {
                    const map = {
                        '0': 'info',
                        '1': 'success',
                        '2': 'warning',
                        '3': 'info',
                        '4': 'danger',
                        '5': 'warning',
                        creating: 'info',
                        running: 'success',
                        stopping: 'warning',
                        stopped: 'info',
                        failed: 'danger',
                        expired: 'warning'
                    };
                    return map[this.statusKey(status)] || 'info';
                },
                canDestroySession(row) {
                    return ['0', '1', '2', '4', 'creating', 'running', 'stopping', 'failed']
                        .includes(this.statusKey(row && row.status));
                },
                canDeleteRecord(row) {
                    return ['3', '4', '5', 'stopped', 'failed', 'expired']
                        .includes(this.statusKey(row && row.status));
                },
                templateName(templateKey) {
                    const names = {
                        'python-exec': 'Python Exec',
                        'csharp-exec': 'C# Exec',
                        'jupyter-python': 'JupyterLab Python',
                        'jupyter-csharp': 'JupyterLab C#',
                        'ncf-preview': 'NCF/XNCF Preview'
                    };
                    return names[templateKey] || templateKey || '-';
                },
                formatDateTime(value) {
                    const date = value instanceof Date ? value : new Date(value);
                    if (Number.isNaN(date.getTime())) {
                        return '-';
                    }

                    return new Intl.DateTimeFormat('zh-CN', {
                        hour: '2-digit',
                        minute: '2-digit',
                        second: '2-digit'
                    }).format(date);
                },
                isRunning(status) {
                    const key = this.statusKey(status);
                    return key === '0' || key === '1' || key === 'creating' || key === 'running';
                },
                canUpdateTtl(row) {
                    return !!row && this.isRunning(row.status);
                },
                ttlDisplay(row) {
                    if (!row) {
                        return '-';
                    }

                    if (row.isTtlUnlimited) {
                        return ncfST('Frontend.050');
                    }

                    if (!this.isRunning(row.status)) {
                        return this.statusText(row.status);
                    }

                    const expiresAt = new Date(row.expiresAtUtc).getTime();
                    if (Number.isNaN(expiresAt)) {
                        return '-';
                    }

                    const remaining = expiresAt - this.nowTick;
                    if (remaining <= 0) {
                        return ncfST('Frontend.096');
                    }

                    const totalSeconds = Math.floor(remaining / 1000);
                    const hours = Math.floor(totalSeconds / 3600);
                    const minutes = Math.floor((totalSeconds % 3600) / 60);
                    const seconds = totalSeconds % 60;
                    const prefix = hours > 0 ? String(hours).padStart(2, '0') + ':' : '';
                    return prefix + String(minutes).padStart(2, '0') + ':' + String(seconds).padStart(2, '0');
                },
                ttlMinutesFromNow(row) {
                    if (!row || row.isTtlUnlimited) {
                        return 45;
                    }

                    const expiresAt = new Date(row.expiresAtUtc).getTime();
                    const remainingMinutes = Math.ceil((expiresAt - Date.now()) / 60000);
                    return Math.min(240, Math.max(1, Number.isNaN(remainingMinutes) ? 45 : remainingMinutes));
                },
                getFunctionUrl(functionKey, action) {
                    const search = new URLSearchParams({ uid: this.moduleUid });
                    if (functionKey) {
                        search.set('functionKey', functionKey);
                        search.set('action', action || 'run');
                    }

                    const anchor = functionKey ? '#function-' + encodeURIComponent(functionKey) : '';
                    return '/Admin/XncfModule/Start/?' + search.toString() + anchor;
                },
                openFunction(functionKey) {
                    if (functionKey && window.NeuCharPivotFunction &&
                        typeof window.NeuCharPivotFunction.open === 'function') {
                        window.NeuCharPivotFunction.open({
                            moduleUid: this.moduleUid,
                            functionKey: functionKey
                        });
                        return;
                    }
                    window.location.assign(this.getFunctionUrl(functionKey, functionKey ? 'run' : 'settings'));
                },
                openSetup() {
                    window.location.assign('/Admin/Sandbox/Setup?uid=' + encodeURIComponent(this.moduleUid));
                },
                openDocs() {
                    window.open(this.docsUrl, '_blank', 'noopener');
                },
                openAccessUrl(accessUrl) {
                    window.open(accessUrl, '_blank', 'noopener');
                },
                async reload() {
                    this.loading = true;
                    try {
                        await this.refreshState();
                    } catch (error) {
                        this.$message.error(ncfST('Frontend.097'));
                    } finally {
                        this.loading = false;
                    }
                },
                async refreshState() {
                    const res = await axios.get('?handler=State');
                    this.sessions = (res.data && res.data.sessions) || [];
                    this.lastUpdatedAt = new Date();
                },
                canEditAlias(row) {
                    return !!row && ['creating', 'running', 'stopping', 'stopped', '0', '1', '2', '3'].includes(this.statusKey(row.status));
                },
                openAliasDialog(row) {
                    if (!this.canEditAlias(row)) {
                        return;
                    }

                    this.aliasDialog.session = row;
                    this.aliasDialog.alias = row.alias || '';
                    this.aliasDialog.visible = true;
                },
                async saveAlias() {
                    const dialog = this.aliasDialog;
                    if (!dialog.session) {
                        return;
                    }

                    const form = new FormData();
                    form.append('sessionId', dialog.session.sessionId);
                    form.append('alias', dialog.alias || '');
                    form.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]')?.value || '');

                    dialog.saving = true;
                    try {
                        await axios.post('?handler=UpdateAlias', form);
                        dialog.visible = false;
                        this.$message.success((dialog.alias || '').trim() ? ncfST('Frontend.098') : ncfST('Frontend.099'));
                        await this.reload();
                    } catch (error) {
                        this.$message.error(ncfST('Frontend.100'));
                    } finally {
                        dialog.saving = false;
                    }
                },
                openTtlDialog(row) {
                    if (!this.canUpdateTtl(row)) {
                        return;
                    }

                    this.ttlDialog.session = row;
                    this.ttlDialog.keepAlive = !!row.isTtlUnlimited;
                    this.ttlDialog.minutes = this.ttlMinutesFromNow(row);
                    this.ttlDialog.visible = true;
                },
                async saveTtl() {
                    const dialog = this.ttlDialog;
                    if (!dialog.session) {
                        return;
                    }

                    const form = new FormData();
                    form.append('sessionId', dialog.session.sessionId);
                    form.append('keepAlive', String(dialog.keepAlive));
                    if (!dialog.keepAlive) {
                        form.append('ttlMinutes', String(dialog.minutes));
                    }
                    form.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]')?.value || '');

                    dialog.saving = true;
                    try {
                        await axios.post('?handler=UpdateTtl', form);
                        dialog.visible = false;
                        this.$message.success(dialog.keepAlive ? ncfST('Frontend.101') : ncfST('Frontend.102'));
                        await this.reload();
                    } catch (error) {
                        this.$message.error(ncfST('Frontend.103'));
                    } finally {
                        dialog.saving = false;
                    }
                },
                async destroySession(sessionId) {
                    if (!sessionId) {
                        return;
                    }

                    if (this.$confirm) {
                        try {
                            await this.$confirm(ncfST('Frontend.104'), ncfST('Frontend.105'), {
                                confirmButtonText: ncfST('Frontend.079'),
                                cancelButtonText: ncfST('Frontend.046'),
                                type: 'warning'
                            });
                        } catch {
                            return;
                        }
                    }

                    const form = new FormData();
                    form.append('sessionId', sessionId);
                    form.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]')?.value || '');
                    this.loading = true;
                    try {
                        await axios.post('?handler=Destroy', form);
                        this.$message.success(ncfST('Frontend.106'));
                        await this.reload();
                    } catch (error) {
                        this.$message.error(ncfST('Frontend.107'));
                    } finally {
                        this.loading = false;
                    }
                },
                async deleteSessionRecord(sessionId) {
                    if (!sessionId) {
                        return;
                    }

                    if (this.$confirm) {
                        try {
                            await this.$confirm(ncfST('Frontend.108'), ncfST('Frontend.109'), {
                                confirmButtonText: ncfST('Frontend.043'),
                                cancelButtonText: ncfST('Frontend.046'),
                                type: 'warning'
                            });
                        } catch {
                            return;
                        }
                    }

                    const form = new FormData();
                    form.append('sessionId', sessionId);
                    form.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]')?.value || '');
                    this.loading = true;
                    try {
                        await axios.post('?handler=Delete', form);
                        this.$message.success(ncfST('Frontend.110'));
                        await this.reload();
                    } catch (error) {
                        this.$message.error(ncfST('Frontend.111'));
                    } finally {
                        this.loading = false;
                    }
                }
            }
        });
    </script>
}
