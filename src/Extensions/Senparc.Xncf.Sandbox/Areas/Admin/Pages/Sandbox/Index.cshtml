@page
@model Senparc.Xncf.Sandbox.Areas.Sandbox.Pages.Index
@using Microsoft.Extensions.Localization
@using Senparc.Xncf.Sandbox
@inject IStringLocalizer<SandboxResource> XR
@{
    ViewData["Title"] = $"{Model.XncfRegister.MenuName}";
    Layout = "_Layout_Vue";
}

@section Style{
    <link href="~/css/Sandbox/index.css?v=20261124-5" rel="stylesheet" />
}

@section breadcrumbs{
    <el-breadcrumb-item>@XR["Frontend.Sandbox.ExtensionModules"]</el-breadcrumb-item>
    <el-breadcrumb-item>@Model.XncfRegister.MenuName</el-breadcrumb-item>
    <el-breadcrumb-item>@XR["Frontend.Sandbox.Panel"]</el-breadcrumb-item>
}

<div class="sandboxPage" v-cloak>
    @Html.AntiForgeryToken()

    <section class="sandboxHero" :aria-label="ncfST('Frontend.Sandbox.SandboxPanel')" aria-labelledby="sandbox-page-title">
        <div class="sandboxHeroCopy">
            <div class="sandboxEyebrow"><i class="fa fa-cube"></i> Sandbox Runtime</div>
            <h1 id="sandbox-page-title">{{ ncfST('Frontend.Sandbox.SandboxPanel') }} <ncf-doc-help topic="sandbox.manage"></ncf-doc-help></h1>
            <p>{{ ncfST('Frontend.Sandbox.ReviewSessionStatusInOnePlaceAndCreateExecuteAndCleanIsolated') }}</p>
            <div class="sandboxHeroActions">
                <el-button type="primary" icon="el-icon-plus" @@click="openFunction('Create')">{{ ncfST('Frontend.Sandbox.CreateSandbox') }}</el-button>
                <el-button icon="el-icon-setting" @@click="openSetup">{{ ncfST('Frontend.Sandbox.EnvironmentSetup') }}</el-button>
            </div>
        </div>
        <div class="sandboxRuntimeSummary" :aria-label="ncfST('Frontend.Sandbox.SandboxRuntimeOverview')">
            <div class="runtimeSummaryIcon"><i class="fa fa-cubes"></i></div>
            <div class="runtimeSummaryMetrics">
                <div>
                    <span>{{ ncfST('Frontend.Sandbox.RegisteredSessions') }}</span>
                    <strong>{{ sessionStats.total }}</strong>
                </div>
                <div>
                    <span>{{ ncfST('Frontend.Sandbox.Running') }}</span>
                    <strong>{{ sessionStats.running }}</strong>
                </div>
                <div>
                    <span>{{ ncfST('Frontend.Sandbox.InteractiveSessions') }}</span>
                    <strong>{{ sessionStats.interactive }}</strong>
                </div>
            </div>
        </div>
    </section>

    <div class="sandboxToolRow">
        <div class="sandboxToolMeta">{{ ncfST('Frontend.Sandbox.StatusUpdatedValue', formatDateTime(lastUpdatedAt)) }}</div>
        <div class="sandboxToolActions">
            <el-button size="mini" icon="el-icon-refresh" :loading="loading" @@click="reload">{{ ncfST('Frontend.Sandbox.Refresh') }}</el-button>
            <el-button size="mini" icon="el-icon-menu" @@click="openFunction()">{{ ncfST('Frontend.Sandbox.AllFunctions') }}</el-button>
            <el-button size="mini" icon="el-icon-document" @@click="openDocs">{{ ncfST('Frontend.Sandbox.EnvironmentDocs') }}</el-button>
        </div>
    </div>

    <section class="sandboxBoardCard sandboxSessions" :aria-label="ncfST('Frontend.Sandbox.SandboxSessions')" aria-labelledby="sandbox-sessions-title" v-loading="loading">
            <div class="sandboxBoardTitleRow">
                <div>
                    <h2 id="sandbox-sessions-title">{{ ncfST('Frontend.Sandbox.SandboxSessions') }}</h2>
                    <p>{{ ncfST('Frontend.Sandbox.AccessInteractiveSessionsThroughTheSiteReverseProxyLinksDoNotExpose') }}</p>
                </div>
                <el-tag size="mini" type="info">{{ ncfST('Frontend.Sandbox.ValueSessions', sessionStats.total) }}</el-tag>
            </div>
            <el-table :data="sessions" height="100%" class="sandboxSessionTable" :empty-text="ncfST('Frontend.Sandbox.NoSandboxSessions')">
                <el-table-column prop="sessionId" :label="ncfST('Frontend.Sandbox.SessionId')" min-width="220" show-overflow-tooltip>
                    <template slot-scope="scope">
                        <div class="sessionPrimary">
                            <span class="sessionIdText">{{ scope.row.sessionId }}</span>
                            <span class="sessionAliasText" v-if="scope.row.alias">{{ scope.row.alias }}</span>
                        </div>
                    </template>
                </el-table-column>
                <el-table-column :label="ncfST('Frontend.Sandbox.Template')" min-width="170">
                    <template slot-scope="scope">
                        <span class="templateName">{{ templateName(scope.row.templateKey) }}</span>
                    </template>
                </el-table-column>
                <el-table-column prop="runtimeKind" :label="ncfST('Frontend.Sandbox.Runtime')" width="104"></el-table-column>
                <el-table-column :label="ncfST('Frontend.Sandbox.Status')" width="104">
                    <template slot-scope="scope">
                        <el-tag :type="statusTagType(scope.row.status)" size="mini">{{ statusText(scope.row.status) }}</el-tag>
                    </template>
                </el-table-column>
                <el-table-column :label="ncfST('Frontend.Sandbox.Access')" width="104">
                    <template slot-scope="scope">
                        <el-tooltip v-if="scope.row.accessUrl" :content="ncfST('Frontend.Sandbox.OpenInteractiveSession')" placement="top">
                            <el-button type="text" size="mini" icon="el-icon-top-right" @@click="openAccessUrl(scope.row.accessUrl)">{{ ncfST('Frontend.Sandbox.Open') }}</el-button>
                        </el-tooltip>
                        <span v-else class="sessionMuted">-</span>
                    </template>
                </el-table-column>
                <el-table-column label="TTL" width="126">
                    <template slot-scope="scope">
                        <span :class="{ sessionMuted: !canUpdateTtl(scope.row), ttlUnlimited: scope.row.isTtlUnlimited }">
                            {{ ttlDisplay(scope.row) }}
                        </span>
                    </template>
                </el-table-column>
                <el-table-column :label="ncfST('Frontend.Sandbox.Actions')" width="180" fixed="right" align="center" class-name="ncf-table-actions-column">
                    <template slot-scope="scope">
                        <el-tooltip v-if="canEditAlias(scope.row)" :content="scope.row.alias ? ncfST('Frontend.Sandbox.EditAlias') : ncfST('Frontend.Sandbox.SetAlias')" placement="top">
                            <el-button type="success" size="mini" circle icon="el-icon-edit" @@click="openAliasDialog(scope.row)"></el-button>
                        </el-tooltip>
                        <el-tooltip v-if="canUpdateTtl(scope.row)" :content="ncfST('Frontend.Sandbox.ExtendOrEditTTL')" placement="top">
                            <el-button type="primary" size="mini" circle icon="el-icon-time" @@click="openTtlDialog(scope.row)"></el-button>
                        </el-tooltip>
                        <el-tooltip v-if="canDestroySession(scope.row)" :content="ncfST('Frontend.Sandbox.DestroyRuntime')" placement="top">
                            <el-button type="warning" size="mini" circle icon="el-icon-video-pause" @@click="destroySession(scope.row.sessionId)"></el-button>
                        </el-tooltip>
                        <el-tooltip v-if="canDeleteRecord(scope.row)" :content="ncfST('Frontend.Sandbox.PermanentlyDeleteSessionRecord')" placement="top">
                            <el-button type="danger" size="mini" circle icon="el-icon-delete" @@click="deleteSessionRecord(scope.row.sessionId)"></el-button>
                        </el-tooltip>
                    </template>
                </el-table-column>
            </el-table>
            <div class="sandboxSessionCards">
                <article v-for="row in sessions" :key="row.sessionId" class="sandboxSessionCard">
                    <div class="sessionCardHeader">
                        <div class="sessionCardIdentity">
                            <strong>{{ row.alias || templateName(row.templateKey) }}</strong>
                            <span class="sessionIdText">{{ row.sessionId }}</span>
                        </div>
                        <el-tag :type="statusTagType(row.status)" size="mini">{{ statusText(row.status) }}</el-tag>
                    </div>
                    <div class="sessionCardGrid">
                        <div><span>{{ ncfST('Frontend.Sandbox.Template') }}</span><strong>{{ templateName(row.templateKey) }}</strong></div>
                        <div><span>{{ ncfST('Frontend.Sandbox.Runtime') }}</span><strong>{{ row.runtimeKind || '-' }}</strong></div>
                        <div><span>{{ ncfST('Frontend.Sandbox.Port') }}</span><strong>{{ row.hostPort || '-' }}</strong></div>
                        <div><span>TTL</span><strong :class="{ ttlUnlimited: row.isTtlUnlimited }">{{ ttlDisplay(row) }}</strong></div>
                    </div>
                    <div class="sessionCardFooter">
                        <span v-if="row.extraPorts" class="extraPortsText">{{ ncfST('Frontend.Sandbox.AdditionalPorts') }}: {{ row.extraPorts }}</span>
                        <span v-else class="sessionMuted">{{ ncfST('Frontend.Sandbox.AdditionalPorts') }}: -</span>
                        <div class="sessionCardActions">
                            <el-button v-if="row.accessUrl" type="text" size="mini" icon="el-icon-top-right" @@click="openAccessUrl(row.accessUrl)">{{ ncfST('Frontend.Sandbox.Open') }}</el-button>
                            <el-button v-if="canEditAlias(row)" type="text" size="mini" icon="el-icon-edit" @@click="openAliasDialog(row)"></el-button>
                            <el-button v-if="canUpdateTtl(row)" type="text" size="mini" icon="el-icon-time" @@click="openTtlDialog(row)"></el-button>
                            <el-button v-if="canDestroySession(row)" type="text" class="actionWarning" size="mini" icon="el-icon-video-pause" @@click="destroySession(row.sessionId)"></el-button>
                            <el-button v-if="canDeleteRecord(row)" type="text" class="actionDanger" size="mini" icon="el-icon-delete" @@click="deleteSessionRecord(row.sessionId)"></el-button>
                        </div>
                    </div>
                </article>
                <el-empty v-if="!sessions.length" :description="ncfST('Frontend.Sandbox.NoSandboxSessions')"></el-empty>
            </div>
    </section>

    <el-dialog :title="ncfST('Frontend.Sandbox.SessionAlias')" :visible.sync="aliasDialog.visible" width="440px" :close-on-click-modal="false">
        <div v-if="aliasDialog.session" class="aliasDialog">
            <div class="aliasSessionId">{{ aliasDialog.session.sessionId }}</div>
            <el-input
                v-model="aliasDialog.alias"
                :placeholder="ncfST('Frontend.Sandbox.LeaveEmptyToClearTheAlias')"
                maxlength="128"
                show-word-limit
                clearable>
            </el-input>
            <div class="aliasDialogHint">
                {{ ncfST('Frontend.Sandbox.AliasesIdentifySessionsInListsFunctionResultsAndLogsTheyDoNot') }}
            </div>
        </div>
        <span slot="footer">
            <el-button @@click="aliasDialog.visible = false">{{ ncfST('Frontend.Sandbox.Cancel') }}</el-button>
            <el-button type="primary" :loading="aliasDialog.saving" @@click="saveAlias">{{ ncfST('Frontend.Sandbox.Save') }}</el-button>
        </span>
    </el-dialog>

    <el-dialog :title="ncfST('Frontend.Sandbox.EditTTL')" :visible.sync="ttlDialog.visible" width="420px" :close-on-click-modal="false">
        <div v-if="ttlDialog.session" class="ttlDialog">
            <div class="ttlSessionId">{{ ttlDialog.session.sessionId }}</div>
            <el-radio-group v-model="ttlDialog.keepAlive">
                <el-radio :label="false">{{ ncfST('Frontend.Sandbox.ScheduledCleanup') }}</el-radio>
                <el-radio :label="true">{{ ncfST('Frontend.Sandbox.KeepForever') }}</el-radio>
            </el-radio-group>
            <el-input-number
                v-if="!ttlDialog.keepAlive"
                v-model="ttlDialog.minutes"
                :min="1"
                :max="240"
                :step="5"
                controls-position="right"
                class="ttlMinutesInput">
            </el-input-number>
            <div class="ttlDialogHint">
                <template v-if="ttlDialog.keepAlive">{{ ncfST('Frontend.Sandbox.ThisSessionIsNotDestroyedByTheTTLScanAndMustBe') }}</template>
                <template v-else>{{ ncfST('Frontend.Sandbox.RecalculatesFromTheCurrentTimeAfterSavingAndDestroysTheSessionAutomatically') }}</template>
            </div>
        </div>
        <span slot="footer">
            <el-button @@click="ttlDialog.visible = false">{{ ncfST('Frontend.Sandbox.Cancel') }}</el-button>
            <el-button type="primary" :loading="ttlDialog.saving" @@click="saveTtl">{{ ncfST('Frontend.Sandbox.Save') }}</el-button>
        </span>
    </el-dialog>
</div>

@section scripts{
    @await Html.PartialAsync("_LocalizationScripts")
    @{
        var jsonCamel = new System.Text.Json.JsonSerializerOptions
        {
            PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
        };
    }
    <script>
        new Vue({
            el: "#app",
            data() {
                return {
                    loading: false,
                    docsUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DocsUrl)),
                    moduleUid: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.XncfModuleUid)),
                    lastUpdatedAt: new Date(),
                    nowTick: Date.now(),
                    countdownTimer: null,
                    stateRefreshTimer: null,
                    ttlDialog: {
                        visible: false,
                        saving: false,
                        session: null,
                        minutes: 45,
                        keepAlive: false
                    },
                    aliasDialog: {
                        visible: false,
                        saving: false,
                        session: null,
                        alias: ''
                    },
                    // Keep camelCase to match axios/?handler=State and el-table props.
                    sessions: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Sessions, jsonCamel))
                };
            },
            created() {
                this.countdownTimer = window.setInterval(() => {
                    this.nowTick = Date.now();
                }, 1000);
                this.stateRefreshTimer = window.setInterval(() => {
                    this.refreshState().catch(() => {});
                }, 30000);
            },
            beforeDestroy() {
                window.clearInterval(this.countdownTimer);
                window.clearInterval(this.stateRefreshTimer);
            },
            computed: {
                sessionStats() {
                    const rows = this.sessions || [];
                    return {
                        total: rows.length,
                        running: rows.filter(row => this.statusKey(row.status) === '1' || this.statusKey(row.status) === 'running').length,
                        interactive: rows.filter(row => !!row.accessUrl).length,
                        attention: rows.filter(row => ['4', '5', 'failed', 'expired'].includes(this.statusKey(row.status))).length
                    };
                }
            },
            methods: {
                statusKey(status) {
                    return String(status === null || typeof status === 'undefined' ? '' : status).toLowerCase();
                },
                statusText(status) {
                    // SandboxSessionStatus: Creating=0, Running=1, Stopping=2, Stopped=3, Failed=4, Expired=5
                    const map = {
                        0: 'Frontend.Sandbox.Creating',
                        1: 'Frontend.Sandbox.Running',
                        2: 'Frontend.Sandbox.Stopping',
                        3: 'Frontend.Sandbox.Stopped',
                        4: 'Frontend.Sandbox.Failed',
                        5: 'Frontend.Sandbox.Expired',
                        creating: 'Frontend.Sandbox.Creating',
                        running: 'Frontend.Sandbox.Running',
                        stopping: 'Frontend.Sandbox.Stopping',
                        stopped: 'Frontend.Sandbox.Stopped',
                        failed: 'Frontend.Sandbox.Failed',
                        expired: 'Frontend.Sandbox.Expired'
                    };
                    const key = map[this.statusKey(status)];
                    return key ? ncfST(key) : ncfST('Frontend.Sandbox.UnknownValue', status);
                },
                statusTagType(status) {
                    const map = {
                        '0': 'info',
                        '1': 'success',
                        '2': 'warning',
                        '3': 'info',
                        '4': 'danger',
                        '5': 'warning',
                        creating: 'info',
                        running: 'success',
                        stopping: 'warning',
                        stopped: 'info',
                        failed: 'danger',
                        expired: 'warning'
                    };
                    return map[this.statusKey(status)] || 'info';
                },
                canDestroySession(row) {
                    return ['0', '1', '2', '4', 'creating', 'running', 'stopping', 'failed']
                        .includes(this.statusKey(row && row.status));
                },
                canDeleteRecord(row) {
                    return ['3', '4', '5', 'stopped', 'failed', 'expired']
                        .includes(this.statusKey(row && row.status));
                },
                templateName(templateKey) {
                    const names = {
                        'python-exec': 'Python Exec',
                        'csharp-exec': 'C# Exec',
                        'jupyter-python': 'JupyterLab Python',
                        'jupyter-csharp': 'JupyterLab C#',
                        'ncf-preview': 'NCF/XNCF Preview'
                    };
                    return names[templateKey] || templateKey || '-';
                },
                formatDateTime(value) {
                    const date = value instanceof Date ? value : new Date(value);
                    if (Number.isNaN(date.getTime())) {
                        return '-';
                    }

                    return new Intl.DateTimeFormat('zh-CN', {
                        hour: '2-digit',
                        minute: '2-digit',
                        second: '2-digit'
                    }).format(date);
                },
                isRunning(status) {
                    const key = this.statusKey(status);
                    return key === '0' || key === '1' || key === 'creating' || key === 'running';
                },
                canUpdateTtl(row) {
                    return !!row && this.isRunning(row.status);
                },
                ttlDisplay(row) {
                    if (!row) {
                        return '-';
                    }

                    if (row.isTtlUnlimited) {
                        return ncfST('Frontend.Sandbox.KeepForever');
                    }

                    if (!this.isRunning(row.status)) {
                        return this.statusText(row.status);
                    }

                    const expiresAt = new Date(row.expiresAtUtc).getTime();
                    if (Number.isNaN(expiresAt)) {
                        return '-';
                    }

                    const remaining = expiresAt - this.nowTick;
                    if (remaining <= 0) {
                        return ncfST('Frontend.Sandbox.WaitingForCleanup');
                    }

                    const totalSeconds = Math.floor(remaining / 1000);
                    const hours = Math.floor(totalSeconds / 3600);
                    const minutes = Math.floor((totalSeconds % 3600) / 60);
                    const seconds = totalSeconds % 60;
                    const prefix = hours > 0 ? String(hours).padStart(2, '0') + ':' : '';
                    return prefix + String(minutes).padStart(2, '0') + ':' + String(seconds).padStart(2, '0');
                },
                ttlMinutesFromNow(row) {
                    if (!row || row.isTtlUnlimited) {
                        return 45;
                    }

                    const expiresAt = new Date(row.expiresAtUtc).getTime();
                    const remainingMinutes = Math.ceil((expiresAt - Date.now()) / 60000);
                    return Math.min(240, Math.max(1, Number.isNaN(remainingMinutes) ? 45 : remainingMinutes));
                },
                getFunctionUrl(functionKey, action) {
                    const search = new URLSearchParams({ uid: this.moduleUid });
                    if (functionKey) {
                        search.set('functionKey', functionKey);
                        search.set('action', action || 'run');
                    }

                    const anchor = functionKey ? '#function-' + encodeURIComponent(functionKey) : '';
                    return '/Admin/XncfModule/Start/?' + search.toString() + anchor;
                },
                openFunction(functionKey) {
                    if (functionKey && window.NeuCharPivotFunction &&
                        typeof window.NeuCharPivotFunction.open === 'function') {
                        window.NeuCharPivotFunction.open({
                            moduleUid: this.moduleUid,
                            functionKey: functionKey
                        });
                        return;
                    }
                    window.location.assign(this.getFunctionUrl(functionKey, functionKey ? 'run' : 'settings'));
                },
                openSetup() {
                    window.location.assign('/Admin/Sandbox/Setup?uid=' + encodeURIComponent(this.moduleUid));
                },
                openDocs() {
                    window.open(this.docsUrl, '_blank', 'noopener');
                },
                openAccessUrl(accessUrl) {
                    window.open(accessUrl, '_blank', 'noopener');
                },
                async reload() {
                    this.loading = true;
                    try {
                        await this.refreshState();
                    } catch (error) {
                        this.$message.error(ncfST('Frontend.Sandbox.FailedToRefreshSandboxSessionsCheckTheServiceStatus'));
                    } finally {
                        this.loading = false;
                    }
                },
                async refreshState() {
                    const res = await axios.get('?handler=State');
                    this.sessions = (res.data && res.data.sessions) || [];
                    this.lastUpdatedAt = new Date();
                },
                canEditAlias(row) {
                    return !!row && ['creating', 'running', 'stopping', 'stopped', '0', '1', '2', '3'].includes(this.statusKey(row.status));
                },
                openAliasDialog(row) {
                    if (!this.canEditAlias(row)) {
                        return;
                    }

                    this.aliasDialog.session = row;
                    this.aliasDialog.alias = row.alias || '';
                    this.aliasDialog.visible = true;
                },
                async saveAlias() {
                    const dialog = this.aliasDialog;
                    if (!dialog.session) {
                        return;
                    }

                    const form = new FormData();
                    form.append('sessionId', dialog.session.sessionId);
                    form.append('alias', dialog.alias || '');
                    form.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]')?.value || '');

                    dialog.saving = true;
                    try {
                        await axios.post('?handler=UpdateAlias', form);
                        dialog.visible = false;
                        this.$message.success((dialog.alias || '').trim() ? ncfST('Frontend.Sandbox.AliasUpdated') : ncfST('Frontend.Sandbox.AliasCleared'));
                        await this.reload();
                    } catch (error) {
                        this.$message.error(ncfST('Frontend.Sandbox.FailedToUpdateTheAliasCheckTheSessionStatus'));
                    } finally {
                        dialog.saving = false;
                    }
                },
                openTtlDialog(row) {
                    if (!this.canUpdateTtl(row)) {
                        return;
                    }

                    this.ttlDialog.session = row;
                    this.ttlDialog.keepAlive = !!row.isTtlUnlimited;
                    this.ttlDialog.minutes = this.ttlMinutesFromNow(row);
                    this.ttlDialog.visible = true;
                },
                async saveTtl() {
                    const dialog = this.ttlDialog;
                    if (!dialog.session) {
                        return;
                    }

                    const form = new FormData();
                    form.append('sessionId', dialog.session.sessionId);
                    form.append('keepAlive', String(dialog.keepAlive));
                    if (!dialog.keepAlive) {
                        form.append('ttlMinutes', String(dialog.minutes));
                    }
                    form.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]')?.value || '');

                    dialog.saving = true;
                    try {
                        await axios.post('?handler=UpdateTtl', form);
                        dialog.visible = false;
                        this.$message.success(dialog.keepAlive ? ncfST('Frontend.Sandbox.SetToKeepPermanently') : ncfST('Frontend.Sandbox.TTLUpdated'));
                        await this.reload();
                    } catch (error) {
                        this.$message.error(ncfST('Frontend.Sandbox.FailedToUpdateTTLCheckTheSessionStatusAndTTLSetting'));
                    } finally {
                        dialog.saving = false;
                    }
                },
                async destroySession(sessionId) {
                    if (!sessionId) {
                        return;
                    }

                    if (this.$confirm) {
                        try {
                            await this.$confirm(ncfST('Frontend.Sandbox.TheEnvironmentWillBeStoppedAndDeletedAfterDestructionContinue'), ncfST('Frontend.Sandbox.DestroySandboxAlternate'), {
                                confirmButtonText: ncfST('Frontend.Sandbox.Destroy'),
                                cancelButtonText: ncfST('Frontend.Sandbox.Cancel'),
                                type: 'warning'
                            });
                        } catch {
                            return;
                        }
                    }

                    const form = new FormData();
                    form.append('sessionId', sessionId);
                    form.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]')?.value || '');
                    this.loading = true;
                    try {
                        await axios.post('?handler=Destroy', form);
                        this.$message.success(ncfST('Frontend.Sandbox.SandboxSessionDestroyed'));
                        await this.reload();
                    } catch (error) {
                        this.$message.error(ncfST('Frontend.Sandbox.FailedToDestroyTheSandboxSessionCheckTheServiceLogs'));
                    } finally {
                        this.loading = false;
                    }
                },
                async deleteSessionRecord(sessionId) {
                    if (!sessionId) {
                        return;
                    }

                    if (this.$confirm) {
                        try {
                            await this.$confirm(ncfST('Frontend.Sandbox.ThisPermanentlyDeletesTheSessionRecordAndCannotBeUndoneConfirmThat'), ncfST('Frontend.Sandbox.DeleteSessionRecord'), {
                                confirmButtonText: ncfST('Frontend.Sandbox.PermanentlyDeleteSessionRecord'),
                                cancelButtonText: ncfST('Frontend.Sandbox.Cancel'),
                                type: 'warning'
                            });
                        } catch {
                            return;
                        }
                    }

                    const form = new FormData();
                    form.append('sessionId', sessionId);
                    form.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]')?.value || '');
                    this.loading = true;
                    try {
                        await axios.post('?handler=Delete', form);
                        this.$message.success(ncfST('Frontend.Sandbox.SandboxSessionRecordDeleted'));
                        await this.reload();
                    } catch (error) {
                        this.$message.error(ncfST('Frontend.Sandbox.FailedToDeleteTheSessionRecordDestroyTheRuntimeEnvironmentFirstOr'));
                    } finally {
                        this.loading = false;
                    }
                }
            }
        });
    </script>
}
