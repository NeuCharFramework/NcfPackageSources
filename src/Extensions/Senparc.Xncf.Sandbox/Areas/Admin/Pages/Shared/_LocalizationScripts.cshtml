@using System.Text.Json
@using System.Globalization
@using Microsoft.Extensions.Localization
@using Senparc.Xncf.Sandbox
@inject IStringLocalizer<SandboxResource> XR
@inject IStringLocalizerFactory LocalizationFactory
@{
    var neutralStrings = Array.Empty<LocalizedString>();
    var originalCulture = CultureInfo.CurrentUICulture;
    try
    {
        CultureInfo.CurrentUICulture = CultureInfo.InvariantCulture;
        neutralStrings = LocalizationFactory.Create(typeof(SandboxResource))
            .GetAllStrings(includeParentCultures: false)
            .ToArray();
    }
    finally
    {
        CultureInfo.CurrentUICulture = originalCulture;
    }

    var neutralByKey = neutralStrings
        .Where(item => item.Name.StartsWith("Frontend.", StringComparison.Ordinal))
        .Select(item => new
        {
            item.Name,
            Parts = item.Value.Split(new[] { "||" }, 2, StringSplitOptions.None)
        })
        .Where(item => item.Parts.Length == 2)
        .ToDictionary(item => item.Name, item => item.Parts, StringComparer.Ordinal);
    var sourceTranslations = neutralByKey.Values
        .ToDictionary(parts => parts[0], parts => parts[1], StringComparer.Ordinal);
    foreach (var item in XR.GetAllStrings(includeParentCultures: false)
                 .Where(item => item.Name.StartsWith("Frontend.", StringComparison.Ordinal)))
    {
        var localizedParts = item.Value.Split(new[] { "||" }, 2, StringSplitOptions.None);
        if (neutralByKey.TryGetValue(item.Name, out var neutralParts))
        {
            sourceTranslations[neutralParts[0]] = localizedParts.Length == 2
                ? localizedParts[1]
                : item.Value;
        }
    }
}
<script>
    window.ncfRegisterSourceTranslations(@Html.Raw(JsonSerializer.Serialize(sourceTranslations)));
</script>
