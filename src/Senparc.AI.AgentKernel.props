<Project>
  <PropertyGroup>
    <SenparcAiVersion>0.27.4</SenparcAiVersion>
    <SenparcAiKernelVersion>0.29.1</SenparcAiKernelVersion>
    <SenparcAiAgentsVersion>0.7.3</SenparcAiAgentsVersion>
    <SenparcAiAgentKernelVersion>0.1.17</SenparcAiAgentKernelVersion>
    <MicrosoftAgentsAiVersion>1.28.0</MicrosoftAgentsAiVersion>
    <MicrosoftAgentsAiHarnessVersion>1.28.0</MicrosoftAgentsAiHarnessVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Senparc.AI" Version="$(SenparcAiVersion)" />
    <PackageReference Include="Senparc.AI.AgentKernel" Version="$(SenparcAiAgentKernelVersion)" />
    <PackageReference Include="Microsoft.Agents.AI" Version="$(MicrosoftAgentsAiVersion)" />
    <PackageReference Include="Microsoft.Agents.AI.Abstractions" Version="$(MicrosoftAgentsAiVersion)" />
    <PackageReference Include="Microsoft.Agents.AI.Harness" Version="$(MicrosoftAgentsAiHarnessVersion)" />
    <PackageReference Include="OpenAI" Version="2.14.0" />
    <PackageReference Include="OllamaSharp" Version="5.4.25" />
    <PackageReference Include="System.ClientModel" Version="1.16.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
  </ItemGroup>
</Project>
