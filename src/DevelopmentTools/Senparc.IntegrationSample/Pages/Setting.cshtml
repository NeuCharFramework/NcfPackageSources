@page
@model Senparc.IntegrationSample.Pages.SettingModel
@{
    ViewData["Title"] = "System Configuration";
}

<h2>SenparcCoreSetting Configuration</h2>
<p>@Model.SenparcCoreSetting.ToJson(true)</p>

<h2>Current Database Configuration</h2>
<p>@Senparc.Ncf.Core.Models.DatabaseConfigurationFactory.Instance.Current.GetType().FullName</p>

<h2>Module Loading Status</h2>
<p>All AddXncfModule calls applied: @(Model.NcfCoreState.AllAddXncfModuleApplied ? "Yes" : "No")</p>
<p>Any DatabaseXncf Register applied: @(Model.NcfCoreState.AynDatabaseXncfLoaded ? "Yes" : "No")</p>
<p>All DatabaseXncf Registers applied: @(Model.NcfCoreState.AllDatabaseXncfLoaded ? "Yes" : "No")</p>
<p>Any AddXncfDatabaseModule call applied: @(Model.NcfCoreState.AnyAddXncfDatabaseModuleApplied ? "Yes" : "No")</p>
<p>All AuthorizeConfig calls applied: @(Model.NcfCoreState.AllAuthorizeConfigApplied ? "Yes" : "No")</p>
<p>All UseXncfModule calls applied: @(Model.NcfCoreState.AllUseXncfModuleApplied ? "Yes" : "No")</p>
<p>Any ThreadXncf Register applied (after UseXncfModule): @(Model.NcfCoreState.AnyThreadXncfLoaded ? "Yes" : "No")</p>
<p>All ThreadXncf Registers applied (after UseXncfModule): @(Model.NcfCoreState.AllThreadXncfLoaded ? "Yes" : "No")</p>
<p>Custom DLL file patterns (DllFilePatterns):
    @if(Model.NcfCoreState.DllFilePatterns == null)
    {
        <span>Not set</span>
    }
    else
    {
        <ol>
            @foreach (var item in Model.NcfCoreState.DllFilePatterns)
            {
                <li>@item</li>
            }
        </ol>
    }
</p>
<p>
    All loaded assemblies:
    <ol>
        @foreach (var item in Model.XncfAssemblies)
        {
            <li>@item.FullName</li>
        }
    </ol>
</p>
