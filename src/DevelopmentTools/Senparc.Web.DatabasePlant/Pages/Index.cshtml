@page
@model IndexModel
@{
    ViewData["Title"] = "Senparc.Web.DatabasePlant Migration Utility";
}

<div class="text-center">
    <h1 class="display-4">Batch Migration Generator</h1>
    <form method="post">
        <p>src root directory: <input type="text" name="srcRootDir" value="E:\Senparc\NeuCharFramework\NcfPackageSources\src" size="100" /></p>
        <p>
            Project paths: <textarea rows="20" cols="100" name="projects">Extensions\System\Senparc.Xncf.Menu
Extensions\System\Senparc.Xncf.XncfModuleManager
Extensions\System\Senparc.Xncf.SystemPermission
Extensions\System\Senparc.Xncf.SystemManager
Extensions\System\Senparc.Xncf.Tenant
Extensions\Senparc.Xncf.XncfBuilder\Senparc.Xncf.XncfBuilder
Extensions\Senparc.Xncf.XncfBuilder\Senparc.Xncf.XncfBuilder.Template
Extensions\Senparc.Xncf.DatabaseToolkit\Senparc.Xncf.DatabaseToolkit
</textarea>
        </p>
        <p>
            Migration note: <input type="text" name="note" size="20" />
            Database name (must be a MultipleDatabaseType enum value): <input type="text" name="databaseName" size="20" />
        </p>
        <p><input type="submit" value="Generate Code" asp-page-handler="GenerateCode" /></p>
    </form>
    <p>Generated command: <textarea rows="20" cols="150">@ViewData["GenerateCodeResult"]</textarea></p>
</div>
