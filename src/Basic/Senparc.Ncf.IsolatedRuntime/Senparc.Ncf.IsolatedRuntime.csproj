<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.1.1.1-preview2</Version>
    <AssemblyName>Senparc.Ncf.IsolatedRuntime</AssemblyName>
    <RootNamespace>Senparc.Ncf.IsolatedRuntime</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>NeuCharFramework shared isolated runtime providers.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Title>Module</Title>
    <Authors>NeuCharFramework</Authors>
    <Owners>NeuCharFramework</Owners>
    <RepositoryUrl>https://github.com/NeuCharFramework/NcfPackageSources</RepositoryUrl>
    <PackageTags>NeuCharFramework,NCF,Docker,Isolation,Runtime</PackageTags>
    <PackageIcon>icon.jpg</PackageIcon>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'TemplateRelease'">true</GeneratePackageOnBuild>
    <Configurations>Debug;Release;Test;TemplateRelease</Configurations>
    <PackageReleaseNotes>[2026-11-03] v0.1.0-preview1 Updated module behavior and related support.
        1. Updated module behavior and related support.
        2. Updated module behavior and related support.
        3. Updated module behavior and related support.
        4. Updated module behavior and related support.
        [2026-11-19] v0.1.1-preview2 Updated module behavior, localization metadata, and English source comments
        1. Kept runtime behavior and module integration aligned with the affected service and registration changes.
        2. Standardized related English source comments and package metadata for the current release.
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Senparc.Ncf.Shared.Abstractions\Senparc.Ncf.Shared.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Senparc.Ncf.IsolatedRuntime.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\icon.jpg" Pack="true" Visible="false" PackagePath="" />
  </ItemGroup>

</Project>
