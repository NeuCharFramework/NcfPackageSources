<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.21.3.2-preview6</Version>
    <AssemblyName>Senparc.Ncf.Utility</AssemblyName>
    <RootNamespace>Senparc.Ncf.Utility</RootNamespace>
    <GeneratePackageOnBuild Condition=" '$(Configuration)' == 'Release' ">true</GeneratePackageOnBuild>
    <GeneratePackageOnBuild Condition="'$(Configuration)'=='TemplateRelease'">true</GeneratePackageOnBuild>
    <Description>Senparc.Ncf.Utility</Description>
    <Copyright>NeuCharFramework</Copyright>
    <PackageTags>NeuCharFramework,NCF</PackageTags>
    <Authors>NeuCharFramework</Authors>
    <Owners>NeuCharFramework</Owners>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Title>Senparc.Ncf.Utility</Title>
    <ProjectUrl>https://github.com/NeuCharFramework/NCF</ProjectUrl>
    <PackageProjectUrl>https://github.com/NeuCharFramework/NcfPackageSources</PackageProjectUrl>
    <PackageIcon>icon.jpg</PackageIcon>
    <PackageReleaseNotes>v0.1.0 initial release
        [2024-10-07] delete AESEncryptionUtility , unify CO2NET feature.
        [2024-10-26] 0.18.6-preview1 add GlobalCulture
        [2025-04-29] v0.19.6-preview1 Update CO2NET and AIKernel
        [2025-11-01] update basic libraries, including Senparc.AI
        [2026-07-17] v0.21.0-preview2 Updated module behavior and related support.
        1. Updated module behavior and related support.
        2. Updated module behavior and related support.
        [2026-07-31] v0.21.1-preview3 Updated module behavior and related support.
        1. Updated module behavior and related support.
        [2026-11-11] v0.21.1-preview3 Updated module behavior and related support.
        1. Updated module behavior and related support.
        2. Updated module behavior and related support.
        [2026-11-12] v0.21.2-preview4 Updated module behavior and related support.
        1. Updated module behavior and related support.
        2. Updated module behavior and related support.
        [2026-11-19] v0.21.3-preview5 Updated module behavior, localization metadata, and English source comments
        1. Updated localized labels, resource fallbacks, and user-facing messages across affected surfaces.
        2. Standardized related English source comments and package metadata for the current release.
    
        [2026-11-27] v0.21.3.2-preview6 Improve source documentation, headers, and module metadata consistency.
        1. Applied standardized copyright headers, XML documentation, and localization metadata across touched sources.
    </PackageReleaseNotes>
    <RepositoryUrl>https://github.com/NeuCharFramework/NcfPackageSources</RepositoryUrl>
    <Configurations>Debug;Release;Test;TemplateRelease</Configurations>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <OutputPath>..\..\BuildOutPut</OutputPath>
    <DocumentationFile>..\..\BuildOutPut\Senparc.Ncf.Utility.XML</DocumentationFile>
    <DefineConstants>$(DefineConstants);RELEASE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <ErrorReport>prompt</ErrorReport>
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='TemplateRelease'">
    <OutputPath>..\..\BuildOutPut</OutputPath>
    <DocumentationFile>..\..\BuildOutPut\Senparc.Ncf.Utility.XML</DocumentationFile>
    <DefineConstants>$(DefineConstants);RELEASE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <ErrorReport>prompt</ErrorReport>
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\icon.jpg" Pack="true" Visible="false" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="8.0.10" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
    <PackageReference Include="Senparc.CO2NET" Version="4.2.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Senparc.Ncf.Log\Senparc.Ncf.Log.csproj" />
  </ItemGroup>
</Project>
