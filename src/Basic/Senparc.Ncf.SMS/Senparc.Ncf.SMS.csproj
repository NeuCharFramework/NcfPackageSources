<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.20.13-preview13</Version>
    <AssemblyName>Senparc.Ncf.SMS</AssemblyName>
    <RootNamespace>Senparc.Ncf.SMS</RootNamespace>
    <GeneratePackageOnBuild Condition=" '$(Configuration)' == 'Release' ">true</GeneratePackageOnBuild>
    <GeneratePackageOnBuild Condition="'$(Configuration)'=='TemplateRelease'">true</GeneratePackageOnBuild>
    <Description>Senparc.Ncf.SMS</Description>
    <Copyright>NeuCharFramework</Copyright>
    <PackageTags>NeuCharFramework,NCF</PackageTags>
    <Authors>NeuCharFramework</Authors>
    <Owners>NeuCharFramework</Owners>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Title>Senparc.Ncf.SMS</Title>
    <ProjectUrl>https://github.com/NeuCharFramework/NCF</ProjectUrl>
    <PackageProjectUrl>https://github.com/NeuCharFramework/NcfPackageSources</PackageProjectUrl>
    <PackageIcon>icon.jpg</PackageIcon>
    <PackageReleaseNotes>v0.1
        initial release
        [2024-09-10] v0.18.4-preview1 upgrade the cache foundation libraries
        [2025-01-25] v0.19.5-preview1 Update Agents functions, support for function calling
        [2025-04-29] v0.19.7-preview1 Update CO2NET and AIKernel
        [2025-11-01] update basic libraries, including Senparc.AI
        [2026-07-17] v0.20.2-preview2 synchronize upstream project versions and adopt shared localization capabilities
        1. Dependency update from Senparc.Ncf.Core to 0.25.0-preview2
        [2026-07-29] v0.20.3-preview3 Dependency update from Senparc.Ncf.Core to 0.26.0-preview3
        [2026-07-31] v0.20.4-preview4 Dependency update from Senparc.Ncf.Core to 0.27.0-preview4
        [2026-08-04] v0.20.5-preview5 Dependency update from Senparc.Ncf.Core to 0.28.0-preview5
        [2026-08-08] v0.20.6-preview6 Dependency update from Senparc.Ncf.Core to 0.28.1-preview6
        [2026-08-13] v0.20.7-preview7 Dependency update from Senparc.Ncf.Core to 0.28.2-preview7
        [2026-08-15] v0.20.8-preview8 Dependency update from Senparc.Ncf.Core to 0.29.0-preview8
        [2026-08-29] v0.20.9-preview9 Dependency updates from Senparc.Ncf.Core to 0.30.0-preview9
        1. Dependency update from Senparc.Ncf.Core to 0.30.0-preview9
        [2026-11-03] v0.20.10-preview10 Dependency update from Senparc.Ncf.Core to 0.30.3-preview9
        [2026-11-05] v0.20.11-preview11 Dependency update from Senparc.Ncf.Core to 0.30.4-preview10
        [2026-11-12] v0.20.12-preview12 Dependency updates from Senparc.Ncf.Core to 0.31.0-preview11
        [2026-11-19] v0.20.13-preview13 Updated SMS integration support and related localization metadata
        1. Updated affected project files while preserving existing public integration behavior.
        2. Standardized related English source comments and package metadata for the current release.
        [2026-11-24] v0.20.13-preview13 Dependency compatibility update for affected Senparc modules.
        1. Aligned dependent package metadata with the current Senparc module versions.
        2. Preserved existing public APIs and runtime integration while incorporating the related improvements.</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/NeuCharFramework/NcfPackageSources</RepositoryUrl>
    <Configurations>Debug;Release;Test;TemplateRelease</Configurations>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <OutputPath>..\..\BuildOutPut</OutputPath>
    <DocumentationFile>..\..\BuildOutPut\Senparc.Ncf.SMS.XML</DocumentationFile>
    <DefineConstants>$(DefineConstants);RELEASE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <ErrorReport>prompt</ErrorReport>
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='TemplateRelease'">
    <OutputPath>..\..\BuildOutPut</OutputPath>
    <DocumentationFile>..\..\BuildOutPut\Senparc.Ncf.SMS.XML</DocumentationFile>
    <DefineConstants>$(DefineConstants);RELEASE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <ErrorReport>prompt</ErrorReport>
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\icon.jpg" Pack="true" Visible="false" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Senparc.Ncf.Core\Senparc.Ncf.Core.csproj" />
    <ProjectReference Include="..\Senparc.Ncf.Log\Senparc.Ncf.Log.csproj" />
  </ItemGroup>
</Project>
